{
  "name": "statki",
  "version": "1.0.0",
  "description": "HULLFALL - gra w HTML/JS",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test.mjs",
    "benchmark:100k": "node scripts/benchmark100k.mjs",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.statki.demo",
    "productName": "HULLFALL",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "!dist/sounds/menu/**",
      "electron/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "http-server": "^14.1.1",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "three": "^0.183.2"
  }
}
