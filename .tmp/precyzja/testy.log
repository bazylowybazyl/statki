            cores: Array.isArray(cfg.cores)
              ? cfg.cores
              : (Array.isArray(base.cores) ? base.cores : []),
            engines: {
              main: (Array.isArray(cfg?.engines?.main) && cfg.engines.main.length)
                ? cfg.engines.main
