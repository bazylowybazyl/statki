                    if (hovered) {
                      _targetingLabel(
                        `${target.label} • LPM: ${selected ? 'ODZNACZ' : 'NAMIERZ'}`,
                        screen.x + 22 * visualScale,
                        screen.y - 18 * visualScale,
                        selected ? '#ff8a94' : '#ffd27a',
                        'left',
                        visualScale
                      );
                    }
                  }
                  // Mostki: większy marker w środku strefy + integralność.
                  const bridges = listTargetableBridges(entity);
                  if (bridges) {
                    for (let i = 0; i < bridges.length; i++) {
                      const bridge = bridges[i];
                      if (bridge.dead) continue;
                      const target = getTargetingBridgeTarget(entity, bridge);
                      const point = getBridgeMarkerWorld(entity, bridge);
                      const screen = worldToScreen(point.x, point.y, camRef);
                      const selected = lockedTargets.includes(target);
                      const hovered = targetingMode.hoveredSubsystem === target;
                      drawSubTargetingReticle(
                        ctx,
                        screen.x,
                        screen.y,
                        (hovered ? 20 : 15) * visualScale,
                        hovered || selected ? 1 : 0.8,
                        selected ? '#ff4d5e' : '#7fd8ff',
                        selected ? '#ff8a94' : '#c8f0ff',
                        visualScale
                      );
                      if (hovered) {
                        _targetingLabel(
                          `${target.label} ${Math.round(bridge.integrity * 100)}% • LPM: ${selected ? 'ODZNACZ' : 'NAMIERZ'}`,
                          screen.x + 26 * visualScale,
                          screen.y - 22 * visualScale,
                          selected ? '#ff8a94' : '#c8f0ff',
                          'left',
                          visualScale
                        );
                      }
                    }
                  }
                }
              } else {
                drawSubTargetingReticle(ctx, cursor.x, cursor.y, 13 * visualScale, 0, '#34e7ff', '#52ff9a', visualScale);
              }
              for (let i = 0; i < lockedTargets.length; i++) {
                const target = lockedTargets[i];
                if (!target?.__targetingSubsystem || !isTargetAlive(target)) continue;
                const screen = worldToScreen(getTargetX(target), getTargetY(target), camRef);
                drawSubTargetingReticle(ctx, screen.x, screen.y, 13 * visualScale, 1, '#ff4d5e', '#ff8a94', visualScale);
              }
            }
    
            ctx.restore();
            ctx.save();
            ctx.fillStyle = color;
            ctx.globalAlpha = 0.82;
            ctx.font = '11px monospace';
            ctx.textAlign = 'left';
            ctx.fillText(`${TARGETING_MODE_ICONS[targetingMode.current]} ${TARGETING_MODE_NAMES[targetingMode.current]} • BROŃ 100%`, clipX + 10, H - 10);
            ctx.restore();
          }
    
          // Kursor systemowy chowamy dokladnie tam, gdzie rysujemy wlasny celownik.
          // Panel stacji, CIC, RTS, kolo trybow i menu maja dostac strzalke z powrotem.
          // Tryb interfejsu (Alt) też oddaje strzałkę. Zapis do style — na końcu render().
          _osCursorHidden = gameStarted
            && !stationUI.open
            && !targetingMode.wheelOpen
            && !CICDisplay.active
            && !isRtsModeActive()
            && !isHudPointerMode()
            && mouse.overCanvas;
    
          if (gameStarted && !stationUI.open && !targetingMode.wheelOpen) {
            if (splitScreenMode && camera2 && player2Ship) {
              const halfW = Math.floor(W / 2);
              // P1 crosshair (left half)
              const p1Cam = { x: cam.x, y: cam.y, zoom: cam.zoom, viewportX: 0, viewportY: 0, viewportW: halfW, viewportH: H };
              _wtsVpW = halfW; _wtsVpH = H; _wtsVpOffX = 0; _wtsVpOffY = 0;
              _drawWeaponAimLines(p1Cam);
              _drawReticle(mouse, p1Cam, ship, 0, halfW);
              // P2 crosshair (right half)
              const p2Cam = { x: camera2.x, y: camera2.y, zoom: camera2.zoom, viewportX: halfW, viewportY: 0, viewportW: W - halfW, viewportH: H };
              _wtsVpW = W - halfW; _wtsVpH = H; _wtsVpOffX = halfW; _wtsVpOffY = 0;
              _drawReticle(mouse2, p2Cam, player2Ship, halfW, W - halfW);
              // Reset viewport params
              _wtsVpW = 0; _wtsVpH = 0; _wtsVpOffX = 0; _wtsVpOffY = 0;
            } else {
              _drawWeaponAimLines(cam);
              _drawReticle(mouse, cam, ship, 0, W);
            }
          }
    
          // --- Koło wyboru celownika: SINGLE / MULTI / SUB ---
          if (targetingMode.wheelOpen && targetingMode.wheelMouseStart) {
            const cx = targetingMode.wheelMouseStart.x;
            const cy = targetingMode.wheelMouseStart.y;
            const wheelR = 90;
            const sectorAngles = [
              { start: -30, end: 90 },    // SINGLE (góra-prawo)
              { start: 90, end: 210 },    // MULTI (prawo-dół)
              { start: 210, end: 330 },   // SUB (lewo)
            ];
    
            ctx.save();
            // Tło koła
            ctx.fillStyle = 'rgba(10, 15, 30, 0.85)';
            ctx.beginPath();
            ctx.arc(cx, cy, wheelR + 10, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = 'rgba(100, 150, 220, 0.4)';
            ctx.lineWidth = 2;
            ctx.stroke();
    
            // Rysuj sektory
            for (let i = 0; i < 3; i++) {
              const s = sectorAngles[i];
              const a1 = (s.start - 90) * Math.PI / 180;
              const a2 = (s.end - 90) * Math.PI / 180;
              const isHover = targetingMode.wheelHover === i;
              const isCurrent = targetingMode.current === i;
    
              ctx.beginPath();
              ctx.moveTo(cx, cy);
              ctx.arc(cx, cy, wheelR, a1, a2);
              ctx.closePath();
              ctx.fillStyle = isHover
                ? `${TARGETING_MODE_COLORS[i]}44`
                : (isCurrent ? 'rgba(40, 60, 100, 0.6)' : 'rgba(20, 30, 50, 0.4)');
              ctx.fill();
              ctx.strokeStyle = isHover ? TARGETING_MODE_COLORS[i] : 'rgba(80, 120, 180, 0.3)';
              ctx.lineWidth = isHover ? 2 : 1;
              ctx.stroke();
    
              // Ikona + nazwa
              const midAngle = ((s.start + s.end) / 2 - 90) * Math.PI / 180;
              const labelR = wheelR * 0.6;
              const lx = cx + Math.cos(midAngle) * labelR;
              const ly = cy + Math.sin(midAngle) * labelR;
    
              ctx.fillStyle = isHover ? '#fff' : (isCurrent ? TARGETING_MODE_COLORS[i] : '#8899bb');
              ctx.font = `bold ${isHover ? 16 : 13}px monospace`;
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText(TARGETING_MODE_ICONS[i], lx, ly - 8);
              ctx.font = `${isHover ? 11 : 9}px monospace`;
              ctx.fillText(TARGETING_MODE_NAMES[i], lx, ly + 8);
    
              ctx.font = '8px monospace';
              ctx.fillStyle = isHover ? '#aabbdd' : '#556688';
              const detail = i === TARGETING_MODE.SINGLE ? '1 CEL' : (i === TARGETING_MODE.MULTI ? 'GRUPA' : 'HARDPOINTY');
              ctx.fillText(detail, lx, ly + 20);
              ctx.fillText('BROŃ 100%', lx, ly + 30);
            }
    
            // Środek koła — tryb SELECT
            const selectR = 26;
            const selectColor = TARGETING_MODE_COLORS[TARGETING_MODE.SELECT];
            const isSelectHover = targetingMode.wheelHover === TARGETING_MODE.SELECT;
            const isSelectCurrent = targetingMode.current === TARGETING_MODE.SELECT;
    
            ctx.beginPath();
            ctx.arc(cx, cy, selectR, 0, Math.PI * 2);
            ctx.fillStyle = isSelectHover
              ? `${selectColor}44`
              : (isSelectCurrent ? 'rgba(40, 60, 100, 0.6)' : 'rgba(20, 30, 50, 0.4)');
            ctx.fill();
            ctx.strokeStyle = isSelectHover ? selectColor : 'rgba(80, 120, 180, 0.3)';
            ctx.lineWidth = isSelectHover ? 2 : 1;
            ctx.stroke();
    
            ctx.fillStyle = isSelectHover ? '#fff' : (isSelectCurrent ? selectColor : '#8899bb');
            ctx.font = `bold ${isSelectHover ? 14 : 11}px monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(TARGETING_MODE_ICONS[TARGETING_MODE.SELECT], cx, cy - 6);
            ctx.font = `${isSelectHover ? 9 : 8}px monospace`;
            ctx.fillText(TARGETING_MODE_NAMES[TARGETING_MODE.SELECT], cx, cy + 8);
    
            ctx.restore();
          }
    
          if (mercMission && mercMission.station) {
            const st = mercMission.station;
            const panelPadding = 24;
            const barW = 220;
            const barH = 10;
            let y = 36;
            const xRight = W - panelPadding;
            ctx.save();
            ctx.textAlign = 'right';
            ctx.fillStyle = '#ffd1d1';
            ctx.fillText('Piracka stacja', xRight, y);
            ctx.fillStyle = '#dfe7ff';
            y += 8;
            if (st.shield) {
              const shieldFrac = clamp(st.shield.val / st.shield.max, 0, 1);
              ctx.fillText(`Osłony: ${Math.round(st.shield.val)}/${st.shield.max}`, xRight, y + 10);
              const bx = xRight - barW;
              ctx.strokeStyle = 'rgba(255,255,255,0.18)';
              ctx.strokeRect(bx - 1, y + 14, barW + 2, barH + 2);
              ctx.fillStyle = '#60a5fa';
              ctx.fillRect(bx, y + 15, barW * shieldFrac, barH);
              ctx.fillStyle = '#dfe7ff';
              y += 32;
            }
            const hullFrac = clamp(st.hp / st.maxHp, 0, 1);
            ctx.fillText(`Kadłub: ${Math.round(st.hp)}/${st.maxHp}`, xRight, y + 10);
            const bx = xRight - barW;
            ctx.strokeStyle = 'rgba(255,255,255,0.18)';
            ctx.strokeRect(bx - 1, y + 14, barW + 2, barH + 2);
            ctx.fillStyle = '#ef4444';
            ctx.fillRect(bx, y + 15, barW * hullFrac, barH);
            y += 32;
            const platforms = mercMission.weaponPlatforms || [];
            if (platforms.length) {
              ctx.fillStyle = '#ffd1d1';
              ctx.fillText('Platformy obronne', xRight, y);
              y += 8;
              for (const platform of platforms) {
                const label = platform.label || 'Platforma';
                const entryBx = xRight - barW;
                if (platform.shield && platform.shield.max > 0) {
                  const shieldFrac = clamp(platform.shield.val / platform.shield.max, 0, 1);
                  ctx.fillStyle = '#dfe7ff';
                  ctx.fillText(`${label}: osłony ${Math.round(platform.shield.val)}/${platform.shield.max}`, xRight, y + 10);
                  ctx.strokeStyle = 'rgba(255,255,255,0.12)';
                  ctx.strokeRect(entryBx - 1, y + 14, barW + 2, barH + 2);
                  ctx.fillStyle = '#60a5fa';
                  ctx.fillRect(entryBx, y + 15, barW * shieldFrac, barH);
                  y += 26;
                }
                const hpFrac = (platform.maxHp > 0) ? clamp(Math.max(0, platform.hp) / platform.maxHp, 0, 1) : 0;
                ctx.fillStyle = '#dfe7ff';
                ctx.fillText(`${label}: kadłub ${Math.max(0, Math.round(platform.hp))}/${platform.maxHp}`, xRight, y + 10);
                ctx.strokeStyle = 'rgba(255,255,255,0.12)';
                ctx.strokeRect(entryBx - 1, y + 14, barW + 2, barH + 2);
                ctx.fillStyle = platform.destroyed ? '#4b5563' : '#f97316';
                ctx.fillRect(entryBx, y + 15, barW * hpFrac, barH);
                y += 28;
              }
            }
            ctx.restore();
          }
    
          // === CIC DISPLAY ===
          if (CICDisplay.active) {
            CICDisplay.draw(ctx, W, H, ship, SensorSystem, null, gameTime);
          }
    
          // === SPOTTER DRONE PiP ===
          if (!CICDisplay.active && gameStarted) {
            SpotterDroneSystem.drawPiP(ctx, W, H, cam, npcs, worldToScreen);
          }
    
          // === CONTACT MARKERS (taktyczne znaczniki w przestrzeni 3D) ===
          if (!CICDisplay.active && gameStarted) {
            ContactMarkers.draw(ctx, W, H, ship, SensorSystem, gameTime, cam, mercMission, false);
          }
    
          renderStationUI();
          renderOptions();
          if (!CICDisplay.active && !stationUI.open) {
            drawWorldCommandMenu(ctx);
          }
          renderZoneMessages();
          renderMissionCompleteBanner();
          // Baner "ALT · TRYB INTERFEJSU" rysuje kokpit (DOM), a kursor ustawiamy raz na klatkę.
          const nextCursor = _cursorRequest || (_osCursorHidden ? 'none' : 'default');
          if (nextCursor !== _osCursorValue) {
            _osCursorValue = nextCursor;
            canvas.style.cursor = nextCursor;
          }
          PerfHUD.addTiming('renderUiTime', performance.now() - tRenderUi0);
          if (renderDbgEnabled) {
            const tRenderEnd = performance.now();
            if (tPost3DStart > 0) {
              RenderLiveDebug.record('renderPost3D2D', tRenderEnd - tPost3DStart);
            }
            RenderLiveDebug.recordFrame(tRenderEnd - tRenderStart);
            RenderLiveDebug.flush(tRenderEnd, false);
          }
          mouse.click = false;
          mouse2.click = false;
        }
    
        function renderZoneMessages() {
          if (window.hudSystem) return;
          if (!zoneState.messages.length) return;
    
          ctx.save();
          ctx.resetTransform();
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          const baseY = 70;
          const lineH = 32;
    
          zoneState.messages.forEach((msg, i) => {
            const progress = msg.maxLife - msg.life;
            const fadeIn = clamp(progress / 0.35, 0, 1);
            const fadeOut = clamp(msg.life / 0.5, 0, 1);
            const alpha = Math.min(fadeIn, fadeOut);
            if (alpha <= 0) return;
    
            const fontSize = 22;
            const y = baseY + i * lineH;
            ctx.font = `600 ${fontSize}px Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif`;
            ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
            ctx.shadowBlur = 12;
            ctx.lineWidth = 2;
            ctx.strokeStyle = 'rgba(12, 20, 36, 0.7)';
            ctx.fillStyle = '#e5ecff';
            ctx.globalAlpha = alpha;
    
            ctx.strokeText(msg.text, W / 2, y);
            ctx.fillText(msg.text, W / 2, y);
          });
    
          ctx.restore();
        }
    
        function renderMissionCompleteBanner() {
          if (!missionCompleteBanner.active) return;
          const alpha = missionCompleteBanner.alpha();
          if (alpha <= 0) return;
    
          ctx.save();
          ctx.resetTransform();
          ctx.translate(W / 2, H * 0.32);
          const scale = 1 + 0.08 * Math.sin(missionCompleteBanner.progress() * Math.PI);
          ctx.scale(scale, scale);
          ctx.globalAlpha = alpha;
    
          const fontSize = Math.round(Math.min(W, H) * 0.08);
          ctx.font = `700 ${fontSize}px Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.shadowColor = 'rgba(80,180,255,0.85)';
          ctx.shadowBlur = Math.max(14, fontSize * 0.2);
          ctx.lineJoin = 'round';
    
          const strokeWidth = Math.max(2, fontSize * 0.05);
          ctx.lineWidth = strokeWidth;
          ctx.strokeStyle = 'rgba(10,20,40,0.6)';
          ctx.strokeText(missionCompleteBanner.text, 0, 0);
    
          ctx.fillStyle = '#ffffff';
          ctx.fillText(missionCompleteBanner.text, 0, 0);
    
          ctx.restore();
        }
    
        // =============== Helpers (POPRAWIONE) ===============
        function roundRect(ctx, x, y, w, h, r) {
          // Zabezpieczenie: promień nie może być większy niż połowa krótszego boku
          if (w < 2 * r) r = w / 2;
          if (h < 2 * r) r = h / 2;
          if (r < 0) r = 0;
    
          ctx.beginPath();
          ctx.moveTo(x + r, y);
          ctx.arcTo(x + w, y, x + w, y + h, r);
          ctx.arcTo(x + w, y + h, x, y + h, r);
          ctx.arcTo(x, y + h, x, y, r);
          ctx.arcTo(x, y, x + w, y, r);
          ctx.closePath();
        }
    
    
        function screenToWorld(sx, sy, camRef = camera) {
          const zoomNow = Math.max(0.0001, Number(camRef?.zoom) || Number(camera.zoom) || 1);
          const camX = Number(camRef?.x) || 0;
          const camY = Number(camRef?.y) || 0;
          const vp = getViewportForCamera(camRef);
          return {
            x: camX + (sx - (vp.x + vp.w / 2)) / zoomNow,
            y: camY + (sy - (vp.y + vp.h / 2)) / zoomNow
          };
        }
        window.screenToWorld = screenToWorld;
    
        // --- MINI UI HELPERS (HUD) ---
        let hudOffset = { x: 40, y: 46 };
        function hudBeginPanel(x = 24, y = 24, w = 450, h = 520) {
          ctx.save();
          ctx.resetTransform();
          ctx.fillStyle = 'rgba(0,0,0,0.55)';
          ctx.fillRect(x, y, w, h);
          ctx.fillStyle = 'rgba(255,255,255,0.08)';
          ctx.fillRect(x, y, w, 24);
          ctx.translate(x + 16, y + 46);
          hudOffset.x = x + 16;
          hudOffset.y = y + 46;
          ctx.fillStyle = '#E6F2FF';
          ctx.font = '16px monospace';
        }
        function hudEndPanel() { ctx.restore(); }
        function uiTitle(t) { ctx.font = '20px monospace'; ctx.fillText(t, 0, 0); ctx.translate(0, 28); ctx.font = '16px monospace'; }
        // --- NOWA FUNKCJA UI DO WYBORU JAKOŚCI ---
        function uiQualitySelector() {
          if (!window.Nebula) return;
          const cfg = window.Nebula.getConfig();
          const current = cfg.quality;
          const opts = ['2k', '4k', '8k'];
    
          ctx.fillText('Jakość tła:', 0, 0);
    
          let x = 180;
          const y = -14;
          const w = 40;
          const h = 20;
    
          for (const opt of opts) {
            const isActive = (current === opt);
    
            // Rysowanie przycisku
            ctx.strokeStyle = isActive ? '#fff' : 'rgba(100,150,255,0.4)';
            ctx.fillStyle = isActive ? '#3b82f6' : 'rgba(10,20,40,0.5)';
            ctx.fillRect(x, y, w, h);
            ctx.strokeRect(x, y, w, h);
    
            // Tekst
            ctx.fillStyle = isActive ? '#fff' : '#8fb5ff';
            ctx.fillText(opt.toUpperCase(), x + 8, 0);
    
            // Obsługa myszy (Canvas Immediate Mode GUI)
            const t = ctx.getTransform();
            const L = t.e + x;
            const T = t.f + y;
            const R = L + w;
            const B = T + h;
    
            const over = mouse.x > L && mouse.x < R && mouse.y > T && mouse.y < B;
            if (over) {
              _cursorRequest = 'pointer';
              if (mouse.click) {
                window.Nebula.setQuality(opt);
                mouse.click = false; // "zjedz" kliknięcie
              }
            }
    
            x += w + 8; // odstęp
          }
          ctx.translate(0, 24); // nowa linia w panelu
        }
    
        function slider(label, min, max, step, obj, key) {
          ctx.fillText(`${label}: ${obj[key].toFixed(2)}`, 0, 0); ctx.translate(0, 18);
          // do prostoty – klawiszami [ i ] zmieniasz ostatni slider; lub klik + ruch (opcjonalnie)
          // Możesz podpiąć realny input według swojej architektury.
        }
        function toast(t) {
          if (typeof pushZoneMessage === 'function') pushZoneMessage(t, 2.2, { label: 'STATUS UPDATE', tone: 'status' });
        }
        function getPlayerHullDef(hullId) {
          return PLAYER_HULL_CATALOG[normalizePlayerHullId(hullId)] || PLAYER_HULL_CATALOG[DEFAULT_PLAYER_HULL_ID];
        }
    
        function getPlayerOwnedHullIds() {
          if (!(PLAYER.ownedHulls instanceof Set)) {
            const fromShip = Array.isArray(ship?.ownedHullIds) ? ship.ownedHullIds : [];
            PLAYER.ownedHulls = new Set(fromShip.map(normalizePlayerHullId));
          }
          PLAYER.ownedHulls.add(DEFAULT_PLAYER_HULL_ID);
          return PLAYER.ownedHulls;
        }
    
        function playerOwnsHull(hullId) {
          return getPlayerOwnedHullIds().has(normalizePlayerHullId(hullId));
        }
    
        function ensurePlayerOwnsHull(hullId) {
          const id = normalizePlayerHullId(hullId);
          getPlayerOwnedHullIds().add(id);
          return id;
        }
    
        function applyHullThrusterLayout(hullId) {
          if (!ship) return;
          const id = normalizePlayerHullId(hullId);
          const frameId = String(Game.player?.shipFrame || '').toLowerCase();
          if (applyPlayerEditorEngineLayoutFromStorage(id) || applyPlayerEditorEngineLayoutFromStorage(frameId)) {
            return;
          }
          const w = Math.max(120, Number(ship.w) || 450);
          const h = Math.max(120, Number(ship.h) || 250);
    
          const makeMain = (x, y) => {
            const mount = inferEditorEngineMount('main', x, y);
            const deg = 90;
            return {
              offset: { x, y },
              forward: editorDegToForward(deg),
              mount,
              baseDeg: deg,
              nozzleDeg: deg,
              gimbalMinDeg: -45,
              gimbalMaxDeg: 45,
              yNudge: 0,
              vfxLengthMin: 10,
              vfxLengthMax: 179
            };
          };
          const makeSide = (x, y) => {
            const mount = inferEditorEngineMount('side', x, y);
            const deg = y < 0 ? 180 : 0;
            return {
              offset: { x, y },
              forward: editorDegToForward(deg),
              mount,
              baseDeg: deg,
              nozzleDeg: deg,
              gimbalMinDeg: -90,
              gimbalMaxDeg: 90,
              side: inferEditorEngineSide(mount, x),
              yNudge: 0,
              vfxWidthMin: 25,
              vfxWidthMax: 227,
              vfxLengthMin: 49,
              vfxLengthMax: 354
            };
          };
    
          let mainThrusters = [];
          let sideThrusters = [];
          const aftX = -w * 0.5 + 14;
    
          if (id === 'frigate') {
            mainThrusters = [
              makeMain(aftX, -h * 0.18),
              makeMain(aftX, h * 0.18)
            ];
            sideThrusters = [
              makeSide(-w * 0.1, -h * 0.46),
              makeSide(-w * 0.1, h * 0.46)
            ];
          } else if (id === 'destroyer') {
            mainThrusters = [
              makeMain(aftX, -h * 0.24),
              makeMain(aftX, 0),
              makeMain(aftX, h * 0.24)
            ];
            sideThrusters = [
              makeSide(-w * 0.15, -h * 0.48),
              makeSide(-w * 0.15, h * 0.48),
              makeSide(w * 0.2, -h * 0.38),
              makeSide(w * 0.2, h * 0.38)
            ];
          } else if (id === 'battleship') {
            mainThrusters = [
              makeMain(aftX, -h * 0.28),
              makeMain(aftX, -h * 0.09),
              makeMain(aftX, h * 0.09),
              makeMain(aftX, h * 0.28)
            ];
            sideThrusters = [
              makeSide(-w * 0.2, -h * 0.5),
              makeSide(-w * 0.2, h * 0.5),
              makeSide(w * 0.24, -h * 0.36),
              makeSide(w * 0.24, h * 0.36)
            ];
          } else if (id === 'megafreighter') {
            // The old Atlas fallback kept the maneuvering jets near the centre of
            // this 2.7k-unit hull, giving them almost no useful lever arm. Place
            // the locomotive's jets at its physical corners so it can turn the
            // complete articulated train through the hard couplers.
            mainThrusters = [
              makeMain(aftX, -h * 0.32),
              makeMain(aftX, -h * 0.1),
              makeMain(aftX, h * 0.1),
              makeMain(aftX, h * 0.32)
            ];
            sideThrusters = [
              makeSide(-w * 0.4, -h * 0.48),
              makeSide(-w * 0.4, h * 0.48),
              makeSide(w * 0.4, -h * 0.42),
              makeSide(w * 0.4, h * 0.42)
            ];
          } else {
            applyPlayerEditorEngineLayoutFromStorage(id);
            return;
          }
    
          ship.visual = ship.visual || {};
          ship.visual.mainThrusters = mainThrusters;
          ship.visual.torqueThrusters = sideThrusters;
          // Układ zapasowy (bez markerów edytora): dysza liczona od kadłuba, nie
          // rozmiar z poprzedniego kadłuba.
          delete ship.visual.engineFx;
    
          if (ship.engines?.main && mainThrusters.length) {
            const first = mainThrusters[0];
            ship.engines.main.vfxOffset = { ...first.offset };
            ship.engines.main.vfxForward = { ...first.forward };
            ship.engines.main.vfxYNudge = Number(first.yNudge) || 0;
            ship.engines.main.vfxLengthMin = Number(first.vfxLengthMin) || ship.engines.main.vfxLengthMin || 10;
            ship.engines.main.vfxLengthMax = Number(first.vfxLengthMax) || ship.engines.main.vfxLengthMax || 179;
          }
        }
    
        function syncPlayerHullSnapshot() {
          const active = normalizePlayerHullId(PLAYER.activeHullId || ship.activeHullId || DEFAULT_PLAYER_HULL_ID);
          PLAYER.activeHullId = active;
          PLAYER.shipId = active;
          ship.activeHullId = active;
          const owned = [...getPlayerOwnedHullIds()].map(normalizePlayerHullId);
          ship.ownedHullIds = [...new Set(owned)];
        }
    
        function applyPlayerHullProfile(hullId, opts = {}) {
          const hull = getPlayerHullDef(hullId);
          if (!hull) return false;
    
          const preserveDamageRatio = opts.preserveDamageRatio !== false;
          const syncVisuals = opts.syncVisuals !== false;
          const prevHullMax = Math.max(1, Number(ship?.hull?.max) || 1);
          const prevHullVal = Math.max(0, Number(ship?.hull?.val) || 0);
          const prevShieldMax = Math.max(1, Number(ship?.shield?.max) || 1);
          const prevShieldVal = Math.max(0, Number(ship?.shield?.val) || 0);
          const hullRatio = preserveDamageRatio ? clamp(prevHullVal / prevHullMax, 0, 1) : 1;
          const shieldRatio = preserveDamageRatio ? clamp(prevShieldVal / prevShieldMax, 0, 1) : 1;
    
          const activeHullId = normalizePlayerHullId(hull.id);
          const previousHardpoints = Array.isArray(Game.player?.hardpoints)
            ? Game.player.hardpoints.map(h => ({
              type: h.type,
              mount: h.mount,
              ammo: h.ammo,
              maxAmmo: h.maxAmmo,
              hangarSquadrons: h.type === HP.HANGAR ? getHardpointHangarSquadrons(h) : undefined
            }))
            : [];
    
          ensurePlayerOwnsHull(activeHullId);
          PLAYER.activeHullId = activeHullId;
          PLAYER.shipId = activeHullId;
          ship.activeHullId = activeHullId;
          if (window.shipDriveState) {
            setDriveHullClass(window.shipDriveState, activeHullId, getPlayerSpeed());
          }
    
          const physics = hull.physics || BASE_PLAYER_PHYSICS;
          SHIP_PHYSICS.PLAYER_MASS = Math.max(1, Number(hull.mass) || BASE_PLAYER_PROFILE.mass);
          SHIP_PHYSICS.SPEED = Math.max(1, Number(physics.speed) || BASE_PLAYER_PHYSICS.speed);
          SHIP_PHYSICS.REVERSE_MULT = clamp(Number(physics.reverseMult) || BASE_PLAYER_PHYSICS.reverseMult, 0.1, 1);
          SHIP_PHYSICS.TURN_ACCEL = Math.max(0.5, Number(physics.turnAccel) || BASE_PLAYER_PHYSICS.turnAccel);
          SHIP_PHYSICS.MAX_TURN_SPEED = Math.max(0.2, Number(physics.maxTurnSpeed) || BASE_PLAYER_PHYSICS.maxTurnSpeed);
          SHIP_PHYSICS.LINEAR_FRICTION = clamp(Number(physics.linearFriction) || BASE_PLAYER_PHYSICS.linearFriction, 0.9, 0.9995);
          SHIP_PHYSICS.ANGULAR_FRICTION = clamp(Number(physics.angularFriction) || BASE_PLAYER_PHYSICS.angularFriction, 0.85, 0.9995);
          SHIP_PHYSICS.BOOST_MULT = Math.max(1.0, Number(physics.boostMult) || BASE_PLAYER_PHYSICS.boostMult);
    
          const hullProfileId = resolveHullRenderProfileId(hull.shipFrame || hull.id);
          const immediateSize = getResolvedHullRenderSize(
            hullProfileId,
            shipSprite?.complete && shipSprite?.naturalWidth > 0 ? shipSprite : null,
            Number(hull?.size?.w) || Number(ship.w) || 450,
            Number(hull?.size?.h) || Number(ship.h) || 250
          );
    
          ship.mass = SHIP_PHYSICS.PLAYER_MASS;
          ship.rammingMass = Math.max(1, Number(hull.rammingMass) || ship.mass);
          ship.sensors = hull.sensors ? { ...hull.sensors } : resolveShipSensors(ship);
          const sizeW = Math.max(120, Number(immediateSize?.w) || Number(hull?.size?.w) || Number(ship.w) || 450);
          const sizeH = Math.max(120, Number(immediateSize?.h) || Number(hull?.size?.h) || Number(ship.h) || 250);
          ship.w = sizeW;
          ship.h = sizeH;
          const fallbackHullRadius = Math.max(20, Number(immediateSize?.radius) || Number(hull.radius) || BASE_PLAYER_PROFILE.radius);
          const currentScale = Math.max(0.0001, Number(ship?.visual?.spriteScale) || 1);
          if (ship?.hexGrid?.rawRadius && Number.isFinite(ship.hexGrid.rawRadius)) {
            ship.radius = Math.max(fallbackHullRadius, ship.hexGrid.rawRadius * currentScale);
          } else {
            ship.radius = fallbackHullRadius;
          }
          ship.visual = ship.visual || {};
          if (Number.isFinite(Number(hull.spriteScale)) && Number(hull.spriteScale) > 0) {
            ship.visual.spriteScale = Number(hull.spriteScale);
          }
          ship.visual.mainThrusters = null;
          ship.visual.torqueThrusters = null;
          refreshShipGeometry(ship);
          applyHullThrusterLayout(activeHullId);
    
          ship.cargoCap = Math.max(8, Number(hull.cargoCap) || BASE_PLAYER_PROFILE.cargoCap);
          ship.hull.max = Math.max(100, Math.round(Number(hull.hullMax) || BASE_PLAYER_PROFILE.hullMax));
          ship.hull.val = Math.max(1, Math.round(ship.hull.max * hullRatio));
          if (ship.shield) {
            ship.shield.max = Math.max(0, Math.round(Number(hull?.shield?.max) || BASE_PLAYER_PROFILE.shieldMax));
            ship.shield.regenRate = Math.max(0, Number(hull?.shield?.regenRate) || BASE_PLAYER_PROFILE.shieldRegen);
            ship.shield.regenDelay = Math.max(0.1, Number(hull?.shield?.regenDelay) || BASE_PLAYER_PROFILE.shieldDelay);
            ship.shield.val = Math.max(0, Math.round(ship.shield.max * shieldRatio));
          }
    
          const targetFrame = SHIPS[hull.shipFrame] ? hull.shipFrame : DEFAULT_PLAYER_HULL_ID;
          Game.player.shipFrame = targetFrame;
          ship.shipFrame = targetFrame;
          rebuildHardpointsForFrame();
          if (previousHardpoints.length) tryPreserveMounts(previousHardpoints);
          syncWeaponSystems();
    
          if (syncVisuals) {
            ship.capitalProfile = ship.capitalProfile || {};
            ship.capitalProfile.spriteSrc = hull.spriteSrc || ship.capitalProfile.spriteSrc || "assets/capital_ship_rect_v1.png";
            const desiredSprite = ship.capitalProfile.spriteSrc || "assets/capital_ship_rect_v1.png";
            const desiredResolved = (() => {
              try { return new URL(desiredSprite, window.location.href).href; } catch { return desiredSprite; }
            })();
            if (invalidateHexShipEntity3D) invalidateHexShipEntity3D(ship);
            disposeHexBody(ship);
            ship.hexGrid = null;
            if (shipSprite.src !== desiredResolved) {
              ship.spriteReady = false;
              ship.renderSpriteImage = null;
              shipSprite.src = desiredSprite;
            } else if (shipSprite.complete && shipSprite.naturalWidth > 0) {
              const resolvedSize = getResolvedHullRenderSize(hullProfileId, shipSprite, ship.w, ship.h);
              ship.w = resolvedSize.w;
              ship.h = resolvedSize.h;
              const renderImage = getPlayerHullRenderImage(shipSprite, ship.w, ship.h) || shipSprite;
              const hexInitImage = buildHexInitImageFromRenderSource(renderImage, ship.w, ship.h) || renderImage;
              updatePlayerLayoutScaleFromRender(shipSprite, renderImage);
              ship.renderSpriteImage = renderImage;
              ship.spriteReady = true;
              ship.spriteW = Math.max(1, Number(renderImage.width) || Number(shipSprite.naturalWidth) || 1);
              ship.spriteH = Math.max(1, Number(renderImage.height) || Number(shipSprite.naturalHeight) || 1);
              Game.player.spriteW = ship.spriteW;
              Game.player.spriteH = ship.spriteH;
              rebuildHardpointsForFrame();
              applyHullThrusterLayout(activeHullId);
              if (previousHardpoints.length) tryPreserveMounts(previousHardpoints);
              syncWeaponSystems();
              initHexBody(ship, hexInitImage);
              if (ship.hexGrid) {
                ship.hexGrid.visualImage = shipSprite;
                ship.hexGrid.meshDirty = true;
                ship.hexGrid.meshDirtyAll = true;
                ship.hexGrid.textureDirty = true;
                ship.hexGrid.cacheDirty = true;
                ship.hexGrid.gpuTextureNeedsUpdate = true;
                attachEntityBridges(ship, { key: activeHullId });
              }
              if (ship?.hexGrid?.rawRadius && Number.isFinite(ship.hexGrid.rawRadius)) {
                const scaleNow = Math.max(0.0001, Number(ship?.visual?.spriteScale) || 1);
                ship.radius = ship.hexGrid.rawRadius * scaleNow;
              }
            }
          }
    
          syncPlayerHullSnapshot();
          syncPlayerMegafreighterTrain(activeHullId);
          if (typeof renderMechanic === 'function') renderMechanic();
          if (opts.persist !== false && typeof saveLoadout === 'function') saveLoadout();
          return true;
        }
    
        function dist(x1, y1, x2, y2) { return Math.hypot(x2 - x1, y2 - y1); }
        Object.defineProperty(PirateSim, 'units', {
          get: function () {
            // Zwraca tablicę: [Gracz, ...Wszystkie żywe NPC]
            // Dzięki temu AI może iterować po 'sim.units' i szukać celów
            return [ship, ...npcs.filter(n => !n.dead)];
          }
        });
    
    
    
        // 2. Podłącz funkcję strzelania AI do silnika gry
        // Kiedy AI wywoła spawnBullet, my przekierujemy to do adaptera, który doda pocisk do gry
        window.spawnBullet = function (sim, from, to, weapon) {
          if (window.spawnBulletAdapter) {
            window.spawnBulletAdapter(from, to, weapon);
          } else if (window.aiSpawnBullet) {
            window.aiSpawnBullet(sim, from, to, weapon);
          }
        };
        async function startGame() {
          if (gameStarted) return;
    
          // --- AUDIO START ---
          AudioSys.init();
          await Promise.all([
            AudioSys.loadSound('engine', './sounds/engine/thruster_loop.wav'),
            AudioSys.loadSound('shieldHit', './sounds/465540__steaq__sci-fi-shield-hit-wav.wav'),
            AudioSys.loadSound('specialTurret', './sounds/weapons/specialturret.wav'),
            AudioSys.loadSound('sfx_hexlance', './sounds/weapons/specialturret.wav'),
            AudioSys.loadSound('sfx_railgun', './sounds/weapons/Laser.wav')
          ]);
    
          if (typeof ship !== 'undefined') {
            ship.engineSound = AudioSys.createEngineLoop('engine');
          }
          // --- AUDIO END ---
    
          gameStarted = true;
    
          // Initialize P1 weapon controller
          p1WeaponCtrl = new WeaponController({
            ship: ship,
            getMouseRef: () => mouse,
            getLockedTarget: () => lockedTarget,
            setLockedTarget: (t) => { lockedTarget = t; },
            getLockedTargets: () => lockedTargets,
            owner: 'player',
            screenToWorldFn: (sx, sy) => screenToWorld(sx, sy)
          });
          window.p1WeaponCtrl = p1WeaponCtrl;
    
          SensorSystem.init();
          SpotterDroneSystem.init();
          fadeOutMenuMusic();
    
          if (continueButton) continueButton.classList.remove('hidden');
          if (optionsButton) optionsButton.disabled = false;
          setMenuView('home');
    
          // 1. Ręcznie ukryj menu i upewnij się, że HUD jest SCHOWANY podczas ładowania
          if (mainMenuEl) mainMenuEl.classList.add('hidden');
          toggleGameUI(false);
    
          showLoadingOverlay(0, 'Przygotowanie świata');
          setLoadingProgress(20, 'Inicjalizacja systemów');
          await nextFrame();
    
          initNPCs();
          setLoadingProgress(40, 'Symulacja tras NPC');
          await nextFrame();
    
          initFleet();
          syncPlayerMegafreighterTrain(PLAYER.activeHullId);
          setLoadingProgress(60, 'Kalibracja floty');
          await nextFrame();
          setLoadingProgress(70, 'Kompilacja shaderów broni');
          if (prewarmHexShips3D) {
            prewarmHexShips3D({ canvas: hexShipsCanvas });
          }
          await nextFrame();
    
          // Wstępna symulacja fizyki
          for (let i = 0; i < 60; i++) npcStep(PHYS_DT);
          setLoadingProgress(80, 'Rozruch silników');
    
          await waitForPlanetsReady();
    
          setLoadingProgress(100, 'Start!');
          await nextFrame();
    
          const firstFramePromise = new Promise(resolve => { firstFrameResolver = resolve; });
          lastTime = performance.now();
          acc = 0;
          vfxTime = 0;
    
          // Inicjalizacja systemów (ale bez pokazywania ich ręcznie, zrobi to toggleGameUI)
          initShieldSystem(W, H);
    
          requestAnimationFrame(loop);
          await firstFramePromise;
    
          // Ukryj loading overlay
          hideLoadingOverlay();
    
          // 2. TERAZ, gdy gra jest gotowa, używamy hideMainMenu() logicznie, 
          // aby włączyć HUD i odpauzować grę.
          hideMainMenu();
    
          console.log("[System] Gra uruchomiona.");
        }
        if (newGameButton) {
          newGameButton.addEventListener('click', () => {
            setMenuView('gamemode');
          });
        }
    
        // ============== SPLIT SCREEN / GAME MODE LOGIC ==============
    
        // Ship selection state
        const SPLIT_SHIP_KEYS = ['atlas', 'frigate', 'destroyer', 'battleship'];
        const shipSelectState = {
          active: false,
          p1: { index: 0, ready: false },
          p2: { index: 0, ready: false },
          prevButtons: [new Array(20).fill(false), new Array(20).fill(false)]
        };
    
        function getShipSelectData(hullKey) {
          const cat = PLAYER_HULL_CATALOG[hullKey];
          if (!cat) return null;
          return cat;
        }
    
        function updateShipSelectUI(player, index) {
          const prefix = player === 0 ? 'p1' : 'p2';
          const key = SPLIT_SHIP_KEYS[index];
          const data = getShipSelectData(key);
          if (!data) return;
          const nameEl = document.getElementById(prefix + '-ship-name');
          const roleEl = document.getElementById(prefix + '-ship-role');
          const imgEl = document.getElementById(prefix + '-ship-img');
          const statsEl = document.getElementById(prefix + '-ship-stats');
          if (nameEl) nameEl.textContent = data.name;
          if (roleEl) roleEl.textContent = data.role || '';
          if (imgEl) imgEl.src = data.spriteSrc || '';
          if (statsEl) statsEl.innerHTML =
            `Hull: ${data.hullMax} &nbsp;|&nbsp; Shield: ${data.shield?.max || 0}<br>` +
            `Mass: ${(data.mass / 1000).toFixed(0)}t &nbsp;|&nbsp; Speed: ${data.physics?.speed || '?'}`;
        }
    
        function updateReadyButton(player, ready) {
          const btn = document.getElementById(player === 0 ? 'p1-ready-btn' : 'p2-ready-btn');
          if (!btn) return;
          if (ready) {
            btn.textContent = 'GOTOWY \u2714';
            btn.style.borderColor = '#4f8';
            btn.style.color = '#4f8';
            btn.style.background = 'rgba(60,255,120,0.15)';
            btn.style.boxShadow = '0 0 20px rgba(60,255,120,0.25)';
          } else {
            btn.textContent = 'READY';
            btn.style.borderColor = player === 0 ? '#4af' : '#f84';
            btn.style.color = player === 0 ? '#4af' : '#f84';
            btn.style.background = player === 0 ? 'rgba(60,140,255,0.08)' : 'rgba(255,120,60,0.08)';
            btn.style.boxShadow = 'none';
          }
        }
    
        function setPlayerReady(player, ready) {
          const st = player === 0 ? shipSelectState.p1 : shipSelectState.p2;
          st.ready = ready;
          updateReadyButton(player, ready);
          // Check if both ready → start
          if (shipSelectState.p1.ready && shipSelectState.p2.ready) {
            setTimeout(() => {
              if (shipSelectState.p1.ready && shipSelectState.p2.ready && shipSelectState.active) {
                hideShipSelectOverlay();
                startSplitScreenGame(
                  SPLIT_SHIP_KEYS[shipSelectState.p1.index],
                  SPLIT_SHIP_KEYS[shipSelectState.p2.index]
                );
              }
            }, 350);
          }
        }
    
        function showShipSelectOverlay() {
          shipSelectState.active = true;
          shipSelectState.p1 = { index: 0, ready: false };
          shipSelectState.p2 = { index: 1, ready: false };
          shipSelectState.prevButtons = [new Array(20).fill(false), new Array(20).fill(false)];
          const overlay = document.getElementById('ship-select-overlay');
          if (overlay) { overlay.classList.remove('hidden'); overlay.style.display = 'flex'; }
          // Update player labels with controller info
          const p1Label = document.querySelector('#ship-select-p1 .ship-select-player-label');
          const p2Label = document.querySelector('#ship-select-p2 .ship-select-player-label');
          if (p1Label) p1Label.textContent = 'Gracz 1 \u2014 ' + getControllerLabel(controllerAssignment.p1);
          if (p2Label) p2Label.textContent = 'Gracz 2 \u2014 ' + getControllerLabel(controllerAssignment.p2);
          updateReadyButton(0, false);
          updateReadyButton(1, false);
          updateShipSelectUI(0, shipSelectState.p1.index);
          updateShipSelectUI(1, shipSelectState.p2.index);
          requestAnimationFrame(shipSelectGamepadLoop);
        }
    
        function hideShipSelectOverlay() {
          shipSelectState.active = false;
          const overlay = document.getElementById('ship-select-overlay');
          if (overlay) { overlay.classList.add('hidden'); overlay.style.display = 'none'; }
        }
    
        // Helper: get pad object for a controller assignment id
        function getAssignedPad(assignmentId) {
          if (!assignmentId || assignmentId === 'keyboard') return null;
          const idx = parseInt(assignmentId.replace('pad', ''));
          const pads = navigator.getGamepads?.() || [];
          return pads[idx] || null;
        }
    
        function shipSelectGamepadLoop() {
          if (!shipSelectState.active) return;
    
          // Process each player's assigned controller
          for (let pi = 0; pi < 2; pi++) {
            const assignId = pi === 0 ? controllerAssignment.p1 : controllerAssignment.p2;
            const st = pi === 0 ? shipSelectState.p1 : shipSelectState.p2;
            const prev = shipSelectState.prevButtons[pi];
    
            if (assignId && assignId !== 'keyboard') {
              // Gamepad input
              const pad = getAssignedPad(assignId);
              if (!pad) continue;
    
              const btnNow = pad.buttons.map(b => b.pressed);
              const justPressed = (i) => btnNow[i] && !prev[i];
    
              if (!st.ready) {
                if (justPressed(14) || justPressed(4)) {
                  st.index = (st.index - 1 + SPLIT_SHIP_KEYS.length) % SPLIT_SHIP_KEYS.length;
                  updateShipSelectUI(pi, st.index);
                }
                if (justPressed(15) || justPressed(5)) {
                  st.index = (st.index + 1) % SPLIT_SHIP_KEYS.length;
                  updateShipSelectUI(pi, st.index);
                }
                if (justPressed(0)) setPlayerReady(pi, true);
              } else {
                if (justPressed(1)) setPlayerReady(pi, false);
              }
    
              const ax = pad.axes[0] || 0;
              const prevAx = prev._axH || 0;
              if (!st.ready) {
                if (ax < -0.5 && prevAx >= -0.5) {
                  st.index = (st.index - 1 + SPLIT_SHIP_KEYS.length) % SPLIT_SHIP_KEYS.length;
                  updateShipSelectUI(pi, st.index);
                }
                if (ax > 0.5 && prevAx <= 0.5) {
                  st.index = (st.index + 1) % SPLIT_SHIP_KEYS.length;
                  updateShipSelectUI(pi, st.index);
                }
              }
    
              shipSelectState.prevButtons[pi] = btnNow;
              shipSelectState.prevButtons[pi]._axH = ax;
            }
            // Keyboard input for ship select is handled via keydown listener below
          }
    
          if (shipSelectState.active) requestAnimationFrame(shipSelectGamepadLoop);
        }
    
        // Keyboard input for ship selection (for whichever player is assigned 'keyboard')
        window.addEventListener('keydown', (e) => {
          if (!shipSelectState.active) return;
          const k = e.key.toLowerCase();
          // Find which player has keyboard assigned
          let pi = -1;
          if (controllerAssignment.p1 === 'keyboard') pi = 0;
          else if (controllerAssignment.p2 === 'keyboard') pi = 1;
          if (pi < 0) return;
    
          const st = pi === 0 ? shipSelectState.p1 : shipSelectState.p2;
          if (!st.ready) {
            if (k === 'arrowleft' || k === 'a') {
              st.index = (st.index - 1 + SPLIT_SHIP_KEYS.length) % SPLIT_SHIP_KEYS.length;
              updateShipSelectUI(pi, st.index);
              e.preventDefault();
            }
            if (k === 'arrowright' || k === 'd') {
              st.index = (st.index + 1) % SPLIT_SHIP_KEYS.length;
              updateShipSelectUI(pi, st.index);
              e.preventDefault();
            }
            if (k === 'enter' || k === ' ') {
              setPlayerReady(pi, true);
              e.preventDefault();
            }
          } else {
            if (k === 'escape' || k === 'backspace') {
              setPlayerReady(pi, false);
              e.preventDefault();
            }
          }
        });
    
        // Mouse/click support for ship select arrows
        document.getElementById('p1-prev')?.addEventListener('click', () => {
          if (!shipSelectState.active || shipSelectState.p1.ready) return;
          shipSelectState.p1.index = (shipSelectState.p1.index - 1 + SPLIT_SHIP_KEYS.length) % SPLIT_SHIP_KEYS.length;
          updateShipSelectUI(0, shipSelectState.p1.index);
        });
        document.getElementById('p1-next')?.addEventListener('click', () => {
          if (!shipSelectState.active || shipSelectState.p1.ready) return;
          shipSelectState.p1.index = (shipSelectState.p1.index + 1) % SPLIT_SHIP_KEYS.length;
          updateShipSelectUI(0, shipSelectState.p1.index);
        });
        document.getElementById('p2-prev')?.addEventListener('click', () => {
          if (!shipSelectState.active || shipSelectState.p2.ready) return;
          shipSelectState.p2.index = (shipSelectState.p2.index - 1 + SPLIT_SHIP_KEYS.length) % SPLIT_SHIP_KEYS.length;
          updateShipSelectUI(1, shipSelectState.p2.index);
        });
        document.getElementById('p2-next')?.addEventListener('click', () => {
          if (!shipSelectState.active || shipSelectState.p2.ready) return;
          shipSelectState.p2.index = (shipSelectState.p2.index + 1) % SPLIT_SHIP_KEYS.length;
          updateShipSelectUI(1, shipSelectState.p2.index);
        });
    
        // Ready button click handlers
        document.getElementById('p1-ready-btn')?.addEventListener('click', () => {
          if (!shipSelectState.active) return;
          setPlayerReady(0, !shipSelectState.p1.ready);
        });
        document.getElementById('p2-ready-btn')?.addEventListener('click', () => {
          if (!shipSelectState.active) return;
          setPlayerReady(1, !shipSelectState.p2.ready);
        });
    
        // ============== CONTROLLER SELECTION SYSTEM ==============
        const controllerAssignment = {
          active: false,
          p1: null, // null | 'keyboard' | 'pad0' | 'pad1' | 'pad2' | 'pad3'
          p2: null,
          prevPadButtons: [{}, {}, {}, {}],
          prevPadAxes: [0, 0, 0, 0],
          prevKeys: {}
        };
        window.controllerAssignment = controllerAssignment;
    
        function getControllerLabel(id) {
          if (!id) return 'Oczekiwanie...';
          if (id === 'keyboard') return 'Klawiatura';
          const pads = navigator.getGamepads?.() || [];
          const idx = parseInt(id.replace('pad', ''));
          const pad = pads[idx];
          const name = pad?.id || ('Pad ' + (idx + 1));
          // Shorten long gamepad names
          const short = name.length > 30 ? name.substring(0, 28) + '...' : name;
          return short;
        }
    
        function getControllerIcon(id) {
          if (!id) return '?';
          if (id === 'keyboard') return '\u2328'; // keyboard unicode
          return '\uD83C\uDFAE'; // gamepad unicode
        }
    
        function updateControllerSlotUI(player, id) {
          const prefix = player === 0 ? 'p1' : 'p2';
          const iconEl = document.getElementById('ctrl-' + prefix + '-icon');
          const labelEl = document.getElementById('ctrl-' + prefix + '-label');
          const hintEl = document.getElementById('ctrl-' + prefix + '-hint');
          const slotEl = document.getElementById('ctrl-slot-' + prefix);
          if (iconEl) { iconEl.textContent = getControllerIcon(id); iconEl.style.opacity = id ? '1' : '0.3'; }
          if (labelEl) labelEl.textContent = getControllerLabel(id);
          if (hintEl) hintEl.textContent = id ? 'Przypisany' : 'Nacisnij lewo lub prawo';
          if (slotEl) {
            const color = player === 0 ? '#4af' : '#f84';
            slotEl.style.borderColor = id ? color : '#335';
            slotEl.style.boxShadow = id ? ('0 0 20px ' + (player === 0 ? 'rgba(60,140,255,0.15)' : 'rgba(255,120,60,0.15)')) : 'none';
          }
        }
    
        function updateControllerConfirmBtn() {
          const btn = document.getElementById('ctrl-confirm-btn');
          if (!btn) return;
          const ok = controllerAssignment.p1 && controllerAssignment.p2;
          btn.disabled = !ok;
          btn.style.borderColor = ok ? '#4f8' : '#335';
          btn.style.color = ok ? '#4f8' : '#556';
          btn.style.cursor = ok ? 'pointer' : 'not-allowed';
          btn.style.background = ok ? 'rgba(60,255,120,0.08)' : 'rgba(255,255,255,0.03)';
        }
    
        function tryAssignController(deviceId) {
          // If already assigned to a player, do nothing (same device can't control both)
          if (controllerAssignment.p1 === deviceId) return;
          if (controllerAssignment.p2 === deviceId) return;
    
          // Assign to first empty slot
          if (!controllerAssignment.p1) {
            controllerAssignment.p1 = deviceId;
            updateControllerSlotUI(0, deviceId);
            updateControllerConfirmBtn();
            return;
          }
          if (!controllerAssignment.p2) {
            controllerAssignment.p2 = deviceId;
            updateControllerSlotUI(1, deviceId);
            updateControllerConfirmBtn();
            return;
          }
        }
    
        function showControllerSelectOverlay() {
          controllerAssignment.active = true;
          controllerAssignment.p1 = null;
          controllerAssignment.p2 = null;
          controllerAssignment.prevPadButtons = [{}, {}, {}, {}];
          controllerAssignment.prevPadAxes = [0, 0, 0, 0];
          controllerAssignment.prevKeys = {};
          const overlay = document.getElementById('controller-select-overlay');
          if (overlay) { overlay.classList.remove('hidden'); overlay.style.display = 'flex'; }
          updateControllerSlotUI(0, null);
          updateControllerSlotUI(1, null);
          updateControllerConfirmBtn();
          requestAnimationFrame(controllerSelectLoop);
        }
    
        function hideControllerSelectOverlay() {
          controllerAssignment.active = false;
          const overlay = document.getElementById('controller-select-overlay');
          if (overlay) { overlay.classList.add('hidden'); overlay.style.display = 'none'; }
        }
    
        function controllerSelectLoop() {
          if (!controllerAssignment.active) return;
    
          // Poll gamepads for left/right input
          const pads = navigator.getGamepads?.() || [];
          for (let i = 0; i < 4; i++) {
            const pad = pads[i];
            if (!pad) continue;
            const deviceId = 'pad' + i;
            const prevBtns = controllerAssignment.prevPadButtons[i] || {};
            const prevAx = controllerAssignment.prevPadAxes[i] || 0;
    
            const btnNow = {};
            for (let b = 0; b < pad.buttons.length; b++) btnNow[b] = pad.buttons[b].pressed;
            const justPressed = (b) => btnNow[b] && !prevBtns[b];
    
            // D-pad left (14), right (15), or A (0)
            if (justPressed(14) || justPressed(15) || justPressed(0)) {
              tryAssignController(deviceId);
            }
    
            // Left stick horizontal
            const ax = pad.axes[0] || 0;
            if ((ax < -0.5 && prevAx >= -0.5) || (ax > 0.5 && prevAx <= 0.5)) {
              tryAssignController(deviceId);
            }
    
            controllerAssignment.prevPadButtons[i] = btnNow;
            controllerAssignment.prevPadAxes[i] = ax;
          }
    
          requestAnimationFrame(controllerSelectLoop);
        }
    
        // Keyboard listener for controller selection
        window.addEventListener('keydown', (e) => {
          if (!controllerAssignment.active) return;
          const k = e.key.toLowerCase();
          if (controllerAssignment.prevKeys[k]) return; // not a new press
          controllerAssignment.prevKeys[k] = true;
    
          if (k === 'arrowleft' || k === 'arrowright' || k === 'a' || k === 'd' || k === 'enter' || k === ' ') {
            tryAssignController('keyboard');
          }
        });
        window.addEventListener('keyup', (e) => {
          if (!controllerAssignment.active) return;
          controllerAssignment.prevKeys[e.key.toLowerCase()] = false;
        });
    
        // Click on slot to unassign
        document.getElementById('ctrl-slot-p1')?.addEventListener('click', () => {
          if (!controllerAssignment.active || !controllerAssignment.p1) return;
          controllerAssignment.p1 = null;
          updateControllerSlotUI(0, null);
          updateControllerConfirmBtn();
        });
        document.getElementById('ctrl-slot-p2')?.addEventListener('click', () => {
          if (!controllerAssignment.active || !controllerAssignment.p2) return;
          controllerAssignment.p2 = null;
          updateControllerSlotUI(1, null);
          updateControllerConfirmBtn();
        });
    
        // Confirm → go to ship select
        document.getElementById('ctrl-confirm-btn')?.addEventListener('click', () => {
          if (!controllerAssignment.active) return;
          if (!controllerAssignment.p1 || !controllerAssignment.p2) return;
          hideControllerSelectOverlay();
          showShipSelectOverlay();
        });
    
        // Back → return to game mode menu
        document.getElementById('ctrl-back-btn')?.addEventListener('click', () => {
          hideControllerSelectOverlay();
          splitScreenMode = false;
          window.splitScreenMode = false;
          if (mainMenuEl) mainMenuEl.classList.remove('hidden');
          setMenuView('gamemode');
        });
    
        // ============== GAME MODE BUTTON HANDLERS ==============
        document.getElementById('btn-mode-single')?.addEventListener('click', () => {
          splitScreenMode = false;
          window.splitScreenMode = false;
          setMenuView('home');
          startGame();
        });
        document.getElementById('btn-mode-split')?.addEventListener('click', () => {
          splitScreenMode = true;
          window.splitScreenMode = true;
          if (mainMenuEl) mainMenuEl.classList.add('hidden');
          showControllerSelectOverlay();
        });
        document.getElementById('btn-gamemode-back')?.addEventListener('click', () => {
          setMenuView('home');
        });
    
        async function startSplitScreenGame(p1HullKey, p2HullKey) {
          // Start the game normally first
          await startGame();
    
          // Apply P1 hull selection after game started
          applyPlayerHullProfile(p1HullKey, { preserveDamageRatio: false });
    
          // Now create player 2
          setupPlayer2(p2HullKey);
        }
    
        function setupPlayer2(hullKey) {
          const hull = PLAYER_HULL_CATALOG[hullKey];
          if (!hull) return;
    
          // Create P2 ship entity with initial size placeholder; exact aspect is resolved from sprite on load.
          const hullProfileId = resolveHullRenderProfileId(hull.shipFrame || hull.id);
          const initialSize = getResolvedHullRenderSize(
            hullProfileId,
            null,
            Number(hull.size?.w) || 450,
            Number(hull.size?.h) || 250
          );
          const sizeW = initialSize.w;
          const sizeH = initialSize.h;
          player2Ship = createShipEntity({
            world: WORLD, overlayView, overrides: {
              w: sizeW, h: sizeH
            }
          });
          player2Ship.isPlayer = true;
          player2Ship.isPlayer2 = true;
          player2Ship.friendly = true;
          player2Ship.isCapitalShip = true;
          player2Ship.shipFrame = hull.shipFrame;
          player2Ship.activeHullId = hull.id;
    
          // Apply hull stats
          player2Ship.hull = { val: hull.hullMax, max: hull.hullMax };
          player2Ship.shield = {
            val: hull.shield.max, max: hull.shield.max,
            regenRate: hull.shield.regenRate, regenDelay: hull.shield.regenDelay,
            regenTimer: 0,
            state: 'active', activationProgress: 1.0, currentAlpha: 1.0,
            energyShotTimer: 0, energyShotDuration: 0.5,
            impacts: [],
            hexScale: 12, baseAlpha: 0.12
          };
          player2Ship.mass = hull.mass;
          player2Ship.rammingMass = hull.rammingMass || hull.mass;
          player2Ship.sensors = hull.sensors ? { ...hull.sensors } : resolveShipSensors(player2Ship);
          player2Ship.radius = initialSize.radius || hull.radius || 220;
          player2Ship.w = sizeW;
          player2Ship.h = sizeH;
          player2Ship.inertia = (1 / 12) * player2Ship.mass * ((sizeW * sizeW) + (sizeH * sizeH));
    
          // Apply visual scale and geometry
          player2Ship.visual = player2Ship.visual || {};
          player2Ship.visual.spriteScale = hull.spriteScale || 1.0;
          player2Ship.capitalProfile = player2Ship.capitalProfile || {};
          player2Ship.capitalProfile.spriteSrc = hull.spriteSrc || "assets/capital_ship_rect_v1.png";
    
          // Configure engines & thruster geometry (same pipeline as P1)
          refreshShipGeometry(player2Ship);
    
          // Apply hull-specific thruster layout for P2
          {
            const id = normalizePlayerHullId(hull.id);
            const w = Math.max(120, Number(player2Ship.w) || 450);
            const h = Math.max(120, Number(player2Ship.h) || 250);
    
            const makeMain = (x, y) => {
              const mount = inferEditorEngineMount('main', x, y);
              const deg = 90;
              return {
                offset: { x, y },
                forward: editorDegToForward(deg),
                mount, baseDeg: deg, nozzleDeg: deg,
                gimbalMinDeg: -45, gimbalMaxDeg: 45,
                yNudge: 0, vfxLengthMin: 10, vfxLengthMax: 179
              };
            };
            const makeSide = (x, y) => {
              const mount = inferEditorEngineMount('side', x, y);
              const deg = y < 0 ? 180 : 0;
              return {
              offset: { x, y },
                forward: editorDegToForward(deg),
                mount, baseDeg: deg, nozzleDeg: deg,
                gimbalMinDeg: -90, gimbalMaxDeg: 90,
                side: inferEditorEngineSide(mount, y),
                yNudge: 0, vfxWidthMin: 25, vfxWidthMax: 227,
                vfxLengthMin: 49, vfxLengthMax: 354
              };
            };
    
            let mainThrusters = [];
            let sideThrusters = [];
            const aftX = -w * 0.5 + 14;
    
            if (id === 'frigate') {
              mainThrusters = [makeMain(aftX, -h * 0.18), makeMain(aftX, h * 0.18)];
              sideThrusters = [makeSide(-w * 0.1, -h * 0.46), makeSide(-w * 0.1, h * 0.46)];
            } else if (id === 'destroyer') {
              mainThrusters = [makeMain(aftX, -h * 0.24), makeMain(aftX, 0), makeMain(aftX, h * 0.24)];
              sideThrusters = [
                makeSide(-w * 0.15, -h * 0.48), makeSide(-w * 0.15, h * 0.48),
                makeSide(w * 0.2, -h * 0.38), makeSide(w * 0.2, h * 0.38)
              ];
            } else if (id === 'battleship') {
              mainThrusters = [
                makeMain(aftX, -h * 0.28), makeMain(aftX, -h * 0.09),
                makeMain(aftX, h * 0.09), makeMain(aftX, h * 0.28)
              ];
              sideThrusters = [
                makeSide(-w * 0.2, -h * 0.5), makeSide(-w * 0.2, h * 0.5),
                makeSide(w * 0.24, -h * 0.36), makeSide(w * 0.24, h * 0.36)
              ];
            }
            // Atlas uses defaults from refreshShipGeometry
    
            if (mainThrusters.length) {
              player2Ship.visual.mainThrusters = mainThrusters;
              player2Ship.visual.torqueThrusters = sideThrusters;
              if (player2Ship.engines?.main && mainThrusters.length) {
                const first = mainThrusters[0];
                player2Ship.engines.main.vfxOffset = { ...first.offset };
                player2Ship.engines.main.vfxForward = { ...first.forward };
                player2Ship.engines.main.vfxYNudge = Number(first.yNudge) || 0;
                player2Ship.engines.main.vfxLengthMin = Number(first.vfxLengthMin) || 10;
                player2Ship.engines.main.vfxLengthMax = Number(first.vfxLengthMax) || 179;
              }
            }
          }
    
          // Load sprite and init hex body for P2
          const p2Sprite = new Image();
          player2Ship.spriteReady = false;
          player2Ship.renderSpriteImage = null;
          p2Sprite.onload = () => {
            const resolvedSize = getResolvedHullRenderSize(hullProfileId, p2Sprite, player2Ship.w, player2Ship.h);
            player2Ship.w = resolvedSize.w;
            player2Ship.h = resolvedSize.h;
            const renderImage = getPlayerHullRenderImage(p2Sprite, player2Ship.w, player2Ship.h) || p2Sprite;
            const hexInitImage = buildHexInitImageFromRenderSource(renderImage, player2Ship.w, player2Ship.h) || renderImage;
            player2Ship.renderSpriteImage = renderImage;
            player2Ship.spriteReady = true;
            player2Ship.spriteW = Math.max(1, Number(renderImage.width) || Number(p2Sprite.naturalWidth) || 1);
            player2Ship.spriteH = Math.max(1, Number(renderImage.height) || Number(p2Sprite.naturalHeight) || 1);
            // Init hex body for proper 3D/2D rendering
            initHexBody(player2Ship, hexInitImage);
            if (player2Ship.hexGrid) {
              player2Ship.hexGrid.visualImage = p2Sprite;
              player2Ship.hexGrid.meshDirty = true;
              player2Ship.hexGrid.meshDirtyAll = true;
              player2Ship.hexGrid.textureDirty = true;
              player2Ship.hexGrid.cacheDirty = true;
              player2Ship.hexGrid.gpuTextureNeedsUpdate = true;
            }
            if (player2Ship.hexGrid?.rawRadius && Number.isFinite(player2Ship.hexGrid.rawRadius)) {
              const scaleNow = Math.max(0.0001, Number(player2Ship.visual?.spriteScale) || 1);
              player2Ship.radius = player2Ship.hexGrid.rawRadius * scaleNow;
            }
            if (invalidateHexShipEntity3D) invalidateHexShipEntity3D(player2Ship);
            console.log('[SplitScreen] P2 sprite loaded & hexBody initialized:', hullKey);
          };
          p2Sprite.onerror = () => {
            console.warn('[SplitScreen] P2 sprite failed to load, using fallback');
            player2Ship.spriteReady = false;
          };
          p2Sprite.src = hull.spriteSrc || "assets/capital_ship_rect_v1.png";
    
          // Spawn near P1 (offset)
          player2Ship.pos.x = ship.pos.x + 2000;
          player2Ship.pos.y = ship.pos.y;
          player2Ship.vel = { x: 0, y: 0 };
          player2Ship.angle = ship.angle;
    
          // Create second camera
          const halfW = Math.floor(W / 2);
          camera2 = {
            x: player2Ship.pos.x, y: player2Ship.pos.y,
            targetX: player2Ship.pos.x, targetY: player2Ship.pos.y,
            zoom: camera.zoom, targetZoom: camera.targetZoom,
            minZoom: camera.minZoom, maxZoom: camera.maxZoom,
            mode: 'ship',
            // Split-screen viewport: right half
            viewportX: halfW, viewportY: 0,
            viewportW: W - halfW, viewportH: H,
            shakeMag: 0, shakeTime: 0, shakeDur: 0,
            addShake(mag, dur) { this.shakeMag = mag; this.shakeTime = dur; this.shakeDur = dur; }
          };
    
          // Set P1 camera viewport: left half
          camera.viewportX = 0;
          camera.viewportY = 0;
          camera.viewportW = halfW;
          camera.viewportH = H;
    
          // === P2 Weapons Setup ===
          // Generate hardpoints and mount default weapons for P2
          const p2Frame = SHIPS[hull.shipFrame || 'atlas'];
          if (p2Frame) {
            const p2Bounds = getPlayerHardpointBoundsForFrame(hull.shipFrame || 'atlas');
            player2Ship.hardpoints = generatePlayerHardpointsForFrame(hull.shipFrame || 'atlas', p2Frame, p2Bounds);
          } else {
            player2Ship.hardpoints = [];
          }
    
          // Mount weapons on P2 hardpoints (same defaults as P1)
          const p2ByType = {};
          for (const type of Object.values(HP)) p2ByType[type] = [];
          for (const hp of player2Ship.hardpoints) {
            if (hp.destroyed) continue;
            let weaponId = null;
            if (hp.type === HP.MAIN) weaponId = 'railgun_mk2';
            else if (hp.type === HP.MISSILE) weaponId = 'missile_rack';
            else if (hp.type === HP.AUX) weaponId = 'ciws_mk1';
            if (weaponId && WEAPONS[weaponId]) {
              hp.mount = weaponId;
              const weapon = WEAPONS[weaponId];
              if (weapon.ammo != null) hp.ammo = weapon.ammo;
              hp.missileCd = 0;
              p2ByType[hp.type].push({ hp, weapon });
            }
          }
          player2Ship.weapons = p2ByType;
    
          // Initialize P2 weapon controller
          p2WeaponCtrl = new WeaponController({
            ship: player2Ship,
            getMouseRef: () => mouse2,
            getLockedTarget: () => lockedTarget2,
            setLockedTarget: (t) => { lockedTarget2 = t; },
            getLockedTargets: () => [], // P2 didn't have radar scanner targets array, pass empty array to prevent error
            owner: 'player2',
            screenToWorldFn: (sx, sy) => {
              // P2 screenToWorld needs camera2 context
              const cam2 = camera2 || { x: 0, y: 0, zoom: 1 };
              return screenToWorld(sx, sy, cam2);
            }
          });
          window.p2WeaponCtrl = p2WeaponCtrl;
    
          window.player2Ship = player2Ship;
          window.camera2 = camera2;
          console.log('[SplitScreen] Player 2 created with weapons:', hullKey, p2ByType);
        }
        // ============== END SPLIT SCREEN LOGIC ==============
    
        if (continueButton) {
          continueButton.addEventListener('click', () => {
            if (!gameStarted) return;
            hideMainMenu();
          });
        }
        if (loadGameButton) {
          loadGameButton.title = 'Wkrotce dostepne';
        }
        let editorLaunchInProgress = false;
        async function openHardpointEditorFromMenu() {
          if (editorLaunchInProgress) return;
          editorLaunchInProgress = true;
          const menuWasVisible = isMainMenuVisible();
          const returnView = (menuView === 'options' || menuView === 'credits' || menuView === 'keybinds') ? menuView : 'home';
          try {
            showLoadingOverlay(0, 'Uruchamianie edytora');
            await nextFrame();
            setLoadingProgress(35, 'Ladowanie modulu');
            const { openHardpointEditor } = await import('./src/ui/hardpointEditor.js');
            setLoadingProgress(70, 'Inicjalizacja edytora');
            await nextFrame();
            if (menuWasVisible) {
              if (mainMenuEl) mainMenuEl.classList.add('hidden');
              toggleGameUI(false);
              window.__onHardpointEditorClosed = () => {
                showMainMenu(returnView);
              };
            } else {
              window.__onHardpointEditorClosed = null;
            }
            setLoadingProgress(100, 'Start');
            await nextFrame();
            openHardpointEditor();
          } catch (error) {
            window.__onHardpointEditorClosed = null;
            if (menuWasVisible) showMainMenu(returnView);
            console.error('Nie udalo sie otworzyc edytora hardpointow:', error);
          } finally {
            hideLoadingOverlay();
            editorLaunchInProgress = false;
          }
        }
        if (optionsButton) {
          optionsButton.title = 'Dostosuj jakosc tla';
          optionsButton.addEventListener('click', () => showMainMenu('options'));
        }
        if (editorButton) {
          editorButton.title = 'Otworz edytor hardpointow i dysz';
          editorButton.addEventListener('click', () => {
            openHardpointEditorFromMenu();
          });
        }
        if (keybindsButton) {
          keybindsButton.title = 'Zobacz aktualne przypisanie klawiszy';
          keybindsButton.addEventListener('click', () => showMainMenu('keybinds'));
        }
        if (optionsBackButton) {
          optionsBackButton.addEventListener('click', () => setMenuView('home'));
        }
        if (creditsButton) {
          creditsButton.title = 'Tworcy i dane projektu';
          creditsButton.addEventListener('click', () => showMainMenu('credits'));
        }
        if (creditsBackButton) {
          creditsBackButton.addEventListener('click', () => setMenuView('home'));
        }
        if (keybindsBackButton) {
          keybindsBackButton.addEventListener('click', () => setMenuView('home'));
        }
        if (qualityButtons && qualityButtons.length) {
          qualityButtons.forEach(btn => {
            btn.addEventListener('click', () => setBackgroundQuality(btn.dataset.quality));
          });
          applyQualitySelection();
        }
        if (supportGuardBtn) {
          supportGuardBtn.addEventListener('click', () => setSupportOrder('guard', { force: true }));
        }
        if (supportEngageBtn) {
          supportEngageBtn.addEventListener('click', () => setSupportOrder('engage', { force: true }));
        }
        if (supportFactionTerranBtn) {
          supportFactionTerranBtn.addEventListener('click', () => setSupportFaction('terran', { force: true }));
        }
        if (supportFactionPirateBtn) {
          supportFactionPirateBtn.addEventListener('click', () => setSupportFaction('pirate', { force: true }));
        }
        if (supportFactionIndependentBtn) {
          supportFactionIndependentBtn.addEventListener('click', () => setSupportFaction('independent', { force: true }));
        }
        if (supportLineModeBtn) {
          supportLineModeBtn.addEventListener('click', () => toggleLineSpawnMode());
        }
        window.addEventListener('mouseup', (event) => {
          if (endSupportDrag(event)) {
            event.preventDefault();
            event.stopPropagation();
          }
        }, true);
        if (energyShotBtn) {
          energyShotBtn.addEventListener('click', () => triggerEnergyShot());
        }
        if (shieldToggleBtn) {
          shieldToggleBtn.addEventListener('click', () => togglePlayerShieldForcedState());
        }
        if (globalShieldsToggleBtn) {
          globalShieldsToggleBtn.addEventListener('click', () => toggleGlobalShields());
        }
        refreshShieldControlButtons();
    
        // --- OBSLUGA JAKOSCI PLANET ---
    
        function updatePlanetQualityUI() {
          const current = window.OPTIONS.planetQuality || 'medium';
          document.querySelectorAll('[data-planet-q]').forEach(btn => {
            const isActive = (btn.dataset.planetQ === current);
            btn.classList.toggle('active', isActive);
            btn.setAttribute('aria-pressed', isActive);
          });
        }
    
        document.querySelectorAll('[data-planet-q]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const quality = e.target.dataset.planetQ;
            if (window.OPTIONS) window.OPTIONS.planetQuality = quality;
            localStorage.setItem('sc_planet_quality', quality);
            updatePlanetQualityUI();
            console.log(`Zmieniono jakość planet na: ${quality}`);
          });
        });
    
        window.addEventListener('DOMContentLoaded', () => {
          const saved = localStorage.getItem('sc_planet_quality');
          if (saved && window.OPTIONS) {
            window.OPTIONS.planetQuality = saved;
          }
          updatePlanetQualityUI();
        });
    
        // --- OBSLUGA JAKOSCI SMUG CIENI (shadow shafts) ---
    
        function updateShaftQualityUI() {
          const current = (window.OPTIONS && window.OPTIONS.shadowShafts) || 'medium';
          document.querySelectorAll('[data-shaft-q]').forEach(btn => {
            const isActive = (btn.dataset.shaftQ === current);
            btn.classList.toggle('active', isActive);
            btn.setAttribute('aria-pressed', isActive);
          });
        }
    
        function applyShaftQuality(quality) {
          if (window.OPTIONS) window.OPTIONS.shadowShafts = quality;
          if (typeof window.Core3DShaftQuality === 'function') window.Core3DShaftQuality(quality);
        }
    
        document.querySelectorAll('[data-shaft-q]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const quality = e.target.dataset.shaftQ;
            applyShaftQuality(quality);
            localStorage.setItem('sc_shadow_shafts', quality);
            updateShaftQualityUI();
            console.log(`Zmieniono jakość smug cieni na: ${quality}`);
          });
        });
    
        window.addEventListener('DOMContentLoaded', () => {
          const saved = localStorage.getItem('sc_shadow_shafts');
          if (saved) applyShaftQuality(saved);
          updateShaftQualityUI();
        });
    
        // --- LAKIER KADLUBOW (hullLacquer.js) ---
    
        function updateLacquerUI() {
          const current = (window.OPTIONS && window.OPTIONS.hullLacquer) || 'on';
          document.querySelectorAll('[data-lacquer]').forEach(btn => {
            const isActive = (btn.dataset.lacquer === current);
            btn.classList.toggle('active', isActive);
            btn.setAttribute('aria-pressed', isActive);
          });
        }
    
        function applyLacquer(mode) {
          if (window.OPTIONS) window.OPTIONS.hullLacquer = mode;
          if (typeof window.Core3DLacquer === 'function') window.Core3DLacquer(mode !== 'off');
        }
    
        document.querySelectorAll('[data-lacquer]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const mode = e.target.dataset.lacquer;
            applyLacquer(mode);
            localStorage.setItem('sc_hull_lacquer', mode);
            updateLacquerUI();
            console.log(`Lakier kadłubów: ${mode}`);
          });
        });
    
        window.addEventListener('DOMContentLoaded', () => {
          const saved = localStorage.getItem('sc_hull_lacquer');
          if (saved) applyLacquer(saved);
          updateLacquerUI();
        });
    
      </script>
    
      <script type="module">
        import { initDevTools } from './src/ui/devTools.js';
        import { initBloomTunerPanel } from './src/ui/bloomTunerPanel.js';
        import { initRingColorTunerPanel } from './src/ui/ringColorTunerPanel.js';
        import { initDestructorConfigPanel } from './src/ui/destructorConfigPanel.js';
        import { initDestructorMassPanel } from './src/ui/destructorMassPanel.js';
    
        window.addEventListener('DOMContentLoaded', () => {
          setTimeout(() => {
            initDevTools();
            initBloomTunerPanel({ enableHotkey: false });
            initRingColorTunerPanel();
            initDestructorConfigPanel();
            initDestructorMassPanel();
          }, 100);
        });
      </script>
    
    </body>
    
    </html>
    
