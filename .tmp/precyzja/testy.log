        // Cel = stacja piracka (mercMission.station albo pierwsza isPirate w stations).
        // Domyślnie lądujemy na ORBICIE ZEWNĘTRZNEJ misji (PIRATE_ORBIT.outerAu = 6 AU),
        // czyli w obrębie strefy misji, ale poza inner orbit — dolot i aggro zostają
        // po stronie gracza. Zrzut tuż przy kadłubie stacji nie dawał żadnego dystansu.
        // opts.orbit: 'outer' (domyślnie) | 'gravity' | 'inner' | 'close'
        function devTeleportToPirateStation(opts = {}) {
          const station = mercMission?.station
            || (Array.isArray(stations) ? stations.find(isPirateStation) : null);
          if (!station) return null;
    
          const radii = (typeof pirateOrbitRadii === 'function') ? pirateOrbitRadii() : null;
          const closeIn = Math.max(1200, (station.r || 600) * 2.2);
          const orbit = String(opts.orbit || 'outer');
          let standoff;
          if (orbit === 'close') standoff = closeIn;
          else if (orbit === 'inner') standoff = radii?.inner;
          else if (orbit === 'gravity') standoff = radii?.gravityWell;
