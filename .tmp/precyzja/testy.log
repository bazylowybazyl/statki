              h: Math.max(160, Number(Game.player?.spriteH) || 520)
            };
          }
          return {
            w: Math.max(120, Number(Game.player?.w) || 260),
            h: Math.max(120, Number(Game.player?.h) || 520)
          };
        }
    
        function generatePlayerHardpointsForFrame(frameId, frame, frameBounds) {
          const editorHardpoints = buildPlayerDefaultEditorHardpoints(frameId);
          if (editorHardpoints.length) return editorHardpoints;
