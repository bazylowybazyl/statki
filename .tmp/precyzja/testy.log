            ? (SUPPORT_SHIP_TEMPLATES.interceptor || SUPPORT_SHIP_TEMPLATES.fighter)
            : SUPPORT_SHIP_TEMPLATES.fighter;
          const f = makeNPCBase({ x: carrier.x, y: carrier.y }, { ...tmpl.stats, shield: tmpl.shield });
          f.friendly = carrier.friendly;
          f.isPirate = carrier.isPirate;
          f.mission = true;
          f.color = carrier.color;
          f.type = (squadronId === 'interceptor') ? 'interceptor' : 'fighter';
          applyFighterSquadronLoadout(f, squadronId);
          assignNpcShipFrame(f);
          f.squad = { leader: carrier };
          f.__carrierParent = carrier;
    
          // Kadłuby NPC nie mają w/h — połowę szerokości szacujemy z rozrzutu
          // hardpointów hangarów (i tak są przy burtach).
