        function onBridgeCommandLost(entity) {
          if (entity === ship) {
            pushZoneMessage('UTRATA DOWODZENIA — MOSTKI ZNISZCZONE', 3.2);
            releaseShipBridges(ship);
            if (!ship.destroyed) applyDamageToPlayer((Number(ship.hull?.val) || 0) + 1, { bypassShield: true });
            return;
          }
          if (entity.dead || entity.isWreck) return;
          beginBridgeHulk(entity);
          // Kadencja wykrywa kill do ~0,1 s po ostatnim trafieniu, a okno zasługi
          // (PLAYER_KILL_CREDIT_WINDOW) to 0,1 s czasu rzeczywistego — trafienie
          // gracza z ostatniej sekundy liczy się jak zabójcze.
          const hitAt = Number(entity._lastPlayerHit);
          const playerKill = Number.isFinite(hitAt) && gameTime - hitAt >= 0 && gameTime - hitAt <= TIME_SCALE;
          if (playerKill) entity._lastPlayerHit = gameTime;
          registerFactionKill(entity);
          if (playerKill) pushZoneMessage(`${String(formatNpcName(entity) || 'CEL').toUpperCase()}: UTRATA DOWODZENIA`, 2.4);
        }
    
        function updateHardpointIntegrity(dt, entities) {
          let playerChanged = false;
          if (updateEntityHardpointIntegrity(ship, dt)) playerChanged = true;
          if (updateEntityCoreIntegrity(ship, dt)) playerChanged = true;
          tickShipBridges(ship, dt);
          if (Array.isArray(entities)) {
            for (let i = 0; i < entities.length; i++) {
              const entity = entities[i];
              if (!entity || entity === ship || entity.dead || entity.isWreck) continue;
              updateEntityHardpointIntegrity(entity, dt);
              updateEntityCoreIntegrity(entity, dt);
              tickShipBridges(entity, dt);
            }
          }
          if (playerChanged) {
            syncWeaponSystems();
            if (typeof renderMechanic === 'function') renderMechanic();
          }
        }
    
        function syncCiwsFromAuxLoadout(auxLoadouts) {
          const prev = Array.isArray(ship.ciws) ? ship.ciws : [];
          const prevByHpId = new Map();
          for (let i = 0; i < prev.length; i++) {
            const entry = prev[i];
            if (!entry || !entry.hpId) continue;
            prevByHpId.set(entry.hpId, entry);
          }
    
          const next = [];
          for (let i = 0; i < auxLoadouts.length; i++) {
            const loadout = auxLoadouts[i];
            const hp = loadout?.hp;
            if (!hp?.pos) continue;
            const previous = prevByHpId.get(hp.id);
            next.push({
              hpId: hp.id,
              offset: { x: Number(hp.pos.x) || 0, y: Number(hp.pos.y) || 0 },
              angle: Number.isFinite(previous?.angle) ? previous.angle : 0,
              angVel: Number.isFinite(previous?.angVel) ? previous.angVel : 0,
              cd: Number.isFinite(previous?.cd) ? previous.cd : 0
            });
          }
    
          ship.ciws = next;
        }
    
        function updateMainWeaponBehavior() {
          if (!rail) return;
          const mainWeapons = Game.player.weapons?.[HP.MAIN] || [];
          let cdMax = 0.15;
          let barrels = 2;
    
          if (mainWeapons.length) {
            const weapon = mainWeapons[0].weapon;
            if (weapon) {
              cdMax = weapon.cooldown || 0.15;
              barrels = Number.isFinite(Number(weapon.barrelsPerShot))
                ? Math.max(1, Math.round(Number(weapon.barrelsPerShot)))
                : (weapon.size === 'L' ? 1 : 2);
            }
          }
    
          rail.cdMax = cdMax;
          rail.shotGap = 0.08;
          rail.burstGap = cdMax;
          rail.burstsPerClick = 1;
          rail.barrelsPerShot = barrels;
        }
    
        function missileAmmoTotal() {
          let total = 0;
          for (const hp of Game.player.hardpoints) {
            if (hp.type === HP.MISSILE && hp.mount && !hp.destroyed) {
              if (typeof hp.ammo === 'number') total += hp.ammo;
            }
          }
          return total;
        }
    
        function missileAmmoCapacity() {
          let total = 0;
          for (const hp of Game.player.hardpoints) {
            if (hp.type === HP.MISSILE && hp.mount && !hp.destroyed) {
              if (typeof hp.maxAmmo === 'number') total += hp.maxAmmo;
            }
          }
          return total;
        }
    
        function restoreHardpointMountEntry(hp, entry) {
          if (!hp || !entry) return;
          if (hp.type === HP.HANGAR) {
            const squadronMounts = Array.isArray(entry.hangarSquadrons) && entry.hangarSquadrons.length
              ? entry.hangarSquadrons
              : (entry.weaponId ? [entry.weaponId] : []);
            setHardpointHangarSquadrons(hp, squadronMounts);
            return;
          }
          // Zapisany fit jest źródłem prawdy dla tego, co WISI NA KADŁUBIE — ładownia
          // ma tylko tego nie dublować. Wcześniej stało tu `skipInventory: true`, przez
          // co sztuki zdjęte z ładowni przez automount przepadały razem ze starą tablicą
          // hardpointów. Teraz montaż normalnie je pobiera, a gdy sztuki brakuje (broń
          // kupiona albo zlootowana — ładownia nie jest zapisywana do localStorage),
          // dokładamy ją i zaraz zdejmujemy montażem. Warunek `hp.mount !== weaponId`
          // pilnuje, żeby odtworzenie TEGO SAMEGO działa nie wyprodukowało sztuki z niczego.
          const inventory = Game.player?.inventory;
          if (entry.weaponId && inventory && hp.mount !== entry.weaponId && !inventory.has(entry.weaponId)) {
            inventory.give(entry.weaponId, 1);
          }
          setHardpointMount(hp, entry.weaponId, { ammo: entry.ammo, maxAmmo: entry.maxAmmo });
        }
    
        function tryPreserveMounts(previous) {
          if (!previous) return;
          const byType = new Map();
          for (const hp of previous) {
            const hangarSquadrons = hp.type === HP.HANGAR ? getHardpointHangarSquadrons(hp) : [];
            if (!hp.mount && hangarSquadrons.length === 0) continue;
            const entry = { weaponId: hp.mount, ammo: hp.ammo, maxAmmo: hp.maxAmmo, hangarSquadrons };
            if (!byType.has(hp.type)) byType.set(hp.type, []);
            byType.get(hp.type).push(entry);
          }
          for (const hp of Game.player.hardpoints) {
            const arr = byType.get(hp.type);
            if (arr && arr.length) {
              const entry = arr.shift();
              restoreHardpointMountEntry(hp, entry);
            }
          }
        }
    
        function saveLoadout() {
          // Po klikniecu "Wyzeruj zapis" w DevTools zapis jest zamkniety na klucz, zeby
          // `beforeunload` nie odtworzyl wlasnie wyczyszczonego `loadout` (patrz <head>).
          if (window.__SAVE_LOCKED) return;
          try {
            syncPlayerHullSnapshot();
            const activeHullId = normalizePlayerHullId(PLAYER.activeHullId || ship.activeHullId || DEFAULT_PLAYER_HULL_ID);
            const activeHullDef = getPlayerHullDef(activeHullId);
            localStorage.setItem('loadout', JSON.stringify({
              activeHullId,
              ownedHullIds: [...getPlayerOwnedHullIds()],
              shipFrame: activeHullDef?.shipFrame || Game.player.shipFrame || DEFAULT_PLAYER_HULL_ID,
              hullChips: serializeHullChips(PLAYER.hullChips),
              hardpoints: Game.player.hardpoints.map(h => ({
                id: h.id,
                type: h.type,
                mount: h.mount,
                ammo: h.ammo,
                maxAmmo: h.maxAmmo,
                hangarSquadrons: h.type === HP.HANGAR ? getHardpointHangarSquadrons(h) : undefined
              }))
            }));
          } catch (e) { console.warn('Loadout save error', e); }
        }
    
        function loadLoadout() {
          const raw = localStorage.getItem('loadout');
          if (!raw) { syncWeaponSystems(); return; }
          try {
            const data = JSON.parse(raw);
            const loadedOwned = Array.isArray(data?.ownedHullIds) ? data.ownedHullIds : [];
            for (const hullId of loadedOwned) ensurePlayerOwnsHull(hullId);
            // Zapis sprzed chipów nie ma pola — wtedy brak chipów.
            PLAYER.hullChips = normalizeHullChips(data?.hullChips, {
              isValidHull: (hullId) => !!PLAYER_HULL_CATALOG[hullId]
            });
            const requestedHull = normalizePlayerHullId(data?.activeHullId || PLAYER.activeHullId || DEFAULT_PLAYER_HULL_ID);
            ensurePlayerOwnsHull(requestedHull);
            applyPlayerHullProfile(requestedHull, { preserveDamageRatio: true, syncVisuals: true, persist: false });
            const expectedFrame = getPlayerHullDef(requestedHull)?.shipFrame;
            if (expectedFrame && SHIPS[expectedFrame]) Game.player.shipFrame = expectedFrame;
            const frame = SHIPS[Game.player.shipFrame];
            if (frame) {
              const bounds = getPlayerHardpointBoundsForFrame(Game.player.shipFrame);
              const fresh = generatePlayerHardpointsForFrame(Game.player.shipFrame, frame, bounds);
              const savedByType = new Map();
              for (const saved of (data.hardpoints || [])) {
                // BEZPIECZEŃSTWO: Jeśli broń nie istnieje w nowym systemie, omiń ją (zapobiegnie znikaniu i crashom)
                const hangarSquadrons = saved.type === HP.HANGAR
                  ? normalizeHangarSquadronMounts(
                    Array.isArray(saved.hangarSquadrons) && saved.hangarSquadrons.length
                      ? saved.hangarSquadrons
                      : (saved.mount ? [saved.mount] : []),
                    99
                  )
                  : [];
                if ((!saved.mount || !WEAPONS[saved.mount]) && hangarSquadrons.length === 0) continue;
                // Broń mogła zmienić rodzaj gniazda już po zapisie — hexlance przeszedł
                // ze `special` na `builtin` (2026-04-11). Kubełkujemy po AKTUALNYM
                // mountType, nie po typie z zapisu: inaczej wpis ląduje na gnieździe
                // special, setHardpointMount go odrzuca (mountType !== hp.type)
                // i broń znika bez śladu, a gniazdo builtin zostaje puste.
                const bucket = WEAPONS[saved.mount]?.mountType || saved.type;
                if (!savedByType.has(bucket)) savedByType.set(bucket, []);
                savedByType.get(bucket).push({ ...saved, hangarSquadrons });
              }
              // Automount przed chwilą wyjął domyślny fit z ładowni, a my zaraz
              // podmienimy całą tablicę hardpointów na `fresh`. Bez zwrotu te sztuki
              // wyparowują — tak właśnie ginął hexlance przy zapisie bez gniazda
              // built-in: nie było go ani na kadłubie, ani w magazynie.
              reclaimMountedWeaponsToInventory();
              for (const hp of fresh) {
                const arr = savedByType.get(hp.type);
                if (arr && arr.length) {
                  const saved = arr.shift();
                  restoreHardpointMountEntry(hp, {
                    weaponId: saved.mount,
                    ammo: saved.ammo,
                    maxAmmo: saved.maxAmmo,
                    hangarSquadrons: saved.hangarSquadrons
                  });
                }
              }
              Game.player.hardpoints = fresh;
            }
          } catch (e) {
            console.warn('Loadout parse error', e);
          }
          syncPlayerHullSnapshot();
          syncWeaponSystems();
          if (typeof renderMechanic === 'function') renderMechanic();
        }
    
        function applyHardpointEditorConfigToRunningGame() {
          try {
            npcHardpointRuntime.refreshCache(true);
          } catch { }
    
          const prev = Array.isArray(Game.player?.hardpoints)
            ? Game.player.hardpoints.map(h => ({
              type: h.type,
              mount: h.mount,
              ammo: h.ammo,
              maxAmmo: h.maxAmmo,
              hangarSquadrons: h.type === HP.HANGAR ? getHardpointHangarSquadrons(h) : undefined
            }))
            : [];
    
          applyPlayerEditorEngineLayoutFromStorage();
          rebuildHardpointsForFrame();
          if (prev.length) tryPreserveMounts(prev);
          syncWeaponSystems();
          if (typeof renderMechanic === 'function') renderMechanic();
    
          const npcList = Array.isArray(window.npcs) ? window.npcs : [];
          for (let i = 0; i < npcList.length; i++) {
            try { applyEditorLayoutToNpc(npcList[i]); } catch { }
          }
        }
    
        window.__applyHardpointEditorConfig = (configData) => {
          if (configData && typeof configData === 'object') {
            try { localStorage.setItem('hpEditor.v1', JSON.stringify(configData)); } catch { }
          }
          applyHardpointEditorConfigToRunningGame();
          return true;
        };
    
        window.addEventListener('beforeunload', saveLoadout);
    
        // =============== Floating HUD state ===============
        const HUD = {
          navArrows: [], // niebieskie strzałki po X: {x,y,age,life}
        };
    
    
        function hudPingNpcStations() {
          // Niebieskie strzałki do stacji nie-misyjnych; gasną po 4s
          const targets = stations.filter(s => !s.mission).slice(0, 8);
          HUD.navArrows = targets.map(s => ({ x: s.x, y: s.y, age: 0, life: 4.0 }));
        }
        function hudUpdateNav(dt) {
          for (const p of HUD.navArrows) p.age += dt;
          HUD.navArrows = HUD.navArrows.filter(p => p.age < p.life);
        }
    
        function drawArrowOnRing(cx, cy, R, ang, size, color) {
          const x = cx + Math.cos(ang) * R, y = cy + Math.sin(ang) * R;
          ctx.save(); ctx.translate(x, y); ctx.rotate(ang);
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.moveTo(size, 0);
          ctx.lineTo(-size * 0.6, size * 0.6);
          ctx.lineTo(-size * 0.2, 0);
          ctx.lineTo(-size * 0.6, -size * 0.6);
          ctx.closePath(); ctx.fill();
          ctx.restore();
        }
        function hudRenderNav(ship, cam) {
          if (!HUD.navArrows.length) return;
          const s = worldToScreen(ship.pos.x, ship.pos.y, cam);
          const R = Math.max(ship.w, ship.h) * camera.zoom * 0.6 + 30;
          for (const p of HUD.navArrows) {
            const ang = Math.atan2(p.y - ship.pos.y, p.x - ship.pos.x);
            const a = Math.max(0, 1 - p.age / p.life);
            ctx.save(); ctx.globalAlpha = 0.3 + 0.7 * a;
            drawArrowOnRing(s.x, s.y, R, ang, 12, '#60a5fa');
            ctx.restore();
          }
        }
    
        function drawStabilizerHeadingMarker(ship, cam, renderPos = null, renderAngle = null) {
          if (!flightAssist?.stabilizer || !ship || ship.destroyed) return;
          const st = ship.__stabilizerState;
          const targetAngle = Number.isFinite(Number(st?.output?.targetAngle))
            ? Number(st.output.targetAngle)
            : Number(st?.targetAngle);
          if (!Number.isFinite(targetAngle)) return;
    
          const pos = renderPos || ship.pos;
          const s = worldToScreen(pos.x, pos.y, cam);
          const zoom = Math.max(0.0001, Number(cam?.zoom) || Number(camera.zoom) || 1);
          const baseRadius = Math.max(ship.radius || 0, ship.w || 0, ship.h || 0);
          const innerR = Math.max(34, baseRadius * zoom * 0.34);
          const outerR = Math.max(innerR + 34, baseRadius * zoom * 0.62 + 42);
          const dx = Math.cos(targetAngle);
          const dy = Math.sin(targetAngle);
          const currentAngle = Number.isFinite(Number(renderAngle)) ? Number(renderAngle) : (Number(ship.angle) || 0);
          const error = wrapAngle(targetAngle - currentAngle);
          const errorNorm = clamp(Math.abs(error) / (Math.PI / 3), 0, 1);
          const color = errorNorm > 0.32 ? 'rgba(255,216,116,0.96)' : 'rgba(96,232,255,0.96)';
          const softColor = errorNorm > 0.32 ? 'rgba(255,180,82,0.26)' : 'rgba(85,210,255,0.24)';
    
          ctx.save();
          ctx.globalCompositeOperation = 'lighter';
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.shadowBlur = 16;
          ctx.shadowColor = color;
    
          ctx.strokeStyle = softColor;
          ctx.lineWidth = 8;
          ctx.beginPath();
          ctx.moveTo(s.x + dx * innerR, s.y + dy * innerR);
          ctx.lineTo(s.x + dx * outerR, s.y + dy * outerR);
          ctx.stroke();
    
          ctx.strokeStyle = color;
          ctx.lineWidth = 2.2;
          ctx.setLineDash([10, 9]);
          ctx.beginPath();
          ctx.moveTo(s.x + dx * innerR, s.y + dy * innerR);
          ctx.lineTo(s.x + dx * outerR, s.y + dy * outerR);
          ctx.stroke();
          ctx.setLineDash([]);
    
          if (Math.abs(error) > 0.015) {
            ctx.globalAlpha = 0.55;
            ctx.strokeStyle = color;
            ctx.lineWidth = 1.8;
            ctx.beginPath();
            ctx.arc(s.x, s.y, innerR + 9, currentAngle, targetAngle, error < 0);
            ctx.stroke();
            ctx.globalAlpha = 1;
          }
    
          ctx.translate(s.x + dx * outerR, s.y + dy * outerR);
          ctx.rotate(targetAngle);
          const size = clamp(13 * Math.sqrt(zoom), 10, 18);
          ctx.fillStyle = color;
          ctx.strokeStyle = 'rgba(4,10,20,0.75)';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(size * 1.15, 0);
          ctx.lineTo(-size * 0.72, -size * 0.7);
          ctx.lineTo(-size * 0.28, 0);
          ctx.lineTo(-size * 0.72, size * 0.7);
          ctx.closePath();
          ctx.stroke();
          ctx.fill();
          ctx.restore();
        }
    
        // =============== Zoom indicator ===============
        const zoomIndicatorEl = document.getElementById('zoom-indicator');
        const zoomIndicator = {
          el: zoomIndicatorEl,
          timer: 0,
          hold: 1.2,
          visible: false,
          update(dt) {
            if (!this.el) return;
            if (this.timer > 0) {
              this.timer -= dt;
              if (this.timer <= 0 && this.visible) {
                this.visible = false;
                this.el.classList.remove('visible');
              }
            }
          },
          show(zoomValue) {
            if (!this.el) return;
            const normalized = clamp(zoomValue / Math.max(0.0001, camera.maxZoom || 1), 0, 1);
            const display = normalized >= 0.995 ? 1 : Math.max(0.01, normalized);
            this.el.textContent = `ZOOM X${display.toFixed(display >= 1 ? 0 : 2)}`;
            this.timer = this.hold;
            this.visible = true;
            this.el.classList.add('visible');
          }
        };
    
        // =============== Game time (1 min real = 1 h game) ===============
        let gameTime = 0; // seconds
    
        const HUD_RADAR_REFRESH_MS = 80;
        const HUD_RADAR_FAR_REFRESH_MS = 120;
        const HUD_RADAR_RANGE = 20000;
        let hudRadarSnapshot = null;
        let hudRadarLastRefreshMs = 0;
        let hudRadarWorldFeatures = [];
    
        function getHudRadarRefreshMs(range) {
          const safeRange = Math.max(1, Number(range) || HUD_RADAR_RANGE);
          if (safeRange >= 60000) return HUD_RADAR_FAR_REFRESH_MS;
          if (safeRange >= 40000) return 90;
          return HUD_RADAR_REFRESH_MS;
        }
    
        function updatePlayerStatusUI() {
          // --- POPRAWKA: Jeśli menu jest otwarte, przerywamy ---
          if (isMainMenuVisible()) return;
          // -----------------------------------------------------
    
          if (!window.hudSystem) return;
          const boostFuelMax = boost?.fuelMax || 1;
          const sysData = {
            power: (enginePower?.current ?? 0) * 100,
            boost: (boost?.fuel ?? 0) / boostFuelMax * 100,
            warpState: warp?.state,
            warpCharge: warp?.charge ?? 0,
            warpMax: warp?.chargeTime ?? 1,
            warpSpeed: warp?.speed ?? 0,
            driveMode: driveState.mode,
            driveModeLabel: getDriveMode(driveState).label,
            driveGear: driveState.gear,
            driveGearCount: driveState.gearCount,
            driveRpm: driveState.rpm,
            driveShiftCueIntensity: driveState.shiftCueIntensity,
            driveShiftCueDanger: driveState.shiftCueDanger,
            driveAuto: driveState.auto,
            driveShiftBoost: driveState.shiftBoostTimer > 0,
            driveSpeedLimit: driveState.speedLimit,
            driveModeMaxSpeed: driveState.modeMaxSpeed
          };
          const nowMs = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
          const hudRadarRange = window.hudSystem?.getRadarRange?.() || HUD_RADAR_RANGE;
          const hudRadarRefreshMs = getHudRadarRefreshMs(hudRadarRange);
          if (!hudRadarSnapshot
            || Number(hudRadarSnapshot?.range) !== hudRadarRange
            || (nowMs - hudRadarLastRefreshMs) >= hudRadarRefreshMs) {
            hudRadarSnapshot = CICDisplay.getHudRadarSnapshot({
              ship,
              npcs,
              SensorSystem,
              asteroidField: window.asteroidField || null,
              asteroidRange: typeof getScannerAsteroidRange === 'function' ? getScannerAsteroidRange() : 60000,
              lockedTargets,
              selectedTarget: scannerSelectedTarget || lockedTarget,
              worldFeatures: hudRadarWorldFeatures,
              range: hudRadarRange,
              maxContacts: 48,
              maxAsteroidContacts: 24
            });
            hudRadarLastRefreshMs = nowMs;
          }
          const envData = {
            locationName: zoneState.current?.label || 'UNKNOWN SECTOR',
            bannerMessage: zoneState.messages[0] || null,
            weaponHud: buildWeaponHudState(),
            radar: hudRadarSnapshot,
            // Karta celu i wyniki skanu w kokpicie (src/ui/cockpitUI.js).
            target: scannerSelectedTarget || lockedTarget || null,
            lockedTargets,
            scanSerial: scannerState.burstSerial,
            repairActive: playerRepairActive,
            boostActive: boost?.state === 'active',
            hangar: getHudHangarState()
          };
          window.hudSystem.update(ship, sysData, envData);
        }
    
        // Jeden obiekt na cały bieg — HUD czyta go co klatkę.
        const hudHangarState = { mounted: 0, out: 0 };
        function getHudHangarState() {
          hudHangarState.mounted = Game.player?.weapons?.[HP.HANGAR]?.length || 0;
          hudHangarState.out = SQUAD.list.length;
          return hudHangarState;
        }
    
        function getHudWeaponByType(type) {
          const entries = Game.player?.weapons?.[type] || [];
          for (let i = 0; i < entries.length; i++) {
            const weapon = entries[i]?.weapon;
            if (weapon) return weapon;
          }
          return null;
        }
    
        function getMainWeaponHudCharge() {
          const weapon = getHudWeaponByType(HP.MAIN);
          const cdMax = Math.max(0.01, Number(rail?.cdMax) || Number(weapon?.cooldown) || 0.15);
          const barrels = Math.max(1, Number(rail?.barrelsPerShot) || 1);
          const cdLeft = barrels > 1
            ? Math.max(Number(rail?.cd?.[0]) || 0, Number(rail?.cd?.[1]) || 0)
            : Math.max(0, Number(rail?.cd?.[0]) || 0);
          return clamp(1 - (cdLeft / cdMax), 0, 1);
        }
    
        // `ready` znaczy „naciśnięcie 4 coś zrobi", a NIE „superbroń jest naładowana".
        // Kokpit wiąże z tym klasę `unavailable` (pointer-events: none), więc gdyby
        // `ready` szło za `armed`, przycisk byłby martwy poza pięciosekundowym oknem
        // po naładowaniu. Built-in nie ma auto-fire, więc nie ma czego przełączać.
        function getBuiltInWeaponHudState() {
          const builtins = Game.player?.weapons?.[HP.BUILTIN] || [];
          const hexlance = builtins.find(loadout => loadout?.weapon?.id === 'hexlance_siege')?.weapon || null;
          if (hexlance) {
            const sw = Superweapon?.superweaponState || null;
            if (!sw) return { weapon: hexlance, charge: 1, ready: true };
            if (sw.charging) {
              // W trakcie ładowania klawisz nic nie robi — tryFireSuperweapon odbija.
              return { weapon: hexlance, charge: clamp((Number(sw.chargeProgress) || 0) / Math.max(0.01, Number(sw.chargeTime) || 1), 0, 1), ready: false };
            }
            if (sw.armed) {
              return { weapon: hexlance, charge: 1, armed: true, ready: true };
            }
            const cdLeft = Math.max(0, Number(sw.cooldown) || 0);
            const cdMax = Math.max(0.01, Number(sw.cooldownMax) || cdLeft || 1);
