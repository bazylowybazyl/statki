            const row = Math.floor(idx / 2) + 1;
            f.formationOffset = { x: -row * 60, y: side * row * 45 };
            f.vx = carrier.vx || 0;
            f.vy = carrier.vy || 0;
            f.angle = carrier.angle || 0;
          }
    
          npcs.push(f);
          (carrier.__hangarFighters || (carrier.__hangarFighters = [])).push(f);
        }
    
        function flushCarrierSpawns(dt) {
          if (__carrierSpawnQueue.length === 0) return;
          const step = Number(dt) || 0;
          let write = 0;
          for (let i = 0; i < __carrierSpawnQueue.length; i++) {
            const req = __carrierSpawnQueue[i];
            req.delay = (req.delay || 0) - step;
            if (req.delay > 0) {
              __carrierSpawnQueue[write++] = req;
              continue;
            }
            if (req.carrier && !req.carrier.dead) {
              spawnCarrierFighter(req.carrier, req.squadronId, req.idx, req.tube, req.slotInTube);
            }
          }
          __carrierSpawnQueue.length = write;
        }
    
        const SUPPORT_SHIP_CONFIGURERS = {
          fighter(npc) {
