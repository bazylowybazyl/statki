        }
    
        function drawFlyingHexDebris(ctx, cam) {
          const debris = window.flyingHexDebris;
          if (!debris || debris.length === 0) return;
          ctx.save();
          for (const d of debris) {
            const alpha = Math.max(0, d.life * d.life);
            if (alpha < 0.01) continue;
            const s = worldToScreen(d.x, d.y, cam);
            const screenR = d.hexR * cam.zoom;
            if (screenR < 0.3) continue;
            ctx.save();
            ctx.translate(s.x, s.y);
            ctx.rotate(d.angle);
            ctx.globalAlpha = alpha;
            const heatT = Math.max(0, Math.min(1, d.life * 2 - 0.3));
            const r = Math.round(70 + heatT * 185);
            const g = Math.round(80 + heatT * 70);
            const b = Math.round(100 - heatT * 55);
            ctx.fillStyle = `rgb(${r},${g},${b})`;
            ctx.beginPath();
            for (let i = 0; i < 6; i++) {
              const a = (i / 6) * Math.PI * 2;
              if (i === 0) ctx.moveTo(Math.cos(a) * screenR, Math.sin(a) * screenR);
              else ctx.lineTo(Math.cos(a) * screenR, Math.sin(a) * screenR);
            }
            ctx.closePath();
            ctx.fill();
            ctx.strokeStyle = `rgba(0,0,0,${0.5 * alpha})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
            ctx.restore();
          }
          ctx.restore();
