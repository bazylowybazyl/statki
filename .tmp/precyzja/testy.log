        const CAPITAL_KILL_TYPES = new Set(['battleship', 'carrier', 'supercapital', 'megafreighter', 'dreadnought']);
    
        // Okno, w którym zabójstwo jest jeszcze przypisywane graczowi. Bez tego
        // dobicie przez piratów celu, który gracz nadgryzł sekundę wcześniej,
        // liczyłoby się jako cudza zasługa (albo cudza wina).
        const PLAYER_KILL_CREDIT_WINDOW = 6;
    
        function markPlayerDamage(entity) {
          if (entity && !entity.dead) entity._lastPlayerHit = gameTime;
        }
        window.markPlayerDamage = markPlayerDamage;
    
        /**
         * Reputacyjny skutek zabicia jednostki. Liczy się TYLKO to, co zabił gracz —
         * inaczej piraci strzelający do frachtowców psuliby graczowi stosunki.
         * Kary nie ma też za dobijanie kogoś, kto już jest z graczem w stanie wojny:
         * wtedy to nie zbrodnia, tylko walka.
         */
        function registerFactionKill(npc) {
          const hitAt = Number(npc?._lastPlayerHit);
          if (!Number.isFinite(hitAt) || gameTime - hitAt > PLAYER_KILL_CREDIT_WINDOW) return;
          const faction = resolveEntityFaction(npc);
          if (!faction) return;
          const standing = resolveStanding(PLAYER.reputation[faction]);
          if (standing.patrolsAttack) return;
          const isCapital = CAPITAL_KILL_TYPES.has(String(npc.type || '').toLowerCase())
            || CAPITAL_KILL_TYPES.has(String(npc.shipFrame || '').toLowerCase());
          const penalty = isCapital ? REPUTATION_EVENTS.killedCapital : REPUTATION_EVENTS.killedShip;
          changePlayerReputation(faction, penalty, 'zniszczona jednostka');
        }
    
        function isHostileNpc(n) {
          if (!n || n.dead) return false;
          return isEntityHostileToPlayer(n);
        }
        window.isHostileNpc = isHostileNpc;
        window.isTargetAlive = isTargetAlive;
        window.isLockableTarget = isLockableTarget;
        window.getTargetX = getTargetX;
        window.getTargetY = getTargetY;
        window.getTargetRadius = getTargetRadius;
    
        function isCommandEntityAlive(entity) {
          return isTargetAlive(entity);
        }
    
        function isValidLockedTarget(target) {
          return isLockableTarget(target);
        }
    
        function playerTargetDistance(target) {
          return Math.hypot(getTargetX(target) - ship.pos.x, getTargetY(target) - ship.pos.y);
        }
    
        function formatSensorRange(value) {
          return formatLocalDistance(value);
        }
    
        function isPlayerLockTargetInRange(target) {
          return isTargetWithinSensorRange(ship, target, 'lockRange');
        }
    
        function canPlayerLockTarget(target) {
          return isValidLockedTarget(target) && isPlayerLockTargetInRange(target);
        }
    
        function warnTargetOutOfLockRange(target) {
          const sensors = getScannerSensors();
          pushZoneMessage(`LOCK: CEL POZA ZASIEGIEM (${formatSensorRange(playerTargetDistance(target))}/${formatSensorRange(sensors.lockRange)})`, 1.25);
        }
    
        function isFriendlyScanTarget(n) {
          return !!(n && !n.dead && n.friendly);
        }
        function getScanObjectRadius(obj) {
          return Math.max(18, getTargetRadius(obj));
        }
        function pushScannerContact(target, type, tone, distance, out = scannerContacts) {
          if (!isTargetAlive(target)) return;
          if (type === 'station' || type === 'platform') target.__scannerContactType = type;
          out.push(buildScannerContact({
            target,
            type,
            tone,
            distance: Number.isFinite(distance) ? distance : 0,
            label: isAsteroidTarget(target) ? '' : getRadarTargetUnitId(target),
            classLabel: isAsteroidTarget(target) ? '' : getRadarTargetUnitClass(target)
          }));
        }
        function buildScannerStationDirectoryContacts() {
          const contacts = buildStationDirectoryContacts(stations, { ship, limit: 3 });
          for (const contact of contacts) {
            if (contact?.target) contact.target.__scannerContactType = 'station';
          }
          return contacts;
        }
        function collectScannerContacts(opts = {}) {
          const contacts = [];
          const range = Math.max(0, Number(opts.range) || getScannerActiveRange());
          const asteroidRangeValue = opts.asteroidRange == null ? getScannerAsteroidRange() : Number(opts.asteroidRange);
          const asteroidRange = Math.min(
            range,
            Math.max(0, Number.isFinite(Number(asteroidRangeValue)) ? Number(asteroidRangeValue) : getScannerAsteroidRange())
          );
          const includeAsteroids = opts.includeAsteroids !== false;
          const sweepSort = opts.sweepSort !== false;
          const rangeSq = range * range;
          const inRange = (obj) => {
            const dx = getTargetX(obj) - ship.pos.x;
            const dy = getTargetY(obj) - ship.pos.y;
            return dx * dx + dy * dy <= rangeSq;
          };
    
          for (const npc of npcs) {
            if (!npc || npc.dead || !inRange(npc)) continue;
            const dist = Math.hypot(getTargetX(npc) - ship.pos.x, getTargetY(npc) - ship.pos.y);
            if (isHostileNpc(npc)) {
              pushScannerContact(npc, 'ship', 'hostile', dist, contacts);
            } else if (isFriendlyScanTarget(npc)) {
              pushScannerContact(npc, 'ship', 'friendly', dist, contacts);
            } else {
              pushScannerContact(npc, 'ship', 'neutral', dist, contacts);
            }
          }
    
          for (const contact of buildScannerStationDirectoryContacts()) {
            if (!contact?.target || !inRange(contact.target)) continue;
            contacts.push(contact);
          }
    
          if (mercMission && mercMission.weaponPlatforms) {
            for (const platform of mercMission.weaponPlatforms) {
              if (!platform || platform.destroyed || platform.removed || !inRange(platform)) continue;
              const dist = Math.hypot(getTargetX(platform) - ship.pos.x, getTargetY(platform) - ship.pos.y);
              pushScannerContact(platform, 'platform', 'hostile', dist, contacts);
            }
          }
    
          if (includeAsteroids && asteroidRange > 0 && window.asteroidField?.queryRadius) {
            const asteroids = window.asteroidField.queryRadius(ship.pos.x, ship.pos.y, asteroidRange) || [];
            const nearestAsteroids = selectNearestAsteroidTargets(asteroids, {
              centerX: ship.pos.x,
              centerY: ship.pos.y,
              limit: SCANNER_ASTEROID_CONTACT_LIMIT
            });
            for (const entry of nearestAsteroids) {
              pushScannerContact(entry.asteroid, 'asteroid', 'resource', entry.distance, contacts);
            }
          }
    
          return sweepSort ? sortScannerSweepContacts(contacts) : sortScannerContacts(contacts);
        }
    
        function refreshScannerPassiveContacts(force = false) {
          const now = performance.now();
          if (!force && now - scannerPassiveContactsAt < SCANNER_PASSIVE_REFRESH_MS) return;
          const sorted = collectScannerContacts({
            range: getScannerPassiveRange(),
            includeAsteroids: false,
            sweepSort: false
          });
          scannerPassiveContacts.length = 0;
          scannerPassiveContacts.push(...sorted);
          scannerPassiveContactsAt = now;
        }
    
        function invalidateScannerPassiveContacts() {
          scannerPassiveContactsAt = Number.NEGATIVE_INFINITY;
        }
    
        function getScannerOverviewContacts() {
          refreshScannerPassiveContacts(false);
          refreshScannerContactDistances(scannerContacts, ship);
          refreshScannerContactDistances(scannerPassiveContacts, ship);
