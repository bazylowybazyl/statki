        function setTargetingMode(nextMode) {
          const next = Math.max(TARGETING_MODE.SINGLE, Math.min(TARGETING_MODE.SELECT, Number(nextMode) || 0));
          if (next === targetingMode.current) return;
          targetingMode.current = next;
