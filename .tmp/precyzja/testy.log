          ctx.moveTo(_colDbgQuad[0].x, _colDbgQuad[0].y);
          ctx.lineTo(_colDbgQuad[1].x, _colDbgQuad[1].y);
          ctx.lineTo(_colDbgQuad[2].x, _colDbgQuad[2].y);
          ctx.lineTo(_colDbgQuad[3].x, _colDbgQuad[3].y);
          ctx.closePath();
          ctx.stroke();
        }
    
        function drawCollisionBoundsDebug(ctx, cam) {
          if (!DevFlags.showCollisionBounds) return;
          const list = DestructorSystem?._visualEntities;
          if (!Array.isArray(list) || list.length === 0) return;
    
          const bp = getBroadphaseDebugInfo();
          const zoom = Math.max(0.0001, Number(cam?.zoom) || 1);
