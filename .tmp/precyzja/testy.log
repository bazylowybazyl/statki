        function resolveEntityFaction(entity) {
          if (!entity) return null;
          const explicit = normalizeFaction(entity.factionId ?? entity.faction);
          if (explicit) return explicit;
          // Jednostki sprzed wprowadzenia frakcji — wnioskujemy ze starych flag.
          if (entity.isPirate) return FACTION.PIRATES;
