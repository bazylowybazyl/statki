        function resolveEntityFaction(entity) {
          if (!entity) return null;
          const explicit = normalizeFaction(entity.factionId ?? entity.faction);
          if (explicit) return explicit;
          // Jednostki sprzed wprowadzenia frakcji — wnioskujemy ze starych flag.
          if (entity.isPirate) return FACTION.PIRATES;
          if (entity.friendly) return FACTION.TERRA_NOVA;
          return null;
        }
    
        function isEntityHostileToPlayer(entity) {
          if (!entity) return false;
          const faction = resolveEntityFaction(entity);
          // Bezpańskie obiekty (wraki, dryf) nie atakują i nie są celem z urzędu.
          if (!faction) return entity.friendly === false && !entity.isWreck;
          return isFactionHostileToPlayer(faction, PLAYER.reputation);
        }
    
        /** Przepisuje wrogość frakcyjną na stary boolean, żeby reszta kodu ją widziała. */
        function syncEntityFactionFlags(entity) {
          if (!entity || entity.isWreck) return;
          const faction = resolveEntityFaction(entity);
          if (!faction) return;
          entity.factionId = faction;
          entity.friendly = !isFactionHostileToPlayer(faction, PLAYER.reputation);
        }
    
