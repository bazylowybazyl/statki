            vy: 0,
            angle: 0,
            angVel: (typeof stats.angVel === 'number') ? stats.angVel : 0,
    
            hp: stats.hp || 100,
            maxHp: stats.hp || 100,
    
            accel: stats.accel || 0,
            maxSpeed: stats.maxSpeed || 0,
