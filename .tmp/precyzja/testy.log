                ctx.beginPath();
                ctx.arc(s.x, s.y, rad, 0, Math.PI * 2);
                ctx.stroke();
                if (t < 0.78) {
                  ctx.font = revealFont;
                  ctx.textBaseline = 'middle';
                  // Podsumowanie (etykieta + masa) liczone raz na efekt, nie co klatkę.
                  if (fx._summary === undefined) fx._summary = scannerRevealSummary(fx.contact);
                  ctx.fillText(fx._summary, s.x + rad + 10, s.y - Math.max(12, rad * 0.25));
                }
                ctx.restore();
              }
            }
    
            // Stary hover-ring został usunięty; wizualizację celu prowadzi wyłącznie
            // aktywny celownik SINGLE/MULTI/SUB. Stacja nadal sygnalizuje klik kursorem.
            if (scan.target && scan.targetType === 'station' && mouse.overCanvas && !stationUI.open) {
              _cursorRequest = 'pointer';
            }
            const radarUiActive = false;
            if (radarUiActive) {
              radarTargetingUI.draw(ctx, {
                width: W,
                height: H,
                camera: cam,
                worldToScreen,
                lockAnim: scannerState.lockAnim,
                targets: scannerContacts
                  .filter(c => c && c.target && isTargetAlive(c.target))
                  .map(c => c.target),
                isLocked: (target) => lockedTargets.includes(target) || target === lockedTarget
              });
            }
            if (!radarUiActive && scannerState.active && scannerContacts.length) {
              // Kontakty zostają na liście po impulsie (do śmierci celu), więc ta pętla
              // chodzi co klatkę przez resztę sesji — poza kadrem nic nie rysujemy,
              // a poświata idzie szerszą linią zamiast shadowBlur na każdy kontakt.
              for (const contact of scannerContacts) {
                const obj = contact.target;
                if (!isTargetAlive(obj)) continue;
                const s = worldToScreenInto(getTargetX(obj), getTargetY(obj), cam, _hudMarkerScreen);
                const baseRad = (getScanObjectRadius(obj) + (contact.type === 'station' ? 20 : 12)) * cam.zoom;
                const tick = Math.max(8, baseRad * 0.38);
                const gap = Math.max(6, baseRad * 0.45);
                if (hudMarkerOffscreen(s.x, s.y, Math.max(baseRad, gap + tick) + hudLineW * 3, hudVpX, hudVpY, hudVpW, hudVpH)) continue;
                const tone =
                  contact.tone === 'hostile' ? '110,255,190' :
                    (contact.tone === 'resource' ? '238,183,99' : (contact.tone === 'friendly' ? '80,190,255' : '150,255,220'));
                ctx.save();
                ctx.strokeStyle = hudRgba(tone, 0.88);
                // Okrąg dużego okrętu przy zbliżeniu potrafi objąć cały kadr — wtedy
                // circleArcInRect zwraca null i rysujemy same narożniki.
                const ringArc = circleArcInRect(s.x, s.y, baseRad, hudVpX, hudVpY, hudVpW, hudVpH);
                if (ringArc) {
                  if (hudGlowOn) {
                    ctx.lineWidth = hudLineW * 3;
                    strokeHudDashedArc(ctx, s.x, s.y, baseRad, ringArc, 10 * cam.zoom, 8 * cam.zoom, 0.3);
                  }
                  ctx.lineWidth = hudLineW;
                  strokeHudDashedArc(ctx, s.x, s.y, baseRad, ringArc, 10 * cam.zoom, 8 * cam.zoom, 1);
                }
                ctx.setLineDash([]);
                ctx.lineWidth = hudLineW;
                ctx.globalAlpha = 0.85;
                ctx.beginPath();
                ctx.moveTo(s.x - gap - tick, s.y - gap); ctx.lineTo(s.x - gap, s.y - gap);
                ctx.moveTo(s.x - gap, s.y - gap - tick); ctx.lineTo(s.x - gap, s.y - gap);
                ctx.moveTo(s.x + gap, s.y - gap - tick); ctx.lineTo(s.x + gap, s.y - gap);
                ctx.lineTo(s.x + gap + tick, s.y - gap);
                ctx.moveTo(s.x - gap - tick, s.y + gap); ctx.lineTo(s.x - gap, s.y + gap);
                ctx.lineTo(s.x - gap, s.y + gap + tick);
                ctx.moveTo(s.x + gap, s.y + gap + tick); ctx.lineTo(s.x + gap, s.y + gap);
                ctx.lineTo(s.x + gap + tick, s.y + gap);
                ctx.stroke();
                ctx.restore();
              }
            }
            PerfHUD.addTiming('renderHudTime', performance.now() - tRender2dSection);
            // ==========================================
            // END SPLIT-SCREEN 2D OVERLAY LOOP
            // ==========================================
            if (_splitPassCount > 1) {
              ctx.restore();
            }
          } // end split pass loop
    
          // Restore original state after split loop
          _currentCam = camera;
          if (_splitPassCount > 1) {
            cam = _origCam;
            _wtsVpW = 0;
            _wtsVpH = 0;
            _wtsVpOffX = 0;
            _wtsVpOffY = 0;
    
            // Draw split-screen divider
            ctx.save();
            ctx.strokeStyle = '#1a2a44';
            ctx.lineWidth = 3;
            ctx.shadowColor = '#3b82f6';
            ctx.shadowBlur = 6;
            ctx.beginPath();
            ctx.moveTo(Math.floor(_fullW / 2), 0);
            ctx.lineTo(Math.floor(_fullW / 2), H);
            ctx.stroke();
            ctx.restore();
          }
    
          const tRenderUi0 = performance.now();
    
          // --- Flash rendering (handled by CanvasVFX) ---
          CanvasVFX.drawFlashes?.(ctx, cam);
    
          // --- Linie celowania broni (weapon aim lines, Starsector-style) ---
          function _drawWeaponAimLines(camRef) {
            if (!ship || ship.destroyed) return;
            const weapons = Game.player?.weapons;
            if (!weapons) return;
    
            const _sA = interpAngle;
            const _cosA = Math.cos(_sA);
            const _sinA = Math.sin(_sA);
            const AIM_LINE_LEN = 350;
    
            ctx.save();
            ctx.lineCap = 'round';
    
            function _aimLine(wx, wy, dx, dy, len, colReady, colDim, ready) {
              const lineLen = Math.max(40, Number(len) || AIM_LINE_LEN);
              const p0 = worldToScreen(wx, wy, camRef);
              const p1 = worldToScreen(wx + dx * lineLen, wy + dy * lineLen, camRef);
              const grad = ctx.createLinearGradient(p0.x, p0.y, p1.x, p1.y);
              const col = ready ? colReady : colDim;
              grad.addColorStop(0, col);
              grad.addColorStop(0.65, col);
              grad.addColorStop(1, 'rgba(0,0,0,0)');
              ctx.globalAlpha = ready ? 0.88 : 0.45;
              ctx.strokeStyle = grad;
              ctx.lineWidth = ready ? 2.2 : 1.5;
              // Cienie wyłączone dla wydajności!
              ctx.shadowBlur = 0;
              ctx.beginPath();
              ctx.moveTo(p0.x, p0.y);
              ctx.lineTo(p1.x, p1.y);
              ctx.stroke();
              if (ready) {
                ctx.fillStyle = colReady;
                ctx.globalAlpha = 0.9;
                ctx.beginPath();
                ctx.arc(p0.x, p0.y, 2, 0, Math.PI * 2);
                ctx.fill();
              }
            }
    
            function _getInterpolatedHardpointWorldPos(hp) {
              const local = getEntityHardpointLocalPos(ship, hp);
              if (!local) return null;
              return {
                x: interpPos.x + (local.x * _cosA - local.y * _sinA),
                y: interpPos.y + (local.x * _sinA + local.y * _cosA)
              };
            }
    
            function _getAimRangeForWeapon(weapon) {
              let range = Number(weapon?.baseRange);
              if (!Number.isFinite(range) || range <= 0) range = Number(weapon?.range);
              if ((!Number.isFinite(range) || range <= 0) && weapon?.id === 'hexlance_siege') {
                range = Number(Superweapon?.superweaponState?.range);
              }
              if (!Number.isFinite(range) || range <= 0) range = AIM_LINE_LEN;
              return Math.max(80, range);
            }
    
            // BUILTIN weapons — TYLKO TO ZOSTAJE (Pomarańczowa linia dla Superbroni)
            const builtW = weapons[HP.BUILTIN] || [];
            for (let i = 0; i < builtW.length; i++) {
              const loadout = builtW[i];
              const hp = loadout?.hp;
              const hpPos = hp?.pos || hp;
              const origin = _getInterpolatedHardpointWorldPos(hp);
              if (!hpPos || !origin) continue;
              const localDir = editorDegToForward(Number.isFinite(Number(hpPos.rot)) ? Number(hpPos.rot) : 90);
              const dir = rotate(localDir, _sA);
              const sw = Superweapon?.superweaponState || null;
              const visible = !!(sw?.charging || sw?.armed);
              if (!visible) continue;
              const ready = !!sw?.armed;
              _aimLine(
                origin.x, origin.y, dir.x, dir.y,
                _getAimRangeForWeapon(loadout?.weapon),
                '#7ef29a', '#7a5520', ready
              );
            }
    
            ctx.restore();
          }
    
          // --- Celowniki trybu ostrzału (firing reticles) ---
          // Draws the selected targeting system without changing weapon statistics.
          // Animacje HUD-a licza sie w sekundach RZECZYWISTYCH — `gameTime` jest
          // mnozony przez TIME_SCALE = 60 i rozpedzal kreskowanie do miga.
          const uiAnimTime = () => performance.now() / 1000;
          function _targetingScreenRadius(target, zoom) {
            const radius = Math.max(12, getTargetRadius(target));
            const visualScale = targetingVisualScale(zoom);
            const profile = target?.capitalProfile;
            // Kadlub rysuje sie na radius*lengthScale wzdluz osi, wiec celownik musi
            // objac POLOWE tej dlugosci — inaczej duzy okret wystaje poza narozniki.
            const hullScale = profile
              ? Math.max(1, Math.max(Number(profile.lengthScale) || 1, Number(profile.widthScale) || 1) * 0.62)
              : 1;
            // Sufit MUSI byc w pikselach ekranu. Stare 180*visualScale mnozylo limit
            // przez zoom drugi raz, wiec przy oddaleniu celownik capitala scinal sie
            // do rozmiaru mniejszego niz sam statek.
            return clamp(radius * hullScale * zoom, 14 * visualScale, 340);
          }
    
          function _targetingLabel(text, x, y, color, align = 'center', visualScale = 1) {
            const scale = targetingVisualScale(visualScale);
            ctx.save();
            ctx.font = `${Math.max(6, 10 * scale).toFixed(1)}px Consolas, monospace`;
            ctx.textAlign = align;
            ctx.textBaseline = 'middle';
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = 6 * scale;
            ctx.fillText(text, x, y);
            ctx.restore();
          }
    
          function _targetingEntityLabel(target) {
            return target?.label || target?.displayName || target?.name || getRadarTargetUnitId(target);
          }
    
          function _drawTargetingRange(shipRef, camRef, clipX, clipW, color) {
            let maxRange = 0;
            const weapons = shipRef.weapons;
            if (weapons) {
              for (const key of Object.keys(weapons)) {
                const entries = weapons[key];
                if (!Array.isArray(entries)) continue;
                for (let i = 0; i < entries.length; i++) {
                  const weapon = entries[i]?.weapon;
                  let range = Number(weapon?.baseRange ?? weapon?.range);
                  if ((!Number.isFinite(range) || range <= 0) && weapon?.id === 'hexlance_siege') {
