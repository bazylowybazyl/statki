        function requestedOrbitRangeFromMenuItem(item, mode, point, targetEntity) {
          if (!item) return null;
          if (item.orbitRangeMode === 'current') return 'current';
          if (item.orbitRangeMode === 'custom') {
            const current = Math.round(computeCurrentOrbitRange(mode, point, targetEntity) || 5000);
            const raw = window.prompt ? window.prompt('Orbit range', String(current)) : String(current);
            if (raw == null) return null;
            const value = Number(String(raw).replace(',', '.').trim());
            if (!Number.isFinite(value) || value <= 0) {
              pushZoneMessage('ORBIT: NIEPRAWIDLOWY DYSTANS', 1.2);
              return null;
            }
            return value;
          }
          const radius = Number(item.orbitRadius);
          return Number.isFinite(radius) && radius > 0 ? radius : null;
        }
    
        function openNormalWorldCommandMenuAt(sx, sy) {
          const rect = canvas.getBoundingClientRect();
          const worldPoint = screenToWorld(sx - rect.left, sy - rect.top);
          const targetEntity = pickCommandTargetAtWorld(worldPoint);
          openWorldCommandMenuAt(
            'normal',
            sx,
            sy,
            worldPoint,
            targetEntity,
            buildNormalCommandMenuItems({ targetEntity })
          );
        }
    
        function openRtsWorldCommandMenuAt(sx, sy, worldPoint) {
          const selectedCount = [...Selection.units].filter(u => u && !u.dead).length;
          if (!selectedCount) return false;
          const targetEntity = pickCommandTargetAtWorld(worldPoint);
          openWorldCommandMenuAt(
            'rts',
            sx,
            sy,
            worldPoint,
            targetEntity,
            buildRtsCommandMenuItems({ selectedCount, targetEntity })
          );
          return true;
        }
    
        function isMovePlacementAction(action) {
          return action === 'move' || action === 'move-formation';
        }
    
        function updateRtsMovePlacement(pointerWorld) {
          const placement = worldCommandMenu.placement;
          if (!placement.active || !placement.anchor) return;
          placement.pointer = pointerWorld ? { x: pointerWorld.x, y: pointerWorld.y } : placement.anchor;
          const dx = placement.pointer.x - placement.anchor.x;
          const dy = placement.pointer.y - placement.anchor.y;
          if (Math.hypot(dx, dy) > 10) {
            placement.faceAngle = Math.atan2(dy, dx);
          }
          placement.targets = computeCommandFormationTargets(placement.units, placement.anchor, placement.faceAngle);
        }
    
        function beginRtsMovePlacement(action, anchorWorld, pointerWorld = null) {
          const units = [...Selection.units].filter(u => u && !u.dead);
          if (!units.length || !anchorWorld) return false;
          const placement = worldCommandMenu.placement;
          placement.active = true;
          placement.action = isMovePlacementAction(action) ? action : 'move';
          placement.anchor = { x: anchorWorld.x, y: anchorWorld.y };
          placement.pointer = pointerWorld ? { x: pointerWorld.x, y: pointerWorld.y } : { x: anchorWorld.x, y: anchorWorld.y };
          placement.faceAngle = Number.isFinite(ship?.angle) ? ship.angle : 0;
          placement.units = units;
          updateRtsMovePlacement(placement.pointer);
          return true;
        }
    
        function commitRtsMovePlacement() {
          const placement = worldCommandMenu.placement;
          if (!placement.active || !placement.anchor) return false;
          issueMoveOrder(placement.anchor, { faceAngle: placement.faceAngle });
          pushZoneMessage(`RTS: MOVE${placement.units.length > 1 ? ' FORMATION' : ''} x${placement.units.length}`, 1.2);
          closeWorldCommandMenu();
          return true;
        }
    
        function setPlayerAttackTarget(targetEntity) {
          if (!isValidLockedTarget(targetEntity)) {
            pushZoneMessage('ATTACK: BRAK CELU', 1.2);
            return false;
          }
          if (!isPlayerLockTargetInRange(targetEntity)) {
            warnTargetOutOfLockRange(targetEntity);
            return false;
          }
          const next = [targetEntity, ...lockedTargets.filter(t => t !== targetEntity && canPlayerLockTarget(t))]
            .slice(0, RADAR_UI_MAX_TARGETS);
          setLockedTargetsExact(next);
          playerAttackState.active = true;
          playerAttackState.target = targetEntity;
          playerAttackState.phase = null;
          playerAttackState.statusKey = '';
          cruiseNav.active = false;
          mainAutoFire = true;
          pushZoneMessage(`ATTACK: ${getRadarTargetUnitId(targetEntity)}`, 1.4);
          updatePlayerAttackCommand(0);
          return true;
        }
    
        function issueAttackOrder(targetEntity) {
          if (!isValidLockedTarget(targetEntity)) {
            pushZoneMessage('RTS: BRAK CELU ATAKU', 1.2);
            return;
          }
          const units = [...Selection.units].filter(u => u && !u.dead);
          if (!units.length) return;
          const point = commandEntityPoint(targetEntity, { x: 0, y: 0 });
          for (const unit of units) {
            if (unit === ship) {
              setPlayerAttackTarget(targetEntity);
              continue;
            }
            const arrival = (unit.radius || unit.w || 30) + commandEntityRadius(targetEntity) + 120;
            issueUnitCommand(unit, {
              type: 'attack-move',
              target: point,
              targetEntity,
              arrival
            });
          }
          pushZoneMessage(`RTS: ATTACK x${units.length}`, 1.2);
        }
    
        function issueRamOrder(targetEntity) {
          if (!isCommandEntityAlive(targetEntity)) {
            pushZoneMessage('RTS: BRAK CELU DO RAM', 1.2);
            return;
          }
          const units = [...Selection.units].filter(u => u && !u.dead);
          if (!units.length) return;
          const point = commandEntityPoint(targetEntity, { x: 0, y: 0 });
          for (const unit of units) {
            const command = createRamCommand({
              point,
              targetEntity,
              arrival: (unit.radius || unit.w || 30) + commandEntityRadius(targetEntity) + 260,
              ramImpulse: unit === ship ? 3400 : 3200
            });
            if (unit === ship) {
              clearPlayerAttackState();
              cruiseNav.active = false;
              ship.command = command;
            } else {
              issueUnitCommand(unit, command);
            }
          }
          pushZoneMessage(`RTS: RAM x${units.length}`, 1.2);
        }
    
        function issueWorldScan(targetEntity, point) {
          const target = targetEntity || pickCommandTargetAtWorld(point);
          if (target) {
            issueDirectScanOrder(target);
            return;
          }
          if (!scannerState.active) {
            setScannerActive(true);
            hudPingNpcStations();
          } else {
            scanWaves.length = 0;
            triggerScanWave();
            CICDisplay.triggerHudRadarBurst?.();
          }
          pushZoneMessage('SCAN: ACTIVE PING', 1.2);
        }
    
        function clearPlayerAttackState(target = null) {
          if (target && playerAttackState.target !== target) return;
          playerAttackState.active = false;
          playerAttackState.target = null;
          playerAttackState.phase = null;
          playerAttackState.statusKey = '';
        }
    
        function getPlayerWeaponRange(weapon) {
          let range = Number(weapon?.baseRange);
          if (!Number.isFinite(range) || range <= 0) range = Number(weapon?.range);
          if ((!Number.isFinite(range) || range <= 0) && weapon?.id === 'hexlance_siege') {
            range = Number(Superweapon?.superweaponState?.range);
          }
          if (!Number.isFinite(range) || range <= 0) return 0;
          const modRange = Number(ship?.modifiers?.range);
          if (Number.isFinite(modRange) && modRange > 0) range *= modRange;
          return range;
        }
    
        function getPlayerMainWeaponRanges() {
          const ranges = [];
          const mainWeapons = Game.player?.weapons?.[HP.MAIN] || [];
          for (const loadout of mainWeapons) {
            const range = getPlayerWeaponRange(loadout?.weapon);
            if (range > 0) ranges.push(range);
          }
          return ranges;
        }
    
        function distanceFromShipToTarget(target) {
          const pos = commandEntityPoint(target, null);
          if (!pos) return Infinity;
          return Math.hypot(pos.x - ship.pos.x, pos.y - ship.pos.y);
        }
    
        function getPlayerAttackRangeState(target) {
          return computeAttackAutopilotState({
            distance: distanceFromShipToTarget(target),
            weaponRanges: getPlayerMainWeaponRanges(),
            targetRadius: commandEntityRadius(target),
            minOrbitRadius: RTS_DEFAULT_ORBIT_RADIUS
          });
        }
    
        function selectLockedTargetInRangeForWeapon(weapon, seedIndex = 0) {
          const targets = (lockedTargets && lockedTargets.length) ? lockedTargets : (lockedTarget ? [lockedTarget] : []);
          if (!targets.length) return null;
          const range = getPlayerWeaponRange(weapon);
          if (range <= 0) return null;
          const valid = [];
          for (let i = 0; i < targets.length; i++) {
            const target = targets[i];
            if (!canPlayerLockTarget(target)) continue;
            if (distanceFromShipToTarget(target) <= range) valid.push(target);
          }
          return valid.length ? valid[Math.abs(seedIndex | 0) % valid.length] : null;
        }
    
        function hasAnyLockedTargetInMainWeaponRange() {
          const targets = (lockedTargets && lockedTargets.length) ? lockedTargets : (lockedTarget ? [lockedTarget] : []);
          if (!targets.length) return false;
          const mainWeapons = Game.player?.weapons?.[HP.MAIN] || [];
          for (let i = 0; i < mainWeapons.length; i++) {
            const weapon = mainWeapons[i]?.weapon;
            if (selectLockedTargetInRangeForWeapon(weapon, i)) return true;
          }
          return false;
        }
    
        function updatePlayerAttackCommand(dt = 0) {
          if (!playerAttackState.active) return;
          const target = playerAttackState.target;
          if (!canPlayerLockTarget(target)) {
            clearPlayerAttackState(target);
            return;
          }
          if (playerHasManualInput()) {
            clearPlayerAttackState(target);
            return;
          }
    
          const state = getPlayerAttackRangeState(target);
          if (!state.hasWeaponRange) {
            mainAutoFire = false;
            clearPlayerAttackState(target);
            pushZoneMessage('ATTACK: BRAK BRONI GLOWNEJ', 1.3);
            return;
          }
    
          mainAutoFire = true;
          cruiseNav.active = false;
          const phase = state.commandType;
          if (phase === 'orbit') {
            ship.command = createOrbitCommand({
              point: commandEntityPoint(target, ship.pos),
              targetEntity: target,
              orbitRadius: state.orbitRadius,
              orbitDir: 1,
              arrival: Math.max(90, commandEntityRadius(target) + 120)
            });
          } else {
            ship.command = createApproachCommand({
              point: commandEntityPoint(target, ship.pos),
              targetEntity: target,
              arrival: state.approachArrival
            });
          }
    
          if (playerAttackState.phase !== phase) {
            playerAttackState.phase = phase;
            pushZoneMessage(phase === 'orbit' ? 'ATTACK: ORBITA / OGIEN' : 'ATTACK: APPROACH DO ZASIEGU', 1.2);
          }
        }
    
        function executeNormalWorldCommandAction(action, point, targetEntity, opts = {}) {
          const liveTarget = isCommandEntityAlive(targetEntity) ? targetEntity : null;
          const targetPoint = commandEntityPoint(liveTarget, point) || point;
          if (!targetPoint) return;
          if (action === 'salvage') {
            if (salvageState.cutting && salvageState.cutting === liveTarget) stopFieldSalvage('SALVAGE: PRZERWANE');
            else startFieldSalvage(liveTarget);
            return;
          }
          if (action === 'tow') {
            if (salvageState.towed === liveTarget) releaseWreckTow('HOL: ODCZEPIONO');
            else startWreckTow(liveTarget);
            return;
          }
          // Rozkaz na zimny wrak (podejście, orbita, taran, skan) wybudza go.
          if (liveTarget?.isCold) thawWreckForOrder(liveTarget, action);
          if (action === 'attack') {
            setPlayerAttackTarget(liveTarget);
            return;
          }
          if (action === 'ram') {
            if (!liveTarget) {
              pushZoneMessage('RAM: BRAK CELU', 1.2);
              return;
            }
            clearPlayerAttackState();
            cruiseNav.active = false;
            ship.command = createRamCommand({
              point: targetPoint,
              targetEntity: liveTarget,
              arrival: commandEntityRadius(liveTarget) + (ship.radius || 220) + 260,
              ramImpulse: 3400
            });
            pushZoneMessage('ROZKAZ: RAM TARGET', 1.3);
            return;
          }
          clearPlayerAttackState();
          if (action === 'approach') {
            cruiseNav.active = false;
            ship.command = createApproachCommand({
              point: targetPoint,
              targetEntity: liveTarget,
              arrival: liveTarget ? Math.max(90, commandEntityRadius(liveTarget) + 80) : 180
            });
            pushZoneMessage(liveTarget ? 'ROZKAZ: APPROACH TARGET' : 'ROZKAZ: APPROACH POINT', 1.3);
            return;
          }
          if (action === 'orbit') {
            cruiseNav.active = false;
            const fallbackRadius = liveTarget
              ? Math.max(900, commandEntityRadius(liveTarget) + 260)
              : 900;
            const orbitRadius = resolveOrbitRadiusForUnit({
              unit: ship,
              targetPoint,
              requestedRadius: opts.requestedRadius ?? opts.orbitRadius ?? fallbackRadius,
              fallbackRadius,
              minRadius: liveTarget ? commandEntityRadius(liveTarget) + 180 : 80
            });
            ship.command = createOrbitCommand({
              point: targetPoint,
              targetEntity: liveTarget,
              orbitRadius,
              orbitDir: 1,
              arrival: liveTarget ? Math.max(90, commandEntityRadius(liveTarget) + 120) : 120
            });
            pushZoneMessage(liveTarget ? `ROZKAZ: ORBIT TARGET ${orbitRadius}` : `ROZKAZ: ORBIT POINT ${orbitRadius}`, 1.3);
            return;
          }
          if (action === 'jump' || action === 'cruise') {
            setCruiseTarget(targetPoint.x, targetPoint.y);
            if (action === 'jump') pushZoneMessage('JUMP TARGET SET', 1.2);
            return;
          }
          if (action === 'scan') {
            issueWorldScan(liveTarget, targetPoint);
          }
        }
    
        function executeRtsWorldCommandAction(action, point, targetEntity, opts = {}) {
          // Odzysk z menu RTS (SALVAGE, TOW / WYCIĄGNIJ) wykonuje statek gracza — ta
          // sama ścieżka co w trybie normalnym, z odmrożeniem zimnego wraku.
          if (action === 'salvage' || action === 'tow') {
            executeNormalWorldCommandAction(action, point, targetEntity, opts);
            return;
          }
          const liveTarget = isCommandEntityAlive(targetEntity) ? targetEntity : null;
          const enemyTarget = isValidLockedTarget(liveTarget) ? liveTarget : pickEnemyTargetAtWorld(point);
          // Rozkaz RTS na zimny wrak wybudza go (ruch w punkt i HOLD — nie).
          if (liveTarget?.isCold && !isMovePlacementAction(action) && action !== 'hold') {
            thawWreckForOrder(liveTarget, action);
          }
          if (isMovePlacementAction(action)) {
            const faceAngle = Number.isFinite(ship?.angle) ? ship.angle : 0;
            issueMoveOrder(point, { faceAngle });
            pushZoneMessage(`RTS: ${Selection.units.size > 1 ? 'MOVE FORMATION' : 'MOVE'}`, 1.2);
            return;
          }
          if (action === 'approach') {
            issueApproachOrder(point, liveTarget);
            return;
          }
          if (action === 'orbit') {
            issueOrbitOrder(point, liveTarget, opts);
            return;
          }
          if (action === 'attack') {
            issueAttackOrder(enemyTarget);
            return;
          }
          if (action === 'ram') {
            issueRamOrder(liveTarget || enemyTarget);
            return;
          }
          if (action === 'hold') {
            issueHoldOrder();
            return;
          }
          if (action === 'scan') {
            issueDirectScanOrder(liveTarget || enemyTarget);
          }
        }
    
        function executeWorldCommandItem(item) {
          if (!item || !item.action || !worldCommandMenu.open) return false;
          const point = worldCommandMenu.worldPoint;
          const targetEntity = worldCommandMenu.targetEntity;
          if (item.action === 'orbit' && worldCommandMenu.submenu !== 'orbit-range') {
            openOrbitRangeMenuFromCurrent();
            return true;
          }
          if (isOrbitRangeMenuItem(item)) {
            const requestedRadius = requestedOrbitRangeFromMenuItem(item, worldCommandMenu.mode, point, targetEntity);
            if (requestedRadius == null) return true;
            if (worldCommandMenu.mode === 'rts') {
              executeRtsWorldCommandAction('orbit', point, targetEntity, { requestedRadius });
            } else {
              executeNormalWorldCommandAction('orbit', point, targetEntity, { requestedRadius });
            }
            closeWorldCommandMenu();
            return true;
          }
          if (worldCommandMenu.mode === 'rts') {
            executeRtsWorldCommandAction(item.action, point, targetEntity);
          } else {
            executeNormalWorldCommandAction(item.action, point, targetEntity);
          }
          closeWorldCommandMenu();
          return true;
        }
    
        function handleWorldCommandMenuRightDrag(sx, sy, worldPoint) {
          if (!worldCommandMenu.open || !worldCommandMenu.rightHeld || worldCommandMenu.mode !== 'rts') return false;
          const placement = worldCommandMenu.placement;
          if (placement.active) {
            updateRtsMovePlacement(worldPoint);
            return true;
          }
          const dx = sx - worldCommandMenu.pressScreenX;
          const dy = sy - worldCommandMenu.pressScreenY;
          if (Math.hypot(dx, dy) >= WORLD_COMMAND_PLACEMENT_DRAG_THRESHOLD) {
            const firstAction = worldCommandMenu.items[0]?.action || 'move';
            beginRtsMovePlacement(firstAction, worldCommandMenu.pressWorld || worldCommandMenu.worldPoint, worldPoint);
            return true;
          }
          return false;
        }
    
        function handleRtsWorldCommandRightUp(sx, sy) {
          if (!worldCommandMenu.open || worldCommandMenu.mode !== 'rts') return false;
          if (worldCommandMenu.placement.active) {
            return commitRtsMovePlacement();
          }
          worldCommandMenu.rightHeld = false;
          const item = hitTestCommandMenu(worldCommandMenu, sx, sy);
          if (item) return executeWorldCommandItem(item);
          return true;
        }
    
        function drawRtsPlacementGhosts(renderCtx, cam) {
          const placement = worldCommandMenu.placement;
          if (!placement.active || !placement.anchor || !placement.units.length) return;
          const zoom = Math.max(0.0001, Number(cam?.zoom) || 1);
          const anchorScreen = worldToScreen(placement.anchor.x, placement.anchor.y, cam);
          const pointer = placement.pointer || placement.anchor;
          const pointerScreen = worldToScreen(pointer.x, pointer.y, cam);
    
          renderCtx.save();
          renderCtx.strokeStyle = 'rgba(122, 196, 255, 0.65)';
          renderCtx.fillStyle = 'rgba(64, 180, 255, 0.12)';
          renderCtx.lineWidth = 1.5;
          renderCtx.setLineDash([8, 6]);
          renderCtx.beginPath();
          renderCtx.moveTo(anchorScreen.x, anchorScreen.y);
          renderCtx.lineTo(pointerScreen.x, pointerScreen.y);
          renderCtx.stroke();
          renderCtx.setLineDash([]);
    
          for (const unit of placement.units) {
            if (!unit || unit.dead) continue;
            const target = placement.targets.get(unit);
            if (!target) continue;
            const screen = worldToScreen(target.x, target.y, cam);
            const faceAngle = Number.isFinite(target.faceAngle) ? target.faceAngle : placement.faceAngle;
            const palette = getCicPlacementGhostPalette({ player: unit === ship });
            const metrics = getCicEntityHullMetrics(unit, zoom);
            const drewSilhouette = drawCicShipSilhouette(
              renderCtx,
              unit,
              screen.x,
              screen.y,
              metrics,
              palette,
              {
                angle: faceAngle,
                alpha: unit === ship ? 0.76 : 0.62,
                accentAlpha: unit === ship ? 0.34 : 0.26
              }
            );
            if (drewSilhouette) continue;
    
            const radius = Math.max(26, Number(unit.radius || unit.w || 30) || 30);
            const length = Math.max(54, radius * 2.2) * zoom;
            const width = Math.max(28, radius * 1.15) * zoom;
            renderCtx.save();
            renderCtx.translate(screen.x, screen.y);
            renderCtx.rotate(faceAngle);
            renderCtx.globalAlpha = unit === ship ? 0.55 : 0.42;
            renderCtx.fillStyle = unit === ship ? 'rgba(116, 235, 255, 0.20)' : 'rgba(122, 166, 255, 0.16)';
            renderCtx.strokeStyle = unit === ship ? 'rgba(136, 250, 255, 0.9)' : 'rgba(154, 188, 255, 0.82)';
            renderCtx.lineWidth = Math.max(1, 1.6 * zoom);
            renderCtx.beginPath();
            renderCtx.moveTo(length * 0.55, 0);
            renderCtx.lineTo(-length * 0.42, -width * 0.5);
            renderCtx.lineTo(-length * 0.24, 0);
            renderCtx.lineTo(-length * 0.42, width * 0.5);
            renderCtx.closePath();
            renderCtx.fill();
            renderCtx.stroke();
            renderCtx.beginPath();
            renderCtx.moveTo(0, 0);
            renderCtx.lineTo(length * 0.72, 0);
            renderCtx.stroke();
            renderCtx.restore();
          }
    
          renderCtx.fillStyle = 'rgba(122, 235, 255, 0.95)';
          renderCtx.beginPath();
          renderCtx.arc(anchorScreen.x, anchorScreen.y, 4, 0, Math.PI * 2);
          renderCtx.fill();
          renderCtx.restore();
        }
    
        function drawCommandArrow(renderCtx, from, to, color, opts = {}) {
          const dx = to.x - from.x;
          const dy = to.y - from.y;
          const len = Math.hypot(dx, dy);
          if (len < 4) return;
          const nx = dx / len;
          const ny = dy / len;
          const arrowLen = Math.max(12, Number(opts.arrowLen) || 20);
          const arrowWing = arrowLen * 0.52;
          renderCtx.strokeStyle = color;
          renderCtx.lineWidth = Number(opts.lineWidth) || 2;
          if (opts.dash) renderCtx.setLineDash(opts.dash);
          renderCtx.beginPath();
          renderCtx.moveTo(from.x, from.y);
          renderCtx.lineTo(to.x, to.y);
          renderCtx.stroke();
          if (opts.dash) renderCtx.setLineDash([]);
          renderCtx.beginPath();
          renderCtx.moveTo(to.x, to.y);
          renderCtx.lineTo(to.x - nx * arrowLen - ny * arrowWing, to.y - ny * arrowLen + nx * arrowWing);
          renderCtx.moveTo(to.x, to.y);
          renderCtx.lineTo(to.x - nx * arrowLen + ny * arrowWing, to.y - ny * arrowLen - nx * arrowWing);
          renderCtx.stroke();
        }
    
        function drawCommandShipGhost(renderCtx, cam, unit, ghost, opts = {}) {
          if (!ghost?.pos) return;
          const fade = Math.max(0, Math.min(1, opts.fadeAlpha == null ? 1 : Number(opts.fadeAlpha)));
          if (fade <= 0.001) return;
          const zoom = Math.max(0.0001, Number(cam?.zoom) || 1);
          const screen = worldToScreen(ghost.pos.x, ghost.pos.y, cam);
          const isPlayer = unit === ship;
          const basePalette = getCicPlacementGhostPalette({ player: isPlayer });
          const palette = opts.palette || basePalette;
          const metrics = getCicEntityHullMetrics(unit, zoom);
          const drewSilhouette = drawCicShipSilhouette(
            renderCtx,
            unit,
            screen.x,
            screen.y,
            metrics,
            palette,
            {
              angle: Number.isFinite(Number(ghost.angle)) ? Number(ghost.angle) : Number(unit?.angle) || 0,
              alpha: (isPlayer ? 0.72 : 0.58) * fade,
              accentAlpha: (isPlayer ? 0.32 : 0.24) * fade
            }
          );
          if (drewSilhouette) return;
    
          const radius = Math.max(26, Number(unit?.radius || unit?.w || 30) || 30);
          const length = Math.max(54, radius * 2.2) * zoom;
          const width = Math.max(28, radius * 1.15) * zoom;
          renderCtx.save();
          renderCtx.translate(screen.x, screen.y);
          renderCtx.rotate(Number.isFinite(Number(ghost.angle)) ? Number(ghost.angle) : Number(unit?.angle) || 0);
          renderCtx.globalAlpha = (isPlayer ? 0.55 : 0.42) * fade;
          renderCtx.fillStyle = opts.fill || (isPlayer ? 'rgba(116, 235, 255, 0.20)' : 'rgba(122, 166, 255, 0.16)');
          renderCtx.strokeStyle = opts.stroke || (isPlayer ? 'rgba(136, 250, 255, 0.9)' : 'rgba(154, 188, 255, 0.82)');
          renderCtx.lineWidth = Math.max(1, 1.6 * zoom);
          renderCtx.beginPath();
          renderCtx.moveTo(length * 0.55, 0);
          renderCtx.lineTo(-length * 0.42, -width * 0.5);
          renderCtx.lineTo(-length * 0.24, 0);
          renderCtx.lineTo(-length * 0.42, width * 0.5);
          renderCtx.closePath();
          renderCtx.fill();
          renderCtx.stroke();
          renderCtx.beginPath();
          renderCtx.moveTo(0, 0);
          renderCtx.lineTo(length * 0.72, 0);
          renderCtx.stroke();
          renderCtx.restore();
        }
    
        function commandMarkerColors(type, isPlayer) {
          if (type === 'ram') {
            return {
              line: 'rgba(255, 210, 95, 0.82)',
              soft: 'rgba(255, 210, 95, 0.16)',
              palette: {
                marker: '#ffd25f',
                body: 'rgba(54, 34, 6, 0.52)',
                accent: 'rgba(255, 210, 95, 0.78)',
                glow: 'rgba(255, 210, 95, 0.46)'
              }
            };
          }
          if (type === 'orbit') {
            return {
              line: isPlayer ? 'rgba(190, 126, 255, 0.78)' : 'rgba(160, 170, 255, 0.70)',
              soft: 'rgba(190, 126, 255, 0.12)'
            };
          }
          if (type === 'move' || type === 'attack-move') {
            return {
              line: isPlayer ? 'rgba(122, 196, 255, 0.80)' : 'rgba(122, 166, 255, 0.70)',
              soft: 'rgba(64, 180, 255, 0.12)'
            };
          }
          return {
            line: isPlayer ? 'rgba(126, 255, 226, 0.78)' : 'rgba(126, 214, 255, 0.68)',
            soft: 'rgba(126, 255, 226, 0.12)'
          };
        }
    
        function drawCommandVisualOverlay(renderCtx, cam, unit, visual) {
          if (!visual) return;
          const zoom = Math.max(0.0001, Number(cam?.zoom) || 1);
          const isPlayer = unit === ship;
          const colors = commandMarkerColors(visual.type, isPlayer);
          const pulse = 0.5 + 0.5 * Math.sin(((typeof performance !== 'undefined' ? performance.now() : 0) * 0.006));
          const lineWidth = Math.max(1.25, 2.0 * Math.sqrt(Math.max(0.2, zoom)));
    
          renderCtx.save();
          renderCtx.globalAlpha = 0.78 + pulse * 0.18;
    
          if (visual.type === 'orbit' && visual.orbit) {
            const center = worldToScreen(visual.orbit.center.x, visual.orbit.center.y, cam);
            const orbitR = Math.max(8, visual.orbit.radius * zoom);
            renderCtx.strokeStyle = colors.line;
            renderCtx.fillStyle = colors.soft;
            renderCtx.lineWidth = lineWidth;
            renderCtx.setLineDash([14, 9]);
            renderCtx.beginPath();
            renderCtx.arc(center.x, center.y, orbitR, 0, Math.PI * 2);
            renderCtx.stroke();
            renderCtx.setLineDash([]);
    
            const pathStart = worldToScreen(visual.path.start.x, visual.path.start.y, cam);
            const pathEnd = worldToScreen(visual.path.end.x, visual.path.end.y, cam);
            drawCommandArrow(renderCtx, pathStart, pathEnd, colors.line, {
              lineWidth: Math.max(1, lineWidth * 0.72),
              dash: [8, 7],
              arrowLen: Math.max(12, 18 * Math.sqrt(zoom))
            });
    
            const arrowStart = worldToScreen(visual.orbit.arrow.start.x, visual.orbit.arrow.start.y, cam);
            const arrowEnd = worldToScreen(visual.orbit.arrow.end.x, visual.orbit.arrow.end.y, cam);
            drawCommandArrow(renderCtx, arrowStart, arrowEnd, colors.line, {
              lineWidth,
              arrowLen: Math.max(16, 24 * Math.sqrt(zoom))
            });
            renderCtx.beginPath();
            renderCtx.arc(pathEnd.x, pathEnd.y, Math.max(5, 7 * Math.sqrt(zoom)), 0, Math.PI * 2);
            renderCtx.fill();
            renderCtx.stroke();
            renderCtx.restore();
            return;
          }
    
          if (visual.path) {
            const start = worldToScreen(visual.path.start.x, visual.path.start.y, cam);
            const end = worldToScreen(visual.path.end.x, visual.path.end.y, cam);
            drawCommandArrow(renderCtx, start, end, colors.line, {
              lineWidth,
              dash: visual.type === 'move' || visual.type === 'attack-move' ? [10, 7] : [14, 9],
              arrowLen: Math.max(14, 21 * Math.sqrt(zoom))
            });
          }
    
          if (visual.arrival > 0 && visual.target) {
            const end = worldToScreen(visual.target.x, visual.target.y, cam);
            const markerR = Math.max(8, Math.min(36, visual.arrival * zoom * 0.18));
            renderCtx.strokeStyle = colors.line;
            renderCtx.fillStyle = colors.soft;
            renderCtx.lineWidth = lineWidth;
            renderCtx.beginPath();
            renderCtx.arc(end.x, end.y, markerR, 0, Math.PI * 2);
            renderCtx.fill();
            renderCtx.stroke();
          }
    
          if (visual.ghost) {
            // Ghost pojawia się na chwilę i znika (nie zostaje na stałe).
            const cmd = unit?.command;
            const nowMs = (typeof performance !== 'undefined' ? performance.now() : 0);
            if (cmd && !cmd._ghostBornAt) cmd._ghostBornAt = nowMs;
            const age = cmd ? (nowMs - cmd._ghostBornAt) / 1000 : 999;
            const GHOST_HOLD = 0.75;
            const GHOST_FADE = 0.85;
            const fade = age <= GHOST_HOLD ? 1 : Math.max(0, 1 - (age - GHOST_HOLD) / GHOST_FADE);
            if (fade > 0.001) {
              drawCommandShipGhost(renderCtx, cam, unit, visual.ghost, {
                palette: colors.palette,
                fadeAlpha: fade
              });
            }
          }
          renderCtx.restore();
        }
    
        function drawActiveCommandMarkers(renderCtx, cam, playerRenderPos = null) {
          const seen = new Set();
          const drawForUnit = (unit, renderPos = null) => {
            if (!unit || unit.dead || unit.destroyed || !unit.command || seen.has(unit)) return;
            // Myśliwce NIE dostają osobnych linii — chmara rysuje jedną zbiorczą linię.
            if (isFighterUnit(unit)) return;
            seen.add(unit);
            const posSource = renderPos || unit.pos || unit;
            const visual = computeCommandVisual(unit.command, posSource, unit);
            drawCommandVisualOverlay(renderCtx, cam, unit, visual);
          };
    
          drawForUnit(ship, playerRenderPos || ship.pos);
          for (const unit of Selection.units) {
            drawForUnit(unit, unit === ship ? (playerRenderPos || ship.pos) : null);
          }
          for (const npc of npcs) {
            if (!npc || npc.dead || !npc.command) continue;
            if (npc.friendly || Selection.units.has(npc)) drawForUnit(npc);
          }
          drawSalvageLinks(renderCtx, cam, playerRenderPos || ship.pos);
        }
    
        // Wiązka tnąca i lina holownicza — bez tego gracz nie widzi, że cokolwiek
        // trwa, bo wrak topnieje powoli i po cichu.
        function drawSalvageLinks(renderCtx, cam, shipPos) {
          const cutting = salvageState.cutting;
          const towed = salvageState.towed;
          if (!cutting && !towed) return;
    
          const from = worldToScreen(shipPos.x, shipPos.y, cam);
          const strokeTo = (target, color, width, dash) => {
            if (!target || target.dead) return;
            const to = worldToScreen(target.x ?? target.pos?.x ?? 0, target.y ?? target.pos?.y ?? 0, cam);
            renderCtx.save();
            renderCtx.strokeStyle = color;
            renderCtx.lineWidth = width;
            renderCtx.setLineDash(dash);
            renderCtx.lineDashOffset = -(gameTime * 60) % 1000;
            renderCtx.beginPath();
            renderCtx.moveTo(from.x, from.y);
            renderCtx.lineTo(to.x, to.y);
            renderCtx.stroke();
            renderCtx.restore();
          };
    
          strokeTo(towed, 'rgba(148, 163, 184, 0.75)', 2, []);
          strokeTo(cutting, 'rgba(56, 220, 255, 0.9)', 3, [14, 8]);
        }
    
        // =================== CHMARY MYŚLIWCÓW ===================
        // 100 myśliwców = jedna chmara z licznikiem, nie 100 linii/ringów.
        const fighterCloudRender = {
          lastNow: 0,
          rolls: [] // trwałe stany rolek: { kind:'F'|'E'|'C', x, y, roll }
        };
    
        function fighterCloudCommandTarget(u) {
          const c = u && u.command;
          if (!c) return null;
          const type = String(c.type || '').toLowerCase();
          if (type !== 'move' && type !== 'attack-move' && type !== 'approach' && type !== 'orbit' && type !== 'ram') return null;
          const ent = c.targetEntity;
          if (ent && !ent.dead && !ent.destroyed && !ent.removed) {
            const ex = getTargetX(ent);
            const ey = getTargetY(ent);
            if (Number.isFinite(ex) && Number.isFinite(ey)) return { x: ex, y: ey, type, hasEntity: true };
          }
          const t = c.target;
          if (t && Number.isFinite(t.x) && Number.isFinite(t.y)) return { x: t.x, y: t.y, type, hasEntity: false };
          return null;
        }
    
        // Dopasuj etykiety do rolek z poprzedniej klatki (po najbliższym centroidzie),
        // żeby animacja slot-machine była ciągła mimo przeliczania chmar co klatkę.
        function acquireCloudRoll(needed, dt) {
          const prev = fighterCloudRender.rolls;
          const used = new Array(prev.length).fill(false);
          const MATCH_SQ = 6000 * 6000;
          const out = [];
          for (const need of needed) {
            let bestI = -1;
            let bestD = MATCH_SQ;
            for (let i = 0; i < prev.length; i++) {
              if (used[i] || prev[i].kind !== need.kind) continue;
              const dx = prev[i].x - need.mx;
              const dy = prev[i].y - need.my;
              const d = dx * dx + dy * dy;
              if (d < bestD) { bestD = d; bestI = i; }
            }
            let entry;
            if (bestI >= 0) { entry = prev[bestI]; used[bestI] = true; }
            else { entry = { kind: need.kind, roll: createRoll(need.target) }; }
            entry.x = need.mx;
            entry.y = need.my;
            stepRoll(entry.roll, need.target, dt);
            need.roll = entry.roll;
            out.push(entry);
          }
          fighterCloudRender.rolls = out;
        }
    
        function drawCloudRollingNumber(renderCtx, sx, sy, roll, target, opts = {}) {
          const fontPx = Math.max(11, Number(opts.fontPx) || 22);
          const color = opts.color || '#ffffff';
          renderCtx.save();
          renderCtx.font = `700 ${fontPx}px "Consolas","Menlo",monospace`;
          renderCtx.textAlign = 'center';
          renderCtx.textBaseline = 'middle';
          const { digitCount, frac, cells } = rollingCells(roll.display, target);
          const dw = Math.max(fontPx * 0.5, renderCtx.measureText('0').width);
          const lineH = fontPx * 1.02;
          const totalW = dw * digitCount;
          const startX = sx - totalW / 2;
    
          // Tło pod liczbą dla czytelności.
          const padX = fontPx * 0.34;
          const padY = fontPx * 0.28;
          const bgX = startX - padX;
          const bgY = sy - lineH * 0.5 - padY;
          const bgW = totalW + padX * 2;
          const bgH = lineH + padY * 2;
          renderCtx.fillStyle = 'rgba(4, 8, 14, 0.60)';
          if (renderCtx.roundRect) {
            renderCtx.beginPath();
            renderCtx.roundRect(bgX, bgY, bgW, bgH, fontPx * 0.28);
            renderCtx.fill();
          } else {
            renderCtx.fillRect(bgX, bgY, bgW, bgH);
          }
    
          renderCtx.fillStyle = color;
          renderCtx.shadowColor = color;
          renderCtx.shadowBlur = Math.max(2, fontPx * 0.2);
          for (let i = 0; i < cells.length; i++) {
            const cell = cells[i];
            const colX = startX + dw * (i + 0.5);
            renderCtx.save();
            renderCtx.beginPath();
            renderCtx.rect(colX - dw * 0.5, sy - lineH * 0.5, dw, lineH);
            renderCtx.clip();
            if (!cell.rolling) {
              renderCtx.fillText(String(cell.loDigit), colX, sy);
            } else {
              const hiOffset = (1 - frac) * lineH;
              const loOffset = hiOffset - lineH;
              renderCtx.fillText(String(cell.hiDigit), colX, sy + hiOffset);
              renderCtx.fillText(String(cell.loDigit), colX, sy + loOffset);
            }
            renderCtx.restore();
          }
          renderCtx.restore();
        }
    
        function drawFighterCloudBubble(renderCtx, cx, cy, r, stroke, fill, opts = {}) {
          renderCtx.save();
          renderCtx.beginPath();
          renderCtx.arc(cx, cy, r, 0, Math.PI * 2);
          if (fill) { renderCtx.fillStyle = fill; renderCtx.fill(); }
          renderCtx.strokeStyle = stroke;
          renderCtx.lineWidth = opts.lineWidth || 1.5;
          if (opts.dash) renderCtx.setLineDash(opts.dash);
          renderCtx.stroke();
          renderCtx.restore();
        }
    
        function updateAndDrawFighterClouds(renderCtx, cam) {
          const nowMs = (typeof performance !== 'undefined' ? performance.now() : 0);
          let dt = (nowMs - fighterCloudRender.lastNow) / 1000;
          if (!(dt > 0) || dt > 0.1) dt = 0.016;
          fighterCloudRender.lastNow = nowMs;
    
          // Zbierz opisy żywych myśliwców.
          const descriptors = [];
          for (const npc of npcs) {
            if (!isFighterUnit(npc)) continue;
            const p = npc.pos || npc;
            descriptors.push({
              x: Number(p.x) || 0,
              y: Number(p.y) || 0,
              team: npc.friendly ? 'friendly' : 'enemy',
              selected: Selection.units.has(npc),
              cmd: npc.friendly ? fighterCloudCommandTarget(npc) : null,
              ref: npc
            });
          }
          if (!descriptors.length) {
            if (fighterCloudRender.rolls.length) fighterCloudRender.rolls = [];
            return;
          }
    
          const zoom = Math.max(0.0001, Number(cam?.zoom) || 1);
          const { clouds } = computeFighterClouds(descriptors, { linkDist: 720 });
          const { battles, cloudToBattle } = computeBattles(clouds, { engageDist: 1300 });
    
          const fontPx = Math.max(13, Math.min(30, 20 * (0.65 + 0.35 * Math.min(2.2, zoom))));
          const labels = [];
    
          // 1) Zbiorcze linie rozkazu dla zaznaczonych chmar (JEDNA linia / chmara).
          renderCtx.save();
          for (const cloud of clouds) {
            if (cloud.team !== 'friendly' || !cloud.selected || !cloud.cmd) continue;
            const from = worldToScreen(cloud.cx, cloud.cy, cam);
            const to = worldToScreen(cloud.cmd.x, cloud.cmd.y, cam);
            const attackish = cloud.cmd.hasEntity || cloud.cmd.type === 'attack-move' || cloud.cmd.type === 'approach' || cloud.cmd.type === 'ram' || cloud.cmd.type === 'orbit';
            const lineColor = attackish ? 'rgba(255, 96, 96, 0.85)' : 'rgba(124, 255, 145, 0.85)';
            renderCtx.globalAlpha = 0.9;
            drawCommandArrow(renderCtx, from, to, lineColor, {
              lineWidth: Math.max(1.4, 2.0 * Math.sqrt(zoom)),
              dash: [12, 8],
              arrowLen: Math.max(14, 20 * Math.sqrt(zoom))
            });
            renderCtx.globalAlpha = 0.8;
            renderCtx.strokeStyle = lineColor;
            renderCtx.lineWidth = Math.max(1.2, 1.6 * Math.sqrt(zoom));
            renderCtx.beginPath();
            renderCtx.arc(to.x, to.y, Math.max(7, 10 * Math.sqrt(zoom)), 0, Math.PI * 2);
            renderCtx.stroke();
          }
          renderCtx.restore();
    
          // 2) Chmury bitewne (dogfight): jeden bąbel + zielony i czerwony licznik.
          for (const battle of battles) {
            const bc = worldToScreen(battle.centroid.x, battle.centroid.y, cam);
            const rScreen = Math.max(26, battle.radius * zoom);
            drawFighterCloudBubble(renderCtx, bc.x, bc.y, rScreen,
              'rgba(255, 176, 92, 0.42)', 'rgba(255, 138, 60, 0.06)',
              { lineWidth: Math.max(1.2, 1.6 * Math.sqrt(zoom)), dash: [10, 8] });
            if (battle.selected) {
              drawFighterCloudBubble(renderCtx, bc.x, bc.y, rScreen + 6,
                'rgba(120, 210, 255, 0.6)', null,
                { lineWidth: Math.max(1.2, 2 * Math.sqrt(zoom)), dash: [4, 6] });
            }
    
            // Etykiety: rozdzielone przy zbliżaniu, złączone (green nad red) w dogfight.
            const fS = worldToScreen(battle.friendlyCentroid.x, battle.friendlyCentroid.y, cam);
            const eS = worldToScreen(battle.enemyCentroid.x, battle.enemyCentroid.y, cam);
            const blend = Math.max(0, Math.min(1, (1600 - battle.separation) / 1300));
            const stack = fontPx * 0.82;
            const gx = fS.x + (bc.x - fS.x) * blend;
            const gy = fS.y + (bc.y - stack * 1.28 - fS.y) * blend;
            const rx = eS.x + (bc.x - eS.x) * blend;
            const ry = eS.y + (bc.y + stack * 1.28 - eS.y) * blend;
    
            labels.push({ kind: 'F', mx: battle.friendlyCentroid.x, my: battle.friendlyCentroid.y, sx: gx, sy: gy, target: battle.friendlyCount, color: '#7cff91', fontPx });
            labels.push({ kind: 'E', mx: battle.enemyCentroid.x, my: battle.enemyCentroid.y, sx: rx, sy: ry, target: battle.enemyCount, color: '#ff5d5d', fontPx });
          }
    
          // 3) Zaznaczone chmury POZA bitwą: bąbel + zielony licznik.
          for (const cloud of clouds) {
            if (cloudToBattle.has(cloud)) continue;
            if (cloud.team !== 'friendly' || !cloud.selected) continue;
            const cs = worldToScreen(cloud.cx, cloud.cy, cam);
            const rScreen = Math.max(24, cloud.radius * zoom);
            drawFighterCloudBubble(renderCtx, cs.x, cs.y, rScreen,
              'rgba(120, 210, 255, 0.65)', 'rgba(90, 180, 255, 0.06)',
              { lineWidth: Math.max(1.2, 1.8 * Math.sqrt(zoom)), dash: [6, 6] });
            labels.push({ kind: 'C', mx: cloud.cx, my: cloud.cy, sx: cs.x, sy: cs.y, target: cloud.count, color: '#7cff91', fontPx });
          }
    
          // 4) Rolki (slot-machine) — dopasuj stan i renderuj liczniki.
          acquireCloudRoll(labels, dt);
          for (const label of labels) {
            drawCloudRollingNumber(renderCtx, label.sx, label.sy, label.roll, label.target, {
              color: label.color,
              fontPx: label.fontPx
            });
          }
        }
    
        function drawWorldCommandMenu(renderCtx) {
          if (!worldCommandMenu.open || worldCommandMenu.placement.active || !worldCommandMenu.items.length) return;
          const mx = worldCommandMenu.x;
          const my = worldCommandMenu.y;
          const mw = worldCommandMenu.width;
          const rowH = worldCommandMenu.itemHeight;
          const mh = rowH * worldCommandMenu.items.length;
          const hover = hitTestCommandMenu(worldCommandMenu, mouse.x, mouse.y);
          const now = (typeof performance !== 'undefined' ? performance.now() : 0) * 0.001;
          const anim = computeCommandMenuOpenAnimation({ elapsed: now - (worldCommandMenu.openedAt || now) });
          const revealH = mh * anim.reveal;
          const hasTarget = !!worldCommandMenu.targetEntity;
          const accent = hasTarget ? '#ff3333' : (worldCommandMenu.mode === 'rts' ? '#38bdf8' : '#33ff33');
          const accentSoft = hasTarget ? 'rgba(255,51,51,0.38)' : (worldCommandMenu.mode === 'rts' ? 'rgba(56,189,248,0.36)' : 'rgba(51,255,51,0.32)');
          const accentFill = hasTarget ? 'rgba(40,5,5,0.92)' : 'rgba(4,12,20,0.92)';
    
          renderCtx.save();
          renderCtx.setTransform(1, 0, 0, 1, 0, 0);
          renderCtx.globalAlpha = anim.alpha;
          renderCtx.beginPath();
          renderCtx.rect(mx - 10, my - 10, mw + 20, Math.max(0, revealH + 20));
          renderCtx.clip();
          renderCtx.shadowColor = accentSoft;
          renderCtx.shadowBlur = 12;
          renderCtx.fillStyle = accentFill;
          renderCtx.fillRect(mx, my, mw, mh);
          renderCtx.shadowBlur = 0;
          renderCtx.strokeStyle = accentSoft;
          renderCtx.lineWidth = 1;
          renderCtx.strokeRect(mx + 0.5, my + 0.5, mw - 1, mh - 1);
          renderCtx.fillStyle = accent;
          renderCtx.fillRect(mx, my, 3, mh);
    
          const grad = renderCtx.createLinearGradient(mx + 3, my, mx + mw, my);
          grad.addColorStop(0, accentSoft);
          grad.addColorStop(0.62, 'rgba(0,0,0,0)');
          renderCtx.fillStyle = grad;
          renderCtx.fillRect(mx + 3, my + 4, mw - 8, 1);
    
          renderCtx.textAlign = 'left';
          renderCtx.textBaseline = 'middle';
          renderCtx.font = '700 11px "Courier New", monospace';
          for (let i = 0; i < worldCommandMenu.items.length; i++) {
            const item = worldCommandMenu.items[i];
            const y = my + i * rowH;
            const rowReveal = clamp((anim.reveal - i * 0.065) / 0.45, 0, 1);
            if (rowReveal <= 0) continue;
            const isHover = item === hover;
            const isScan = item.action === 'scan';
            const isAttack = item.action === 'attack';
            const rowAccent = isAttack ? '#ff8844' : (isScan ? '#38bdf8' : accent);
            renderCtx.globalAlpha = anim.alpha * rowReveal;
            renderCtx.fillStyle = isHover ? 'rgba(51,255,51,0.18)' : 'rgba(6,20,30,0.78)';
            renderCtx.fillRect(mx + 8, y + 4, mw - 16, rowH - 8);
            renderCtx.strokeStyle = isHover ? rowAccent : (isScan ? 'rgba(56,189,248,0.42)' : accentSoft);
            renderCtx.lineWidth = 1;
            renderCtx.strokeRect(mx + 8.5, y + 4.5, mw - 17, rowH - 9);
            if (item === hover) {
              renderCtx.fillStyle = rowAccent;
              renderCtx.fillRect(mx + 8, y + 4, 2, rowH - 8);
            }
            renderCtx.fillStyle = isHover ? '#e0f2fe' : (isScan ? '#bae6fd' : 'rgba(148,163,184,0.96)');
            renderCtx.fillText('> ' + (item.label || String(item.action || '').toUpperCase()), mx + 18 + (isHover ? 4 : 0), y + rowH * 0.5);
          }
          if (anim.reveal < 1) {
            renderCtx.globalAlpha = Math.max(0.15, anim.alpha);
            renderCtx.strokeStyle = accent;
            renderCtx.shadowColor = accent;
            renderCtx.shadowBlur = 10;
            renderCtx.beginPath();
            renderCtx.moveTo(mx, my + revealH);
            renderCtx.lineTo(mx + mw, my + revealH);
            renderCtx.stroke();
          }
          renderCtx.restore();
        }
    
        function handleRtsAdvancedOrderAtWorld(worldPoint) {
          const targetEntity = pickCommandTargetAtWorld(worldPoint);
          const order = rtsState.pendingOrder;
          clearPendingRtsOrder();
          if (!order) return false;
          if (order === 'approach') {
            issueApproachOrder(worldPoint, targetEntity);
            return true;
          }
          if (order === 'orbit') {
            issueOrbitOrder(worldPoint, targetEntity);
            return true;
          }
          if (order === 'direct-scan') {
            issueDirectScanOrder(targetEntity || pickCommandTargetAtWorld(worldPoint));
            return true;
          }
          return false;
        }
    
        function handleSingleSelectionClick(worldPoint, additive = false) {
          const hit = pickSelectableAllyAtWorld(worldPoint);
          const picked = hit?.towTrain?.head && !hit.towTrain.head.dead ? hit.towTrain.head : hit;
          if (!additive) Selection.units.clear();
          if (picked) {
            if (additive && Selection.units.has(picked)) Selection.units.delete(picked);
            else Selection.units.add(picked);
          }
        }
    
        function handleSelectionCommand(event) {
          if (!Selection.units.size) return true;
          const rect = canvas.getBoundingClientRect();
          const pt = screenToWorld(event.clientX - rect.left, event.clientY - rect.top);
          if (handleRtsAdvancedOrderAtWorld(pt)) return true;
          const clickedEnemy = pickEnemyTargetAtWorld(pt);
          const clickedPoint = clickedEnemy ? scannerTargetPoint(clickedEnemy) : pt;
          issueMoveOrder(clickedPoint, {
            attackMove: !!clickedEnemy,
            targetEntity: clickedEnemy || null
          });
          return true;
        }
    
        window.applyImmediateRtsOrder = (action) => {
          if (action === 'hold') issueHoldOrder();
        };
    
        // Helper: in split-screen, determine which mouse object gets input
        // based on controllerAssignment (keyboard player gets the real mouse)
        function _getMouseForScreen(clientX) {
          if (!splitScreenMode) return { m: mouse, isP2: false };
          const kbIsP2 = controllerAssignment.p2 === 'keyboard';
          const kbIsP1 = !controllerAssignment.p1 || controllerAssignment.p1 === 'keyboard';
          // If both are keyboard or neither, fall back to spatial: left=P1, right=P2
          if (kbIsP2 && !kbIsP1) return { m: mouse2, isP2: true };
          if (kbIsP1 && !kbIsP2) return { m: mouse, isP2: false };
          // Both keyboard or unknown — use position
