        // symulacji w sekundach (gameTime chodzi ×TIME_SCALE i zawija się co dobę).
        let bridgeSimTime = 0;
    
        // Gracz jest rysowany z pozą interpolowaną (hexShips3D) — okna i wyrzut
        // mostka muszą iść za nią, inaczej „pływają” po kadłubie przy prędkości.
        function bridgeRenderPose(entity) {
          if (entity !== ship) return null;
          const p = window.__interpShipPose;
          return p && Number.isFinite(p.x) && Number.isFinite(p.y) && Number.isFinite(p.angle) ? p : null;
        }
    
        function tickShipBridges(entity, dt) {
          if (!entity?.bridgeState || entity.destroyed) return;
          const flags = updateShipBridges(entity, dt, bridgeSimTime);
          if (flags & BRIDGE_EVENT.COMMAND_LOST) onBridgeCommandLost(entity);
          else if (flags & BRIDGE_EVENT.BRIDGE_LOST) onBridgeLost(entity);
        }
    
        // Padł jeden mostek, dowodzi zapasowy (Atlas).
        function onBridgeLost(entity) {
          if (entity === ship) pushZoneMessage('MOSTEK GŁÓWNY ZNISZCZONY — DOWODZENIE PRZEJMUJE ZAPASOWY', 3.2);
        }
    
        // Gracz ginie od razu zwykłą ścieżką. NPC staje się hulkiem: agonia w
