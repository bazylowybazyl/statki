          // wypuszcza pojedynczo z odstępem (efekt katapultowania).
          const perTube = new Array(tubes.length).fill(0);
          for (let i = 0; i < launch; i++) {
            const ti = i % tubes.length;
            const slot = base + i;
            __carrierSpawnQueue.push({
              carrier: npc,
              squadronId,
              idx: slot,
              tube: tubes[ti],
              // Slot w klinie liczony od już żyjących, żeby dolatujące uzupełnienia
              // nie wchodziły na miejsca zajęte przez wcześniejszą falę.
              slotInTube: Math.floor(base / tubes.length) + perTube[ti],
              delay: perTube[ti] * FIGHTER_LAUNCH_INTERVAL + ti * 0.08
            });
            perTube[ti]++;
          }
          npc.__hangarCd = 4.5 + Math.random() * 2.5;
        }
        window.updateNpcHangars = updateNpcHangars;
    
        function spawnCarrierFighter(carrier, squadronId, idx, tube, slotInTube) {
          if (!carrier || carrier.dead) return;
          if (tube?.hp?.destroyed) return;
          const tmpl = (squadronId === 'interceptor')
            ? (SUPPORT_SHIP_TEMPLATES.interceptor || SUPPORT_SHIP_TEMPLATES.fighter)
            : SUPPORT_SHIP_TEMPLATES.fighter;
          const f = makeNPCBase({ x: carrier.x, y: carrier.y }, { ...tmpl.stats, shield: tmpl.shield });
          f.friendly = carrier.friendly;
          f.isPirate = carrier.isPirate;
          f.mission = true;
          f.color = carrier.color;
          f.type = (squadronId === 'interceptor') ? 'interceptor' : 'fighter';
          applyFighterSquadronLoadout(f, squadronId);
          assignNpcShipFrame(f);
          f.squad = { leader: carrier };
          f.__carrierParent = carrier;
    
          // Kadłuby NPC nie mają w/h — połowę szerokości szacujemy z rozrzutu
          // hardpointów hangarów (i tak są przy burtach).
          const halfBeam = Math.max(carrier.radius || 150, Math.abs(tube?.local?.y || 0) * 1.35);
          if (tube) {
