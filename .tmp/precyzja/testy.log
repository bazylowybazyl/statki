          // Eskadry w hangarach mają własny tor (setHardpointHangarSquadrons) i
          // zachowują się bardziej jak amunicja niż broń — nie liczymy ich sztukowo.
          const trackInventory = !!inventory
            && opts.skipInventory !== true
            && hp.type !== HP.HANGAR;
          const previousMount = hp.mount || null;
          // Zniszczony hardpoint zabiera działo ze sobą — nie wraca do ładowni.
          const releasePrevious = () => {
            if (trackInventory && previousMount && !hp.destroyed) inventory.give(previousMount, 1);
          };
    
          if (hp.destroyed) {
            hp.mount = null;
