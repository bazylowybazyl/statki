            if (weapons) {
              for (const key of Object.keys(weapons)) {
                const entries = weapons[key];
                if (!Array.isArray(entries)) continue;
                for (let i = 0; i < entries.length; i++) {
                  const weapon = entries[i]?.weapon;
                  let range = Number(weapon?.baseRange ?? weapon?.range);
                  if ((!Number.isFinite(range) || range <= 0) && weapon?.id === 'hexlance_siege') {
