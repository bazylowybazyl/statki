        }
    
        function warnTargetOutOfLockRange(target) {
          const sensors = getScannerSensors();
          pushZoneMessage(`LOCK: CEL POZA ZASIEGIEM (${formatSensorRange(playerTargetDistance(target))}/${formatSensorRange(sensors.lockRange)})`, 1.25);
        }
    
        function isFriendlyScanTarget(n) {
          return !!(n && !n.dead && n.friendly);
        }
        function getScanObjectRadius(obj) {
          return Math.max(18, getTargetRadius(obj));
        }
        function pushScannerContact(target, type, tone, distance, out = scannerContacts) {
          if (!isTargetAlive(target)) return;
          if (type === 'station' || type === 'platform') target.__scannerContactType = type;
          out.push(buildScannerContact({
            target,
            type,
            tone,
            distance: Number.isFinite(distance) ? distance : 0,
            label: isAsteroidTarget(target) ? '' : getRadarTargetUnitId(target),
            classLabel: isAsteroidTarget(target) ? '' : getRadarTargetUnitClass(target)
          }));
        }
        function buildScannerStationDirectoryContacts() {
          const contacts = buildStationDirectoryContacts(stations, { ship, limit: 3 });
          for (const contact of contacts) {
            if (contact?.target) contact.target.__scannerContactType = 'station';
          }
          return contacts;
        }
        function collectScannerContacts(opts = {}) {
          const contacts = [];
          const range = Math.max(0, Number(opts.range) || getScannerActiveRange());
          const asteroidRangeValue = opts.asteroidRange == null ? getScannerAsteroidRange() : Number(opts.asteroidRange);
          const asteroidRange = Math.min(
            range,
            Math.max(0, Number.isFinite(Number(asteroidRangeValue)) ? Number(asteroidRangeValue) : getScannerAsteroidRange())
          );
          const includeAsteroids = opts.includeAsteroids !== false;
          const sweepSort = opts.sweepSort !== false;
          const rangeSq = range * range;
          const inRange = (obj) => {
            const dx = getTargetX(obj) - ship.pos.x;
            const dy = getTargetY(obj) - ship.pos.y;
            return dx * dx + dy * dy <= rangeSq;
          };
    
          for (const npc of npcs) {
            if (!npc || npc.dead || !inRange(npc)) continue;
