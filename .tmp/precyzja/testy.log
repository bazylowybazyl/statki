          // (statek gracza zintegrowany wyżej, NPC w npcStep), przed destruktorem.
          updateMegafreighterTrains(dt);
          const aiGridMs = window.__aiGridMs || 0;
          const aiEnemyBrainMs = window.__aiNpcEnemyBrainMs || 0;
          const aiFriendlyBrainMs = window.__aiNpcFriendlyBrainMs || 0;
          const aiSeparationMs = window.__aiSepMs || 0;
          const aiWeaponScanMs = window.__aiWeaponScanMs || 0;
          const aiTargetPickMs = window.__aiTargetPickMs || 0;
