            const cdMax = Math.max(0.01, Number(sw.cooldownMax) || cdLeft || 1);
            return { weapon: hexlance, charge: clamp(1 - (cdLeft / cdMax), 0, 1), ready: cdLeft <= 0 && sw.queue?.length === 0 };
          }
          const fallbackWeapon = builtins.find(loadout => loadout?.weapon)?.weapon || null;
