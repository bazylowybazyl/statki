            const st = getFleetPhase(side);
            return st ? { phase: st.phase, members: st.members, threats: st.threats, frontDist: Math.round(st.frontDist) || null } : null;
          };
          const out = { awareness: describeFleetAwareness(), friendly: phase('friendly'), pirate: phase('pirate'), wingOrder: SupportWing?.order };
          console.log(out);
          return out;
        };
    
        function applyRingFlightDevSpawn() {
          const params = new URLSearchParams(location.search);
          const targetKey = String(params.get('ringFlightTest') || '').toLowerCase();
          if (!params.has('dev') || !['earth', 'mars'].includes(targetKey)) return;
          const ring = getPlanetaryRing(targetKey);
          const planet = planets.find(p => String(p?.id || p?.name || '').toLowerCase() === targetKey);
          if (!ring?.layout || !planet) return;
          const radius = ring.layout.outerRadius + 1200;
          ship.pos.x = planet.x + radius;
          ship.pos.y = planet.y;
          ship.vel.x = 0;
          ship.vel.y = 0;
          ship.angle = Math.PI;
