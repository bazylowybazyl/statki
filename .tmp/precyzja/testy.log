        };
        window.targetingMode = targetingMode;
        // Kursor systemowy: render() zbiera życzenia w klatce (_cursorRequest = hover
        // stacji/opcji, _osCursorHidden = własny celownik), a na końcu zapisuje style
        // tylko przy zmianie. Dawniej góra render() co klatkę nadpisywała 'default'
        // i strzałka OS wisiała nad celownikiem.
        let _osCursorHidden = false;
        let _osCursorValue = null;
        let _cursorRequest = '';
    
        function setTargetingMode(nextMode) {
          const next = Math.max(TARGETING_MODE.SINGLE, Math.min(TARGETING_MODE.SELECT, Number(nextMode) || 0));
          if (next === targetingMode.current) return;
          targetingMode.current = next;
          targetingMode.acquireTarget = null;
          targetingMode.acquireProgress = 0;
          targetingMode.acquireHold = 0;
          targetingMode.acquireReadyFx = 0;
          targetingMode.acquireReadyRef = null;
