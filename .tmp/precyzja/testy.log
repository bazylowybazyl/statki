          ship.pos.y += ship.vel.y * dt;
    
          // granice
          const margin = Math.max(50, getAuToWorldUnits() * WORLD_EDGE_MARGIN_AU);
          ship.pos.x = clamp(ship.pos.x, margin, WORLD.w - margin);
          ship.pos.y = clamp(ship.pos.y, margin, WORLD.h - margin);
    
          ship.x = ship.pos.x;
          ship.y = ship.pos.y;
    
          // ====== PLAYER 2 PHYSICS (Split Screen) ======
          if (splitScreenMode && player2Ship && !player2Ship.destroyed) {
            const p2 = player2Ship;
            // Update thruster state
            composeShipThrusterCommand(p2, {
              main: input2.main,
              retro: input2.retro,
              torque: input2.torque,
              mainTorque: input2.main > 1e-3 ? input2.torque : 0,
              leftSide: input2.leftSide,
              rightSide: input2.rightSide
            });
            updateShipThrusterState(p2, dt);
    
            const p2sin = Math.sin(p2.angle);
            const p2cos = Math.cos(p2.angle);
            const p2fwd = { x: p2cos, y: p2sin };
            const p2right = { x: -p2sin, y: p2cos };
            const p2mass = Math.max(1, Number(p2.mass) || 200000);
            const p2inv = 1 / p2mass;
            const p2inertia = Math.max(1, Number(p2.inertia) || ((1 / 12) * p2mass * (((p2.w || 450) ** 2) + ((p2.h || 250) ** 2))));
    
            const p2rev = Math.max(0, -(clamp(p2.input?.thrustY ?? 0, -1, 1)));
            const p2retroState = p2.__retroState;
            const p2reverseEngaged = !!(p2rev > 0.05 && p2retroState?.reverseEngaged);
            const p2VelAlongForward = (p2.vel.x * p2fwd.x) + (p2.vel.y * p2fwd.y);
            const p2CounterNorm = clamp((-p2VelAlongForward) / Math.max(600, SHIP_PHYSICS.SPEED * 4.0), 0, 1);
            const p2forces = computeShipThrusterForces(p2, {
              mainForceMul: 1.0 + (p2CounterNorm * 1.75),
              sideForceMul: 1.6,
              reverseInput: p2reverseEngaged ? p2rev : 0
            }, _p2ForceScratch);
    
            const p2wfx = (p2fwd.x * p2forces.localFx) + (p2right.x * p2forces.localFy);
            const p2wfy = (p2fwd.y * p2forces.localFx) + (p2right.y * p2forces.localFy);
            p2.vel.x += p2wfx * p2inv * dt;
            p2.vel.y += p2wfy * p2inv * dt;
    
            p2.angVel = (p2.angVel || 0) + (p2forces.localTorque / p2inertia) * dt;
            p2.angVel = clamp(p2.angVel, -3.5, 3.5);
    
            // Damper (always active for P2 simplicity)
            const p2speed = Math.hypot(p2.vel.x, p2.vel.y);
            if (p2speed > 1e-4) {
              const brakeRate = p2reverseEngaged ? 0.06 : 0.4;
              const brakeDelta = Math.min(p2speed, p2speed * brakeRate * dt);
              const invSpd = 1 / p2speed;
              p2.vel.x -= p2.vel.x * invSpd * brakeDelta;
              p2.vel.y -= p2.vel.y * invSpd * brakeDelta;
            }
            p2.angVel *= Math.exp(-2.0 * dt);
            if (Math.abs(p2.angVel) < 0.003) p2.angVel = 0;
    
            p2.angle = wrapAngle((p2.angle || 0) + (p2.angVel || 0) * dt);
            p2.pos.x += p2.vel.x * dt;
            p2.pos.y += p2.vel.y * dt;
            p2.pos.x = clamp(p2.pos.x, margin, WORLD.w - margin);
            p2.pos.y = clamp(p2.pos.y, margin, WORLD.h - margin);
