            if (Selection.units.size) {
              ctx.save();
              ctx.strokeStyle = '#4a9eff';
              ctx.lineWidth = 2;
              ctx.globalAlpha = 0.9;
              for (const unit of [...Selection.units]) {
                if (!unit || unit.dead) { Selection.units.delete(unit); continue; }
                // Myśliwce nie dostają osobnych ringów — pokazuje je marker chmary.
                if (isFighterUnit(unit)) continue;
                const pos = unit.pos || unit;
                const baseR = unit.radius || unit.w || 30;
                const screen = worldToScreen(pos.x, pos.y, cam);
                ctx.beginPath();
                ctx.arc(screen.x, screen.y, Math.max(20, baseR + 12) * cam.zoom, 0, Math.PI * 2);
                ctx.stroke();
              }
              ctx.restore();
            }
    
            updateAndDrawFighterClouds(ctx, cam);
    
            drawRtsPlacementGhosts(ctx, cam);
    
            if (Selection.active && Selection.dragging && Selection.rect) {
              const x0 = Math.min(Selection.rect.x0, Selection.rect.x1);
              const y0 = Math.min(Selection.rect.y0, Selection.rect.y1);
              const x1 = Math.max(Selection.rect.x0, Selection.rect.x1);
              const y1 = Math.max(Selection.rect.y0, Selection.rect.y1);
              const s0 = worldToScreen(x0, y0, cam);
              const s1 = worldToScreen(x1, y1, cam);
              ctx.save();
              ctx.strokeStyle = '#7aa8ff';
              ctx.globalAlpha = 0.8;
              ctx.lineWidth = 2;
              ctx.strokeRect(Math.min(s0.x, s1.x), Math.min(s0.y, s1.y), Math.abs(s1.x - s0.x), Math.abs(s1.y - s0.y));
              ctx.restore();
            }
    
            if (LineSpawnState.active && LineSpawnState.dragging && LineSpawnState.startScreen && LineSpawnState.curScreen) {
              const p0 = LineSpawnState.startScreen;
              const p1 = LineSpawnState.curScreen;
              const dragLenPx = Math.hypot(p1.x - p0.x, p1.y - p0.y);
              const lineKey = LineSpawnState.selectedKey;
              const previewCount = lineKey ? computeLineSpawnCount(lineKey, dragLenPx) : 0;
              ctx.save();
              ctx.strokeStyle = '#eeb763';
              ctx.globalAlpha = 0.85;
              ctx.lineWidth = 2;
              ctx.setLineDash([8, 6]);
              ctx.beginPath();
              ctx.moveTo(p0.x, p0.y);
              ctx.lineTo(p1.x, p1.y);
              ctx.stroke();
              ctx.setLineDash([]);
              if (dragLenPx >= LINE_SPAWN_MIN_DRAG_PX && previewCount > 0) {
                ctx.fillStyle = '#eeb763';
                for (let i = 0; i < previewCount; i++) {
                  const t = previewCount === 1 ? 0.5 : i / (previewCount - 1);
                  const px = p0.x + (p1.x - p0.x) * t;
                  const py = p0.y + (p1.y - p0.y) * t;
                  ctx.beginPath();
                  ctx.arc(px, py, 3, 0, Math.PI * 2);
                  ctx.fill();
                }
              }
              const midX = (p0.x + p1.x) / 2;
              const midY = (p0.y + p1.y) / 2;
              const label = dragLenPx < LINE_SPAWN_MIN_DRAG_PX ? '...' : `${previewCount}x`;
              ctx.font = 'bold 16px Consolas, monospace';
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              const textW = ctx.measureText(label).width;
              ctx.fillStyle = 'rgba(0,0,0,0.6)';
              ctx.fillRect(midX - textW / 2 - 10, midY - 14, textW + 20, 28);
              ctx.strokeStyle = '#eeb763';
              ctx.lineWidth = 1;
              ctx.strokeRect(midX - textW / 2 - 10, midY - 14, textW + 20, 28);
              ctx.fillStyle = '#eeb763';
              ctx.fillText(label, midX, midY);
              ctx.restore();
            }
    
            if (!splitScreenMode) {
              // ======= STATEK =======
              const shipS = worldToScreen(interpPos.x, interpPos.y, cam);
              const spriteScale = ship.visual?.spriteScale || 1;
              const visualW = ship.w * spriteScale;
              const visualH = ship.h * spriteScale;
              ctx.imageSmoothingEnabled = true;
              ctx.imageSmoothingQuality = 'high';
              ctx.save();
              ctx.translate(shipS.x, shipS.y);
              ctx.scale(camera.zoom, camera.zoom);
              ctx.rotate(interpAngle);
    
              // --- 1. OBLICZANIE ACTIVE THRUSTERS ---
              // Gdy statek gracza jest renderowany w 3D, pomijamy 2D exhausty, bo nakładają się na kadłub.
              // --- 2. Rysowanie Warp Glow (ładowanie) ---
              let warpGlowProgress = 0;
              if (warp.state === 'charging') {
                warpGlowProgress = clamp(warp.charge / warp.chargeTime, 0, 1);
              } else if (warp.state === 'active' && warp.entryProgress < 1) {
                warpGlowProgress = 1 - smoothstep01(warp.entryProgress);
              }
              if (warpGlowProgress > 0) {
                const chargeRadius = Math.max(visualW, visualH) * 0.7;
                drawWarpChargeEffectLocal(warpGlowProgress, chargeRadius, spriteScale);
              }
    
              // --- 3. Rysowanie KADLUBA ---
              if (ship.hexGrid) {
                if (ship.hp < ship.maxHp) {
                  const zoom = camera.zoom;
                  const size = (ship.radius || 20); // Usunąłem * zoom, bo ctx jest już wyskalowany w linii 2010
                  const hpPct = Math.max(0, ship.hp / ship.maxHp);
                  ctx.save();
                  // Rysujemy lokalnie względem statku
                  ctx.fillStyle = '#ef4444';
                  ctx.fillRect(-size, -size - 10, size * 2, 4);
                  ctx.fillStyle = '#22c55e';
                  ctx.fillRect(-size, -size - 10, size * 2 * hpPct, 4);
                  ctx.restore();
                }
                // Nie robimy return, żeby silniki i efekty (rysowane dalej) się wykonały
              }
              else if (USE_SHIP_SPRITE && ship.spriteReady) {
                const spriteImg = ship.renderSpriteImage || shipSprite;
                const scale = (ship.h / ship.spriteH) * spriteScale;
                const drawW = ship.spriteW * scale;
                const drawH = ship.spriteH * scale;
    
                ctx.save();
                ctx.globalAlpha = 0.33;
                ctx.drawImage(spriteImg, -drawW / 2 + 6, -drawH / 2 + 8, drawW, drawH);
                ctx.restore();
    
                ctx.drawImage(spriteImg, -drawW / 2, -drawH / 2, drawW, drawH);
              } else {
                // Fallback proceduralny (gdy brak sprite'a)
                ctx.fillStyle = 'rgba(3,8,18,0.8)';
                ctx.fillRect(-visualW / 2 + 6 * spriteScale, -visualH / 2 + 8 * spriteScale, visualW, visualH);
                const g = ctx.createLinearGradient(-visualW / 2, -visualH / 2, visualW / 2, visualH / 2);
                g.addColorStop(0, '#1d2740'); g.addColorStop(1, '#2d3b55');
                ctx.fillStyle = g;
                roundRect(ctx, -visualW / 2, -visualH / 2, visualW, visualH, 10 * spriteScale);
                ctx.fill();
    
                ctx.save();
                ctx.strokeStyle = 'rgba(255,255,255,0.06)';
                ctx.lineWidth = 1.5;
                roundRect(ctx, -visualW / 2, -visualH / 2, visualW, visualH, 10 * spriteScale);
                ctx.stroke();
                ctx.globalAlpha = 0.25;
                ctx.beginPath();
                ctx.moveTo(-visualW * 0.35, -visualH * 0.20); ctx.lineTo(visualW * 0.35, -visualH * 0.20);
                ctx.moveTo(-visualW * 0.35, visualH * 0.20); ctx.lineTo(visualW * 0.35, visualH * 0.20);
                ctx.stroke();
                ctx.globalAlpha = 1;
                ctx.restore();
    
                ctx.fillStyle = '#a8d1ff';
                ctx.beginPath();
                ctx.ellipse(0, -6 * spriteScale, visualW * 0.22, visualH * 0.22, 0, 0, Math.PI * 2);
                ctx.fill();
    
                ctx.save();
                ctx.rotate(-interpAngle);
                const glare = ctx.createRadialGradient(0, -visualH * 0.18, 6 * spriteScale, 0, -visualH * 0.18, visualW * 0.5);
                glare.addColorStop(0, 'rgba(255,255,255,0.25)');
                glare.addColorStop(1, 'rgba(255,255,255,0)');
                ctx.fillStyle = glare;
                ctx.beginPath();
                ctx.ellipse(0, -6 * spriteScale, visualW * 0.22, visualH * 0.22, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
              }
    
              // --- 4. Rysowanie ELEMENTÓW PROCEDURALNYCH (gdy brak sprite'a) ---
              if (!(USE_SHIP_SPRITE && ship.spriteReady)) {
                for (const pod of ship.pods) {
                  ctx.save();
                  ctx.translate(pod.offset.x, pod.offset.y);
                  const pg = ctx.createLinearGradient(-pod.w / 2, -pod.h / 2, pod.w / 2, pod.h / 2);
                  pg.addColorStop(0, '#1d2740'); pg.addColorStop(1, '#2d3b55');
                  ctx.fillStyle = pg;
                  roundRect(ctx, -pod.w / 2, -pod.h / 2, pod.w, pod.h, 6 * spriteScale);
                  ctx.fill();
                  ctx.restore();
                }
    
                const mainE = ship.engines.main;
                ctx.save();
                const mainVisual = mainE.visualOffset || mainE.offset;
                ctx.translate(mainVisual.x, mainVisual.y);
                ctx.fillStyle = '#2a3a56';
                roundRect(ctx, -14 * spriteScale, -9 * spriteScale, 28 * spriteScale, 18 * spriteScale, 6 * spriteScale);
                ctx.fill();
                ctx.save();
                ctx.globalAlpha = 0.8;
                ctx.shadowBlur = 20;
                ctx.shadowColor = 'rgba(150,200,255,0.9)';
                ctx.fillStyle = 'rgba(160,210,255,0.75)';
                roundRect(ctx, -8 * spriteScale, -6 * spriteScale, 16 * spriteScale, 12 * spriteScale, 4 * spriteScale);
                ctx.fill();
                ctx.restore();
                ctx.restore();
    
                for (const k of ['sideLeft', 'sideRight', 'torqueLeft', 'torqueRight']) {
                  const e = ship.engines[k];
                  ctx.save();
                  const vis = e.visualOffset || e.offset;
                  ctx.translate(vis.x, vis.y);
                  ctx.fillStyle = '#2f3b57';
                  roundRect(ctx, -6 * spriteScale, -6 * spriteScale, 12 * spriteScale, 12 * spriteScale, 3 * spriteScale);
                  ctx.fill();
                  ctx.restore();
                }
    
                // Działka boczne
                ctx.fillStyle = '#cbd6ff';
                for (const off of ship.sideGunsLeft) {
                  ctx.save();
                  ctx.translate(off.x, off.y);
                  roundRect(ctx, -12 * spriteScale, -3 * spriteScale, 8 * spriteScale, 6 * spriteScale, 3 * spriteScale);
                  ctx.fill();
                  ctx.restore();
                }
                for (const off of ship.sideGunsRight) {
                  ctx.save();
                  ctx.translate(off.x, off.y);
                  roundRect(ctx, 4 * spriteScale, -3 * spriteScale, 8 * spriteScale, 6 * spriteScale, 3 * spriteScale);
                  ctx.fill();
                  ctx.restore();
                }
              }
    
              ctx.restore(); // ship
            }
    
    
            PerfHUD.addTiming('render2dPlayerTime', performance.now() - tRender2dSection);
            tRender2dSection = performance.now();
    
            // === Turret Pass ===
            // Wiezyczki siedza NAD kadlubem (WebGL jest juz przeblitowany na te
            // kanwe) i POD pociskami logicznie, choc pociski lecą warstwe nizej —
            // pocisk wychodzacy z lufy wynurza sie zza dziala, i o to chodzi.
            Turret2D.draw(ctx, cam);
    
            PerfHUD.addTiming('render2dTurretTime', performance.now() - tRender2dSection);
            tRender2dSection = performance.now();
    
            // === Projectile Pass ===
            for (const b of bullets) {
              if (b.__renderedByThree === true) continue;
              CanvasVFX.drawBulletVisual(ctx, b, cam, alpha);
            }
    
            // === Hexlance Projectiles (Supercapital Weapon) ===
            const mWorldRender = screenToWorld(mouse.x, mouse.y, cam);
            // FIX: Przekazujemy interpolowaną pozycję i kąt
            Superweapon.drawSuperweapon(ctx, cam, ship, worldToScreen, mWorldRender, { pos: interpPos, angle: interpAngle });
    
            PerfHUD.addTiming('render2dProjectilesTime', performance.now() - tRender2dSection);
            tRender2dSection = performance.now();
    
            CanvasVFX.drawLightnings(ctx, cam);
    
            // === VFX Pass ===
            CanvasVFX.drawBeams(ctx, cam);
            CanvasVFX.drawParticles(ctx, cam);
            // Pęknięcia flaku idą po cząstkach: dym ma przykryć iskry, a ogień
            // i odłamki dopalić się addytywnie na wierzchu.
            FlakBurstVFX.draw(ctx, cam);
    
            PerfHUD.addTiming('render2dVfxTime', performance.now() - tRender2dSection);
            tRender2dSection = performance.now();
    
            // === FOG OF WAR === (disabled — will be reimplemented later)
    
            // === BELT AMBIENT DIM === Głębiej w pasie asteroid = ciemniejsza scena.
            // Overlay leży nad światem (2D + WebGL pod spodem), ale pod HUD/celownikami.
            {
              const beltDim = window.beltBackdrop ? window.beltBackdrop.getAmbientDim() : 0;
              if (beltDim > 0.004) {
                ctx.save();
                ctx.globalAlpha = 1;
                ctx.fillStyle = `rgba(3, 5, 10, ${(beltDim * 0.12).toFixed(3)})`;
                ctx.fillRect(0, 0, W, H);
                ctx.restore();
              }
            }
    
            // === UI / HUD Pass ===
            // Rysuj HUD na Canvasie TYLKO jeśli nie jesteśmy w menu
            if (!isMainMenuVisible()) {
              hudRenderNav(ship, cam);
              drawStabilizerHeadingMarker(ship, cam, interpPos, interpAngle);
            }
    
            // Kadr bieżącej kamery (w split-screenie połówka). Pola kopiujemy od razu:
            // _vpScratch nadpisuje każde worldToScreenInto.
            const _hudVp = getViewportForCamera(cam);
            const hudVpX = _hudVp.x, hudVpY = _hudVp.y, hudVpW = _hudVp.w, hudVpH = _hudVp.h;
            const hudLineW = Math.max(1.5, 2.5 * Math.sqrt(cam.zoom));
            const hudGlowOn = cam.zoom >= HUD_GLOW_MIN_ZOOM;
    
            if (scannerState.active && scanWaves.length) {
              for (const w of scanWaves) {
                const center = worldToScreenInto(w.x, w.y, cam, _hudCircleScreen);
                const cx = center.x;
                const cy = center.y;
                const radius = Math.max(1, w.r * cam.zoom);
                const fade = clamp(1 - (w.r / Math.max(1, w.max)), 0, 1);
                ctx.save();
                ctx.strokeStyle = 'rgba(110,217,255,0.9)';
                // Fala dochodzi do ~90k j. — przez większość życia jej obwód w ogóle
                // nie przecina kadru, a pełny okrąg był kreskowany i rozmywany co klatkę.
                const waveArc = circleArcInRect(cx, cy, radius, hudVpX, hudVpY, hudVpW, hudVpH);
                if (waveArc) {
                  if (hudGlowOn) {
                    ctx.lineWidth = hudLineW * 3;
                    strokeHudDashedArc(ctx, cx, cy, radius, waveArc, 18 * cam.zoom, 12 * cam.zoom, (0.18 + 0.42 * fade) * 0.3);
                  }
                  ctx.lineWidth = hudLineW;
                  strokeHudDashedArc(ctx, cx, cy, radius, waveArc, 18 * cam.zoom, 12 * cam.zoom, 0.18 + 0.42 * fade);
                }
                const innerR = Math.max(6, radius * 0.14);
                const innerArc = circleArcInRect(cx, cy, innerR, hudVpX, hudVpY, hudVpW, hudVpH);
                if (innerArc) {
                  ctx.setLineDash([]);
                  if (hudGlowOn) {
                    ctx.globalAlpha = (0.22 + 0.35 * fade) * 0.3;
                    ctx.lineWidth = hudLineW * 3;
                    ctx.beginPath();
                    ctx.arc(cx, cy, innerR, innerArc.start, innerArc.end);
                    ctx.stroke();
                  }
                  ctx.globalAlpha = 0.22 + 0.35 * fade;
                  ctx.lineWidth = hudLineW;
                  ctx.beginPath();
                  ctx.arc(cx, cy, innerR, innerArc.start, innerArc.end);
                  ctx.stroke();
                }
                ctx.restore();
    
                for (let j = w.nextContact; j < w.contacts.length; j++) {
                  const contact = w.contacts[j];
                  if (!contact || !isTargetAlive(contact.target)) continue;
                  const revealIn = scannerContactRevealTime(contact, w) - w.age;
                  if (revealIn > SCANNER_ACQUIRE_LEAD_TIME) break;
                  const acquire = clamp(1 - (revealIn / SCANNER_ACQUIRE_LEAD_TIME), 0, 1);
                  if (acquire <= 0) continue;
                  const obj = contact.target;
                  const s = worldToScreenInto(getTargetX(obj), getTargetY(obj), cam, _hudMarkerScreen);
                  const baseRad = (getScanObjectRadius(obj) + 16) * cam.zoom;
                  const rad = baseRad * (1.25 - 0.22 * acquire);
                  const tick = Math.max(8, rad * 0.3);
                  const gap = Math.max(6, rad * 0.5);
                  if (hudMarkerOffscreen(s.x, s.y, Math.max(rad, gap + tick) + hudLineW * 3, hudVpX, hudVpY, hudVpW, hudVpH)) continue;
                  const tone = scannerToneRgb(contact.tone);
                  const arcStart = -Math.PI / 2;
                  const arcEnd = -Math.PI / 2 + Math.PI * 2 * acquire;
                  ctx.save();
                  ctx.strokeStyle = hudRgba(tone, 0.95);
                  if (hudGlowOn) {
                    ctx.globalAlpha = (0.25 + 0.55 * acquire) * 0.3 * acquire;
                    ctx.lineWidth = hudLineW * 3;
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, rad, arcStart, arcEnd);
                    ctx.stroke();
                  }
                  ctx.globalAlpha = 0.25 + 0.55 * acquire;
                  ctx.lineWidth = hudLineW;
                  ctx.beginPath();
                  ctx.arc(s.x, s.y, rad, arcStart, arcEnd);
                  ctx.stroke();
                  ctx.globalAlpha *= 0.9;
                  ctx.beginPath();
                  ctx.moveTo(s.x - gap - tick, s.y - gap); ctx.lineTo(s.x - gap, s.y - gap);
                  ctx.moveTo(s.x - gap, s.y - gap - tick); ctx.lineTo(s.x - gap, s.y - gap);
                  ctx.moveTo(s.x + gap, s.y - gap - tick); ctx.lineTo(s.x + gap, s.y - gap);
                  ctx.lineTo(s.x + gap + tick, s.y - gap);
                  ctx.moveTo(s.x - gap - tick, s.y + gap); ctx.lineTo(s.x - gap, s.y + gap);
                  ctx.lineTo(s.x - gap, s.y + gap + tick);
                  ctx.moveTo(s.x + gap, s.y + gap + tick); ctx.lineTo(s.x + gap, s.y + gap);
                  ctx.lineTo(s.x + gap + tick, s.y + gap);
                  ctx.stroke();
                  ctx.restore();
                }
              }
            }
    
            if (radarPings.length || scannerRevealFx.length) {
              const pingLineW = Math.max(1, 2 * Math.sqrt(cam.zoom));
              for (const p of radarPings) {
                const s = worldToScreenInto(p.x, p.y, cam, _hudMarkerScreen);
                const t = clamp(p.age / Math.max(0.001, p.life), 0, 1);
                const rad = (24 + 44 * t) * cam.zoom;
                if (hudMarkerOffscreen(s.x, s.y, rad + pingLineW * 3, hudVpX, hudVpY, hudVpW, hudVpH)) continue;
                ctx.save();
                ctx.strokeStyle = 'rgba(110,217,255,0.9)';
                if (hudGlowOn) {
                  ctx.globalAlpha = 0.55 * (1 - t) * 0.3;
                  ctx.lineWidth = pingLineW * 3;
                  ctx.beginPath();
                  ctx.arc(s.x, s.y, rad, 0, Math.PI * 2);
                  ctx.stroke();
                }
                ctx.globalAlpha = 0.55 * (1 - t);
                ctx.lineWidth = pingLineW;
                ctx.beginPath();
                ctx.arc(s.x, s.y, rad, 0, Math.PI * 2);
                ctx.stroke();
                ctx.restore();
              }
              const revealLineW = Math.max(1.5, 2.4 * Math.sqrt(cam.zoom));
              const revealFont = `${Math.max(10, 11 * Math.sqrt(cam.zoom)).toFixed(0)}px Consolas, monospace`;
              for (const fx of scannerRevealFx) {
                const obj = fx.target;
                if (!isTargetAlive(obj)) continue;
                const s = worldToScreenInto(getTargetX(obj), getTargetY(obj), cam, _hudMarkerScreen);
                const t = clamp(fx.age / Math.max(0.001, fx.life), 0, 1);
                const baseRad = (getScanObjectRadius(obj) + 18) * cam.zoom;
                const rad = baseRad + (22 * t * cam.zoom);
                // Etykieta stoi na prawo od okręgu — zapas ~280 px w tę stronę.
                if (s.x + rad + 280 < hudVpX || s.x - rad - 8 > hudVpX + hudVpW
                  || s.y + rad + 24 < hudVpY || s.y - rad - 24 > hudVpY + hudVpH) continue;
                const tone = scannerToneRgb(fx.contact?.tone);
                ctx.save();
                ctx.strokeStyle = hudRgba(tone, 0.95);
                ctx.fillStyle = hudRgba(tone, 0.95);
                if (hudGlowOn) {
                  ctx.globalAlpha = 0.85 * (1 - t) * 0.3;
                  ctx.lineWidth = revealLineW * 3;
                  ctx.beginPath();
                  ctx.arc(s.x, s.y, rad, 0, Math.PI * 2);
                  ctx.stroke();
                }
                ctx.globalAlpha = 0.85 * (1 - t);
                ctx.lineWidth = revealLineW;
                ctx.beginPath();
                ctx.arc(s.x, s.y, rad, 0, Math.PI * 2);
                ctx.stroke();
                if (t < 0.78) {
                  ctx.font = revealFont;
                  ctx.textBaseline = 'middle';
                  // Podsumowanie (etykieta + masa) liczone raz na efekt, nie co klatkę.
                  if (fx._summary === undefined) fx._summary = scannerRevealSummary(fx.contact);
                  ctx.fillText(fx._summary, s.x + rad + 10, s.y - Math.max(12, rad * 0.25));
                }
                ctx.restore();
              }
            }
    
            // Stary hover-ring został usunięty; wizualizację celu prowadzi wyłącznie
            // aktywny celownik SINGLE/MULTI/SUB. Stacja nadal sygnalizuje klik kursorem.
            if (scan.target && scan.targetType === 'station' && mouse.overCanvas && !stationUI.open) {
              _cursorRequest = 'pointer';
            }
            const radarUiActive = false;
            if (radarUiActive) {
              radarTargetingUI.draw(ctx, {
                width: W,
                height: H,
                camera: cam,
                worldToScreen,
                lockAnim: scannerState.lockAnim,
                targets: scannerContacts
                  .filter(c => c && c.target && isTargetAlive(c.target))
                  .map(c => c.target),
                isLocked: (target) => lockedTargets.includes(target) || target === lockedTarget
              });
            }
            if (!radarUiActive && scannerState.active && scannerContacts.length) {
              // Kontakty zostają na liście po impulsie (do śmierci celu), więc ta pętla
              // chodzi co klatkę przez resztę sesji — poza kadrem nic nie rysujemy,
              // a poświata idzie szerszą linią zamiast shadowBlur na każdy kontakt.
              for (const contact of scannerContacts) {
                const obj = contact.target;
                if (!isTargetAlive(obj)) continue;
                const s = worldToScreenInto(getTargetX(obj), getTargetY(obj), cam, _hudMarkerScreen);
                const baseRad = (getScanObjectRadius(obj) + (contact.type === 'station' ? 20 : 12)) * cam.zoom;
                const tick = Math.max(8, baseRad * 0.38);
                const gap = Math.max(6, baseRad * 0.45);
                if (hudMarkerOffscreen(s.x, s.y, Math.max(baseRad, gap + tick) + hudLineW * 3, hudVpX, hudVpY, hudVpW, hudVpH)) continue;
                const tone =
                  contact.tone === 'hostile' ? '110,255,190' :
                    (contact.tone === 'resource' ? '238,183,99' : (contact.tone === 'friendly' ? '80,190,255' : '150,255,220'));
                ctx.save();
                ctx.strokeStyle = hudRgba(tone, 0.88);
                // Okrąg dużego okrętu przy zbliżeniu potrafi objąć cały kadr — wtedy
                // circleArcInRect zwraca null i rysujemy same narożniki.
