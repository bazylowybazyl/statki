          return p && Number.isFinite(p.x) && Number.isFinite(p.y) && Number.isFinite(p.angle) ? p : null;
        }
    
        function tickShipBridges(entity, dt) {
          if (!entity?.bridgeState || entity.destroyed) return;
          const flags = updateShipBridges(entity, dt, bridgeSimTime);
          if (flags & BRIDGE_EVENT.COMMAND_LOST) onBridgeCommandLost(entity);
          else if (flags & BRIDGE_EVENT.BRIDGE_LOST) onBridgeLost(entity);
        }
    
        // Padł jeden mostek, dowodzi zapasowy (Atlas).
        function onBridgeLost(entity) {
          if (entity === ship) pushZoneMessage('MOSTEK GŁÓWNY ZNISZCZONY — DOWODZENIE PRZEJMUJE ZAPASOWY', 3.2);
        }
    
        // Gracz ginie od razu zwykłą ścieżką. NPC staje się hulkiem: agonia w
        // npcStep (bez AI, broni i ciągu), potem finishBridgeKill robi z niego wrak.
        function onBridgeCommandLost(entity) {
          if (entity === ship) {
            pushZoneMessage('UTRATA DOWODZENIA — MOSTKI ZNISZCZONE', 3.2);
            releaseShipBridges(ship);
            if (!ship.destroyed) applyDamageToPlayer((Number(ship.hull?.val) || 0) + 1, { bypassShield: true });
            return;
          }
          if (entity.dead || entity.isWreck) return;
          beginBridgeHulk(entity);
          // Kadencja wykrywa kill do ~0,1 s po ostatnim trafieniu, a okno zasługi
          // (PLAYER_KILL_CREDIT_WINDOW) to 0,1 s czasu rzeczywistego — trafienie
          // gracza z ostatniej sekundy liczy się jak zabójcze.
          const hitAt = Number(entity._lastPlayerHit);
          const playerKill = Number.isFinite(hitAt) && gameTime - hitAt >= 0 && gameTime - hitAt <= TIME_SCALE;
          if (playerKill) entity._lastPlayerHit = gameTime;
