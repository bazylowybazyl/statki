        setLiveDebugPerfHud(PerfHUD);
        installLiveDebugConsoleApi();
    
        const supportUIRoot = document.getElementById('panel-support');
        const supportGuardBtn = document.getElementById('support-guard');
        const supportEngageBtn = document.getElementById('support-engage');
        const supportFactionTerranBtn = document.getElementById('support-faction-terran');
        const supportFactionPirateBtn = document.getElementById('support-faction-pirate');
        const supportFactionIndependentBtn = document.getElementById('support-faction-independent');
        const supportRosterRoot = document.getElementById('support-roster');
        const supportLineModeBtn = document.getElementById('support-line-mode');
        let carrierSpawnBtn = null;
        const shieldControlsRoot = document.getElementById('panel-shield');
        const energyShotBtn = document.getElementById('btn-energy-shot');
        const shieldToggleBtn = document.getElementById('btn-shield-toggle');
        const globalShieldsToggleBtn = document.getElementById('btn-global-shields-toggle');
        const supportDragState = {
          active: false,
          key: null,
          sourceBtn: null
        };
        const SUPPORT_DRAG_TYPES = new Set([
          'carrier',
          'supercapital',
          'atlas',
          'megafreighter',
          'frigate_pd',
          'frigate_laser',
          'destroyer',
          'battleship',
          'pirate_battleship'
        ]);
        const SUPPORT_CLICK_TYPES = new Set([
          'fighter',
          'carrier_fighter'
        ]);
    
        // --- Tryb LINIE: masowe spawnowanie wzdluz przeciaganej linii (dev/sandbox) ---
        // Kazdy klucz rostera dostaje "klase wagowa" jednostki; klasa okresla ile
        // sztuk zmiesci sie na linii dlugosci calego ekranu (im ciezsza klasa, tym
        // mniej sztuk — fregaty leca ciasno, kapitalki szeroko).
        const SUPPORT_LINE_TIER_BY_KEY = Object.freeze({
          frigate_pd: 'frigate',
          frigate_laser: 'frigate',
          destroyer: 'destroyer',
          battleship: 'battleship',
          pirate_battleship: 'battleship',
          carrier: 'capital',
          supercapital: 'capital',
          atlas: 'capital',
          megafreighter: 'capital'
        });
        const SUPPORT_LINE_TIER_MAX = Object.freeze({
          frigate: 40,
          destroyer: 20,
          battleship: 10,
          capital: 5
        });
        const LINE_SPAWN_MIN_DRAG_PX = 24;
        // Suwak "szerokosc" = ile miejsca dostaje jeden statek. 100% to rozstaw
        // bazowy (pelny ekran = tyle sztuk, ile mowi SUPPORT_LINE_TIER_MAX);
        // mniejsza wartosc zageszcza linie, wiec na tej samej dlugosci miesci sie
        // proporcjonalnie wiecej jednostek.
        const LINE_SPAWN_WIDTH_MIN_PCT = 25;
        const LineSpawnState = {
          active: false,
          selectedKey: null,
          selectedBtn: null,
          widthPct: 100,
          dragging: false,
          startScreen: null,
          curScreen: null,
          startWorld: null,
          curWorld: null
        };
    
        const SUPPORT_FACTION_MODES = Object.freeze({
          terran: 'friendly',
          pirate: 'pirate',
          independent: 'dummy'
        });
    
        const SUPPORT_FACTION_ROSTERS = Object.freeze({
          terran: [
            { key: 'frigate_pd', name: 'Custos', role: 'Frigate', count: 'x50', icon: 'frigate', drag: true },
            { key: 'destroyer', name: 'Hasta', role: 'Destroyer', count: 'x5', icon: 'destroyer', drag: true },
            { key: 'battleship', name: 'Bellator', role: 'Battleship', count: 'x5', icon: 'battleship', drag: true },
            { key: 'carrier', name: 'Citadella', role: 'Carrier', count: 'x1', icon: 'carrier', drag: true },
            { key: 'supercapital', name: 'Colossus', role: 'Supercapital', count: 'x1', icon: 'supercapital', drag: true },
            { key: 'fighter', name: 'Fighter Wing', role: 'Hangar squadron', count: 'x200', icon: 'fighter', click: true }
          ],
          pirate: [
            { key: 'frigate_pd', name: 'Pirate Frigate', role: 'Raider frigate', count: 'x50', icon: 'frigate', drag: true },
            { key: 'destroyer', name: 'Pirate Destroyer', role: 'Raider destroyer', count: 'x5', icon: 'destroyer', drag: true },
            { key: 'pirate_battleship', name: 'Pirate Battleship', role: 'Raider battleship', count: 'x1', icon: 'battleship', drag: true }
          ],
          independent: [
            { key: 'atlas', name: 'Atlas', role: 'Independent supercapital', count: 'x1', icon: 'supercapital', drag: true },
            { key: 'megafreighter', name: 'Megafreighter', role: 'Freight train', count: 'x1', icon: 'supercapital', drag: true }
          ]
        });
    
        function isSupportDragKey(key) {
          return SUPPORT_DRAG_TYPES.has(key);
        }
    
        function normalizeSupportFaction(faction) {
          const key = String(faction || '').trim().toLowerCase();
          return SUPPORT_FACTION_ROSTERS[key] ? key : 'terran';
        }
    
        function getSupportModeForFaction(faction) {
          return SUPPORT_FACTION_MODES[normalizeSupportFaction(faction)] || 'friendly';
        }
    
        function supportIconMarkup(icon) {
          if (icon === 'supercapital') {
            return '<div class="icon-supercapital"><div class="icon-sc-wing"></div><div class="icon-sc-hull"></div><div class="icon-sc-wing"></div></div>';
          }
          if (icon === 'carrier') {
            return '<div class="icon-carrier"><div class="icon-carrier-bay"></div><div class="icon-carrier-core"></div><div class="icon-carrier-bay"></div></div>';
          }
          if (icon === 'battleship') {
            return '<div class="icon-battleship"><div class="icon-bs-rect"></div><div class="icon-bs-chevron"></div></div>';
          }
          if (icon === 'destroyer') return '<div class="icon-destroyer"></div>';
          if (icon === 'fighter') return '<div class="icon-fighter"></div>';
          return '<div class="icon-frigate"></div>';
        }
    
        function selectLineSpawnCard(key, btn) {
          LineSpawnState.selectedKey = key;
          LineSpawnState.selectedBtn = btn || null;
          // Podswietlenie karty dotyczy tylko starego panelu HUD. Kokpit (shadow DOM)
          // rysuje wlasny roster i sam sobie zaznacza wybor — stad null-guard.
          if (supportRosterRoot && supportRosterRoot.isConnected) {
            supportRosterRoot.querySelectorAll('.support-card.line-selected').forEach(c => c.classList.remove('line-selected'));
          }
          if (btn) btn.classList.add('line-selected');
        }
    
        // Gdy tryb LINIE jest wlaczony, klikniecie karty statku zamiast spawnowac
        // wybiera typ do przeciagania po mapie. Zwraca true, jesli klik zostal
        // przechwycony (obsluzony) przez tryb LINIE.
        function handleLineModeCardClick(key, btn) {
          if (!LineSpawnState.active) return false;
          if (btn.getAttribute('aria-disabled') === 'true') return true;
          if (!SUPPORT_LINE_TIER_BY_KEY[key]) {
            toast('Ten typ nie wspiera trybu LINIE');
            return true;
          }
          selectLineSpawnCard(key, btn);
          return true;
        }
    
        function bindSupportSpawnButton(btn) {
          if (!btn) return;
          const key = btn.dataset.supportSpawn;
          if (SUPPORT_CLICK_TYPES.has(key)) {
            btn.addEventListener('click', () => {
              if (handleLineModeCardClick(key, btn)) return;
              if (btn.getAttribute('aria-disabled') === 'true') return;
              const mode = getSupportSpawnMode();
              if (key === 'carrier_fighter') {
                const carrier = getFriendlyCarrierEntity();
                if (!carrier) return;
                spawnCallInShip('fighter', { anchor: carrier, mode });
              } else {
                spawnCallInShip(key, { mode });
              }
              // Rozkaz skrzydła zostaje, jaki był (ATAK nie znika po przyzwaniu).
            });
          } else if (isSupportDragKey(key)) {
            btn.addEventListener('mousedown', (event) => {
              if (event.button !== 0) return;
              if (LineSpawnState.active) return;
              if (btn.getAttribute('aria-disabled') === 'true') return;
              beginSupportDrag(key, btn);
            });
            btn.addEventListener('click', (event) => {
              event.preventDefault();
              handleLineModeCardClick(key, btn);
            });
          }
        }
    
        function renderSupportRoster() {
          if (!supportRosterRoot) return;
          const faction = normalizeSupportFaction(SupportWing?.faction || 'terran');
          const roster = SUPPORT_FACTION_ROSTERS[faction] || SUPPORT_FACTION_ROSTERS.terran;
          const frag = document.createDocumentFragment();
          supportRosterRoot.textContent = '';
          carrierSpawnBtn = null;
          let reselectedBtn = null;
          for (const item of roster) {
            const card = document.createElement('div');
            card.className = 'support-card';
            card.dataset.supportSpawn = item.key;
            card.dataset.supportFaction = faction;
            card.innerHTML = `
              <div class="ship-icon-wrap">${supportIconMarkup(item.icon)}</div>
              <div class="support-details"><span class="ship-name">${item.name}</span><span class="ship-role">${item.role}</span></div>
              <div class="support-count">${item.count}</div>
            `;
            if (item.key === 'carrier') carrierSpawnBtn = card;
            bindSupportSpawnButton(card);
            if (LineSpawnState.active && item.key === LineSpawnState.selectedKey) {
              card.classList.add('line-selected');
              reselectedBtn = card;
            }
            frag.appendChild(card);
          }
          supportRosterRoot.appendChild(frag);
          // Wybrany typ moze nie istniec w rosterze nowej frakcji (np. 'battleship'
          // Terra Novy vs 'pirate_battleship' piratow) — wtedy czyscimy wybor.
          if (LineSpawnState.active) {
            if (reselectedBtn) {
              LineSpawnState.selectedBtn = reselectedBtn;
            } else {
              LineSpawnState.selectedKey = null;
              LineSpawnState.selectedBtn = null;
            }
          }
        }
    
        function beginSupportDrag(key, btn) {
          supportDragState.active = true;
          supportDragState.key = key;
          supportDragState.sourceBtn = btn || null;
        }
    
        function endSupportDrag(event) {
          if (!supportDragState.active) return false;
          const key = supportDragState.key;
          supportDragState.active = false;
          supportDragState.key = null;
          supportDragState.sourceBtn = null;
    
          const rect = canvas.getBoundingClientRect();
          const x = event.clientX;
          const y = event.clientY;
          const overCanvas = x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
          if (overCanvas) {
            const world = screenToWorld(x - rect.left, y - rect.top);
            const mode = getSupportSpawnMode();
            // Rozkaz skrzydła zostaje, jaki był — dawniej każde przyzwanie
            // przestawiało CAŁE skrzydło na ESKORTĘ i kasowało kliknięty ATAK.
            spawnCallInShip(key, { spawnPos: world, pos: world, mode });
          }
          mouse.left = false;
          mouse.click = false;
          return true;
        }
    
        function toggleLineSpawnMode(forceOn) {
          const next = (typeof forceOn === 'boolean') ? forceOn : !LineSpawnState.active;
          LineSpawnState.active = next;
          LineSpawnState.dragging = false;
          cancelLineSpawnDrag();
          if (supportLineModeBtn) supportLineModeBtn.classList.toggle('active', next);
          if (!next) {
            LineSpawnState.selectedKey = null;
            LineSpawnState.selectedBtn = null;
            if (supportRosterRoot && supportRosterRoot.isConnected) {
              supportRosterRoot.querySelectorAll('.support-card.line-selected').forEach(c => c.classList.remove('line-selected'));
            }
            return next;
          }
          // Wygodny domyslny wybor, zeby od razu dalo sie ciagnac linie.
          if (!LineSpawnState.selectedKey) {
            const faction = normalizeSupportFaction(SupportWing?.faction || 'terran');
            const roster = SUPPORT_FACTION_ROSTERS[faction] || SUPPORT_FACTION_ROSTERS.terran;
            const firstLineable = roster.find(item => SUPPORT_LINE_TIER_BY_KEY[item.key]);
            if (firstLineable) {
              const card = (supportRosterRoot && supportRosterRoot.isConnected)
                ? supportRosterRoot.querySelector(`.support-card[data-support-spawn="${firstLineable.key}"]`)
                : null;
              selectLineSpawnCard(firstLineable.key, card);
            }
          }
          toast('Tryb LINIE: przeciagnij LPM po mapie (wybierz typ na liscie)');
          return next;
        }
    
        // API dla kokpitu (shadow DOM) — cala mechanika linii zyje tutaj, bo tu jest
        // canvas, kamera i spawner. Kokpit tylko przelacza tryb i wybiera typ.
        window.LineSpawn = {
          toggle: (force) => toggleLineSpawnMode(force),
          isActive: () => LineSpawnState.active,
          setType: (key) => {
            if (key == null) { selectLineSpawnCard(null, null); return true; }
            if (!SUPPORT_LINE_TIER_BY_KEY[key]) return false;
            selectLineSpawnCard(key, null);
            return true;
          },
          getType: () => LineSpawnState.selectedKey,
          supportsType: (key) => !!SUPPORT_LINE_TIER_BY_KEY[key],
          tierMax: (key) => getLineSpawnEffectiveMax(key),
          setWidth: (pct) => setLineSpawnWidth(pct),
          getWidth: () => LineSpawnState.widthPct,
          minWidth: () => LINE_SPAWN_WIDTH_MIN_PCT
        };
    
        function getLineSpawnTierMax(key) {
          const tier = SUPPORT_LINE_TIER_BY_KEY[key];
          return SUPPORT_LINE_TIER_MAX[tier] || 10;
        }
    
        // Ile sztuk zmiesci sie na linii dlugosci calego ekranu przy AKTUALNYM
        // ustawieniu suwaka szerokosci.
        function getLineSpawnEffectiveMax(key) {
          const pct = clamp(Number(LineSpawnState.widthPct) || 100, LINE_SPAWN_WIDTH_MIN_PCT, 100);
          return Math.max(1, Math.round(getLineSpawnTierMax(key) * (100 / pct)));
        }
    
        function setLineSpawnWidth(pct) {
          const next = clamp(Math.round(Number(pct) || 100), LINE_SPAWN_WIDTH_MIN_PCT, 100);
          LineSpawnState.widthPct = next;
          return next;
        }
    
        function computeLineSpawnCount(key, dragLenPx) {
          const screenW = Math.max(1, canvas.clientWidth || canvas.width || window.innerWidth || 1920);
          const maxCount = getLineSpawnEffectiveMax(key);
          const frac = clamp(dragLenPx / screenW, 0, 1);
          return Math.max(1, Math.round(maxCount * frac));
        }
    
        function beginLineSpawnDrag(screenX, screenY) {
          const rect = canvas.getBoundingClientRect();
          const local = { x: screenX - rect.left, y: screenY - rect.top };
          LineSpawnState.dragging = true;
          LineSpawnState.startScreen = local;
          LineSpawnState.curScreen = { ...local };
          LineSpawnState.startWorld = screenToWorld(local.x, local.y);
          LineSpawnState.curWorld = LineSpawnState.startWorld;
        }
    
        function updateLineSpawnDrag(screenX, screenY) {
          if (!LineSpawnState.dragging) return;
          const rect = canvas.getBoundingClientRect();
          const local = { x: screenX - rect.left, y: screenY - rect.top };
          LineSpawnState.curScreen = local;
          LineSpawnState.curWorld = screenToWorld(local.x, local.y);
        }
    
        function cancelLineSpawnDrag() {
          LineSpawnState.dragging = false;
          LineSpawnState.startScreen = null;
          LineSpawnState.curScreen = null;
          LineSpawnState.startWorld = null;
          LineSpawnState.curWorld = null;
        }
    
        function finishLineSpawnDrag(screenX, screenY) {
          const key = LineSpawnState.selectedKey;
          const startScreen = LineSpawnState.startScreen;
          const startWorld = LineSpawnState.startWorld;
          cancelLineSpawnDrag();
          if (!key || !startScreen || !startWorld) return;
    
          const rect = canvas.getBoundingClientRect();
          const endScreen = { x: screenX - rect.left, y: screenY - rect.top };
          const dragLenPx = Math.hypot(endScreen.x - startScreen.x, endScreen.y - startScreen.y);
          if (dragLenPx < LINE_SPAWN_MIN_DRAG_PX) return;
    
          const endWorld = screenToWorld(endScreen.x, endScreen.y);
          const count = computeLineSpawnCount(key, dragLenPx);
          const dx = endWorld.x - startWorld.x;
          const dy = endWorld.y - startWorld.y;
    
          const mode = getSupportSpawnMode();
          for (let i = 0; i < count; i++) {
            const t = count === 1 ? 0.5 : i / (count - 1);
            const pos = { x: startWorld.x + dx * t, y: startWorld.y + dy * t };
            spawnCallInShip(key, { spawnPos: pos, pos, mode, singleModule: true });
          }
          toast(`LINIA: ${count}x ${key}`);
        }
    
        function setupSidePanel(panelEl) {
          if (!panelEl) return null;
          const toggleBtn = panelEl.querySelector('.panel-toggle');
          const bodyEl = panelEl.querySelector('.side-panel-body');
          let collapsed = false;
    
          function applyState() {
            panelEl.classList.toggle('collapsed', collapsed);
            if (bodyEl) bodyEl.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
            panelEl.setAttribute('data-collapsed', collapsed ? 'true' : 'false');
          }
    
          applyState();
    
          if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
              collapsed = !collapsed;
              applyState();
            });
          }
    
          return {
            collapse() { if (!collapsed) { collapsed = true; applyState(); } },
            expand() { if (collapsed) { collapsed = false; applyState(); } },
            isCollapsed: () => collapsed
          };
        }
    
        // Wywołania są tu dla efektu ubocznego — podpinają przycisk zwijania panelu.
        // Zwracanego uchwytu (collapse/expand) nikt nie używa.
        setupSidePanel(supportUIRoot);
        setupSidePanel(shieldControlsRoot);
        // Fleet to rejestr jednostek gracza (ships/templates) — bez własnego UI.
        const Fleet = window.Fleet || (window.Fleet = {
          ships: []
        });
    
        const SupportWing = window.SupportWing || (window.SupportWing = {
          units: [],
          order: 'guard',
          faction: 'terran',
          spawnMode: 'friendly',
          ui: {
            root: supportUIRoot || null,
            guardBtn: supportGuardBtn || null,
            engageBtn: supportEngageBtn || null,
            factionTerranBtn: supportFactionTerranBtn || null,
            factionPirateBtn: supportFactionPirateBtn || null,
            factionIndependentBtn: supportFactionIndependentBtn || null
          }
        });
        SupportWing.faction = normalizeSupportFaction(SupportWing.faction || 'terran');
        SupportWing.spawnMode = normalizeCallInSpawnMode(SupportWing.spawnMode || 'friendly');
        if (!SupportWing.ui.root && supportUIRoot) SupportWing.ui.root = supportUIRoot;
        if (!SupportWing.ui.guardBtn && supportGuardBtn) SupportWing.ui.guardBtn = supportGuardBtn;
        if (!SupportWing.ui.engageBtn && supportEngageBtn) SupportWing.ui.engageBtn = supportEngageBtn;
        if (!SupportWing.ui.factionTerranBtn && supportFactionTerranBtn) SupportWing.ui.factionTerranBtn = supportFactionTerranBtn;
        if (!SupportWing.ui.factionPirateBtn && supportFactionPirateBtn) SupportWing.ui.factionPirateBtn = supportFactionPirateBtn;
        if (!SupportWing.ui.factionIndependentBtn && supportFactionIndependentBtn) SupportWing.ui.factionIndependentBtn = supportFactionIndependentBtn;
    
        const OPTIONS = {
          vfx: { colorTempK: 8000, bloomGain: 1.1, engineGain: 1.0 },
          audio: { master: 0.8, sfx: 1.0, music: 0.7 },
          controls: { mouseSensitivity: 1.0 }, // bez odwracania osi
          planetQuality: 'medium',
          shadowShafts: 'medium'
        };
        window.OPTIONS = OPTIONS;
        const VFX_TUNE_DEFAULTS = {
          mainW: 2.26,
          mainL: 2.37,
          sideW: 1.0,
          sideL: 0.98,
          curve: 1.8
        };
        const VFX_TUNE_STORAGE_KEY = 'engineVfxTune.v1';
        let storedVfxTune = null;
        try {
          const raw = localStorage.getItem(VFX_TUNE_STORAGE_KEY);
          if (raw) storedVfxTune = JSON.parse(raw);
        } catch { }
        window.VFX_TUNE = Object.assign({}, VFX_TUNE_DEFAULTS, storedVfxTune || {}, window.VFX_TUNE || {});
        window.__getEngineVfxTune = () => ({ ...window.VFX_TUNE });
        window.__setEngineVfxTune = (patch = {}, opts = {}) => {
          if (!patch || typeof patch !== 'object') return window.__getEngineVfxTune();
          for (const key of ['mainW', 'mainL', 'sideW', 'sideL', 'curve', 'mainCurve', 'sideCurve']) {
            if (!Object.prototype.hasOwnProperty.call(patch, key)) continue;
            const val = Number(patch[key]);
            if (Number.isFinite(val) && val > 0) window.VFX_TUNE[key] = val;
          }
          const save = opts && opts.save !== false;
          if (save) {
            try { localStorage.setItem(VFX_TUNE_STORAGE_KEY, JSON.stringify(window.VFX_TUNE)); } catch { }
          }
          return window.__getEngineVfxTune();
        };
        window.__resetEngineVfxTune = (opts = {}) => {
          window.VFX_TUNE = { ...VFX_TUNE_DEFAULTS };
          const save = opts && opts.save !== false;
          if (save) {
            try { localStorage.setItem(VFX_TUNE_STORAGE_KEY, JSON.stringify(window.VFX_TUNE)); } catch { }
          }
          return window.__getEngineVfxTune();
        };
        let OPTIONS_OPEN = false;
    
        // --- SYSTEM AUDIO (AudioSys) ---
        const AudioSys = {
          ctx: null,
          masterGain: null,
          sounds: {},
          isInit: false,
    
          // Inicjalizacja kontekstu (musi być po kliknięciu użytkownika)
          init: function () {
            if (this.isInit) return;
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            this.ctx = new AudioContext();
    
            // Główna szyna głośności (Master)
            this.masterGain = this.ctx.createGain();
            // Pobieramy głośność z Twoich OPTIONS (jeśli są dostępne)
            const vol = (typeof OPTIONS !== 'undefined') ? OPTIONS.audio.master : 0.5;
            this.masterGain.gain.value = vol;
            this.masterGain.connect(this.ctx.destination);
    
            this.isInit = true;
            console.log("[AudioSys] Zainicjowano.");
          },
    
          // Ładowanie pojedynczego dźwięku do pamięci
          loadSound: async function (name, url) {
            if (!this.ctx) this.init();
            try {
              const response = await fetch(url);
              const arrayBuffer = await response.arrayBuffer();
              const audioBuffer = await this.ctx.decodeAudioData(arrayBuffer);
              this.sounds[name] = audioBuffer;
              console.log(`[AudioSys] Załadowano '${name}'`);
            } catch (e) {
              console.error(`[AudioSys] Błąd ładowania '${name}' z ${url}:`, e);
            }
          },
    
          // Tworzenie zapętlonego silnika (z kontrolą Pitch i Volume)
          createEngineLoop: function (soundName) {
            if (!this.sounds[soundName]) return null;
    
            const source = this.ctx.createBufferSource();
            source.buffer = this.sounds[soundName];
            source.loop = true;
    
            const gainNode = this.ctx.createGain();
            gainNode.gain.value = 0; // Na start cisza
    
            // Lancuch: Zrodlo -> Gain -> Master -> Wyjscie
            source.connect(gainNode);
            gainNode.connect(this.masterGain);
    
            source.start(0);
    
            return {
              source: source,
              gain: gainNode,
    
              // Funkcja aktualizująca brzmienie w czasie rzeczywistym
              update: (throttle) => {
                const now = AudioSys.ctx.currentTime;
                const targetPitch = 0.5 + (throttle * 0.6);
                source.playbackRate.setTargetAtTime(targetPitch, now, 0.2);
                let baseVol = 0.05 + (throttle * 0.25);
    
                // Pobranie ustawień SFX gracza
                const sfxVol = (typeof OPTIONS !== 'undefined') ? OPTIONS.audio.sfx : 1.0;
    
                // Aplikowanie głośności
                gainNode.gain.setTargetAtTime(baseVol * sfxVol, now, 0.1);
              },
    
              stop: () => {
                try { source.stop(); } catch (e) { }
              }
            };
          },
          // Prosta funkcja do strzałów (na przyszłość)
          playSound: function (name) {
            if (!this.sounds[name]) return;
            const source = this.ctx.createBufferSource();
            source.buffer = this.sounds[name];
            const sfxVol = (typeof OPTIONS !== 'undefined') ? OPTIONS.audio.sfx : 1.0;
    
            const gain = this.ctx.createGain();
            gain.gain.value = sfxVol;
    
            source.connect(gain);
            gain.connect(this.masterGain);
            source.start(0);
          }
        };
