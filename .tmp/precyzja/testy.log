          // Layout z edytora (także 'hpEditor.v1') to pozycje wizualne — bywa ich
          // 3–10× więcej niż spec ramy. Broń dostaje najwyżej SHIPS[rama].spec[typ]
          // gniazd, rozłożonych po kącie wokół kadłuba (src/game/npcWeaponSpec.js).
          // Reszta zostaje PUSTA (hp.mount = null): Turret2D, AI i integralność
          // hardpointów widzą tylko broń, która naprawdę jest.
          const specFrameId = resolveNpcSpecFrameId(npc, SHIPS);
          const armedSlots = selectSpecSlots(npc.editorHardpoints, specFrameId ? SHIPS[specFrameId].spec : null, Object.keys(loadout));
    
          // Przypisz fizyczne bronie do wybranych hardpointów
          for (const hp of npc.editorHardpoints) {
