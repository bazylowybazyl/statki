            // siedzimy w strefie — myśliwce spawnują się DOKŁADNIE na kadłubie
            // Atlasa (promień 300), więc sztywne 0.9*maxSpeed wyrzucało świeżo
            // wypuszczoną eskadrę na pełnym ciągu jak z procy.
            const depth = clamp(1 - (distToLeader / minSafeDist), 0, 1);
