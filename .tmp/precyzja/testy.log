          );
          const shipPx = Number(ship?.pos?.x ?? ship?.x);
          const shipPy = Number(ship?.pos?.y ?? ship?.y);
    
          // Wake sweep: budź sleeping wraki gdy szybki obiekt zbliża się do nich
          for (let si = _sleepingWrecksBuffer.length - 1; si >= 0; si--) {
