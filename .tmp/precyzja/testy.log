        function enforceWreckHexBudget() {
          _wreckBudgetTimer -= PHYS_DT;
          if (_wreckBudgetTimer > 0) return;
          _wreckBudgetTimer = WRECK_BUDGET_CHECK_SEC;
          if (!Array.isArray(wrecks) || wrecks.length === 0) return;
    
          const arenaStats = getHexArenaStats?.();
          const capacity = Math.max(1, Number(arenaStats?.capacity) || DEFAULT_HEX_ARENA_CAPACITY);
    
          let total = 0;
          for (let i = 0; i < wrecks.length; i++) {
            total += Number(wrecks[i]?.hexGrid?.shards?.length) || 0;
          }
          // The old 55% cap ignored living ships. In a huge fleet they could
          // already occupy most of the arena, leaving no room for the next hull.
          // Estimate their packed footprint and keep an explicit spawn reserve.
          const allocated = Math.max(0, Number(arenaStats?.allocated) || 0);
          const packedWrecks = Math.min(total, allocated);
          const livingHexes = Math.max(0, allocated - packedWrecks);
          const reserve = Math.max(WRECK_HEX_RESERVE_MIN, Math.floor(capacity * WRECK_HEX_RESERVE_FRAC));
          const availableAfterLiving = Math.max(0, capacity - livingHexes - reserve);
          const budget = Math.min(Math.floor(capacity * WRECK_HEX_BUDGET_FRAC), availableAfterLiving);
          if (total <= budget) return;
    
          _wreckBudgetScratch.length = 0;
          const px = ship?.pos?.x || 0;
          const py = ship?.pos?.y || 0;
          for (let i = 0; i < wrecks.length; i++) {
            const w = wrecks[i];
            if (!w) continue;
            if (salvageState.towed === w || salvageState.cutting === w) continue;
            if (!cargoBagIsEmpty(w._cargoManifest)) continue;
            const hexes = Number(w.hexGrid?.shards?.length) || 0;
            if (hexes <= 0) continue;
            const dx = w.x - px;
            const dy = w.y - py;
            _wreckBudgetScratch.push({ w, hexes, distSq: dx * dx + dy * dy });
          }
          _wreckBudgetScratch.sort((a, b) => b.distSq - a.distSq);
    
          const doomed = new Set();
          for (let i = 0; i < _wreckBudgetScratch.length && total > budget; i++) {
            const entry = _wreckBudgetScratch[i];
            doomed.add(entry.w);
            total -= entry.hexes;
          }
          if (doomed.size === 0) return;
    
          for (let i = wrecks.length - 1; i >= 0; i--) {
            const w = wrecks[i];
            if (!doomed.has(w)) continue;
            TowSystem.detachBody(w, 'wreck-budget');
            if (DestructorSystem?.recycleWreck) DestructorSystem.recycleWreck(w);
            wrecks.splice(i, 1);
          }
          if (window.DEBUG_WRECK_BUDGET) {
            console.log('[WreckBudget] zwolniono ' + doomed.size + ' wrakow, heksy -> ' + total + '/' + budget);
          }
        }
    
