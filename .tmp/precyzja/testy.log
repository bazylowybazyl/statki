        // strojono separację floty, ale niesie teraz inną rolę — bufor. Otarcie
        // sojuszniczych kadłubów nie jest już amortyzowane przez tarcze, tylko
        // idzie w zgniot; zawężenie odstępu do samych kadłubów zacisnęłoby szyki
        // akurat wtedy, gdy kontakt zaczął kosztować pancerz.
        function shieldPairStandoff(a, b) {
          const read = (e) => {
            if (!e) return 0;
