        function updateSpecialWeaponCooldowns(dt) {
          const specials = getCombinedSpecialLoadouts(Game.player);
          for (let i = 0; i < specials.length; i++) {
            const loadout = specials[i];
            const hp = loadout?.hp;
            if (!hp) continue;
            // Reszta salwy wielolufowej. Domknięcie powstaje TYLKO gdy kolejka
            // coś trzyma — czyli przez ~30 ms po strzale, a nie co klatkę.
            if (hp.salvo && hp.salvo.length) {
              drainSalvoQueue(hp, loadout?.weapon?.id, dt,
                (barrel) => fireSpecialBarrel(loadout, hp, i, barrel, true));
            }
            const current = Number(hp.specialCd) || 0;
            if (current <= 0) continue;
            hp.specialCd = Math.max(0, current - dt);
          }
        }
    
