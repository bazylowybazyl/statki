          let aiSquadsMs = 0;
          let aiSupportWingMs = 0;
          if (runAiLogic) {
            SQUADS.forEach(s => s.update());
            aiSquadsMs = performance.now() - tAiSection0;
            PerfHUD.addTiming('aiSquadsTime', aiSquadsMs);
            if (aiDbgEnabled) AILiveDebug.record('squads', aiSquadsMs);
    
            tAiSection0 = performance.now();
            // Katapultowanie myśliwców z hangarów — kolejka opróżniana PRZED npcStep,
