          missile_rack: 8,
          ciws_mk1: 6,
          flak_capital: 2,
          fighter_squad_multirole: 6,
          hexlance_siege: 1,
          supernova_missile: 4,
          // Zapas na pierwsze eksperymenty z fitem
          armata_mk1: 2,
          laser_pd_mk1: 2
        };
