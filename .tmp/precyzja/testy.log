        // Zbiera wyrzutnie z hardpointów 'hangar' danej jednostki. Każdy hardpoint to
        // jedna wyrzutnia; burta wynika ze znaku lokalnego Y hardpointu.
        function collectHangarTubes(entity, entries) {
          const byHp = new Map();
          for (const entry of entries) {
            const hp = entry?.hp;
            if (!hp || hp.destroyed) continue;
            let tube = byHp.get(hp);
            if (!tube) {
              const local = getEntityHardpointLocalPos(entity, hp);
              if (!local) continue;
              tube = { hp, local, side: local.y >= 0 ? 1 : -1, squadrons: [] };
              byHp.set(hp, tube);
            }
            if (entry.squadron) tube.squadrons.push(entry.squadron);
          }
          const tubes = [];
          for (const tube of byHp.values()) {
            if (tube.squadrons.length) tubes.push(tube);
          }
          return orderHangarTubes(tubes);
        }
    
        function getPlayerHangarTubes() {
          if (!window.ship) return [];
          return collectHangarTubes(ship, Game.player.weapons?.[HP.HANGAR] || []);
        }
    
        // Wspólny wyrzut: pozycja = hardpoint hangaru przesunięty na zewnątrz burty,
        // prędkość = pęd nosiciela + impuls katapulty w bok (plus składowa do przodu).
        function ejectFighterFromTube(carrier, tube, fighter, halfBeam) {
          const frame = {
            x: Number.isFinite(carrier?.pos?.x) ? carrier.pos.x : carrier.x,
            y: Number.isFinite(carrier?.pos?.y) ? carrier.pos.y : carrier.y,
            vx: Number(carrier.vel?.x ?? carrier.vx) || 0,
            vy: Number(carrier.vel?.y ?? carrier.vy) || 0,
            angle: (Number(carrier.angle) || 0)
              + (carrier === ship ? 0 : (Number(carrier.capitalProfile?.spriteRotation) || 0))
          };
          const launch = computeLaunchVector(frame, tube, halfBeam);
    
          fighter.x = launch.x;
          fighter.y = launch.y;
          fighter.vx = launch.vx;
          fighter.vy = launch.vy;
          fighter.angle = launch.angle;
          fighter.desiredAngle = launch.angle;
    
          if (window.spawnParticle) {
            for (let i = 0; i < 6; i++) {
              const spread = (Math.random() - 0.5) * 0.5;
              const px = launch.nx * Math.cos(spread) - launch.ny * Math.sin(spread);
              const py = launch.nx * Math.sin(spread) + launch.ny * Math.cos(spread);
              window.spawnParticle(
                { x: launch.x, y: launch.y },
                { x: frame.vx - px * (180 + Math.random() * 220), y: frame.vy - py * (180 + Math.random() * 220) },
                0.35, '#cfe8ff', 2 + Math.random() * 3, true
              );
            }
          }
        }
    
        function buildSquadronFighter(squadron) {
          const f = makeNPCBase({ x: 0, y: 0 }, {
            hp: squadron.hp,
            accel: squadron.accel,
            maxSpeed: squadron.maxSpeed,
            turn: squadron.turn,
            radius: squadron.radius,
            mass: squadron.mass,
            separationRange: squadron.separationRange
          });
          f.fighter = true;
          f.type = 'fighter';
          f.mission = true;
          f.squadronId = squadron.id;
          f.squadronName = squadron.name;
          f.color = squadron.color || '#7cff91';
          f.gun = squadron.weaponId;
          f.msl = squadron.missileId;
          f.mslAmmo = squadron.missileAmmo;
          f.gunCD = 0.5;
          return f;
        }
    
        function spawnFighterFromTube(req) {
          if (!window.ship || ship.destroyed) return null;
          const { tube, squadron, slotInTube } = req;
          if (tube.hp?.destroyed) return null;
    
          const f = buildSquadronFighter(squadron);
          f.friendly = true;
          f.squadronIndex = req.squadronIndex;
    
          // ship.h ustawia się dopiero po wczytaniu sprite'a kadłuba — gdyby było
          // puste, klin wylądowałby w obrysie statku. Rozrzut hardpointów hangarów
          // jest drugim, niezależnym oszacowaniem połowy szerokości.
          const halfBeam = Math.max(
            (Number(ship.h) || 0) * 0.5,
            Math.abs(tube.local?.y || 0) * 1.35,
            120
          );
          ejectFighterFromTube(ship, tube, f, halfBeam);
    
          if (!window.SQUAD) window.SQUAD = { list: [], order: 'idle', targets: [] };
          f.formIndex = req.globalIndex;
          f.formationOffset = chevronFormationOffset(
            tube.sideRank, tube.side, slotInTube, squadron.squadSize || 1, halfBeam
          );
          f.squad = { leader: ship, type: 'fighter', squadronId: squadron.id };
          f.ai = (dt) => { if (window.runAdvancedFighterAI) window.runAdvancedFighterAI(f, dt); };
    
          window.SQUAD.list.push(f);
          npcs.push(f);
          return f;
        }
    
        // Kolejka startów — opróżniana w update'cie klatki, nie w jednym rzucie.
        function updateFighterLaunchQueue(dt) {
          if (!__fighterLaunchQueue.length) return;
          let ready = 0;
          for (let i = 0; i < __fighterLaunchQueue.length; i++) {
            const req = __fighterLaunchQueue[i];
            req.delay -= dt;
            if (req.delay <= 0) ready++;
          }
          if (!ready) return;
          // Zachowaj kolejność startów: spawnujemy od przodu kolejki.
          const pending = [];
          for (let i = 0; i < __fighterLaunchQueue.length; i++) {
            const req = __fighterLaunchQueue[i];
            if (req.delay <= 0) req.spawn(req);
            else pending.push(req);
          }
          __fighterLaunchQueue.length = 0;
          for (let i = 0; i < pending.length; i++) __fighterLaunchQueue.push(pending[i]);
        }
        window.updateFighterLaunchQueue = updateFighterLaunchQueue;
        window.isFighterLaunchInProgress = () => __fighterLaunchQueue.length > 0;
    
        function launchMountedFighterSquadrons() {
          const tubes = getPlayerHangarTubes();
          if (!tubes.length) {
            if (typeof toast === 'function') toast('Brak modułu hangaru!');
            return [];
          }
          SQUAD.list = [];
          SQUAD.order = 'escort';
          SQUAD.targets = [];
          __fighterLaunchQueue.length = 0;
    
          // Wszystkie wyrzutnie pracują RÓWNOLEGLE (tyle strumieni ile hangarów),
          // każda wypuszcza pojedynczo co FIGHTER_LAUNCH.INTERVAL.
          const plan = buildLaunchPlan(tubes, tube => tube.squadrons);
          for (const req of plan) {
            req.spawn = spawnFighterFromTube;
            __fighterLaunchQueue.push(req);
          }
          return plan;
        }
    
        window.spawnFighter = function (squadronId = 'multirole') {
          const tubes = getPlayerHangarTubes();
          const squadron = getFighterSquadronDef(squadronId);
          const tube = tubes[0] || {
            local: { x: 0, y: (ship?.h || 200) * 0.35 },
            side: 1,
            sideRank: 0,
            hp: null
          };
          return spawnFighterFromTube({
            tube,
            squadron,
            slotInTube: window.SQUAD?.list?.length || 0,
            squadronIndex: 0,
            globalIndex: window.SQUAD?.list?.length || 0
          });
        };
        window.launchMountedFighterSquadrons = launchMountedFighterSquadrons;
        window.getPlayerHangarTubes = getPlayerHangarTubes;
    
    
    
        function lineOffsets(count, spacing) {
          const start = -((count - 1) * spacing) / 2;
          const arr = [];
          for (let i = 0; i < count; i++) arr.push(start + i * spacing);
          return arr;
        }
    
        function buildMercSwarmQueue(station) {
          if (!station) return [];
          const toPlayer = norm({ x: ship.pos.x - station.x, y: ship.pos.y - station.y });
          const right = { x: -toPlayer.y, y: toPlayer.x };
          const baseDist = station.r + 220;
          const rowSpacing = 200;
          const queue = [];
    
          const addRow = (kinds, dist, spacing) => {
            const offsets = lineOffsets(kinds.length, spacing);
            kinds.forEach((kind, idx) => {
              const offset = offsets[idx];
              queue.push({
                kind,
                pos: {
                  x: station.x + toPlayer.x * dist + right.x * offset,
                  y: station.y + toPlayer.y * dist + right.y * offset
                },
                offset,
                right,
                forward: toPlayer
              });
            });
          };
    
          addRow(new Array(8).fill('fighter_squad'), baseDist + rowSpacing * 3, 180);
          addRow(['frigate_pd', 'frigate_laser', 'frigate_pd'], baseDist + rowSpacing * 2, 210);
          return queue;
        }
    
        function resetSwarmQueue() {
          if (!mercMission || !mercMission.swarm) return;
          mercMission.swarm.timer = 0.5;
          const st = mercMission.station;
          const formationQueue = buildMercSwarmQueue(st);
          if (formationQueue.length) {
            mercMission.swarm.queue = formationQueue;
            return;
          }
          // Fallback jeśli nie da się zbudować formacji
          const types = ['fighter_squad', 'interceptor', 'frigate_pd'];
          mercMission.swarm.queue = [];
          for (let i = 0; i < 5; i++) {
            mercMission.swarm.queue.push(types[Math.floor(Math.random() * types.length)]);
          }
        }
        window.resetSwarmQueue = resetSwarmQueue;
    
    
    
        function enterPirateInnerOrbit() {
          if (!mercMission || !mercMission.station) return;
          if (mercMission.alertStage !== 'engage') {
            mercMission.alertStage = 'engage';
          }
          if (!mercMission.aggro) triggerMercAggro('player_inner_orbit');
        }
    
        function triggerMercAggro(reason) {
          if (!mercMission) return;
          const wasAggro = mercMission.aggro;
          mercMission.aggro = true;
          mercMission.aggroReason = mercMission.aggroReason || reason;
          mercMission.alertStage = 'engage';
    
          if (!wasAggro) {
            console.log("PIRATE FLEET WARPING IN!");
            window.hudSystem?.logEvent?.('ALARM MISJI — piracka flota rozpoczęła warp-in.', 'bad');
            spawnPirateHeavyFleet(mercMission.station);
          }
    
    
          for (const npc of npcs) {
            if (npc.mission && npc.isPirate && !npc.dead) {
              if (npc.state === 'warping_in') continue;
              npc.state = 'engage_formation';
              npc.guardStation = null;
              npc.forceTarget = null;
              npc.target = null;
            }
          }
    
          if (mercMission.swarm) {
            mercMission.swarm.active = true;
            if (!mercMission.swarm.queue || !mercMission.swarm.queue.length) resetSwarmQueue();
            if (!mercMission.swarm.timer || mercMission.swarm.timer > 1.2) mercMission.swarm.timer = 1.2;
          }
        }
    
    
        // =============== Rail (Kolejka strzałów gracza) ===============
        const RAIL_SPEED = 2600;
    
        rail = {
          cd: [0, 0],
          cdMax: 0.15,
          shotGap: 0.08,
          burstGap: 0.2,
          burstsPerClick: 1,
          barrelsPerShot: 2,
          queue: [],
          nextStart: 0,
          behaviorId: 'default',
        };
        railTimer = 0;
    
        rebuildHardpointsForFrame();
        loadLoadout();
    
        function triggerRailVolley() {
          const mainWeapons = Game.player.weapons?.[HP.MAIN];
          if (!mainWeapons || !mainWeapons.length) return;
          if (rail.queue.length) return;
          const start = rail.nextStart;
          rail.nextStart ^= 1;
          const barrels = Math.max(1, rail.barrelsPerShot || 2);
          const orderPair = barrels === 1 ? [start] : [start, 1 - start];
          for (let b = 0; b < rail.burstsPerClick; b++) {
            const baseDelay = b * (orderPair.length * rail.shotGap + rail.burstGap);
            for (let idx = 0; idx < orderPair.length; idx++) {
              const barrelBaseTime = baseDelay + idx * rail.shotGap;
              for (let w = 0; w < mainWeapons.length; w++) {
                const jitter = Math.random() * 0.12;
                rail.queue.push({
                  timer: barrelBaseTime + jitter,
                  barrel: orderPair[idx],
                  weaponIndex: w,
                  ignoreCD: true
                });
              }
            }
          }
        }
        function fireRailBarrel(barIndex, specificWeaponIdx = -1) {
          const mainWeapons = Game.player.weapons?.[HP.MAIN] || [];
          if (!mainWeapons.length) return;
    
          if (!p1WeaponCtrl) return;
          let maxCooldown = 0;
    
          for (let i = 0; i < mainWeapons.length; i++) {
            if (specificWeaponIdx !== -1 && i !== specificWeaponIdx) continue;
    
            const weaponData = mainWeapons[i]?.weapon;
            if (!weaponData) continue;
    
            if (!mainWeapons[i].hp) continue;
            const aim = getMountedWeaponAim(ship, mainWeapons[i]);
    
            // Określamy liczbę luf na podstawie rozmiaru nowej broni
            const barrelsPerShot = Number.isFinite(Number(weaponData.barrelsPerShot))
              ? Math.max(1, Math.round(Number(weaponData.barrelsPerShot)))
              : (weaponData.size === 'L' ? 1 : 2);
            const muzzle = p1WeaponCtrl.computeMountedMuzzle(mainWeapons[i], barIndex);
            const baseEmitterUid = `p_main_${i}_${weaponData.id || 'x'}`;
            muzzle.emitterUid = barrelsPerShot > 1 ? `${baseEmitterUid}:b${barIndex}` : baseEmitterUid;
    
            const targetToPass = isTargetAlive(aim.target) ? aim.target : null;
            if (mainAutoFire && lockedTargets.length && !targetToPass) continue;
            const cd = window.fireWeaponCore(ship, targetToPass, weaponData.id, muzzle);
    
            // Efekty wizualne wystrzału (Muzzle flash) z lufy gracza
            // Armata i Tempest Ion mają własny błysk 3D z dema
            // (src/3d/muzzleFx3D.js) — kanwowy rozbłysk pod nim to druga
            // warstwa tego samego efektu w tym samym punkcie.
            if (weaponData.category !== 'beam' && !MuzzleFX3D.handles(weaponData.id)) {
              const isHeavyWeapon = (weaponData.size === 'L' || weaponData.size === 'Capital');
              const muzzleScale = isHeavyWeapon ? 1.8 : 1.0;
              if (weaponData.category === 'torpedo') {
                // Torpedo launch: smoke + directional flame
                CanvasVFX.spawnArmataMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale * 1.5);
              } else if (weaponData.category === 'superweapon' || weaponData.id === 'siege_railgun') {
                // Siege railgun: massive rail flash + screen shake handled elsewhere
                CanvasVFX.spawnRailMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale * 2.0);
              } else if (weaponData.category === 'armata' || weaponData.category === 'plasma') {
                CanvasVFX.spawnArmataMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale);
              } else if (weaponData.category === 'autocannon') {
