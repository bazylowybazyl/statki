          return [alias];
        }
    
        function hasEditorHullConfigContent(cfg) {
          return !!(
            (Array.isArray(cfg?.hardpoints) && cfg.hardpoints.length) ||
            (Array.isArray(cfg?.cores) && cfg.cores.length) ||
            (Array.isArray(cfg?.engines?.main) && cfg.engines.main.length) ||
            (Array.isArray(cfg?.engines?.side) && cfg.engines.side.length) ||
            (Array.isArray(cfg?.lights?.position) && cfg.lights.position.length) ||
            (Array.isArray(cfg?.lights?.road) && cfg.lights.road.length)
          );
        }
    
        function resolvePlayerEditorKey(preferredKey = null) {
          const shipsFromStorage = readShipsEditorConfigFromStorage() || {};
          const shipsFromDefaults = SHIP_EDITOR_DEFAULTS?.ships || {};
          const hasKey = (k) => !!k && (shipsFromStorage[k] || shipsFromDefaults[k]);
    
          const frameKey = String(Game.player?.shipFrame || '').toLowerCase();
          const hullKey = String(ship?.activeHullId || '').toLowerCase();
          const requested = String(preferredKey || '').toLowerCase();
    
          const candidates = [
            requested,
            toEditorHullAlias(requested),
            frameKey,
            toEditorHullAlias(frameKey),
            hullKey,
            toEditorHullAlias(hullKey),
            'atlas'
          ];
    
          for (const candidate of candidates) {
            const keys = getEditorHullConfigKeys(candidate);
            for (const key of keys) {
              if (hasKey(key)) return toEditorHullAlias(candidate) || key;
            }
          }
          return 'atlas';
        }
    
        function getPlayerEditorConfigFromStorage(preferredKey = null) {
          const ships = readShipsEditorConfigFromStorage() || {};
          const defaults = SHIP_EDITOR_DEFAULTS?.ships || {};
          const resolvedKey = resolvePlayerEditorKey(preferredKey);
          const sourceKeys = getEditorHullConfigKeys(resolvedKey);
          let fallback = null;
          for (const key of sourceKeys) {
            if (defaults?.[key] && typeof defaults[key] === 'object') {
              if (!fallback || hasEditorHullConfigContent(defaults[key])) fallback = defaults[key];
              if (hasEditorHullConfigContent(defaults[key])) break;
            }
          }
          const base = (fallback && typeof fallback === 'object') ? fallback : (PLAYER_EDITOR_DEFAULTS || {});
          let cfg = null;
          for (const key of sourceKeys) {
            if (ships?.[key] && typeof ships[key] === 'object') {
              if (!cfg || hasEditorHullConfigContent(ships[key])) cfg = ships[key];
              if (hasEditorHullConfigContent(ships[key])) break;
            }
          }
          if (!cfg || typeof cfg !== 'object') return base;
    
          const merged = {
            ...base,
            ...cfg,
