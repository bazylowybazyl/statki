              // recyklingiem, inaczej trzymałyby referencję do cudzego wraku.
              if (salvageState.towed === w) releaseWreckTow('HOL: WRAK PRZEPADŁ');
              if (salvageState.cutting === w) stopFieldSalvage('SALVAGE: WRAK ROZEBRANY');
              TowSystem.detachBody(w, 'wreck-despawn');
