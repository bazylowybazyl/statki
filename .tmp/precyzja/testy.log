        }
    
        function setSelectionUnits(units, additive = false) {
          if (!additive) Selection.units.clear();
          for (const unit of units || []) {
            if (!unit || unit.dead) continue;
            const selected = unit.towTrain?.head && !unit.towTrain.head.dead ? unit.towTrain.head : unit;
            Selection.units.add(selected);
          }
        }
    
        function pickSelectableAllyAtWorld(worldPoint) {
          if (!worldPoint) return null;
          let best = null;
          let bestDistSq = Infinity;
          for (const unit of selectableAllies()) {
            const pos = selectablePointOf(unit);
            const dx = pos.x - worldPoint.x;
            const dy = pos.y - worldPoint.y;
            const distSq = dx * dx + dy * dy;
            const hitR = selectableRadiusOf(unit) + 20;
            if (distSq <= hitR * hitR && distSq < bestDistSq) {
              bestDistSq = distSq;
              best = unit;
            }
          }
          return best;
        }
    
        function startSelection(worldPoint, screenPoint, additive = false) {
          Selection.active = true;
          Selection.dragging = false;
          Selection.rect = { x0: worldPoint.x, y0: worldPoint.y, x1: worldPoint.x, y1: worldPoint.y };
          Selection.startScreenX = Number(screenPoint?.x) || 0;
          Selection.startScreenY = Number(screenPoint?.y) || 0;
          Selection.additive = !!additive;
        }
    
        function updateSelectionRect(worldPoint, screenPoint) {
          if (!Selection.active || !Selection.rect) return;
          const dx = (Number(screenPoint?.x) || 0) - Selection.startScreenX;
          const dy = (Number(screenPoint?.y) || 0) - Selection.startScreenY;
          if (!Selection.dragging && Math.hypot(dx, dy) >= RTS_SELECTION_DRAG_THRESHOLD) {
            Selection.dragging = true;
