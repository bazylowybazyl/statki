            : 'SHIP ALERT';
          const tone = typeof options?.tone === 'string' && options.tone.trim()
            ? options.tone.trim()
            : 'status';
          zoneState.messages = [{
            id: ++zoneMessageSeq,
            text: text.trim(),
            life: duration,
            maxLife: duration,
            label,
            tone
