        const BASE_FRAME_DT = 1 / 60;
        function npcTurnPhysicsStep(npc, desiredAngle, dt, frameNorm) {
          const maxTurnSpeed = npc?.turn;
          if (!Number.isFinite(maxTurnSpeed) || maxTurnSpeed <= 0) return;
          if (!Number.isFinite(npc.angle)) npc.angle = 0;
          if (!Number.isFinite(npc.angVel)) npc.angVel = 0;
    
          const friction = (typeof npc.angularFriction === 'number') ? clamp(npc.angularFriction, 0, 1) : SHIP_PHYSICS.ANGULAR_FRICTION;
          const angularDamping = Math.pow(friction, frameNorm);
    
          const diff = wrapAngle(desiredAngle - npc.angle);
          const kp = (typeof npc.turnKp === 'number') ? npc.turnKp : 5.5;
          const desiredSpin = clamp(diff * kp, -maxTurnSpeed, maxTurnSpeed);
    
          const turnAccel = (typeof npc.turnAccel === 'number') ? Math.max(0, npc.turnAccel) : (maxTurnSpeed * 4);
          const maxDelta = turnAccel * dt;
          npc.angVel += clamp(desiredSpin - npc.angVel, -maxDelta, maxDelta);
    
          npc.angVel *= angularDamping;
          npc.angVel = clamp(npc.angVel, -maxTurnSpeed, maxTurnSpeed);
          npc.angle = wrapAngle(npc.angle + npc.angVel * dt);
        }
    
        function npcRotationStep(npc, dt, frameNorm) {
          if (!npc) return;
          const keepAngle = !!npc.keepAngle;
          const vx = npc.vx || 0;
          const vy = npc.vy || 0;
          const spdSq = vx * vx + vy * vy;
    
          let desiredAngle = Number.isFinite(npc.desiredAngle) ? npc.desiredAngle : NaN;
          if (!Number.isFinite(desiredAngle) && !keepAngle && spdSq > 25) {
            desiredAngle = Math.atan2(vy, vx);
            npc.desiredAngle = desiredAngle;
          }
    
          if (Number.isFinite(desiredAngle)) {
            npcTurnPhysicsStep(npc, desiredAngle, dt, frameNorm);
