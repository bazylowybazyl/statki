        const rtsState = {
          panPrimed: false,
          panDragging: false,
          panStartX: 0,
          panStartY: 0,
          pendingOrder: null,
          pendingLabel: '',
          commandSuppressedByDrag: false
        };
        window.rtsState = rtsState;
    
        const WORLD_COMMAND_MENU_W = 206;
        const WORLD_COMMAND_MENU_ITEM_H = 30;
        const WORLD_COMMAND_MENU_MARGIN = 10;
        const WORLD_COMMAND_PLACEMENT_DRAG_THRESHOLD = 12;
        const worldCommandMenu = {
          open: false,
          mode: 'normal',
          x: 0,
          y: 0,
          width: WORLD_COMMAND_MENU_W,
          itemHeight: WORLD_COMMAND_MENU_ITEM_H,
          items: [],
          worldPoint: null,
          targetEntity: null,
          submenu: null,
          rightHeld: false,
          pressScreenX: 0,
          pressScreenY: 0,
          pressWorld: null,
          openedAt: 0,
          placement: {
            active: false,
