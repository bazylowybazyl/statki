        publishGameState({ ship });
        ship.mass = SHIP_PHYSICS.PLAYER_MASS;
        ship.rammingMass = SHIP_PHYSICS.PLAYER_MASS;
        ship.inertia = (1 / 12) * ship.mass * ((ship.w * ship.w) + (ship.h * ship.h));
        applyPlayerEditorEngineLayoutFromStorage();
    
        ship.inventory = mergedInventory;
        ship.shipFrame = previousPlayer.shipFrame || 'atlas';
        ship.hardpoints = previousPlayer.hardpoints || [];
        ship.editorCores = buildPlayerDefaultEditorCores();
        ship.editorLights = buildPlayerDefaultEditorLights();
        ship.weapons = previousPlayer.weapons || {};
