            const { timer, duration, fadeIn, fadeOut } = this;
            if (timer < fadeIn) {
              const t = clamp(timer / fadeIn, 0, 1);
              return 1 - Math.pow(1 - t, 3);
            }
            if (timer > duration - fadeOut) {
              const t = clamp((duration - timer) / fadeOut, 0, 1);
              return t * t * t;
            }
