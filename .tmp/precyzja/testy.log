              pushScannerContact(npc, 'ship', 'neutral', dist, contacts);
            }
          }
    
          for (const contact of buildScannerStationDirectoryContacts()) {
            if (!contact?.target || !inRange(contact.target)) continue;
            contacts.push(contact);
          }
    
          if (mercMission && mercMission.weaponPlatforms) {
            for (const platform of mercMission.weaponPlatforms) {
              if (!platform || platform.destroyed || platform.removed || !inRange(platform)) continue;
              const dist = Math.hypot(getTargetX(platform) - ship.pos.x, getTargetY(platform) - ship.pos.y);
              pushScannerContact(platform, 'platform', 'hostile', dist, contacts);
            }
          }
    
          if (includeAsteroids && asteroidRange > 0 && window.asteroidField?.queryRadius) {
            const asteroids = window.asteroidField.queryRadius(ship.pos.x, ship.pos.y, asteroidRange) || [];
            const nearestAsteroids = selectNearestAsteroidTargets(asteroids, {
              centerX: ship.pos.x,
              centerY: ship.pos.y,
              limit: SCANNER_ASTEROID_CONTACT_LIMIT
            });
            for (const entry of nearestAsteroids) {
              pushScannerContact(entry.asteroid, 'asteroid', 'resource', entry.distance, contacts);
            }
          }
    
          return sweepSort ? sortScannerSweepContacts(contacts) : sortScannerContacts(contacts);
        }
    
        function refreshScannerPassiveContacts(force = false) {
          const now = performance.now();
          if (!force && now - scannerPassiveContactsAt < SCANNER_PASSIVE_REFRESH_MS) return;
          const sorted = collectScannerContacts({
            range: getScannerPassiveRange(),
            includeAsteroids: false,
            sweepSort: false
          });
          scannerPassiveContacts.length = 0;
          scannerPassiveContacts.push(...sorted);
          scannerPassiveContactsAt = now;
        }
    
        function invalidateScannerPassiveContacts() {
          scannerPassiveContactsAt = Number.NEGATIVE_INFINITY;
        }
    
        function getScannerOverviewContacts() {
          refreshScannerPassiveContacts(false);
          refreshScannerContactDistances(scannerContacts, ship);
          refreshScannerContactDistances(scannerPassiveContacts, ship);
          const overviewContacts = scannerContacts.slice();
          const seenTargets = new Set();
          for (const contact of overviewContacts) {
            if (contact?.target) seenTargets.add(contact.target);
          }
          for (const contact of scannerPassiveContacts) {
            if (!contact?.target || seenTargets.has(contact.target)) continue;
            overviewContacts.push(contact);
            seenTargets.add(contact.target);
          }
          for (const contact of buildScannerStationDirectoryContacts()) {
            if (!contact?.target || seenTargets.has(contact.target)) continue;
            overviewContacts.push(contact);
            seenTargets.add(contact.target);
          }
