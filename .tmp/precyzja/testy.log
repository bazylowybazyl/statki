          mission.status = 'completed';
          mission.completedAt = gameTime;
          mission.progress = 1;
          if (Array.isArray(mission.objectives)) {
            for (const objective of mission.objectives) objective.done = true;
          }
          const reward = Math.max(0, Math.round(Number(options.rewardCredits ?? mission.rewardCredits) || 0));
          mission.rewardCredits = reward;
          if (!mission.rewardGranted && reward > 0) {
            PLAYER.credits += reward;
            mission.rewardGranted = true;
          }
          missionCompleteBanner.trigger(options.banner || 'MISJA UKOŃCZONA');
          toast(`${mission.title} — ukończono. Nagroda: ${reward.toLocaleString('pl-PL')} CR`);
