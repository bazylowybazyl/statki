              ship.engines.main.gimbalMinDeg = Number.isFinite(Number(firstMain.gimbalMinDeg)) ? Number(firstMain.gimbalMinDeg) : ship.engines.main.gimbalMinDeg;
              ship.engines.main.gimbalMaxDeg = Number.isFinite(Number(firstMain.gimbalMaxDeg)) ? Number(firstMain.gimbalMaxDeg) : ship.engines.main.gimbalMaxDeg;
