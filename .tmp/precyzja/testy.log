          const pooledFriendlies = window.getAIFriendlyCandidates?.();
          const candidates = Array.isArray(pooledFriendlies) ? pooledFriendlies : npcs;
          for (let i = 0; i < candidates.length; i++) {
            const target = candidates[i];
            if (!target || target.dead || target.friendly !== true) continue;
            const score = pirateEngageScore(npc, target);
            if (score > bestScore) {
              bestScore = score;
              best = target;
            }
          }
          return best;
