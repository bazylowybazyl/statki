        let railTimer = 0;
    
        function triggerEnergyShot() {
          if (!ship?.shield) return;
          applyEnergyShot(ship);
          const gained = Math.max(1, (Number(ship.shield.max) || 0) * 0.5);
          if (typeof toast === 'function') toast(`Energy Shot: +${Math.round(gained)} shield`);
        }
        window.triggerEnergyShot = triggerEnergyShot;
    
        function refreshShieldControlButtons() {
          const playerShieldEnabled = !!(ship?.shield) && !(ship?._shieldForcedOff);
          if (shieldToggleBtn) {
            shieldToggleBtn.textContent = `Shield: ${playerShieldEnabled ? 'ON' : 'OFF'}`;
            shieldToggleBtn.classList.toggle('active', playerShieldEnabled);
            shieldToggleBtn.setAttribute('aria-pressed', playerShieldEnabled ? 'true' : 'false');
          }
          if (globalShieldsToggleBtn) {
            const globalEnabled = !(window.DevFlags && window.DevFlags.globalShieldsOff);
            globalShieldsToggleBtn.textContent = `Global Shields: ${globalEnabled ? 'ON' : 'OFF'}`;
            globalShieldsToggleBtn.classList.toggle('active', globalEnabled);
