            requestAnimationFrame(poll);
          })();
        });
    
        // Helper do spawnu eksplozji 3D
        function triggerRailgunExplosion3D(x, y, size = ship.h * 0.22, options = {}) {
          if (overlay3D && window.makeRailgunExplosion) {
            const fx = window.makeRailgunExplosion({ x, y, size, ...options });
            overlay3D.spawn(fx);
          }
        }
    
        function triggerArmataImpact3D(x, y, size = ship.h * 0.3) {
