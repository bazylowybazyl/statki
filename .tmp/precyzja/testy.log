    <!doctype html>
    <html lang="pl">
    
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <title>Super Capital: Battle for Solar System - Aero HUD</title>
      <!-- ZEROWANIE ZAPISU — musi stac PRZED modulami, bo one czytaja localStorage juz przy imporcie.
           Ctrl+F5 czysci tylko cache HTTP, a "usuwanie ciastek" nie rusza localStorage, wiec stary
           uklad hardpointow z edytora (hpEditor.v1) przezywal kazde odswiezenie i wygrywal z nowym
           ukladem z src/data/hardpointEditorDefaults.js. Stad byl potrzebny tryb incognito.
           Uzycie: index.html?reset (wszystko) | ?reset=ship | ?reset=hp | ?reset=loadout | ?reset=dev
           Z konsoli: resetGameSave()  /  resetGameSave('hp') — potem F5. -->
      <script>
        (function () {
          const SAVE_KEYS = {
            // Co wisi na kadlubie: uklad gniazd z edytora + zapisany fit + strojenie dysz.
            ship: ['hpEditor.v1', 'loadout', 'engineVfxTune.v1'],
            // Panele deweloperskie, layouty HUD i ustawienia grafiki.
            dev: [
              'devConfig', 'devFlags', 'devBloomPanel', 'devRingColors',
              'devDestructorConfig', 'devDestructorMassConfig',
              'perfHudCollapsedSections', 'statki.scannerOverview.layout.v1',
              'sc_shadow_shafts', 'sc_planet_quality', 'sc_hull_lacquer'
            ]
          };
          const ALL_KEYS = [...SAVE_KEYS.ship, ...SAVE_KEYS.dev];
    
          function keysForScope(scope) {
            switch (String(scope || 'all').trim().toLowerCase()) {
              case 'hp':
              case 'hardpoints':
              case 'gniazda': return ['hpEditor.v1'];
              case 'loadout':
              case 'fit': return ['loadout'];
              case 'ship':
              case 'statek':
              case 'kadlub': return SAVE_KEYS.ship;
              case 'dev':
              case 'panele': return SAVE_KEYS.dev;
              default: return ALL_KEYS;
            }
          }
    
          function resetGameSave(scope) {
            const wiped = [];
            for (const key of keysForScope(scope)) {
              try {
                if (localStorage.getItem(key) === null) continue;
                localStorage.removeItem(key);
                wiped.push(key);
              } catch { }
            }
            console.info('[reset] wyczyszczone:', wiped.length ? wiped.join(', ') : '(nic nie bylo zapisane)');
            return wiped;
          }
    
          // Wyczyszczenie kluczy + reload to za malo: index.html wiesza
          // `beforeunload -> saveLoadout`, wiec przy przeladowaniu `loadout` wrocilby
          // zapisany ze stanu, ktory wciaz siedzi w pamiedzi. Dlatego przed reloadem
          // zamykamy zapisy na klucz — `saveLoadout()` i devtoolsowe `saveLS()`
          // sprawdzaja `window.__SAVE_LOCKED` i wychodza bez pisania.
          function hardResetGameSave(scope) {
            window.__SAVE_LOCKED = true;
            const wiped = resetGameSave(scope);
            location.reload();
            return wiped;
          }
    
          window.__SAVE_LOCKED = false;
          window.resetGameSave = resetGameSave;
          window.hardResetGameSave = hardResetGameSave;
          window.GAME_SAVE_KEYS = ALL_KEYS;
    
          let params;
          try { params = new URLSearchParams(location.search); } catch { return; }
          if (!params.has('reset')) return;
          resetGameSave(params.get('reset'));
          // Parametr znika z adresu bez przeladowania: kolejne F5 startuje juz z czystego
          // zapisu, zamiast kasowac go w kolko przy kazdym odswiezeniu.
          params.delete('reset');
          const query = params.toString();
          try {
            history.replaceState(null, '', location.pathname + (query ? '?' + query : '') + location.hash);
          } catch { }
        })();
      </script>
    
      <link rel="stylesheet" href="assets/css/main.css">
