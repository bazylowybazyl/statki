          ctx.fillText('pad ' + bp.pad.toFixed(1) + ' j. = maxDeform ' + bp.maxDeform + ' x ' + bp.deformScale + ' + ' + bp.hexSpacing + ' x 4', boxX + 8, vpY + 28);
          ctx.fillStyle = avg > 2.5 ? '#ff8a5c' : '#9ff5b8';
          ctx.fillText('pole pudla / pole kadluba: srednio x' + avg.toFixed(2) + '  (' + shown + ' encji)', boxX + 8, vpY + 42);
          ctx.fillStyle = '#dfe7ff';
          ctx.fillText('komorka hasha ' + bp.cellSize + ' j.   kontakty/klatka ' + bp.contacts, boxX + 8, vpY + 56);
          ctx.fillText('encji w destruktorze ' + bp.entities + '   bez akt. heksow ' + noHexCount, boxX + 8, vpY + 70);
          ctx.restore();
        }
    
        // Przelacznik z konsoli: ColBoundsDbg() wlacza, ColBoundsDbg(false) gasi,
        // ColBoundsDbg(true, true) dokłada siatke hasha broadphase.
        window.ColBoundsDbg = (on = true, grid = false) => {
          DevFlags.showCollisionBounds = !!on;
          DevFlags.showBroadphaseGrid = !!grid;
          return {
            showCollisionBounds: DevFlags.showCollisionBounds,
            showBroadphaseGrid: DevFlags.showBroadphaseGrid
          };
        };
    
        function stationPortWorld(st, idx) {
          const off = st.ports[idx % st.ports.length];
          return { x: st.x + off.x, y: st.y + off.y };
        }
    
    
        function drawPlanetLabels(ctx, cam) {
          ctx.save();
          ctx.textAlign = 'center';
          ctx.textBaseline = 'bottom';
          const _camZoom = cam?.zoom ?? camera.zoom ?? 1;
          const fontSize = Math.round(clamp(18 * _camZoom, 12, 30));
          ctx.font = `600 ${fontSize}px Inter,system-ui,monospace`;
          ctx.lineJoin = 'round';
          for (const pl of planets) {
            if (!pl || !pl.label) continue;
            const screen = worldToScreen(pl.x, pl.y, cam);
            if (screen.x < -160 || screen.x > W + 160 || screen.y < -160 || screen.y > H + 160) continue;
            const planetKey = String(pl.id || pl.name || '').toLowerCase();
            const labelRadius = (planetKey === 'earth' || planetKey === 'mars')
              ? resolveRingPlanetWorldRadius(pl)
              : (pl.r || 0);
            const offset = (labelRadius + 40) * _camZoom;
            const y = screen.y - offset;
            ctx.save();
            ctx.shadowColor = 'rgba(12, 22, 42, 0.7)';
            ctx.shadowBlur = fontSize * 0.4;
            ctx.lineWidth = Math.max(2, fontSize * 0.18);
            ctx.strokeStyle = 'rgba(10, 20, 36, 0.85)';
            ctx.fillStyle = 'rgba(223, 231, 255, 0.95)';
            ctx.strokeText(pl.label, screen.x, y);
            ctx.fillText(pl.label, screen.x, y);
            ctx.restore();
          }
          ctx.restore();
        }
    
    
        function drawRangeRuler(ctx, cam) {
          if (!DevFlags.showRuler) return;
    
          const _vp = getViewportForCamera(cam);
          const cx = _vp.x + _vp.w / 2;
          const cy = _vp.y + _vp.h / 2;
          const zoom = cam?.zoom ?? camera.zoom ?? 1;
    
          ctx.save();
          ctx.globalAlpha = 0.5;
          ctx.lineWidth = 1;
          ctx.strokeStyle = '#6db6ff';
    
          const step = 500;
          const maxWorldR = Math.min(W, H) / zoom * 0.5 * 0.95;
    
          for (let r = step; r < maxWorldR; r += step) {
            const rr = r * zoom;
            ctx.beginPath();
            ctx.arc(cx, cy, rr, 0, Math.PI * 2);
            ctx.stroke();
    
            if (r % 1000 === 0) {
              ctx.fillStyle = '#cfe6ff';
              ctx.font = '11px monospace';
              ctx.textAlign = 'left';
              ctx.textBaseline = 'middle';
              ctx.fillText(`${r}`, cx + rr + 4, cy);
            }
          }
    
          ctx.globalAlpha = 0.25;
          const axisR = maxWorldR * zoom;
          ctx.beginPath(); ctx.moveTo(cx - axisR, cy); ctx.lineTo(cx + axisR, cy); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(cx, cy - axisR); ctx.lineTo(cx, cy + axisR); ctx.stroke();
    
          ctx.restore();
        }
    
        function drawPlanetOrbitRings(ctx, cam) {
          if (!DevFlags.showPlanetOrbits) return;
          const planetList = Array.isArray(window.planets) ? window.planets : [];
          if (!planetList.length) return;
    
          const zoom = cam?.zoom ?? camera.zoom ?? 1;
          ctx.save();
          ctx.lineWidth = Math.max(1, 1.5 * zoom);
    
          for (const planet of planetList) {
            if (!planet || !Number.isFinite(planet.x) || !Number.isFinite(planet.y)) continue;
            const radii = planetOrbitRadii(planet);
            const s = worldToScreen(planet.x, planet.y, cam);
    
            if (Number.isFinite(radii.inner)) {
              ctx.strokeStyle = 'rgba(90, 180, 255, 0.55)';
              ctx.beginPath();
              ctx.arc(s.x, s.y, radii.inner * zoom, 0, Math.PI * 2);
              ctx.stroke();
            }
            if (Number.isFinite(radii.outer)) {
              ctx.strokeStyle = 'rgba(140, 210, 255, 0.45)';
              ctx.beginPath();
              ctx.arc(s.x, s.y, radii.outer * zoom, 0, Math.PI * 2);
              ctx.stroke();
            }
            if (Number.isFinite(radii.gravityWell)) {
              ctx.strokeStyle = 'rgba(170, 150, 255, 0.35)';
              ctx.beginPath();
              ctx.arc(s.x, s.y, radii.gravityWell * zoom, 0, Math.PI * 2);
              ctx.stroke();
            }
          }
    
          ctx.restore();
        }
    
        function drawNpcHardpointOverlay(ctx, npc, screenPos) {
          const hardpoints = Array.isArray(npc?.editorHardpoints) ? npc.editorHardpoints : null;
          if (!hardpoints || hardpoints.length === 0) return;
          const zoom = Math.max(0.0001, Number(_currentCam.zoom) || 1);
          const angle = (npc.angle || 0) + (Number(npc.capitalProfile?.spriteRotation) || 0);
          const c = Math.cos(angle);
          const s = Math.sin(angle);
          const radius = Math.max(0.45, Math.min(4.4, 2.1 * zoom));
          const hpScale = getEntityHardpointScale(npc);
    
          ctx.save();
          ctx.globalCompositeOperation = 'screen';
          for (const hp of hardpoints) {
            if (!hp) continue;
            if (hp.destroyed) continue;
            const localX = Number(hp.x);
            const localY = Number(hp.y);
            if (!Number.isFinite(localX) || !Number.isFinite(localY)) continue;
            const sx = localX * hpScale.x;
            const sy = localY * hpScale.y;
            const x = screenPos.x + (sx * c - sy * s) * zoom;
            const y = screenPos.y + (sx * s + sy * c) * zoom;
            const color = NPC_HARDPOINT_COLORS[hp.type] || '#cfe4ff';
            ctx.fillStyle = color;
            ctx.strokeStyle = 'rgba(255,255,255,0.92)';
            ctx.lineWidth = Math.max(0.45, Math.min(1.1, 0.75 * zoom + 0.15));
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
          }
          ctx.restore();
        }
        function drawNpcStatusBars(ctx, npc, s, size) {
          const hullMax = Math.max(1, Number(npc?.maxHp) || 1);
          const hullVal = Math.max(0, Number(npc?.hp) || 0);
          const hullPct = Math.max(0, Math.min(1, hullVal / hullMax));
    
          const shieldMax = Math.max(0, Number(npc?.shield?.max) || 0);
          const shieldVal = Math.max(0, Number(npc?.shield?.val) || 0);
          const shieldPct = shieldMax > 0 ? Math.max(0, Math.min(1, shieldVal / shieldMax)) : 0;
    
          // Paski tylko przy uszkodzeniu (jak przed lutym, gdy rysował się sam kadłub
          // przy hp < maxHp). Dawny warunek `shieldVal > 0.5 || shieldVal < max - 0.5`
          // był tautologią dla max > 1 — paski wisiały na KAŻDYM NPC z osłoną.
          const showShield = shieldMax > 0 && shieldVal < shieldMax - 0.5;
          const showHull = hullVal < hullMax || showShield;
          if (!showHull && !showShield) return;
    
          const yTop = -size - 11;
          ctx.save();
          ctx.translate(s.x, s.y);
    
          if (showShield) {
            ctx.fillStyle = '#1f3f66';
            ctx.fillRect(-size, yTop, size * 2, 3);
            ctx.fillStyle = '#60a5fa';
            ctx.fillRect(-size, yTop, size * 2 * shieldPct, 3);
          }
    
          if (showHull) {
            const hpY = showShield ? (yTop + 5) : yTop;
            ctx.fillStyle = '#ef4444';
            ctx.fillRect(-size, hpY, size * 2, 3);
            ctx.fillStyle = '#22c55e';
            ctx.fillRect(-size, hpY, size * 2 * hullPct, 3);
          }
    
          ctx.restore();
        }
    
        function drawNPCPretty(ctx, npc, s) {
          const _zoom = _currentCam.zoom;
          const statusSize = (npc.radius || 20) * _zoom;
    
          if (npc.hexGrid) {
            if (DevFlags.showNpcHardpoints) drawNpcHardpointOverlay(ctx, npc, s);
            drawNpcStatusBars(ctx, npc, s, statusSize);
            return;
          }
    
          if (isFighterUnit(npc)) {
            const size = Math.max(4, (npc.radius || 12) * _zoom);
            ctx.save();
            ctx.translate(s.x, s.y);
            ctx.rotate(npc.angle || 0);
            if (!drawFighterSprite(ctx, npc.friendly, size)) {
              ctx.fillStyle   = npc.friendly ? '#5cf' : '#f55';
              ctx.strokeStyle = npc.friendly ? '#aef' : '#faa';
              ctx.lineWidth = Math.max(0.5, _zoom * 0.8);
              // Both sprite and fallback point along +X (the flight/fire heading).
              ctx.beginPath();
              ctx.moveTo( size * 1.2,  0);
              ctx.lineTo(-size * 0.6,  size * 0.7);
              ctx.lineTo(-size * 0.2,  size * 0.2);
              ctx.lineTo(-size * 0.2, -size * 0.2);
              ctx.lineTo(-size * 0.6, -size * 0.7);
              ctx.closePath();
              ctx.fill();
              ctx.stroke();
            }
            ctx.restore();
            drawNpcStatusBars(ctx, npc, s, size);
            return;
          }
    
          if ((npc.type === 'destroyer' || npc.type === 'battleship' || npc.isCapitalShip || npc.isCargoVan || (npc.type && npc.type.includes('frigate'))) && !npc.hexGrid) {
            const sprite = getHullSpriteForNpc(npc) || (npc.capitalSprite && npc.capitalSprite.ready ? npc.capitalSprite : null);
            const nowMs = performance.now();
            if (sprite && sprite.ready && !sprite.error && !(npc.__hexInitRetryAtMs > nowMs) && hexInitBudgetAllows()) {
              _hexInitCountThisFrame++;
              const hexInit = getNpcHexInitSource(npc, sprite);
              npc.__hardpointScaleX = (hexInit?.hardpointScaleX && hexInit.hardpointScaleX > 0) ? hexInit.hardpointScaleX : 1.0;
              npc.__hardpointScaleY = (hexInit?.hardpointScaleY && hexInit.hardpointScaleY > 0) ? hexInit.hardpointScaleY : 1.0;
              npc.__hardpointScale = (hexInit?.hardpointScale && hexInit.hardpointScale > 0) ? hexInit.hardpointScale : 1.0;
              applyEditorLayoutToNpc(npc);
              initHexBody(npc, (hexInit?.image || sprite.image));
              _hexInitSpentMs += performance.now() - nowMs;
              if (npc.hexGrid) {
                npc.hexGrid.visualImage = sprite.image;
                prewarmHexShipVisual(sprite.image);
                attachEntityBridges(npc);
                drawNPCPretty(ctx, npc, s);
                return;
              }
              // initHexBody potrafi wrócić bez siatki (sprite pusty pod progiem alfy,
              // wyjątek getImageData, typ niekwalifikowany). Dawniej rekurencja szła
              // wtedy bez końca: wyjątek przerywał loop() przed requestAnimationFrame
              // i gra stawała. Ponowna próba za 2 s — inicjalizacja to canvas +
              // getImageData całego sprite'a, nie wolno jej powtarzać co klatkę.
              npc.__hexInitRetryAtMs = nowMs + 2000;
            }
          }
    
          drawNpcStatusBars(ctx, npc, s, statusSize);
        }
    
        // ============== SPLIT SCREEN RENDER ==============
        let prevState2 = null;
        function saveState2() {
          if (!player2Ship) return;
          if (!prevState2) prevState2 = { pos: { x: 0, y: 0 }, angle: 0 };
          prevState2.pos.x = player2Ship.pos.x;
          prevState2.pos.y = player2Ship.pos.y;
          prevState2.angle = player2Ship.angle;
        }
        // ============== END SPLIT SCREEN RENDER ==============
    
        function render(alpha, frameDt) {
          const tRenderProfile0 = performance.now();
          let tRenderProfileSection = tRenderProfile0;
          _cursorRequest = '';
          ctx.clearRect(0, 0, W, H);
          const renderDbgEnabled = RenderLiveDebug.enabled;
          const tRenderStart = renderDbgEnabled ? performance.now() : 0;
          let tRenderSection = tRenderStart;
          let tPost3DStart = 0;
          //  cheats (np. nielimitowany warp)
          if (window.ApplyCheats) ApplyCheats();
    
          if (RingCityFlight.isActive()) {
            const flightCamera = RingCityFlight.getCamera();
            if (window.updatePlanets3D) window.updatePlanets3D(frameDt, flightCamera);
            updatePlanetaryRings3D(frameDt, planets, flightCamera);
            // updatePlanetaryRings3D ustawia transform rodzica ringu; dopiero po
            // nim przeliczamy pozycję bolidu i kamery na bieżący world-space.
            RingCityFlight.updateWorld(0);
            if (window.updateStations3D) window.updateStations3D(stations);
            if (updateWorld3D) updateWorld3D(frameDt, vfxTime);
    
            const flightEntities = [];
            if (ship && !ship.dead) flightEntities.push(ship);
            // Model 3D mostka w wolnej kamerze (wysokość widać w perspektywie).
            Bridge3D.update(flightEntities, { nowSec: bridgeSimTime, dt: PAUSED ? 0 : frameDt, zoom: 1, poseOf: bridgeRenderPose, camera: flightCamera });
            if (updateHexShips3D) {
              updateHexShips3D(
                flightCamera,
                flightEntities,
                RingCityFlight.getCullInfo(W, H)
              );
            }
            if (updateShields3D) updateShields3D(frameDt, flightEntities, window.__interpShipPose);
            if (drawHexShips3D) drawHexShips3D(ctx, W, H);
            PerfHUD.addTiming('render3dDrawTime', performance.now() - tRenderProfileSection);
            return;
          }
    
          window.__weaponAimAlpha = alpha;
          // Interpolacja stanu
          const interpPos = {
            x: prevState.pos.x + (ship.pos.x - prevState.pos.x) * alpha,
            y: prevState.pos.y + (ship.pos.y - prevState.pos.y) * alpha
          };
          const interpAngle = interpAngleShort(prevState.angle, ship.angle, alpha);
          const interpTurretAngle = interpAngleShort(prevState.turretAngle, ship.turret.angle, alpha);
          const interpTurretAngle2 = interpAngleShort(prevState.turretAngle2, ship.turret2.angle, alpha);
          const interpTurretAngle3 = interpAngleShort(prevState.turretAngle3, ship.turret3.angle, alpha);
          const interpTurretAngle4 = interpAngleShort(prevState.turretAngle4, ship.turret4.angle, alpha);
          const prevCiwsAngles = Array.isArray(prevState?.ciwsAngles) ? prevState.ciwsAngles : [];
          const interpCIWSAngles = ship.ciws.map((c, i) => {
            const from = Number.isFinite(prevCiwsAngles[i]) ? prevCiwsAngles[i] : c.angle;
            return interpAngleShort(from, c.angle, alpha);
          });
          window.__interpShipPose = { x: interpPos.x, y: interpPos.y, angle: interpAngle };
          window.__interpShipTurretAngles = {
            turret1: interpTurretAngle,
            turret2: interpTurretAngle2,
            turret3: interpTurretAngle3,
            turret4: interpTurretAngle4,
            ciws: interpCIWSAngles
          };
    
          // --- LOGIKA KAMERY (POPRAWIONA) ---
          // Przeniesiona do render(), aby używać interpPos i uniknąć drgań (jitter)
    
          if (camera.mode === 'ship' && !camera.transition) {
            let targetCamX, targetCamY;
            const lookAheadFactor = 2.0;
            const centerX = W * 0.5;
            const centerY = H * 0.5;
            const zoomSafe = Math.max(0.1, camera.zoom || 1);
            // Tryb interfejsu (Alt w kokpicie) = wolna mysz: kamera nie wychyla się za kursorem.
            const freeMouse = splitScreenMode || isHudPointerMode();
            const mouseOffsetX = freeMouse ? 0 : (mouse.x - centerX) * lookAheadFactor / zoomSafe;
            const mouseOffsetY = freeMouse ? 0 : (mouse.y - centerY) * lookAheadFactor / zoomSafe;
    
            // Velocity-based camera lead — zawsze ~15% szerokości ekranu w world units,
            // niezależnie od zooma i prędkości hulla.
            const _cvls = ship.__camVelLead || (ship.__camVelLead = { x: 0, y: 0 });
            const _cvSpd = Math.hypot(ship.vel.x, ship.vel.y);
            // Aktualny v_max tego hulla (z drag physics) — lead normalizowany do niego
            const _cvHullVmax = Math.max(100, Number(driveState?.modeMaxSpeed) || (SHIP_PHYSICS.SPEED / Math.max(1e-6, -Math.log(SHIP_PHYSICS.LINEAR_FRICTION) * 60)));
            // Max lead w game units = 15% szerokości viewportu (stały % ekranu przy każdym zoomie)
            const _cvMaxLead = W * 0.15 / Math.max(0.001, zoomSafe);
            const _cvNorm = Math.min(_cvSpd, _cvHullVmax) / _cvHullVmax;
            // Wolniejszy lerp = mniej agresywna kamera (czas ~0.5s)
            const _cvLerp = 1 - Math.exp(-2 * (frameDt || 0.016));
            if (_cvSpd > 1) {
              _cvls.x += ((ship.vel.x / _cvSpd) * _cvNorm * _cvMaxLead - _cvls.x) * _cvLerp;
              _cvls.y += ((ship.vel.y / _cvSpd) * _cvNorm * _cvMaxLead - _cvls.y) * _cvLerp;
            } else {
              _cvls.x *= (1 - _cvLerp);
              _cvls.y *= (1 - _cvLerp);
            }
    
            targetCamX = interpPos.x + mouseOffsetX + _cvls.x;
            targetCamY = interpPos.y + mouseOffsetY + _cvls.y;
    
            camera.x = targetCamX;
            camera.y = targetCamY;
            camera.targetX = targetCamX;
            camera.targetY = targetCamY;
            if (!camera.manualZoom) camera.targetZoom = camera.defaultZoom;
          } else if (camera.mode === 'focus') {
            const st = camera.focusStation;
            if (st) {
              camera.x = st.x;
              camera.y = st.y;
            } else {
              camera.clearFocus();
            }
          } else if (camera.mode === 'infrastructure') {
            const st = camera.focusStation;
            if (!st) {
              camera.clearFocus();
            }
          }
    
          let camBaseX = camera.x;
          let camBaseY = camera.y;
          let camBaseZoom = camera.zoom;
          if (camera.mode === 'rts' && prevCameraState) {
            camBaseX = lerp(prevCameraState.x, camera.x, alpha);
            camBaseY = lerp(prevCameraState.y, camera.y, alpha);
            camBaseZoom = lerp(prevCameraState.zoom, camera.zoom, alpha);
          }
    
          const camNoShake = { x: camBaseX, y: camBaseY, zoom: camBaseZoom };
          let cam = { x: camBaseX, y: camBaseY, zoom: camBaseZoom };
          if (!DevFlags.disableCameraShake && camera.shakeMag > 0) {
            const t = camera.shakeTime / camera.shakeDur;
            const mag = camera.shakeMag * Math.max(0, t);
            cam.x += (Math.random() * 2 - 1) * mag;
            cam.y += (Math.random() * 2 - 1) * mag;
          }
          // Wstrząs od strzałów (Weapon3DSystem) rusza CAŁĄ klatką, jak camera.addShake.
          // Dawniej dokładał go tylko Core3D.syncCamera: kadłuby i pociski 3D drgały,
          // a wieżyczki, myśliwce i znaczniki z kanwy 2D stały w miejscu — warstwy
          // się rozjeżdżały. Wartość jest z poprzedniej klatki (syncProjectiles liczy
          // ją później), co przy losowym drganiu jest niezauważalne.
          const weaponShake = window.__weapon3dCameraShake;
          if (!DevFlags.disableCameraShake && weaponShake) {
            cam.x += Number(weaponShake.x) || 0;
            cam.y += Number(weaponShake.y) || 0;
          }
    
          window.__splitCamera2 = (splitScreenMode && camera2 && player2Ship && !player2Ship.destroyed)
            ? { x: camera2.x, y: camera2.y, zoom: camera2.zoom }
            : null;
    
          overlayView.center.x = cam.x;
          overlayView.center.y = cam.y;
          overlayView.viewport.w = W;
          overlayView.viewport.h = H;
          overlayView.zoom = cam.zoom;
    
          if (renderDbgEnabled) {
            RenderLiveDebug.record('cameraPrep', tRenderSection > 0 ? (performance.now() - tRenderSection) : 0);
            tRenderSection = performance.now();
          }
          PerfHUD.addTiming('renderPrepTime', performance.now() - tRenderProfileSection);
          tRenderProfileSection = performance.now();
    
          // ==========================================
          // --- UNIFIED 3D UPDATE & RENDER ---
          // ==========================================
    
          // 1. Zaktualizuj wszystkie obiekty 3D na podstawie logiki gry
          let tRender3dSub = performance.now();
          if (renderDbgEnabled) tRenderSection = tRender3dSub;
          if (window.updatePlanets3D) window.updatePlanets3D(frameDt, camNoShake);
          const render3dPlanetsMs = performance.now() - tRender3dSub;
          PerfHUD.addTiming('render3dPlanetsUpdateTime', render3dPlanetsMs);
          if (renderDbgEnabled) RenderLiveDebug.record('updatePlanets3D', render3dPlanetsMs);
    
          tRender3dSub = performance.now();
          if (renderDbgEnabled) tRenderSection = tRender3dSub;
          updatePlanetaryRings3D(frameDt, planets, camNoShake);
          RingCityFlight.updateIdle(frameDt);
          const render3dRingsMs = performance.now() - tRender3dSub;
          PerfHUD.addTiming('render3dRingsUpdateTime', render3dRingsMs);
          if (renderDbgEnabled) RenderLiveDebug.record('updatePlanetaryRings3D', render3dRingsMs);
    
          tRender3dSub = performance.now();
          if (renderDbgEnabled) tRenderSection = tRender3dSub;
          if (window.updateStations3D) window.updateStations3D(stations);
          const render3dStationsMs = performance.now() - tRender3dSub;
          PerfHUD.addTiming('render3dStationsUpdateTime', render3dStationsMs);
          if (renderDbgEnabled) RenderLiveDebug.record('updateStations3D', render3dStationsMs);
    
          tRender3dSub = performance.now();
          if (renderDbgEnabled) tRenderSection = tRender3dSub;
          if (updateWorld3D) updateWorld3D(frameDt, vfxTime);
          const render3dWorldMs = performance.now() - tRender3dSub;
          PerfHUD.addTiming('render3dWorldUpdateTime', render3dWorldMs);
          if (renderDbgEnabled) RenderLiveDebug.record('updateWorld3D', render3dWorldMs);
    
          tRender3dSub = performance.now();
          if (renderDbgEnabled) tRenderSection = tRender3dSub;
          if (window.asteroidField) {
            // Kolizje statków z asteroidami chodzą w physicsStep (stepShipAsteroidCollisions).
            window.asteroidField.update(frameDt);
          }
          // Tło 3D pasów: streaming chunków wokół kamery + immersja (ciemniej w głębi pasa).
          // camNoShake — shake kamery nie powinien triggerować streamingu.
          if (window.beltBackdrop) {
            window.beltBackdrop.update(frameDt, camNoShake, ship && ship.pos ? ship.pos : null, W, H);
          }
          const render3dAsteroidsMs = performance.now() - tRender3dSub;
