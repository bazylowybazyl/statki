        // strzale. Na hp tylko wartości proste: gniazda bywają serializowane.
        function getNpcEmitterUid(owner, hp) {
          const ownerKey = owner?.id ?? owner?.uid ?? owner?._id ?? owner?.npcId ?? 'x';
          if (hp.__emitterUid == null || hp.__emitterUidOwner !== ownerKey || hp.__emitterUidHp !== hp.id) {
            hp.__emitterUid = `npc:${ownerKey}:${hp.id}`;
            hp.__emitterUidOwner = ownerKey;
            hp.__emitterUidHp = hp.id;
