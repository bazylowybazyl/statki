            return spawnCapitalCallIn('carrier', { ...opts, mode });
          }
          if (templateKey === 'supercapital') {
            return spawnCapitalCallIn('supercapital', { ...opts, mode });
          }
          if (templateKey === 'atlas') {
            return spawnCapitalCallIn('atlas', { ...opts, mode });
          }
          if (templateKey === 'megafreighter') {
            return spawnCapitalCallIn('megafreighter', { ...opts, mode });
          }
          return spawnSupportShip(templateKey, { ...opts, mode });
        }
    
        function spawnFriendlyCarrier(opts = {}) {
          return spawnCapitalCallIn('carrier', { ...opts, mode: 'friendly' });
        }
    
        function spawnFriendlySupercapital(opts = {}) {
          return spawnCapitalCallIn('supercapital', { ...opts, mode: 'friendly' });
        }
    
        window.spawnSupportShip = spawnSupportShip;
