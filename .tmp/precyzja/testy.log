          // (PLAYER_KILL_CREDIT_WINDOW) to 0,1 s czasu rzeczywistego — trafienie
          // gracza z ostatniej sekundy liczy się jak zabójcze.
          const hitAt = Number(entity._lastPlayerHit);
          const playerKill = Number.isFinite(hitAt) && gameTime - hitAt >= 0 && gameTime - hitAt <= TIME_SCALE;
          if (playerKill) entity._lastPlayerHit = gameTime;
          registerFactionKill(entity);
