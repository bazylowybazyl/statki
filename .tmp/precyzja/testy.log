          const reactorFactory = createReactorBlowFactory;
          const yamatoFactory = createYamatoImpactFactory;
          const supernovaFactory = createSupernovaMissileBlowFactory;
          const host = document.getElementById('game-root');
    
          // Musimy mieć: API z modułu + host z DOM + overlayView z tego skryptu
          if (!init || !railFactory || !host || typeof overlayView === 'undefined') return false;
    
          // Rakiety dzielą kontekst WebGL z overlayem efektów. Osobny initOverlay
          // tworzył DRUGI WebGLRenderer (własna kanwa, własny stan sterownika) —
          // przy strzelaniu „Overlay FX 3D" skakało z 0.22 do 3.45 ms. Awaryjny
          // powrót do dwóch kontekstów: window.DevFlags.splitOverlayContexts = true
