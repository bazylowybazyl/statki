        function supportGuardBehavior(npc, slotIndex, dt) {
          const slot = supportGuardSlot(slotIndex);
    
          // --- FIX: Detekcja kolizji z Liderem ---
          const leader = (npc.supportData?.leader) || ship;
          const distToLeader = Math.hypot(npc.x - leader.x, npc.y - leader.y);
    
          // Bezpieczna strefa wokół lidera
          const minSafeDist = (leader.radius || 220) + (npc.radius || 30) + 60;
    
          if (distToLeader < minSafeDist) {
            // JESTEŚ ZA BLISKO! Tryb ucieczki
            const pushX = npc.x - leader.x;
            const pushY = npc.y - leader.y;
            const dist = Math.hypot(pushX, pushY) || 1;
            const dir = { x: pushX / dist, y: pushY / dist };
    
            // Okręty z modelem lotu: ten sam pilot co w walce. Bez ogranicznika
            // przeszkód — lider jest ZA nami, a pęd w jego stronę dławiłby ucieczkę.
            if (usesShipFlightModel(npc) && window.capitalArriveTo) {
              const escapeRange = Math.max(minSafeDist, (npc.radius || 30) * 3);
              window.capitalArriveTo(npc, npc.x + dir.x * escapeRange, npc.y + dir.y * escapeRange, {
                dt,
                arrival: Math.max(70, (npc.radius || 30) + 35),
                speedMode: 'combat',
                noObstacleCap: true
              });
              return;
            }
    
            if (npcHasPhysicalThrusters(npc)) {
              const escapeRange = Math.max(minSafeDist, (npc.radius || 30) * 3);
              const flight = executeNpcFlightCommand(npc, {
                type: 'move',
                target: {
                  x: npc.x + dir.x * escapeRange,
                  y: npc.y + dir.y * escapeRange
                },
                arrival: Math.max(70, (npc.radius || 30) + 35)
              }, dt);
              if (flight?.usedThrusters) return;
            }
    
            // Wymuś odlot od lidera. Prędkość proporcjonalna do tego, jak głęboko
            // siedzimy w strefie — myśliwce spawnują się DOKŁADNIE na kadłubie
            // Atlasa (promień 300), więc sztywne 0.9*maxSpeed wyrzucało świeżo
            // wypuszczoną eskadrę na pełnym ciągu jak z procy.
            const depth = clamp(1 - (distToLeader / minSafeDist), 0, 1);
            const wantSpeed = npc.maxSpeed * (0.25 + 0.65 * depth);
            if (npc.fighter && window.steerFighter) {
              window.steerFighter(npc, dir.x * wantSpeed, dir.y * wantSpeed, dt, 360);
            } else {
              const turned = window.clampTurnVec(npc.vx, npc.vy, dir.x * wantSpeed, dir.y * wantSpeed, dt, 360);
              npc.vx = turned.vx;
              npc.vy = turned.vy;
            }
            if (npc.vx * npc.vx + npc.vy * npc.vy > 25) {
              npc.desiredAngle = Math.atan2(npc.vy, npc.vx);
            }
            return; // Przerywamy, nie lecimy do slotu
          }
    
          // Standardowy lot do slotu (jeśli jest bezpiecznie)
