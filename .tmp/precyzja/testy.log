          ctx.lineWidth = 8;
          ctx.beginPath();
          ctx.moveTo(s.x + dx * innerR, s.y + dy * innerR);
          ctx.lineTo(s.x + dx * outerR, s.y + dy * outerR);
          ctx.stroke();
    
          ctx.strokeStyle = color;
          ctx.lineWidth = 2.2;
          ctx.setLineDash([10, 9]);
          ctx.beginPath();
          ctx.moveTo(s.x + dx * innerR, s.y + dy * innerR);
          ctx.lineTo(s.x + dx * outerR, s.y + dy * outerR);
          ctx.stroke();
          ctx.setLineDash([]);
    
