          const { tube, squadron, slotInTube } = req;
          if (tube.hp?.destroyed) return null;
    
          const f = buildSquadronFighter(squadron);
          f.friendly = true;
          f.squadronIndex = req.squadronIndex;
    
          // ship.h ustawia się dopiero po wczytaniu sprite'a kadłuba — gdyby było
          // puste, klin wylądowałby w obrysie statku. Rozrzut hardpointów hangarów
          // jest drugim, niezależnym oszacowaniem połowy szerokości.
          const halfBeam = Math.max(
            (Number(ship.h) || 0) * 0.5,
            Math.abs(tube.local?.y || 0) * 1.35,
            120
          );
          ejectFighterFromTube(ship, tube, f, halfBeam);
    
          if (!window.SQUAD) window.SQUAD = { list: [], order: 'idle', targets: [] };
          f.formIndex = req.globalIndex;
