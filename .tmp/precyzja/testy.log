              }
              survivingShards = npc.hexGrid.shards.filter(s => s.active && !s.isDebris && s.hp > 0);
            }
            const aliveRatio = hexTotal > 0 ? hexAlive / hexTotal : 0;
            const didCritBlow = tryTriggerCriticalReactorBlow(npc, overkillDmg, aliveRatio, survivingShards, _critChainDepth);
    
            if (!didCritBlow) {
              if ((survivingShards.length > 3 || (npc.isCargoVan && survivingShards.length > 0)) && window.createWreckage) {
                window.createWreckage(npc, survivingShards);
