          };
          if (!npc || !hullSprite?.image || !hullSprite.ready) return fallback;
    
          const hullProfileId = getNpcHullRenderProfileId(npc);
          if (!hullProfileId) return fallback;
    
          const srcW = Math.max(1, hullSprite.width || hullSprite.image.naturalWidth || hullSprite.image.width || 1);
          const srcH = Math.max(1, hullSprite.height || hullSprite.image.naturalHeight || hullSprite.image.height || 1);
          const targetSize = getHullRenderSize(hullProfileId, srcW, srcH);
          const targetWidth = Math.max(64, Number(targetSize?.w) || 64);
          const targetHeight = Math.max(64, Number(targetSize?.h) || 64);
          const scaleX = Math.max(0.01, targetWidth / srcW);
          const scaleY = Math.max(0.01, targetHeight / srcH);
          const uniformScale = (scaleX + scaleY) * 0.5;
          const nearlyIdentity = Math.abs(scaleX - 1) < 0.01 && Math.abs(scaleY - 1) < 0.01;
          if (!Number.isFinite(scaleX) || !Number.isFinite(scaleY) || nearlyIdentity) return fallback;
    
          const key = `${hullSprite.image.src || hullProfileId}|${targetWidth}x${targetHeight}`;
