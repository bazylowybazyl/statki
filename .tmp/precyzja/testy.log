            canvas.height = Math.max(2, Math.round(targetHeight));
            const ictx = canvas.getContext('2d', { willReadFrequently: true });
            if (ictx) {
              ictx.imageSmoothingEnabled = true;
              ictx.drawImage(hullSprite.image, 0, 0, canvas.width, canvas.height);
              NPC_HEX_IMAGE_CACHE.set(key, canvas);
            } else {
              canvas = null;
            }
          }
          if (!canvas) return fallback;
          return {
            image: canvas,
            hardpointScaleX: scaleX,
            hardpointScaleY: scaleY,
            hardpointScale: uniformScale
