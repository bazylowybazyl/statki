            if (hasTargets) {
              specialMissileAutoFire = !specialMissileAutoFire;
              pushZoneMessage(specialMissileAutoFire ? 'SPECIAL MISSILE: AUTO-FIRE ON' : 'SPECIAL MISSILE: AUTO-FIRE OFF', 1.5);
            } else {
