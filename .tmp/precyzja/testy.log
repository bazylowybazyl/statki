              ship.engines.main.vfxLengthMin = Number(firstMain.vfxLengthMin) || ship.engines.main.vfxLengthMin || 10;
              ship.engines.main.vfxLengthMax = Number(firstMain.vfxLengthMax) || ship.engines.main.vfxLengthMax || 179;
              ship.engines.main.mount = firstMain.mount || ship.engines.main.mount || null;
              ship.engines.main.baseDeg = Number.isFinite(Number(firstMain.baseDeg)) ? Number(firstMain.baseDeg) : ship.engines.main.baseDeg;
              ship.engines.main.nozzleDeg = Number.isFinite(Number(firstMain.nozzleDeg)) ? Number(firstMain.nozzleDeg) : ship.engines.main.nozzleDeg;
              ship.engines.main.gimbalMinDeg = Number.isFinite(Number(firstMain.gimbalMinDeg)) ? Number(firstMain.gimbalMinDeg) : ship.engines.main.gimbalMinDeg;
              ship.engines.main.gimbalMaxDeg = Number.isFinite(Number(firstMain.gimbalMaxDeg)) ? Number(firstMain.gimbalMaxDeg) : ship.engines.main.gimbalMaxDeg;
            }
