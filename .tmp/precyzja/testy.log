        function hudPingNpcStations() {
          // Niebieskie strzałki do stacji nie-misyjnych; gasną po 4s
          const targets = stations.filter(s => !s.mission).slice(0, 8);
          HUD.navArrows = targets.map(s => ({ x: s.x, y: s.y, age: 0, life: 4.0 }));
        }
        function hudUpdateNav(dt) {
          for (const p of HUD.navArrows) p.age += dt;
          HUD.navArrows = HUD.navArrows.filter(p => p.age < p.life);
        }
    
        function drawArrowOnRing(cx, cy, R, ang, size, color) {
          const x = cx + Math.cos(ang) * R, y = cy + Math.sin(ang) * R;
          ctx.save(); ctx.translate(x, y); ctx.rotate(ang);
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.moveTo(size, 0);
          ctx.lineTo(-size * 0.6, size * 0.6);
          ctx.lineTo(-size * 0.2, 0);
          ctx.lineTo(-size * 0.6, -size * 0.6);
          ctx.closePath(); ctx.fill();
          ctx.restore();
        }
        function hudRenderNav(ship, cam) {
          if (!HUD.navArrows.length) return;
          const s = worldToScreen(ship.pos.x, ship.pos.y, cam);
          const R = Math.max(ship.w, ship.h) * camera.zoom * 0.6 + 30;
          for (const p of HUD.navArrows) {
            const ang = Math.atan2(p.y - ship.pos.y, p.x - ship.pos.x);
            const a = Math.max(0, 1 - p.age / p.life);
            ctx.save(); ctx.globalAlpha = 0.3 + 0.7 * a;
            drawArrowOnRing(s.x, s.y, R, ang, 12, '#60a5fa');
            ctx.restore();
          }
        }
    
        function drawStabilizerHeadingMarker(ship, cam, renderPos = null, renderAngle = null) {
          if (!flightAssist?.stabilizer || !ship || ship.destroyed) return;
          const st = ship.__stabilizerState;
          const targetAngle = Number.isFinite(Number(st?.output?.targetAngle))
            ? Number(st.output.targetAngle)
            : Number(st?.targetAngle);
          if (!Number.isFinite(targetAngle)) return;
    
          const pos = renderPos || ship.pos;
          const s = worldToScreen(pos.x, pos.y, cam);
          const zoom = Math.max(0.0001, Number(cam?.zoom) || Number(camera.zoom) || 1);
          const baseRadius = Math.max(ship.radius || 0, ship.w || 0, ship.h || 0);
          const innerR = Math.max(34, baseRadius * zoom * 0.34);
          const outerR = Math.max(innerR + 34, baseRadius * zoom * 0.62 + 42);
          const dx = Math.cos(targetAngle);
          const dy = Math.sin(targetAngle);
          const currentAngle = Number.isFinite(Number(renderAngle)) ? Number(renderAngle) : (Number(ship.angle) || 0);
          const error = wrapAngle(targetAngle - currentAngle);
          const errorNorm = clamp(Math.abs(error) / (Math.PI / 3), 0, 1);
          const color = errorNorm > 0.32 ? 'rgba(255,216,116,0.96)' : 'rgba(96,232,255,0.96)';
          const softColor = errorNorm > 0.32 ? 'rgba(255,180,82,0.26)' : 'rgba(85,210,255,0.24)';
    
          ctx.save();
