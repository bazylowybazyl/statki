        function updateEntityHardpointIntegrity(entity, dt) {
          if (!entity || entity.dead || !entity.hexGrid) return false;
          const hardpoints = getEntityHardpoints(entity);
          if (!hardpoints || hardpoints.length === 0) return false;
    
          entity.__hardpointProbeTimer = (Number(entity.__hardpointProbeTimer) || 0) - dt;
          if (entity.__hardpointProbeTimer > 0) return false;
          entity.__hardpointProbeTimer = HARDPOINT_INTEGRITY_CONFIG.probeEverySec;
    
          let changed = false;
