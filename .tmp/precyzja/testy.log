          }
          // Weapon keys (1=main, 2=special, 3=missiles, 4=built-in) — toggle auto-fire or single shot
          if (e.code === 'Digit1' && !stationUI.open && !CICDisplay.active && !e.repeat) {
            if (!warp.isBusy()) {
              const hasTargets = lockedTargets && lockedTargets.length > 0;
              if (hasTargets) {
