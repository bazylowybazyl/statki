                centerY += getTargetY(candidates[i]);
                averageVx += Number(candidates[i]?.vx ?? candidates[i]?.vel?.x) || 0;
                averageVy += Number(candidates[i]?.vy ?? candidates[i]?.vel?.y) || 0;
              }
              centerX /= candidates.length;
              centerY /= candidates.length;
              averageVx /= candidates.length;
              averageVy /= candidates.length;
              const desiredAngle = perpendicularTargetingAngle(
                averageVx,
                averageVy,
                ship.pos.x - centerX,
                ship.pos.y - centerY
              );
              targetingMode.groupAngle = lerpTargetingAxisAngle(
                targetingMode.groupAngle,
                desiredAngle,
                1 - Math.exp(-step * 1.7)
              );
    
              const centerScreen = worldToScreen(centerX, centerY, camRef);
              const ca = Math.cos(targetingMode.groupAngle);
              const sa = Math.sin(targetingMode.groupAngle);
              let minX = Infinity;
              let minY = Infinity;
              let maxX = -Infinity;
              let maxY = -Infinity;
              for (let i = 0; i < candidates.length; i++) {
                const target = candidates[i];
                const screen = worldToScreen(getTargetX(target), getTargetY(target), camRef);
                const dx = screen.x - centerScreen.x;
                const dy = screen.y - centerScreen.y;
                const localX = dx * ca + dy * sa;
                const localY = -dx * sa + dy * ca;
                const radius = _targetingScreenRadius(target, camRef.zoom);
                minX = Math.min(minX, localX - radius);
                maxX = Math.max(maxX, localX + radius);
                minY = Math.min(minY, localY - radius);
                maxY = Math.max(maxY, localY + radius);
              }
              const offsetX = (minX + maxX) * 0.5;
              const offsetY = (minY + maxY) * 0.5;
              targetX = centerScreen.x + offsetX * ca - offsetY * sa;
              targetY = centerScreen.y + offsetX * sa + offsetY * ca;
              targetW = maxX - minX + TARGETING_GROUP_PAD_PX * visualScale * 2;
              targetH = maxY - minY + TARGETING_GROUP_PAD_PX * visualScale * 2;
            } else {
              targetingMode.groupAngle = lerpTargetingAxisAngle(
                targetingMode.groupAngle,
                0,
                1 - Math.exp(-step * 1.4)
              );
            }
    
            const positionK = 1 - Math.exp(-step * 12);
            const expanding = targetW > targetingMode.groupW + 1 || targetH > targetingMode.groupH + 1;
            const sizeK = 1 - Math.exp(-step * (expanding ? 10 : 4));
            targetingMode.groupX += (targetX - targetingMode.groupX) * positionK;
            targetingMode.groupY += (targetY - targetingMode.groupY) * positionK;
            targetingMode.groupW += (targetW - targetingMode.groupW) * sizeK;
            targetingMode.groupH += (targetH - targetingMode.groupH) * sizeK;
          }
    
          function _drawSubScanOverlay(entity, camRef) {
            const center = worldToScreen(getTargetX(entity), getTargetY(entity), camRef);
            const visualScale = targetingVisualScale(camRef.zoom);
            const radius = Math.max(18 * visualScale, getTargetRadius(entity) * camRef.zoom) / visualScale;
            const lengthScale = Math.max(1, Number(entity?.capitalProfile?.lengthScale) || 1);
            const widthScale = Math.max(0.7, Number(entity?.capitalProfile?.widthScale) || 1);
            const halfLength = clamp(radius * lengthScale, 30, 300);
            const halfHeight = clamp(radius * widthScale * 0.72 + 10, 22, 150);
            const rear = -halfLength - 16;
            const nose = halfLength + 16;
            const done = targetingMode.scannedTargets.has(entity);
            const progress = done ? 1 : targetingMode.subScanProgress;
            const color = done ? '#52ff9a' : '#34e7ff';
            const angle = (Number(entity?.angle) || 0) + (Number(entity?.capitalProfile?.spriteRotation) || 0);
    
            ctx.save();
            ctx.translate(center.x, center.y);
            ctx.rotate(angle);
            ctx.scale(visualScale, visualScale);
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = done ? 8 : 12;
            ctx.lineWidth = 1.5;
            ctx.setLineDash([2, 9]);
            // Czas rzeczywisty: gameTime chodzi z TIME_SCALE = 60.
            ctx.lineDashOffset = -uiAnimTime() * 20;
            ctx.beginPath();
            ctx.moveTo(rear, -halfHeight);
            ctx.lineTo(rear, halfHeight);
            ctx.moveTo(nose, -halfHeight);
            ctx.lineTo(nose, halfHeight);
            ctx.stroke();
            ctx.setLineDash([]);
    
            if (!done) {
              const scanX = rear + (nose - rear) * progress;
              const gradient = ctx.createLinearGradient(scanX - 34, 0, scanX + 8, 0);
              gradient.addColorStop(0, 'rgba(52,231,255,0)');
              gradient.addColorStop(0.72, 'rgba(52,231,255,0.12)');
              gradient.addColorStop(1, 'rgba(180,250,255,0.52)');
              ctx.fillStyle = gradient;
              ctx.fillRect(scanX - 34, -halfHeight, 42, halfHeight * 2);
              ctx.beginPath();
              ctx.moveTo(scanX, -halfHeight);
              ctx.lineTo(scanX, halfHeight);
              targetingStrokeGlass(ctx, '#34e7ff', 2.2);
              ctx.globalAlpha = 0.18;
              ctx.fillStyle = '#34e7ff';
              ctx.fillRect(rear, -halfHeight, scanX - rear, halfHeight * 2);
            } else {
              ctx.globalAlpha = 0.18 + 0.12 * Math.sin(uiAnimTime() * 4);
              ctx.strokeStyle = color;
              ctx.strokeRect(rear, -halfHeight, nose - rear, halfHeight * 2);
            }
            ctx.restore();
    
            const hardpoints = getEntityHardpoints(entity) || [];
            const text = done
              ? `SUB • SKAN ZAKOŃCZONY • ${hardpoints.filter(hp => hp && !hp.destroyed).length} HARDPOINTÓW`
              : `SUB • SKANOWANIE ${Math.round(progress * 100)}%`;
            _targetingLabel(text, center.x, center.y - (halfHeight + 18) * visualScale, color, 'center', visualScale);
          }
    
          function _drawReticle(mouseRef, camRef, shipRef, clipX, clipW) {
            if (!shipRef || shipRef.destroyed) return;
            const mouseWorld = screenToWorld(mouseRef.x, mouseRef.y, camRef);
            const cursor = worldToScreen(mouseWorld.x, mouseWorld.y, camRef);
            const color = TARGETING_MODE_COLORS[targetingMode.current];
            const visualScale = targetingVisualScale(camRef.zoom);
            const isPrimary = shipRef === ship && mouseRef === mouse;
            if (isPrimary) _updateTargetingState(mouseRef, camRef, mouseWorld, frameDt);
    
            _drawTargetingRange(shipRef, camRef, clipX, clipW, color);
            ctx.save();
            ctx.beginPath();
            ctx.rect(clipX, 0, clipW, H);
            ctx.clip();
    
            if (!isPrimary) {
              drawSingleTargetingReticle(ctx, cursor.x, cursor.y, 13 * visualScale, 0, color, '#dfffff', visualScale);
            } else if (targetingMode.current === TARGETING_MODE.SINGLE) {
              for (let i = 0; i < lockedTargets.length; i++) {
                const target = lockedTargets[i];
                if (!isTargetAlive(target) || target.__targetingSubsystem) continue;
                const screen = worldToScreen(getTargetX(target), getTargetY(target), camRef);
                const lockedRadius = _targetingScreenRadius(target, camRef.zoom);
                drawSingleTargetingReticle(ctx, screen.x, screen.y, lockedRadius, 1, '#ff4d5e', '#ff8a94', visualScale);
                drawTargetingLockRing(ctx, screen.x, screen.y, lockedRadius + 18 * visualScale, '#ff4d5e', visualScale);
              }
              const hovered = targetingMode.acquireTarget;
              if (hovered && !lockedTargets.includes(hovered)) {
                const screen = worldToScreen(getTargetX(hovered), getTargetY(hovered), camRef);
                const radius = _targetingScreenRadius(hovered, camRef.zoom);
                const ready = drawSingleTargetingReticle(ctx, screen.x, screen.y, radius, targetingMode.acquireProgress, '#ffb648', '#ffd27a', visualScale);
                drawTargetingSnapEcho(ctx, screen.x, screen.y, radius + 14 * visualScale, targetingMode.acquireReadyFx, '#ffd27a', visualScale);
                _targetingLabel(
                  ready ? '◂ SINGLE • LPM: LOCK ▸' : `SINGLE • NAMIAR ${Math.round(targetingMode.acquireProgress * 100)}%`,
                  screen.x,
                  screen.y + radius + 28 * visualScale,
                  ready ? '#ffd27a' : '#ffb648',
                  'center',
                  visualScale
                );
              } else if (!hovered) {
                const blocked = targetingMode.hoverBlocked;
                if (blocked && isTargetAlive(blocked)) {
                  const screen = worldToScreen(getTargetX(blocked), getTargetY(blocked), camRef);
                  const radius = _targetingScreenRadius(blocked, camRef.zoom);
                  ctx.save();
                  ctx.globalAlpha = 0.45;
                  drawSingleTargetingReticle(ctx, screen.x, screen.y, radius, 0, '#6f8b99', '#6f8b99', visualScale);
                  ctx.restore();
                  _targetingLabel(
                    _targetingBlockedReason(blocked),
                    screen.x,
                    screen.y + radius + 28 * visualScale,
                    '#8fb0bf',
                    'center',
                    visualScale
                  );
                }
                drawSingleTargetingReticle(ctx, cursor.x, cursor.y, 13 * visualScale, 0, '#ffb648', '#ffd27a', visualScale);
              }
            } else if (targetingMode.current === TARGETING_MODE.MULTI) {
              // Cel ZATWIERDZONY musi byc czerwony takze wtedy, gdy nadal siedzi w
              // ramce. Wczesniej petla kandydatow malowala go na bursztynowo, a
              // petla lockow go pomijala — po LPM nie zmienialo sie NIC na ekranie.
              let readyCount = 0;
              let pendingCount = 0;
              for (let i = 0; i < targetingMode.groupCandidates.length; i++) {
                const target = targetingMode.groupCandidates[i];
                const screen = worldToScreen(getTargetX(target), getTargetY(target), camRef);
                const nodeRadius = _targetingScreenRadius(target, camRef.zoom);
                if (lockedTargets.includes(target)) {
                  drawMultiTargetingNode(ctx, screen.x, screen.y, nodeRadius, 1, '#ff4d5e', '#ff8a94', visualScale);
                  drawTargetingLockRing(ctx, screen.x, screen.y, nodeRadius + 12 * visualScale, '#ff4d5e', visualScale);
                  continue;
                }
                pendingCount++;
                const progress = targetingMode.groupAcquisition.get(target) || 0;
                if (drawMultiTargetingNode(ctx, screen.x, screen.y, nodeRadius, progress, '#ffb648', '#ffd27a', visualScale)) readyCount++;
                drawTargetingSnapEcho(ctx, screen.x, screen.y, nodeRadius + 10 * visualScale, targetingMode.groupReadyFx.get(target) || 0, '#ffd27a', visualScale);
              }
              for (let i = 0; i < lockedTargets.length; i++) {
                const target = lockedTargets[i];
                if (!isTargetAlive(target) || target.__targetingSubsystem || targetingMode.groupCandidates.includes(target)) continue;
                const screen = worldToScreen(getTargetX(target), getTargetY(target), camRef);
                const lockedRadius = _targetingScreenRadius(target, camRef.zoom);
                drawMultiTargetingNode(ctx, screen.x, screen.y, lockedRadius, 1, '#ff4d5e', '#ff8a94', visualScale);
                drawTargetingLockRing(ctx, screen.x, screen.y, lockedRadius + 12 * visualScale, '#ff4d5e', visualScale);
              }
              const allLocked = pendingCount === 0 && targetingMode.groupCandidates.length > 0;
              const frameColor = allLocked
                ? '#ff4d5e'
                : (pendingCount > 0 && readyCount === pendingCount ? '#ffd27a' : '#34e7ff');
              drawMultiTargetingFrame(
                ctx,
                targetingMode.groupX,
                targetingMode.groupY,
                targetingMode.groupW,
                targetingMode.groupH,
                targetingMode.groupAngle,
                frameColor,
                allLocked ? 0.55 : 0.95,
                visualScale
              );
              if (targetingMode.groupCandidates.length > 0) {
                const labelOffset = targetingMode.groupH * 0.5 + 18 * visualScale;
                let label;
                if (allLocked) label = `MULTI • ${lockedTargets.length} × LOCK`;
                else if (readyCount === pendingCount) label = `◂ MULTI • ${readyCount} GOTOWYCH • LPM: LOCK ▸`;
                else label = `MULTI • NAMIAR ${readyCount}/${pendingCount}`;
                _targetingLabel(
                  label,
                  targetingMode.groupX + Math.sin(targetingMode.groupAngle) * labelOffset,
                  targetingMode.groupY - Math.cos(targetingMode.groupAngle) * labelOffset,
                  frameColor,
                  'center',
                  visualScale
                );
              }
            } else if (targetingMode.current === TARGETING_MODE.SELECT) {
              drawSelectTargetingReticle(ctx, cursor.x, cursor.y, 13 * visualScale, 0, visualScale);
            } else {
              const entity = targetingMode.subScanTarget;
              if (entity && isTargetAlive(entity)) {
                _drawSubScanOverlay(entity, camRef);
                if (targetingMode.scannedTargets.has(entity)) {
                  const hardpoints = getEntityHardpoints(entity) || [];
                  for (let i = 0; i < hardpoints.length; i++) {
                    const hp = hardpoints[i];
                    if (!hp || hp.destroyed) continue;
                    const target = getTargetingSubsystemTarget(entity, hp);
                    const point = getEntityHardpointWorldPos(entity, hp);
                    if (!point) continue;
                    const screen = worldToScreen(point.x, point.y, camRef);
                    const selected = lockedTargets.includes(target);
                    const hovered = targetingMode.hoveredSubsystem === target;
                    drawSubTargetingReticle(
                      ctx,
                      screen.x,
                      screen.y,
                      (hovered ? 14 : 10) * visualScale,
                      hovered || selected ? 1 : 0.72,
                      selected ? '#ff4d5e' : '#ffb648',
                      selected ? '#ff8a94' : '#ffd27a',
                      visualScale
                    );
                    if (hovered) {
                      _targetingLabel(
                        `${target.label} • LPM: ${selected ? 'ODZNACZ' : 'NAMIERZ'}`,
                        screen.x + 22 * visualScale,
                        screen.y - 18 * visualScale,
                        selected ? '#ff8a94' : '#ffd27a',
                        'left',
                        visualScale
                      );
                    }
                  }
                  // Mostki: większy marker w środku strefy + integralność.
                  const bridges = listTargetableBridges(entity);
                  if (bridges) {
                    for (let i = 0; i < bridges.length; i++) {
                      const bridge = bridges[i];
                      if (bridge.dead) continue;
                      const target = getTargetingBridgeTarget(entity, bridge);
                      const point = getBridgeMarkerWorld(entity, bridge);
                      const screen = worldToScreen(point.x, point.y, camRef);
                      const selected = lockedTargets.includes(target);
                      const hovered = targetingMode.hoveredSubsystem === target;
                      drawSubTargetingReticle(
                        ctx,
                        screen.x,
                        screen.y,
                        (hovered ? 20 : 15) * visualScale,
                        hovered || selected ? 1 : 0.8,
                        selected ? '#ff4d5e' : '#7fd8ff',
                        selected ? '#ff8a94' : '#c8f0ff',
                        visualScale
                      );
                      if (hovered) {
                        _targetingLabel(
                          `${target.label} ${Math.round(bridge.integrity * 100)}% • LPM: ${selected ? 'ODZNACZ' : 'NAMIERZ'}`,
                          screen.x + 26 * visualScale,
                          screen.y - 22 * visualScale,
                          selected ? '#ff8a94' : '#c8f0ff',
                          'left',
                          visualScale
                        );
                      }
                    }
                  }
                }
              } else {
                drawSubTargetingReticle(ctx, cursor.x, cursor.y, 13 * visualScale, 0, '#34e7ff', '#52ff9a', visualScale);
              }
              for (let i = 0; i < lockedTargets.length; i++) {
                const target = lockedTargets[i];
                if (!target?.__targetingSubsystem || !isTargetAlive(target)) continue;
                const screen = worldToScreen(getTargetX(target), getTargetY(target), camRef);
                drawSubTargetingReticle(ctx, screen.x, screen.y, 13 * visualScale, 1, '#ff4d5e', '#ff8a94', visualScale);
              }
            }
    
            ctx.restore();
            ctx.save();
            ctx.fillStyle = color;
            ctx.globalAlpha = 0.82;
            ctx.font = '11px monospace';
            ctx.textAlign = 'left';
            ctx.fillText(`${TARGETING_MODE_ICONS[targetingMode.current]} ${TARGETING_MODE_NAMES[targetingMode.current]} • BROŃ 100%`, clipX + 10, H - 10);
            ctx.restore();
          }
    
          // Kursor systemowy chowamy dokladnie tam, gdzie rysujemy wlasny celownik.
          // Panel stacji, CIC, RTS, kolo trybow i menu maja dostac strzalke z powrotem.
          // Tryb interfejsu (Alt) też oddaje strzałkę. Zapis do style — na końcu render().
          _osCursorHidden = gameStarted
            && !stationUI.open
            && !targetingMode.wheelOpen
            && !CICDisplay.active
            && !isRtsModeActive()
            && !isHudPointerMode()
            && mouse.overCanvas;
    
          if (gameStarted && !stationUI.open && !targetingMode.wheelOpen) {
            if (splitScreenMode && camera2 && player2Ship) {
              const halfW = Math.floor(W / 2);
              // P1 crosshair (left half)
              const p1Cam = { x: cam.x, y: cam.y, zoom: cam.zoom, viewportX: 0, viewportY: 0, viewportW: halfW, viewportH: H };
              _wtsVpW = halfW; _wtsVpH = H; _wtsVpOffX = 0; _wtsVpOffY = 0;
              _drawWeaponAimLines(p1Cam);
              _drawReticle(mouse, p1Cam, ship, 0, halfW);
              // P2 crosshair (right half)
              const p2Cam = { x: camera2.x, y: camera2.y, zoom: camera2.zoom, viewportX: halfW, viewportY: 0, viewportW: W - halfW, viewportH: H };
              _wtsVpW = W - halfW; _wtsVpH = H; _wtsVpOffX = halfW; _wtsVpOffY = 0;
              _drawReticle(mouse2, p2Cam, player2Ship, halfW, W - halfW);
              // Reset viewport params
              _wtsVpW = 0; _wtsVpH = 0; _wtsVpOffX = 0; _wtsVpOffY = 0;
            } else {
              _drawWeaponAimLines(cam);
              _drawReticle(mouse, cam, ship, 0, W);
            }
          }
    
          // --- Koło wyboru celownika: SINGLE / MULTI / SUB ---
          if (targetingMode.wheelOpen && targetingMode.wheelMouseStart) {
            const cx = targetingMode.wheelMouseStart.x;
            const cy = targetingMode.wheelMouseStart.y;
            const wheelR = 90;
            const sectorAngles = [
              { start: -30, end: 90 },    // SINGLE (góra-prawo)
              { start: 90, end: 210 },    // MULTI (prawo-dół)
              { start: 210, end: 330 },   // SUB (lewo)
            ];
    
            ctx.save();
            // Tło koła
            ctx.fillStyle = 'rgba(10, 15, 30, 0.85)';
            ctx.beginPath();
            ctx.arc(cx, cy, wheelR + 10, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = 'rgba(100, 150, 220, 0.4)';
            ctx.lineWidth = 2;
            ctx.stroke();
    
            // Rysuj sektory
            for (let i = 0; i < 3; i++) {
              const s = sectorAngles[i];
              const a1 = (s.start - 90) * Math.PI / 180;
              const a2 = (s.end - 90) * Math.PI / 180;
              const isHover = targetingMode.wheelHover === i;
              const isCurrent = targetingMode.current === i;
    
              ctx.beginPath();
              ctx.moveTo(cx, cy);
              ctx.arc(cx, cy, wheelR, a1, a2);
              ctx.closePath();
              ctx.fillStyle = isHover
                ? `${TARGETING_MODE_COLORS[i]}44`
                : (isCurrent ? 'rgba(40, 60, 100, 0.6)' : 'rgba(20, 30, 50, 0.4)');
              ctx.fill();
              ctx.strokeStyle = isHover ? TARGETING_MODE_COLORS[i] : 'rgba(80, 120, 180, 0.3)';
              ctx.lineWidth = isHover ? 2 : 1;
              ctx.stroke();
    
              // Ikona + nazwa
              const midAngle = ((s.start + s.end) / 2 - 90) * Math.PI / 180;
              const labelR = wheelR * 0.6;
              const lx = cx + Math.cos(midAngle) * labelR;
              const ly = cy + Math.sin(midAngle) * labelR;
    
              ctx.fillStyle = isHover ? '#fff' : (isCurrent ? TARGETING_MODE_COLORS[i] : '#8899bb');
              ctx.font = `bold ${isHover ? 16 : 13}px monospace`;
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText(TARGETING_MODE_ICONS[i], lx, ly - 8);
              ctx.font = `${isHover ? 11 : 9}px monospace`;
              ctx.fillText(TARGETING_MODE_NAMES[i], lx, ly + 8);
    
              ctx.font = '8px monospace';
              ctx.fillStyle = isHover ? '#aabbdd' : '#556688';
              const detail = i === TARGETING_MODE.SINGLE ? '1 CEL' : (i === TARGETING_MODE.MULTI ? 'GRUPA' : 'HARDPOINTY');
              ctx.fillText(detail, lx, ly + 20);
              ctx.fillText('BROŃ 100%', lx, ly + 30);
            }
    
            // Środek koła — tryb SELECT
            const selectR = 26;
            const selectColor = TARGETING_MODE_COLORS[TARGETING_MODE.SELECT];
            const isSelectHover = targetingMode.wheelHover === TARGETING_MODE.SELECT;
            const isSelectCurrent = targetingMode.current === TARGETING_MODE.SELECT;
    
            ctx.beginPath();
            ctx.arc(cx, cy, selectR, 0, Math.PI * 2);
            ctx.fillStyle = isSelectHover
              ? `${selectColor}44`
              : (isSelectCurrent ? 'rgba(40, 60, 100, 0.6)' : 'rgba(20, 30, 50, 0.4)');
            ctx.fill();
            ctx.strokeStyle = isSelectHover ? selectColor : 'rgba(80, 120, 180, 0.3)';
            ctx.lineWidth = isSelectHover ? 2 : 1;
            ctx.stroke();
    
            ctx.fillStyle = isSelectHover ? '#fff' : (isSelectCurrent ? selectColor : '#8899bb');
            ctx.font = `bold ${isSelectHover ? 14 : 11}px monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(TARGETING_MODE_ICONS[TARGETING_MODE.SELECT], cx, cy - 6);
            ctx.font = `${isSelectHover ? 9 : 8}px monospace`;
            ctx.fillText(TARGETING_MODE_NAMES[TARGETING_MODE.SELECT], cx, cy + 8);
    
            ctx.restore();
          }
    
          if (mercMission && mercMission.station) {
            const st = mercMission.station;
            const panelPadding = 24;
            const barW = 220;
            const barH = 10;
            let y = 36;
            const xRight = W - panelPadding;
            ctx.save();
            ctx.textAlign = 'right';
            ctx.fillStyle = '#ffd1d1';
            ctx.fillText('Piracka stacja', xRight, y);
            ctx.fillStyle = '#dfe7ff';
            y += 8;
            if (st.shield) {
              const shieldFrac = clamp(st.shield.val / st.shield.max, 0, 1);
              ctx.fillText(`Osłony: ${Math.round(st.shield.val)}/${st.shield.max}`, xRight, y + 10);
              const bx = xRight - barW;
              ctx.strokeStyle = 'rgba(255,255,255,0.18)';
              ctx.strokeRect(bx - 1, y + 14, barW + 2, barH + 2);
              ctx.fillStyle = '#60a5fa';
              ctx.fillRect(bx, y + 15, barW * shieldFrac, barH);
              ctx.fillStyle = '#dfe7ff';
              y += 32;
            }
            const hullFrac = clamp(st.hp / st.maxHp, 0, 1);
            ctx.fillText(`Kadłub: ${Math.round(st.hp)}/${st.maxHp}`, xRight, y + 10);
            const bx = xRight - barW;
            ctx.strokeStyle = 'rgba(255,255,255,0.18)';
            ctx.strokeRect(bx - 1, y + 14, barW + 2, barH + 2);
            ctx.fillStyle = '#ef4444';
            ctx.fillRect(bx, y + 15, barW * hullFrac, barH);
            y += 32;
            const platforms = mercMission.weaponPlatforms || [];
            if (platforms.length) {
              ctx.fillStyle = '#ffd1d1';
              ctx.fillText('Platformy obronne', xRight, y);
              y += 8;
              for (const platform of platforms) {
                const label = platform.label || 'Platforma';
                const entryBx = xRight - barW;
                if (platform.shield && platform.shield.max > 0) {
                  const shieldFrac = clamp(platform.shield.val / platform.shield.max, 0, 1);
                  ctx.fillStyle = '#dfe7ff';
                  ctx.fillText(`${label}: osłony ${Math.round(platform.shield.val)}/${platform.shield.max}`, xRight, y + 10);
                  ctx.strokeStyle = 'rgba(255,255,255,0.12)';
                  ctx.strokeRect(entryBx - 1, y + 14, barW + 2, barH + 2);
                  ctx.fillStyle = '#60a5fa';
                  ctx.fillRect(entryBx, y + 15, barW * shieldFrac, barH);
                  y += 26;
                }
                const hpFrac = (platform.maxHp > 0) ? clamp(Math.max(0, platform.hp) / platform.maxHp, 0, 1) : 0;
                ctx.fillStyle = '#dfe7ff';
                ctx.fillText(`${label}: kadłub ${Math.max(0, Math.round(platform.hp))}/${platform.maxHp}`, xRight, y + 10);
