        const STATION_TERMINAL_TABS = [
          { id: 'hangar', label: 'HANGAR', key: '1' },
          { id: 'trade', label: 'TRADE', key: '2' },
          { id: 'cantina', label: 'CANTINA', key: '3' },
          { id: 'mechanic', label: 'MECHANIC', key: '4' },
          { id: 'infrastructure', label: 'INFRASTRUCTURE', key: '5' },
        ];
        const STATION_TERMINAL_TAB_IDS = STATION_TERMINAL_TABS.map(tab => tab.id);
        const STATION_TERMINAL_TAB_SET = new Set(STATION_TERMINAL_TAB_IDS);
        const stationTerminal = {
