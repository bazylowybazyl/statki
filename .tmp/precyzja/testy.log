        function drawTowRopes(ctx, cam) {
          if (TowSystem.size === 0) return;
          const zoom = Math.max(0.0001, Number(cam?.zoom) || 1);
          const pulse = 0.5 + 0.5 * Math.sin(performance.now() * 0.005);
          ctx.save();
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          TowSystem.forEach((rope) => {
            const a = worldToScreen(rope.worldAx, rope.worldAy, cam);
            const b = worldToScreen(rope.worldBx, rope.worldBy, cam);
            const tensionRatio = Number.isFinite(rope.breakForce) && rope.breakForce > 0
              ? clamp(rope.lastTension / rope.breakForce, 0, 1)
              : 0;
            const outerWidth = clamp(7 * Math.sqrt(zoom), 2.4, 10);
    
            ctx.globalAlpha = 0.92;
            ctx.strokeStyle = tensionRatio > 0.72 ? '#8b2f25' : '#17242b';
            ctx.lineWidth = outerWidth;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
    
            ctx.globalAlpha = 0.86;
            ctx.strokeStyle = tensionRatio > 0.72
              ? `rgba(255, ${Math.round(105 + pulse * 65)}, 72, 0.95)`
              : 'rgba(133, 196, 211, 0.9)';
            ctx.lineWidth = Math.max(1, outerWidth * 0.32);
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
    
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const distance = Math.hypot(dx, dy);
            if (distance > 10) {
              const invDistance = 1 / distance;
              const nx = dx * invDistance;
              const ny = dy * invDistance;
              const px = -ny;
              const py = nx;
              const markerHalf = Math.min(5, distance * 0.08);
              const mx = (a.x + b.x) * 0.5;
              const my = (a.y + b.y) * 0.5;
