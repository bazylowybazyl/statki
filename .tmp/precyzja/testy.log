          npc.mission = true;
          npc.color = policy.color || (policy.friendly ? '#7cff91' : '#ff5c7c');
          const hullFrame = getCallInHullFrame(typeKey, policy, template);
          if (hullFrame) npc.shipFrame = hullFrame;
        }
    
        function runCallInCombatAI(npc, typeKey, dt) {
          const kind = String(typeKey || npc?.type || '').toLowerCase();
          if (kind === 'fighter' || kind === 'interceptor') {
            if (window.runAdvancedFighterAI) window.runAdvancedFighterAI(npc, dt);
          } else if (kind === 'frigate_laser') {
            if (window.aiLaserFrigate) window.aiLaserFrigate(null, npc, dt);
            else if (window.aiFrigate) window.aiFrigate(null, npc, dt);
          } else if (kind.includes('frigate')) {
            if (window.aiFrigate) window.aiFrigate(null, npc, dt);
          } else if (kind === 'destroyer') {
            if (window.aiDestroyer) window.aiDestroyer(null, npc, dt);
          } else if (window.aiBattleship) {
            window.aiBattleship(null, npc, dt);
          }
        }
    
        function spawnSupportShip(templateKey, opts = {}) {
          const template = SUPPORT_SHIP_TEMPLATES[templateKey];
          if (!template) return [];
          const policy = getCallInSpawnPolicy(opts.mode ?? getSupportSpawnMode(), template);
          const typeKey = resolveCallInTypeKey(templateKey, template);
          const anchor = (opts.anchor && !opts.anchor.dead) ? opts.anchor : ship;
          const anchorPos = anchor.pos || { x: anchor.x ?? ship.pos.x, y: anchor.y ?? ship.pos.y };
          const anchorVel = anchor.vel || { x: anchor.vx ?? 0, y: anchor.vy ?? 0 };
          const anchorAngle = anchor.angle ?? ship.angle;
          const useSpawnPos = opts.spawnPos && Number.isFinite(opts.spawnPos.x) && Number.isFinite(opts.spawnPos.y);
          const basePos = useSpawnPos ? opts.spawnPos : anchorPos;
          const baseAngle = opts.spawnAngle ?? anchorAngle;
          const baseOffset = (opts.spawnOffset ?? template.spawnOffset ?? (useSpawnPos ? { x: 0, y: 0 } : { x: -60, y: 0 }));
    
          const created = [];
          const count = Math.max(1, template.count || 1);
          const spawnFormation = SUPPORT_FORMATION.spawn || { perRow: 4, rowGap: 70 };
          for (let i = 0; i < count; i++) {
            const jitter = (Math.random() * 12 - 6);
            const offset = {
              x: (baseOffset.x || 0) + jitter,
              y: (baseOffset.y || 0) + ((i % spawnFormation.perRow) - (spawnFormation.perRow - 1) * 0.5) * 8
            };
            const rotated = rotate(offset, baseAngle);
            const spawnPos = { x: basePos.x + rotated.x, y: basePos.y + rotated.y };
            const npc = makeNPCBase(spawnPos, { ...template.stats, shield: template.shield });
            npc.type = typeKey;
            npc.callInTemplateKey = templateKey;
            npc.sensors = template.sensors ? { ...template.sensors } : undefined;
            applyCallInIdentity(npc, typeKey, template, policy);
            assignNpcShipFrame(npc);
            applyCallInIdentity(npc, typeKey, template, policy);
            npc.vx = anchorVel.x ?? npc.vx;
            npc.vy = anchorVel.y ?? npc.vy;
            template.configure?.(npc, i);
            applyEditorLayoutToNpc(npc);
            equipNpcWeapons(npc, policy.weaponFaction);
            if (policy.joinSupportWing) {
              npc.supportData = { npc, type: typeKey, slotIndex: SupportWing.units.length + created.length, leader: anchor };
              npc.ai = dt => runSupportAI(npc, dt);
              SupportWing.units.push(npc.supportData);
            } else {
              npc.supportData = null;
              npc.ai = policy.aiEnabled ? (dt => runCallInCombatAI(npc, typeKey, dt)) : null;
            }
            npcs.push(npc);
            created.push(npc);
          }
          return created;
        }
    
        const CAPITAL_SHIP_TEMPLATES = CAPITAL_SHIP_TEMPLATES_DATA;
    
        Fleet.templates = Object.assign(Fleet.templates || {}, { capital: CAPITAL_SHIP_TEMPLATES });
    
        function addFleetShip(entry) {
          if (!entry || !entry.entity) return null;
          Fleet.ships.push(entry);
          npcs.push(entry.entity);
          return entry;
        }
    
        function createCapitalShipEntry(templateKey, overrides = {}) {
          const template = CAPITAL_SHIP_TEMPLATES[templateKey];
          if (!template) return null;
          const policy = getCallInSpawnPolicy(overrides.mode ?? getSupportSpawnMode(), template);
          const hullFrame = getCallInHullFrame(templateKey, policy, template);
          if ((templateKey === 'carrier' || templateKey === 'supercapital') && !hullFrame) return null;
          const staticDummy = template.staticDummy === true;
          const hardpointCounts = {
            large: staticDummy ? 0 : Math.max(0, Number(template.hardpoints?.large) || 0),
            medium: staticDummy ? 0 : Math.max(0, Number(template.hardpoints?.medium) || 0)
          };
          const offset = overrides.formationOffset || template.formationOffset || { x: -820, y: 420 };
          const basePos = overrides.pos || { x: ship.pos.x + offset.x, y: ship.pos.y + offset.y };
    
          const npc = makeNPCBase(basePos, {
            hp: template.hull,
            accel: template.accel,
            maxSpeed: template.maxSpeed,
            turn: template.turn,
            radius: template.radius,
            mass: template.mass
          });
    
          npc.hp = template.hull;
          npc.maxHp = template.hull;
          npc.radius = template.radius;
          if (Number.isFinite(template.mass)) npc.mass = template.mass;
          if (Number.isFinite(template.rammingMass)) npc.rammingMass = template.rammingMass;
          npc.type = template.id;
          npc.staticDummy = staticDummy;
          npc.disableEditorLayout = staticDummy || template.disableEditorLayout === true;
          npc.combatDisabled = staticDummy;
          npc.callInTemplateKey = templateKey;
          npc.sensors = template.sensors ? { ...template.sensors } : undefined;
          applyCallInIdentity(npc, templateKey, template, policy);
          assignNpcShipFrame(npc);
          applyCallInIdentity(npc, templateKey, template, policy);
          if (policy.friendly && template.profile?.accentColor) npc.color = template.profile.accentColor;
          npc.isCapitalShip = true;
          npc.capitalProfile = Object.assign({
            lengthScale: 3.4,
            widthScale: 1.4
          }, template.profile || {});
          if (Number.isFinite(Number(npc.capitalProfile.spriteScale)) && Number(npc.capitalProfile.spriteScale) > 0) {
            npc.visual = npc.visual || {};
            npc.visual.spriteScale = Number(npc.capitalProfile.spriteScale);
          }
          if (npc.capitalProfile.spriteSrc) {
            npc.capitalSprite = getCapitalShipSprite(npc.capitalProfile.spriteSrc);
          }
          npc.shield = {
            val: template.shield,
            max: template.shield,
            regenRate: template.shieldRegen,
            regenDelay: template.shieldDelay,
            regenTimer: 0
          };
          npc.hardpoints = hardpointCounts;
          npc.fleetFormationOffset = offset;
          if (Number.isFinite(Number(template.weaponRange)) && Number(template.weaponRange) > 0) {
            npc.weaponRange = Number(template.weaponRange);
            npc.preferredRange = Number(template.weaponRange);
          }
          npc.vx = 0;
          npc.vy = 0;
          npc.angle = Math.atan2(ship.pos.y - npc.y, ship.pos.x - npc.x);
          npc.desiredAngle = npc.angle;
          npc.keepAngle = true;
          npc.drawLayer = template.profile?.spriteLayer ?? 0;
    
          const entry = {
            id: overrides.id || `fleet_${templateKey}_${Math.random().toString(36).slice(2, 8)}`,
            type: templateKey,
            displayName: overrides.displayName || template.displayName,
            roleText: overrides.roleText || template.roleText,
            entity: npc,
            hardpoints: hardpointCounts,
            status: {
              hull: template.hull,
              hullMax: template.hull,
              shield: template.shield,
              shieldMax: template.shield
            },
            template,
            spawnPolicy: policy
          };
    
          if (policy.registerFleet) npc.fleetEntry = entry;
          applyEditorLayoutToNpc(npc);
    
          const supportLeader = (overrides.anchor && !overrides.anchor.dead) ? overrides.anchor : ship;
          const supportType = templateKey === 'carrier' ? 'carrier' : templateKey;
          if (staticDummy) {
            npc.weapons = { main: [], aux: [], missile: [], hangar: [], special: [], special_missile: [], builtin: [] };
          } else {
            equipNpcWeapons(npc, policy.weaponFaction);
          }
          const joinSupportWing = policy.joinSupportWing && !staticDummy && template.disableSupportWing !== true;
          if (joinSupportWing) {
            npc.supportData = {
              npc,
              type: supportType,
              slotIndex: SupportWing.units.length,
              leader: supportLeader
            };
            SupportWing.units.push(npc.supportData);
            npc.ai = dt => runSupportAI(npc, dt);
          } else {
            npc.supportData = null;
            npc.ai = (!staticDummy && policy.aiEnabled) ? (dt => runCallInCombatAI(npc, supportType, dt)) : null;
          }
    
          return entry;
        }
        function resolveCapitalSpawnPos(opts = {}) {
          const au = getAuToWorldUnits();
          const angle = Number.isFinite(ship?.angle) ? ship.angle : Math.random() * Math.PI * 2;
          return (opts.pos && Number.isFinite(opts.pos.x) && Number.isFinite(opts.pos.y))
            ? opts.pos
            : {
              x: ship.pos.x + Math.cos(angle) * au,
              y: ship.pos.y + Math.sin(angle) * au
            };
        }
    
        const _megafreighterTrainLayout = [];
        // Wszystkie żywe składy (gracza i NPC) prowadzone sztywną kinematyką =o=.
        const megafreighterTrains = [];
    
        function updateMegafreighterTrains(dt) {
          for (let i = megafreighterTrains.length - 1; i >= 0; i--) {
            const train = megafreighterTrains[i];
            const head = train?.head;
            const headGone = !head || head.dead === true || head.removed === true
              || (train.playerControlled && playerMegafreighterTrain !== train);
            if (headGone) {
              megafreighterTrains.splice(i, 1);
              continue;
            }
            stepMegafreighterTrainKinematics(train.modules, dt);
          }
        }
    
        function configureMegafreighterModule(entry, moduleDef, trainId, moduleIndex, pose, opts = {}) {
          const npc = entry.entity;
          npc.type = moduleDef.type;
          npc.shipFrame = 'megafreighter';
          npc.callInTemplateKey = 'megafreighter';
          npc.hp = moduleDef.hull;
          npc.maxHp = moduleDef.hull;
          npc.mass = moduleDef.mass;
          npc.rammingMass = moduleDef.mass;
          npc.radius = moduleDef.radius;
          npc.w = moduleDef.renderWidth;
          npc.h = moduleDef.renderHeight;
          npc.angle = pose.angle;
          npc.desiredAngle = pose.angle;
          npc.vx = Number(opts.velocity?.x) || 0;
          npc.vy = Number(opts.velocity?.y) || 0;
          npc.angVel = Number(opts.angularVelocity) || 0;
          npc.ai = null;
          npc.combatDisabled = true;
          npc.staticDummy = true;
          // Independent call-ins use the generic "dummy" mode, which normally
          // marks them hostile. The freight train must remain commandable/towable.
          if (!npc.isPirate) npc.friendly = true;
          npc.towTrainId = trainId;
          npc.towTrainRole = moduleDef.role;
          npc.towTrainIndex = moduleIndex;
          npc.towTrainChild = moduleIndex > 0;
          if (moduleIndex > 0) {
            npc.accel = 0;
            npc.maxSpeed = 0;
            npc.turn = 0;
            npc.turnAccel = 0;
            // Wagon nie ma własnego autopilota obrotu. Jego kąt i angVel wynikają
            // wyłącznie z sił przekazywanych przez sztywny, przegubowy sprzęg.
            npc.desiredAngle = Number.NaN;
            npc.keepAngle = true;
          }
          npc.capitalProfile = {
            ...(entry.template?.profile || {}),
            spriteSrc: moduleDef.spriteSrc,
            spriteEngineGlow: false,
            engineOffsets: []
          };
          npc.capitalSprite = getCapitalShipSprite(moduleDef.spriteSrc);
          npc.visual = npc.visual || {};
          npc.visual.spriteScale = Number(npc.capitalProfile.spriteScale) || 1;
          entry.displayName = moduleDef.displayName;
          entry.roleText = moduleDef.role === 'front' ? 'Locomotive / tow controller' : 'Rigid cargo module';
          entry.status.hull = moduleDef.hull;
          entry.status.hullMax = moduleDef.hull;
          return npc;
        }
    
        function spawnMegafreighterTrain(opts = {}) {
          const mode = normalizeCallInSpawnMode(opts.mode ?? getSupportSpawnMode());
          const origin = resolveCapitalSpawnPos(opts);
          const heading = Number.isFinite(Number(opts.angle))
            ? Number(opts.angle)
            : Math.atan2(ship.pos.y - origin.y, ship.pos.x - origin.x);
          const layout = buildMegafreighterTrainLayout(origin, heading, _megafreighterTrainLayout);
          const trainId = opts.trainId || `megatrain_${Math.random().toString(36).slice(2, 9)}`;
          const train = {
            id: trainId,
            head: null,
            modules: [],
            couplers: []
          };
    
          for (let i = 0; i < layout.length; i++) {
            const pose = layout[i];
            const entry = createCapitalShipEntry('megafreighter', {
              pos: { x: pose.x, y: pose.y },
              formationOffset: { x: 0, y: 0 },
              anchor: (opts.anchor && !opts.anchor.dead) ? opts.anchor : ship,
              mode,
              displayName: pose.module.displayName
            });
            if (!entry) continue;
            const npc = configureMegafreighterModule(entry, pose.module, trainId, i, pose, opts);
            npc.towTrain = train;
            train.modules.push(npc);
    
            if (i === 0 && entry.spawnPolicy?.registerFleet) addFleetShip(entry);
            else npcs.push(npc);
          }
    
          train.head = train.modules[0] || null;
          if (!train.head) return null;
          train.head.towLocomotive = true;
          train.head.towTrainModules = train.modules;
    
          // Wagony prowadzi sztywna kinematyka =o= (updateMegafreighterTrains),
          // nie sprzęgi impulsowe TowSystem.
          megafreighterTrains.push(train);
    
          window.lastMegafreighterTrain = train;
          return train.head;
        }
    
        let playerMegafreighterTrain = null;
    
        function removePlayerMegafreighterTrain(reason = 'player-hull-changed') {
          const train = playerMegafreighterTrain;
          if (!train) return;
    
          const trainIndex = megafreighterTrains.indexOf(train);
          if (trainIndex >= 0) megafreighterTrains.splice(trainIndex, 1);
          for (const coupler of train.couplers) TowSystem.detach(coupler, reason);
          for (let i = 1; i < train.modules.length; i++) {
            const module = train.modules[i];
            if (!module) continue;
            TowSystem.detachBody(module, reason);
            releaseNpcHexBody(module);
            module.dead = true;
            module.removed = true;
            const npcIndex = npcs.indexOf(module);
            if (npcIndex >= 0) npcs.splice(npcIndex, 1);
          }
    
          delete ship.towTrain;
          delete ship.towTrainId;
          delete ship.towTrainRole;
          delete ship.towTrainIndex;
          delete ship.towTrainModules;
          delete ship.towLocomotive;
          playerMegafreighterTrain = null;
          window.playerMegafreighterTrain = null;
        }
    
        function spawnPlayerMegafreighterTrain() {
          removePlayerMegafreighterTrain('player-train-respawn');
          const layout = buildMegafreighterTrainLayout(ship.pos, ship.angle, _megafreighterTrainLayout);
          const trainId = `player_megatrain_${Math.random().toString(36).slice(2, 9)}`;
          const train = {
            id: trainId,
            head: ship,
            playerControlled: true,
            modules: [ship],
            couplers: []
          };
    
          ship.towTrain = train;
          ship.towTrainId = trainId;
          ship.towTrainRole = 'front';
          ship.towTrainIndex = 0;
          ship.towLocomotive = true;
    
          for (let i = 1; i < layout.length; i++) {
            const pose = layout[i];
            const entry = createCapitalShipEntry('megafreighter', {
              pos: { x: pose.x, y: pose.y },
              formationOffset: { x: 0, y: 0 },
              anchor: ship,
              mode: 'dummy',
              displayName: pose.module.displayName
            });
            if (!entry) continue;
            const module = configureMegafreighterModule(entry, pose.module, trainId, i, pose, {
              velocity: ship.vel,
              angularVelocity: ship.angVel
            });
            module.friendly = true;
            module.isPirate = false;
            module.mission = true;
            module.towTrain = train;
            module.playerTrainModule = true;
            npcs.push(module);
            train.modules.push(module);
          }
    
          ship.towTrainModules = train.modules;
          // Wagony prowadzi sztywna kinematyka =o= (updateMegafreighterTrains),
          // nie sprzęgi impulsowe TowSystem.
          megafreighterTrains.push(train);
    
          playerMegafreighterTrain = train;
          window.playerMegafreighterTrain = train;
          return train;
        }
    
        function syncPlayerMegafreighterTrain(hullId = null) {
          const isMegafreighter = String(hullId || ship?.activeHullId || '').toLowerCase() === 'megafreighter';
          if (!isMegafreighter) {
            removePlayerMegafreighterTrain();
            return null;
          }
          if (!gameStarted) return null;
    
          const current = playerMegafreighterTrain;
          const isCurrentValid = current
            && current.head === ship
            && current.modules.length === MEGAFREIGHTER_TRAIN_MODULES.length
            && current.modules.slice(1).every(module => module && !module.dead && npcs.includes(module));
          return isCurrentValid ? current : spawnPlayerMegafreighterTrain();
        }
    
        window.syncPlayerMegafreighterTrain = syncPlayerMegafreighterTrain;
    
        function spawnCapitalCallIn(templateKey, opts = {}) {
          const mode = normalizeCallInSpawnMode(opts.mode ?? getSupportSpawnMode());
          if (templateKey === 'megafreighter' && opts.singleModule !== true) {
            return spawnMegafreighterTrain({ ...opts, mode });
          }
          if (templateKey === 'carrier' && mode === 'friendly') {
            const existing = getFriendlyCarrierEntity();
            if (existing) return existing;
          }
    
          const entry = createCapitalShipEntry(templateKey, {
            pos: resolveCapitalSpawnPos(opts),
            formationOffset: { x: 0, y: 0 },
            anchor: (opts.anchor && !opts.anchor.dead) ? opts.anchor : ship,
            mode
          });
          if (!entry) return null;
    
          if (entry.spawnPolicy?.registerFleet) addFleetShip(entry);
          else npcs.push(entry.entity);
          return entry.entity;
        }
    
        function spawnCallInShip(templateKey, opts = {}) {
          const mode = normalizeCallInSpawnMode(opts.mode ?? getSupportSpawnMode());
          if (templateKey === 'carrier') {
            return spawnCapitalCallIn('carrier', { ...opts, mode });
          }
          if (templateKey === 'supercapital') {
            return spawnCapitalCallIn('supercapital', { ...opts, mode });
          }
          if (templateKey === 'atlas') {
            return spawnCapitalCallIn('atlas', { ...opts, mode });
          }
          if (templateKey === 'megafreighter') {
            return spawnCapitalCallIn('megafreighter', { ...opts, mode });
          }
          return spawnSupportShip(templateKey, { ...opts, mode });
        }
    
        function spawnFriendlyCarrier(opts = {}) {
          return spawnCapitalCallIn('carrier', { ...opts, mode: 'friendly' });
        }
    
        function spawnFriendlySupercapital(opts = {}) {
          return spawnCapitalCallIn('supercapital', { ...opts, mode: 'friendly' });
        }
    
        window.spawnSupportShip = spawnSupportShip;
        window.spawnCallInShip = spawnCallInShip;
        window.spawnMegafreighterTrain = spawnMegafreighterTrain;
        window.spawnFriendlyCarrier = spawnFriendlyCarrier;
        window.spawnFriendlySupercapital = spawnFriendlySupercapital;
    
        function initFleet() {
          Fleet.ships.length = 0;
        }
    
        function spawnPirate(kind, station) {
          // 1. Znajdź szablon
          let template = SUPPORT_SHIP_TEMPLATES[kind];
    
          // Fallback: jeśli wpisano 'fighter', a w szablonach jest 'interceptor' (lub odwrotnie)
          if (!template) {
            if (kind === 'fighter') template = SUPPORT_SHIP_TEMPLATES['interceptor'];
            else if (kind === 'interceptor') template = SUPPORT_SHIP_TEMPLATES['fighter'];
          }
    
          // Jeśli nadal brak szablonu, użyj domyślnego interceptora (żeby gra się nie wysypała)
          if (!template) {
            console.warn(`Nieznany typ pirata: ${kind}. Spawnuję interceptor.`);
            template = SUPPORT_SHIP_TEMPLATES['interceptor'];
          }
    
          // 2. Pozycja startowa
          const angle = Math.random() * Math.PI * 2;
          const dist = (station.r || 100) + 150;
          const pos = {
            x: station.x + Math.cos(angle) * dist,
            y: station.y + Math.sin(angle) * dist
          };
    
          // 3. Stworzenie bazy NPC z szablonu
          const npc = makeNPCBase(pos, { ...template.stats, shield: template.shield });
    
          // 4. Nadpisanie właściwości pod PIRATA
          npc.type = kind;
          npc.friendly = false;
          npc.isPirate = true;
          assignNpcShipFrame(npc);
          npc.mission = true;
          npc.color = '#ff5c7c'; // Czerwony kolor pirata
    
    
          // Przypisanie referencji do stacji (ważne dla logiki patrolu)
          npc.home = station;
    
          // 5. Konfiguracja uzbrojenia i AI z szablonu
          if (template.configure) {
            template.configure(npc);
            applyEditorLayoutToNpc(npc);
            equipNpcWeapons(npc, 'pirate');
          }
    
          // 6. Początkowy obrót w stronę gracza
          npc.angle = Math.atan2(ship.pos.y - npc.y, ship.pos.x - npc.x);
    
          // 7. Rejestracja w grze
          npcs.push(npc);
          return npc;
        }
    
        function spawnPirateHeavyFleet(station) {
          if (!station) return;
          const dx = ship.pos.x - station.x;
          const dy = ship.pos.y - station.y;
          const dist = Math.hypot(dx, dy) || 1;
    
          const fwd = { x: dx / dist, y: dy / dist };
          const right = { x: -fwd.y, y: fwd.x };
    
          const startDist = 3500;
          const endDist = 800;
    
          const fleetComposition = [
            'destroyer', 'destroyer',
            'battleship', 'battleship', 'battleship',
            'destroyer', 'destroyer', 'destroyer'
          ];
    
          // POPRAWKA 1: Zwiększony odstęp, żeby Battleshipy (szerokość ~280) się nie zderzały
          const spacing = 1600;
          const totalWidth = (fleetComposition.length - 1) * spacing;
    
          fleetComposition.forEach((type, i) => {
            const offset = (i * spacing) - (totalWidth / 2);
            const startX = station.x - (fwd.x * startDist) + (right.x * offset);
            const startY = station.y - (fwd.y * startDist) + (right.y * offset);
            const targetX = station.x + (fwd.x * endDist) + (right.x * offset);
            const targetY = station.y + (fwd.y * endDist) + (right.y * offset);
    
            const npc = spawnPirate(type, station);
            npc.x = startX;
            npc.y = startY;
            npc.angle = Math.atan2(fwd.y, fwd.x);
            npc.state = 'warping_in';
            npc.isCollidable = false;
    
            // Lekka losowość hamowania, żeby nie wyglądały jak roboty
            const randomBrake = 280 + Math.random() * 40;
    
            npc.warpData = {
              targetX,
              targetY,
              speed: 4000,
              brakingDist: randomBrake
            };
            npc.vx = 0;
            npc.vy = 0;
          });
    
          pushZoneMessage("WARNING: HOSTILE CAPITAL SIGNATURES DETECTED", 4.0);
          if (window.AudioSys) AudioSys.playSound('shieldHit');
        }
    
        // POPRAWKA 2: Przypisanie do window (teraz będzie widoczne globalnie)
        window.spawnPirateHeavyFleet = spawnPirateHeavyFleet;
        // Lista na martwe, dryfujące kawałki
        window.createWreckage = function (parentEntity, shards) {
