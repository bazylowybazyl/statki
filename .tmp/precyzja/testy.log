          }
    
          // Czy to niszczyciel?
          if (npc.type === 'destroyer') {
            return 'destroyer';
          }
    
          // Czy to pancernik / capital?
          if (npc.type === 'battleship' || npc.type === 'carrier' || npc.isCapitalShip) {
