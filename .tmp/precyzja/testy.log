          }
          return out;
        }
    
        function buildPlayerDefaultEditorCores(preferredKey = null) {
          const playerCfg = getPlayerEditorConfigFromStorage(preferredKey);
          const src = Array.isArray(playerCfg?.cores) ? playerCfg.cores : [];
          if (!src.length) return [];
          const { scaleX, scaleY } = getPlayerEditorScale();
          const out = [];
          for (let i = 0; i < src.length; i++) {
            const marker = src[i];
            const x = Number(marker?.x);
            const y = Number(marker?.y);
            if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
            out.push({
              id: marker?.id || uid(),
              x: x * scaleX,
              y: y * scaleY
            });
          }
          return out;
        }
    
        function buildPlayerDefaultEditorLights(preferredKey = null) {
          const playerCfg = getPlayerEditorConfigFromStorage(preferredKey);
