            engineOffsets: []
          };
          npc.capitalSprite = getCapitalShipSprite(moduleDef.spriteSrc);
          npc.visual = npc.visual || {};
          npc.visual.spriteScale = Number(npc.capitalProfile.spriteScale) || 1;
          entry.displayName = moduleDef.displayName;
          entry.roleText = moduleDef.role === 'front' ? 'Locomotive / tow controller' : 'Rigid cargo module';
          entry.status.hull = moduleDef.hull;
          entry.status.hullMax = moduleDef.hull;
          return npc;
        }
    
        function spawnMegafreighterTrain(opts = {}) {
          const mode = normalizeCallInSpawnMode(opts.mode ?? getSupportSpawnMode());
          const origin = resolveCapitalSpawnPos(opts);
          const heading = Number.isFinite(Number(opts.angle))
            ? Number(opts.angle)
            : Math.atan2(ship.pos.y - origin.y, ship.pos.x - origin.x);
          const layout = buildMegafreighterTrainLayout(origin, heading, _megafreighterTrainLayout);
          const trainId = opts.trainId || `megatrain_${Math.random().toString(36).slice(2, 9)}`;
          const train = {
            id: trainId,
            head: null,
            modules: [],
            couplers: []
          };
    
          for (let i = 0; i < layout.length; i++) {
            const pose = layout[i];
            const entry = createCapitalShipEntry('megafreighter', {
              pos: { x: pose.x, y: pose.y },
              formationOffset: { x: 0, y: 0 },
              anchor: (opts.anchor && !opts.anchor.dead) ? opts.anchor : ship,
              mode,
              displayName: pose.module.displayName
            });
            if (!entry) continue;
            const npc = configureMegafreighterModule(entry, pose.module, trainId, i, pose, opts);
            npc.towTrain = train;
            train.modules.push(npc);
    
            if (i === 0 && entry.spawnPolicy?.registerFleet) addFleetShip(entry);
            else npcs.push(npc);
          }
    
          train.head = train.modules[0] || null;
          if (!train.head) return null;
          train.head.towLocomotive = true;
          train.head.towTrainModules = train.modules;
    
          // Wagony prowadzi sztywna kinematyka =o= (updateMegafreighterTrains),
          // nie sprzęgi impulsowe TowSystem.
          megafreighterTrains.push(train);
    
          window.lastMegafreighterTrain = train;
          return train.head;
        }
    
        let playerMegafreighterTrain = null;
    
        function removePlayerMegafreighterTrain(reason = 'player-hull-changed') {
          const train = playerMegafreighterTrain;
          if (!train) return;
    
          const trainIndex = megafreighterTrains.indexOf(train);
          if (trainIndex >= 0) megafreighterTrains.splice(trainIndex, 1);
          for (const coupler of train.couplers) TowSystem.detach(coupler, reason);
          for (let i = 1; i < train.modules.length; i++) {
            const module = train.modules[i];
            if (!module) continue;
            TowSystem.detachBody(module, reason);
            releaseNpcHexBody(module);
            module.dead = true;
            module.removed = true;
            const npcIndex = npcs.indexOf(module);
            if (npcIndex >= 0) npcs.splice(npcIndex, 1);
          }
    
          delete ship.towTrain;
          delete ship.towTrainId;
          delete ship.towTrainRole;
          delete ship.towTrainIndex;
          delete ship.towTrainModules;
          delete ship.towLocomotive;
          playerMegafreighterTrain = null;
          window.playerMegafreighterTrain = null;
        }
    
        function spawnPlayerMegafreighterTrain() {
          removePlayerMegafreighterTrain('player-train-respawn');
          const layout = buildMegafreighterTrainLayout(ship.pos, ship.angle, _megafreighterTrainLayout);
          const trainId = `player_megatrain_${Math.random().toString(36).slice(2, 9)}`;
          const train = {
            id: trainId,
            head: ship,
            playerControlled: true,
            modules: [ship],
            couplers: []
          };
    
          ship.towTrain = train;
          ship.towTrainId = trainId;
          ship.towTrainRole = 'front';
          ship.towTrainIndex = 0;
          ship.towLocomotive = true;
    
          for (let i = 1; i < layout.length; i++) {
            const pose = layout[i];
            const entry = createCapitalShipEntry('megafreighter', {
              pos: { x: pose.x, y: pose.y },
              formationOffset: { x: 0, y: 0 },
              anchor: ship,
              mode: 'dummy',
              displayName: pose.module.displayName
            });
            if (!entry) continue;
            const module = configureMegafreighterModule(entry, pose.module, trainId, i, pose, {
              velocity: ship.vel,
              angularVelocity: ship.angVel
            });
            module.friendly = true;
            module.isPirate = false;
            module.mission = true;
            module.towTrain = train;
            module.playerTrainModule = true;
            npcs.push(module);
            train.modules.push(module);
          }
    
          ship.towTrainModules = train.modules;
          // Wagony prowadzi sztywna kinematyka =o= (updateMegafreighterTrains),
          // nie sprzęgi impulsowe TowSystem.
          megafreighterTrains.push(train);
    
          playerMegafreighterTrain = train;
          window.playerMegafreighterTrain = train;
          return train;
        }
    
        function syncPlayerMegafreighterTrain(hullId = null) {
          const isMegafreighter = String(hullId || ship?.activeHullId || '').toLowerCase() === 'megafreighter';
          if (!isMegafreighter) {
            removePlayerMegafreighterTrain();
            return null;
          }
          if (!gameStarted) return null;
    
          const current = playerMegafreighterTrain;
          const isCurrentValid = current
            && current.head === ship
            && current.modules.length === MEGAFREIGHTER_TRAIN_MODULES.length
            && current.modules.slice(1).every(module => module && !module.dead && npcs.includes(module));
          return isCurrentValid ? current : spawnPlayerMegafreighterTrain();
        }
    
        window.syncPlayerMegafreighterTrain = syncPlayerMegafreighterTrain;
    
        function spawnCapitalCallIn(templateKey, opts = {}) {
          const mode = normalizeCallInSpawnMode(opts.mode ?? getSupportSpawnMode());
          if (templateKey === 'megafreighter' && opts.singleModule !== true) {
            return spawnMegafreighterTrain({ ...opts, mode });
          }
          if (templateKey === 'carrier' && mode === 'friendly') {
            const existing = getFriendlyCarrierEntity();
            if (existing) return existing;
          }
    
          const entry = createCapitalShipEntry(templateKey, {
            pos: resolveCapitalSpawnPos(opts),
            formationOffset: { x: 0, y: 0 },
            anchor: (opts.anchor && !opts.anchor.dead) ? opts.anchor : ship,
            mode
          });
          if (!entry) return null;
    
          if (entry.spawnPolicy?.registerFleet) addFleetShip(entry);
          else npcs.push(entry.entity);
          return entry.entity;
        }
    
        function spawnCallInShip(templateKey, opts = {}) {
          const mode = normalizeCallInSpawnMode(opts.mode ?? getSupportSpawnMode());
          if (templateKey === 'carrier') {
            return spawnCapitalCallIn('carrier', { ...opts, mode });
          }
          if (templateKey === 'supercapital') {
            return spawnCapitalCallIn('supercapital', { ...opts, mode });
          }
          if (templateKey === 'atlas') {
            return spawnCapitalCallIn('atlas', { ...opts, mode });
          }
          if (templateKey === 'megafreighter') {
            return spawnCapitalCallIn('megafreighter', { ...opts, mode });
          }
          return spawnSupportShip(templateKey, { ...opts, mode });
        }
    
        function spawnFriendlyCarrier(opts = {}) {
          return spawnCapitalCallIn('carrier', { ...opts, mode: 'friendly' });
        }
    
        function spawnFriendlySupercapital(opts = {}) {
          return spawnCapitalCallIn('supercapital', { ...opts, mode: 'friendly' });
        }
    
        window.spawnSupportShip = spawnSupportShip;
        window.spawnCallInShip = spawnCallInShip;
        window.spawnMegafreighterTrain = spawnMegafreighterTrain;
        window.spawnFriendlyCarrier = spawnFriendlyCarrier;
        window.spawnFriendlySupercapital = spawnFriendlySupercapital;
    
        function initFleet() {
          Fleet.ships.length = 0;
        }
    
        function spawnPirate(kind, station) {
          // 1. Znajdź szablon
          let template = SUPPORT_SHIP_TEMPLATES[kind];
    
          // Fallback: jeśli wpisano 'fighter', a w szablonach jest 'interceptor' (lub odwrotnie)
          if (!template) {
            if (kind === 'fighter') template = SUPPORT_SHIP_TEMPLATES['interceptor'];
            else if (kind === 'interceptor') template = SUPPORT_SHIP_TEMPLATES['fighter'];
          }
    
          // Jeśli nadal brak szablonu, użyj domyślnego interceptora (żeby gra się nie wysypała)
          if (!template) {
            console.warn(`Nieznany typ pirata: ${kind}. Spawnuję interceptor.`);
            template = SUPPORT_SHIP_TEMPLATES['interceptor'];
          }
    
          // 2. Pozycja startowa
          const angle = Math.random() * Math.PI * 2;
          const dist = (station.r || 100) + 150;
          const pos = {
            x: station.x + Math.cos(angle) * dist,
            y: station.y + Math.sin(angle) * dist
          };
    
          // 3. Stworzenie bazy NPC z szablonu
          const npc = makeNPCBase(pos, { ...template.stats, shield: template.shield });
    
          // 4. Nadpisanie właściwości pod PIRATA
          npc.type = kind;
          npc.friendly = false;
          npc.isPirate = true;
          assignNpcShipFrame(npc);
          npc.mission = true;
          npc.color = '#ff5c7c'; // Czerwony kolor pirata
    
    
          // Przypisanie referencji do stacji (ważne dla logiki patrolu)
          npc.home = station;
    
          // 5. Konfiguracja uzbrojenia i AI z szablonu
          if (template.configure) {
            template.configure(npc);
            applyEditorLayoutToNpc(npc);
            equipNpcWeapons(npc, 'pirate');
          }
    
          // 6. Początkowy obrót w stronę gracza
          npc.angle = Math.atan2(ship.pos.y - npc.y, ship.pos.x - npc.x);
    
          // 7. Rejestracja w grze
          npcs.push(npc);
          return npc;
        }
    
        function spawnPirateHeavyFleet(station) {
          if (!station) return;
          const dx = ship.pos.x - station.x;
          const dy = ship.pos.y - station.y;
          const dist = Math.hypot(dx, dy) || 1;
    
          const fwd = { x: dx / dist, y: dy / dist };
          const right = { x: -fwd.y, y: fwd.x };
    
          const startDist = 3500;
          const endDist = 800;
    
          const fleetComposition = [
            'destroyer', 'destroyer',
            'battleship', 'battleship', 'battleship',
            'destroyer', 'destroyer', 'destroyer'
          ];
    
          // POPRAWKA 1: Zwiększony odstęp, żeby Battleshipy (szerokość ~280) się nie zderzały
          const spacing = 1600;
          const totalWidth = (fleetComposition.length - 1) * spacing;
    
          fleetComposition.forEach((type, i) => {
            const offset = (i * spacing) - (totalWidth / 2);
            const startX = station.x - (fwd.x * startDist) + (right.x * offset);
            const startY = station.y - (fwd.y * startDist) + (right.y * offset);
            const targetX = station.x + (fwd.x * endDist) + (right.x * offset);
            const targetY = station.y + (fwd.y * endDist) + (right.y * offset);
    
            const npc = spawnPirate(type, station);
            npc.x = startX;
            npc.y = startY;
            npc.angle = Math.atan2(fwd.y, fwd.x);
            npc.state = 'warping_in';
            npc.isCollidable = false;
    
            // Lekka losowość hamowania, żeby nie wyglądały jak roboty
            const randomBrake = 280 + Math.random() * 40;
    
            npc.warpData = {
              targetX,
              targetY,
              speed: 4000,
              brakingDist: randomBrake
            };
            npc.vx = 0;
            npc.vy = 0;
          });
    
          pushZoneMessage("WARNING: HOSTILE CAPITAL SIGNATURES DETECTED", 4.0);
          if (window.AudioSys) AudioSys.playSound('shieldHit');
        }
    
        // POPRAWKA 2: Przypisanie do window (teraz będzie widoczne globalnie)
        window.spawnPirateHeavyFleet = spawnPirateHeavyFleet;
        // Lista na martwe, dryfujące kawałki
        window.createWreckage = function (parentEntity, shards) {
          if (!shards || shards.length === 0) return;
          if (DestructorSystem?.spawnWreckEntity && parentEntity?.hexGrid) {
            try {
              return DestructorSystem.spawnWreckEntity(parentEntity, shards, null);
            } catch (err) {
              console.warn('[createWreckage] DestructorSystem.spawnWreckEntity failed, using fallback:', err);
            }
          }
    
          // 1. Oblicz środek masy nowej grupy
          let sumLx = 0, sumLy = 0;
          for (const s of shards) {
            sumLx += s.lx;
            sumLy += s.ly;
          }
          const avgLx = sumLx / shards.length;
          const avgLy = sumLy / shards.length;
    
          let sumC = 0, sumR = 0;
          for (const s of shards) {
            sumC += s.c;
            sumR += s.r;
          }
          const avgC = Math.round(sumC / shards.length);
          const avgR = Math.round(sumR / shards.length);
    
          const scale = parentEntity.visual?.spriteScale || 1.0;
          const c = Math.cos(parentEntity.angle);
          const s = Math.sin(parentEntity.angle);
    
          const worldX = parentEntity.x + (avgLx * scale * c - avgLy * scale * s);
          const worldY = parentEntity.y + (avgLx * scale * s + avgLy * scale * c);
    
          // --- PRZYGOTOWANIE CACHE DLA WRAKU (FIX) ---
          // Używamy wymiarów oryginału, aby zachować spójność koordynatów
          const srcW = parentEntity.hexGrid.srcWidth;
          const srcH = parentEntity.hexGrid.srcHeight;
          const inheritedArmorImage = parentEntity.hexGrid.armorImage || parentEntity.hexGrid.cacheCanvas || null;
          const inheritedNormalMapImage = parentEntity.hexGrid.normalMapImage || null;
          const wreck = {
            x: worldX,
            y: worldY,
            pos: { x: worldX, y: worldY },
            vx: (parentEntity.vx || parentEntity.vel?.x || 0),
            vy: (parentEntity.vy || parentEntity.vel?.y || 0),
            vel: { x: (parentEntity.vx || parentEntity.vel?.x || 0), y: (parentEntity.vy || parentEntity.vel?.y || 0) },
            angle: parentEntity.angle,
            angVel: parentEntity.angVel || 0,
            mass: shards.length * 10,
            friction: 0.998,
            dead: false,
            isWreck: true,
            isCollidable: true,
            visual: { spriteScale: scale },
    
            hexGrid: {
              shards: [],
              map: {},
              offsetX: 0,
              offsetY: 0,
              srcWidth: srcW,
              srcHeight: srcH,
              armorImage: inheritedArmorImage,
              normalMapImage: inheritedNormalMapImage,
              cacheCanvas: parentEntity.hexGrid.cacheCanvas || null,
              cacheCtx: null,
              cacheDirty: false,
              textureDirty: false,
              meshDirty: true,
              gpuTextureNeedsUpdate: false
            }
          };
    
          let maxR2 = 0;
    
          for (const shard of shards) {
            shard.lx -= avgLx;
            shard.ly -= avgLy;
            shard.origLx -= avgLx;
            shard.origLy -= avgLy;
            shard.c -= avgC;
            shard.r -= avgR;
    
            const d2 = shard.lx * shard.lx + shard.ly * shard.ly;
            if (d2 > maxR2) maxR2 = d2;
    
            wreck.hexGrid.shards.push(shard);
            wreck.hexGrid.map[shard.c + "," + shard.r] = shard;
          }
    
          wreck.radius = (Math.sqrt(maxR2) + 20) * scale;
    
          if (parentEntity.dead && parentEntity._cargoOrderId && !parentEntity._cargoWreck) {
            wreck._cargoOrderId = parentEntity._cargoOrderId;
            wreck._cargoWreckId = `cargo-wreck:${parentEntity._cargoOrderId}`;
            parentEntity._cargoWreck = wreck;
          }
    
          if (window.wrecks) {
            window.wrecks.push(wreck);
          }
    
          if (window.spawnParticle) {
            for (let i = 0; i < 3; i++) {
              window.spawnParticle({ x: worldX, y: worldY }, { x: wreck.vx, y: wreck.vy }, 1.0, '#aaaaaa', 5, false);
            }
          }
          return wreck;
        };
        // Ile myśliwców liczy pojedyncza eskadra roju i jak długo stacja przezbraja
        // się po wypuszczeniu CAŁEGO kompletu.
        const PIRATE_SWARM_SQUAD_SIZE = 7;
        const PIRATE_SWARM_RELOAD = 30;
        const isPirateFighterKind = (kind) =>
          kind === 'fighter' || kind === 'interceptor' || kind === 'fighter_squad';
    
        function spawnPirateSquad(station, type, count, mode = 'guard', opts = {}) {
          const squad = new Squad('pirate', 'fighter');
          window.SQUADS.push(squad);
    
          // Parametry orbity / pozycji
          const radius = opts.radius || (station.r + 200);
          const speed = opts.speed || 0.3;
          const startPhase = Math.random() * Math.PI * 2;
          const phaseStep = (Math.PI * 2) / count;
    
          // Parametry ataku (tylko dla mode='attack')
          let attackAngle = 0;
          let attackDir = { x: 0, y: 0 };
          if (mode === 'attack') {
            // Oblicz kąt w stronę gracza
            const dx = ship.pos.x - station.x;
            const dy = ship.pos.y - station.y;
            attackAngle = Math.atan2(dy, dx);
            attackDir = { x: Math.cos(attackAngle), y: Math.sin(attackAngle) };
          }
    
          // Sektor tej eskadry w chmarze. Przy rzucie wielu eskadr naraz każda
          // dostaje własny wycinek wachlarza i własne pasmo odległości, więc rój
          // wychodzi szerokim frontem zamiast nakładać się w jednym punkcie.
          const arcCount = Math.max(1, Number(opts.arcCount) || 1);
          const arcIndex = Math.max(0, Number(opts.arcIndex) || 0);
          const swarmFan = Math.min(2.4, 0.5 + arcCount * 0.24);
    
          for (let i = 0; i < count; i++) {
            // 1. Spawn jednostki
            const npc = spawnPirate(type, station);
    
            // 2. Pozycja startowa (dla obu trybów startują wokół stacji)
            // Dla ataku: spawnujemy ich w sektorze skierowanym do gracza, żeby nie lecieli przez stację
            let angle;
            let spawnR;
            if (mode === 'attack') {
              const sectorCenter = attackAngle + (arcIndex - (arcCount - 1) / 2) * (swarmFan / arcCount);
              angle = sectorCenter + (i - (count - 1) / 2) * 0.13;
              // Trzy pasma odległości — chmara ma głębokość, nie jest płaską ścianą.
              spawnR = station.r + 140 + (i % 3) * 340 + arcIndex * 90;
            } else {
              angle = startPhase + (i * phaseStep);   // Równomiernie dookoła (orbita)
              spawnR = radius;
            }
    
            npc.x = station.x + Math.cos(angle) * spawnR;
            npc.y = station.y + Math.sin(angle) * spawnR;
    
            // 3. Konfiguracja zachowania
            if (mode === 'guard') {
              // --- TRYB STRAŻNIKA (Orbitowanie) ---
              npc.state = 'guard';
              // Lider dostaje dane do orbitowania
              if (i === 0) {
                npc.guardStation = station;
                npc.guardOrbitRadius = radius;
                npc.guardOrbitSpeed = speed;
                npc.guardPhase = angle;
              }
              // Prędkość styczna (żeby już płynęli po orbicie)
              npc.vx = -Math.sin(angle) * radius * speed;
              npc.vy = Math.cos(angle) * radius * speed;
              npc.angle = angle + (speed > 0 ? Math.PI / 2 : -Math.PI / 2);
            }
            else {
              // --- TRYB ATAKU (Swarm / Posiłki) ---
              npc.state = 'engage_formation';
    
              // Wyczyść guardStation, żeby nie orbitowali
              npc.guardStation = null;
    
              // Boczny rozrzut w obrębie pasma, żeby sąsiedzi nie startowali
              // dokładnie na jednym promieniu.
              const lane = ((i % 2 === 0) ? 1 : -1) * Math.ceil(i / 2) * 70;
              npc.x += -Math.sin(angle) * lane;
              npc.y += Math.cos(angle) * lane;
    
              const launchSpeed = 780 + Math.random() * 220;
              npc.vx = Math.cos(angle) * launchSpeed;
              npc.vy = Math.sin(angle) * launchSpeed;
              npc.angle = angle;
              npc.desiredAngle = angle;
    
              // Wymuś szukanie celu
              npc.forceTarget = null;
              npc.target = null;
              npc.retargetTimer = 0;
            }
    
            squad.addUnit(npc);
    
            // Klin za liderem. Dawne 50/40 u odstępu to przy prędkości myśliwca
            // (~3400 u/s) 0.015 s lotu — eskadra sklejała się w jeden punkt.
            if (i > 0) {
              const row = Math.ceil(i / 2);
              const wing = (i % 2 === 1) ? -1 : 1;
              npc.formationOffset = { x: -row * 190, y: wing * row * 140 };
            } else {
              npc.formationOffset = { x: 0, y: 0 };
            }
          }
    
          return squad;
        }
        window.spawnPirateSquad = spawnPirateSquad;
        const TRAFFIC_WEIGHTS = {
          mercury: { civilian: 0.02, convoy: 0.25 },
          venus: { civilian: 0.03, convoy: 0.25 },
          earth: { civilian: 1.80, convoy: 0.50 },
          mars: { civilian: 1.60, convoy: 0.55 },
          default: { civilian: 0.40, convoy: 0.40 }
        };
    
        function trafficWeightFor(station, kind) {
          const table = TRAFFIC_WEIGHTS[station.id] || TRAFFIC_WEIGHTS.default;
          if (kind === 'convoy') return table.convoy ?? TRAFFIC_WEIGHTS.default.convoy;
          if (kind === 'civilian') return table.civilian ?? TRAFFIC_WEIGHTS.default.civilian;
          if (kind && typeof table[kind] === 'number') return table[kind];
          return table.civilian ?? TRAFFIC_WEIGHTS.default.civilian;
        }
    
        function weightedPickStation(kind, scope) {
          let pool;
          if (Array.isArray(scope)) {
            pool = scope.slice();
          } else if (scope === 'inner' || scope === 'outer') {
            const match = scope === 'inner';
            pool = stations.filter(s => s.inner === match);
          } else if (typeof scope === 'boolean') {
            pool = stations.filter(s => s.inner === scope);
          } else {
            pool = stations.slice();
          }
          if (!pool.length) return null;
          let total = 0;
          const weighted = pool.map(st => {
            const w = Math.max(0, trafficWeightFor(st, kind));
            total += w;
            return { st, w };
          });
          if (total <= 0) {
            return pool[Math.floor(Math.random() * pool.length)];
          }
          let r = Math.random() * total;
          for (const { st, w } of weighted) {
            r -= w;
            if (r <= 0) return st;
          }
          return weighted[weighted.length - 1].st;
        }
    
        function preferEarthMarsRoute(stationId) {
          return (stationId === 'earth' || stationId === 'mars') && Math.random() < 0.7;
        }
    
        function pickNextStation(startStationId, type) {
          const start = stations.find(s => s.id === startStationId) || stations[0];
          if (!start) return startStationId;
          if (preferEarthMarsRoute(start.id)) {
            return start.id === 'earth' ? 'mars' : 'earth';
          }
          const isCivil = type && (type.startsWith('civilian') || type.startsWith('freighter'));
          const sameSphere = stations.filter(s => s.inner === start.inner && s.id !== start.id);
          const otherSphere = stations.filter(s => s.inner !== start.inner);
          let pool = sameSphere.length ? sameSphere : stations.filter(s => s.id !== start.id);
          if (isCivil && otherSphere.length && Math.random() < 0.35) {
            pool = otherSphere;
          }
          let target = weightedPickStation(isCivil ? 'civilian' : null, pool);
          if (!target || target.id === start.id) {
