            : [];
          const hardpoints = (getEntityHardpoints(target) || []).map((hp) => {
            const local = getEntityHardpointLocalPos(target, hp) || { x: 0, y: 0 };
            return { x: local.x, y: local.y, destroyed: !!hp?.destroyed };
          });
          const cores = (getEntityCores(target) || []).map((core) => {
            const local = getEntityCoreLocalPos(target, core) || { x: 0, y: 0 };
            return { x: local.x, y: local.y, destroyed: !!core?.destroyed };
          });
          return {
            width: (Number(grid?.srcWidth) || Math.max(120, (Number(target?.radius) || 40) * 3)) * hpScale.x,
            height: (Number(grid?.srcHeight) || Math.max(80, (Number(target?.radius) || 40) * 2)) * hpScale.y,
            shards,
            hardpoints,
            cores
