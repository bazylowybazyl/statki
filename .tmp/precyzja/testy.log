        function autoMountDefaults() {
          mountFirstFree(HP.MAIN, 'railgun_mk2', 24);
          mountFirstFree(HP.MISSILE, 'missile_rack', 8);
          // Aux dzielony: sześć CIWS-ów robi za stały strumień, dwie baterie flaku
          // "Perun" domykają obronę zaporą, która czyści całe nadlatujące eskadry.
          mountFirstFree(HP.AUX, 'ciws_mk1', 6);
