        const __carrierSpawnQueue = [];
        const CARRIER_LAUNCH_RANGE = 9000;
        const CARRIER_FIGHTERS_PER_BAY = 4;
        const CARRIER_MAX_BAYS = 5;      // nie startuj z więcej niż 5 bay (balans/perf)
        const CARRIER_LAUNCH_BATCH = 4;  // ile myśliwców na jeden cykl startu
    
        // Wyrzutnie nosiciela NPC — te same hardpointy 'hangar', z których liczyliśmy
        // bay. Wcześniej pozycja startu była losowana wokół dziobu (angle ±0.6 rad,
        // r+50), więc myśliwce wysypywały się chmarą w jednym punkcie zamiast
        // wychodzić burtami.
        function carrierHangarTubes(npc) {
          const hps = npc.editorHardpoints;
          if (!Array.isArray(hps)) return [];
          const entries = [];
          for (let i = 0; i < hps.length; i++) {
            const hp = hps[i];
            if (hp && hp.type === 'hangar' && !hp.destroyed) entries.push({ hp, squadron: true });
          }
          return collectHangarTubes(npc, entries);
        }
    
        function carrierHangarBayCount(npc) {
          const hps = npc.editorHardpoints;
          if (!Array.isArray(hps)) return 0;
          let bays = 0;
          for (let i = 0; i < hps.length; i++) {
            const hp = hps[i];
