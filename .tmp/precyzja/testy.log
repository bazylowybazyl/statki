            npc.weapons[hp.type].push({ hp: hp, weapon: MASTER_WEAPONS[weaponId] });
          }
        }
    
        // Wylot strzału NPC — obiekty wielokrotnego użytku (dawniej 3–4 obiekty na
        // strzał). fireWeaponCore czyta je synchronicznie i niczego nie zatrzymuje:
        // pociski i rakiety 3D kopiują liczby, wiązki kopiują do własnych buforów.
        const _adapterMuzzlePos = { x: 0, y: 0 };
        const _adapterMuzzleDir = { x: 1, y: 0 };
        const _adapterBaseVel = { x: 0, y: 0 };
        const _adapterMuzzle = { pos: _adapterMuzzlePos, dir: _adapterMuzzleDir, baseVel: _adapterBaseVel, emitterUid: null, pdTarget: null };
    
        // Pomocniczy Wrapper dla AI (TERAZ OBSŁUGUJE HARDPOINTY NPC!)
        window.spawnBulletAdapter = function (owner, target, weaponDef, opts = {}) {
          const muzzlePos = _adapterMuzzlePos;
          const muzzleDir = _adapterMuzzleDir;
          muzzlePos.x = owner.x;
          muzzlePos.y = owner.y;
          muzzleDir.x = Math.cos(owner.angle || 0);
          muzzleDir.y = Math.sin(owner.angle || 0);
    
          // Odczyt koordynatów lufy prosto z edytora!
          if (opts.hp && opts.hp.x !== undefined) {
            const angle = (owner.angle || 0) + (Number(owner.capitalProfile?.spriteRotation) || 0);
            const c = Math.cos(angle);
            const s = Math.sin(angle);
            const hpX = opts.hp.x * getEntityHardpointScaleX(owner);
            const hpY = opts.hp.y * getEntityHardpointScaleY(owner);
            muzzlePos.x = owner.x + (hpX * c - hpY * s);
            muzzlePos.y = owner.y + (hpX * s + hpY * c);
          } else if (opts.origin) {
            muzzlePos.x = opts.origin.x;
            muzzlePos.y = opts.origin.y;
          }
    
          const muzzle = _adapterMuzzle;
          if (opts.originVel) {
            muzzle.baseVel = opts.originVel;
          } else {
            _adapterBaseVel.x = owner.vx || 0;
            _adapterBaseVel.y = owner.vy || 0;
            muzzle.baseVel = _adapterBaseVel;
          }
          muzzle.emitterUid = opts.hp?.id != null ? getNpcEmitterUid(owner, opts.hp) : null;
          // PD: cel wybrany przez AI (processAutonomousWeapons) — wiązka testuje
          // tylko jego, bez skanu świata (fireWeaponCore → resolvePdBeamHit).
          muzzle.pdTarget = opts.pdTarget || null;
          window.fireWeaponCore(owner, target, weaponDef.id, muzzle);
          muzzle.pdTarget = null;
          muzzle.baseVel = _adapterBaseVel;
        };
    
        // Uid emitera (wiązka ciągła trzyma się po nim swojej lufy). Liczony raz na
