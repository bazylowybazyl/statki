            timer: 0,
            duration: 1.1,
            dir: { x: 0, y: 0 },
            startSpeed: 0,
            sourceId: null
          },
          isBusy() { return this.state !== 'idle'; }
        };
        publishGameState({ warp });
        // WAŻNE: Upubliczniamy warp, żeby planet3d.assets.js (gwiazdy) go widziały!
        window.warp = warp;
        setWarpGear(1, true);
    
        function exitWarp() {
          spawnShockwave(ship.pos.x, ship.pos.y, { maxR: 1200, maxLife: 0.7 });
          camera.addShake(18, 0.22);
    
          warp.entryProgress = 0;
    
          // TO JEST NAJWAŻNIEJSZE:
          // Ustawiamy timer na czas trwania efektu hamowania (np. 0.8 sekundy)
          warpBrakeTimer = 0.8;
    
          // Zachowujemy ostatni kierunek warpa, aby efekt hamowania wiedział, w którą stronę rysować kreski
          // (Jeśli warp.dir się zeruje gdzieś indziej, to tu go "zamrażamy" dla efektu)
          if (!warp.lastDir) warp.lastDir = { x: warp.dir.x, y: warp.dir.y };
          warp.lastDir.x = warp.dir.x;
          warp.lastDir.y = warp.dir.y;
        }
    
        // === DEV: TELEPORT =========================================================
        // Skok bez warpa. Poza samą pozycją trzeba wyzerować stan, który zakłada
        // ciągłość ruchu: prevState (interpolacja renderu — inaczej statek "rozmaże
        // się" przez pół układu w jednej klatce), przejście kamery i rozkaz RTS,
        // który natychmiast zawróciłby autopilota do starego celu.
        function devTeleportTo(x, y, opts = {}) {
          if (!ship?.pos || !Number.isFinite(x) || !Number.isFinite(y)) return false;
    
          if (warp.state !== 'idle') {
            warp.state = 'idle';
            warp.charge = 0;
            warp.entryProgress = 0;
          }
          warp.gravityBrake.active = false;
          warp.gravityBrake.timer = 0;
          warpBrakeTimer = 0;
    
          ship.pos.x = x;
          ship.pos.y = y;
          ship.vel.x = 0;
          ship.vel.y = 0;
          ship.angVel = 0;
          if (Number.isFinite(opts.angle)) ship.angle = opts.angle;
          ship.command = null;
    
          // Snap interpolacji renderu do nowej pozycji.
          if (prevState) {
            prevState.pos.x = x;
            prevState.pos.y = y;
            prevState.angle = ship.angle;
          }
    
          camera.transition = null;
          camera.x = x;
          camera.y = y;
          if (Number.isFinite(opts.zoom)) camera.zoom = clamp(opts.zoom, camera.minZoom, camera.maxZoom);
    
          if (typeof spawnShockwave === 'function') {
            spawnShockwave(x, y, { maxR: 1400, maxLife: 0.6, color: 'rgba(120, 200, 255,' });
          }
          camera.addShake(10, 0.25);
          return true;
        }
