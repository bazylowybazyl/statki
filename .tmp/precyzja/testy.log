          const shield = entity?.shield;
          if (shield && typeof shield.val === 'number' && typeof shield.max === 'number') {
            return `${Math.max(0, Math.round(shield.val))}/${Math.max(0, Math.round(shield.max))}`;
          }
          return 'Brak';
        }
    
        function formatWeaponName(weapon) {
          if (!weapon) return 'Brak';
          if (typeof weapon === 'string') return toTitleCaseFromKey(weapon);
          if (weapon.name) return toTitleCaseFromKey(weapon.name);
          return 'Brak';
        }
    
        function hideHoverInfo() {
          const { el, content } = hoverInfoState;
          if (!el) return;
          if (content) content.innerHTML = '';
          if (!el.classList.contains('hidden')) el.classList.add('hidden');
          hoverInfoState.type = null;
          hoverInfoState.target = null;
        }
    
        function updateHoverInfo(target, type) {
          const { el, title, subtitle, content } = hoverInfoState;
          if (!el) return;
          if (!target || !type) {
            hideHoverInfo();
            return;
          }
          hoverInfoState.type = type;
          hoverInfoState.target = target;
          el.classList.remove('hidden');
          if (content) content.innerHTML = '';
    
          if (type === 'station') {
            if (title) title.textContent = target.name || (target.id ? `Stacja ${String(target.id).toUpperCase()}` : 'Stacja');
            if (subtitle) subtitle.textContent = 'STACJA ORBITALNA';
            if (content) {
              const section = document.createElement('div');
              section.className = 'hover-section';
              section.textContent = 'Zakładki';
              content.appendChild(section);
    
              const tags = document.createElement('div');
              tags.className = 'hover-tags';
              for (const tab of availableStationTabs(target)) {
                const span = document.createElement('span');
                span.className = 'hover-tag';
                span.textContent = tab;
                tags.appendChild(span);
              }
              content.appendChild(tags);
            }
          } else if (type === 'npc') {
            if (title) title.textContent = formatNpcName(target);
            if (subtitle) subtitle.textContent = target.friendly ? 'SOJUSZNIK' : 'CELE NPC';
            if (content) {
              const lines = [
                { label: 'HP', value: `${Math.max(0, Math.round(target.hp ?? 0))}/${Math.max(0, Math.round(target.maxHp ?? target.hp ?? 0))}` },
                { label: 'Tarcza', value: formatShieldValue(target) },
                { label: 'Broń', value: formatWeaponName(target.weapon) }
              ];
              for (const line of lines) {
                const row = document.createElement('div');
                row.className = 'hover-line';
                const strong = document.createElement('strong');
                strong.textContent = `${line.label}:`;
                const span = document.createElement('span');
                span.textContent = line.value;
                row.appendChild(strong);
                row.appendChild(span);
                content.appendChild(row);
              }
            }
          } else if (type === 'platform') {
            if (title) title.textContent = target.label || 'Platforma obronna';
            if (subtitle) subtitle.textContent = 'PIRACKA OBRONA';
            if (content) {
              const lines = [];
              if (target.shield) {
                lines.push({ label: 'Osłony', value: `${Math.max(0, Math.round(target.shield.val))}/${target.shield.max}` });
              }
              lines.push({ label: 'Kadłub', value: `${Math.max(0, Math.round(target.hp ?? 0))}/${Math.max(0, Math.round(target.maxHp ?? target.hp ?? 0))}` });
              lines.push({ label: 'Orbita', value: formatLocalDistance(target.orbitRadius) });
              for (const line of lines) {
                const row = document.createElement('div');
                row.className = 'hover-line';
                const strong = document.createElement('strong');
                strong.textContent = `${line.label}:`;
                const span = document.createElement('span');
                span.textContent = line.value;
                row.appendChild(strong);
                row.appendChild(span);
                content.appendChild(row);
              }
            }
          } else if (type === 'wreck') {
            const info = describeSalvage(target);
            if (title) title.textContent = info?.label ? `Wrak: ${info.label}` : 'Wrak';
            // Zimny = „tło” pola wraków; holowanie albo cięcie go wybudza.
            if (subtitle) subtitle.textContent = target.isCold ? 'ODZYSK MOŻLIWY · ZIMNY' : 'ODZYSK MOŻLIWY';
            if (content) {
              if (!info || (!info.materials.length && !info.weaponCount)) {
                const row = document.createElement('div');
                row.className = 'hover-line';
                row.textContent = 'Rozebrany do gołej konstrukcji.';
                content.appendChild(row);
              } else {
                for (const material of info.materials) {
                  const row = document.createElement('div');
                  row.className = 'hover-line';
                  const strong = document.createElement('strong');
                  strong.textContent = `${material.label}:`;
                  const span = document.createElement('span');
                  span.textContent = `${material.amount}`;
                  row.appendChild(strong);
                  row.appendChild(span);
                  content.appendChild(row);
                }
                // Broń wychodzi tylko przez dok — mówimy o tym wprost, bo inaczej
                // gracz przetnie wrak z działami i nie zrozumie, czemu ich nie ma.
                const note = document.createElement('div');
                note.className = 'hover-line hover-salvage-note';
                note.textContent = info.weaponCount
                  ? `Uzbrojenie: ${info.weaponCount} szt. — tylko przez holowanie do doku`
                  : 'Bez sprawnego uzbrojenia';
                content.appendChild(note);
              }
            }
          }
        }
    
        window.addEventListener('keydown', (e) => {
          if (stationUI.open) {
            if (e.code === 'Escape') { closeStationUI(); e.stopImmediatePropagation(); return; }
            const tabMatch = STATION_TERMINAL_TABS.find(tab => e.code === `Digit${tab.key}`);
            if (tabMatch) stationUI.tab = tabMatch.id;
          }
        });
    
        window.addEventListener('keydown', (e) => {
          if (e.code === 'KeyO' && !stationUI.open) { OPTIONS_OPEN = !OPTIONS_OPEN; }
        });
    
        function renderStationUI() {
          const alpha = clamp(stationUI.appear, 0, 1);
    
          const shouldShow = stationUI.open && stationUI.visible && !stationUI.awaitingCamera && alpha > 0.001;
          const showInfrastructure = shouldShow && stationUI.tab === 'infrastructure';
    
          InfrastructureUI.setVisible(showInfrastructure);
    
          const topDock = document.getElementById('hud-top-dock');
          if (topDock) {
            topDock.classList.toggle('expanded', shouldShow);
          }
    
          if (shouldShow) {
            renderStationOverlay(stationUI.tab, stationUI.station);
          }
        }
    
    
        // ============== INFRASTRUCTURE UI (moved to src/ui/infrastructureUI.js) ==============
    
    
        function initMechanicUI() {
          // Ta funkcja jest teraz uproszczona, ponieważ logika została przeniesiona 
          // bezpośrednio do buildMechanicPanel w głównym oknie stacji.
          // Zachowujemy ją tylko dla kompatybilności, jeśli coś ją wywołuje.
        }
    
        const HP_GROUP_META = {
          [HP.MAIN]: { title: 'Broń główna', css: 'hp-main' },
          [HP.MISSILE]: { title: 'Rakiety', css: 'hp-miss' },
          [HP.AUX]: { title: 'Broń dodatkowa', css: 'hp-aux' },
          [HP.HANGAR]: { title: 'Hangary', css: 'hp-hangar' },
          [HP.SPECIAL]: { title: 'Broń specjalna', css: 'hp-spec' },
          [HP.SPECIAL_MISSILE]: { title: 'Rakieta specjalna', css: 'hp-spec' },
          [HP.BUILTIN]: { title: 'Built-In', css: 'hp-spec' },
        };
        let mechanicWeaponFilter = 'all';
        let mechanicHardpointFilter = 'all';
        let mechanicBatchMode = '1';
        let mechanicDragWeaponId = null;
        const MECHANIC_DEV_WEAPON_STOCK = 99;
    
        function isMechanicDevMode() {
          try {
            return new URLSearchParams(window.location.search).has('dev');
          } catch {
            return false;
          }
        }
    
        function fillMechanicWeapons() {
          // Podwójna blokada: przycisku nie ma poza ?dev, a wywołanie funkcji
          // z konsoli także nie zmieni stanu zwykłej rozgrywki.
          if (!isMechanicDevMode() || !Game.player) return 0;
          const inventory = createWeaponInventory(Game.player.inventory);
          Game.player.inventory = inventory;
          const changed = fillWeaponInventory(
            inventory,
            Object.values(MASTER_WEAPONS),
            MECHANIC_DEV_WEAPON_STOCK
          );
          mechanicWeaponFilter = 'all';
          renderMechanic();
          toast(`DEV: wszystkie bronie w magazynie (×${MECHANIC_DEV_WEAPON_STOCK})`);
          return changed;
        }
    
        function weaponMetaText(weapon) {
          if (!weapon) return '';
          const parts = [];
          if (weapon.baseDamage != null) parts.push(`${weapon.baseDamage} dmg`);
          if (weapon.cooldown != null) parts.push(`${weapon.cooldown}s cd`);
          if (weapon.baseRange != null) parts.push(`zas. ${weapon.baseRange}`);
          if (weapon.ammo != null) parts.push(`${weapon.ammo} ammo`);
          if (weapon.energyCost != null) parts.push(`${weapon.energyCost} e`);
          return parts.join(' | ');
        }
    
        function mechanicCompactWeaponStats(weapon) {
          if (!weapon) return '';
          if (weapon.mountType === HP.HANGAR && weapon.squadronId) {
            const squadron = getFighterSquadronDef(weapon.squadronId);
            return `${squadron.squadSize} fighters / v${squadron.maxSpeed} / turn ${squadron.turn}`;
          }
          const parts = [];
          if (weapon.baseDamage != null) parts.push(`${weapon.baseDamage}dmg`);
          if (weapon.cooldown != null) parts.push(`${weapon.cooldown}s`);
          if (weapon.ammo != null) parts.push(`${weapon.ammo} ammo`);
          return parts.length ? parts.join(' / ') : weaponMetaText(weapon);
        }
    
        function mechanicHardpointGlyph(hp) {
          switch (hp?.type) {
            case HP.MAIN: return 'MN';
            case HP.MISSILE: return 'MS';
            case HP.AUX: return 'AX';
            case HP.HANGAR: return 'HG';
            case HP.SPECIAL: return 'SP';
            case HP.SPECIAL_MISSILE: return 'SM';
            case HP.BUILTIN: return 'BI';
            default: return 'HP';
          }
        }
    
        function addHangarSquadronToHardpoint(hp, weaponId) {
          if (!hp || hp.destroyed) return false;
          const weapon = weaponId ? WEAPONS[weaponId] : null;
          if (!isHangarSquadronWeapon(weapon) || !canMountWeaponOnHardpoint(weapon, hp)) return false;
          const current = getHardpointHangarSquadrons(hp);
          const next = addHangarSquadronMount(current, weaponId, getHardpointHangarCapacity(hp));
          if (next.length === current.length) return false;
          setHardpointHangarSquadrons(hp, next);
          return true;
        }
    
        function applyWeaponToHardpoint(hp, weaponId, options = null) {
          if (!hp) return false;
          if (hp.destroyed) return false;
          const weapon = weaponId ? WEAPONS[weaponId] : null;
          // Size/type gate — a weapon may only sit in a hardpoint of equal or larger size.
          if (weapon && !options?.force && !canMountWeaponOnHardpoint(weapon, hp)) return false;
          if (hp.type === HP.HANGAR) {
            if (!weaponId) {
              setHardpointMount(hp, null);
            } else if (!addHangarSquadronToHardpoint(hp, weaponId)) {
              return false;
            }
            if (options?.deferFinalize) return true;
            syncWeaponSystems();
            renderMechanic();
            saveLoadout();
            return true;
          }
          setHardpointMount(hp, weaponId);
          if (weapon && weapon.ammo != null) {
            hp.ammo = weapon.ammo;
            hp.maxAmmo = weapon.ammo;
          }
          if (options?.deferFinalize) return true;
          syncWeaponSystems();
          renderMechanic();
          saveLoadout();
          return true;
        }
    
        function applyWeaponBatchToHardpoints(startHp, weaponId) {
          if (!startHp || !weaponId) return;
          if (startHp.destroyed) return;
          const weapon = WEAPONS[weaponId];
          if (!weapon || weapon.mountType !== startHp.type) return;
          if (!canMountWeaponOnHardpoint(weapon, startHp)) {
            toast(`${weapon.name} (${weapon.size}) nie mieści się w slocie ${getHardpointSize(startHp)}`);
            return;
          }
          const typeHardpoints = Game.player.hardpoints.filter(h => h.type === startHp.type && !h.destroyed);
          const startIdx = typeHardpoints.indexOf(startHp);
          if (startIdx < 0) return;
    
          if (mechanicBatchMode === '1') {
            applyWeaponToHardpoint(startHp, weaponId);
            return;
          }
    
          let extraSlots = 0;
          if (mechanicBatchMode === 'all') {
            extraSlots = Number.MAX_SAFE_INTEGER;
          } else {
            const parsed = Number(mechanicBatchMode);
            extraSlots = Number.isFinite(parsed) ? Math.max(0, parsed | 0) : 0;
          }
    
          applyWeaponToHardpoint(startHp, weaponId, { deferFinalize: true });
          let assignedExtra = 0;
          for (let i = startIdx + 1; i < typeHardpoints.length; i++) {
            if (assignedExtra >= extraSlots) break;
            // Only counts when the weapon actually fits this slot's size.
            if (applyWeaponToHardpoint(typeHardpoints[i], weaponId, { deferFinalize: true })) assignedExtra++;
          }
    
          syncWeaponSystems();
          renderMechanic();
          saveLoadout();
        }
    
        function attachSlotDnD(slot, hp) {
          slot.addEventListener('dragover', (e) => {
            if (hp?.destroyed) return;
            const weaponId = mechanicDragWeaponId || e.dataTransfer?.getData('text/plain');
            const weapon = weaponId ? WEAPONS[weaponId] : null;
            // Type + size gate — incompatible slots won't accept the drop.
            if (!canAcceptWeaponOnHardpoint(weapon, hp)) {
              if (weapon && weapon.mountType === hp.type) slot.classList.add('size-reject');
              return;
            }
            e.preventDefault();
            slot.classList.add('drag-over');
          });
          slot.addEventListener('dragleave', () => { slot.classList.remove('drag-over'); slot.classList.remove('size-reject'); });
          slot.addEventListener('drop', (e) => {
            if (hp?.destroyed) return;
            const weaponId = e.dataTransfer?.getData('text/plain') || mechanicDragWeaponId;
            const weapon = weaponId ? WEAPONS[weaponId] : null;
            slot.classList.remove('drag-over');
            slot.classList.remove('size-reject');
            if (!weapon || weapon.mountType !== hp.type) return;
            e.preventDefault();
            applyWeaponBatchToHardpoints(hp, weapon.id);
          });
        }
    
        function quickMountWeapon(weapon) {
          if (!weapon) return;
          // First free slot whose type AND size accept this weapon.
          const targetHp = Game.player.hardpoints.find(h => {
            if (!canAcceptWeaponOnHardpoint(weapon, h)) return false;
            return h.type === HP.HANGAR ? true : !h.mount;
          });
          if (targetHp) {
            applyWeaponToHardpoint(targetHp, weapon.id);
          } else {
            toast(`Brak wolnego slotu ${weapon.size}+ dla: ${weapon.name}`);
          }
        }
    
        function createWeaponRow(weapon) {
          const row = document.createElement('div');
          row.className = 'weapon-row'; // Nowa klasa CSS
          row.draggable = true;
          row.dataset.weaponId = weapon.id;
          row.dataset.weaponType = weapon.type;
    
          // 1. Mała ikona
          const iconWrap = document.createElement('div');
          const iconPath = WEAPON_ICON_PATHS[weapon.id];
          if (iconPath) {
            iconWrap.className = 'weapon-row-icon';
            const img = document.createElement('img');
            img.src = iconPath;
            iconWrap.appendChild(img);
          } else {
            iconWrap.className = 'weapon-row-icon placeholder';
            iconWrap.textContent = 'IMG';
          }
          row.appendChild(iconWrap);
    
          // 1b. Plakietka rozmiaru (S/M/L/C)
          const sizeBadge = document.createElement('div');
          const wSize = weapon.size || 'M';
          sizeBadge.className = 'weapon-size-badge size-' + wSize;
          sizeBadge.textContent = WEAPON_SIZE_LABEL[wSize] || wSize;
          sizeBadge.title = `Rozmiar broni: ${wSize}`;
          row.appendChild(sizeBadge);
    
          // 2. Nazwa + liczba sztuk w ładowni
          const nameEl = document.createElement('div');
          nameEl.className = 'weapon-row-name';
          nameEl.textContent = weapon.name;
          const stock = Game.player?.inventory?.count?.(weapon.id) ?? 0;
          if (stock > 0) {
            const countEl = document.createElement('span');
            countEl.className = 'weapon-row-count';
            countEl.textContent = `×${stock}`;
            countEl.title = `Sztuk w ładowni: ${stock}`;
            nameEl.appendChild(countEl);
          }
          row.appendChild(nameEl);
    
          // 3. Statystyki (Dmg/Cd) - kompatybilne z nowym słownikiem
          const metaEl = document.createElement('div');
          metaEl.className = 'weapon-row-meta';
          metaEl.textContent = mechanicCompactWeaponStats(weapon);
          row.appendChild(metaEl);
    
          // Obsługa przeciągania (Drag & Drop)
          row.addEventListener('dragstart', (e) => {
            mechanicDragWeaponId = weapon.id;
            row.classList.add('dragging');
            if (e.dataTransfer) {
              e.dataTransfer.setData('text/plain', weapon.id);
              e.dataTransfer.effectAllowed = 'copy';
            }
          });
          row.addEventListener('dragend', () => {
            mechanicDragWeaponId = null;
            row.classList.remove('dragging');
          });
          row.addEventListener('dblclick', () => quickMountWeapon(weapon));
    
          return row;
        }
    
        function setMechanicFilterActive(containerId, value) {
          const container = document.getElementById(containerId);
          if (!container) return;
          container.querySelectorAll('button[data-filter]').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.filter === value);
          });
        }
    
        function initMechanicFilter(containerId, getValue, setValue) {
          const container = document.getElementById(containerId);
          if (!container) return;
          container.querySelectorAll('button[data-filter]').forEach(btn => {
            btn.addEventListener('click', () => {
              const val = btn.dataset.filter;
              if (!val) return;
              setValue(val);
              renderMechanic();
            });
          });
          setMechanicFilterActive(containerId, getValue());
        }
    
        function setMechanicBatchActive(value) {
          const container = document.getElementById('hp-batch-tabs');
          if (!container) return;
          container.querySelectorAll('button[data-batch]').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.batch === value);
          });
        }
    
        function initMechanicBatchControls() {
          const container = document.getElementById('hp-batch-tabs');
          if (!container) return;
          container.querySelectorAll('button[data-batch]').forEach(btn => {
            btn.addEventListener('click', () => {
              const val = btn.dataset.batch;
              if (!val) return;
              mechanicBatchMode = val;
              setMechanicBatchActive(mechanicBatchMode);
            });
          });
          setMechanicBatchActive(mechanicBatchMode);
        }
    
        function renderAvailableWeapons(root) {
          if (!root) return;
          root.innerHTML = '';
          // Zakładka „Chipy” zajmuje lewą kartę zamiast magazynu broni.
          if (mechanicWeaponFilter === 'chips') {
            renderMechanicChips(root);
            return;
          }
          const inventory = Game.player?.inventory || new Set();
          const filter = mechanicWeaponFilter;
          const weapons = [...inventory]
            .map(id => WEAPONS[id])
            .filter(Boolean)
            // ZMIANA Z type NA mountType:
            .filter(w => filter === 'all' || w.mountType === filter || (filter === 'special' && w.mountType === 'special_missile'));
    
          // Sortowanie i grupowanie (BEZPIECZNIE)
          const grouped = {};
          for (const t of Object.values(HP)) grouped[t] = [];
    
          for (const w of weapons) {
            // Zabezpieczenie: jeśli broń nie ma zdefiniowanego mountType lub uderza w nieistniejącą grupę, pomiń
            const typeKey = w.mountType;
            if (grouped[typeKey]) {
              grouped[typeKey].push(w);
            }
          }
    
          for (const type of Object.values(HP)) {
            if (!grouped[type] || !grouped[type].length) continue;
    
            // Naglowek grupy (np. "MAIN") - jako prosty tekst
            const header = document.createElement('div');
            header.className = 'list-group-header';
            const meta = HP_GROUP_META[type];
            header.textContent = meta ? meta.title : type.toUpperCase();
            root.appendChild(header);
    
            // Sortowanie alfabetyczne (z ochrona przed brakujacymi nazwami)
            grouped[type].sort((a, b) => (a?.name || '').localeCompare(b?.name || ''));
    
            // Generowanie wierszy
            for (const weapon of grouped[type]) {
              root.appendChild(createWeaponRow(weapon));
            }
          }
    
          if (weapons.length === 0) {
            const empty = document.createElement('div');
            empty.style.padding = '10px';
            empty.style.color = '#777';
            empty.textContent = filter === 'all' ? 'Pusty magazyn.' : 'Brak broni w wybranej kategorii.';
            root.appendChild(empty);
          }
        }
    
        // Nagłówek lewej karty warsztatu: magazyn broni albo chipy.
        const MECHANIC_LEFT_CARD_TEXT = {
          weapons: {
            title: 'Magazyn broni',
            badge: 'Loadout',
            desc: 'Przeciagnij bron na slot po prawej stronie.'
          },
          chips: {
            title: 'Chipy',
            badge: 'Kadłub',
            desc: 'Chip działa na kadłubie, na którym go zainstalujesz. Bez PD CHIP obrona punktowa '
              + '(CIWS, laser PD, flak) strzela tylko do rakiet, torped i myśliwców — w kadłuby nie celuje.'
          }
        };
    
        function syncMechanicLeftCardHeader() {
          const text = mechanicWeaponFilter === 'chips' ? MECHANIC_LEFT_CARD_TEXT.chips : MECHANIC_LEFT_CARD_TEXT.weapons;
          const title = document.getElementById('mechanic-left-title');
          if (title && title.textContent !== text.title) title.textContent = text.title;
          const badge = document.getElementById('mechanic-left-badge');
          if (badge && badge.textContent !== text.badge) badge.textContent = text.badge;
          const desc = document.getElementById('mechanic-left-desc');
          if (desc && desc.textContent !== text.desc) desc.textContent = text.desc;
        }
    
        // Zakładka „Chipy”: katalog (src/data/chips.js) dla AKTYWNEGO kadłuba — chip
        // jest per kadłub, jak loadout. Instalacja kosztuje CR (z ?dev za darmo),
        // zdjęcie zwraca 50% ceny (CHIP_REMOVE_REFUND); w ?dev zdjęcie nic nie zwraca,
        // żeby darmowa instalacja nie drukowała kredytów.
        function renderMechanicChips(root) {
          const hullId = PLAYER.activeHullId;
          const hullName = getPlayerHullDef(hullId)?.name || hullId;
          const devFree = isMechanicDevMode();
    
          const header = document.createElement('div');
          header.className = 'list-group-header';
          header.textContent = `Kadłub: ${hullName}`;
          root.appendChild(header);
    
          for (const chipId of CHIP_ORDER) {
            const def = CHIPS[chipId];
            if (!def) continue;
            const installed = hullHasChip(PLAYER.hullChips, hullId, chipId);
            const row = document.createElement('div');
            row.className = installed ? 'mechanic-chip-row installed' : 'mechanic-chip-row';
            row.dataset.chipId = chipId;
    
            const head = document.createElement('div');
            head.className = 'mechanic-chip-head';
            const name = document.createElement('span');
            name.className = 'weapon-row-name';
            name.textContent = def.name;
            const status = document.createElement('span');
            status.className = installed ? 'mechanic-chip-status installed' : 'mechanic-chip-status';
            status.textContent = installed ? 'Zainstalowany' : 'Dostępny';
            head.append(name, status);
    
            const desc = document.createElement('div');
            desc.className = 'card-desc';
            desc.textContent = def.desc;
    
            const actions = document.createElement('div');
            actions.className = 'card-actions';
            const price = document.createElement('span');
            price.className = 'card-price';
            price.textContent = devFree ? `${def.cost} CR (DEV: 0)` : `${def.cost} CR`;
            const btn = document.createElement('button');
            btn.type = 'button';
            if (installed) {
              const refund = chipRemovalRefund(def, { freeInstall: devFree });
              btn.dataset.chipAction = 'remove';
              btn.textContent = refund > 0 ? `Zdejmij (+${refund} CR)` : 'Zdejmij';
              btn.addEventListener('click', () => removeMechanicChip(chipId));
            } else {
              const cost = devFree ? 0 : (Number(def.cost) || 0);
              btn.dataset.chipAction = 'install';
              btn.dataset.cost = String(cost);
              btn.textContent = 'Zainstaluj';
              btn.disabled = PLAYER.credits < cost;
              btn.addEventListener('click', () => installMechanicChip(chipId));
            }
            actions.append(price, btn);
            row.append(head, desc, actions);
            root.appendChild(row);
          }
        }
    
        function installMechanicChip(chipId) {
          const def = CHIPS[chipId];
          const hullId = PLAYER.activeHullId;
          if (!def || hullHasChip(PLAYER.hullChips, hullId, chipId)) return false;
          const cost = isMechanicDevMode() ? 0 : (Number(def.cost) || 0);
          if (PLAYER.credits < cost) {
            toast('Za mało kredytów');
            return false;
          }
          PLAYER.credits -= cost;
          installHullChip(PLAYER.hullChips, hullId, chipId);
          saveLoadout();
          toast(`Zainstalowano: ${def.name}`);
          renderMechanic();
          updateStationOverlay(stationUI.tab, stationUI.station);
          return true;
        }
    
        function removeMechanicChip(chipId) {
          const def = CHIPS[chipId];
          const hullId = PLAYER.activeHullId;
          if (!def || !removeHullChip(PLAYER.hullChips, hullId, chipId)) return false;
          const refund = chipRemovalRefund(def, { freeInstall: isMechanicDevMode() });
          PLAYER.credits += refund;
          saveLoadout();
          toast(refund > 0 ? `Zdjęto: ${def.name} (+${refund} CR)` : `Zdjęto: ${def.name}`);
          renderMechanic();
          updateStationOverlay(stationUI.tab, stationUI.station);
          return true;
        }
    
        function mechanicHangarMountNames(hp) {
          return getHardpointHangarSquadrons(hp)
            .map(id => WEAPONS[id]?.name)
            .filter(Boolean);
        }
    
        function mechanicHangarMetaText(hp) {
          const mounts = getHardpointHangarSquadrons(hp);
          const capacity = getHardpointHangarCapacity(hp);
          let fighters = 0;
          for (const mountId of mounts) {
            const squadron = getFighterSquadronDef(WEAPONS[mountId]?.squadronId);
            fighters += Number(squadron.squadSize) || 0;
          }
          return `${mounts.length}/${capacity} esk. | ${fighters} fighters`;
        }
    
        function createHpRow(hp, idx) {
          const row = document.createElement('div');
          row.className = 'hp-row'; // Nowa klasa CSS
          row.dataset.hpId = hp.id;
          row.dataset.hpType = hp.type;
          if (hp.destroyed) row.classList.add('destroyed');
    
          // 1. Ikona zamontowanej broni (lub puste miejsce)
          const hangarMounts = hp.type === HP.HANGAR ? getHardpointHangarSquadrons(hp) : [];
          const weapon = hp.mount ? WEAPONS[hp.mount] : (hangarMounts[0] ? WEAPONS[hangarMounts[0]] : null);
          const iconWrap = document.createElement('div');
          const iconPath = weapon ? WEAPON_ICON_PATHS[weapon.id] : null;
    
          if (iconPath) {
            iconWrap.className = 'weapon-row-icon';
            iconWrap.innerHTML = `<img src="${iconPath}">`;
          } else {
            iconWrap.className = 'weapon-row-icon hardpoint-glyph';
            iconWrap.textContent = mechanicHardpointGlyph(hp);
            iconWrap.title = weapon ? `Brak ikony: ${weapon.name}` : `Pusty hardpoint: ${hp.type}`;
          }
          row.appendChild(iconWrap);
    
          // 1b. Plakietka rozmiaru slotu (S/M/L/C)
          const hpSize = getHardpointSize(hp);
          const slotBadge = document.createElement('div');
          slotBadge.className = 'weapon-size-badge slot size-' + hpSize;
          slotBadge.textContent = WEAPON_SIZE_LABEL[hpSize] || hpSize;
          slotBadge.title = `Rozmiar slotu: ${hpSize}`;
          row.appendChild(slotBadge);
    
          // 1c. Plakietka rozmiaru aktualnie zamontowanej broni (S/M/L/C)
          const mountedBadge = document.createElement('div');
          const mountedSize = (!hp.destroyed && weapon?.size) ? weapon.size : null;
          if (mountedSize) {
            mountedBadge.className = 'weapon-size-badge mounted size-' + mountedSize;
            mountedBadge.textContent = WEAPON_SIZE_LABEL[mountedSize] || mountedSize;
            mountedBadge.title = `Rozmiar zamontowanej broni: ${mountedSize}`;
          } else {
            mountedBadge.className = 'weapon-size-badge mounted empty';
            mountedBadge.textContent = '-';
            mountedBadge.title = 'Brak zamontowanej broni';
          }
          row.appendChild(mountedBadge);
    
          // 2. Typ slotu (np. MAIN #1) - mała etykieta
          const label = document.createElement('div');
          label.className = 'hp-row-label';
          const hpLabel = hp.type === 'special_missile' ? 'MISSILE SPECIAL' : hp.type.toUpperCase();
          label.textContent = `${hpLabel} #${idx + 1}`;
          row.appendChild(label);
    
          // 3. Nazwa zamontowanej broni lub "Puste"
          const mountInfo = document.createElement('div');
          mountInfo.className = 'hp-row-mount';
          if (hp.destroyed) {
            mountInfo.textContent = 'Zniszczony';
            mountInfo.classList.add('empty');
          } else if (hp.type === HP.HANGAR && hangarMounts.length) {
            mountInfo.textContent = mechanicHangarMountNames(hp).join(', ');
            mountInfo.classList.remove('empty');
          } else if (weapon) {
            mountInfo.textContent = weapon.name;
            mountInfo.classList.remove('empty');
          } else {
            mountInfo.textContent = 'Puste';
            mountInfo.classList.add('empty');
          }
          row.appendChild(mountInfo);
    
          // 4. Statystyki zamontowanej broni
          const metaEl = document.createElement('div');
          metaEl.className = 'hp-row-meta';
          metaEl.textContent = (!hp.destroyed && hp.type === HP.HANGAR)
            ? mechanicHangarMetaText(hp)
            : ((!hp.destroyed && weapon) ? mechanicCompactWeaponStats(weapon) : '-');
          row.appendChild(metaEl);
    
          // 5. Przycisk "X" do odczepiania
          const clearBtn = document.createElement('button');
          clearBtn.className = 'hp-row-clear';
          clearBtn.textContent = '×';
          clearBtn.title = "Odczep broń";
          clearBtn.disabled = (!(hp.mount || hangarMounts.length)) || !!hp.destroyed;
          clearBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            applyWeaponToHardpoint(hp, null);
          });
          row.appendChild(clearBtn);
    
          // Podpięcie upuszczania (Drop)
          attachSlotDnD(row, hp); // Ta funkcja pomocnicza zostaje bez zmian w kodzie
          return row;
        }
    
        function renderInstalledHardpoints(root) {
          if (!root) return;
          root.innerHTML = '';
    
          const filter = mechanicHardpointFilter;
          const source = filter === 'all'
            ? Game.player.hardpoints
            : Game.player.hardpoints.filter(hp => hp.type === filter || (filter === 'special' && hp.type === 'special_missile'));
    
          const listByType = {};
          for (const t of Object.values(HP)) listByType[t] = [];
          for (const hp of source) listByType[hp.type].push(hp);
    
          for (const type of Object.values(HP)) {
            const slots = listByType[type];
            if (!slots || slots.length === 0) continue;
    
            // Nagłówek grupy (np. "MAIN (4)")
            const meta = HP_GROUP_META[type];
            const header = document.createElement('div');
            header.className = 'list-group-header';
            header.textContent = `${meta ? meta.title : type} (${slots.length})`;
            header.style.marginBottom = '4px';
            root.appendChild(header);
    
            // Generowanie wierszy slotów
            slots.forEach((hp, idx) => {
              root.appendChild(createHpRow(hp, idx));
            });
          }
    
          if (source.length === 0) {
            const empty = document.createElement('div');
            empty.textContent = filter === 'all' ? 'Brak slotów na uzbrojenie.' : 'Brak slotów dla wybranego filtra.';
            empty.style.padding = '10px';
            root.appendChild(empty);
          }
        }
        function renderMechanic() {
          setMechanicFilterActive('weapon-filter-tabs', mechanicWeaponFilter);
          syncMechanicLeftCardHeader();
          setMechanicFilterActive('hp-filter-tabs', mechanicHardpointFilter);
          setMechanicBatchActive(mechanicBatchMode);
          renderAvailableWeapons(document.getElementById('mechanic-available'));
          renderInstalledHardpoints(document.getElementById('hp-groups'));
          const sel = document.getElementById('ship-frame-select');
          if (sel && sel.value !== Game.player.shipFrame) {
            sel.value = Game.player.shipFrame;
          }
        }
    
        const DEFAULT_PLAYER_HULL_ID = 'atlas';
        const BASE_PLAYER_PHYSICS = {
          speed: SHIP_PHYSICS.SPEED,
          reverseMult: SHIP_PHYSICS.REVERSE_MULT,
          turnAccel: SHIP_PHYSICS.TURN_ACCEL,
          maxTurnSpeed: SHIP_PHYSICS.MAX_TURN_SPEED,
          linearFriction: SHIP_PHYSICS.LINEAR_FRICTION,
          angularFriction: SHIP_PHYSICS.ANGULAR_FRICTION,
          boostMult: SHIP_PHYSICS.BOOST_MULT
        };
        const BASE_PLAYER_PROFILE = {
          mass: Number(ship?.mass) || SHIP_PHYSICS.PLAYER_MASS,
          rammingMass: Number(ship?.rammingMass) || SHIP_PHYSICS.PLAYER_MASS,
          radius: Number(ship?.radius) || 220,
          hullMax: Number(ship?.hull?.max) || 12000,
          shieldMax: Number(ship?.shield?.max) || 18000,
          shieldRegen: Number(ship?.shield?.regenRate) || 150,
          shieldDelay: Number(ship?.shield?.regenDelay) || 2.5,
          cargoCap: Number(ship?.cargoCap) || 20
        };
    
        const PLAYER_HULL_CATALOG = createPlayerHullCatalog({
          ships: SHIPS,
          basePhysics: BASE_PLAYER_PHYSICS,
          baseProfile: BASE_PLAYER_PROFILE
        });
        const PLAYER_HULL_ORDER = [...PLAYER_HULL_MARKET_ORDER];
        const HANGAR_UI_STATE = {
          marketExpanded: new Set(),
          ownedExpanded: new Set()
        };
    
        function formatHangarCredits(value) {
          return Math.max(0, Math.round(Number(value) || 0)).toLocaleString('pl-PL');
        }
    
        function normalizePlayerHullId(hullId) {
          const key = String(hullId || '').toLowerCase();
          if (PLAYER_HULL_CATALOG[key]) return key;
          return DEFAULT_PLAYER_HULL_ID;
        }
    
        function isHangarHullExpanded(section, hullId) {
          const id = normalizePlayerHullId(hullId);
          const bucket = section === 'owned' ? HANGAR_UI_STATE.ownedExpanded : HANGAR_UI_STATE.marketExpanded;
          return bucket.has(id);
        }
    
        function toggleHangarHullExpanded(section, hullId) {
          const id = normalizePlayerHullId(hullId);
          const bucket = section === 'owned' ? HANGAR_UI_STATE.ownedExpanded : HANGAR_UI_STATE.marketExpanded;
          if (bucket.has(id)) bucket.delete(id);
          else bucket.add(id);
          buildHangarPanel();
          updateStationOverlay(stationUI.tab, stationUI.station);
        }
    
        // --- Zakładki ---
        const persistedOwnedHulls = Array.isArray(previousPlayer?.ownedHullIds) ? previousPlayer.ownedHullIds : [];
        const persistedActiveHull = previousPlayer?.activeHullId || previousPlayer?.shipId || DEFAULT_PLAYER_HULL_ID;
        const PLAYER = {
          credits: 1200,
          cargo: {},
          // Stosunek frakcji do gracza. Zmienia ceny, dostęp do doków i to,
          // czy patrole otwierają ogień.
          reputation: previousPlayer.reputation || createInitialReputation(),
          shipId: normalizePlayerHullId(persistedActiveHull),
          activeHullId: normalizePlayerHullId(persistedActiveHull),
          // Per-hull weapon loadouts: { [hullId]: [{ id, type, mount, ammo, maxAmmo }] }.
          // Each owned ship remembers its own fitting across hull switches.
          hullLoadouts: {},
          // Chipy per kadłub: { [hullId]: string[] } (katalog: src/data/chips.js).
          // Zapis w 'loadout' (saveLoadout/loadLoadout); brak pola = brak chipów.
          hullChips: {},
          ownedHulls: new Set([
            DEFAULT_PLAYER_HULL_ID,
            normalizePlayerHullId(persistedActiveHull),
            ...persistedOwnedHulls.map(normalizePlayerHullId)
          ])
        };
    
        // Chip okrętu (src/data/chips.js). Gracz: PLAYER.hullChips[aktywny kadłub],
        // NPC: opcjonalne entity.chips (Set albo tablica). Pytają o to pętle broni —
        // AI PD przy każdej decyzji, ciwsStep co krok — więc zero alokacji.
        function hasShipChip(entity, chipId) {
          if (!entity || !chipId) return false;
          if (entity === ship) return hullHasChip(PLAYER.hullChips, PLAYER.activeHullId, chipId);
          return chipListHas(entity.chips, chipId);
        }
        window.hasShipChip = hasShipChip;
    
        const BLUEPRINTS = {
          upgrades: [
            { id: 'rail_cooler', name: 'Chłodzenie raila', cost: 600, apply() { rail.heatCap *= 1.25; rail.coolRate *= 1.15; } },
            {
              id: 'boost_core', name: 'Wzmocniony boost', cost: 700, apply() {
                boost.extraThrustMul *= 1.15;
                boost.consumeRate *= 0.9;
                boost.handlingMultiplier *= 1.05;
              }
            },
            {
              id: 'agility', name: 'Zwrotność +', cost: 500, apply() {
                ship.angularDamping *= 0.9;
                ship.engines.torqueLeft.maxThrust = Math.round(ship.engines.torqueLeft.maxThrust * 1.12);
                ship.engines.torqueRight.maxThrust = Math.round(ship.engines.torqueRight.maxThrust * 1.12);
              }
            },
          ],
          ships: PLAYER_HULL_ORDER.map(id => PLAYER_HULL_CATALOG[id]).filter(Boolean),
        };
    
        ensurePlayerOwnsHull(DEFAULT_PLAYER_HULL_ID);
        ensurePlayerOwnsHull(PLAYER.activeHullId);
        syncPlayerHullSnapshot();
        applyPlayerHullProfile(PLAYER.activeHullId, { preserveDamageRatio: false, syncVisuals: true, persist: false });
    
        const STATION_TAB_LABELS = {
          trade: 'Handel',
          cantina: 'Kantyna',
          hangar: 'Hangar',
          mechanic: 'Mechanik',
          infrastructure: 'Infrastruktura'
        };
        const STATION_TAB_CONFIG = STATION_TERMINAL_TABS.map(tab => ({
          id: tab.id,
          label: STATION_TAB_LABELS[tab.id] || toTitleCaseFromKey(tab.id)
        }));
    
        // Surowce, ich wartości i łańcuchy produkcji żyją w src/data/resources.js.
        // Stary MARKET (ruda/paliwo/zywnosc) i lokalne ECONOMY_RESOURCES zostały
        // usunięte — handel działa teraz na tym samym rejestrze co wydobycie.
    
        // Ikona surowca: kształt z kategorii, kolor z rejestru. Jeden generator
        // zamiast ręcznie pisanych SVG-ów — 28 surowców nie da się utrzymać ręcznie.
        const RESOURCE_CATEGORY_SHAPES = {
          ore: '<path d="M12 3 18 7v10l-6 4-6-4V7z" fill="COLOR" stroke="STROKE" stroke-width="1.2"/><path d="M12 3v8l6 6" stroke="STROKE" stroke-width="1" stroke-linecap="round" opacity="0.8"/>',
          gas: '<path d="M12 3c-3.2 3.5-5 6.3-5 9a5 5 0 1010 0c0-2.7-1.8-5.5-5-9z" fill="COLOR" stroke="STROKE" stroke-width="1.4"/>',
          volatile: '<path d="M12 3.5 15 9l6 .8-4.4 4.2 1.1 6-5.7-3-5.7 3 1.1-6L3 9.8 9 9z" fill="COLOR" stroke="STROKE" stroke-width="1.1"/>',
          metal: '<rect x="4.5" y="6.5" width="15" height="4" rx="1.2" fill="COLOR" stroke="STROKE"/><rect x="6" y="11.5" width="13" height="4" rx="1.2" fill="COLOR" stroke="STROKE" opacity="0.85"/><rect x="7.5" y="16.5" width="10" height="3" rx="1" fill="COLOR" stroke="STROKE" opacity="0.7"/>',
          electronic: '<rect x="7" y="7" width="10" height="10" rx="1.4" fill="COLOR" stroke="STROKE" stroke-width="1.2"/><path d="M10 4v3M14 4v3M10 17v3M14 17v3M4 10h3M4 14h3M17 10h3M17 14h3" stroke="STROKE" stroke-width="1.3" stroke-linecap="round"/>',
          fuel: '<rect x="8" y="4" width="8" height="16" rx="3" fill="COLOR" stroke="STROKE" stroke-width="1.3"/><path d="M12 7v10" stroke="STROKE" stroke-width="1.6" stroke-linecap="round" opacity="0.85"/>',
          chemical: '<path d="M10 3h4v5.5l4.4 8A2 2 0 0116.6 20H7.4a2 2 0 01-1.8-3.5L10 8.5z" fill="COLOR" stroke="STROKE" stroke-width="1.2"/>',
          component: '<path d="M12 2.8 20 7v10l-8 4.2L4 17V7z" fill="COLOR" stroke="STROKE" stroke-width="1.3"/><circle cx="12" cy="12" r="3.2" fill="none" stroke="STROKE" stroke-width="1.3"/>',
          salvage: '<path d="M4 15l5-5 3 3 4-6 4 8z" fill="COLOR" stroke="STROKE" stroke-width="1.2"/><path d="M4 19h16" stroke="STROKE" stroke-width="1.4" stroke-linecap="round"/>'
        };
    
        function resourceIconSvg(key) {
          const def = RESOURCES[key];
          if (!def) return '';
          const shape = RESOURCE_CATEGORY_SHAPES[def.category] || RESOURCE_CATEGORY_SHAPES.ore;
          const body = shape.replace(/COLOR/g, def.color).replace(/STROKE/g, 'rgba(255,255,255,0.72)');
          return `<svg viewBox="0 0 24 24" fill="none">${body}</svg>`;
        }
    
        const stationOverlayDom = {
          root: document.getElementById('top-drawer'),
          tabs: document.getElementById('station-tabs'),
          title: document.getElementById('station-title'),
          subtitle: document.getElementById('station-subtitle'),
          credits: document.getElementById('station-credits'),
          panels: {
            upgrades: document.getElementById('tab-upgrades'),
            trade: document.getElementById('tab-trade'),
            cantina: document.getElementById('tab-cantina'),
            hangar: document.getElementById('tab-hangar'),
            mechanic: document.getElementById('tab-mechanic-html'),
            infrastructure: document.getElementById('tab-infrastructure-html'),
          }
        };
    
        const stationOverlayState = {
          built: false,
          activeTab: null,
          stationKey: null
        };
    
        function createResourceIcon(key) {
          const wrap = document.createElement('span');
          wrap.className = 'resource-icon-wrap';
          wrap.innerHTML = resourceIconSvg(key);
          const svg = wrap.querySelector('svg');
          if (svg) svg.classList.add('resource-icon');
          return wrap;
        }
    
        function getResourceLabel(key) {
          return RESOURCES[key] ? resourceLabel(key) : toTitleCaseFromKey(key);
        }
    
        function createStationCard({ title, badge, description, meta = [], actions = [], dataset = null }) {
          const card = document.createElement('div');
          card.className = 'station-card-aero';
          if (dataset) {
            for (const [key, val] of Object.entries(dataset)) {
              card.dataset[key] = val;
            }
          }
    
          const header = document.createElement('div');
          header.className = 'card-header';
          const titleEl = document.createElement('div');
          titleEl.className = 'card-title';
          titleEl.textContent = title;
          header.appendChild(titleEl);
          if (badge) {
            const chip = document.createElement('span');
            chip.className = 'card-badge';
            chip.textContent = badge;
            header.appendChild(chip);
          }
          card.appendChild(header);
    
          if (description) {
            const desc = document.createElement('p');
            desc.className = 'card-desc';
            desc.textContent = description;
            card.appendChild(desc);
          }
    
          if (meta.length) {
            const metaEl = document.createElement('div');
            metaEl.className = 'card-desc';
            metaEl.dataset.cardMeta = 'true';
            metaEl.innerHTML = meta.map(text => `<div>${text}</div>`).join('');
            card.appendChild(metaEl);
          }
    
          if (actions.length) {
            const actionsEl = document.createElement('div');
            actionsEl.className = 'card-actions';
            actions.forEach(action => {
              const btn = document.createElement('button');
              btn.textContent = action.label;
              if (action.dataset) {
                for (const [k, v] of Object.entries(action.dataset)) {
                  btn.dataset[k] = v;
                }
              }
              if (typeof action.disabled === 'boolean') btn.disabled = action.disabled;
              btn.addEventListener('click', action.onClick);
              actionsEl.appendChild(btn);
            });
            card.appendChild(actionsEl);
          }
    
          return card;
        }
    
        function initStationOverlayTabs() {
          if (!stationOverlayDom.tabs) return;
          stationOverlayDom.tabs.innerHTML = '';
          for (const tab of STATION_TAB_CONFIG) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'station-tab-btn';
            btn.dataset.tab = tab.id;
            btn.textContent = tab.label;
            btn.addEventListener('click', () => {
              stationUI.tab = tab.id;
              renderStationUI();
            });
            stationOverlayDom.tabs.appendChild(btn);
          }
        }
        function buildTradePanel() {
          const pane = stationOverlayDom.panels.trade;
          if (!pane) return;
          pane.innerHTML = '';
    
          const resourcesCard = document.createElement('div');
          resourcesCard.className = 'station-card-aero trade-resource-card';
    
          const resHeader = document.createElement('div');
          resHeader.className = 'card-header';
          const resTitle = document.createElement('div');
          resTitle.className = 'card-title';
          resTitle.textContent = 'Magazyny i produkcja';
          resHeader.appendChild(resTitle);
          const resBadge = document.createElement('span');
          resBadge.className = 'card-badge';
          resBadge.textContent = 'Trade';
          resHeader.appendChild(resBadge);
          resourcesCard.appendChild(resHeader);
    
          const resDesc = document.createElement('p');
          resDesc.className = 'card-desc';
          resDesc.textContent = 'Aktualny stan surowców na orbicie planety.';
          resourcesCard.appendChild(resDesc);
    
          const resMeta = document.createElement('div');
          resMeta.className = 'card-desc';
          const resNote = document.createElement('span');
          resNote.className = 'trade-resource-note';
          resNote.textContent = 'Magazyny stacji orbitalnej.';
          resMeta.appendChild(resNote);
          resourcesCard.appendChild(resMeta);
    
          const resTable = document.createElement('table');
          resTable.className = 'trade-resource-table';
          for (const tier of [TIER.RAW, TIER.REFINED, TIER.COMPONENT]) {
            const headRow = document.createElement('tr');
            headRow.className = 'trade-resource-tier';
            const headCell = document.createElement('td');
            headCell.colSpan = 2;
            headCell.textContent = TIER_LABEL_PL[tier];
            headRow.appendChild(headCell);
            resTable.appendChild(headRow);
    
            for (const key of RESOURCE_KEYS_BY_TIER[tier]) {
              const row = document.createElement('tr');
              row.dataset.resourceKey = key;
              const labelCell = document.createElement('td');
              labelCell.className = 'trade-resource-label';
              labelCell.appendChild(createResourceIcon(key));
              const label = document.createElement('span');
              label.textContent = getResourceLabel(key);
              labelCell.appendChild(label);
              const values = document.createElement('td');
              values.className = 'trade-resource-values';
              const amount = document.createElement('span');
              amount.dataset.field = 'amount';
              amount.className = 'trade-resource-amount';
              amount.textContent = '0';
              const cap = document.createElement('span');
              cap.dataset.field = 'capacity';
              cap.className = 'trade-resource-capacity';
              cap.textContent = '0';
              values.appendChild(amount);
              values.append(' / ');
              values.appendChild(cap);
              row.appendChild(labelCell);
              row.appendChild(values);
              resTable.appendChild(row);
            }
          }
          resourcesCard.appendChild(resTable);
          pane.appendChild(resourcesCard);
    
          pane.appendChild(buildTradeMarketCard());
        }
    
        // Stacja skupuje poniżej i sprzedaje powyżej wartości bazowej z resources.js.
        // Rozpiętość jest marżą doku — opłaca się produkować samemu, ale zakup
        // brakującego surowca zawsze jest możliwy.
        const TRADE_BUY_MARGIN = 1.18;
        const TRADE_SELL_MARGIN = 0.82;
    
        // Cena lokalna = wartość bazowa × niedobór × profil frakcji × reputacja.
        // To ten mnożnik niedoboru tworzy trasy handlowe: pusty magazyn na Marsie
        // płaci za stal dwa razy tyle co pełny magazyn na Ziemi, więc frachtowce
        // (i gracz) mają dokąd lecieć.
        const SCARCITY_MIN_MUL = 0.6;   // magazyn pełny — nadwyżka, nikt nie chce
        const SCARCITY_MAX_MUL = 1.8;   // magazyn pusty — głód
        // Frakcja płaci więcej za to, czego potrzebuje, i taniej oddaje to,
        // czego ma w nadmiarze z własnej produkcji.
        const FACTION_DEMAND_MUL = 1.25;
        const FACTION_SUPPLY_MUL = 0.8;
    
        function getStationScarcityMul(station, key) {
          const econ = station ? InfrastructureUI.ensureEconomy(station) : null;
          const cap = Number(econ?.capacity?.[key]);
          if (!Number.isFinite(cap) || cap <= 0) return 1;
          const fill = Math.max(0, Math.min(1, (Number(econ.resources?.[key]) || 0) / cap));
          return SCARCITY_MIN_MUL + (SCARCITY_MAX_MUL - SCARCITY_MIN_MUL) * (1 - fill);
        }
    
        function getFactionProfileMul(station, key) {
          const faction = FACTIONS[normalizeFaction(station?.factionId)];
          if (!faction) return 1;
          if (faction.demands?.includes(key)) return FACTION_DEMAND_MUL;
          if (faction.supplies?.includes(key)) return FACTION_SUPPLY_MUL;
          return 1;
        }
    
        function getLocalBasePrice(station, key) {
          return getResourceValue(key) * getStationScarcityMul(station, key) * getFactionProfileMul(station, key);
        }
    
        function getTradeBuyPrice(key, station = stationUI.station) {
          // Dobra reputacja obniża cenę zakupu...
          const rep = getFactionPriceMultiplier(station?.factionId, PLAYER.reputation);
          return Math.max(1, Math.round(getLocalBasePrice(station, key) * TRADE_BUY_MARGIN * rep));
        }
    
        function getTradeSellPrice(key, station = stationUI.station) {
          // ...i podnosi cenę skupu, więc dzielimy zamiast mnożyć.
          const rep = getFactionPriceMultiplier(station?.factionId, PLAYER.reputation) || 1;
          return Math.max(1, Math.round(getLocalBasePrice(station, key) * TRADE_SELL_MARGIN / rep));
        }
    
        // Komponenty handluje się sztukami, surowce sypkie partiami po 10.
        function getTradeStep(key) { return RESOURCES[key]?.tier === TIER.COMPONENT ? 1 : 10; }
    
        function getPlayerCargoFree() {
          const capacity = Number(getPlayerHullDef(PLAYER.activeHullId)?.cargoCap) || 0;
          return Math.max(0, capacity - getBagMass(PLAYER.cargo));
        }
    
        function buildTradeMarketCard() {
          const card = document.createElement('div');
          card.className = 'station-card-aero trade-market-card';
    
          const header = document.createElement('div');
          header.className = 'card-header';
          const title = document.createElement('div');
          title.className = 'card-title';
          title.textContent = 'Handel z dokiem';
          header.appendChild(title);
          const badge = document.createElement('span');
          badge.className = 'card-badge';
          badge.textContent = 'Rynek';
          header.appendChild(badge);
          card.appendChild(header);
    
          const desc = document.createElement('p');
          desc.className = 'card-desc';
          desc.textContent = 'Sprzedaj nadwyżki z ładowni albo dokup surowiec, którego jeszcze nie produkujesz.';
          card.appendChild(desc);
    
          const holdNote = document.createElement('div');
          holdNote.className = 'card-desc trade-hold-note';
          card.appendChild(holdNote);
    
          const table = document.createElement('table');
          table.className = 'trade-market-table';
          for (const key of RESOURCE_KEYS) {
            const row = document.createElement('tr');
            row.dataset.marketKey = key;
    
            const labelCell = document.createElement('td');
            labelCell.className = 'trade-resource-label';
            labelCell.appendChild(createResourceIcon(key));
            const label = document.createElement('span');
            label.textContent = getResourceLabel(key);
            labelCell.appendChild(label);
            row.appendChild(labelCell);
    
            const stockCell = document.createElement('td');
            stockCell.className = 'trade-market-stock';
            stockCell.dataset.field = 'stock';
            row.appendChild(stockCell);
    
            // Ceny są lokalne (niedobór + profil frakcji + reputacja), więc wypełnia
            // je updateTradeCards przy każdym odświeżeniu, nie budowa tabeli.
            const priceCell = document.createElement('td');
            priceCell.className = 'trade-market-price';
            priceCell.dataset.field = 'price';
            row.appendChild(priceCell);
    
            const actionCell = document.createElement('td');
            actionCell.className = 'trade-market-actions';
            const step = getTradeStep(key);
            const sellBtn = document.createElement('button');
            sellBtn.className = 'card-action';
            sellBtn.textContent = `Sprzedaj ${step}`;
            sellBtn.dataset.tradeType = 'sell';
            sellBtn.addEventListener('click', () => handleTrade('sell', key, step));
            actionCell.appendChild(sellBtn);
            const buyBtn = document.createElement('button');
            buyBtn.className = 'card-action';
            buyBtn.textContent = `Kup ${step}`;
            buyBtn.dataset.tradeType = 'buy';
            buyBtn.addEventListener('click', () => handleTrade('buy', key, step));
            actionCell.appendChild(buyBtn);
            row.appendChild(actionCell);
    
            table.appendChild(row);
          }
          card.appendChild(table);
          return card;
        }
    
        function buildCantinaPanel() {
          const pane = stationOverlayDom.panels.cantina;
          if (!pane) return;
          pane.innerHTML = '';
          pane.appendChild(createStationCard({
            title: 'Najemnik: piracka stacja',
            badge: 'Misja',
            description: 'Odbierz kontrakt na zniszczenie pirackiej placówki w pobliskim sektorze.',
            meta: ['Nagrody za eliminację wrogów'],
            actions: [{ label: 'Przyjmij', onClick: startMercenaryMission }]
          }));
          pane.appendChild(createStationCard({
            title: 'Wojna o terytorium',
            badge: 'Misja',
            description: 'Dołącz do sił sojuszniczych i odbij punkt kontrolny z rąk piratów.',
            meta: ['Aktywuje wrogie fale w sektorze'],
            actions: [{ label: 'Dołącz', onClick: startTerritoryWarMission }]
          }));
        }
        function buildHangarPanel() {
          const pane = stationOverlayDom.panels.hangar;
          if (!pane) return;
          pane.innerHTML = '';
    
          const currentHullId = normalizePlayerHullId(PLAYER.activeHullId || ship.activeHullId || DEFAULT_PLAYER_HULL_ID);
          const ownedHulls = getPlayerOwnedHullIds();
          const allHullDefs = BLUEPRINTS.ships.filter(Boolean);
          const marketDefs = allHullDefs.filter(def => !ownedHulls.has(def.id));
          const ownedDefs = allHullDefs.filter(def => ownedHulls.has(def.id));
    
          // --- Helper: create a service row (repair / upgrade style) ---
          function createServiceRow(label, subtitle, btnText, btnAttrs, onClick, disabled) {
            const row = document.createElement('div');
            row.className = 'hangar-hull-entry';
            row.style.marginBottom = '4px';
    
            const summary = document.createElement('div');
            summary.className = 'weapon-row hangar-hull-summary';
    
            const iconWrap = document.createElement('div');
            iconWrap.className = 'weapon-row-icon placeholder';
            iconWrap.textContent = label.slice(0, 2).toUpperCase();
            summary.appendChild(iconWrap);
    
            const info = document.createElement('div');
            info.className = 'hangar-hull-info';
            const nameEl = document.createElement('div');
            nameEl.className = 'weapon-row-name';
            nameEl.textContent = label;
            const roleEl = document.createElement('div');
            roleEl.className = 'hangar-hull-role';
            roleEl.textContent = subtitle;
            info.appendChild(nameEl);
            info.appendChild(roleEl);
            summary.appendChild(info);
    
            const meta = document.createElement('div');
            meta.className = 'weapon-row-meta hangar-hull-meta';
            const btn = document.createElement('button');
            btn.className = 'hangar-hull-action-btn';
            btn.textContent = btnText;
            btn.disabled = !!disabled;
            btn.style.cssText = 'padding:4px 14px; border-radius:4px; border:1px solid #2a4472; background:#0d1a30; color:#8cf; cursor:pointer; font-size:12px;';
            for (const [k, v] of Object.entries(btnAttrs || {})) btn.setAttribute(k, v);
            btn.onclick = (e) => { e.stopPropagation(); onClick(); };
            meta.appendChild(btn);
            summary.appendChild(meta);
    
            row.appendChild(summary);
            return { row, roleEl, btn };
          }
    
          // --- Repair row ---
          {
            const hullMax = Math.max(1, Number(ship?.hull?.max) || 1);
            const hullVal = Math.max(0, Number(ship?.hull?.val) || 0);
            const damageFrac = 1 - (hullVal / hullMax);
            const damagePct = Math.ceil(damageFrac * 100);
            const repairCost = Math.ceil(damageFrac * 600);
            const { row, roleEl, btn } = createServiceRow(
              'Napraw kadlub',
              `Uszkodzenia: ${damagePct}% \u2022 Koszt: ${repairCost} CR`,
              'Napraw',
              { 'data-hangar-action': 'repair' },
              () => handleRepair(),
              damagePct <= 0 || PLAYER.credits < repairCost
            );
            roleEl.setAttribute('data-hangar-repair-status', '1');
            pane.appendChild(row);
          }
    
          // --- Upgrade rows ---
          if (BLUEPRINTS.upgrades && BLUEPRINTS.upgrades.length) {
            for (const upgrade of BLUEPRINTS.upgrades) {
              const cost = upgrade.cost || 0;
              const { row, btn } = createServiceRow(
                upgrade.name,
                `Ulepszenie \u2022 Koszt: ${cost} CR`,
                'Kup',
                { 'data-upgrade-id': upgrade.id, 'data-cost': String(cost) },
                () => purchaseUpgrade(upgrade),
                PLAYER.credits < cost
              );
              pane.appendChild(row);
            }
          }
    
          // --- Ship lists (full width, below service rows) ---
          const wrap = document.createElement('div');
          wrap.className = 'mechanic-body';
          wrap.style.marginTop = '12px';
          pane.appendChild(wrap);
    
          function createHullListCard(title, badge) {
            const card = document.createElement('div');
            card.className = 'station-card-aero mechanic-station-card mechanic-list-panel';
            const header = document.createElement('div');
            header.className = 'card-header';
            const titleEl = document.createElement('div');
            titleEl.className = 'card-title';
            titleEl.textContent = title;
            const badgeEl = document.createElement('span');
            badgeEl.className = 'card-badge';
            badgeEl.textContent = badge;
            header.appendChild(titleEl);
            header.appendChild(badgeEl);
            const desc = document.createElement('p');
            desc.className = 'card-desc';
            card.appendChild(header);
            card.appendChild(desc);
            return { card, desc };
          }
    
          function hullHardpointSummary(def) {
            const spec = SHIPS[def.shipFrame]?.spec || {};
            const main = Number(spec.main) || 0;
            const missile = Number(spec.missile) || 0;
            const aux = Number(spec.aux) || 0;
            const hangar = Number(spec.hangar) || 0;
            const special = Number(spec.special) || 0;
            const total = main + missile + aux + hangar + special;
            return { main, missile, aux, hangar, special, total };
          }
    
          function createHullRow(def, section) {
            const isOwned = section === 'owned';
            const isActive = normalizePlayerHullId(def.id) === currentHullId;
            const expanded = isHangarHullExpanded(section, def.id);
            const hpSpec = hullHardpointSummary(def);
    
            const row = document.createElement('div');
            row.className = 'hangar-hull-entry';
            row.dataset.hangarRow = '1';
            row.dataset.hullId = def.id;
            row.style.marginBottom = '6px';
    
            const summary = document.createElement('div');
            summary.className = 'weapon-row hangar-hull-summary';
            summary.dataset.expanded = expanded ? '1' : '0';
            summary.tabIndex = 0;
            summary.setAttribute('role', 'button');
            summary.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            summary.addEventListener('click', () => toggleHangarHullExpanded(section, def.id));
            summary.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                toggleHangarHullExpanded(section, def.id);
              }
            });
    
            const iconWrap = document.createElement('div');
            const iconSrc = def.spriteSrc || '';
            if (iconSrc) {
              iconWrap.className = 'weapon-row-icon';
              const img = document.createElement('img');
              img.src = iconSrc;
              img.alt = def.name;
              iconWrap.appendChild(img);
            } else {
              iconWrap.className = 'weapon-row-icon placeholder';
              iconWrap.textContent = String(def.name || '?').slice(0, 2).toUpperCase();
            }
            summary.appendChild(iconWrap);
    
            const info = document.createElement('div');
            info.className = 'hangar-hull-info';
            const name = document.createElement('div');
            name.className = 'weapon-row-name';
            name.textContent = def.name;
            const role = document.createElement('div');
            role.className = 'hangar-hull-role';
            role.textContent = def.role || 'Uniwersalny';
            info.appendChild(name);
            info.appendChild(role);
            summary.appendChild(info);
    
            const meta = document.createElement('div');
            meta.className = 'weapon-row-meta hangar-hull-meta';
    
            if (isOwned) meta.textContent = isActive ? 'ACTIVE' : 'OWNED';
            else meta.textContent = `${formatHangarCredits(def.cost)} CR`;
    
            const exp = document.createElement('span');
            exp.className = 'hangar-hull-expand';
            exp.textContent = expanded ? 'v' : '>';
            meta.appendChild(exp);
    
            summary.appendChild(meta);
            row.appendChild(summary);
    
            if (expanded) {
              const details = document.createElement('div');
              details.className = 'hangar-hull-details';
              const statRows = [
                ['Hull HP', `${Math.round(def.hullMax || 0)}`],
                ['Shield', `${Math.round(def.shield?.max || 0)}`],
                ['Mass', `${Math.round(def.mass || 0)}`],
                ['Speed', `${Math.round(def.physics?.speed || 0)}`],
                ['Turn', `${(Number(def.physics?.maxTurnSpeed) || 0).toFixed(2)}`],
                ['Hardpoints', `${hpSpec.total}`],
                ['Main / Missile', `${hpSpec.main} / ${hpSpec.missile}`],
                ['Aux / Hangar / Special', `${hpSpec.aux} / ${hpSpec.hangar} / ${hpSpec.special}`]
              ];
              for (const [labelText, valueText] of statRows) {
                const line = document.createElement('div');
                line.className = 'hangar-hull-stat';
                const label = document.createElement('span');
                label.className = 'hangar-hull-stat-label';
                label.textContent = labelText;
                const value = document.createElement('span');
                value.className = 'hangar-hull-stat-value';
                value.textContent = valueText;
                line.appendChild(label);
                line.appendChild(value);
                details.appendChild(line);
              }
              row.appendChild(details);
    
              const actions = document.createElement('div');
              actions.className = 'hangar-hull-actions';
    
              const actionBtn = document.createElement('button');
              actionBtn.type = 'button';
              actionBtn.dataset.hullId = def.id;
              actionBtn.className = 'hangar-hull-action-btn';
              if (isOwned) {
                actionBtn.dataset.hullAction = 'enter';
                actionBtn.textContent = isActive ? 'IN SHIP' : 'ENTER SHIP';
                actionBtn.disabled = isActive;
                actionBtn.addEventListener('click', () => purchaseShip(def, { activate: true }));
              } else {
                actionBtn.dataset.hullAction = 'buy';
                actionBtn.dataset.cost = `${Math.round(def.cost || 0)}`;
                actionBtn.textContent = 'BUY';
                actionBtn.disabled = PLAYER.credits < (def.cost || 0);
                actionBtn.addEventListener('click', () => purchaseShip(def, { activate: false }));
              }
              actions.appendChild(actionBtn);
              row.appendChild(actions);
            }
    
            return row;
          }
    
          const marketColumn = document.createElement('div');
          marketColumn.className = 'mechanic-column mechanic-parts';
          const marketCard = createHullListCard('Dostepne statki', 'Market');
          marketCard.desc.textContent = 'Kliknij statek aby rozwinac szczegoly i kupic hull.';
          const marketList = document.createElement('div');
          marketList.className = 'weapon-pool mechanic-list-scroll';
          if (!marketDefs.length) {
            const empty = document.createElement('div');
            empty.className = 'card-desc';
            empty.textContent = 'Brak statkow do zakupu.';
            marketList.appendChild(empty);
          } else {
            marketDefs.forEach(def => marketList.appendChild(createHullRow(def, 'market')));
          }
          marketCard.card.appendChild(marketList);
          marketColumn.appendChild(marketCard.card);
    
          const ownedColumn = document.createElement('div');
          ownedColumn.className = 'mechanic-column mechanic-install';
          const ownedCard = createHullListCard('Twoje statki', 'Inventory');
          ownedCard.desc.textContent = 'Kliknij statek aby sprawdzic staty i wejsc do wybranego hulla.';
          const ownedList = document.createElement('div');
          ownedList.className = 'weapon-pool mechanic-list-scroll';
          if (!ownedDefs.length) {
            const empty = document.createElement('div');
            empty.className = 'card-desc';
            empty.textContent = 'Nie posiadasz zadnych hulli.';
            ownedList.appendChild(empty);
          } else {
            ownedDefs.forEach(def => ownedList.appendChild(createHullRow(def, 'owned')));
          }
          ownedCard.card.appendChild(ownedList);
          ownedColumn.appendChild(ownedCard.card);
    
          wrap.appendChild(marketColumn);
          wrap.appendChild(ownedColumn);
        }
    
        function buildMechanicPanel() {
          const pane = stationOverlayDom.panels.mechanic;
          if (!pane) return;
    
          pane.innerHTML = `
          <div class="station-card-aero mechanic-station-card mechanic-list-panel">
            <div class="card-header">
              <div class="card-title" id="mechanic-left-title">Magazyn broni</div>
              <span class="card-badge" id="mechanic-left-badge">Loadout</span>
            </div>
            <p class="card-desc" id="mechanic-left-desc">Przeciagnij bron na slot po prawej stronie.</p>
            <div class="mechanic-tabs" id="weapon-filter-tabs">
              <button class="mechanic-tab-btn" data-filter="all">Wszystkie</button>
              <button class="mechanic-tab-btn" data-filter="main">Bron glowna</button>
              <button class="mechanic-tab-btn" data-filter="missile">Rakiety</button>
              <button class="mechanic-tab-btn" data-filter="aux">Bron dodatkowa</button>
              <button class="mechanic-tab-btn" data-filter="hangar">Hangary</button>
              <button class="mechanic-tab-btn" data-filter="special">Bron specjalna</button>
              <button class="mechanic-tab-btn" data-filter="builtin">Wbudowane</button>
              <button class="mechanic-tab-btn" data-filter="chips">Chipy</button>
              ${isMechanicDevMode() ? '<button class="mechanic-tab-btn" id="mechanic-fill-weapons" type="button">Fill weapons</button>' : ''}
            </div>
            <div id="mechanic-available" class="weapon-pool mechanic-list-scroll"></div>
          </div>
    
          <div class="station-card-aero mechanic-station-card mechanic-list-panel">
            <div class="card-header">
              <div class="card-title">Hardpointy</div>
              <span class="card-badge">Statek</span>
            </div>
            <p class="card-desc">Upusc bron na slot, aby podmienic uzbrojenie.</p>
            <div class="mechanic-tabs" id="hp-filter-tabs">
              <button class="mechanic-tab-btn" data-filter="all">Wszystkie</button>
              <button class="mechanic-tab-btn" data-filter="main">Bron glowna</button>
              <button class="mechanic-tab-btn" data-filter="missile">Rakiety</button>
              <button class="mechanic-tab-btn" data-filter="aux">Bron dodatkowa</button>
              <button class="mechanic-tab-btn" data-filter="hangar">Hangary</button>
              <button class="mechanic-tab-btn" data-filter="special">Bron specjalna</button>
              <button class="mechanic-tab-btn" data-filter="builtin">Wbudowane</button>
            </div>
            <div class="mechanic-batch-row">
              <span class="mechanic-batch-label">Hardpointy:</span>
              <div id="hp-batch-tabs" class="mechanic-batch-tabs">
                <button class="mechanic-batch-btn" data-batch="1">1</button>
                <button class="mechanic-batch-btn" data-batch="3">3</button>
                <button class="mechanic-batch-btn" data-batch="5">5</button>
                <button class="mechanic-batch-btn" data-batch="10">10</button>
                <button class="mechanic-batch-btn" data-batch="all">ALL</button>
              </div>
            </div>
            <div id="hp-groups" class="hp-groups mechanic-list-scroll"></div>
          </div>
          `;
    
          const sel = document.getElementById('ship-frame-select');
          if (sel) {
            const activeHull = getPlayerHullDef(PLAYER.activeHullId || ship.activeHullId || DEFAULT_PLAYER_HULL_ID);
            const activeFrame = activeHull?.shipFrame && SHIPS[activeHull.shipFrame]
              ? SHIPS[activeHull.shipFrame]
              : SHIPS[Game.player.shipFrame];
            sel.innerHTML = activeFrame
              ? `<option value="${activeFrame.id}" selected>${activeFrame.name}</option>`
              : '';
            sel.disabled = true;
            sel.title = 'Rama wynika z aktualnie wybranego hulla.';
            sel.onchange = null;
          }
    
          initMechanicFilter('weapon-filter-tabs', () => mechanicWeaponFilter, (val) => { mechanicWeaponFilter = val; });
          initMechanicFilter('hp-filter-tabs', () => mechanicHardpointFilter, (val) => { mechanicHardpointFilter = val; });
          initMechanicBatchControls();
          document.getElementById('mechanic-fill-weapons')?.addEventListener('click', fillMechanicWeapons);
          renderMechanic();
          updateMechanicCards();
        }
    
        function buildInfrastructurePanel() {
          const pane = stationOverlayDom.panels.infrastructure;
          if (!pane) return;
          pane.innerHTML = '';
          pane.appendChild(createStationCard({
            title: 'Infrastruktura stacji',
            badge: 'Budowa',
            description: 'Przeciągaj budynki na siatkę infrastruktury, aby rozwijać stację.',
            meta: ['Skrót klawiatury: [6]'],
            actions: [{
              label: 'Otwórz budowę',
              onClick: () => {
                stationUI.tab = 'infrastructure';
                InfrastructureUI.setVisible(true);
                renderStationUI();
              }
            }]
          }));
    
          // Ring zone painter card
          pane.appendChild(createStationCard({
