            const planet = earthStation.planet;
            const radii = planet && window.planetOrbitRadii ? window.planetOrbitRadii(planet) : null;
            const gravityWell = (radii && Number.isFinite(radii.gravityWell)) ? radii.gravityWell : null;
            const planetRadius = earthStation.planet?.r || 0;
            const orbitPadding = 900;
            const spawnOrbitRadius = gravityWell
