          const cloneList = (kind) => {
            const list = Array.isArray(src?.[kind]) ? src[kind] : [];
            const out = [];
            for (let i = 0; i < list.length; i++) {
              const marker = list[i];
              const x = Number(marker?.x);
              const y = Number(marker?.y);
              if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
              out.push({ ...marker, x, y });
            }
            return out;
