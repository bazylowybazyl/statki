        function computeAutoBeamEmitterUid(shooter, weapon, muzzleData) {
          const sx = shooter?.pos?.x ?? shooter?.x ?? 0;
          const sy = shooter?.pos?.y ?? shooter?.y ?? 0;
          const sa = Number(shooter?.angle) || 0;
          const dxLocal = (muzzleData.pos.x - sx);
          const dyLocal = (muzzleData.pos.y - sy);
