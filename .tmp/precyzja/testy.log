        function isScannerStationContact(target, contact) {
          if (contact?.type === 'station' || contact?.tone === 'station') return true;
          return target?.__scannerContactType === 'station' || stations.includes(target);
        }
    
        function openScannerStationConnection(target) {
          if (!isTargetAlive(target) || !isScannerStationContact(target, null)) return false;
          const hudSystem = window.hudSystem;
          if (!hudSystem || typeof hudSystem.handleMenuAction !== 'function') return false;
          if (hudSystem.menuState !== 'SCAN' && typeof hudSystem.setBottomMenuState === 'function') {
            hudSystem.setBottomMenuState('SCAN');
          }
          if (hudSystem.menuState !== 'SCAN') return false;
          hudSystem.handleMenuAction('terminal-connect', target?.id != null ? String(target.id) : '');
          pushZoneMessage(`LACZENIE ZE STACJA: ${getStationDisplayName(target).toUpperCase()}`, 1.2);
          return true;
