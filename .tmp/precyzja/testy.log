        function handleScannerOverviewAction(action, target) {
          if (!isTargetAlive(target)) return;
          selectScannerTarget(target);
          if (action === 'lock') {
            toggleLockedTargetUi(target);
          } else if (action === 'scan') {
            issueDirectScanOrder(target);
          } else if (action === 'approach' || action === 'orbit' || action === 'jump') {
            handleRadarAction(action, target);
