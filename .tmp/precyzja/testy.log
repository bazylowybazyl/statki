          }
          const x = Number(hp.x);
          const y = Number(hp.y);
          if (!Number.isFinite(x) || !Number.isFinite(y)) return null;
          const hpScale = getEntityHardpointScale(entity);
          return { x: x * hpScale.x, y: y * hpScale.y };
        }
    
        function getEntityHardpointWorldPos(entity, hp) {
