            const builtW = weapons[HP.BUILTIN] || [];
            for (let i = 0; i < builtW.length; i++) {
              const loadout = builtW[i];
              const hp = loadout?.hp;
              const hpPos = hp?.pos || hp;
              const origin = _getInterpolatedHardpointWorldPos(hp);
              if (!hpPos || !origin) continue;
              const localDir = editorDegToForward(Number.isFinite(Number(hpPos.rot)) ? Number(hpPos.rot) : 90);
              const dir = rotate(localDir, _sA);
              const sw = Superweapon?.superweaponState || null;
              const visible = !!(sw?.charging || sw?.armed);
