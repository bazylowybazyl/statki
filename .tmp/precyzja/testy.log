            if (!weapon && loadout?.weapon) weapon = loadout.weapon;
            const hp = loadout?.hp;
            const wpn = loadout?.weapon;
            if (!hp || !wpn) continue;
            const cdLeft = Math.max(0, Number(hp.specialCd) || 0);
            const cdMax = Math.max(0.01, Number(wpn.cooldown) || cdLeft || 0.25);
            if (cdLeft < bestCdLeft) {
