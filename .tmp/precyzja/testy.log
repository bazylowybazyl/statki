            if (!weapons) return;
    
            const _sA = interpAngle;
            const _cosA = Math.cos(_sA);
            const _sinA = Math.sin(_sA);
            const AIM_LINE_LEN = 350;
    
            ctx.save();
            ctx.lineCap = 'round';
    
            function _aimLine(wx, wy, dx, dy, len, colReady, colDim, ready) {
              const lineLen = Math.max(40, Number(len) || AIM_LINE_LEN);
              const p0 = worldToScreen(wx, wy, camRef);
              const p1 = worldToScreen(wx + dx * lineLen, wy + dy * lineLen, camRef);
              const grad = ctx.createLinearGradient(p0.x, p0.y, p1.x, p1.y);
              const col = ready ? colReady : colDim;
