          // kontakty z czujników WSZYSTKICH okrętów strony (dla sojuszników także
          // Atlasa, sond i dronów), ze smyczą postawy — ESKORTA bije tylko to, co
          // blisko gracza; pirat z bazą broni stacji. Dawny „radar" 20 km od
          // pojedynczego okrętu nie widział tego, co gracz miał na radarze.
          // Skrzydło wsparcia bierze w pierwszej kolejności cel namierzony przez gracza.
          return pickContactTarget(npc, {
            player: ship,
            priority: npc?.supportData ? lockedTarget : null
          });
        }
