          // Formacja abreast — capitale rozmieszczone na boki od gracza
          const allCapitals = SupportWing.units.filter(u => u && !u.npc?.dead && u.type !== 'fighter');
          const capitalIndex = Math.max(0, allCapitals.indexOf(data));
          const capitalCount = Math.max(1, allCapitals.length);
    
          // Symetryczne rozmieszczenie: 1→prawo, 2→lewo, 3→prawo dalej, 4→lewo dalej...
          const side = (capitalIndex % 2 === 0) ? 1 : -1;
