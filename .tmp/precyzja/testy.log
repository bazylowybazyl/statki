          }
    
          // Tło 3D pasów asteroid — proceduralne skały na warstwie tła (layer 1),
          // pod sprite'owym polem gameplayu. Regiony liczone z tych samych
          // BELT_DEFINITIONS i pozycji planet co AsteroidField wyżej.
          if (AsteroidBeltBackdrop && !window.beltBackdrop) {
            try {
              window.beltBackdrop = new AsteroidBeltBackdrop({
                seed: 0xB4CD07,
                planets,
                sun: SUN,
                auToWorld: getAuToWorldUnits(),
                scene: Core3D.scene,
                fovDeg: Core3D.cameraPersp ? Core3D.cameraPersp.fov : 35,
              });
              console.log(`[BeltBackdrop] ready: ${window.beltBackdrop.regions.length} belt regions`);
            } catch (err) {
              console.error('[BeltBackdrop] init failed', err);
            }
          }
        });
    
        function waitForPlanetsReady() {
          if (planetScene3D || planetStationsReady) return Promise.resolve();
          return waitForCondition(() => planetScene3D || planetStationsReady, 2500);
        }
    
        // Mgła pasa jest w całości PRZESTRZENNA (addytywne płaty pyłu w WebGL,
        // asteroidBeltBackdrop3D) — pełnoekranowy wash 2D usunięty: gradient 'screen'
        // szarzył cały kadr (łącznie z planetami w tle), a 8-bitowa kwantyzacja
        // radialnego gradientu robiła koncentryczne prążki na ekranie.
    
    
        // =============== Bullets & effects ===============
        window.CANVAS_WEAPON_VFX_ENABLED = true;
        CanvasVFX.init();
        CanvasVFX.enabled = true;
        FlakBurstVFX.init();
        window.spawnParticle = (...args) => CanvasVFX.spawnParticle(...args);
        window.spawnShockwave = (...args) => CanvasVFX.spawnShockwave(...args);
        window.spawnWeaponImpactFromPreset = (...args) => CanvasVFX.spawnWeaponImpactFromPreset?.(...args);
        function isCanvasWeaponVfxEnabled() { return window.CANVAS_WEAPON_VFX_ENABLED !== false; }
    
        function resolveProjectileImpact3DKey(b) {
          const rawKey = String(b?.vfxKey || b?.weaponId || b?.weaponName || '').toLowerCase();
          if (rawKey.includes('yamato')) return 'yamato';
          if (b?.type === 'plasma' || b?.type === 'rocket' || b?.type === 'torpedo' || b?.type === 'armata') return 'armata';
          if (b?.type === 'rail') return 'rail';
          return 'default';
        }
    
        // ── Bramka efektów trafień 3D ────────────────────────────────────────────
        // spawnBulletImpactEffect woła fizyka (120 Hz) dla KAŻDEGO trafienia pocisku
        // w bitwie — także kilka ekranów dalej i przy dalekim zoomie, gdzie błysk ma
        // 1–3 px. Każdy efekt overlaya to kilkanaście–kilkadziesiąt draw calli i nowe
        // materiały, a limit 96 efektów wyrzucał wtedy te, które BYŁO widać. Ta sama
        // rodzina bramek co CanvasVFX.spawnProjectileImpact3D (kadr + cooldown per
        // komórka), plus próg rozmiaru ekranowego i obie kamery split-screenu.
        // Bez alokacji: klucz komórki cooldownu jest liczbą.
        const IMPACT_FX_MARGIN_PX = 260;
        const IMPACT_FX_MIN_PX = 3;      // bazowy rozmiar efektu na ekranie
        const IMPACT_SPARK_MIN_PX = 2;   // rozrzut iskier na ekranie
        const IMPACT_FX_CELL_PX = 24;    // komórka cooldownu ≈ 24 px ekranu (min. 60 j.)
        const _impactFxLastMs = new Map();
    
        function impactScreenPxForCamera(x, y, sizeWorld, cam, vpX, vpW) {
          if (!cam) return 0;
          const zoom = Math.max(0.0001, Number(cam.zoom) || 1);
          const sx = (x - (Number(cam.x) || 0)) * zoom + vpX + vpW * 0.5;
          const sy = (y - (Number(cam.y) || 0)) * zoom + H * 0.5;
          const reach = IMPACT_FX_MARGIN_PX + sizeWorld * zoom;
          if (sx < vpX - reach || sx > vpX + vpW + reach || sy < -reach || sy > H + reach) return 0;
          return sizeWorld * zoom;
        }
    
        // Największy rozmiar ekranowy efektu wśród kamer, w których punkt jest
        // w kadrze (z marginesem); 0 = poza kadrem wszędzie.
        function impactFxScreenPx(x, y, sizeWorld) {
          if (splitScreenMode && camera2) {
            const halfW = Math.floor(W / 2);
            return Math.max(
              impactScreenPxForCamera(x, y, sizeWorld, camera, 0, halfW),
              impactScreenPxForCamera(x, y, sizeWorld, camera2, halfW, W - halfW)
            );
          }
          return impactScreenPxForCamera(x, y, sizeWorld, camera, 0, W);
        }
    
        // Skupiony ogień w jeden kadłub dawał dziesiątki nakładających się efektów
        // w tym samym miejscu ekranu. Komórka rośnie z oddaleniem (stałe ~24 px).
        function impactFxCooldownReady(kind, cooldownMs, x, y) {
          if (!(cooldownMs > 0)) return true;
          const zoom = Math.max(0.0001, Number(camera.zoom) || 1);
          const cell = Math.max(60, IMPACT_FX_CELL_PX / zoom);
          const key = (Math.round(x / cell) * 1048576 + Math.round(y / cell)) * 4 + kind;
          const nowMs = performance.now();
          const last = _impactFxLastMs.get(key);
          if (last !== undefined && nowMs - last < cooldownMs) return false;
          _impactFxLastMs.set(key, nowMs);
          if (_impactFxLastMs.size > 2048) {
            // Najdłuższy cooldown to 42 ms — starsze wpisy nic już nie blokują.
            const threshold = nowMs - 100;
            for (const [k, t] of _impactFxLastMs) if (t < threshold) _impactFxLastMs.delete(k);
            if (_impactFxLastMs.size > 4096) _impactFxLastMs.clear();
          }
          return true;
        }
    
        function spawnBulletImpactEffect(b, x, y, scale = 1.0) {
          const impactKey = resolveProjectileImpact3DKey(b);
          // Trafienia pociskow ida wylacznie przez overlay 3D ponizej. Kanwa 2D ma
          // wlasna sciezke dla trafien wiazek (spawnWeaponImpactFromPreset).
    
          if (window.overlay3D) {
            const baseSize = 40 * scale;
            // Rodzaj efektu: 0 yamato, 1 armata, 2 rail, 3 autocannon. Cooldowny jak
            // w CanvasVFX.shouldSpawnProjectileImpact3D; yamato bez cooldownu.
            let fxKind = 3;
            let fxSize = baseSize;
            let fxCooldownMs = 42;
            if (impactKey === 'yamato') {
              fxKind = 0; fxSize = baseSize * 2.4; fxCooldownMs = 0;
            } else if (b.type === 'plasma' || b.type === 'rocket' || b.type === 'torpedo' || b.type === 'armata') {
              fxKind = 1; fxSize = baseSize * 1.5; fxCooldownMs = 28;
            } else if (b.type === 'rail') {
              fxKind = 2; fxSize = baseSize * 1.2; fxCooldownMs = 8;
            }
            if (impactFxScreenPx(x, y, fxSize) >= IMPACT_FX_MIN_PX && impactFxCooldownReady(fxKind, fxCooldownMs, x, y)) {
              if (fxKind === 0) {
                if (window.triggerYamatoImpact3D) triggerYamatoImpact3D(x, y, fxSize, b.color || b.vfxColor);
              } else if (fxKind === 1) {
                if (window.triggerArmataImpact3D) triggerArmataImpact3D(x, y, fxSize);
              } else if (fxKind === 2) {
                if (window.triggerRailgunExplosion3D) triggerRailgunExplosion3D(x, y, fxSize);
              } else if (window.triggerAutocannonImpact3D) {
                triggerAutocannonImpact3D(x, y, fxSize, b.color || b.vfxColor);
              }
            }
            // GPU sparks alongside 3D effects — tylko gdy ich rozrzut (prędkość ×
            // życie 0.3 s) jest na ekranie widoczny.
            const spark3D = SparkSystem3D;
            if (spark3D && spark3D.isInitialized) {
              const isHeavy = (b.weaponSize === 'L' || b.weaponSize === 'Capital');
              const sparkSpeed = isHeavy ? 400 * scale : 280 * scale;
              if (impactFxScreenPx(x, y, sparkSpeed * 0.3) >= IMPACT_SPARK_MIN_PX) {
                const sparkCount = isHeavy ? Math.round(16 * scale) : Math.round(8 * scale);
                const sparkSize = isHeavy ? 0.6 : 0.4;
                spark3D.burst(x, y, sparkCount, sparkSpeed, 0.3, sparkSize);
              }
            }
          }
        }
        window.spawnBulletImpactEffect = spawnBulletImpactEffect;
    
        // =============== Station UI ===============
        let stationUI = {
          open: false,
