        // ZIMNE WRAKI (src/game/coldWrecks.js, brief docs/BRIEF-zimne-wraki.md)
        // Uśpiony od dawna wrak, do którego nic się nie odwołuje i przy którym nic
        // się nie rusza, wychodzi ze wszystkich list (pętla wraków, siatka pocisków,
        // destruktor, 3D) i zostaje smugą. Wraca WYŁĄCZNIE jawnie: holowanie,
        // cięcie, rozkaz na wrak, konsola (window.thawWreck).
        // ============================================================
        // Pętla wraków kasuje gorący/śpiący wrak dalej niż tyle od gracza. Zimnych
        // ta reguła nie dotyczy — pole wraków przetrwa odlot gracza.
        const WRECK_DESPAWN_DIST = 50000;
        let _coldRefMarkStamp = 0;
    
        function markColdRef(entity) {
          if (entity && entity.isWreck === true) entity._coldRefStamp = _coldRefMarkStamp;
        }
    
        // Raz na skan (i na klatkę z kolejką zamrożeń): stempluje wraki, do których
        // coś się odwołuje — odzysk, locki, kursor, menu, rozkazy, liny, ładunek.
        // O(NPC + liny), bez alokacji.
        function markColdWreckReferences(stamp) {
          _coldRefMarkStamp = stamp;
          markColdRef(salvageState.cutting);
          markColdRef(salvageState.towed);
          markColdRef(lockedTarget);
          markColdRef(lockedTarget2);
          for (let i = 0; i < lockedTargets.length; i++) markColdRef(lockedTargets[i]);
          markColdRef(scan.target);
          markColdRef(scannerSelectedTarget);
          if (worldCommandMenu.open) markColdRef(worldCommandMenu.targetEntity);
          markColdRef(playerAttackState.target);
          markColdRef(ship?.command?.targetEntity);
          for (let i = 0; i < npcs.length; i++) {
            const npc = npcs[i];
            if (!npc) continue;
            if (!npc.dead) {
              // Rozkaz RTS / wymuszony cel na wrak.
              markColdRef(npc.command?.targetEntity);
              markColdRef(npc.forceTarget);
            }
            // Wrak w locie transferu ładunku (rodzic jeszcze trzyma referencję).
            markColdRef(npc._cargoWreck);
          }
          const ropes = TowSystem.constraints;
          for (let i = 0; i < ropes.length; i++) {
            markColdRef(ropes[i].bodyA);
            markColdRef(ropes[i].bodyB);
          }
        }
    
        // Tanie odwołania sprawdzane wprost przy każdym kandydacie.
        function isColdWreckReferencedDirect(wreck) {
          if (TowSystem.isAttached(wreck)) return true;
          if (wreck._cargoOrderId) {
            const order = getShipmentOrder(cargoFleet, wreck._cargoOrderId);
            // Partia jeszcze nie „leży” we wraku — transfer w toku.
            if (order && order.status !== SHIPMENT_STATUS.WRECK && order.status !== SHIPMENT_STATUS.RECOVERED) return true;
          }
          return false;
        }
    
        const coldWreckSystem = createColdWreckSystem({
          wrecks,
          coldWrecks,
          // Lista destruktora z klatki (żywe okręty, gracz, gorące wraki) — i tak
          // budowana raz na klatkę; śpiące wraki odfiltrowuje moduł.
          getAwakeBodies: () => _cachedDynamicDestructibles || wrecks,
          markReferences: markColdWreckReferences,
          isReferenced: isColdWreckReferencedDirect,
          isVisuallySafe: (w) => (isColdFreezeVisuallySafe ? isColdFreezeVisuallySafe(w) : true),
          getPlayerPos: () => ship?.pos || null,
          getFrameId: () => renderFrameId,
          onBeforeFreeze(w) {
            // Asekuracyjnie: holowany/cięty nie przejdzie warunków, ale lina ani
            // cięcie nie mogą trzymać wraku bez siatki.
            if (salvageState.towed === w) releaseWreckTow();
            if (salvageState.cutting === w) stopFieldSalvage();
            TowSystem.detachBody(w, 'wreck-cold');
            // Smuga (kolor z meshu, póki jest) PRZED zwolnieniem meshy.
            if (captureColdWreckImpostor) captureColdWreckImpostor(w, w._coldSnapshot);
            if (invalidateHexShipEntity3D) invalidateHexShipEntity3D(w);
          },
          onThawed(w, reason) {
            if (window.DEBUG_COLD_WRECKS) console.log('[ColdWrecks] odmrożony (' + reason + ')', w);
          }
        });
    
        /**
         * Jawne wybudzenie zimnego wraku (holowanie, cięcie, rozkaz, konsola).
         * Najwyżej jedno na klatkę — reszta czeka, `onReady(wreck)` wykona akcję,
         * gdy wrak wróci do `wrecks`. Zwraca THAW_RESULT ('thawed'|'queued'|'failed').
         */
        function thawWreck(wreck, reason = 'dev', onReady = null) {
          return coldWreckSystem.thaw(wreck, reason, onReady);
        }
        window.thawWreck = thawWreck;
        // Konsola dev: wymuszone zamrożenie (z pominięciem warunków), liczniki
        // i strojenie na żywo (np. ColdWreckConfig.clearRadius = 1200).
        window.freezeWreck = (wreck) => coldWreckSystem.freeze(wreck);
        window.ColdWreckStats = coldWreckSystem.stats;
        window.ColdWreckConfig = coldWreckSystem.config;
    
        // Pola zimnych wraków (src/game/wreckFields.js) dla CIC: przebudowa tylko po
        // zmianie zbioru zimnych (coldWreckSystem.version), najwyżej co 0,5 s.
        const coldWreckFields = [];
        window.coldWreckFields = coldWreckFields;
        let _coldFieldsVersion = -1;
        let _coldFieldsTimer = 0;
        function refreshColdWreckFields(dt) {
          _coldFieldsTimer -= dt;
          if (coldWreckSystem.version === _coldFieldsVersion || _coldFieldsTimer > 0) return;
          _coldFieldsTimer = 0.5;
          _coldFieldsVersion = coldWreckSystem.version;
          buildWreckFields(coldWrecks, coldWreckFields);
        }
    
        // Rozkaz na zimny wrak go budzi. Wyjątek: wrak dalej niż WRECK_DESPAWN_DIST
        // od gracza — odmrożony, zniknąłby w najbliższym kroku pętli wraków, a
        // podejście/orbita potrzebują tylko jego pozycji.
        function thawWreckForOrder(wreck, reason) {
          if (!wreck?.isCold) return;
          if (salvageDistanceToShip(wreck) > WRECK_DESPAWN_DIST) return;
          thawWreck(wreck, 'rozkaz:' + reason);
        }
    
        function physicsStep(dt, runFrameLogic = true, frameLogicDt = dt, runAiLogic = runFrameLogic, aiLogicDt = frameLogicDt, aiBrainPhase = 0, aiBrainPhaseCount = 1) {
          const tPhysics0 = performance.now();
          PerfHUD.markPhysicsStep();
          let tPhysSection0 = performance.now();
          const tPreAiTotal0 = tPhysSection0;
          let tPreSection0 = tPhysSection0;
          updateCameraTarget(dt);
          updateStationUIState(dt);
          InfrastructureUI.updateEditorState(dt);
          InfrastructureUI.update(dt);
          updateStationEconomies(dt);
          updateCargoFleet(dt);
          updateSalvage(dt);
          if (window.updateInfrastructureAnimations) {
            window.updateInfrastructureAnimations(dt);
          }
          // czas gry
          gameTime = (gameTime + dt * TIME_SCALE) % (24 * 3600);
          publishGameState({ gameTime });
          bridgeSimTime += dt;
          // aktualizacja orbit planet i stacji
          for (const pl of planets) {
            pl.angle += pl.speed * dt * TIME_SCALE;
            const R = pl.devOrbitOverrideR ?? pl.orbitRadius ?? pl.orbit?.radius ?? pl.orbitR ?? BASE_ORBIT;
            if ('orbitRadius' in pl) pl.orbitRadius = R;
            if (pl.orbit && 'radius' in pl.orbit) pl.orbit.radius = R;
            if ('orbitR' in pl) pl.orbitR = R;
            pl.x = SUN.x + Math.cos(pl.angle) * R;
            pl.y = SUN.y + Math.sin(pl.angle) * R;
          }
          for (const st of stations) {
            if (st.static) continue;
            st.angle += st.speed * dt * TIME_SCALE;
            st.x = st.planet.x + Math.cos(st.angle) * st.orbitRadius;
            st.y = st.planet.y + Math.sin(st.angle) * st.orbitRadius;
          }
          for (const st of stations) {
            if (!st.warpGate) continue;
            const off = st.warpGate.offset;
            const ox = off && typeof off.x === 'number' ? off.x : 0;
            const oy = off && typeof off.y === 'number' ? off.y : 0;
            st.warpGate.x = st.x + ox;
            st.warpGate.y = st.y + oy;
          }
          refreshWarpRoutes(warpRoutes);
          InfrastructureUI.syncWorldPositions();
          for (const st of stations) {
            if (!st.shield) continue;
            if (st.shield.regenTimer > 0) {
              st.shield.regenTimer = Math.max(0, st.shield.regenTimer - dt);
            } else {
              st.shield.val = clamp(st.shield.val + st.shield.regenRate * dt, 0, st.shield.max);
            }
          }
          for (const st of stations) {
            if (st.baseR == null) st.baseR = st.r;
            const scale = stationScaleFor(st);
            st.r = (st.baseR || st.r) * scale;
          }
          updateZoneState(dt);
          ship.shadowFactor = 0;
          ship.sunExposure = 1;
          const solarExposureFactor = 1;
          if (boost.state === 'active' && !isPlanetOrbitZoneId(zoneState.current?.id)) {
            boost.state = 'idle';
          }
          if (typeof warpBrakeTimer !== 'undefined' && warpBrakeTimer > 0) {
            warpBrakeTimer -= dt;
          }
          // regen paliwa gdy nie warpuje
          if (warp.state !== 'active') {
            warp.fuel = clamp(warp.fuel + warp.regenRate * solarExposureFactor * dt, 0, warp.fuelMax);
            if (DevFlags.unlimitedWarp) warp.fuel = warp.fuelMax;
            warp.entryProgress = 0;
          }
          
          
          const boostAllowed = isPlanetOrbitZoneId(zoneState.current?.id);
          let boostActive = boost.state === 'active' && boostAllowed;
          if (boost.state === 'active') {
            boost.fuel = clamp(boost.fuel - boost.consumeRate * dt, 0, boost.fuelMax);
            if (boost.fuel <= 0) {
              boost.state = 'idle';
              boostActive = false;
            } else {
              boostActive = true;
            }
          } else {
            boostActive = false;
            if (boost.effectTime <= 0) {
              boost.fuel = clamp(boost.fuel + boost.regenRate * solarExposureFactor * dt, 0, boost.fuelMax);
            }
          }
          if (!boostActive && boost.effectTime > 0) boost.effectTime = Math.max(0, boost.effectTime - dt);
    
          PerfHUD.addTiming('worldZoneTime', performance.now() - tPreSection0);
          tPreSection0 = performance.now();
    
          updatePlayerAttackCommand(dt);
    
          // rail queue/cd
          if (p1WeaponCtrl) p1WeaponCtrl.updateAim(warp.state === 'active' ? 0 : dt);
          rail.cd[0] = Math.max(0, rail.cd[0] - dt);
          rail.cd[1] = Math.max(0, rail.cd[1] - dt);
          const requiredBarrels = Math.max(1, rail.barrelsPerShot || 2);
          const secondaryReady = requiredBarrels < 2 || rail.cd[1] <= 0;
          if (!stationUI.open && mouse.fireMain && rail.queue.length === 0 && rail.cd[0] <= 0 && secondaryReady && !warp.isBusy()) { triggerRailVolley(); }
          // Auto-fire: ciągły ogień na namierzone cele (toggle z klawisza 1/2/3)
          if (mainAutoFire && lockedTargets.length > 0 && hasAnyLockedTargetInMainWeaponRange() && !stationUI.open && rail.queue.length === 0 && rail.cd[0] <= 0 && secondaryReady && !warp.isBusy()) {
            triggerRailVolley();
          }
          if (specialAutoFire && lockedTargets.length > 0 && !stationUI.open && !warp.isBusy()) {
            tryFireMountedSpecialWeapons();
          }
          if (specialMissileAutoFire && lockedTargets.length > 0 && !stationUI.open && !warp.isBusy()) {
            tryFireSpecialMissiles();
          }
          if (rocketAutoFire && lockedTargets.length > 0 && !stationUI.open && !warp.isBusy() && rocketCooldown <= 0) {
            if (fireRocket(Math.random() < 0.5 ? 'right' : 'left')) rocketCooldown = ROCKET_FIRE_INTERVAL;
          }
          for (const q of rail.queue) q.timer -= dt;
          let firedSomething = true;
          while (firedSomething) {
            firedSomething = false;
            for (let i = 0; i < rail.queue.length; i++) {
              const q = rail.queue[i];
              const canFire = q.ignoreCD || rail.cd[q.barrel] <= 0;
              if (q.timer <= 0 && canFire && !warp.isBusy()) {
                fireRailBarrel(q.barrel, q.weaponIndex);
                rail.queue.splice(i, 1);
                firedSomething = true;
                break;
              }
            }
          }
          railTimer = (requiredBarrels > 1) ? Math.min(rail.cd[0], rail.cd[1]) : rail.cd[0];
    
          ship.special.cooldownTimer = Math.max(0, ship.special.cooldownTimer - dt);
          updateSpecialWeaponCooldowns(dt);
          if (ship.shield.regenTimer > 0) ship.shield.regenTimer -= dt;
          else ship.shield.val = clamp(ship.shield.val + ship.shield.regenRate * solarExposureFactor * dt, 0, ship.shield.max);
          updateShieldFx(ship, dt);
          if (splitScreenMode && player2Ship && !player2Ship.destroyed) {
            updateShieldFx(player2Ship, dt);
            // P2 weapon controller update — handles main guns, missiles, specials
            if (p2WeaponCtrl) p2WeaponCtrl.update(dt);
          }
          rocketCooldown = Math.max(0, rocketCooldown - dt);
          for (const loadout of (Game.player.weapons?.[HP.MISSILE] || [])) {
            const hp = loadout?.hp;
            if (hp && typeof hp.missileCd === 'number') hp.missileCd = Math.max(0, hp.missileCd - dt);
          }
          // mouse world position
          const mouseWorld = screenToWorld(mouse.x, mouse.y);
          updateAgilityLogic(dt, mouseWorld);
          const hasMissilesEquipped = (Game.player.weapons?.[HP.MISSILE]?.length || 0) > 0;
    
          PerfHUD.addTiming('playerSystemsTime', performance.now() - tPreSection0);
          tPreSection0 = performance.now();
    
          // Skan pod kursorem, fale radaru, drony, sensory i CIC — to warstwa
          // informacyjna, nie fizyka. Odświeżana raz na klatkę; wcześniej CIC
          // przeliczał się ~2.9× na klatkę (0.68 ms zamiast 0.24 ms).
          if (runFrameLogic) {
          // hover scanning
          let hover = null;
          let hoverType = null;
          if (mouse.overCanvas) {
            let bestDistSq = Infinity;
            const npcMargin = 20;
            for (const npc of npcs) {
              if (npc.dead) continue;
              const radius = (npc.radius || 0) + npcMargin;
              const dx = npc.x - mouseWorld.x;
              const dy = npc.y - mouseWorld.y;
              const distSq = dx * dx + dy * dy;
              if (distSq <= radius * radius && distSq < bestDistSq) {
                bestDistSq = distSq;
                hover = npc;
                hoverType = 'npc';
              }
            }
            const stationMargin = 24;
            for (const st of stations) {
              const baseR = ((st.r ?? st.baseR) || 120) + stationMargin;
              const dx = st.x - mouseWorld.x;
              const dy = st.y - mouseWorld.y;
              const distSq = dx * dx + dy * dy;
              if (distSq <= baseR * baseR && distSq < bestDistSq) {
                bestDistSq = distSq;
                hover = st;
                hoverType = 'station';
              }
            }
            if (mercMission && mercMission.weaponPlatforms) {
              const platformMargin = 18;
              for (const platform of mercMission.weaponPlatforms) {
                if (!platform || platform.removed) continue;
                const radius = (platform.radius || 0) + platformMargin;
                const dx = platform.x - mouseWorld.x;
                const dy = platform.y - mouseWorld.y;
                const distSq = dx * dx + dy * dy;
                if (distSq <= radius * radius && distSq < bestDistSq) {
                  bestDistSq = distSq;
                  hover = platform;
                  hoverType = 'platform';
                }
              }
            }
            // Wraki na końcu — nie mają przejmować kursora nad żywym celem.
            // Zimne (coldWrecks) też: kursor ich nie budzi, dopiero rozkaz/holowanie.
            for (let pass = 0; pass < 2; pass++) {
              const wreckList = pass === 0 ? window.wrecks : coldWrecks;
              if (!Array.isArray(wreckList)) continue;
              for (const wreck of wreckList) {
                if (!wreck || wreck.dead) continue;
                const radius = (Number(wreck.radius) || 120) + 40;
                const dx = (wreck.x ?? 0) - mouseWorld.x;
                const dy = (wreck.y ?? 0) - mouseWorld.y;
                const distSq = dx * dx + dy * dy;
                // Odległość przed hasSalvage — ten alokuje (Object.values), a pole
                // wraków to setki kandydatów na klatkę.
                if (distSq > radius * radius || distSq >= bestDistSq) continue;
                if (!hasSalvage(wreck)) continue;
                bestDistSq = distSq;
                hover = wreck;
                hoverType = 'wreck';
              }
            }
          }
    
          if (hover) {
            scan.target = hover;
            scan.targetType = hoverType;
            scan.scanned = hover;
            updateHoverInfo(hover, hoverType);
            if (!stationUI.open && mouse.click && hoverType === 'station' && !isRtsModeActive()) {
              openStationUI(hover);
              mouse.click = false;
            }
          } else {
            if (scan.target || scan.scanned || scan.targetType) {
              scan.target = null;
              scan.scanned = null;
              scan.targetType = null;
            }
            hideHoverInfo();
          }
          // Nowy celownik jest jedynym źródłem zatwierdzonych namiarów. Stara lista
          // kontaktów pojedynczego skanu nie może kasować poprawnego locka po powrocie celu.
          const reconciledLocks = reconcileLockedTargets(lockedTargets, canPlayerLockTarget);
          lockedTargets = reconciledLocks.targets;
          lockedTarget = reconciledLocks.primary;
          if (lockedTargets.length === 0) {
            if (mainAutoFire) { mainAutoFire = false; pushZoneMessage('AUTO-FIRE OFF — brak celów', 1.5); }
            if (specialAutoFire) specialAutoFire = false;
            if (rocketAutoFire) rocketAutoFire = false;
            if (specialMissileAutoFire) specialMissileAutoFire = false;
          }
          if (scannerSelectedTarget && !isTargetAlive(scannerSelectedTarget)) {
            scannerSelectedTarget = null;
          }
          scannerState.lockAnim += frameLogicDt * SCANNER_LOCK_PULSE_SPEED;
          // Kokpit (hudSystem.cockpit) ma własną listę skanu i overview pod Alt, a stary
          // #scanner-overview-ui-root chowa na stałe cockpit-ui-bridge.css (ładowany
          // bezwarunkowo). Bez tej bramki model, sortowanie kontaktów i DOM starego
          // panelu liczyły się co klatkę dla niewidocznego elementu.
          const legacyScannerPanelVisible = !window.hudSystem?.cockpit;
          const scannerUiEnabled = legacyScannerPanelVisible && (scannerState.active || lockedTargets.length > 0 || scannerSelectedTarget) && !CICDisplay.active && !stationUI.open && !splitScreenMode;
          const radarUiEnabled = false;
          const scannerOverviewContacts = scannerUiEnabled ? getScannerOverviewContacts() : scannerContacts;
          // Locked targets always shown; scanner contacts shown when scanner active (excluding already-locked)
          // Lista tylko dla radarowego UI — przy wyłączonym nie budujemy jej co klatkę.
          const _radarTargets = radarUiEnabled ? lockedTargets.filter(t => isTargetAlive(t)) : [];
          if (radarUiEnabled && scannerState.active) {
            for (const _c of scannerContacts) {
              if (_c && _c.target && isTargetAlive(_c.target) && !lockedTargets.includes(_c.target)) {
                _radarTargets.push(_c.target);
              }
            }
          }
          scannerOverviewUI.update({
            enabled: scannerUiEnabled,
            contacts: scannerOverviewContacts,
            selectedTarget: scannerSelectedTarget,
            lockedTargets,
            maxRows: 96
          });
          radarTargetingUI.update({
            enabled: radarUiEnabled,
            dt: frameLogicDt,
            deepScanDuration: RADAR_UI_DEEP_SCAN_DURATION,
            width: W,
            height: H,
            camera,
            worldToScreen,
            lockAnim: scannerState.lockAnim,
            ship,
            targets: _radarTargets,
            distanceTo: (target) => Math.hypot(getTargetX(target) - ship.pos.x, getTargetY(target) - ship.pos.y),
            getMeta: getRadarTargetMeta,
            getScanData: getRadarTargetScanData,
            isLocked: (target) => lockedTargets.includes(target) || target === lockedTarget,
            toggleLock: toggleLockedTargetUi,
            onAction: handleRadarAction,
            onStatus: (text) => pushZoneMessage(text, 1.2),
            onDeepScanComplete: () => pushZoneMessage('SKAN ZAKONCZONY', 1.2)
          });
    
          // update radar pings
          for (let i = radarPings.length - 1; i >= 0; i--) {
            const p = radarPings[i];
            p.age += frameLogicDt; if (p.age > p.life) radarPings.splice(i, 1);
          }
          for (let i = scannerRevealFx.length - 1; i >= 0; i--) {
            const fx = scannerRevealFx[i];
            fx.age += frameLogicDt;
            if (fx.age > fx.life || !isTargetAlive(fx.target)) scannerRevealFx.splice(i, 1);
          }
          // update scan waves
          for (let i = scanWaves.length - 1; i >= 0; i--) {
            const w = scanWaves[i];
            w.age += frameLogicDt;
            w.r += w.speed * frameLogicDt;
            while (w.nextContact < w.contacts.length) {
              const contact = w.contacts[w.nextContact];
              if (!contact || !isTargetAlive(contact.target)) {
                w.nextContact++;
                continue;
              }
              if (w.age < scannerContactRevealTime(contact, w)) break;
              revealScannerContact(contact, w);
              w.nextContact++;
            }
            for (const npc of npcs) {
              if (npc.dead) continue;
              // Myśliwce całkowicie pomijamy — brak hypot, brak alokacji w hit-set
              const _t = String(npc.type || '').toLowerCase();
              if (!npc.isCapitalShip && (_t === 'fighter' || _t === 'interceptor' || _t === 'drone')) continue;
              if (!scannerState.sweepTargets.has(npc) && !w.hit.has(npc) && Math.hypot(npc.x - w.x, npc.y - w.y) <= w.r) {
                w.hit.add(npc);
                spawnRadarPing(npc.x, npc.y);
              }
            }
            for (const st of stations) {
              if (!scannerState.sweepTargets.has(st) && !w.hit.has(st) && Math.hypot(st.x - w.x, st.y - w.y) <= w.r) { w.hit.add(st); spawnRadarPing(st.x, st.y); }
            }
            if (mercMission && mercMission.weaponPlatforms) {
              for (const platform of mercMission.weaponPlatforms) {
                if (!platform || platform.destroyed || platform.removed) continue;
                if (!scannerState.sweepTargets.has(platform) && !w.hit.has(platform) && Math.hypot(platform.x - w.x, platform.y - w.y) <= w.r) {
                  w.hit.add(platform);
                  spawnRadarPing(platform.x, platform.y);
                }
              }
            }
            if (w.r > w.max) scanWaves.splice(i, 1);
          }
    
          // === SPOTTER DRONES UPDATE ===
          SpotterDroneSystem.update(frameLogicDt, ship, npcs);
    
          // === SENSOR SYSTEM UPDATE === (fog rendering disabled, sensors still update for CIC)
          SensorSystem.update(frameLogicDt, ship, npcs, Game.infrastructure, stations, gameTime);
    
          // === CIC UPDATE ===
          CICDisplay.update(frameLogicDt, ship, npcs, stations, SensorSystem);
          } // koniec bloku runFrameLogic (skan/sensory/CIC)
    
          PerfHUD.addTiming('scanUiTime', performance.now() - tPreSection0);
          tPreSection0 = performance.now();
    
          updatePlayerCommand(dt);
          updateEnginePower(dt);
          updateDriveTransmission(
            driveState,
            getPlayerSpeed(),
            warp.state === 'idle' ? Math.max(input.main, input.retro || 0) : 0,
            dt
          );
          if (driveState.shiftSerial !== lastDriveShiftSerial) {
            if (driveState.lastShiftQuality === 'auto') announceDriveShift('auto');
            lastDriveShiftSerial = driveState.shiftSerial;
          }
          const manualTorqueInput = clamp(Number(ship?.thrusterInput?.torque) || 0, -1, 1);
          const stabilizerState = getShipStabilizerState(ship);
          const commandHeadingActive = !!ship.command && !playerHasManualInput();
          let stabilizerAssistTorque = 0;
          let stabilizerAssistLeft = 0;
          let stabilizerAssistRight = 0;
          let stabilizerMainTurning = false;
          const stabilizerActive = warp.state === 'idle' && flightAssist.stabilizer && !commandHeadingActive;
          if (stabilizerActive) {
            const manualHeadingInput = (keys['a'] || keys['d']) ? manualTorqueInput : 0;
            // Prawdziwa zdolność obrotu w tej klatce: dysze boczne, a przy ciągu
            // naprzód (albo bez dysz bocznych) także odchylenie silników głównych.
            const stabilizerMainThrottle = clamp(Number(ship?.thrusterInput?.main) || 0, 0, 1);
            _playerStabilizerTurnOptions.mainAssist = stabilizerMainThrottle > 1e-3 ? true : 'auto';
            _playerStabilizerTurnOptions.mainThrottle = stabilizerMainThrottle;
            _playerStabilizerTurnOptions.mainBoost = boostActive ? SHIP_PHYSICS.BOOST_MULT : 1;
            const stabilizerCapability = resolveShipTurnCapability(ship, driveState, _playerStabilizerTurnOptions, _playerStabilizerTurnCapability);
            stabilizerMainTurning = stabilizerCapability.mainAssist;
            const headingAssist = updateHeadingStabilizer(stabilizerState, ship, dt, {
              enabled: true,
              manualTorque: manualHeadingInput,
              physics: SHIP_PHYSICS,
              turnCapability: stabilizerCapability
            });
            stabilizerAssistTorque = headingAssist.torque;
    
            // Stabilizacja ruchu bocznego (strafe) — tylko gdy kadłub umie przesunąć
            // się w bok bez skręcania. Custos/Hasta (dysza strafe'u = dysza obrotu)
            // odkręcałyby się przy tym od strzałki.
            const manualLeft = clamp(Number(ship?.thrusterInput?.leftSide) || 0, 0, 1);
            const manualRight = clamp(Number(ship?.thrusterInput?.rightSide) || 0, 0, 1);
            if (strafeUsableForCapability(stabilizerCapability) && manualLeft < 0.08 && manualRight < 0.08) {
              const omega = Number(ship?.angVel) || 0;
              const sinA = Math.sin(ship.angle);
              const cosA = Math.cos(ship.angle);
              // Prędkość wzdłuż osi "right" statku: (-sin, cos)
              const lateralVel = -(ship.vel.x * sinA) + (ship.vel.y * cosA);
              // Prędkość wzdłuż osi "forward" statku: (cos, sin)
              const forwardVel = (ship.vel.x * cosA) + (ship.vel.y * sinA);
              // Kompensacja rotacji: obrót statku zmienia projekcję prędkości na oś boczną.
              // Tempo zmiany lateralVel z samej rotacji ≈ -forwardVel * omega.
              // Odejmujemy tę składową, żeby stabilizator nie reagował na pozorny dryf z obrotu.
              const rotationContrib = -forwardVel * omega;
              const correctedLateral = lateralVel - rotationContrib * 0.35;
              const absCorrected = Math.abs(correctedLateral);
              // Wyciszanie siły stabilizacji gdy statek aktywnie się obraca
              const absOmega = Math.abs(omega);
              const rotationDampen = 1 - clamp(absOmega / (SHIP_PHYSICS.MAX_TURN_SPEED * 0.24), 0, 0.72);
              const lateralNorm = clamp(absCorrected / (SHIP_PHYSICS.SPEED * 0.2), 0, 1);
              // Te same dysze obracają statek — strafe w trakcie obrotu zabiera mu
              // ~2/3 momentu i stabilizator nie wyhamowałby obrotu na czas.
              const turnPriority = 1 - smoothstep01(Math.abs(stabilizerAssistTorque) / 0.25);
              const lateralStrength = lateralNorm * (2.0 - lateralNorm) * rotationDampen * turnPriority;
              if (absCorrected > 12) {
                // correctedLateral > 0 = dryf w prawo → odpal prawe dysze (pchną w lewo)
                // correctedLateral < 0 = dryf w lewo → odpal lewe dysze (pchną w prawo)
                if (correctedLateral > 0) stabilizerAssistRight = clamp(lateralStrength * 0.85, 0, 0.9);
                else stabilizerAssistLeft = clamp(lateralStrength * 0.85, 0, 0.9);
              }
            }
            // Przy jednej dyszy bocznej na burtę (Custos, Hasta) strafe skręca
            // statek — znosimy to przeciwnym momentem, inaczej stabilizacja boczna
            // i Q/E odkręcały statek od strzałki.
            stabilizerAssistTorque = compensateStrafeYaw(
              stabilizerCapability,
              stabilizerAssistTorque,
              Math.max(manualLeft, stabilizerAssistLeft),
              Math.max(manualRight, stabilizerAssistRight)
            );
          }
          else {
            updateHeadingStabilizer(stabilizerState, ship, dt, {
              enabled: false,
              manualTorque: 0,
              physics: SHIP_PHYSICS
            });
          }
          const thrusterCommand = composeShipThrusterCommand(ship, {
            torque: stabilizerAssistTorque,
            leftSide: stabilizerAssistLeft,
            rightSide: stabilizerAssistRight,
            // Czyste A/D obraca statek parą dysz manewrowych. Główne silniki
            // pomagają w zakręcie tylko przy ciągu naprzód — albo zawsze, gdy
            // kadłub nie ma dysz bocznych (inaczej w ogóle by nie skręcał).
            // Autopilot skręca samymi bocznymi, gdy je ma: odchylone dysze główne
            // (gaz skrętu ≥18%) pchały statek w bok od celu i przy dolocie krążył.
            // Przy stabilizatorze dysze główne dostają tylko jego moment — surowe
            // A/D omijało regulator.
            mainTorque: commandHeadingActive
              ? (_playerCommandTurnCapability.mainAssist ? manualTorqueInput : 0)
              : stabilizerActive
                ? (stabilizerMainTurning ? stabilizerAssistTorque : 0)
                : (((Number(ship?.thrusterInput?.main) || 0) > 1e-3
                  || (Math.abs(manualTorqueInput) > 1e-3 && playerNeedsMainEngineTurning()))
                  ? manualTorqueInput
                  : 0),
            suppressManualTorque: stabilizerActive
          });
          const thrusterDrive = updateShipThrusterState(ship, dt);
          const driveMain = clamp(thrusterDrive?.main ?? input.main, 0, 1);
          const driveLeft = clamp(thrusterDrive?.leftSide ?? input.leftSide, 0, 1);
          const driveRight = clamp(thrusterDrive?.rightSide ?? input.rightSide, 0, 1);
          const driveRetro = clamp(thrusterDrive?.retro ?? input.retro, 0, 1);
          const driveTurn = clamp((thrusterDrive?.torque || 0) + (thrusterDrive?.mainTorqueAssist || 0), -1, 1);
          const commandTurn = clamp(Number(thrusterCommand?.manualTorque) || 0, -1, 1);
          const activeTurnCommand = clamp(Number(thrusterCommand?.torque) || 0, -1, 1);
    
          if (warp.state === 'active') {
            const turnInput = commandTurn;
            const manualTurning = Math.abs(turnInput) > 1e-3;
            if (manualTurning) {
              const currentAngle = Math.atan2(warp.dir.y, warp.dir.x);
              const maxTurn = warp.turnRate * dt;
              const delta = clamp(turnInput * warp.turnRate * dt, -maxTurn, maxTurn);
              const newAngle = currentAngle + delta;
              warp.dir.x = Math.cos(newAngle);
              warp.dir.y = Math.sin(newAngle);
            }
            updateWarpCruiseAutopilot(dt, manualTurning);
            const desiredBodyAngle = Math.atan2(warp.dir.y, warp.dir.x);
            const diffBody = wrapAngle(desiredBodyAngle - ship.angle);
            const maxAlign = warp.alignRate * dt;
            ship.angle = wrapAngle(ship.angle + clamp(diffBody, -maxAlign, maxAlign));
            ship.angVel = 0;
    
            warp.entryProgress = Math.min(1, warp.entryProgress + dt / Math.max(0.001, warp.entryDuration));
            const entryEase = smoothstep01(warp.entryProgress);
            const zoneWarpMul = zoneState.current?.warpMultiplier ?? 1;
            const maxWarpSpeed = warp.speed * zoneWarpMul;
            const entryStartSpeed = Math.min(warp.entryBaseSpeed, maxWarpSpeed);
            const targetSpeed = entryStartSpeed + (maxWarpSpeed - entryStartSpeed) * entryEase;
            const targetV = { x: warp.dir.x * targetSpeed, y: warp.dir.y * targetSpeed };
            ship.vel.x += (targetV.x - ship.vel.x) * clamp(6 * dt, 0, 1);
            ship.vel.y += (targetV.y - ship.vel.y) * clamp(6 * dt, 0, 1);
            if (!DevFlags.unlimitedWarp) {
              warp.fuel = Math.max(0, warp.fuel - warp.consumeRate * dt);
              if (warp.fuel <= 0) { warp.state = 'idle'; exitWarp(); }
            } else {
              warp.fuel = warp.fuelMax;
            }
          }
          else if (warp.state === 'charging') {
            const dirToMouse = norm({ x: mouseWorld.x - ship.pos.x, y: mouseWorld.y - ship.pos.y });
            warp.dir.x = dirToMouse.x;
            warp.dir.y = dirToMouse.y;
    
            const desiredBodyAngle = Math.atan2(dirToMouse.y, dirToMouse.x);
    
            // Logika obrotu podczas ładowania (Visual feel)
            const kp = 5.5, maxSpin = 2.5, accel = 8.0;
            const diffB = wrapAngle(desiredBodyAngle - ship.angle);
            const desiredSpin = clamp(diffB * kp, -maxSpin, maxSpin);
            const delta = clamp(desiredSpin - ship.angVel, -accel * dt, accel * dt);
            ship.angVel += delta;
    
            // Ladowanie paska
            if (warp.charge < warp.chargeTime) {
              warp.charge += dt;
            }
    
            // WARUNEK WEJŚCIA:
            // Jeśli naładowane -> wchodzimy. engageWarp() weźmie obecny kąt dziobu.
            if (warp.charge >= warp.chargeTime && (DevFlags.unlimitedWarp || warp.fuel > 0)) {
              engageWarp();
            }
          }
          else {
            // --- Thruster-based Newtonian player physics ---
            const turnInput = driveTurn;
            const sin = Math.sin(ship.angle);
            const cos = Math.cos(ship.angle);
            const forward = { x: cos, y: sin };
            const right = { x: -sin, y: cos };
            const reverseInput = Math.max(0, -(clamp(ship.input?.thrustY ?? 0, -1, 1)));
            const retroState = ship.__retroState;
            const gamepadReverse = (ship.input?.thrustY ?? 0) < -0.15;
            const manualBrakeHeld = !!((!isRtsModeActive() && keys['s']) || gamepadReverse);
            const reverseEngaged = !!(reverseInput > 0.05 && retroState?.reverseEngaged);
            const manualReverseHeld = manualBrakeHeld && reverseEngaged;
            const damperActive = !!((flightAssist.damper && !manualReverseHeld) || (manualBrakeHeld && !reverseEngaged));
            const reverseThrustInput = reverseEngaged ? reverseInput : 0;
            const massSafe = Math.max(1, Number(ship.mass) || SHIP_PHYSICS.PLAYER_MASS || 1);
            const invMass = 1 / massSafe;
            const inertiaSafe = Math.max(
              1,
              Number(ship.inertia) || ((1 / 12) * massSafe * (((ship.w || 450) ** 2) + ((ship.h || 250) ** 2)))
            );
    
            const velAlongForward = (ship.vel.x * forward.x) + (ship.vel.y * forward.y);
            const counterThrustNorm = (driveMain > 1e-3)
              ? clamp((-velAlongForward) / Math.max(600, SHIP_PHYSICS.SPEED * 4.0), 0, 1)
              : 0;
            const counterThrustMul = 1.0 + (counterThrustNorm * 1.75);
    
            const thrusterForces = computeShipThrusterForces(ship, {
              mainForceMul: driveState.mainForceScale
                * driveState.shiftBoostMultiplier
                * (boostActive ? SHIP_PHYSICS.BOOST_MULT : 1.0)
                * counterThrustMul,
              sideForceMul: driveState.sideForceScale,
              reverseInput: reverseThrustInput
            }, _p1ForceScratch);
    
            const worldFx = (forward.x * thrusterForces.localFx) + (right.x * thrusterForces.localFy);
            const worldFy = (forward.y * thrusterForces.localFx) + (right.y * thrusterForces.localFy);
            ship.vel.x += worldFx * invMass * dt;
            ship.vel.y += worldFy * invMass * dt;
    
            // Liniowy drag — naturalny terminal velocity z linearFriction każdego hulla
            // v_max = speed / (-ln(friction) * 60)  np. friction=0.996 → v_max≈2500 u/s
            {
              const _drag = Math.pow(driveState.linearFriction, dt * 60);
              ship.vel.x *= _drag;
              ship.vel.y *= _drag;
            }
    
            const trainYawAssist = playerMegafreighterTrain?.head === ship
              ? MEGAFREIGHTER_YAW_ASSIST
              : 1;
            let angularAcc = (thrusterForces.localTorque / inertiaSafe)
              * driveState.turnAccelerationScale
              * trainYawAssist;
            ship.angVel += angularAcc * dt;
    
            const damperState = ship.__damperState || (ship.__damperState = { power: 0 });
            const speedSq = ship.vel.x * ship.vel.x + ship.vel.y * ship.vel.y;
            const speed = speedSq > 1e-8 ? Math.sqrt(speedSq) : 0;
            const speedRampNorm = clamp(speed / 40000, 0, 1);
            const damperRampIn = lerp(11.0, 3.4, speedRampNorm);
            const damperRampOut = 7.5;
            if (manualReverseHeld) {
              damperState.power = 0;
            } else {
              damperState.power = approachValue(
                Number(damperState.power) || 0,
                damperActive ? 1 : 0,
                (damperActive ? damperRampIn : damperRampOut) * dt
              );
            }
            const damperPower = clamp(damperState.power, 0, 1);
    
            if (damperPower > 1e-4) {
              const retroAssist = Math.max(reverseThrustInput, driveRetro);
              const lowSpeedAssist = clamp(1 - (speed / 260), 0, 1);
              const damperLinearScale = retroAssist > 0.05 ? lerp(0.28, 1.0, lowSpeedAssist) : 1.0;
              const linearBrakeBase = lerp(SHIP_PHYSICS.SPEED * 0.7, SHIP_PHYSICS.SPEED * 16.0, damperPower) * damperLinearScale;
              const linearBrakeDynamic = speed * lerp(0.18, 1.25, damperPower) * damperLinearScale;
              if (speed > 1e-4) {
                const brakeDelta = Math.min(speed, Math.max(linearBrakeBase, linearBrakeDynamic) * dt);
                const invSpeed = 1 / speed;
                ship.vel.x -= ship.vel.x * invSpeed * brakeDelta;
                ship.vel.y -= ship.vel.y * invSpeed * brakeDelta;
              }
    
              // Kursem steruje regulator (autopilot albo stabilizator), a dysze
              // boczne nie są zajęte retro — tłumik nie mrozi obrotu (4–28 rad/s²
              // przy ~0,04 z dysz Atlasa), regulator sam wyhamuje go przy celu.
              // Inaczej postój autopilota nie mógł obrócić statku, a stabilizator
              // z włączonym tłumikiem (C) stał w miejscu.
              const headingSteered = (commandHeadingActive || stabilizerActive) && driveRetro < 0.05;
              if (!headingSteered) {
                const angularBrake = lerp(SHIP_PHYSICS.TURN_ACCEL * 0.4, SHIP_PHYSICS.TURN_ACCEL * 2.8, damperPower);
                ship.angVel = approachValue(ship.angVel, 0, angularBrake * dt);
              }
    
              if ((ship.vel.x * ship.vel.x + ship.vel.y * ship.vel.y) < 0.25 && damperPower > 0.7) {
                ship.vel.x = 0;
                ship.vel.y = 0;
              }
              // Resztkę obrotu dobijamy także przy regulatorze, ale dopiero gdy ten
              // prawie nie daje momentu (jak shouldZeroStabilizedAngularVelocity):
              // na starcie obrotu zerowanie < 0,001 rad/s nie dałoby ruszyć z miejsca.
              const headingTurning = headingSteered && Math.abs(activeTurnCommand) >= 0.03;
              if (!headingTurning && Math.abs(ship.angVel) < 0.001 && damperPower > 0.94 && retroAssist < 0.08) {
                ship.angVel = 0;
              }
            }
    
            applyDriveSpeedGovernor(driveState, ship.vel, dt);
            const driveMaxTurnSpeed = SHIP_PHYSICS.MAX_TURN_SPEED * driveState.maxTurnSpeedScale;
            ship.angVel = clamp(ship.angVel, -driveMaxTurnSpeed, driveMaxTurnSpeed);
            if (shouldZeroStabilizedAngularVelocity({
              stabilizerEnabled: flightAssist.stabilizer,
              activeTurnCommand,
              angVel: ship.angVel
            })) {
              ship.angVel = 0;
            }
            ship.angle = wrapAngle(ship.angle + ship.angVel * dt);
    
            if (boostActive) {
              boost.effectTime = boost.effectDuration;
              boost.effectDir = { x: forward.x, y: forward.y };
            }
            if (!boostActive && boost.effectTime > 0) boost.effectTime = Math.max(0, boost.effectTime - dt);
          }
    
          // integracja ruchu (pozycja)
          // W modelu V46 nie używamy F=ma, tylko bezpośrednio v += speed*dt, więc ax/ay nie są potrzebne
          // Jednak dla kolizji i wraków warto zachować jakąś "masę" w kolizjach, ale ruch gracza jest nadrzędny.
          updateGravityWarpBrake(dt);
          ship.pos.x += ship.vel.x * dt;
          ship.pos.y += ship.vel.y * dt;
    
          // granice
          const margin = Math.max(50, getAuToWorldUnits() * WORLD_EDGE_MARGIN_AU);
          ship.pos.x = clamp(ship.pos.x, margin, WORLD.w - margin);
          ship.pos.y = clamp(ship.pos.y, margin, WORLD.h - margin);
    
          ship.x = ship.pos.x;
          ship.y = ship.pos.y;
    
          // ====== PLAYER 2 PHYSICS (Split Screen) ======
          if (splitScreenMode && player2Ship && !player2Ship.destroyed) {
            const p2 = player2Ship;
            // Update thruster state
            composeShipThrusterCommand(p2, {
              main: input2.main,
              retro: input2.retro,
              torque: input2.torque,
              mainTorque: input2.main > 1e-3 ? input2.torque : 0,
              leftSide: input2.leftSide,
              rightSide: input2.rightSide
            });
            updateShipThrusterState(p2, dt);
    
            const p2sin = Math.sin(p2.angle);
            const p2cos = Math.cos(p2.angle);
            const p2fwd = { x: p2cos, y: p2sin };
            const p2right = { x: -p2sin, y: p2cos };
            const p2mass = Math.max(1, Number(p2.mass) || 200000);
            const p2inv = 1 / p2mass;
            const p2inertia = Math.max(1, Number(p2.inertia) || ((1 / 12) * p2mass * (((p2.w || 450) ** 2) + ((p2.h || 250) ** 2))));
    
            const p2rev = Math.max(0, -(clamp(p2.input?.thrustY ?? 0, -1, 1)));
            const p2retroState = p2.__retroState;
            const p2reverseEngaged = !!(p2rev > 0.05 && p2retroState?.reverseEngaged);
            const p2VelAlongForward = (p2.vel.x * p2fwd.x) + (p2.vel.y * p2fwd.y);
            const p2CounterNorm = clamp((-p2VelAlongForward) / Math.max(600, SHIP_PHYSICS.SPEED * 4.0), 0, 1);
            const p2forces = computeShipThrusterForces(p2, {
              mainForceMul: 1.0 + (p2CounterNorm * 1.75),
              sideForceMul: 1.6,
              reverseInput: p2reverseEngaged ? p2rev : 0
            }, _p2ForceScratch);
    
            const p2wfx = (p2fwd.x * p2forces.localFx) + (p2right.x * p2forces.localFy);
            const p2wfy = (p2fwd.y * p2forces.localFx) + (p2right.y * p2forces.localFy);
            p2.vel.x += p2wfx * p2inv * dt;
            p2.vel.y += p2wfy * p2inv * dt;
    
            p2.angVel = (p2.angVel || 0) + (p2forces.localTorque / p2inertia) * dt;
            p2.angVel = clamp(p2.angVel, -3.5, 3.5);
    
            // Damper (always active for P2 simplicity)
            const p2speed = Math.hypot(p2.vel.x, p2.vel.y);
            if (p2speed > 1e-4) {
              const brakeRate = p2reverseEngaged ? 0.06 : 0.4;
              const brakeDelta = Math.min(p2speed, p2speed * brakeRate * dt);
              const invSpd = 1 / p2speed;
              p2.vel.x -= p2.vel.x * invSpd * brakeDelta;
              p2.vel.y -= p2.vel.y * invSpd * brakeDelta;
            }
            p2.angVel *= Math.exp(-2.0 * dt);
            if (Math.abs(p2.angVel) < 0.003) p2.angVel = 0;
    
            p2.angle = wrapAngle((p2.angle || 0) + (p2.angVel || 0) * dt);
            p2.pos.x += p2.vel.x * dt;
            p2.pos.y += p2.vel.y * dt;
            p2.pos.x = clamp(p2.pos.x, margin, WORLD.w - margin);
            p2.pos.y = clamp(p2.pos.y, margin, WORLD.h - margin);
            p2.x = p2.pos.x;
            p2.y = p2.pos.y;
    
            // Shield regen for P2
            if (p2.shield) {
              if (p2.shield.regenTimer > 0) p2.shield.regenTimer -= dt;
              else p2.shield.val = clamp(p2.shield.val + (p2.shield.regenRate || 150) * dt, 0, p2.shield.max);
            }
    
            // Update camera2
            if (camera2) {
              camera2.x = p2.pos.x;
              camera2.y = p2.pos.y;
              camera2.targetX = p2.pos.x;
              camera2.targetY = p2.pos.y;
              // Independent zoom for P2 — smooth interpolation
              const zoomLerp2 = 1 - Math.exp(-8 * dt);
              camera2.zoom += (camera2.targetZoom - camera2.zoom) * zoomLerp2;
              if (camera2.shakeTime > 0) {
                camera2.shakeTime -= dt;
                if (camera2.shakeTime <= 0) camera2.shakeMag = 0;
              }
            }
          }
          // P1-P2 hex collision is handled by DestructorSystem (P2 is in dynamicDestructibles)
          // ====== END PLAYER 2 PHYSICS ======
    
          // obrót (STARY KOD USUNIĘTY - zastąpiony powyżej kinematycznym)
          /* const angAcc = totalTorque / ship.inertia;
          ship.angVel += angAcc * dt;
          ship.angVel *= Math.exp(-ship.angularDamping * (boostActive ? boost.angularDampingFactor : 1) * dt);
          ship.angle += ship.angVel * dt;
          */
          // ship.angle = wrapAngle(ship.angle);
          PerfHUD.addTiming('playerFlightTime', performance.now() - tPreSection0);
          tPreSection0 = performance.now();
    
          updateFlyingHexDebris(dt);
    
          // Zimne wraki: odmrożenia z kolejki, skan co 0,5 s, zamrażanie w budżecie
          // klatki. PRZED pętlą wraków — zamrożony wrak nie trafia już do buforów
          // ani list destruktora tej klatki.
          if (runFrameLogic) coldWreckSystem.step(frameLogicDt);
          if (runFrameLogic) refreshColdWreckFields(frameLogicDt);
    
          // Aktualizacja wraków — podział na aktywne i śpiące
          _activeWrecksBuffer.length = 0;
          _sleepingWrecksBuffer.length = 0;
          for (let i = wrecks.length - 1; i >= 0; i--) {
            const w = wrecks[i];
            const wreckFreshTime = 2.5;
            const wreckSleepSpeed = 22.0;
            const wreckSleepAngVel = 0.03;
            const wreckSleepDelay = 1.4;
    
            // Fizyka ruchu (tylko dla nie-śpiących)
            if (!w._wreckSleeping) {
              w.x += w.vx * dt;
              w.y += w.vy * dt;
              w.angle += w.angVel * dt;
              // Tarcie wraku jest „na krok 1/120 s” (stepDecay120 / ?physHz).
              const wreckFriction = stepDecay120(w.friction, dt);
              w.vx *= wreckFriction;
              w.vy *= wreckFriction;
              w.angVel *= wreckFriction;
              if (w.pos) { w.pos.x = w.x; w.pos.y = w.y; }
              if (w.vel) { w.vel.x = w.vx; w.vel.y = w.vy; }
            }
            w._wreckAge = (Number(w._wreckAge) || 0) + dt;
            const wreckSpeedSq = (w.vx * w.vx) + (w.vy * w.vy);
            const wreckSlowEnough = wreckSpeedSq < (wreckSleepSpeed * wreckSleepSpeed) && Math.abs(w.angVel) < wreckSleepAngVel;
            if (!w.noWreckSleep && (Number(w._wreckAge) || 0) > wreckFreshTime && wreckSlowEnough) {
              w._wreckSleepTimer = (Number(w._wreckSleepTimer) || 0) + dt;
              if ((Number(w._wreckSleepTimer) || 0) >= wreckSleepDelay) {
                w._wreckSleeping = true;
                w.vx = 0;
