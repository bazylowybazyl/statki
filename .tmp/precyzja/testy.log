        const CARRIER_FIGHTERS_PER_BAY = 4;
        const CARRIER_MAX_BAYS = 5;      // nie startuj z więcej niż 5 bay (balans/perf)
        const CARRIER_LAUNCH_BATCH = 4;  // ile myśliwców na jeden cykl startu
    
        // Wyrzutnie nosiciela NPC — te same hardpointy 'hangar', z których liczyliśmy
