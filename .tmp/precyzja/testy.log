          const candidates = [
            requested,
            toEditorHullAlias(requested),
            frameKey,
            toEditorHullAlias(frameKey),
            hullKey,
            toEditorHullAlias(hullKey),
            'atlas'
          ];
    
          for (const candidate of candidates) {
            const keys = getEditorHullConfigKeys(candidate);
            for (const key of keys) {
