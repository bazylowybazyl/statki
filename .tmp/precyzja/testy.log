              }
              const _rawDmg = Number.isFinite(b.damage) ? b.damage : 0;
              // CIWS/laser_pd: 100% vs myśliwce, 20% vs hull/tarcza statków
              const _isCIWSBullet = b.type === 'ciws';
              const _isFighterTarget = !!(hitNPC.fighter || hitNPC.type === 'fighter');
              const npcDamage = (_isCIWSBullet && !_isFighterTarget) ? _rawDmg * 0.2 : _rawDmg;
    
              // === FAILSAFE ===
              // Jeśli tarcza jest aktywna, ale z jakiegoś powodu matematyka elipsy zawiodła (np. lag, tunelowanie),
