          if (current > target) return Math.max(target, current - delta);
          return target;
        }
    
        function updateEnginePower(dt) {
          if (ship.destroyed) {
            enginePower.target = 0;
            enginePower.current = 0;
            input.main = 0;
            return;
          }
          if (ship.agility && ship.agility.active) {
            enginePower.target = 0;
            enginePower.current = approachValue(enginePower.current, 0, 6.0 * dt);
            input.main = 0;
            return;
          }
          const manualInput = playerHasManualInput();
          if (ship.command && !manualInput && !PAUSED && warp.state === 'idle') {
            enginePower.target = Math.max(clamp(input.main, 0, 1), clamp(input.retro || 0, 0, 1) * 0.92);
            enginePower.current = enginePower.target;
            return;
          }
          if (camera.mode === 'rts') {
            enginePower.target = 0;
            enginePower.current = 0;
            input.main = 0;
            input.retro = 0;
            return;
          }
    
          // Reaktywny pasek mocy:
          // W = 100% mocy, brak ciągu = 0%.
          // S / reverse to hamulec, więc nie podbijają mocy głównych silników.
          // Gamepad: left stick Y (forward) also drives engine power.
          const reverseInput = Math.max(
            clamp(Number(ship?.thrusterInput?.retro) || 0, 0, 1),
            clamp(Number(input?.retro) || 0, 0, 1)
          );
          const brakeHeld = !!keys['s'] || reverseInput > 0.05;
          let target = 0;
          if (keys['w'] && !brakeHeld) target = 1.0;
    
          // Gamepad forward thrust should come from the real pad state, not from ship.thrusterInput,
          // bo to tworzy pętlę sprzężenia zwrotnego po puszczeniu W.
          const gamepadMain = getP1GamepadForwardInput();
          if (!brakeHeld) target = Math.max(target, gamepadMain);
    
          enginePower.target = target;
    
          if (brakeHeld && enginePower.target <= 1e-3) {
            enginePower.current = 0;
            input.main = 0;
            return;
          }
    
          // Szybka reakcja paska (6.0), żeby wizualnie pasowało do nowej fizyki
          enginePower.current = approachValue(enginePower.current, enginePower.target, 6.0 * dt);
          input.main = enginePower.current;
        }
    
        function updateAgilityLogic(dt, mouseWorld) {
          const ag = ship.agility;
          if (!ag) return;
    
          // 1. Zmniejszanie cooldownów
          if (ag.cooldowns.dash > 0) ag.cooldowns.dash -= dt;
          if (ag.cooldowns.strafe > 0) ag.cooldowns.strafe -= dt;
          if (ag.cooldowns.arc > 0) ag.cooldowns.arc -= dt;
    
          if (!ag.active) {
            ag.arcCharge = 0;
            ag.lastPivot = null;
            return;
          }
    
          // Wyznaczanie punktu obrotu (Pivot)
          let currentPivot = null;
          if (isTargetAlive(lockedTarget)) {
            const lockPoint = scannerTargetPoint(lockedTarget);
            currentPivot = { x: lockPoint.x, y: lockPoint.y, isEntity: true, ref: lockedTarget };
          } else if (mouseWorld) {
            currentPivot = { x: mouseWorld.x, y: mouseWorld.y, isEntity: false, ref: null };
          }
    
          // 2. Jeśli trwa aktywny manewr łuku (Arc Maneuver) - ZARZĄDZAJ LOTEM
          if (ag.maneuver) {
            const m = ag.maneuver;
    
            // Przerwij manewr, jeśli zakotwiczyliśmy go na statku, a ten wybuchł
            if (m.isEntity && m.target && !isTargetAlive(m.target)) {
              ag.maneuver = null;
              return;
            }
    
            m.elapsed += dt;
            let t = m.elapsed / m.duration;
            if (t >= 1) {
              t = 1;
              ag.maneuver = null; // Zakończ manewr
            }
    
            // Płynne przyspieszanie i zwalnianie (Ease In/Out)
            const easeT = t * t * (3 - 2 * t);
            const currentAngle = m.startAngle + m.totalAngle * easeT;
    
            // Aktualizuj punkt docelowy
            const pivotX = m.isEntity ? m.target.x : m.staticX;
            const pivotY = m.isEntity ? m.target.y : m.staticY;
    
            const targetX = pivotX + Math.cos(currentAngle) * m.radius;
            const targetY = pivotY + Math.sin(currentAngle) * m.radius;
    
            // Kinematyczne przejęcie pędu - teraz statek porusza się dostojniej
            ship.vel.x = (targetX - ship.pos.x) / dt;
            ship.vel.y = (targetY - ship.pos.y) / dt;
    
            // Zawsze patrz nosem w punkt obrotu
            ship.angle = Math.atan2(pivotY - ship.pos.y, pivotX - ship.pos.x);
            ship.angVel = 0;
    
            // Mniej agresywne efekty dymu (bo statek leci wolniej)
            spawnParticle(ship.pos, { x: -ship.vel.x * 0.15, y: -ship.vel.y * 0.15 }, 0.3, '#66ffcc', 3, true);
            return;
          }
    
          if (isRtsModeActive()) {
            ag.arcCharge = 0;
            ag.lastPivot = null;
            return;
          }
    
          // 3. Ladowanie umiejetnosci luku (A / D)
          if ((keys['a'] || keys['d']) && ag.cooldowns.arc <= 0 && currentPivot) {
            ag.arcDir = keys['d'] ? 1 : -1;
    
            // ZWOLNIONE LADOWANIE: zajmie ok. 1.25s, zeby zaladowac maksa
            const chargeRate = Math.PI * 0.8;
    
            // LIMIT 180 STOPNI (Math.PI to dokładnie pół okręgu)
            ag.arcCharge = Math.min(Math.PI, ag.arcCharge + chargeRate * dt);
            ag.lastPivot = currentPivot;
          } else if (ag.arcCharge > 0) {
            // Puszczono klawisz - WYKONAJ MANEWR
            const finalPivot = ag.lastPivot || currentPivot;
    
            if (finalPivot) {
              const dx = ship.pos.x - finalPivot.x;
              const dy = ship.pos.y - finalPivot.y;
              const radius = Math.hypot(dx, dy);
    
              if (radius > 20) {
                ag.maneuver = {
                  isEntity: finalPivot.isEntity,
                  target: finalPivot.ref,
                  staticX: finalPivot.x,
                  staticY: finalPivot.y,
                  startAngle: Math.atan2(dy, dx),
                  totalAngle: ag.arcCharge * ag.arcDir,
                  radius: radius,
                  elapsed: 0,
                  // ZWOLNIONY FIZYCZNIE LOT (pełne 180 stopni potrwa ~1.8 sekundy)
                  duration: Math.max(0.4, Math.abs(ag.arcCharge) / (Math.PI * 0.55))
                };
    
                ag.cooldowns.arc = ag.maxCooldowns.arc;
