        function getNpcHullRenderProfileId(npc) {
          const shipFrameId = resolveHullRenderProfileId(npc?.shipFrame);
          if (shipFrameId && shipFrameId !== 'atlas' && String(npc?.shipFrame || '').trim()) return shipFrameId;
          const type = String(npc?.type || '').toLowerCase();
          if (FREIGHTER_HULL_BY_TYPE[type]) return FREIGHTER_HULL_BY_TYPE[type];
          if (type === 'battleship') return npc?.isPirate ? 'pirate_battleship' : 'terran_battleship';
          if (type === 'destroyer') return npc?.isPirate ? 'pirate_destroyer' : 'terran_destroyer';
          if (type.includes('frigate')) return npc?.isPirate ? 'pirate_frigate' : 'terran_frigate';
          if (type === 'megafreighter' || type.startsWith('megafreighter_')) return 'megafreighter';
          if (type === 'atlas') return 'atlas';
          if (type === 'supercapital') return 'terran_supercapital';
          if (type === 'carrier') return 'terran_carrier';
          if (type === 'capital_carrier') return 'capital_carrier';
          if (npc?.isCapitalShip) return 'terran_carrier';
          return null;
        }
    
        function assignNpcShipFrame(npc) {
