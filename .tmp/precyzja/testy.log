          zones.push({
            key: 'sun',
            id: 'sun',
            label: 'Sun',
            enteringLabel: 'Entering Sun',
            edgeDist: sunEdge,
            approachRange: ZONE_APPROACH_DISTANCE,
            priority: zonePriority.sun
          });
    
          if (ASTEROID_BELT) {
