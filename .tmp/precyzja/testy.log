                // tarczy w górze odcinek kończy się zwykle przed kadłubem (puste pudło).
                let sweepLimit = hitT < 1 ? hitT : 1;
                if (shieldT >= 0 && shieldT < sweepLimit) sweepLimit = shieldT;
                let hexSweep = null;
                if (sweepLimit >= 1) {
                  hexSweep = DestructorSystem.sweepImpact(realNpc, b.px, b.py, b.x, b.y, bulletR);
                } else if (sweepLimit > 0) {
                  hexSweep = DestructorSystem.sweepImpact(realNpc, b.px, b.py,
                    b.px + (b.x - b.px) * sweepLimit, b.py + (b.y - b.py) * sweepLimit, bulletR);
                }
                hullT = hexSweep ? (sweepLimit >= 1 ? hexSweep.t : hexSweep.t * sweepLimit) : -1;
                hullIsHex = hullT >= 0;
                if (hexSweep) {
                  hullImpactX = hexSweep.worldX;
                  hullImpactY = hexSweep.worldY;
                  // Wynik sweepa jest statyczny — następny kandydat go nadpisze.
                  hullShard = hexSweep.hitShard;
                }
              }
    
              let candidateT = hullT;
              let candidateShield = false;
              let candidateImpactX = hullImpactX;
              let candidateImpactY = hullImpactY;
              if (shieldT >= 0 && (candidateT < 0 || shieldT <= candidateT)) {
                candidateT = shieldT;
                candidateShield = true;
                candidateImpactX = b.px + (b.x - b.px) * shieldT;
                candidateImpactY = b.py + (b.y - b.py) * shieldT;
              }
              if (candidateT < 0 || candidateT >= hitT) continue;
    
              hitT = candidateT;
              hitNPC = npc;
              didHitShield = candidateShield;
              didHitHex = !candidateShield && hullIsHex;
              hitHexShard = didHitHex ? hullShard : null;
              hitX = candidateImpactX;
              hitY = candidateImpactY;
            }
    
            if (hitNPC) {
              // Flak trafiony bezpośrednio (np. w tarczę, zanim zadziałał zapalnik)
              // i tak pęka — obrażenia rozchodzą się jako odłamki, nie jako trafienie.
              if (b.type === 'flak' && b.flakBurstRadius) {
                b.x = hitX;
                b.y = hitY;
                detonateFlakShell(b);
                removeBulletAt(i);
                if (profileBullet) secNpcHit += (performance.now() - tBulletSection0) * bulletProfileScale;
                continue;
              }
              const _rawDmg = Number.isFinite(b.damage) ? b.damage : 0;
              // CIWS/laser_pd: 100% vs myśliwce, 20% vs hull/tarcza statków
              const _isCIWSBullet = b.type === 'ciws';
              const _isFighterTarget = !!(hitNPC.fighter || hitNPC.type === 'fighter');
              const npcDamage = (_isCIWSBullet && !_isFighterTarget) ? _rawDmg * 0.2 : _rawDmg;
    
              // === FAILSAFE ===
              // Jeśli tarcza jest aktywna, ale z jakiegoś powodu matematyka elipsy zawiodła (np. lag, tunelowanie),
              // a pocisk trafił w fizyczny heks w środku -> WYMUSZAMY trafienie w tarczę.
              const shieldActive = isEntityShieldBlocking(hitNPC);
    
              // Czy trafiono w fizyczny kadłub?
              let hexHit = false;
              if (didHitShield) {
                // Swept shield hit is already definitive; probing the hex body here
                // doubled the narrowphase cost of the common shielded-hit path.
                hexHit = false;
              } else if (didHitHex) {
                hexHit = true;
              } else if (hitNPC.hexGrid) {
                // Sprawdzamy kolizję z heksem, ale na razie bez zadawania obrażeń (damage=0),
                // żeby nie zranić statku pod tarczą.
                hexHit = (typeof DestructorSystem.probeImpact === 'function')
                  ? DestructorSystem.probeImpact(hitNPC, hitX, hitY)
                  : DestructorSystem.applyImpact(hitNPC, hitX, hitY, 0, { x: 0, y: 0 });
              } else {
                // Dla małych statków bez heksów, uznajemy że trafienie w ogóle (isHit) to trafienie w kadłub
                hexHit = true;
              }
    
              // Rozstrzygniecie: TARCZA CZY KADLUB?
              if (shieldActive && (didHitShield || hexHit)) {
                // Jeśli tarcza działa ORAZ (trafiono w elipsę LUB trafiono w kadłub) -> TARCZA BLOKUJE
    
                registerShieldImpact(hitNPC, hitX, hitY, npcDamage, shieldFxClassForBullet(b));
                if (window.AudioSys) AudioSys.playSound('shieldHit');
    
                // Odejmij HP tarczy
                const absorbed = Math.min(hitNPC.shield.val, npcDamage);
                hitNPC.shield.val -= absorbed;
                hitNPC.shield.regenTimer = hitNPC.shield.regenDelay || 3.0;
    
                // ZATRZYMAJ I USUN POCISK
                removeBulletAt(i);
                if (profileBullet) secNpcHit += (performance.now() - tBulletSection0) * bulletProfileScale;
                continue;
    
              } else if (!shieldActive && hexHit) {
                // Tarcza nie działa, trafiono w kadłub -> OBRAŻENIA
    
                // Obrażenia w heks trafiony przez sweep (bez niego — sonda w punkcie trafienia)
                if (hitNPC.hexGrid) {
                  applyHexImpact(hitNPC._realEntity || hitNPC, hitX, hitY, npcDamage, { x: b.vx, y: b.vy }, hitHexShard);
                  // Kierunek wyrzutu atmosfery, gdy padnie mostek (tunel ostrzału).
                  noteBridgeHit(hitNPC._realEntity || hitNPC, hitX, hitY, b.vx, b.vy, bridgeSimTime);
                }
    
                // Routing obrażeń: gracz vs NPC
                if (hitNPC._isPlayerShip) {
                  applyDamageToPlayer(npcDamage);
                } else {
                  if (b.owner === 'player' || b.owner === 'player2') markPlayerDamage(hitNPC);
                  applyDamageToNPC(hitNPC, npcDamage, b.type);
                }
    
                spawnBulletImpactEffect(b, hitX, hitY, 1.0);
    
                if (shouldRemoveProjectileAfterImpact(b, !!hitNPC.hexGrid)) removeBulletAt(i);
                if (profileBullet) secNpcHit += (performance.now() - tBulletSection0) * bulletProfileScale;
                continue;
              } else {
                // Pocisk minął wszystko (np. dziura we wraku, albo minął tarczę gdy była wyłączona)
                hitNPC = null;
                if (profileBullet) secNpcHit += (performance.now() - tBulletSection0) * bulletProfileScale;
                continue;
              }
            }
            if (profileBullet) secNpcHit += (performance.now() - tBulletSection0) * bulletProfileScale;
    
            tBulletSection0 = profileBullet ? performance.now() : 0;
            // --- KOLIZJE Z ASTEROIDAMI (swept hit -> lazy hex promotion) ---
            if (!hitNPC && window.asteroidField?.raycast && window.asteroidField?.applyDamageAt) {
              const segX0 = Number.isFinite(b.px) ? b.px : b.x;
              const segY0 = Number.isFinite(b.py) ? b.py : b.y;
              const segX1 = b.x;
              const segY1 = b.y;
              const astHit = window.asteroidField.raycast(segX0, segY0, segX1, segY1, b.r || 0);
    
              if (astHit?.asteroid?.alive) {
                const tAst = Math.max(0, Math.min(1, Number(astHit.hitT ?? astHit.t) || 0));
                const hitX = segX0 + (segX1 - segX0) * tAst;
                const hitY = segY0 + (segY1 - segY0) * tAst;
                const astDamage = Number.isFinite(b.damage) ? b.damage : 0;
                const astResult = window.asteroidField.applyDamageAt(astHit.asteroid, hitX, hitY, astDamage, { x: b.vx, y: b.vy });
    
                if (astResult?.hit || astResult?.destroyed) {
                  spawnBulletImpactEffect(b, hitX, hitY, 0.9);
    
                  if (shouldRemoveProjectileAfterImpact(b, true)) removeBulletAt(i);
                  if (profileBullet) secAst += (performance.now() - tBulletSection0) * bulletProfileScale;
                  continue;
                }
              }
            }
            if (profileBullet) secAst += (performance.now() - tBulletSection0) * bulletProfileScale;
    
            tBulletSection0 = profileBullet ? performance.now() : 0;
            // --- KOLIZJE Z RINGIEM PLANETARNYM (swept hit, bez wrzucania ringu do glownego SpatialGrid) ---
            if (!hitNPC) {
              const segX0 = Number.isFinite(b.px) ? b.px : b.x;
              const segY0 = Number.isFinite(b.py) ? b.py : b.y;
              const segX1 = b.x;
              const segY1 = b.y;
              const vxSweep = segX1 - segX0;
              const vySweep = segY1 - segY0;
              const vvSweep = vxSweep * vxSweep + vySweep * vySweep;
              const sweepLen = Math.sqrt(vvSweep);
              const searchRadius = Math.max(120, (b.r || 0) + sweepLen + 48);
              const ringSearch = getPotentialPlanetaryRingTargets(b.x, b.y, searchRadius);
              const ringBuf = ringSearch.buffer;
              const ringCount = ringSearch.count;
              let ringHit = null;
              let ringHitX = b.x;
              let ringHitY = b.y;
    
              for (let k = 0; k < ringCount; k++) {
                const seg = ringBuf[k];
                if (!seg || seg.dead || seg.isCollidable === false) continue;
                if (b.source && b.source === seg) continue;
    
                const tx = Number(seg.x) || 0;
                const ty = Number(seg.y) || 0;
                const hitR = (Number(seg.radius) || 80) + (Number(b.r) || 0);
                let tSweep = 0;
                if (vvSweep > 1e-6) {
                  tSweep = ((tx - segX0) * vxSweep + (ty - segY0) * vySweep) / vvSweep;
                  tSweep = Math.max(0, Math.min(1, tSweep));
                }
                const cx = segX0 + vxSweep * tSweep;
                const cy = segY0 + vySweep * tSweep;
                const dx = tx - cx;
                const dy = ty - cy;
                if (dx * dx + dy * dy > hitR * hitR) continue;
    
                // Precyzyjny test trafienia po heksach (usuwa "niewidzialne" hitboxy w szczelinie ringu)
                const hasRealHexHit = (typeof DestructorSystem.probeImpact === 'function')
                  ? DestructorSystem.probeImpact(seg, cx, cy)
                  : DestructorSystem.applyImpact(seg, cx, cy, 0, { x: 0, y: 0 });
                if (!hasRealHexHit) continue;
    
                ringHit = seg;
                ringHitX = cx;
                ringHitY = cy;
                break;
              }
    
              if (ringHit) {
                const ringDamage = Number.isFinite(b.damage) ? b.damage : 0;
                DestructorSystem.applyImpact(ringHit, ringHitX, ringHitY, ringDamage, { x: b.vx, y: b.vy });
    
                spawnBulletImpactEffect(b, ringHitX, ringHitY, 0.95);
    
                if (shouldRemoveProjectileAfterImpact(b, true)) removeBulletAt(i);
                if (profileBullet) secRing += (performance.now() - tBulletSection0) * bulletProfileScale;
                continue;
              }
            }
            if (profileBullet) secRing += (performance.now() - tBulletSection0) * bulletProfileScale;
    
            tBulletSection0 = profileBullet ? performance.now() : 0;
            // --- KOLIZJE Z INNYMI OBIEKTAMI ---
            if (stepPlatformCount > 0) {
              let hitPlatform = false;
              for (let pi = 0; pi < stepPlatformCount; pi++) {
                const p = _bulletStepPlatforms[pi];
                if (p && !p.destroyed && b.source !== p) {
                  const pdx = p.x - b.x;
                  const pdy = p.y - b.y;
                  const pr = p.radius + b.r;
                  if (pdx * pdx + pdy * pdy >= pr * pr) continue;
                  const platShielded = isEntityShieldBlocking(p);
                  applyDamageToPlatform(p, b.damage || 0);
                  triggerMercAggro('platform_hit');
                  if (platShielded) registerShieldImpact(p, b.x, b.y, b.damage || 0, shieldFxClassForBullet(b));
                  else spawnBulletImpactEffect(b, b.x, b.y, 1.0);
                  removeBulletAt(i);
                  hitPlatform = true;
                  break;
                }
              }
              // Pocisk zdjęty — nie sprawdzaj stacji tym samym (usuniętym) pociskiem.
              if (hitPlatform) {
                if (profileBullet) secMisc += (performance.now() - tBulletSection0) * bulletProfileScale;
                continue;
              }
            }
            for (let si = 0; si < stepStationCount; si++) {
              const st = _bulletStepStations[si];
              if (st.hp && !st._destroyed3D && b.source !== st) {
                const sdx = st.x - b.x;
                const sdy = st.y - b.y;
                const collisionR = (st.hitR || st.r) + b.r;
                if (sdx * sdx + sdy * sdy >= collisionR * collisionR) continue;
                const stShielded = isEntityShieldBlocking(st);
                applyDamageToStation(st, b.damage || 0);
                if (mercMission?.station === st) triggerMercAggro('station_hit');
                if (stShielded) registerShieldImpact(st, b.x, b.y, b.damage || 0, shieldFxClassForBullet(b));
                else spawnBulletImpactEffect(b, b.x, b.y, 1.0);
                removeBulletAt(i);
                break;
              }
            }
            if (profileBullet) secMisc += (performance.now() - tBulletSection0) * bulletProfileScale;
          }
    
          PerfHUD.addTiming('bulletMoveVfxTime', secMoveVfx);
          PerfHUD.addTiming('bulletInterceptTime', secIntercept);
          PerfHUD.addTiming('bulletNpcHitTime', secNpcHit);
          PerfHUD.addTiming('bulletAsteroidTime', secAst);
          PerfHUD.addTiming('bulletRingTime', secRing);
          PerfHUD.addTiming('bulletMiscHitTime', secMisc);
        }
        // =============== NPC movement/shooting ===============
        let npcFireTimer = 0;
        function npcShootingStep(dt) {
          let npcFireScanMs = 0;
          let npcFireSpawnMs = 0;
          npcFireTimer -= dt;
          if (npcFireTimer <= 0) {
            npcFireTimer = 0.45 + Math.random() * 0.8;
            let shooter = null;
            let seen = 0;
            const tNpcFireScan0 = performance.now();
            for (let i = 0; i < npcs.length; i++) {
              const n = npcs[i];
              if (!n || n.dead || !n.weapon || n.friendly) continue;
              const dx = n.x - ship.pos.x;
              const dy = n.y - ship.pos.y;
              if (dx * dx + dy * dy >= 900 * 900) continue;
              seen++;
              if (Math.random() * seen < 1) shooter = n;
            }
            npcFireScanMs = performance.now() - tNpcFireScan0;
            if (shooter) {
              const tNpcFireSpawn0 = performance.now();
              const dx = ship.pos.x - shooter.x;
              const dy = ship.pos.y - shooter.y;
              const len = Math.hypot(dx, dy) || 1;
              const dirX = dx / len;
              const dirY = dy / len;
              const bx = shooter.x + dirX * (shooter.radius + 6), by = shooter.y + dirY * (shooter.radius + 6);
              if (shooter.weapon === 'railgun') {
                window.bullets.push({ x: bx, y: by, vx: dirX * 600 + shooter.vx, vy: dirY * 600 + shooter.vy, life: 2.0, r: 4, owner: 'npc', damage: 40, type: 'rail', penetration: 1, source: shooter });
              } else {
                window.bullets.push({ x: bx, y: by, vx: dirX * 220 + shooter.vx, vy: dirY * 220 + shooter.vy, life: 4, r: 3, owner: 'npc', damage: 12, source: shooter });
              }
              npcFireSpawnMs = performance.now() - tNpcFireSpawn0;
            }
          }
          window.__npcFireScanMs = (window.__npcFireScanMs || 0) + npcFireScanMs;
          window.__npcFireSpawnMs = (window.__npcFireSpawnMs || 0) + npcFireSpawnMs;
        }
        // Każdy NPC podejmuje decyzję 20 razy/s, ale flota jest rozłożona na fazy
        // kolejnych podkroków. Dzięki temu 189 mózgów nie budzi się w jednej klatce.
        // INTEGRACJA nadal działa w każdym podkroku — inaczej myśliwiec przy 3400 u/s
        // skakałby ~70 u naraz i pociski (16 u/podkrok) zaczęłyby go mijać.
        function npcStep(dt, aiDbg = null, runAiMaintenance = true, brainDt = dt, brainPhase = 0, brainPhaseCount = 1) {
          const DESPAWN_RADIUS_SQ = NPC_DESPAWN_RADIUS * NPC_DESPAWN_RADIUS;
          const frameNorm = dt / BASE_FRAME_DT;
          const phaseCount = Math.max(1, brainPhaseCount | 0);
          const phase = Math.max(0, brainPhase | 0) % phaseCount;
          let layoutChanged = false;
          if (runAiMaintenance) {
            layoutChanged = pollNpcEditorLayoutCache(brainDt);
            // Odroczone starty myśliwców z hangarów NPC — dopisz do npcs PRZED budową
            // grida i pętlą AI (spawn w trakcie iteracji npcs[] byłby ryzykowny).
            flushCarrierSpawns(brainDt);
            // Build AI spatial grid ONCE per 20 Hz cycle for all phased AI queries
            // (separation, weapon scan, target pick, dogfight neighbors).
            // Cost: ~0.05ms for 200 entities. Saves 50-90ms in O(N²) hot loops.
            const tAiGrid0 = performance.now();
            if (window.rebuildAIGrid) window.rebuildAIGrid(npcs, true);
            window.__aiGridMs = (window.__aiGridMs || 0) + (performance.now() - tAiGrid0);
            // Koordynator bitewny: sloty linii walki + flankowania dla capitali
            // (throttling wewnątrz — pełny rebuild co ~0.45s).
            if (window.updateFleetCoordinator) {
              const tCoord0 = performance.now();
              window.updateFleetCoordinator(npcs, ship, brainDt);
              window.__aiCoordMs = (window.__aiCoordMs || 0) + (performance.now() - tCoord0);
            }
          }
          let measuredAiMs = 0;
          for (const npc of npcs) {
            if (runAiMaintenance && (layoutChanged || npc.__editorLayoutVersion !== npcHardpointRuntime.version)) {
              applyEditorLayoutToNpc(npc);
            }
            if (npc.hitFlash) npc.hitFlash = Math.max(0, npc.hitFlash - dt);
            updateShieldFx(npc, dt);
    
            if (npc.shield && npc.shield.max > 0) {
              if (npc.shield.regenTimer > 0) {
                npc.shield.regenTimer = Math.max(0, npc.shield.regenTimer - dt);
              } else if (npc.shield.val < npc.shield.max) {
                npc.shield.val = Math.min(npc.shield.max, npc.shield.val + (npc.shield.regenRate || 0) * dt);
              }
            }
    
            if (npc.fleetEntry && npc.fleetEntry.status) {
              const status = npc.fleetEntry.status;
              const nextHull = Math.max(0, npc.hp || 0);
              const nextShield = Math.max(0, npc.shield?.val || 0);
              if (Math.abs((status.hull ?? 0) - nextHull) > 0.5 || Math.abs((status.shield ?? 0) - nextShield) > 0.5) {
                status.hull = nextHull;
                status.shield = nextShield;
              }
            }
    
            // Despawn logic (poza misją)
            if (!npc.mission && !npc.isCargoVan) {
              const dx = npc.x - ship.pos.x;
              const dy = npc.y - ship.pos.y;
              if (dx * dx + dy * dy > DESPAWN_RADIUS_SQ) {
                npc.dead = true;
                npc.respawnTimer = 5;
                continue;
              }
            }
    
            // Hulk po utracie mostka: bez AI, broni i ciągu — dryf, po agonii wrak.
            if (isBridgeHulk(npc)) {
              if (!npc.dead && stepBridgeHulk(npc, dt, bridgeSimTime)) finishBridgeKill(npc);
              continue;
            }
    
            // --- LOGIKA MISJI I WALKI ---
            if (npc.mission) {
              if (npc.dead) continue;
              npc.__npcFlightIntegrated = false;
    
              if (npc.state === 'warping_in' && npc.warpData) {
                const dx = npc.warpData.targetX - npc.x;
                const dy = npc.warpData.targetY - npc.y;
                const dist = Math.hypot(dx, dy);
    
                if (dist < npc.warpData.brakingDist) {
                  npc.state = 'engage_formation';
                  npc.isCollidable = true;
                  npc.vx *= 0.1;
                  npc.vy *= 0.1;
                  spawnShockwave(npc.x, npc.y, { maxR: 600, maxLife: 0.5, color: 'rgba(255, 100, 100,' });
                  if (npc.type === 'battleship') camera.addShake(8, 0.4);
                  else camera.addShake(3, 0.2);
                  npc.warpData = null;
                } else {
                  const dirX = dx / dist;
                  const dirY = dy / dist;
    
                  npc.vx = dirX * npc.warpData.speed;
                  npc.vy = dirY * npc.warpData.speed;
                  npc.desiredAngle = Math.atan2(npc.vy, npc.vx);
                  npcRotationStep(npc, dt, frameNorm);
    
                  spawnParticle(
                    { x: npc.x, y: npc.y },
                    { x: -dirX * 500, y: -dirY * 500 },
                    0.2, '#ffaaaa', 4, false
                  );
    
                  npc.x += npc.vx * dt;
                  npc.y += npc.vy * dt;
                  continue;
                }
              }
    
              // 1. Komendy RTS (priorytet)
              if (handleCommandedNpc(npc, dt)) {
                if (npc.__npcFlightIntegrated) {
                  npc.__npcFlightIntegrated = false;
                  continue;
                }
                if (usesShipFlightModel(npc)) {
                  stepShipFlight(npc, dt);
                  continue;
                }
                // Tarcie „na krok 1/120 s” (stepDecay120 / ?physHz).
                const npcDrag = stepDecay120(npc.friction || 0.99, dt);
                npc.vx *= npcDrag;
                npc.vy *= npcDrag;
                npc.x += (npc.vx || 0) * dt;
                npc.y += (npc.vy || 0) * dt;
                if (Math.hypot(npc.vx || 0, npc.vy || 0) > 1) {
                  npc.desiredAngle = Math.atan2(npc.vy || 0, npc.vx || 0);
                }
                npcRotationStep(npc, dt, frameNorm);
                continue;
              }
    
              // 2. AI — stabilny kubełek fazowy; każdy NPC trafia tu raz na 6 ticków.
              const npcBrainDue = phaseCount === 1 || (sepUid(npc) % phaseCount) === phase;
              if (npcBrainDue && npc.ai) {
                const tAi0 = performance.now();
                npc.ai(brainDt);
                const aiMs = performance.now() - tAi0;
                measuredAiMs += aiMs;
                if (npc.friendly) window.__aiNpcFriendlyBrainMs = (window.__aiNpcFriendlyBrainMs || 0) + aiMs;
                else window.__aiNpcEnemyBrainMs = (window.__aiNpcEnemyBrainMs || 0) + aiMs;
                if (aiDbg?.enabled) {
                  aiDbg.record('npcBrain', aiMs);
                  const role = npc.isPirate
                    ? `pirate:${npc.type || 'npc'}`
                    : npc.friendly
                      ? `friendly:${npc.type || 'npc'}`
                      : `npc:${npc.type || 'npc'}`;
                  aiDbg.record(role, aiMs);
                }
              }
    
              if (npc.__npcFlightIntegrated) {
                npc.__npcFlightIntegrated = false;
                continue;
              }
    
              // 3a. Okręty (fregata → superkapitał): pilot + integrator KAŻDY tick,
              // według specyfikacji kadłuba. Mózg (wyżej, raz na 6 ticków) tylko
              // ustawia intencję — nie całkuje ruchu, więc nie ma już dwóch
              // integratorów na zmianę (pozycja szła 1,83× szybciej niż prędkość,
              // a dwa sterowniki obrotu szarpały kadłubem).
              if (usesShipFlightModel(npc)) {
                stepShipFlight(npc, dt);
                continue;
              }
    
              // 3. Fizyka (Ruch) — myśliwce i reszta bytów bez modelu lotu.
              // NaN recovery — if AI produced NaN velocity, reset to zero
              if (!Number.isFinite(npc.vx)) npc.vx = 0;
              if (!Number.isFinite(npc.vy)) npc.vy = 0;
              npc.x += npc.vx * dt;
              npc.y += npc.vy * dt;
    
              // --- FIZYKA PEDU (FRICTION) ---
              // Używamy friction z szablonu (np. 0.995 dla Destroyera - płynie długo)
              // lub domyślnego 0.92 dla małych/lekkich obiektów, żeby nie latały jak mydło.
              // Współczynnik jest „na krok 1/120 s” — przy innym kroku (?physHz)
              // stepDecay120 daje ten sam zanik na sekundę.
              const friction = stepDecay120(npc.friction || 1.0, dt);
    
              npc.vx *= friction;
              npc.vy *= friction;
    
              // 4. Obrót (obrót z limitem przyspieszenia, jak "wciśnięcie A/D")
              npcRotationStep(npc, dt, frameNorm);
              continue;
            }
    
            // --- LOGIKA CYWILNA (Reszta funkcji bez zmian) ---
            if (npc.dead) {
              // Rekord transportowy obsługuje śmierć atomowo i usuwa widok; pusty
              // frachtowiec nie może odrodzić się jako niezależny cywil.
              if (npc.isCargoVan) continue;
              npc.respawnTimer -= dt;
              if (npc.respawnTimer <= 0) {
                const base = stations.find(s => s.id === npc.lastStation) || stations[0];
                const group = stations.filter(s => s.inner === base.inner);
                const start = group[Math.floor(Math.random() * group.length)] || base;
                const targetId = pickNextStation(start.id, npc.type);
                npc.hp = npc.maxHp;
                npc.dead = false;
                if (!beginStationTransit(npc, start, targetId)) {
                  npc.dead = true;
                  npc.respawnTimer = 5;
                }
              }
              continue;
            }
            if (npc.docking) {
              const st = stations.find(s => s.id === npc.lastStation);
              if (st) { const portPos = stationPortWorld(st, npc.dockPort || 0); npc.x = portPos.x; npc.y = portPos.y; }
              if (npc.isCargoVan) {
                npc.vx = 0;
                npc.vy = 0;
                npc.fade = 1;
                continue;
              }
              npc.fade -= dt / 0.6;
              if (npc.fade <= 0 && st) {
                const targetId = pickNextStation(npc.lastStation, npc.type);
                if (!beginStationTransit(npc, st, targetId)) {
                  npc.fade = 0;
                  npc.docking = true;
                }
              }
              continue;
            }
            if (npc.phase === 'warping') {
              npc.x += npc.vx * dt; npc.y += npc.vy * dt;
              if (npc.vx * npc.vx + npc.vy * npc.vy > 25) {
                npc.desiredAngle = Math.atan2(npc.vy || 0, npc.vx || 0);
              }
              npcRotationStep(npc, dt, frameNorm);
              const route = npc.warpRoute;
              const traveled = (npc.x - route.start.x) * route.dir.x + (npc.y - route.start.y) * route.dir.y;
              if (traveled >= route.length) {
                npc.phase = 'toStation';
                npc.x = route.end.x;
                npc.y = route.end.y;
                npc.vx = 0;
                npc.vy = 0;
              }
              continue;
            }
            if (npc.phase === 'toGate') {
              const gate = npc.warpRoute.start;
              const start = stations.find(s => s.id === npc.lastStation);
              const gv = { x: gate.x - start.x, y: gate.y - start.y };
              const gd = Math.hypot(gv.x, gv.y) || 1;
              const dirToGate = { x: gv.x / gd, y: gv.y / gd };
              const perp = { x: -dirToGate.y, y: dirToGate.x };
              const laneOffset = npc.lane ? 20 : -20;
              const gatePos = { x: gate.x + perp.x * laneOffset, y: gate.y + perp.y * laneOffset };
              const queue = gate.queues[npc.lane];
              let idx = queue.indexOf(npc);
              if (idx === -1) { queue.push(npc); idx = queue.length - 1; }
              const spacing = 30;
              const targetPos = { x: gatePos.x - dirToGate.x * idx * spacing, y: gatePos.y - dirToGate.y * idx * spacing };
              const distGate = Math.hypot(npc.x - gatePos.x, npc.y - gatePos.y);
              if (idx === 0 && distGate < 5) {
                queue.shift(); npc.phase = 'warping';
                npc.vx = npc.warpRoute.dir.x * 4000; npc.vy = npc.warpRoute.dir.y * 4000;
                npc.x = gatePos.x; npc.y = gatePos.y;
                continue;
              }
              const to = { x: targetPos.x - npc.x, y: targetPos.y - npc.y };
              const d = Math.hypot(to.x, to.y);
              if (d < 1) { npc.vx = 0; npc.vy = 0; continue; }
              const dir = { x: to.x / d, y: to.y / d };
              const desiredV = { x: dir.x * npc.speed, y: dir.y * npc.speed };
              npc.vx += (desiredV.x - (npc.vx || 0)) * clamp(1.5 * dt, 0, 1);
              npc.vy += (desiredV.y - (npc.vy || 0)) * clamp(1.5 * dt, 0, 1);
              npc.x += npc.vx * dt;
              npc.y += npc.vy * dt;
              npcRotationStep(npc, dt, frameNorm);
              continue;
            }
            let targetPos, st = null;
            if (npc.leader != null) {
              const leader = npcs.find(n => n.id === npc.leader && !n.dead);
              if (leader) {
                targetPos = { x: leader.x + Math.cos(npc.orbitAngle) * npc.orbitRadius, y: leader.y + Math.sin(npc.orbitAngle) * npc.orbitRadius };
              } else { npc.leader = null; }
            }
            if (!targetPos) {
              st = stations.find(s => s.id === npc.target);
              if (!st) {
                npc.target = pickNextStation(npc.lastStation, npc.type);
                continue;
              }
              if (npc.phase === 'toStation') { targetPos = stationPortWorld(st, npc.dockPort || 0); }
              else { targetPos = { x: st.x, y: st.y }; }
            }
            const to = { x: targetPos.x - npc.x, y: targetPos.y - npc.y };
            const d = Math.hypot(to.x, to.y);
            const dir = d ? { x: to.x / d, y: to.y / d } : { x: 0, y: 0 };
            const desiredSpeed = npc.leader != null ? npc.speed : npc.speed * (d < 120 ? (d / 120) : 1);
            const desiredV = { x: dir.x * desiredSpeed, y: dir.y * desiredSpeed };
            npc.vx += (desiredV.x - (npc.vx || 0)) * clamp(1.5 * dt, 0, 1);
            npc.vy += (desiredV.y - (npc.vy || 0)) * clamp(1.5 * dt, 0, 1);
            const toP = { x: ship.pos.x - npc.x, y: ship.pos.y - npc.y }; const dp = Math.hypot(toP.x, toP.y);
            if (dp < 120) { npc.vx -= (toP.x / dp) * 40 * dt; npc.vy -= (toP.y / dp) * 40 * dt; }
            npc.x += npc.vx * dt;
            npc.y += npc.vy * dt;
            npcRotationStep(npc, dt, frameNorm);
            const portPos = st ? stationPortWorld(st, npc.dockPort || 0) : null;
            const distToStation = portPos ? Math.hypot(portPos.x - npc.x, portPos.y - npc.y) : Infinity;
            if (npc.leader == null && st && distToStation < 20) {
              npc.docking = true; npc.x = portPos.x; npc.y = portPos.y; npc.vx = 0; npc.vy = 0; npc.lastStation = st.id;
            }
          }
          return measuredAiMs;
        }
        function pirateMissionStep(dt) {
          if (!mercMission) return;
          const st = mercMission.station;
          if (!st) return;
    
          const orbitRadii = pirateOrbitRadii();
          const aggroRadius = mercMission.aggroRadius || orbitRadii.inner || (st.r + 1200);
          mercMission.aggroRadius = aggroRadius;
          const distToPlayer = Math.hypot(ship.pos.x - st.x, ship.pos.y - st.y);
          const zoneId = zoneState.current?.id;
    
          // --- ZMIANA: Usunięto enterPirateOuterOrbit (nie resetujemy już formacji starym kodem) ---
    
          if (zoneId === 'pirate_inner') {
            enterPirateInnerOrbit();
          }
    
          const shouldAggro = zoneId === 'pirate_inner' || distToPlayer < aggroRadius;
          if (!mercMission.aggro && shouldAggro) {
            triggerMercAggro(zoneId === 'pirate_inner' ? 'player_inner_orbit' : 'player_inside_zone');
          }
    
          // --- ZMIANA: Usunięto updatePirateGuardBehavior ---
          // To naprawia konflikt sterowników. Teraz tylko runAdvancedFighterAI steruje ruchem.
    
          // --- Platformy Obronne ---
          PirateSim.time = (PirateSim.time || 0) + dt;
    
          const platforms = mercMission.weaponPlatforms || [];
          const target = { x: ship.pos.x, y: ship.pos.y, vx: ship.vel.x, vy: ship.vel.y };
          for (const platform of platforms) {
            if (!platform) continue;
            platform.hitFlash = Math.max(0, platform.hitFlash - dt);
            if (platform.destroyed) {
              platform.deathTimer += dt;
              if (platform.deathTimer > 3) {
                platform.removed = true;
              }
              continue;
            }
    
            platform.angle += platform.orbitSpeed * dt;
            platform.rotation = wrapAngle(platform.rotation + platform.spin * dt);
            platform.x = st.x + Math.cos(platform.angle) * platform.orbitRadius;
            platform.y = st.y + Math.sin(platform.angle) * platform.orbitRadius;
    
            const tangentialVel = {
              x: -Math.sin(platform.angle) * platform.orbitRadius * platform.orbitSpeed,
              y: Math.cos(platform.angle) * platform.orbitRadius * platform.orbitSpeed
            };
    
            if (platform.shield) {
              if (platform.shield.regenTimer > 0) {
                platform.shield.regenTimer = Math.max(0, platform.shield.regenTimer - dt);
              } else {
                platform.shield.val = clamp(platform.shield.val + platform.shield.regenRate * dt, 0, platform.shield.max);
              }
            }
    
            platform.rail.cd = Math.max(0, platform.rail.cd - dt);
            platform.missile.cd = Math.max(0, platform.missile.cd - dt);
    
            const distToPlayerPlat = Math.hypot(target.x - platform.x, target.y - platform.y);
    
            if (platform.rail.cd === 0 && distToPlayerPlat < 2200) {
              const lead = leadTarget({ x: platform.x, y: platform.y }, tangentialVel, target, RAIL_SPEED * 0.9);
              const aim = Math.atan2(lead.y - platform.y, lead.x - platform.x);
              const jitter = (Math.random() - 0.5) * platform.rail.scatter;
              const dir = { x: Math.cos(aim + jitter), y: Math.sin(aim + jitter) };
              const muzzle = muzzlePosFor(platform, dir, 14);
              window.bullets.push({
                x: muzzle.x, y: muzzle.y,
                vx: dir.x * (RAIL_SPEED * 0.9), vy: dir.y * (RAIL_SPEED * 0.9),
                life: 2.0, r: 4, owner: 'npc', damage: platform.rail.damage, type: 'rail', penetration: 2,
                source: platform, spawnGrace: 0.08
              });
              spawnParticle({ x: muzzle.x, y: muzzle.y }, { x: 0, y: 0 }, 0.10, '#bfe7ff', 6, true);
              platform.rail.cd = platform.rail.cdMax;
            }
    
            if (platform.missile.cd === 0 && distToPlayerPlat < 2600) {
              const lead = leadTarget({ x: platform.x, y: platform.y }, tangentialVel, target, SIDE_BULLET_SPEED);
              const aim = Math.atan2(lead.y - platform.y, lead.x - platform.x);
              const dir = { x: Math.cos(aim), y: Math.sin(aim) };
              const muzzleR = muzzlePosFor(platform, dir, 16);
              window.bullets.push({
                x: muzzleR.x, y: muzzleR.y, px: muzzleR.x, py: muzzleR.y,
                vx: dir.x * SIDE_BULLET_SPEED, vy: dir.y * SIDE_BULLET_SPEED,
                life: 2.6, r: 5, owner: 'npc', damage: platform.missile.damage,
                type: 'rocket', explodeRadius: SIDE_PLASMA_EXPLODE_RADIUS,
                homingDelay: SIDE_ROCKET_HOMING_DELAY,
                source: platform, spawnGrace: 0.12
              });
              platform.missile.cd = platform.missile.cdMax;
            }
          }
          if (platforms.length) {
            mercMission.weaponPlatforms = platforms.filter(p => p && !p.removed);
          }
    
          if (mercMission.alertStage !== 'engage') return;
    
          // --- SWARM (Fale wrogów) ---
          const swarm = mercMission.swarm;
          if (!swarm) return;
          if (!swarm.active) return;
    
          // Liczba żywych piratów
          const alive = npcs.reduce((a, n) => a + (n.mission && !n.friendly && !n.dead ? 1 : 0), 0);
    
          swarm.timer -= dt;
    
          // Jeśli mało wrogów i upłynął czas -> spawnuj
          if (swarm.timer <= 0 && alive < swarm.maxAlive) {
            // Reset timera (dłuższy odstęp po spawnie fali)
            swarm.timer = 8.0;
    
            // Pobierz typ z kolejki
            const queued = Array.isArray(swarm.queue) ? swarm.queue.shift() : null;
            const descriptor = (queued && typeof queued === 'object') ? queued : { kind: queued };
            let kind = descriptor.kind || ((Math.random() < 0.6) ? 'fighter_squad' : 'frigate_pd');
    
            const spawnPos = descriptor.pos;
            const angleToPlayer = spawnPos
              ? Math.atan2(ship.pos.y - spawnPos.y, ship.pos.x - spawnPos.x)
              : Math.atan2(ship.pos.y - st.y, ship.pos.x - st.x);
    
            // 1. MYŚLIWCE: CAŁA CHMARA JEDNYM RZUTEM.
            // Dawniej jeden wpis z kolejki = 7 interceptorów co 8 s, a kolejka ma 8
            // wpisów myśliwskich — gracz dostawał sznur małych grupek zamiast
            // jednego uderzenia. Teraz zabieramy z kolejki WSZYSTKIE wpisy myśliwskie
            // i startujemy je naraz, każda eskadra we własnym sektorze wachlarza.
            if (isPirateFighterKind(kind)) {
              const queueArr = Array.isArray(swarm.queue) ? swarm.queue : [];
              const budget = Math.max(0, swarm.maxAlive - alive);
              // Nie opróżniaj kolejki głębiej, niż pozwala limit żywych — przy
              // zapchanej arenie jeden tick skasowałby cały komplet myśliwców,
              // spawnując garstkę.
              const maxSquads = Math.max(1, Math.ceil(budget / PIRATE_SWARM_SQUAD_SIZE));
    
              let squads = 1;
              for (let qi = queueArr.length - 1; qi >= 0 && squads < maxSquads; qi--) {
                const q = queueArr[qi];
                const qKind = (q && typeof q === 'object') ? q.kind : q;
                if (isPirateFighterKind(qKind)) {
                  squads++;
                  queueArr.splice(qi, 1);
                }
              }
    
              const total = Math.min(squads * PIRATE_SWARM_SQUAD_SIZE, budget);
              let spawned = 0;
              let arcIndex = 0;
              while (spawned < total) {
                const n = Math.min(PIRATE_SWARM_SQUAD_SIZE, total - spawned);
                spawnPirateSquad(st, 'interceptor', n, 'attack', { arcIndex, arcCount: squads });
                spawned += n;
                arcIndex++;
              }
    
              // Po pełnym rzucie stacja potrzebuje czasu na przezbrojenie — bez tego
              // resetSwarmQueue dorzucałby kolejny komplet co 8 s.
              swarm.timer = PIRATE_SWARM_RELOAD;
            }
            // 2. DUŻE STATKI: Spawnujemy pojedynczo przez spawnPirate
            else {
              const npc = spawnPirate(kind, st);
    
              // Jeśli w kolejce była zdefiniowana pozycja (np. dla formacji capitali)
              if (spawnPos) {
                npc.x = spawnPos.x; npc.y = spawnPos.y;
                npc.formationSlot = { x: descriptor.offset || 0, y: 0 };
                npc.angle = angleToPlayer;
    
                // KLUCZOWE: Nadaj pęd początkowy, żeby nie stały w miejscu przy spawnie
                npc.vx += Math.cos(angleToPlayer) * 80;
                npc.vy += Math.sin(angleToPlayer) * 80;
              }
    
              // Ważne: Ustaw stan na atak, żeby nie weszły w tryb Guard/Orbit
              npc.state = 'engage_formation';
              npc.guardStation = null;
    
              // Reset celów dla AI (niech aiPickBestTarget wybierze gracza lub jego myśliwce)
              npc.forceTarget = null;
              npc.target = null;
            }
    
            // Jeśli kolejka pusta, odnów ją
            if (swarm.queue && swarm.queue.length === 0) resetSwarmQueue();
