                  camera2.targetZoom = clamp(camera2.targetZoom * (1 + zoomSpeed), camera2.minZoom, camera2.maxZoom);
                }
              }
    
              // Right stick → move P2 crosshair (clamped to right half)
              if (Math.abs(rx) > 0 || Math.abs(ry) > 0) {
                const cursorSpeed = 12;
                mouse2.x = clamp((mouse2.x || (halfW + halfW / 2)) + rx * cursorSpeed, halfW, W);
                mouse2.y = clamp((mouse2.y || H / 2) + ry * cursorSpeed, 0, H);
                mouse2.overCanvas = true;
              }
    
              // Select (8) — reserved for future P2 command UI
              const p2PadId = pad.index ?? 'p2';
              const p2SelNow = btn(8);
              const p2SelPrev = !!_padPrevSelect[p2PadId];
              _padPrevSelect[p2PadId] = p2SelNow;
            }
            // Start button (9) — rising edge only → toggle menu
            const padId = pad.index ?? (isP1 ? 'p1' : 'p2');
            const startNow = btn(9);
            const startPrev = !!_padPrevStart[padId];
            if (startNow && !startPrev) {
              if (stationUI.open) { /* skip if station UI open */ }
              else toggleMainMenu();
            }
            _padPrevStart[padId] = startNow;
          }
    
          // P1 controller
          const p1Assign = controllerAssignment.p1;
          if (p1Assign && p1Assign !== 'keyboard') {
            const p1Pad = getAssignedPad(p1Assign);
            applyPadToShip(p1Pad, ship, input, true);
          } else if (!p1Assign) {
            // Fallback: no assignment (single player) — use pad[0]
            const pads = navigator.getGamepads?.() || [];
            applyPadToShip(pads[0], ship, input, true);
          }
    
          // P2 controller (split screen only)
          if (splitScreenMode && player2Ship && !player2Ship.destroyed) {
