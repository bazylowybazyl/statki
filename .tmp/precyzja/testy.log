          }
          const hullMax = Math.max(1, Number(entity?.maxHp) || Number(entity?.hp) || 1);
          return Math.max(HARDPOINT_INTEGRITY_CONFIG.minHullDamage, (hullMax * HARDPOINT_INTEGRITY_CONFIG.npcHullFracTotal) / count);
