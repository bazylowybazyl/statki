            ctx.restore();
          }
    
          function _collectTargetingGroup(mouseWorld, camRef) {
            const out = targetingMode.groupCandidates;
            out.length = 0;
            const radiusWorld = TARGETING_GROUP_RADIUS_PX / Math.max(0.0001, camRef.zoom);
            const radiusSq = radiusWorld * radiusWorld;
    
            const addTarget = (target) => {
              if (!target || target.__targetingSubsystem || !canPlayerLockTarget(target)) return;
              const dx = getTargetX(target) - mouseWorld.x;
              const dy = getTargetY(target) - mouseWorld.y;
              const reach = radiusWorld + getTargetRadius(target);
              if (dx * dx + dy * dy > Math.max(radiusSq, reach * reach)) return;
              if (!out.includes(target)) out.push(target);
