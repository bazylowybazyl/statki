        // a cel może w tym czasie zginąć.
        function fireSpecialBarrel(loadout, hp, slot, barrelIndex, multiBarrel) {
          const weapon = loadout?.weapon;
          if (!weapon || !p1WeaponCtrl || !ship || ship.dead) return 0;
          const aim = getMountedWeaponAim(ship, loadout);
          const target = isTargetAlive(aim.target) ? aim.target : null;
          const muzzle = p1WeaponCtrl.computeMountedMuzzle(loadout, barrelIndex);
          const base = `special:${hp?.id || slot}`;
          muzzle.emitterUid = multiBarrel ? `${base}:b${barrelIndex}` : base;
          return Number(window.fireWeaponCore(ship, target, weapon.id, muzzle)) || 0;
        }
    
        function _fireSpecialGroup(loadouts) {
          if (!loadouts.length) return false;
          let fired = false;
          if (!p1WeaponCtrl) return false;
    
          for (let i = 0; i < loadouts.length; i++) {
            const loadout = loadouts[i];
            const weapon = loadout?.weapon;
            if (!weapon || weapon.id === 'hexlance_siege') continue;
    
            const hp = loadout?.hp;
            const hpPos = hp?.pos || hp;
            if (!hp || !hpPos) continue;
    
            const cdLeft = Math.max(0, Number(hp.specialCd) || 0);
            if (cdLeft > 0) continue;
    
            // Salwa: `barrelsPerShot` luf na jedno naciśnięcie. Pierwsza idzie
            // od razu, reszta z kolejki w `updateSpecialWeaponCooldowns`.
            const aim = getMountedWeaponAim(ship, loadout);
            const barrels = barrelsPerShotOf(weapon);
            const start = Number(aim.nextBarrel) || 0;
            aim.nextBarrel = start + barrels;
    
            const cd = fireSpecialBarrel(loadout, hp, i, start, barrels > 1);
            hp.specialCd = Math.max(0.01, cd || Number(weapon.cooldown) || 0.25);
            queueSalvoBarrels(hp, weapon.id, start, barrels);
            fired = true;
          }
          return fired;
        }
    
        function tryFireMountedSpecialWeapons() {
          return _fireSpecialGroup(Game.player?.weapons?.[HP.SPECIAL] || []);
        }
    
        function tryFireSpecialMissiles() {
          return _fireSpecialGroup(Game.player?.weapons?.[HP.SPECIAL_MISSILE] || []);
        }
    
        // Hexlance jest DWUTAKTOWY: pierwsze 4 rozpoczyna ładowanie (1,2 s), dopiero
        // drugie 4 — w pięciosekundowym oknie „armed" — wypuszcza salwę. Wszystkie
        // odmowy niżej były wcześniej ciche, więc martwy klawisz, brak działa na
        // kadłubie i przeładowanie wyglądały identycznie: jak nic. Każde wyjście ma
        // teraz komunikat, tak jak klawisze 1/2/3/5.
        function tryFireMountedBuiltInWeapons() {
          const builtins = Game.player?.weapons?.[HP.BUILTIN] || [];
          const hasHexlance = builtins.some(loadout => loadout?.weapon?.id === 'hexlance_siege' && loadout?.hp);
          if (!hasHexlance) {
            pushZoneMessage('HEXLANCE: BRAK DZIAŁA NA KADŁUBIE', 2.0);
            return false;
          }
    
          const sw = Superweapon?.superweaponState || null;
          const wasArmed = !!sw?.armed;
          if (Superweapon.tryFireSuperweapon(ship)) {
            pushZoneMessage(wasArmed ? 'HEXLANCE: OGNIA' : 'HEXLANCE: ŁADOWANIE — WCIŚNIJ 4 PONOWNIE', 1.8);
            return true;
          }
    
          if (sw?.charging) pushZoneMessage('HEXLANCE: ŁADOWANIE…', 1.0);
          else if (sw?.queue?.length) pushZoneMessage('HEXLANCE: SALWA W TOKU', 1.0);
          else if (Number(sw?.cooldown) > 0) pushZoneMessage(`HEXLANCE: PRZEŁADOWANIE ${Number(sw.cooldown).toFixed(1)}s`, 1.2);
          return false;
        }
    
    
        // ==========================================================================================
        // 1. BAZA DANYCH AI SPACE (Statystyki broni i pocisków)
        // ==========================================================================================
        // 2. ADAPTER SYSTEMU (Most między AI SPACE a Super Capital: Battle for Solar System)
        // ==========================================================================================
    
        // Ten obiekt udaje silnik z AI Space, żebyśmy nie musieli przepisywać każdej linijki AI
        const PirateSim = {
          time: 0,
          get units() {
