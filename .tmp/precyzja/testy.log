        window.pickSquadTargets = pickSquadTargets;
        // window.spawnFighter jest niżej (start z wyrzutni hangarów). Stara wersja
        // z tego miejsca (2 myśliwce na sztywnych 650 u/s) i tak była nadpisywana.
    
        // === WYRZUTNIE MYŚLIWCÓW ===================================================
        // Jeden hardpoint typu 'hangar' = jedna wyrzutnia. Myśliwce wychodzą BURTĄ
        // (prostopadle do osi kadłuba), pojedynczo, z odstępem czasowym — stąd efekt
        // katapultowania. Wcześniej cała eskadra pojawiała się w jednej klatce na
        // ±ship.w/2 (czyli na DZIOBIE i RUFIE, bo lokalne x to oś wzdłużna), z
        // rozrzutem bocznym 18 u, a impuls wyrzutu szedł wektorem PRZODU (cos/sin
        // kąta) mimo komentarza "wyrzut na boki" — stąd "zbite na sobie".
        const FIGHTER_LAUNCH_INTERVAL = FIGHTER_LAUNCH.INTERVAL;
    
        const __fighterLaunchQueue = [];
    
        // Zbiera wyrzutnie z hardpointów 'hangar' danej jednostki. Każdy hardpoint to
        // jedna wyrzutnia; burta wynika ze znaku lokalnego Y hardpointu.
        function collectHangarTubes(entity, entries) {
          const byHp = new Map();
          for (const entry of entries) {
            const hp = entry?.hp;
            if (!hp || hp.destroyed) continue;
            let tube = byHp.get(hp);
            if (!tube) {
              const local = getEntityHardpointLocalPos(entity, hp);
              if (!local) continue;
              tube = { hp, local, side: local.y >= 0 ? 1 : -1, squadrons: [] };
              byHp.set(hp, tube);
            }
            if (entry.squadron) tube.squadrons.push(entry.squadron);
          }
          const tubes = [];
          for (const tube of byHp.values()) {
            if (tube.squadrons.length) tubes.push(tube);
          }
          return orderHangarTubes(tubes);
        }
    
        function getPlayerHangarTubes() {
          if (!window.ship) return [];
          return collectHangarTubes(ship, Game.player.weapons?.[HP.HANGAR] || []);
        }
    
        // Wspólny wyrzut: pozycja = hardpoint hangaru przesunięty na zewnątrz burty,
        // prędkość = pęd nosiciela + impuls katapulty w bok (plus składowa do przodu).
        function ejectFighterFromTube(carrier, tube, fighter, halfBeam) {
          const frame = {
            x: Number.isFinite(carrier?.pos?.x) ? carrier.pos.x : carrier.x,
            y: Number.isFinite(carrier?.pos?.y) ? carrier.pos.y : carrier.y,
            vx: Number(carrier.vel?.x ?? carrier.vx) || 0,
            vy: Number(carrier.vel?.y ?? carrier.vy) || 0,
            angle: (Number(carrier.angle) || 0)
              + (carrier === ship ? 0 : (Number(carrier.capitalProfile?.spriteRotation) || 0))
          };
          const launch = computeLaunchVector(frame, tube, halfBeam);
    
          fighter.x = launch.x;
          fighter.y = launch.y;
          fighter.vx = launch.vx;
          fighter.vy = launch.vy;
          fighter.angle = launch.angle;
          fighter.desiredAngle = launch.angle;
    
          if (window.spawnParticle) {
            for (let i = 0; i < 6; i++) {
              const spread = (Math.random() - 0.5) * 0.5;
              const px = launch.nx * Math.cos(spread) - launch.ny * Math.sin(spread);
              const py = launch.nx * Math.sin(spread) + launch.ny * Math.cos(spread);
              window.spawnParticle(
                { x: launch.x, y: launch.y },
                { x: frame.vx - px * (180 + Math.random() * 220), y: frame.vy - py * (180 + Math.random() * 220) },
                0.35, '#cfe8ff', 2 + Math.random() * 3, true
              );
            }
          }
        }
    
        function buildSquadronFighter(squadron) {
          const f = makeNPCBase({ x: 0, y: 0 }, {
            hp: squadron.hp,
            accel: squadron.accel,
            maxSpeed: squadron.maxSpeed,
            turn: squadron.turn,
            radius: squadron.radius,
            mass: squadron.mass,
            separationRange: squadron.separationRange
          });
          f.fighter = true;
          f.type = 'fighter';
          f.mission = true;
          f.squadronId = squadron.id;
          f.squadronName = squadron.name;
          f.color = squadron.color || '#7cff91';
          f.gun = squadron.weaponId;
          f.msl = squadron.missileId;
          f.mslAmmo = squadron.missileAmmo;
          f.gunCD = 0.5;
          return f;
        }
    
        function spawnFighterFromTube(req) {
          if (!window.ship || ship.destroyed) return null;
          const { tube, squadron, slotInTube } = req;
          if (tube.hp?.destroyed) return null;
    
          const f = buildSquadronFighter(squadron);
          f.friendly = true;
          f.squadronIndex = req.squadronIndex;
    
          // ship.h ustawia się dopiero po wczytaniu sprite'a kadłuba — gdyby było
          // puste, klin wylądowałby w obrysie statku. Rozrzut hardpointów hangarów
          // jest drugim, niezależnym oszacowaniem połowy szerokości.
          const halfBeam = Math.max(
            (Number(ship.h) || 0) * 0.5,
            Math.abs(tube.local?.y || 0) * 1.35,
            120
          );
          ejectFighterFromTube(ship, tube, f, halfBeam);
    
          if (!window.SQUAD) window.SQUAD = { list: [], order: 'idle', targets: [] };
          f.formIndex = req.globalIndex;
          f.formationOffset = chevronFormationOffset(
            tube.sideRank, tube.side, slotInTube, squadron.squadSize || 1, halfBeam
          );
          f.squad = { leader: ship, type: 'fighter', squadronId: squadron.id };
          f.ai = (dt) => { if (window.runAdvancedFighterAI) window.runAdvancedFighterAI(f, dt); };
    
          window.SQUAD.list.push(f);
          npcs.push(f);
          return f;
        }
    
        // Kolejka startów — opróżniana w update'cie klatki, nie w jednym rzucie.
        function updateFighterLaunchQueue(dt) {
          if (!__fighterLaunchQueue.length) return;
          let ready = 0;
          for (let i = 0; i < __fighterLaunchQueue.length; i++) {
            const req = __fighterLaunchQueue[i];
            req.delay -= dt;
            if (req.delay <= 0) ready++;
          }
          if (!ready) return;
          // Zachowaj kolejność startów: spawnujemy od przodu kolejki.
          const pending = [];
          for (let i = 0; i < __fighterLaunchQueue.length; i++) {
            const req = __fighterLaunchQueue[i];
            if (req.delay <= 0) req.spawn(req);
            else pending.push(req);
          }
          __fighterLaunchQueue.length = 0;
          for (let i = 0; i < pending.length; i++) __fighterLaunchQueue.push(pending[i]);
        }
        window.updateFighterLaunchQueue = updateFighterLaunchQueue;
        window.isFighterLaunchInProgress = () => __fighterLaunchQueue.length > 0;
    
        function launchMountedFighterSquadrons() {
          const tubes = getPlayerHangarTubes();
          if (!tubes.length) {
            if (typeof toast === 'function') toast('Brak modułu hangaru!');
            return [];
          }
          SQUAD.list = [];
          SQUAD.order = 'escort';
          SQUAD.targets = [];
          __fighterLaunchQueue.length = 0;
    
          // Wszystkie wyrzutnie pracują RÓWNOLEGLE (tyle strumieni ile hangarów),
          // każda wypuszcza pojedynczo co FIGHTER_LAUNCH.INTERVAL.
          const plan = buildLaunchPlan(tubes, tube => tube.squadrons);
          for (const req of plan) {
            req.spawn = spawnFighterFromTube;
            __fighterLaunchQueue.push(req);
          }
          return plan;
        }
    
        window.spawnFighter = function (squadronId = 'multirole') {
          const tubes = getPlayerHangarTubes();
          const squadron = getFighterSquadronDef(squadronId);
          const tube = tubes[0] || {
            local: { x: 0, y: (ship?.h || 200) * 0.35 },
            side: 1,
