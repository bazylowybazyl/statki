              if (cause === 'plasma') {
                CanvasVFX.spawnExplosionPlasma(npc.x, npc.y, isFighterLike ? 1.2 : 1.45);
              } else if (cause === 'default') {
                CanvasVFX.spawnDefaultHit(npc.x, npc.y, isFighterLike ? 1.2 : 1.35);
              } else {
