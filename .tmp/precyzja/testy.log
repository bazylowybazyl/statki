        // r+50), więc myśliwce wysypywały się chmarą w jednym punkcie zamiast
        // wychodzić burtami.
        function carrierHangarTubes(npc) {
          const hps = npc.editorHardpoints;
          if (!Array.isArray(hps)) return [];
          const entries = [];
          for (let i = 0; i < hps.length; i++) {
            const hp = hps[i];
            if (hp && hp.type === 'hangar' && !hp.destroyed) entries.push({ hp, squadron: true });
          }
          return collectHangarTubes(npc, entries);
        }
    
        function carrierHangarBayCount(npc) {
          const hps = npc.editorHardpoints;
          if (!Array.isArray(hps)) return 0;
          let bays = 0;
          for (let i = 0; i < hps.length; i++) {
            const hp = hps[i];
            if (hp && hp.type === 'hangar' && !hp.destroyed) bays++;
          }
          return bays;
        }
    
        function carrierEnemyWithin(carrier, range) {
          const rSq = range * range;
          if (carrier.isPirate && window.ship && !window.ship.destroyed) {
            const dx = window.ship.pos.x - carrier.x;
            const dy = window.ship.pos.y - carrier.y;
            if (dx * dx + dy * dy <= rSq) return true;
          }
          for (let i = 0; i < npcs.length; i++) {
            const o = npcs[i];
            if (!o || o.dead || o === carrier) continue;
            if (!window.isEnemyUnit || !window.isEnemyUnit(carrier, o)) continue;
            const dx = o.x - carrier.x;
            const dy = o.y - carrier.y;
            if (dx * dx + dy * dy <= rSq) return true;
          }
          return false;
        }
    
        function updateNpcHangars(npc, dt) {
          if (!npc || npc.dead) return;
          const bays = carrierHangarBayCount(npc);
          if (bays <= 0) return;
    
          const alive = npc.__hangarFighters ? npc.__hangarFighters.filter(f => f && !f.dead) : [];
          npc.__hangarFighters = alive;
    
          npc.__hangarCd = (npc.__hangarCd || 0) - dt;
          if (npc.__hangarCd > 0) return;
    
          const maxFighters = Math.min(bays, CARRIER_MAX_BAYS) * CARRIER_FIGHTERS_PER_BAY;
          if (alive.length >= maxFighters) return;
          if (!carrierEnemyWithin(npc, CARRIER_LAUNCH_RANGE)) return;
    
          const tubes = carrierHangarTubes(npc);
          if (!tubes.length) return;
    
          const launch = Math.min(CARRIER_LAUNCH_BATCH, maxFighters - alive.length);
          const squadronId = npc.isPirate ? 'interceptor' : 'multirole';
          const base = alive.length;
