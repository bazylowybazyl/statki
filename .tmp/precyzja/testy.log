            const swx = sw.x, swy = sw.y;
            const swR = Number(sw._bpRadius) || 100;
            for (let ai = 0; ai < dynamicDestructibles.length; ai++) {
              const active = dynamicDestructibles[ai];
              if (!active || active.dead || active === sw) continue;
              const avx = Number(active.vel?.x ?? active.vx ?? 0);
              const avy = Number(active.vel?.y ?? active.vy ?? 0);
              const speedSq = avx * avx + avy * avy;
              if (speedSq < 225) continue; // < 15 u/s — nie budź
    
              const ax = Number(active.pos?.x ?? active.x ?? 0);
              const ay = Number(active.pos?.y ?? active.y ?? 0);
