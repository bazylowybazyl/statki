        const scannerOverviewUI = initScannerOverviewUI({
          onSelectTarget: handleScannerOverviewSelect,
          onToggleLock: (target) => toggleLockedTargetUi(target),
          onAction: handleScannerOverviewAction,
          getDetails: getScannerOverviewDetails,
          getTargetLabel: getRadarTargetUnitId,
