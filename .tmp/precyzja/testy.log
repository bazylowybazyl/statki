          const uniformRaw = Number(entity?.__hardpointScale);
          const uniform = (Number.isFinite(uniformRaw) && uniformRaw > 0) ? uniformRaw : 1;
          const scaleX = (Number.isFinite(scaleXRaw) && scaleXRaw > 0) ? scaleXRaw : uniform;
