            const dx = window.ship.pos.x - carrier.x;
            const dy = window.ship.pos.y - carrier.y;
            if (dx * dx + dy * dy <= rSq) return true;
          }
          for (let i = 0; i < npcs.length; i++) {
            const o = npcs[i];
            if (!o || o.dead || o === carrier) continue;
            if (!window.isEnemyUnit || !window.isEnemyUnit(carrier, o)) continue;
            const dx = o.x - carrier.x;
