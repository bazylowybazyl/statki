            }
          }
          return 'atlas';
        }
    
        function getPlayerEditorConfigFromStorage(preferredKey = null) {
          const ships = readShipsEditorConfigFromStorage() || {};
          const defaults = SHIP_EDITOR_DEFAULTS?.ships || {};
          const resolvedKey = resolvePlayerEditorKey(preferredKey);
          const sourceKeys = getEditorHullConfigKeys(resolvedKey);
          let fallback = null;
          for (const key of sourceKeys) {
            if (defaults?.[key] && typeof defaults[key] === 'object') {
              if (!fallback || hasEditorHullConfigContent(defaults[key])) fallback = defaults[key];
              if (hasEditorHullConfigContent(defaults[key])) break;
            }
          }
          const base = (fallback && typeof fallback === 'object') ? fallback : (PLAYER_EDITOR_DEFAULTS || {});
          let cfg = null;
          for (const key of sourceKeys) {
            if (ships?.[key] && typeof ships[key] === 'object') {
              if (!cfg || hasEditorHullConfigContent(ships[key])) cfg = ships[key];
              if (hasEditorHullConfigContent(ships[key])) break;
            }
          }
          if (!cfg || typeof cfg !== 'object') return base;
    
          const merged = {
            ...base,
            ...cfg,
            hardpoints: (Array.isArray(cfg.hardpoints) && cfg.hardpoints.length)
              ? cfg.hardpoints
