          const baseY = Number.isFinite(entity?.pos?.y) ? entity.pos.y : Number(entity?.y || 0);
          const spriteRot = (entity === ship) ? 0 : (Number(entity?.capitalProfile?.spriteRotation) || 0);
          const angle = (Number(entity?.angle) || 0) + spriteRot;
