            shards,
            hardpoints,
            cores
          };
        }
    
        function getRadarTargetScanData(target) {
          return {
            weapons: buildRadarWeaponsSummary(target),
            cargo: buildRadarCargoSummary(target),
            blueprint: buildRadarBlueprintData(target)
          };
        }
    
        function handleRadarAction(action, target) {
          if (!isTargetAlive(target)) return;
          clearPlayerAttackState(target);
          const label = getRadarTargetUnitId(target);
          const point = scannerTargetPoint(target);
          const radius = getTargetRadius(target);
          if (action === 'approach') {
            ship.command = {
              type: 'approach',
              target: point,
              targetEntity: target,
              arrival: Math.max(90, radius + 80)
            };
            pushZoneMessage(`ROZKAZ: ZBLIZANIE DO ${label}`, 1.5);
          } else if (action === 'orbit') {
            ship.command = {
              type: 'orbit',
              target: point,
              targetEntity: target,
              orbitRadius: Math.max(RTS_DEFAULT_ORBIT_RADIUS, radius + 180),
              orbitDir: 1,
              arrival: Math.max(90, radius + 120)
            };
            pushZoneMessage(`ROZKAZ: ORBITA WOKOL ${label}`, 1.5);
          } else if (action === 'warp' || action === 'jump') {
            setCruiseTarget(point.x, point.y);
            pushZoneMessage(`ROZKAZ: JUMP DO ${label}`, 1.6);
          }
        }
    
        function getScannerOverviewDetails(target) {
          if (!target) return { title: 'CONTACT', rows: [] };
          if (isAsteroidTarget(target)) return buildAsteroidScanDetails(target);
          const meta = getRadarTargetMeta(target);
          const rows = [
            { name: 'ID', amount: meta.unitId },
            { name: 'Class', amount: meta.unitClass },
            { name: 'Distance', amount: `${Math.round(Math.hypot(getTargetX(target) - ship.pos.x, getTargetY(target) - ship.pos.y))}` },
            { name: 'Radius', amount: `${Math.round(getTargetRadius(target))}` }
          ];
          for (const row of buildRadarCargoSummary(target)) rows.push(row);
          return {
            title: `${meta.unitId} / ${meta.unitClass}`,
            rows
          };
        }
    
        function selectScannerTarget(target) {
          if (!isTargetAlive(target)) return false;
          scannerState.autoInspectFirst = false;
          return setScannerInspectedTarget(target);
        }
    
        function isScannerStationContact(target, contact) {
          if (contact?.type === 'station' || contact?.tone === 'station') return true;
          return target?.__scannerContactType === 'station' || stations.includes(target);
        }
    
        function openScannerStationConnection(target) {
          if (!isTargetAlive(target) || !isScannerStationContact(target, null)) return false;
          const hudSystem = window.hudSystem;
          if (!hudSystem || typeof hudSystem.handleMenuAction !== 'function') return false;
          if (hudSystem.menuState !== 'SCAN' && typeof hudSystem.setBottomMenuState === 'function') {
            hudSystem.setBottomMenuState('SCAN');
          }
          if (hudSystem.menuState !== 'SCAN') return false;
          hudSystem.handleMenuAction('terminal-connect', target?.id != null ? String(target.id) : '');
          pushZoneMessage(`LACZENIE ZE STACJA: ${getStationDisplayName(target).toUpperCase()}`, 1.2);
          return true;
        }
    
        function handleScannerOverviewSelect(target, contact, meta = {}) {
          const selected = selectScannerTarget(target);
          if (selected && !meta.ctrlKey && isScannerStationContact(target, contact)) {
            openScannerStationConnection(target);
          }
          return selected;
        }
    
        function handleScannerOverviewAction(action, target) {
          if (!isTargetAlive(target)) return;
          selectScannerTarget(target);
          if (action === 'lock') {
            toggleLockedTargetUi(target);
          } else if (action === 'scan') {
            issueDirectScanOrder(target);
          } else if (action === 'approach' || action === 'orbit' || action === 'jump') {
            handleRadarAction(action, target);
          }
        }
    
        const radarTargetingUI = initRadarTargetingUI({
          clearLocks: clearLockedTargetsUi
