        function initStationOverlay() {
          if (!stationOverlayDom.root) return;
          initStationOverlayTabs();
          buildTradePanel();
          buildCantinaPanel();
          buildHangarPanel();
          buildMechanicPanel();
          buildInfrastructurePanel();
          stationOverlayState.built = true;
        }
    
        function updateStationHeader(station) {
          if (stationOverlayDom.title) {
            stationOverlayDom.title.textContent = station?.name || 'Stacja orbitalna';
          }
          if (stationOverlayDom.subtitle) {
            const parts = [];
            // Właściciel i nastawienie na pierwszym miejscu — to one decydują
            // o cenach i o tym, czy dok w ogóle wpuści.
            if (isDerelict(station)) {
              parts.push('OPUSZCZONA — brak kontroli lotów');
            } else {
              const standing = resolveStanding(PLAYER.reputation[station.factionId]);
              parts.push(`${getFactionName(station.factionId)} • ${standing.label}`);
            }
            parts.push(describeStationRole(station));
            if (station?.planet?.name) parts.push(`Orbita: ${station.planet.name}`);
            stationOverlayDom.subtitle.textContent = parts.join(' • ') || 'Przestrzeń cywilna';
          }
          if (stationOverlayDom.credits) {
            stationOverlayDom.credits.textContent = `${Math.round(PLAYER.credits)} CR`;
          }
        }
    
        function setActiveStationTab(tab) {
          if (stationOverlayDom.tabs) {
            stationOverlayDom.tabs.querySelectorAll('.station-tab-btn').forEach(btn => {
              btn.classList.toggle('active', btn.dataset.tab === tab);
            });
          }
          for (const [key, pane] of Object.entries(stationOverlayDom.panels)) {
            if (!pane) continue;
            const match = key === tab;
            pane.classList.toggle('active', match);
            pane.classList.toggle('hidden', !match);
          }
          const wideStationTab = (tab === 'mechanic' || tab === 'hangar');
          const contentArea = document.getElementById('station-content-area');
          if (contentArea) {
            contentArea.classList.toggle('mechanic-layout', wideStationTab);
          }
          const topDock = document.getElementById('hud-top-dock');
          if (topDock) {
            topDock.classList.toggle('mechanic-expanded', wideStationTab);
          }
          const topDrawer = document.getElementById('top-drawer');
          if (topDrawer) {
            topDrawer.classList.toggle('mechanic-expanded', wideStationTab);
          }
        }
    
        function updateUpgradeButtons() {
          const buttons = stationOverlayDom.panels.hangar?.querySelectorAll('button[data-upgrade-id]');
          if (!buttons) return;
          buttons.forEach(btn => {
            const cost = Number(btn.dataset.cost) || 0;
            btn.disabled = PLAYER.credits < cost;
          });
        }
    
        function updateTradeResourceTable(station) {
          const pane = stationOverlayDom.panels.trade;
          if (!pane) return;
          const table = pane.querySelector('.trade-resource-table');
          if (!table) return;
          const econ = station ? InfrastructureUI.ensureEconomy(station) : null;
          if (!econ) return;
          table.querySelectorAll('tr[data-resource-key]').forEach(row => {
            const key = row.dataset.resourceKey;
            const amountEl = row.querySelector('[data-field="amount"]');
            const capEl = row.querySelector('[data-field="capacity"]');
            if (amountEl) amountEl.textContent = `${Math.round(econ.resources?.[key] ?? 0)}`;
            if (capEl) capEl.textContent = `${Math.round(econ.capacity?.[key] ?? 0)}`;
          });
          const note = pane.querySelector('.trade-resource-note');
          if (note) {
            const label = station?.planet?.name || station?.name;
            note.textContent = label ? `Magazyny: ${label}` : 'Magazyny stacji orbitalnej.';
          }
        }
    
        function updateTradeCards(station) {
          updateTradeResourceTable(station);
          const pane = stationOverlayDom.panels.trade;
          const table = pane?.querySelector('.trade-market-table');
          if (!table) return;
          const econ = station ? InfrastructureUI.ensureEconomy(station) : null;
          const cargoFree = getPlayerCargoFree();
          const cargoCap = Number(getPlayerHullDef(PLAYER.activeHullId)?.cargoCap) || 0;
    
          const holdNote = pane.querySelector('.trade-hold-note');
          if (holdNote) {
            holdNote.textContent = `Ładownia: ${Math.round(getBagMass(PLAYER.cargo))} / ${Math.round(cargoCap)}`;
          }
    
          table.querySelectorAll('tr[data-market-key]').forEach(row => {
            const key = row.dataset.marketKey;
            const step = getTradeStep(key);
            const held = Number(PLAYER.cargo?.[key]) || 0;
            const stationStock = Number(econ?.resources?.[key]) || 0;
    
            const stockCell = row.querySelector('[data-field="stock"]');
            if (stockCell) stockCell.textContent = `${Math.round(held)} / stacja ${Math.round(stationStock)}`;
    
            const sellPrice = getTradeSellPrice(key, station);
            const buyPrice = getTradeBuyPrice(key, station);
            const priceCell = row.querySelector('[data-field="price"]');
            if (priceCell) {
              priceCell.textContent = `${sellPrice} / ${buyPrice} CR`;
              // Kolor mówi, czy tu się opłaca sprzedawać, czy kupować — bez tego
              // gracz musiałby porównywać liczby między stacjami z pamięci.
              const ratio = sellPrice / Math.max(1, getResourceValue(key));
              priceCell.classList.toggle('is-rich', ratio >= 1.05);
              priceCell.classList.toggle('is-poor', ratio <= 0.65);
            }
    
            // Wiersze bez ruchu w obie strony tylko przygasają — pełne ukrycie
            // sprawiłoby, że tabela skacze przy każdym zakupie.
            row.classList.toggle('is-idle', held <= 0 && stationStock <= 0);
    
            row.querySelectorAll('button[data-trade-type]').forEach(btn => {
              if (btn.dataset.tradeType === 'buy') {
                const cost = buyPrice * step;
                const massNeeded = getResourceMassLocal(key, step);
                btn.disabled = PLAYER.credits < cost || stationStock < step || cargoFree < massNeeded;
              } else {
                btn.disabled = held < step;
              }
            });
          });
        }
    
        function getResourceMassLocal(key, amount) {
          return (RESOURCES[key]?.mass || 0) * amount;
        }
    
        function updateMechanicCards() {
          // Naprawa przeniesiona do hangaru. Tu tylko przyciski „Zainstaluj” chipów
          // idą za stanem kredytów (jak przyciski rynku w hangarze).
          const pane = stationOverlayDom.panels.mechanic;
          if (!pane) return;
          for (const btn of pane.querySelectorAll('button[data-chip-action="install"]')) {
            btn.disabled = PLAYER.credits < (Number(btn.dataset.cost) || 0);
          }
        }
        function renderStationOverlay(tab, station) {
          if (!stationOverlayState.built) initStationOverlay();
          if (!stationOverlayDom.root) return;
          const stationKey = InfrastructureUI.getStationKey(station) || station?.name || 'station';
          if (stationOverlayState.activeTab !== tab || stationOverlayState.stationKey !== stationKey) {
            setActiveStationTab(tab);
            stationOverlayState.activeTab = tab;
            stationOverlayState.stationKey = stationKey;
          }
          updateStationHeader(station);
          updateUpgradeButtons();
          updateTradeCards(station);
          updateMechanicCards();
          updateHangarCards();
        }
    
        // Handel przenosi surowiec między ładownią gracza a magazynem stacji —
        // nic nie znika i nie powstaje z niczego. Kredyty to marża doku.
        function handleTrade(type, key, qty) {
          const amount = Math.max(1, Math.round(Number(qty) || 1));
          if (!RESOURCES[key]) return;
          const station = stationUI.station;
          const econ = station ? InfrastructureUI.ensureEconomy(station) : null;
          if (!econ) {
            toast('Brak magazynu stacji');
            return;
          }
    
          if (type === 'buy') {
            const cost = getTradeBuyPrice(key, station) * amount;
            if (PLAYER.credits < cost) { toast('Za mało kredytów'); return; }
            if ((Number(econ.resources?.[key]) || 0) < amount) { toast('Stacja nie ma zapasu'); return; }
            if (getPlayerCargoFree() < getResourceMassLocal(key, amount)) { toast('Ładownia pełna'); return; }
            PLAYER.credits -= cost;
            econ.resources[key] = (Number(econ.resources[key]) || 0) - amount;
            PLAYER.cargo[key] = (Number(PLAYER.cargo[key]) || 0) + amount;
          } else if (type === 'sell') {
            const held = Number(PLAYER.cargo?.[key]) || 0;
            if (held < amount) return;
            const cap = Number(econ.capacity?.[key]);
            const stock = Number(econ.resources?.[key]) || 0;
            // Nadwyżka ponad pojemność magazynu przepada — dok ją odsprzedaje dalej,
            // ale gracz i tak dostaje pełną zapłatę.
            const stored = Number.isFinite(cap) ? Math.min(amount, Math.max(0, cap - stock)) : amount;
            PLAYER.cargo[key] = held - amount;
            if (PLAYER.cargo[key] <= 0) delete PLAYER.cargo[key];
            econ.resources[key] = stock + stored;
            PLAYER.credits += getTradeSellPrice(key, station) * amount;
            // Regularny handel powoli ociepla stosunki z właścicielem doku.
            if (station.factionId) changePlayerReputation(station.factionId, REPUTATION_EVENTS.tradedGoods);
          }
          updateStationOverlay(stationUI.tab, stationUI.station);
        }
    
        // ============================================================
        // EKONOMIA STACJI
        // Silnik chodzi dla WSZYSTKICH stacji naraz, nie tylko dla tej z otwartym
        // terminalem — inaczej świat zamierałby, gdy gracz na niego nie patrzy,
        // a o to właśnie chodzi, żeby żył sam.
        // ============================================================
    
        let economyCycleTimer = 0;
    
        function updateStationEconomies(dt) {
          economyCycleTimer += dt;
          if (economyCycleTimer < ECONOMY_CYCLE_SECONDS) return;
          const cycles = Math.floor(economyCycleTimer / ECONOMY_CYCLE_SECONDS);
          economyCycleTimer -= cycles * ECONOMY_CYCLE_SECONDS;
          for (const station of stations) {
            if (!station || isDerelict(station)) continue;
            const econ = InfrastructureUI.ensureEconomy(station);
            if (econ) runStationEconomy(station, econ, cycles);
          }
          // Terminal pokazuje stany magazynowe — po cyklu trzeba go odświeżyć.
          if (stationUI.open) updateStationOverlay(stationUI.tab, stationUI.station);
        }
    
        // ============================================================
        // FLOTY TOWAROWE
        // Vany wożą realny ładunek między stacjami. Trasy nie są wpisane w tabelę —
        // biorą się z tego, co się nie bilansuje w produkcji stacji.
        // ============================================================
    
        const cargoFleet = createFleetState();
        const cargoActors = new Map();
        const cargoTransitEvents = [];
        const cargoPoseScratch = { x: 0, y: 0, phase: 'toGate' };
        const CARGO_MATERIALIZE_RADIUS = 15000;
        const CARGO_DEMATERIALIZE_RADIUS = 18000;
        const CARGO_WARP_SPEED = 4000;
        const CARGO_DISPATCH_ENABLED = true;
        const cargoAdvanceOptions = {
          events: cargoTransitEvents,
          getEconomy: resolveCargoEconomy,
          onEvent: onCargoTransitEvent,
          retryIntervalSeconds: 1
        };
    
        function getStationById(stationId) {
          for (let i = 0; i < stations.length; i++) {
            if (stations[i]?.id === stationId) return stations[i];
          }
          return null;
        }
    
        function resolveCargoEconomy(stationId) {
          const station = getStationById(stationId);
          return station ? InfrastructureUI.ensureEconomy(station) : null;
        }
    
        function getCargoVanClass(order) {
          return VAN_CLASSES.find(vanClass => vanClass.id === order?.vanClassId) || VAN_CLASSES[0];
        }
    
        function getCargoTravelSeconds(shipment, route) {
          if (!shipment || !route) return 0;
          const speed = Math.max(1, Number(shipment.vanClass?.speed) || VAN_CLASSES[0].speed);
          const source = shipment.source;
          const target = shipment.target;
          const toGate = Math.hypot(route.start.x - source.x, route.start.y - source.y) / speed;
          const fromGate = Math.hypot(target.x - route.end.x, target.y - route.end.y) / speed;
          return Math.max(1, toGate + route.length / CARGO_WARP_SPEED + fromGate);
        }
    
        function fillCargoOrderPose(order, route, out) {
          const source = route?.fromRef;
          const target = route?.toRef;
          if (!source || !target || !out) return false;
          if (order.status === SHIPMENT_STATUS.AWAITING_UNLOAD) {
            out.x = target.x;
            out.y = target.y;
            out.phase = 'toStation';
            return true;
          }
    
          const vanClass = getCargoVanClass(order);
          const speed = Math.max(1, Number(vanClass?.speed) || 1);
          const total = Math.max(0.001, Number(order.route?.durationSeconds) || 0.001);
          const elapsed = Math.max(0, Math.min(total, Number(order.routeProgress) * total || 0));
          const toGateDuration = Math.hypot(route.start.x - source.x, route.start.y - source.y) / speed;
          const warpDuration = route.length / CARGO_WARP_SPEED;
    
          if (elapsed < toGateDuration) {
            const t = toGateDuration > 0 ? elapsed / toGateDuration : 1;
            out.x = source.x + (route.start.x - source.x) * t;
            out.y = source.y + (route.start.y - source.y) * t;
            out.phase = 'toGate';
            return true;
          }
          if (elapsed < toGateDuration + warpDuration) {
            const t = warpDuration > 0 ? (elapsed - toGateDuration) / warpDuration : 1;
            out.x = route.start.x + (route.end.x - route.start.x) * t;
            out.y = route.start.y + (route.end.y - route.start.y) * t;
            out.phase = 'warping';
            return true;
          }
    
          const fromGateDuration = Math.max(0.001, total - toGateDuration - warpDuration);
          const t = Math.max(0, Math.min(1, (elapsed - toGateDuration - warpDuration) / fromGateDuration));
          out.x = route.end.x + (target.x - route.end.x) * t;
          out.y = route.end.y + (target.y - route.end.y) * t;
          out.phase = 'toStation';
          return true;
        }
    
        function cargoSegmentProgress(ax, ay, bx, by, x, y) {
          const dx = bx - ax;
          const dy = by - ay;
          const lengthSq = dx * dx + dy * dy;
          if (lengthSq <= 0.000001) return 1;
          return clamp(((x - ax) * dx + (y - ay) * dy) / lengthSq, 0, 1);
        }
    
        function getCargoActorRouteProgress(order, route, van) {
          const source = route?.fromRef;
          const target = route?.toRef;
          if (!source || !target || !van) return Number(order?.routeProgress) || 0;
          if (van.docking || order.status === SHIPMENT_STATUS.AWAITING_UNLOAD) return 1;
    
          const vanClass = getCargoVanClass(order);
          const speed = Math.max(1, Number(vanClass?.speed) || 1);
          const toGateDuration = Math.hypot(route.start.x - source.x, route.start.y - source.y) / speed;
          const warpDuration = route.length / CARGO_WARP_SPEED;
          const toStationDuration = Math.hypot(target.x - route.end.x, target.y - route.end.y) / speed;
          const duration = Math.max(0.001, Number(order.route?.durationSeconds)
            || toGateDuration + warpDuration + toStationDuration);
          let elapsed = 0;
    
          if (van.phase === 'warping') {
            elapsed = toGateDuration + warpDuration * cargoSegmentProgress(
              route.start.x, route.start.y, route.end.x, route.end.y, van.x, van.y
            );
          } else if (van.phase === 'toStation') {
            elapsed = toGateDuration + warpDuration + toStationDuration * cargoSegmentProgress(
              route.end.x, route.end.y, target.x, target.y, van.x, van.y
            );
          } else {
            elapsed = toGateDuration * cargoSegmentProgress(
              source.x, source.y, route.start.x, route.start.y, van.x, van.y
            );
          }
          return clamp(elapsed / duration, 0, 1);
        }
    
        function cargoDistanceToPlayerSq(x, y) {
          const dx = (Number(x) || 0) - ship.pos.x;
          const dy = (Number(y) || 0) - ship.pos.y;
          return dx * dx + dy * dy;
        }
    
        function ensureCargoWreckFragment(van) {
          if (van?._cargoWreck) return van._cargoWreck;
          const shards = van?.hexGrid?.shards;
          if (!Array.isArray(shards) || shards.length === 0 || !window.createWreckage) return null;
          let shard = shards.find(candidate => candidate?.active && !candidate.isDebris && candidate.hp > 0);
          if (!shard) shard = shards.find(candidate => candidate && !candidate.isDebris) || shards[0];
          if (!shard) return null;
    
          // Nawet całkowite zniszczenie kratownicy zostawia jeden realny fragment
          // kadłuba jako nośnik partii; nie tworzymy osobnego obiektu-kontenera.
          if (!shard.active || shard.hp <= 0 || shard.isDebris) {
            shard.active = true;
            shard.isDebris = false;
            shard.hp = Math.max(1, Number(shard.maxHp) || 1);
          }
          return window.createWreckage(van, [shard]) || van._cargoWreck || null;
        }
    
        function ensureCargoWreckInventory(wreck, order) {
          if (!wreck) return null;
          const shardCount = Math.max(1, Number(wreck.hexGrid?.activeStructuralCount) || 1);
          if (!wreck._salvage) {
            wreck._salvage = {
              weapons: [],
              materials: {},
              materialsTotal: {},
              sourceShards: shardCount,
              remainingShards: shardCount,
              label: `Wrak transportu ${order.id}`
            };
          }
          if (!wreck._salvage.materials) wreck._salvage.materials = {};
          if (!wreck._salvage.materialsTotal) wreck._salvage.materialsTotal = { ...wreck._salvage.materials };
          if (!wreck._cargoManifest || typeof wreck._cargoManifest !== 'object') wreck._cargoManifest = {};
          return wreck._cargoManifest;
        }
    
        function handleCargoVanDestroyed(van) {
          const order = getShipmentOrder(cargoFleet, van?._cargoOrderId || van?.shipmentOrderId);
          if (!order || order.status === SHIPMENT_STATUS.DELIVERED) return false;
          const wreck = van._cargoWreck || ensureCargoWreckFragment(van);
          if (!wreck) return false;
          const wreckId = wreck._cargoWreckId || `cargo-wreck:${order.id}`;
          const inventory = ensureCargoWreckInventory(wreck, order);
          const result = wreckShipmentOrder(order, wreckId, inventory, cargoFleet.elapsedSeconds);
          if (wreck && Object.keys(result.moved || {}).length) {
            wreck._cargoOrderId = order.id;
            wreck._cargoWreckId = wreckId;
          }
          removeActorFromTransitQueues(van);
          return result.changed;
        }
    
        function removeCargoVanView(order, van, saveState = true) {
          if (!van) return;
          removeActorFromTransitQueues(van);
          if (saveState && order?.actorId && !van.dead) {
            const route = getWarpRoute(order.sourceStationId, order.targetStationId);
            const routeProgress = route
              ? getCargoActorRouteProgress(order, route, van)
              : (Number(order.routeProgress) || 0);
            dematerializeShipmentOrderView(order, van, {
              x: van.x,
              y: van.y,
              vx: van.vx,
              vy: van.vy,
              angle: van.angle,
              hp: van.hp,
              maxHp: van.maxHp,
              lane: van.lane,
              dockPort: van.dockPort,
              phase: van.phase,
              routeProgress,
              clockTime: cargoFleet.elapsedSeconds
            });
          } else {
            if (order?.actorId) dematerializeShipmentOrderView(order, van);
            delete van.shipmentOrderId;
            delete van.shipmentViewId;
          }
          releaseNpcHexBody(van);
          const npcIndex = npcs.indexOf(van);
          if (npcIndex >= 0) npcs.splice(npcIndex, 1);
          if (order) cargoActors.delete(order.id);
          van._cargoOrderId = null;
        }
    
        function materializeCargoOrder(order) {
          const source = getStationById(order.sourceStationId);
          const target = getStationById(order.targetStationId);
          const route = getWarpRoute(order.sourceStationId, order.targetStationId);
          if (!source || !target || !route || !fillCargoOrderPose(order, route, cargoPoseScratch)) return null;
    
          const vanClass = getCargoVanClass(order);
          const stats = NPC_TYPES[vanClass.npcType] || NPC_TYPES['freighter-small'];
          const saved = order.viewState || null;
          const savedIsCurrent = saved
            && Number.isFinite(Number(saved.x))
            && Number.isFinite(Number(saved.y))
            && Number.isFinite(Number(saved.recordElapsedSeconds))
            && Math.abs(Number(saved.recordElapsedSeconds) - Number(order.elapsedSeconds)) <= 1e-6;
          const spawnPose = savedIsCurrent ? saved : cargoPoseScratch;
          const van = makeNPCBase(spawnPose, {
            ...stats,
            hp: Number(saved?.maxHp) || stats.hp,
            maxSpeed: vanClass.speed,
            accel: vanClass.speed * 0.6,
            turn: 1.4
          });
          van.id = `cargo-view:${order.id}`;
          van.type = vanClass.npcType;
          van.shipFrame = 'terran_frigate';
          van.factionId = normalizeFaction(order.factionId);
          van.isCargoVan = true;
          van.isCollidable = true;
          van.combatDisabled = true;
          van.displayName = `Transport ${vanClass.id.toUpperCase()}`;
          van.color = stats.color;
          van._cargoOrderId = order.id;
          van.hp = Math.max(1, Math.min(van.maxHp, Number(saved?.hp) || van.maxHp));
          van.angle = savedIsCurrent && Number.isFinite(Number(saved?.angle))
            ? Number(saved.angle)
            : Math.atan2(route.dir.y, route.dir.x);
    
          if (!assignTransitRoute(van, source, target, route, {
            phase: spawnPose.phase,
            lane: saved?.lane,
            dockPort: saved?.dockPort,
            speed: vanClass.speed,
            resetVelocity: spawnPose.phase !== 'warping',
            warpSpeed: CARGO_WARP_SPEED
          })) return null;
          van.x = spawnPose.x;
          van.y = spawnPose.y;
          if (savedIsCurrent && Number.isFinite(Number(saved.vx)) && Number.isFinite(Number(saved.vy))) {
            van.vx = Number(saved.vx);
            van.vy = Number(saved.vy);
          }
    
          if (order.status === SHIPMENT_STATUS.AWAITING_UNLOAD) {
            const portPos = stationPortWorld(target, van.dockPort || 0);
            van.x = portPos.x;
            van.y = portPos.y;
            van.vx = 0;
            van.vy = 0;
            van.docking = true;
            van.lastStation = target.id;
          }
    
          if (!materializeShipmentOrderView(order, van)) {
            removeActorFromTransitQueues(van);
            return null;
          }
          syncEntityFactionFlags(van);
          assignNpcShipFrame?.(van);
          npcs.push(van);
          cargoActors.set(order.id, van);
          return van;
        }
    
        function notifyCargoDelivery(order, delivered) {
          const target = getStationById(order?.targetStationId);
          if (!cargoBagIsEmpty(delivered) && target && stationUI.open && stationUI.station === target) {
            toast(`Dostawa: ${describeCargo(delivered)}`);
          }
        }
    
        function reconcileCargoViewsBeforeAdvance() {
          for (const [orderId, van] of cargoActors) {
            const order = getShipmentOrder(cargoFleet, orderId);
            if (!order) {
              removeCargoVanView(null, van, false);
              cargoActors.delete(orderId);
              continue;
            }
            if (van.dead) {
              handleCargoVanDestroyed(van);
              removeCargoVanView(order, van, false);
              continue;
            }
            if (order.status === SHIPMENT_STATUS.DELIVERED || order.status === SHIPMENT_STATUS.WRECK) {
              removeCargoVanView(order, van, false);
              continue;
            }
            if (van.docking && van.lastStation === order.targetStationId
              && order.status === SHIPMENT_STATUS.IN_TRANSIT) {
              const target = getStationById(order.targetStationId);
              const econ = target ? InfrastructureUI.ensureEconomy(target) : null;
              const result = tryDeliverShipmentOrder(order, econ, cargoFleet.elapsedSeconds);
              if (result.changed) {
                notifyCargoDelivery(order, result.delivered);
                removeCargoVanView(order, van, false);
                continue;
              }
              order.nextUnloadAttemptAt = cargoFleet.elapsedSeconds + cargoAdvanceOptions.retryIntervalSeconds;
            }
            if (cargoDistanceToPlayerSq(van.x, van.y) > CARGO_DEMATERIALIZE_RADIUS * CARGO_DEMATERIALIZE_RADIUS) {
              removeCargoVanView(order, van, true);
            }
          }
        }
    
        function syncCargoOrderViews() {
          for (const [orderId, van] of cargoActors) {
            const order = getShipmentOrder(cargoFleet, orderId);
            const active = order && (order.status === SHIPMENT_STATUS.IN_TRANSIT
              || order.status === SHIPMENT_STATUS.AWAITING_UNLOAD);
            if (!active) removeCargoVanView(order, van, false);
          }
          for (const order of cargoFleet.activeOrders) {
            if (!order) continue;
            const existing = cargoActors.get(order.id);
            if (existing) continue;
            if (order.actorId) dematerializeShipmentOrderView(order, order.actorId, order.viewState);
            const route = getWarpRoute(order.sourceStationId, order.targetStationId);
            if (!route || !fillCargoOrderPose(order, route, cargoPoseScratch)) continue;
            if (cargoDistanceToPlayerSq(cargoPoseScratch.x, cargoPoseScratch.y)
              <= CARGO_MATERIALIZE_RADIUS * CARGO_MATERIALIZE_RADIUS) {
              materializeCargoOrder(order);
            }
          }
        }
    
        function onCargoTransitEvent(event, order) {
          if (event?.type === 'delivered') notifyCargoDelivery(order, event.result?.delivered || {});
        }
    
        function countActiveCargoOrders() {
          return cargoFleet.activeOrders.length;
        }
    
        /**
         * Wystawia jedno zlecenie transportowe. Zwraca `{ ok, order, reason }`,
         * żeby konsola deweloperska mogła powiedzieć, DLACZEGO nic nie poleciało —
         * najczęstszy powód to brak rozbieżności w magazynach, nie usterka.
         */
        function dispatchOneCargoOrder(options = {}) {
          if (!options.force && countActiveCargoOrders() >= MAX_ACTIVE_VANS) {
            return { ok: false, reason: `limit ${MAX_ACTIVE_VANS} aktywnych transportów` };
          }
          const shipment = planShipment(
            stations,
            (station) => InfrastructureUI.ensureEconomy(station),
            { skipPairs: options.ignoreCooldowns ? new Set() : getBlockedPairs(cargoFleet) }
          );
          if (!shipment) {
            return { ok: false, reason: 'brak pary nadwyżka→niedobór (magazyny za blisko progów 70%/25%)' };
          }
          const route = getWarpRoute(shipment.source.id, shipment.target.id);
          if (!route) {
            blockRoute(cargoFleet, shipment.source, shipment.target);
            return { ok: false, reason: `brak trasy warp ${shipment.source.id}→${shipment.target.id}` };
          }
          const sourceEcon = InfrastructureUI.ensureEconomy(shipment.source);
          const order = createShipmentOrder(cargoFleet, shipment, sourceEcon, route, {
            travelSeconds: getCargoTravelSeconds(shipment, route),
            warpSpeed: CARGO_WARP_SPEED
          });
          if (!order) {
            blockRoute(cargoFleet, shipment.source, shipment.target);
            return { ok: false, reason: 'towar zniknął między planowaniem a załadunkiem' };
          }
          return { ok: true, order, shipment };
        }
    
        function updateCargoFleet(dt) {
          tickCooldowns(cargoFleet, dt);
          reconcileCargoViewsBeforeAdvance();
          syncCargoOrderViews();
          advanceShipmentOrders(cargoFleet, dt, cargoAdvanceOptions);
    
          if (!CARGO_DISPATCH_ENABLED) return;
          cargoFleet.dispatchTimer += dt;
          if (cargoFleet.dispatchTimer < DISPATCH_INTERVAL) return;
          cargoFleet.dispatchTimer -= DISPATCH_INTERVAL;
          dispatchOneCargoOrder();
        }
    
        // ============================================================
        // KONSOLA DEWELOPERSKA — window.Cargo
        // Ekonomia potrzebuje minut, żeby magazyny rozjechały się poza progi
        // 70%/25% i pojawiła się pierwsza para nadwyżka→niedobór. Testowanie
        // transportu w tempie czasu rzeczywistego jest przez to bardzo powolne.
        // ============================================================
    
        window.Cargo = {
          /** Przewija gospodarkę o N cykli (1 cykl = 20 s gry). To usuwa czekanie. */
          economy(cycles = 30) {
            const runs = Math.max(1, Math.floor(cycles));
            let touched = 0;
            for (const station of stations) {
              if (!station || isDerelict(station)) continue;
              const econ = InfrastructureUI.ensureEconomy(station);
              if (econ && runStationEconomy(station, econ, runs)) touched++;
            }
            if (stationUI.open) updateStationOverlay(stationUI.tab, stationUI.station);
            console.log(`[Cargo] przewinięto ${runs} cykli (${runs * ECONOMY_CYCLE_SECONDS}s gry) na ${touched} stacjach`);
            return this.trade();
          },
    
          /** Wymusza jedno zlecenie natychmiast, z pominięciem timera i karencji. */
          dispatch() {
            const result = dispatchOneCargoOrder({ force: true, ignoreCooldowns: true });
            if (!result.ok) {
              console.warn(`[Cargo] nic nie wysłano — ${result.reason}`);
              console.info('[Cargo] spróbuj najpierw: Cargo.economy(40)');
              return null;
            }
            const { order, shipment } = result;
            console.log(`[Cargo] ${shipment.source.id} → ${shipment.target.id}: `
              + `${describeCargo(order.manifest)} (${shipment.vanClass.id}, ETA ${Math.round(order.remainingSeconds)}s)`);
            return order;
          },
    
          /** Lista transportów w drodze. */
          list() {
            const rows = cargoFleet.activeOrders.map(o => ({
              trasa: `${o.sourceStationId} → ${o.targetStationId}`,
              ładunek: describeCargo(o.manifest),
              'ETA (s)': Math.round(o.remainingSeconds ?? 0),
              status: o.status,
              widoczny: o.actorId ? 'tak' : 'nie'
            }));
            if (!rows.length) console.log('[Cargo] brak transportów w drodze');
            else console.table(rows);
            return rows;
          },
    
          /** Dowozi wszystko, co jest w drodze. Zmaterializowane pomija — te wiozą się fizyką. */
          arrive() {
            const visible = cargoFleet.activeOrders.filter(o => o.actorId).length;
            advanceShipmentOrders(cargoFleet, 100000, cargoAdvanceOptions);
            if (visible) console.warn(`[Cargo] ${visible} transportów jest widocznych — te dolecą fizycznie, nie skokiem`);
            console.log('[Cargo] pozostałe dostarczone');
            return this.list();
          },
    
          /** Stan magazynów: gdzie jest nadwyżka, a gdzie głód. */
          trade() {
            const rows = [];
            for (const station of stations) {
              if (!station || isDerelict(station)) continue;
              const econ = InfrastructureUI.ensureEconomy(station);
              if (!econ) continue;
              rows.push({
                stacja: station.id,
                oddaje: getStationSurpluses(station, econ, 3).map(s => `${s.id}×${s.spare}`).join(' ') || '—',
                potrzebuje: getStationDeficits(station, econ, 3).map(d => `${d.id} ${(d.fill * 100).toFixed(0)}%`).join(' ') || '—'
              });
            }
            console.table(rows);
            return rows;
          },
    
          help() {
            console.log([
              'Cargo.economy(n)  przewiń gospodarkę o n cykli po 20 s (domyślnie 30)',
              'Cargo.dispatch()  wymuś jedno zlecenie natychmiast',
              'Cargo.list()      transporty w drodze',
              'Cargo.arrive()    dowieź wszystko, co niewidoczne',
              'Cargo.trade()     kto ma nadwyżkę, a kto głoduje',
              '',
              'Typowy test:  Cargo.economy(40)  →  Cargo.dispatch()  →  Cargo.list()'
            ].join('\n'));
          }
        };
    
        // ============================================================
        // OPUSZCZONE STACJE
        // Stacja bez właściciela nic nie produkuje, ale w magazynach został towar
        // po poprzednich mieszkańcach. To jedyne miejsce, gdzie da się wziąć
        // komponenty bez płacenia i bez psucia sobie z kimkolwiek stosunków.
        // ============================================================
    
        const DERELICT_LOOT_POOL = [
          { id: 'steel', min: 40, max: 180 },
          { id: 'polymer', min: 20, max: 90 },
          { id: 'chips', min: 4, max: 26 },
          { id: 'copper_wire', min: 15, max: 70 },
          { id: 'hull_plate', min: 2, max: 14 },
          { id: 'coolant', min: 10, max: 45 },
          { id: 'avionics', min: 0, max: 5 },
          { id: 'scrap', min: 60, max: 240 }
        ];
    
        // Stacje nie zaczynają z pustymi magazynami: czynne mają zapas roboczy,
        // opuszczone — resztki po poprzednikach. Start od zera dawał sztuczny
        // kryzys, bo producent oddaje nadwyżkę dopiero powyżej progu zapełnienia.
        function seedStationEconomies() {
          for (const station of stations) {
            if (isDerelict(station) || station._stockSeeded) continue;
            station._stockSeeded = true;
            const econ = InfrastructureUI.ensureEconomy(station);
            if (econ) seedStationStock(station, econ);
          }
          seedDerelictStations();
        }
    
        function seedDerelictStations() {
          for (const station of stations) {
            if (!isDerelict(station) || station._derelictSeeded) continue;
            station._derelictSeeded = true;
            const econ = InfrastructureUI.ensureEconomy(station);
            if (!econ) continue;
            for (const entry of DERELICT_LOOT_POOL) {
              const amount = Math.round(entry.min + Math.random() * (entry.max - entry.min));
              if (amount <= 0) continue;
              const cap = Number(econ.capacity?.[entry.id]);
              econ.resources[entry.id] = Number.isFinite(cap) ? Math.min(cap, amount) : amount;
            }
          }
        }
    
        // ============================================================
        // SALVAGE — odzysk łupu z wraków
        // Dwie ścieżki: cięcie w polu (szybko, bez broni) i holowanie do doku
        // (wolno, ryzykownie, pełny łup z bronią w całości).
        // ============================================================
    
        const salvageState = {
          cutting: null,      // wrak aktualnie cięty
          cutDebt: 0,         // ułamkowe komórki do zdjęcia, przenoszone między klatkami
          towed: null,        // wrak na linie
          towHandle: null,
          messageCooldown: 0  // dławi spam komunikatów o odzysku
        };
    
        /** Dokłada surowce do ładowni w granicach udźwigu. Zwraca co faktycznie weszło. */
        function addToPlayerCargo(bag) {
          const accepted = {};
          let free = getPlayerCargoFree();
          for (const [id, amount] of Object.entries(bag || {})) {
            const def = RESOURCES[id];
            if (!def) continue;
            const want = Math.floor(Number(amount) || 0);
            if (want <= 0) continue;
            // Surowce bez masy (gdyby się trafiły) nie mogą dzielić przez zero.
            const perUnit = def.mass > 0 ? def.mass : 0.0001;
            const fits = Math.min(want, Math.floor(free / perUnit));
            if (fits <= 0) continue;
            PLAYER.cargo[id] = (Number(PLAYER.cargo[id]) || 0) + fits;
            accepted[id] = fits;
            free -= fits * perUnit;
          }
          return accepted;
        }
    
        function cargoBagIsEmpty(bag) {
          for (const amount of Object.values(bag || {})) {
            if ((Number(amount) || 0) > 0) return false;
          }
          return true;
        }
    
        function recoverCargoWreckToPlayer(wreck) {
          if (!wreck || cargoBagIsEmpty(wreck._cargoManifest)) return { changed: false, moved: {} };
          if (getBagMass(wreck._cargoManifest) > getPlayerCargoFree() + 1e-6) {
            return { changed: false, moved: {}, reason: 'capacity' };
          }
          const order = getShipmentOrder(cargoFleet, wreck._cargoOrderId);
          if (!order) return { changed: false, moved: {}, reason: 'missing-order' };
          return recoverWreckedShipmentOrder(order, wreck._cargoManifest, PLAYER.cargo, {
            ownerKind: SHIPMENT_OWNER_KIND.PLAYER,
            ownerId: 'player',
            now: cargoFleet.elapsedSeconds
          });
        }
    
        function recoverCargoWreckToStation(wreck, station, econ) {
          if (!wreck || !station || cargoBagIsEmpty(wreck._cargoManifest)) return { changed: false, moved: {} };
          const order = getShipmentOrder(cargoFleet, wreck._cargoOrderId);
          if (!order) return { changed: false, moved: {}, reason: 'missing-order' };
          return recoverWreckedShipmentOrder(order, wreck._cargoManifest, econ, {
            ownerKind: SHIPMENT_OWNER_KIND.STATION,
            ownerId: station.id,
            now: cargoFleet.elapsedSeconds
          });
        }
    
        function formatCargoBag(bag) {
          return Object.entries(bag || {})
            .filter(([, amount]) => (Number(amount) || 0) > 0)
            .map(([id, amount]) => `${getResourceLabel(id)} ×${Math.round(amount)}`)
            .join(', ');
        }
    
        function isSalvageableWreck(entity) {
          return !!entity && entity.isWreck === true && !entity.dead && hasSalvage(entity);
        }
    
        function salvageDistanceToShip(wreck) {
          if (!wreck || !ship?.pos) return Infinity;
          return Math.hypot((wreck.x ?? wreck.pos?.x ?? 0) - ship.pos.x, (wreck.y ?? wreck.pos?.y ?? 0) - ship.pos.y);
        }
    
        function startFieldSalvage(wreck) {
          if (!isSalvageableWreck(wreck)) {
            pushZoneMessage('SALVAGE: NIC DO WYCIĘCIA', 1.4);
            return;
          }
          // Zimny wrak nie ma siatki do cięcia — najpierw odmrożenie (najwyżej
          // jedno na klatkę; z kolejki cięcie ruszy klatkę później).
          if (wreck.isCold) {
            if (thawWreck(wreck, 'salvage', startFieldSalvage) === THAW_RESULT.FAILED) {
              pushZoneMessage('SALVAGE: WRAKU NIE DA SIĘ PODJĄĆ', 1.4);
            }
            return;
          }
          if (salvageState.towed === wreck) {
            pushZoneMessage('SALVAGE: WRAK NA HOLU — ODEPNIJ ALBO ODDAJ W DOKU', 1.6);
            return;
          }
          salvageState.cutting = wreck;
          salvageState.cutDebt = 0;
          const info = describeSalvage(wreck);
          const weaponsNote = info?.weaponCount ? ` | ${info.weaponCount} dz. przepadnie` : '';
          pushZoneMessage(`SALVAGE: CIĘCIE${weaponsNote}`, 1.6);
        }
    
        function stopFieldSalvage(reason = '') {
          if (!salvageState.cutting) return;
          salvageState.cutting = null;
          salvageState.cutDebt = 0;
          if (reason) pushZoneMessage(reason, 1.4);
        }
    
        /**
         * Zdejmuje komórkę najdalszą od środka fragmentu — kadłub znika od krawędzi
         * do wnętrza, co czyta się jak cięcie, a nie losowe rozpuszczanie.
         * Liczone w lokalnych współrzędnych kratownicy, bez transformacji do świata.
         */
        function cutOuterShard(wreck) {
          const grid = wreck?.hexGrid;
          const shards = grid?.shards;
          if (!Array.isArray(shards) || !shards.length) return false;
          const cx = (Number(grid.srcWidth) || 0) * 0.5 + (Number(grid.pivot?.x) || 0);
          const cy = (Number(grid.srcHeight) || 0) * 0.5 + (Number(grid.pivot?.y) || 0);
          let best = null;
          let bestD2 = -1;
          for (const shard of shards) {
            if (!shard || !shard.active || shard.isDebris) continue;
            const dx = (Number(shard.gridX) || 0) - cx;
            const dy = (Number(shard.gridY) || 0) - cy;
            const d2 = dx * dx + dy * dy;
            if (d2 > bestD2) {
              bestD2 = d2;
              best = shard;
            }
          }
          if (!best) return false;
          DestructorSystem?.destroyShard?.(wreck, best, { x: 0, y: 0 });
          return true;
        }
    
        function updateFieldSalvage(dt) {
          const wreck = salvageState.cutting;
          if (!wreck) return;
          if (wreck.dead) {
            stopFieldSalvage('SALVAGE: WRAK PRZEPADŁ');
            return;
          }
          if (salvageDistanceToShip(wreck) > FIELD_CUT_RANGE) {
            stopFieldSalvage('SALVAGE: POZA ZASIĘGIEM');
            return;
          }
    
          const cargoRecovery = recoverCargoWreckToPlayer(wreck);
          if (cargoRecovery.changed) {
            pushZoneMessage(`ODZYSKANO ŁADUNEK: ${formatCargoBag(cargoRecovery.moved)}`, 1.8);
          }
          if (!wreck.hexGrid) {
            stopFieldSalvage(cargoRecovery.reason === 'capacity'
              ? 'SALVAGE: CAŁA PARTIA NIE MIEŚCI SIĘ W ŁADOWNI'
              : 'SALVAGE: PUSTY KONTENER');
            return;
          }
          if (getPlayerCargoFree() <= 0) {
            stopFieldSalvage('SALVAGE: ŁADOWNIA PEŁNA');
            return;
          }
    
          const before = Number(wreck.hexGrid.activeStructuralCount) || 0;
          if (before <= 0) {
            stopFieldSalvage('SALVAGE: WRAK ROZEBRANY');
            return;
          }
    
          salvageState.cutDebt += FIELD_CUT_SHARDS_PER_SECOND * dt;
          // Limit na klatkę chroni przed lawiną po zacięciu (np. po alt-tabie).
          let budget = Math.min(8, Math.floor(salvageState.cutDebt));
          while (budget > 0) {
            if (!cutOuterShard(wreck)) break;
            salvageState.cutDebt -= 1;
            budget--;
          }
    
          const after = Number(wreck.hexGrid.activeStructuralCount) || 0;
          const removed = Math.max(0, before - after);
          if (removed <= 0) return;
    
          // Łup liczony z FAKTYCZNIE ubytej struktury, nie z upływu czasu — dzięki
          // temu nie da się go zdublować, gdy wrak rozwala równolegle ktoś inny.
          const salvage = getSalvage(wreck);
          const denom = Math.max(1, Number(salvage?.remainingShards) || before);
          const yielded = takeFieldCut(wreck, removed / denom);
          if (cargoBagIsEmpty(yielded)) return;
    
          const accepted = addToPlayerCargo(yielded);
          // Odliczanie własnym timerem, nie gameTime — ten zawija się co dobę.
          salvageState.messageCooldown = Math.max(0, salvageState.messageCooldown - dt);
          if (!cargoBagIsEmpty(accepted) && salvageState.messageCooldown <= 0) {
            salvageState.messageCooldown = 1.2;
            pushZoneMessage(`+ ${formatCargoBag(accepted)}`, 1.2);
          }
        }
    
        // --- Holowanie ---
    
        function startWreckTow(wreck) {
          if (!isSalvageableWreck(wreck)) {
            pushZoneMessage('HOL: NIC DO ZABRANIA', 1.4);
            return;
          }
          if (salvageState.towed) {
            pushZoneMessage('HOL: JUŻ HOLUJESZ WRAK', 1.4);
            return;
          }
          // Holownik „wyciąga” zimny wrak z tła: odmrożenie, potem zaczep (z kolejki
          // odmrożeń — klatkę później, tym samym wywołaniem).
          if (wreck.isCold) {
            if (thawWreck(wreck, 'tow', startWreckTow) === THAW_RESULT.FAILED) {
              pushZoneMessage('HOL: WRAKU NIE DA SIĘ PODJĄĆ', 1.4);
            }
            return;
          }
          if (salvageState.cutting === wreck) stopFieldSalvage();
    
          const restLength = (Number(ship.radius) || 220) + (Number(wreck.radius) || 200) + 260;
          const handle = window.attachTowRope?.(ship, wreck, {
            length: restLength,
            stiffness: 0.26,
            damping: 0.9,
            collideConnected: false,
            // Zbyt ostry manewr zrywa linę — holowanie ma być realnym obciążeniem,
            // a nie darmowym doczepieniem masy.
            breakForce: 260000,
            tag: 'salvage-tow',
            onBreak: () => {
              if (salvageState.towed === wreck) {
                salvageState.towed = null;
                salvageState.towHandle = null;
                pushZoneMessage('HOL: LINA ZERWANA', 1.6);
              }
            }
          });
          if (!handle) {
            pushZoneMessage('HOL: NIE UDAŁO SIĘ ZACZEPIĆ', 1.4);
            return;
          }
          // Holowany wrak nie może zasnąć — uśpiony wypada z solvera i lina
          // przestaje na niego działać.
          wreck.noWreckSleep = true;
          wreck._wreckSleeping = false;
          salvageState.towed = wreck;
          salvageState.towHandle = handle;
          pushZoneMessage('HOL: WRAK NA LINIE — LEĆ DO STACJI', 2.0);
        }
    
        function releaseWreckTow(reason = '') {
          if (!salvageState.towHandle) return;
          window.detachTowRope?.(salvageState.towHandle);
          if (salvageState.towed) salvageState.towed.noWreckSleep = false;
          salvageState.towed = null;
          salvageState.towHandle = null;
          if (reason) pushZoneMessage(reason, 1.4);
        }
    
        /** Zdejmuje wrak ze świata i oddaje obiekt do puli destruktora. */
        function removeWreckFromWorld(wreck) {
          if (!wreck) return;
          wreck.dead = true;
          wreck.isCollidable = false;
          TowSystem.detachBody(wreck, 'wreck-removed');
          const list = Array.isArray(window.wrecks) ? window.wrecks : null;
          const idx = list ? list.indexOf(wreck) : -1;
          if (idx >= 0) list.splice(idx, 1);
          // Zimny wrak żyje tylko w coldWrecks — pula nie może wydać obiektu,
          // który nadal tam wisi.
          coldWreckSystem.forget(wreck);
          DestructorSystem?.recycleWreck?.(wreck);
        }
    
        function findDeliveryStation(wreck) {
          const list = Array.isArray(window.stations) ? window.stations : [];
          const wx = wreck.x ?? wreck.pos?.x ?? 0;
          const wy = wreck.y ?? wreck.pos?.y ?? 0;
          for (const station of list) {
            const sx = Number(station?.x);
            const sy = Number(station?.y);
            if (!Number.isFinite(sx) || !Number.isFinite(sy)) continue;
            if (Math.hypot(sx - wx, sy - wy) <= DOCK_DELIVERY_RANGE) return station;
          }
          return null;
        }
    
        function updateWreckTow() {
          const wreck = salvageState.towed;
          if (!wreck) return;
          if (wreck.dead || !wreck.hexGrid) {
            releaseWreckTow('HOL: WRAK PRZEPADŁ');
            return;
          }
          const station = findDeliveryStation(wreck);
          if (!station) return;
          deliverWreckToDock(wreck, station);
        }
    
        /**
         * Rozbiórka w doku — pełne materiały trafiają do magazynu stacji (nie do
         * ładowni: wrak ma masę setek ton), a broń w całości do ładowni gracza.
         */
        function deliverWreckToDock(wreck, station) {
          const econ = InfrastructureUI.ensureEconomy(station);
          const cargoRecovery = recoverCargoWreckToStation(wreck, station, econ);
          const { materials, weapons } = takeDockSalvage(wreck);
          const storedParts = [];
          if (econ) {
            for (const [id, amount] of Object.entries(materials)) {
              if (!RESOURCES[id]) continue;
              const cap = Number(econ.capacity?.[id]);
              const stock = Number(econ.resources?.[id]) || 0;
              const stored = Number.isFinite(cap) ? Math.min(amount, Math.max(0, cap - stock)) : amount;
              if (stored <= 0) continue;
              econ.resources[id] = stock + stored;
              storedParts.push(`${getResourceLabel(id)} ×${Math.round(stored)}`);
            }
          }
    
          const inventory = Game.player?.inventory;
          const recovered = [];
          for (const weaponId of weapons) {
            if (!WEAPONS[weaponId]) continue;
            inventory?.give(weaponId, 1);
            recovered.push(WEAPONS[weaponId].name || weaponId);
          }
    
          releaseWreckTow();
          if (!hasSalvage(wreck)) {
            // Wrak zniknął w rozbiórce. Sama flaga `dead` nie wystarczy — pętla
            // wraków jej nie sprawdza, więc kadłub wisiałby przy stacji w nieskończoność.
            removeWreckFromWorld(wreck);
          }
    
          pushZoneMessage(cargoRecovery.reason === 'capacity'
            ? 'ROZBIÓRKA: ŁADUNEK CZEKA NA MIEJSCE W MAGAZYNIE'
            : 'ROZBIÓRKA UKOŃCZONA', 2.2);
          if (cargoRecovery.changed) toast(`Odzyskany ładunek: ${formatCargoBag(cargoRecovery.moved)}`);
          if (storedParts.length) toast(`Magazyn stacji: ${storedParts.join(', ')}`);
          if (recovered.length) toast(`Odzyskana broń: ${recovered.join(', ')}`);
          else toast('Wrak nie miał sprawnego uzbrojenia');
          renderMechanic?.();
        }
    
        function updateSalvage(dt) {
          updateFieldSalvage(dt);
          updateWreckTow();
        }
    
        function purchaseUpgrade(upgrade) {
          if (!upgrade) return;
          if (PLAYER.credits >= upgrade.cost) {
            PLAYER.credits -= upgrade.cost;
            upgrade.apply();
            toast('Zainstalowano: ' + upgrade.name);
          } else {
            toast('Za mało kredytów');
          }
          updateStationOverlay(stationUI.tab, stationUI.station);
        }
        function updateHangarCards() {
          const pane = stationOverlayDom.panels.hangar;
          if (!pane) return;
          const activeHullId = normalizePlayerHullId(PLAYER.activeHullId || ship.activeHullId || DEFAULT_PLAYER_HULL_ID);
          for (const btn of pane.querySelectorAll('button[data-hull-action]')) {
            const action = btn.dataset.hullAction;
            const hullId = normalizePlayerHullId(btn.dataset.hullId);
            const cost = Number(btn.dataset.cost) || 0;
            if (action === 'buy') {
              btn.disabled = PLAYER.credits < cost;
            } else if (action === 'enter') {
              btn.disabled = hullId === activeHullId;
            }
          }
          // Update repair row
          const hullMax = Math.max(1, Number(ship?.hull?.max) || 1);
          const hullVal = Math.max(0, Number(ship?.hull?.val) || 0);
          const damageFrac = 1 - (hullVal / hullMax);
          const damagePct = Math.ceil(damageFrac * 100);
          const repairCost = Math.ceil(damageFrac * 600);
          const repairStatus = pane.querySelector('[data-hangar-repair-status]');
          if (repairStatus) repairStatus.textContent = `Uszkodzenia: ${damagePct}% • Koszt: ${repairCost} CR`;
          const repairBtn = pane.querySelector('button[data-hangar-action="repair"]');
          if (repairBtn) repairBtn.disabled = damagePct <= 0 || PLAYER.credits < repairCost;
        }
    
        function purchaseShip(shipBP, opts = {}) {
          if (!shipBP) return;
          const hullDef = getPlayerHullDef(shipBP.id);
          if (!hullDef) return;
          const shouldActivate = opts.activate !== false;
    
          let changed = false;
          if (!playerOwnsHull(hullDef.id)) {
            if (PLAYER.credits < hullDef.cost) {
              toast('Za malo kredytow');
              updateStationOverlay(stationUI.tab, stationUI.station);
              return false;
            }
            PLAYER.credits -= hullDef.cost;
            ensurePlayerOwnsHull(hullDef.id);
            HANGAR_UI_STATE.marketExpanded.delete(normalizePlayerHullId(hullDef.id));
            HANGAR_UI_STATE.ownedExpanded.add(normalizePlayerHullId(hullDef.id));
            toast(`Zakupiono hull: ${hullDef.name}`);
            changed = true;
          }
    
          if (shouldActivate) {
            const switched = applyPlayerHullProfile(hullDef.id, { preserveDamageRatio: true, syncVisuals: true });
            if (switched) changed = true;
            toast(`Aktywowano: ${hullDef.name}`);
          }
    
          if (changed) buildHangarPanel();
          updateStationOverlay(stationUI.tab, stationUI.station);
          return true;
        }
    
        function handleRepair() {
          const damageFrac = 1 - (ship.hull.val / ship.hull.max);
          const repairCost = Math.ceil(damageFrac * 600);
          if (damageFrac <= 0) {
            toast('Kadłub jest w pełni sprawny');
            return;
          }
          if (PLAYER.credits >= repairCost) {
            PLAYER.credits -= repairCost;
            ship.hull.val = ship.hull.max;
            toast('Naprawiono kadłub.');
          } else {
            toast('Za mało kredytów');
          }
          updateStationOverlay(stationUI.tab, stationUI.station);
        }
    
        function updateStationOverlay(tab, station) {
          renderStationOverlay(tab, station);
        }
    
        const DevEconomy = window.DevEconomy = window.DevEconomy || {};
        DevEconomy.addCredits = (amountRaw = 0) => {
          const amount = Math.max(0, Math.floor(Number(amountRaw) || 0));
          if (amount <= 0) return PLAYER.credits;
          PLAYER.credits += amount;
          updateStationOverlay(stationUI.tab, stationUI.station);
          return PLAYER.credits;
        };
        DevEconomy.getCredits = () => PLAYER.credits;
        window.DevAddCredits = DevEconomy.addCredits;
    
        initMechanicUI();
        InfrastructureUI.init(canvas);
        InfrastructureUI.autopopulate();
        seedStationEconomies();
        ZonePainterUI.init(canvas);
        function startMercenaryMission() {
          if (mercMission) { toast('Misja już aktywna. Wciśnij J aby zobaczyć dziennik.'); return; }
    
          const beltTarget = (() => {
            if (!ASTEROID_BELT) return null;
            const inner = ASTEROID_BELT.inner;
            if (!Number.isFinite(inner)) return null;
            const safeMargin = Math.max(1200, ZONE_APPROACH_DISTANCE * 0.6);
            const radius = Math.max(500, inner - safeMargin);
            return { radius, angle: Math.random() * Math.PI * 2 };
          })();
    
          const earth = planets.find(p => p.id === 'earth' || p.name === 'earth');
          const targetPlanet = earth || planets[2] || planets[0];
          const earthOrbit = targetPlanet ? planetOrbitRadii(targetPlanet) : null;
    
          const orbitRadius = beltTarget?.radius
            ?? earthOrbit?.outer
            ?? Math.max(1600, (targetPlanet?.r || 0) * 4);
          const angle = beltTarget?.angle ?? (Math.random() * Math.PI * 2);
          const centerX = beltTarget ? SUN.x : (targetPlanet?.x || SUN.x);
          const centerY = beltTarget ? SUN.y : (targetPlanet?.y || SUN.y);
          const x = centerX + Math.cos(angle) * orbitRadius;
          const y = centerY + Math.sin(angle) * orbitRadius;
    
          const r = 220;
          const portOffset = r + 60;
          const ports = [
            { x: portOffset, y: 0 },
            { x: 0, y: portOffset },
            { x: -portOffset, y: 0 },
            { x: 0, y: -portOffset }
          ];
    
          const station = {
            id: 'PIR',
            x, y, r,
            baseR: r,
            isPirate: true,
            factionId: FACTION.PIRATES,
            hp: 10000, maxHp: 10000,
            static: true, mission: true,
            ports,
            style: STATION_STYLES[Math.floor(Math.random() * STATION_STYLES.length)],
            shield: {
              max: 9000,
              val: 9000,
              regenRate: 650,
              regenDelay: 4.5,
              regenTimer: 0
            }
          };
    
          stations.push(station);
          if (typeof attachPirateStation3D === 'function') {
            if (!mainScene3D && typeof initWorld3D === 'function') {
              const res = initWorld3D();
              mainScene3D = res?.scene || mainScene3D;
            }
            attachPirateStation3D(mainScene3D, station);
          }
          mercMission = {
            station,
            npcsSpawned: false,
            alertStage: 'idle',
            guardConfigured: false,
            weaponPlatforms: [],
            // --- SWARM control ---
            swarm: {
              active: false,
              maxAlive: 200,     // <- zwiększony limit
              timer: 2,
              baseInterval: 1.0, // skraca się wraz z utratą HP stacji
              queue: []
            }
          };
    
          mercMission.guards = [];
          // CIC czyta stąd promień agresji obrony stacji.
          window.mercMission = mercMission;
    
          // 1. Eskadra Interceptorów (6 sztuk)
          // Używamy nowej funkcji: tworzy eskadrę, która orbituje (mode='guard')
          spawnPirateSquad(station, 'interceptor', 6, 'guard', {
            radius: station.r + 320,
            speed: 0.45
          });
    
          // 2. Fregaty (2 sztuki)
          // Duże statki spawnujemy osobno, żeby nie latały "na ogonie" lidera jak myśliwce,
          // tylko dostojnie krążyły po dalszej orbicie.
          const frigateTypes = ['frigate_pd', 'frigate_laser']; // Różne typy dla urozmaicenia
    
          for (let i = 0; i < 2; i++) {
            const type = frigateTypes[i % frigateTypes.length];
            const npc = spawnPirate(type, station); // Używamy głównego spawnera
    
            // Konfiguracja orbitowania (Guard)
            npc.state = 'guard';
            npc.guardStation = station;
            npc.guardOrbitRadius = station.r + 550; // Dalsza orbita
            npc.guardOrbitSpeed = (i === 0 ? 1 : -1) * 0.15; // Lecą w przeciwnych kierunkach
            npc.guardPhase = i * Math.PI; // Startują po przeciwnych stronach (0 i 180 stopni)
    
            // Pozycja startowa na orbicie (żeby nie dolatywały z środka)
            npc.x = station.x + Math.cos(npc.guardPhase) * npc.guardOrbitRadius;
            npc.y = station.y + Math.sin(npc.guardPhase) * npc.guardOrbitRadius;
            npc.angle = npc.guardPhase + (npc.guardOrbitSpeed > 0 ? Math.PI / 2 : -Math.PI / 2);
    
            mercMission.guards.push(npc);
          }
          if (typeof window.resetSwarmQueue === 'function') {
            window.resetSwarmQueue();
          }
    
          // Zapis do dziennika + koordy do znacznika celu w CIC
          const exists = MISSIONS.active.find(m => m.id === 'merc_pirate_station' && m.status === 'active');
          if (!exists) {
            const missionEntry = {
              id: 'merc_pirate_station',
              title: 'Najemnik: piracka stacja',
              type: 'mercenary',
              faction: 'pirates',
              factionLabel: 'Pirates',
              stationId: station.id,
              pos: { x, y },
              location: beltTarget ? 'Pas asteroid' : `${targetPlanet?.label || 'Orbita planety'}`,
              description: 'Namierz i zniszcz piracką stację wraz z jej systemami obronnymi.',
              objective: 'Zniszcz piracką stację.',
              objectives: [
                { text: 'Dotrzyj do strefy pirackiej stacji.', done: false },
                { text: 'Przełam obronę i zniszcz stację.', done: false }
              ],
              rewardCredits: 50000,
              rewardGranted: false,
              progress: 0,
              startedAt: gameTime,
              status: 'active'
            };
            MISSIONS.active.push(missionEntry);
            window.hudSystem?.onMissionUpdated?.(missionEntry, 'started');
          }
    
          toast('Misja najemnik rozpoczęta. TAB / M — CIC, cel oznaczony znacznikiem misji. Dziennik: J.');
        }
    
        function resetMercMission() {
          if (!mercMission) return;
          if (mercMission.weaponPlatforms) {
            mercMission.weaponPlatforms.length = 0;
          }
          mercMission = null;
          window.mercMission = null;
        }
        function startTerritoryWarMission() { toast('Dołączono do wojny terytorialnej'); }
    
        function renderOptions() {
          if (!OPTIONS_OPEN) return;
          hudBeginPanel();
          uiTitle('Opcje');
    
          // --- NOWE: Wybór jakości tła ---
          uiQualitySelector();
          // ------------------------------
          slider('VFX: temperatura (K)', 1000, 20000, 500, OPTIONS.vfx, 'colorTempK');
          slider('VFX: bloom', 0.2, 2.5, 0.05, OPTIONS.vfx, 'bloomGain');
          slider('VFX: silnik (głośność)', 0, 1.5, 0.05, OPTIONS.vfx, 'engineGain');
          slider('Audio: master', 0, 1, 0.05, OPTIONS.audio, 'master');
          slider('Audio: SFX', 0, 1, 0.05, OPTIONS.audio, 'sfx');
          slider('Audio: muzyka', 0, 1, 0.05, OPTIONS.audio, 'music');
          slider('Mysz: czułość', 0.3, 2.0, 0.05, OPTIONS.controls, 'mouseSensitivity');
          // brak opcji odwrócenia osi zgodnie z prośbą
          hudEndPanel();
        }
        function spawnLaserBeam(start, end, width, opts = {}) {
          if (CanvasVFX.spawnLaserBeam) { CanvasVFX.spawnLaserBeam(start, end, width, opts); return; }
        }
    
        // =============== Input ===============
        const input = { main: 0, leftSide: 0, rightSide: 0, retro: 0, torque: 0 };
        publishGameState({ input });
        const driveState = createDriveTransmission({
          hullClass: PLAYER.activeHullId
        });
        window.shipDriveState = driveState;
        const flightAssist = {
          damper: false,
          stabilizer: false
        };
        window.flightAssist = flightAssist;
        function getShipStabilizerState(shipRef = ship) {
          return shipRef.__stabilizerState || (shipRef.__stabilizerState = {});
        }
        function setFlightStabilizerEnabled(enabled) {
          flightAssist.stabilizer = !!enabled;
          const st = getShipStabilizerState(ship);
          st.enabled = flightAssist.stabilizer;
          st.targetAngle = Number.isFinite(Number(ship?.angle)) ? wrapAngle(ship.angle) : 0;
          if (!flightAssist.stabilizer && st.output) {
            st.output.active = false;
            st.output.torque = 0;
            st.output.targetAngle = st.targetAngle;
          }
        }
        const enginePower = { target: 0, current: 0 };
        const keys = {};
        let shiftBinding = null;
        let lastDriveShiftSerial = driveState.shiftSerial;
        // Mapa sektora (M) usunięta — jej rolę przejął CIC (TAB / M).
        const cruiseNav = {
          active: false,
          target: null,
          waypoints: [],
          waypointIndex: 0,
          manualOverrideTimer: 0,
          manualOverrideDuration: 1.15,
          replanTimer: 0,
          replanInterval: 1.25,
          waypointRadius: 2600,
          arriveRadius: 3200,
          obstacleMargin: 1100
        };
        let PAUSED = false;
    
        function getPlayerSpeed() {
          return Math.hypot(Number(ship?.vel?.x) || 0, Number(ship?.vel?.y) || 0);
        }
    
        function announceDriveMode() {
          const mode = getDriveMode(driveState);
          pushZoneMessage(`${mode.label} · LIMIT ${formatVelocity(driveState.modeMaxSpeed)}`, 1.4);
        }
    
        function setPlayerDriveMode(modeId, silent = false) {
          const changed = setDriveMode(driveState, modeId, getPlayerSpeed());
          if (ship?.agility) {
            ship.agility.active = false;
            ship.agility.arcCharge = 0;
            ship.agility.maneuver = null;
          }
          if (changed && !silent) announceDriveMode();
          return changed;
        }
    
        function cyclePlayerDriveMode(direction = 1) {
          cycleDriveMode(driveState, direction, getPlayerSpeed());
          if (ship?.agility) ship.agility.active = false;
          announceDriveMode();
          return driveState.mode;
        }
    
        function togglePlayerDriveAuto() {
          setDriveAuto(driveState, !driveState.auto);
          pushZoneMessage(`SKRZYNIA AUTO: ${driveState.auto ? 'ON' : 'OFF'}`, 1.2);
          window.hudSystem?.refreshOpenMenu?.();
          return driveState.auto;
        }
    
        function announceDriveShift(quality) {
          if (quality === 'blocked') return;
          const suffix = quality === 'perfect' ? ' · PERFECT BOOST'
            : quality === 'good' ? ' · BOOST'
              : quality === 'early' ? ' · ZA WCZEŚNIEJ'
                : quality === 'late' ? ' · ZA PÓŹNO'
                  : quality === 'auto' ? ' · AUTO' : '';
          const tone = quality === 'perfect' || quality === 'good' ? 'good'
            : quality === 'early' || quality === 'late' ? 'warn' : 'status';
          pushZoneMessage(`BIEG ${driveState.gear}/${driveState.gearCount}${suffix}`, 1.1, { tone });
        }
    
        function requestPlayerShiftUp() {
          if (warp.state !== 'idle') return 'blocked';
          const quality = shiftDriveUp(driveState, getPlayerSpeed(), false);
          announceDriveShift(quality);
          return quality;
        }
    
        function requestPlayerShiftDown() {
          if (warp.state !== 'idle') return false;
          const shifted = shiftDriveDown(driveState, getPlayerSpeed(), false);
          if (shifted) pushZoneMessage(`BIEG ${driveState.gear}/${driveState.gearCount}`, 0.9);
          return shifted;
        }
    
        function setWarpGear(nextGear, silent = false) {
          const speeds = Array.isArray(warp?.gearSpeeds) && warp.gearSpeeds.length
            ? warp.gearSpeeds
            : [10000, 20000, 35000, 55000, 80000];
          const clampedGear = clamp((nextGear | 0) || 1, 1, speeds.length);
          warp.gear = clampedGear;
          warp.speed = speeds[clampedGear - 1];
          if (!silent) {
            pushZoneMessage(`Warp gear ${warp.gear}/${speeds.length} · ${formatVelocity(warp.speed, { warp: true })}`, 1.2);
          }
        }
    
        function shiftWarpGearUp() {
          const maxGear = Array.isArray(warp?.gearSpeeds) ? warp.gearSpeeds.length : 5;
          setWarpGear(Math.min(maxGear, (warp.gear || 1) + 1), false);
        }
    
        function getCruiseGravityObstacles(target) {
          const out = [];
          for (const planet of planets) {
            if (!planet) continue;
            const radii = planetOrbitRadii(planet);
            let radius = Number.isFinite(radii.gravityWell) ? radii.gravityWell : radii.outer;
            radius = (Number(radius) || 0) + cruiseNav.obstacleMargin;
            if (radius <= 0) continue;
            if (target) {
              const tx = target.x - planet.x;
              const ty = target.y - planet.y;
              if ((tx * tx + ty * ty) <= radius * radius * 0.64) continue;
            }
            out.push({
              x: Number(planet.x) || 0,
              y: Number(planet.y) || 0,
              r: radius
            });
          }
          return out;
        }
    
        function segmentCirclePenetration(a, b, circle) {
          const vx = b.x - a.x;
          const vy = b.y - a.y;
          const lenSq = vx * vx + vy * vy;
          let t = 0;
          if (lenSq > 1e-6) {
            t = ((circle.x - a.x) * vx + (circle.y - a.y) * vy) / lenSq;
            t = clamp(t, 0, 1);
          }
          const px = a.x + vx * t;
          const py = a.y + vy * t;
          const dx = px - circle.x;
          const dy = py - circle.y;
          const dSq = dx * dx + dy * dy;
          const rSq = circle.r * circle.r;
          if (dSq >= rSq) return 0;
          return circle.r - Math.sqrt(Math.max(1e-6, dSq));
        }
    
        function segmentCollisionScore(a, b, obstacles) {
          let score = 0;
          for (let i = 0; i < obstacles.length; i++) {
            score += segmentCirclePenetration(a, b, obstacles[i]);
          }
          return score;
        }
    
        function pushPointOutsideObstacles(point, obstacles) {
          let px = point.x;
          let py = point.y;
          for (let iter = 0; iter < 3; iter++) {
            let moved = false;
            for (let i = 0; i < obstacles.length; i++) {
              const o = obstacles[i];
              const dx = px - o.x;
              const dy = py - o.y;
              const minR = o.r + 260;
              const dSq = dx * dx + dy * dy;
              if (dSq >= minR * minR) continue;
              const d = Math.sqrt(Math.max(1e-6, dSq));
              const nx = dx / d;
              const ny = dy / d;
              px = o.x + nx * minR;
              py = o.y + ny * minR;
              moved = true;
            }
            if (!moved) break;
          }
          return {
            x: clamp(px, 0, WORLD.w),
            y: clamp(py, 0, WORLD.h)
          };
        }
    
        function buildCruiseDetourPair(a, b, obstacle, obstacles) {
          const vx = b.x - a.x;
          const vy = b.y - a.y;
          const segLen = Math.sqrt(vx * vx + vy * vy);
          if (segLen < 1e-3) return [];
          const tx = vx / segLen;
          const ty = vy / segLen;
          const nx = -ty;
          const ny = tx;
          const arcR = obstacle.r + 900;
          const along = Math.max(obstacle.r * 0.85, 2100);
    
          let bestPair = null;
          let bestCost = Infinity;
          const testSides = [-1, 1];
          for (let i = 0; i < testSides.length; i++) {
            const side = testSides[i];
            const p1 = pushPointOutsideObstacles({
              x: obstacle.x - tx * along + nx * side * arcR,
              y: obstacle.y - ty * along + ny * side * arcR
            }, obstacles);
            const p2 = pushPointOutsideObstacles({
              x: obstacle.x + tx * along + nx * side * arcR,
              y: obstacle.y + ty * along + ny * side * arcR
            }, obstacles);
    
            const cScore =
              segmentCollisionScore(a, p1, obstacles) +
              segmentCollisionScore(p1, p2, obstacles) +
              segmentCollisionScore(p2, b, obstacles);
    
            const d1x = p1.x - a.x;
            const d1y = p1.y - a.y;
            const d2x = p2.x - p1.x;
            const d2y = p2.y - p1.y;
            const d3x = b.x - p2.x;
            const d3y = b.y - p2.y;
            const distanceCost =
              Math.sqrt(d1x * d1x + d1y * d1y) +
              Math.sqrt(d2x * d2x + d2y * d2y) +
              Math.sqrt(d3x * d3x + d3y * d3y);
            const totalCost = distanceCost + cScore * 7000;
            if (totalCost < bestCost) {
              bestCost = totalCost;
              bestPair = [p1, p2];
            }
          }
          return bestPair || [];
        }
    
        function planCruiseRoute(startPos, targetPos) {
          if (!startPos || !targetPos) return [];
          const start = {
            x: clamp(Number(startPos.x) || 0, 0, WORLD.w),
            y: clamp(Number(startPos.y) || 0, 0, WORLD.h)
          };
          const target = {
            x: clamp(Number(targetPos.x) || 0, 0, WORLD.w),
            y: clamp(Number(targetPos.y) || 0, 0, WORLD.h)
          };
          const obstacles = getCruiseGravityObstacles(target);
          const route = [start, target];
          const maxPasses = 18;
    
          for (let pass = 0; pass < maxPasses; pass++) {
            let inserted = false;
            for (let i = 0; i < route.length - 1; i++) {
              const a = route[i];
              const b = route[i + 1];
              let bestObstacle = null;
              let bestPen = 0;
              for (let j = 0; j < obstacles.length; j++) {
                const o = obstacles[j];
                const pen = segmentCirclePenetration(a, b, o);
                if (pen > bestPen) {
                  bestPen = pen;
                  bestObstacle = o;
                }
              }
              if (!bestObstacle || bestPen < 20) continue;
              const detour = buildCruiseDetourPair(a, b, bestObstacle, obstacles);
              if (!detour.length) continue;
              route.splice(i + 1, 0, ...detour);
              inserted = true;
              if (route.length > 14) break;
              break;
            }
            if (!inserted || route.length > 14) break;
          }
    
          const waypoints = route.slice(1);
          if (!waypoints.length) {
            waypoints.push(target);
          } else {
            const last = waypoints[waypoints.length - 1];
            if (Math.abs(last.x - target.x) > 1 || Math.abs(last.y - target.y) > 1) {
              waypoints.push(target);
            }
          }
          return waypoints;
        }
    
        function rebuildCruiseRouteFromCurrent() {
          if (!cruiseNav.target) return;
          cruiseNav.waypoints = planCruiseRoute(ship.pos, cruiseNav.target);
          cruiseNav.waypointIndex = 0;
          cruiseNav.replanTimer = cruiseNav.replanInterval;
        }
    
        function setCruiseTarget(worldX, worldY) {
          cruiseNav.target = {
            x: clamp(Number(worldX) || 0, 0, WORLD.w),
            y: clamp(Number(worldY) || 0, 0, WORLD.h)
          };
          cruiseNav.active = true;
          cruiseNav.manualOverrideTimer = 0;
          ship.command = null;
          rebuildCruiseRouteFromCurrent();
          pushZoneMessage(`Cruise target set: ${Math.round(cruiseNav.target.x)} / ${Math.round(cruiseNav.target.y)}`, 2.6);
        }
        window.setCruiseTarget = setCruiseTarget;
        window.cruiseNav = cruiseNav;
    
        // CIC attack orders (called from cicDisplay.js PPM handler)
        function cicAttackOrder(entity) {
          if (!isValidLockedTarget(entity)) return;
          if (!isPlayerLockTargetInRange(entity)) {
            warnTargetOutOfLockRange(entity);
            return;
          }
          lockedTarget = entity;
          if (!lockedTargets.includes(entity)) lockedTargets.push(entity);
          pushZoneMessage('CEL ZABLOKOWANY', 1.5);
        }
        function cicGroupAttackOrder(targets) {
          const valid = targets.filter(t => canPlayerLockTarget(t));
          if (valid.length === 0) return;
          lockedTargets = valid;
          lockedTarget = valid[0];
          pushZoneMessage(`ATAK: ${valid.length} CEL${valid.length === 1 ? '' : 'E'}`, 2);
        }
        window.cicAttackOrder = cicAttackOrder;
        window.cicGroupAttackOrder = cicGroupAttackOrder;
    
        function updateWarpCruiseAutopilot(dt, hasManualTurnInput) {
          if (!cruiseNav.active || !cruiseNav.target || warp.state !== 'active') return;
    
          if (hasManualTurnInput) {
            cruiseNav.manualOverrideTimer = cruiseNav.manualOverrideDuration;
            return;
          }
          if (cruiseNav.manualOverrideTimer > 0) {
            cruiseNav.manualOverrideTimer = Math.max(0, cruiseNav.manualOverrideTimer - dt);
            return;
          }
    
          const toTargetX = cruiseNav.target.x - ship.pos.x;
          const toTargetY = cruiseNav.target.y - ship.pos.y;
          const targetDistSq = toTargetX * toTargetX + toTargetY * toTargetY;
          if (targetDistSq <= cruiseNav.arriveRadius * cruiseNav.arriveRadius) {
            cruiseNav.active = false;
            warp.state = 'idle';
            exitWarp();
            pushZoneMessage('Cruise target reached', 2.2);
            return;
          }
    
          cruiseNav.replanTimer -= dt;
          if (cruiseNav.replanTimer <= 0 || cruiseNav.waypointIndex >= cruiseNav.waypoints.length) {
            rebuildCruiseRouteFromCurrent();
          }
          if (!cruiseNav.waypoints.length) return;
    
          let waypoint = cruiseNav.waypoints[Math.min(cruiseNav.waypointIndex, cruiseNav.waypoints.length - 1)];
          let dx = waypoint.x - ship.pos.x;
          let dy = waypoint.y - ship.pos.y;
          let distSq = dx * dx + dy * dy;
    
          while (distSq <= cruiseNav.waypointRadius * cruiseNav.waypointRadius && cruiseNav.waypointIndex < cruiseNav.waypoints.length - 1) {
            cruiseNav.waypointIndex++;
            waypoint = cruiseNav.waypoints[cruiseNav.waypointIndex];
            dx = waypoint.x - ship.pos.x;
            dy = waypoint.y - ship.pos.y;
            distSq = dx * dx + dy * dy;
          }
    
          const desiredAngle = Math.atan2(dy, dx);
          const currentAngle = Math.atan2(warp.dir.y, warp.dir.x);
          const diff = wrapAngle(desiredAngle - currentAngle);
          if (Math.abs(diff) > 1e-4) {
            const maxTurn = warp.turnRate * dt;
            const delta = clamp(diff, -maxTurn, maxTurn);
            const newAngle = currentAngle + delta;
            warp.dir.x = Math.cos(newAngle);
            warp.dir.y = Math.sin(newAngle);
          }
        }
    
        function setPaused(state) {
          const next = !!state;
          if (next === PAUSED) return;
          PAUSED = next;
        }
    
        function togglePause() {
          setPaused(!PAUSED);
        }
    
        window.__setGamePaused = setPaused;
        window.__isGamePaused = () => PAUSED;
    
        window.addEventListener('keydown', e => {
          if (e.code !== 'Escape') return;
          if (stationUI.open) return;
          if (worldCommandMenu.open) {
            closeWorldCommandMenu();
            e.preventDefault();
            return;
          }
          if (!gameStarted) {
            showMainMenu('home');
            return;
          }
          toggleMainMenu();
        });
    
        function currentShiftMode() {
          return isPlanetOrbitZoneId(zoneState.current?.id) ? 'boost' : 'warp';
        }
    
        function activateBoostIfAllowed() {
          if (!isPlanetOrbitZoneId(zoneState.current?.id)) return false;
          if (boost.fuel > 0) {
            boost.state = 'active';
            return true;
          }
          return false;
        }
    
        function stopBoost() {
          if (boost.state === 'active') {
            boost.state = 'idle';
          }
        }
    
        function handleShiftDown() {
          if (ship.destroyed) return;
          shiftBinding = currentShiftMode();
          if (shiftBinding === 'boost') {
            activateBoostIfAllowed();
          } else {
            handleWarpKeyDown();
          }
        }
    
        function handleShiftUp() {
          if (ship.destroyed) return;
          const mode = shiftBinding || currentShiftMode();
          if (mode === 'boost') {
            stopBoost();
          } else {
            handleWarpKeyUp();
          }
          shiftBinding = null;
        }
    
        function triggerForwardImpulse(entity, power = 0, opts = {}) {
          if (!entity || entity.dead || entity.destroyed) return false;
          const impulse = Number(power) || 0;
          if (Math.abs(impulse) <= 1e-4) return false;
          const angle = Number(entity.angle) || 0;
          const dirX = Number.isFinite(Number(opts.dirX)) ? Number(opts.dirX) : Math.cos(angle);
          const dirY = Number.isFinite(Number(opts.dirY)) ? Number(opts.dirY) : Math.sin(angle);
          const len = Math.max(1e-6, Math.hypot(dirX, dirY));
          const vx = (dirX / len) * impulse;
          const vy = (dirY / len) * impulse;
          if (entity.vel) {
            entity.vel.x = (Number(entity.vel.x) || 0) + vx;
            entity.vel.y = (Number(entity.vel.y) || 0) + vy;
            entity.vx = entity.vel.x;
            entity.vy = entity.vel.y;
          } else {
            entity.vx = (Number(entity.vx) || 0) + vx;
            entity.vy = (Number(entity.vy) || 0) + vy;
          }
          const px = Number(entity.pos?.x ?? entity.x) || 0;
          const py = Number(entity.pos?.y ?? entity.y) || 0;
          if (opts.effects !== false) {
            spawnShockwave(px, py, {
              maxR: Number(opts.maxR) || 420,
              w: Number(opts.width) || 12,
              color: opts.color || 'rgba(150,255,150,'
            });
            if (opts.shake !== false) camera.addShake(Number(opts.shakePower) || 15, Number(opts.shakeTime) || 0.3);
          }
          return true;
        }
    
        function triggerRamImpulse(entity, impulse = {}, opts = {}) {
          const power = Math.max(1600, Number(impulse?.power) || 3400);
          const ok = triggerForwardImpulse(entity, power, {
            dirX: impulse?.dirX,
            dirY: impulse?.dirY,
            effects: opts.effects,
            maxR: opts.maxR || 560,
            width: opts.width || 14,
            color: opts.color || 'rgba(255,210,95,',
            shakePower: opts.shakePower || (entity === ship ? 22 : 10),
            shakeTime: opts.shakeTime || 0.32,
            shake: opts.shake
          });
          if (ok && entity?.agility?.cooldowns) {
            entity.agility.cooldowns.dash = Math.max(entity.agility.cooldowns.dash || 0, entity.agility.maxCooldowns?.dash || 1.4);
          }
          return ok;
        }
    
        function playerHasManualInput() {
          if (camera.mode === 'rts') return false;
          return keys['w'] || keys['s'] || keys['a'] || keys['d'] || keys['q'] || keys['e'];
        }
    
        function computePlayerHoldControl(ship) {
          return computePlayerHoldControlFromFlight(ship, SHIP_PHYSICS);
        }
    
        // Bufory zdolności obrotu gracza (resolveShipTurnCapability, co klatkę).
        // mainAssist 'auto': silniki główne skręcają tylko kadłubem bez sensownych
        // dysz bocznych (np. Bellator w domyślnym układzie edytora).
        const _playerCommandTurnCapability = { accel: 0, maxRate: 0, lag: 0, mainAccel: 0 };
        const _playerStabilizerTurnCapability = { accel: 0, maxRate: 0, lag: 0, mainAccel: 0 };
        const _playerManualTurnCapability = { accel: 0, maxRate: 0, lag: 0, mainAccel: 0 };
        const _playerStabilizerTurnOptions = { mainAssist: false, mainThrottle: 0, mainBoost: 1 };
        const _playerAutoTurnOptions = { mainAssist: 'auto', mainThrottle: 0, mainBoost: 1 };
        const _playerManualTurnOptions = { mainAssist: 'auto', mainThrottle: 0, mainBoost: 1 };
        function playerNeedsMainEngineTurning() {
          return resolveShipTurnCapability(ship, driveState, _playerManualTurnOptions, _playerManualTurnCapability).mainAssist;
        }
        function updatePlayerCommand(dt) {
          if (ship.destroyed) return;
          const cmd = ship.command;
          if (!cmd) return;
          if (PAUSED || warp.state !== 'idle') return;
          if (playerHasManualInput()) { ship.command = null; return; }
    
          // Gaz główny z poprzedniej klatki: kadłub skręcający silnikami głównymi
          // (Bellator) ma przy pełnym ciągu ~5× większy moment z małych korekt.
          _playerAutoTurnOptions.mainThrottle = clamp(Number(ship?.thrusterInput?.main) || 0, 0, 1);
          const result = computePlayerCommandControl(ship, cmd, {
            defaultArrival: 90,
            physics: SHIP_PHYSICS,
            // Autopilot skręca dyszami bocznymi, a silnikami głównymi tylko gdy
            // kadłub nie ma bocznych (physicsStep: mainTorque) — planuje obrót
            // z prawdziwym przyspieszeniem wybranego sposobu.
            turnCapability: resolveShipTurnCapability(ship, driveState, _playerAutoTurnOptions, _playerCommandTurnCapability)
          });
          if (!result || result.clearCommand) {
            ship.command = null;
            return;
          }
          if (result.nextCommand) {
            ship.command = result.nextCommand;
          }
          if (result.control) applyPlayerInput(ship, result.control, input);
          if (result.ramImpulse && cmd && !cmd.ramImpulseDone) {
            if (triggerRamImpulse(ship, result.ramImpulse, { effects: true })) {
              cmd.ramImpulseDone = true;
              ship.command = null;
              pushZoneMessage('RAM: GRAVITY IMPULSE', 1.1);
            }
          }
        }
    
        function handleWarpKeyDown() {
          if (warp.state === 'idle' && (DevFlags.unlimitedWarp || warp.fuel > 0)) {
            warp.state = 'charging';
            warp.charge = 0;
          }
        }
    
        function handleWarpKeyUp() {
          if (warp.state === 'charging') { warp.state = 'idle'; warp.charge = 0; }
          else if (warp.state === 'active') { warp.state = 'idle'; exitWarp(); }
        }
    
        // Auto-fire toggle flags (keys 1/2/3 with locked targets)
        let mainAutoFire = false;
        let specialAutoFire = false;
        let rocketAutoFire = false;
        let specialMissileAutoFire = false;
        let playerRepairActive = false;
        const playerAttackState = {
          active: false,
          target: null,
          phase: null,
