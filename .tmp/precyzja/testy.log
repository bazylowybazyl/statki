              mount,
              baseDeg: deg,
              nozzleDeg: deg,
              gimbalMinDeg: -90,
              gimbalMaxDeg: 90,
              side: inferEditorEngineSide(mount, x),
              yNudge: 0,
              vfxWidthMin: 25,
              vfxWidthMax: 227,
              vfxLengthMin: 49,
              vfxLengthMax: 354
            };
          };
    
          let mainThrusters = [];
          let sideThrusters = [];
          const aftX = -w * 0.5 + 14;
    
          if (id === 'frigate') {
            mainThrusters = [
              makeMain(aftX, -h * 0.18),
              makeMain(aftX, h * 0.18)
            ];
            sideThrusters = [
              makeSide(-w * 0.1, -h * 0.46),
              makeSide(-w * 0.1, h * 0.46)
            ];
          } else if (id === 'destroyer') {
            mainThrusters = [
              makeMain(aftX, -h * 0.24),
              makeMain(aftX, 0),
              makeMain(aftX, h * 0.24)
            ];
            sideThrusters = [
              makeSide(-w * 0.15, -h * 0.48),
              makeSide(-w * 0.15, h * 0.48),
              makeSide(w * 0.2, -h * 0.38),
              makeSide(w * 0.2, h * 0.38)
            ];
          } else if (id === 'battleship') {
            mainThrusters = [
              makeMain(aftX, -h * 0.28),
              makeMain(aftX, -h * 0.09),
              makeMain(aftX, h * 0.09),
              makeMain(aftX, h * 0.28)
            ];
            sideThrusters = [
              makeSide(-w * 0.2, -h * 0.5),
              makeSide(-w * 0.2, h * 0.5),
              makeSide(w * 0.24, -h * 0.36),
              makeSide(w * 0.24, h * 0.36)
            ];
