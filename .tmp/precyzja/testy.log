            planetStationsReady = true;
          }
          if (!planetStationsReady && !ensurePlanetStationsInit(stations)) {
            let tries = 0;
            const maxTries = 240;
            (function poll() {
              if (ensurePlanetStationsInit(stations) || tries++ > maxTries) return;
              requestAnimationFrame(poll);
            })();
          }
    
          // Pole asteroid (InstancedMesh) - 5 pasów: Main Belt, Greeks (L4), Trojans (L5),
          // Hildas (rezonans 3:2 z Jowiszem), Kuiper Belt. Generowane raz, deterministycznie z seed.
          if (AsteroidField && !window.asteroidField) {
            try {
              window.asteroidField = new AsteroidField({
                seed: 0xA57E20,
