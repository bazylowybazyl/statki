        }
    
        function getHullSpriteForNpc(npc) {
          const hullProfileId = getNpcHullRenderProfileId(npc);
          if (!hullProfileId) return null;
          const src = HULL_SPRITE_PATHS_BY_ID[hullProfileId] || null;
          if (!src) return null;
          const sprite = loadHullSprite(src);
          if (!sprite || !sprite.ready || sprite.error) return null;
          return sprite;
        }
    
        const NPC_HEX_IMAGE_CACHE = new Map();
        function getNpcHexInitSource(npc, hullSprite) {
          const fallback = {
            image: hullSprite?.image || null,
            hardpointScaleX: 1.0,
            hardpointScaleY: 1.0,
            hardpointScale: 1.0
          };
          if (!npc || !hullSprite?.image || !hullSprite.ready) return fallback;
    
          const hullProfileId = getNpcHullRenderProfileId(npc);
          if (!hullProfileId) return fallback;
    
          const srcW = Math.max(1, hullSprite.width || hullSprite.image.naturalWidth || hullSprite.image.width || 1);
          const srcH = Math.max(1, hullSprite.height || hullSprite.image.naturalHeight || hullSprite.image.height || 1);
          const targetSize = getHullRenderSize(hullProfileId, srcW, srcH);
          const targetWidth = Math.max(64, Number(targetSize?.w) || 64);
          const targetHeight = Math.max(64, Number(targetSize?.h) || 64);
          const scaleX = Math.max(0.01, targetWidth / srcW);
          const scaleY = Math.max(0.01, targetHeight / srcH);
          const uniformScale = (scaleX + scaleY) * 0.5;
          const nearlyIdentity = Math.abs(scaleX - 1) < 0.01 && Math.abs(scaleY - 1) < 0.01;
          if (!Number.isFinite(scaleX) || !Number.isFinite(scaleY) || nearlyIdentity) return fallback;
    
          const key = `${hullSprite.image.src || hullProfileId}|${targetWidth}x${targetHeight}`;
          let canvas = NPC_HEX_IMAGE_CACHE.get(key);
          if (!canvas) {
            canvas = document.createElement('canvas');
            canvas.width = Math.max(2, Math.round(targetWidth));
            canvas.height = Math.max(2, Math.round(targetHeight));
            const ictx = canvas.getContext('2d', { willReadFrequently: true });
            if (ictx) {
              ictx.imageSmoothingEnabled = true;
              ictx.drawImage(hullSprite.image, 0, 0, canvas.width, canvas.height);
              NPC_HEX_IMAGE_CACHE.set(key, canvas);
            } else {
              canvas = null;
            }
          }
          if (!canvas) return fallback;
          return {
            image: canvas,
            hardpointScaleX: scaleX,
            hardpointScaleY: scaleY,
            hardpointScale: uniformScale
          };
        }
    
        function getCapitalShipSprite(src) {
          if (!src) return null;
          if (!capitalShipSpriteCache[src]) {
            const img = new Image();
            const entry = capitalShipSpriteCache[src] = {
              image: img,
              ready: false,
              error: false,
              width: 0,
              height: 0
            };
            img.onload = () => {
              entry.ready = true;
              entry.width = img.naturalWidth;
              entry.height = img.naturalHeight;
            };
            img.onerror = () => {
              entry.error = true;
            };
            img.src = src;
          }
          return capitalShipSpriteCache[src];
        }
    
        function getPlayerHullRenderImage(image, targetW, targetH) {
          if (!image) return null;
          const srcW = Math.max(1, Number(image.naturalWidth) || Number(image.width) || 1);
          const srcH = Math.max(1, Number(image.naturalHeight) || Number(image.height) || 1);
          const outW = Math.max(64, Math.round(Number(targetW) || srcW));
          const outH = Math.max(64, Math.round(Number(targetH) || srcH));
          const srcKey = image.currentSrc || image.src || 'player';
          const key = `${srcKey}|${outW}x${outH}`;
    
          let cached = playerHullRenderCache.get(key);
          if (cached) return cached;
    
          const outCanvas = document.createElement('canvas');
          outCanvas.width = outW;
          outCanvas.height = outH;
          const outCtx = outCanvas.getContext('2d', { willReadFrequently: true });
          if (!outCtx) return image;
    
          outCtx.clearRect(0, 0, outW, outH);
          outCtx.imageSmoothingEnabled = true;
          outCtx.drawImage(image, 0, 0, srcW, srcH, 0, 0, outW, outH);
          playerHullRenderCache.set(key, outCanvas);
          return outCanvas;
        }
    
        function getResolvedHullRenderSize(hullProfileId, image = null, fallbackW = 450, fallbackH = 250) {
          const srcW = Math.max(0, Number(image?.naturalWidth) || Number(image?.width) || 0);
          const srcH = Math.max(0, Number(image?.naturalHeight) || Number(image?.height) || 0);
          const size = getHullRenderSize(hullProfileId, srcW, srcH);
          return {
            w: Math.max(64, Number(size?.w) || Number(fallbackW) || 450),
            h: Math.max(64, Number(size?.h) || Number(fallbackH) || 250),
            radius: Math.max(20, Number(size?.radius) || 20),
            length: Math.max(64, Number(size?.length) || 64)
          };
        }
    
        function updatePlayerLayoutScaleFromRender(sourceImage, renderImage) {
          if (!ship) return;
          const srcW = Math.max(1, Number(sourceImage?.naturalWidth) || Number(sourceImage?.width) || 1);
          const srcH = Math.max(1, Number(sourceImage?.naturalHeight) || Number(sourceImage?.height) || 1);
          const renderW = Math.max(1, Number(renderImage?.width) || Number(renderImage?.naturalWidth) || srcW);
          const renderH = Math.max(1, Number(renderImage?.height) || Number(renderImage?.naturalHeight) || srcH);
          const scaleX = Math.max(0.01, renderW / srcW);
          const scaleY = Math.max(0.01, renderH / srcH);
          ship.__hardpointScaleX = scaleX;
          ship.__hardpointScaleY = scaleY;
          ship.__hardpointScale = (scaleX + scaleY) * 0.5;
        }
    
        function buildHexInitImageFromRenderSource(sourceImage, fallbackW = 1, fallbackH = 1) {
          if (!sourceImage) return null;
          const w = Math.max(1, Number(sourceImage.naturalWidth) || Number(sourceImage.width) || Number(fallbackW) || 1);
          const h = Math.max(1, Number(sourceImage.naturalHeight) || Number(sourceImage.height) || Number(fallbackH) || 1);
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ictx = canvas.getContext('2d', { willReadFrequently: true });
          if (!ictx) return sourceImage;
          ictx.clearRect(0, 0, w, h);
          ictx.drawImage(sourceImage, 0, 0, w, h);
          return canvas;
        }
    
        ship.spriteReady = false;
        shipSprite.onload = () => {
          const activeHullKey = String(ship?.activeHullId || 'atlas').toLowerCase();
          const activeHullDef = getPlayerHullDef(activeHullKey);
          const hullProfileId = resolveHullRenderProfileId(activeHullDef?.shipFrame || activeHullDef?.id || activeHullKey);
          const resolvedSize = getResolvedHullRenderSize(hullProfileId, shipSprite, ship.w, ship.h);
          ship.w = resolvedSize.w;
          ship.h = resolvedSize.h;
          const renderImage = getPlayerHullRenderImage(shipSprite, ship.w, ship.h) || shipSprite;
          const hexInitImage = buildHexInitImageFromRenderSource(renderImage, ship.w, ship.h) || renderImage;
          updatePlayerLayoutScaleFromRender(shipSprite, renderImage);
          ship.renderSpriteImage = renderImage;
          ship.spriteReady = true;
          ship.spriteW = Math.max(1, Number(renderImage.width) || Number(shipSprite.naturalWidth) || 1);
          ship.spriteH = Math.max(1, Number(renderImage.height) || Number(shipSprite.naturalHeight) || 1);
          Game.player.spriteW = ship.spriteW;
          Game.player.spriteH = ship.spriteH;
          const prev = Game.player.hardpoints.map(h => ({
            type: h.type,
            mount: h.mount,
            ammo: h.ammo,
            maxAmmo: h.maxAmmo,
            hangarSquadrons: h.type === HP.HANGAR ? getHardpointHangarSquadrons(h) : undefined
          }));
          rebuildHardpointsForFrame();
          applyHullThrusterLayout(activeHullKey);
          tryPreserveMounts(prev);
          syncWeaponSystems();
          if (invalidateHexShipEntity3D) invalidateHexShipEntity3D(ship);
          initHexBody(ship, hexInitImage);
          if (ship.hexGrid) {
            ship.hexGrid.visualImage = shipSprite;
            ship.hexGrid.meshDirty = true;
            ship.hexGrid.meshDirtyAll = true;
            ship.hexGrid.textureDirty = true;
            ship.hexGrid.cacheDirty = true;
            ship.hexGrid.gpuTextureNeedsUpdate = true;
            attachEntityBridges(ship, { key: activeHullKey });
          }
          if (ship?.hexGrid?.rawRadius && Number.isFinite(ship.hexGrid.rawRadius)) {
            const scaleNow = Math.max(0.0001, Number(ship?.visual?.spriteScale) || 1);
            ship.radius = ship.hexGrid.rawRadius * scaleNow;
          }
          if (typeof renderMechanic === 'function') renderMechanic();
          saveLoadout();
        };
        shipSprite.onerror = () => {
          ship.spriteReady = false;
          const fallback = "assets/capital_ship_rect_v1.png";
          if (shipSprite.src !== fallback) {
            console.warn('[Hull] Nie udalo sie zaladowac sprite statku, fallback do atlas.');
            ship.capitalProfile = ship.capitalProfile || {};
            ship.capitalProfile.spriteSrc = fallback;
            shipSprite.src = fallback;
          }
        };
        shipSprite.src = ship.capitalProfile?.spriteSrc || "assets/capital_ship_rect_v1.png";
    
        // USUNIETO STARY KOD SUPERBRONI (definicje superweapon, executeSuperweaponFire itp.)
        // Teraz korzystamy z src/game/superweapon.js
    
    
    
        // =============== Słońce, planety i stacje ===============
        const SUN = {
          x: WORLD.w / 2, y: WORLD.h / 2, r: 823, r3D: 399,
          color: {
            core: '#ffe88a',   // jasno-żółty rdzeń
            mid: '#ffbe3b',   // pomarańcz-żółć
            rim: '#ff8c1a'    // ciepła krawędź tarczy
          },
          corona: {
            rays: 72,           // ile "igieł"
            jitter: 0.35,       // nieregularność
            length: 0.85,       // długość korony w promieniach R
            pulse: 0.22,        // amplituda pulsu
            haze: 2.8          // rozmiar miękkiej poświaty (×R)
          },
          seed: 93731
        };
        window.SUN = SUN;
    
        // --- tryb: REALNY UKLAD SLONECZNY (domyslnie wlaczony) ---
        const solarParams = new URLSearchParams(location.search);
        const USE_SOLAR = solarParams.has('solar') ? solarParams.get('solar') !== '0' : true; // można też sterować paramem URL ?solar=1
        window.USE_SOLAR = USE_SOLAR;
        // Te same liczby, którymi systemMap.js liczy skalę — trzymane w jednym miejscu,
        // żeby świat i jego pomiary nie mogły się rozjechać.
        const WORLD_TARGET_DIAMETER = SYSTEM_MAP_CONSTANTS.worldTargetDiameter;
        const WORLD_SAFETY_MARGIN_AU = SYSTEM_MAP_CONSTANTS.safetyMarginAu;
        const WORLD_EDGE_MARGIN_AU = WORLD_SAFETY_MARGIN_AU;
        const PLANET_3D_SIZE_MULTIPLIER = SYSTEM_MAP_CONSTANTS.planet3dSizeMultiplier;
    
        function getRingBeltDefinition(id) {
          return BELT_DEFINITIONS.find(belt => belt.id === id && belt.shape === 'ring') || null;
        }
    
        function getOuterAsteroidEdgeAU() {
          return getOutermostBeltEdgeAu(BELT_DEFINITIONS);
        }
    
        function makeSolarPlanets() {
          // Tabela orbit i rachunek skali mieszkają w src/data/systemMap.js — ten sam
          // moduł czytają skrypty pomiarowe i prototypy ruchu. Wcześniej ta tabela była
          // tutaj wpisana, a wszystko poza grą przepisywało jej liczby ręcznie, więc
          // każda zmiana skali po cichu unieważniała dokumentację i pomiary.
          const { auInWorldUnits, planets } = buildSystemMap(getOuterAsteroidEdgeAU(), {
            planetScale: PLANET_SCALE,
            sunRadius: SUN.r
          });
          window.BASE_ORBIT = auInWorldUnits;
          window.WORLD_UNITS_PER_AU = auInWorldUnits;
          return planets;
        }
    
        function computeWorldDiameter(planets) {
          const auToWorld = getAuToWorldUnits();
          const safetyMarginAU = WORLD_SAFETY_MARGIN_AU;
          const maxPlanetOrbitAU = planets
            .map(p => p.orbitAU)
            .filter(Number.isFinite)
            .reduce((max, value) => Math.max(max, value), 0);
          const outerRadiusAU = Math.max(maxPlanetOrbitAU, getOuterAsteroidEdgeAU()) + safetyMarginAU;
          const outerRadiusWorld = outerRadiusAU * auToWorld;
          return outerRadiusWorld * 2;
        }
    
        function alignWorldToCenter(centerX, centerY) {
          SUN.x = centerX;
          SUN.y = centerY;
    
          if (camera) {
            camera.x = centerX;
            camera.y = centerY;
            camera.targetX = centerX;
            camera.targetY = centerY;
          }
    
          if (!hasSavedShipPosition && ship) {
            ship.pos.x = centerX;
            ship.pos.y = centerY;
            overlayView.center.x = centerX;
            overlayView.center.y = centerY;
          }
        }
    
        // jeśli kiedyś będziemy chcieli wrócić do starych zasad, zostawiamy helper:
        function makeProceduralPlanets() {
          // stary kod może zostać, ale domyślnie nieużywany
          const PLANET_TYPES = {
            TERRAN: 'terran',
            VOLCANIC: 'volcanic',
            FROZEN: 'frozen',
            GAS: 'gas',
            BARREN: 'barren'
          };
          const NUM_PLANETS = 7;
          const TYPES = [
            PLANET_TYPES.VOLCANIC,
            PLANET_TYPES.VOLCANIC,
            PLANET_TYPES.TERRAN,
            PLANET_TYPES.TERRAN,
            PLANET_TYPES.BARREN,
            PLANET_TYPES.GAS,
            PLANET_TYPES.FROZEN
          ];
          const BASE_ORBIT = 7000;
          window.BASE_ORBIT = BASE_ORBIT;
          window.WORLD_UNITS_PER_AU = BASE_ORBIT;
          const list = [];
          for (let i = 0; i < NUM_PLANETS; i++) {
            const orbitRadius = BASE_ORBIT * (i + 1);
            const angle = Math.random() * Math.PI * 2;
            const au = i + 1;
            const periodHours = 24 * 365 * Math.pow(au, 1.5);
            const speed = (2 * Math.PI) / (periodHours * 3600);
            const r = (48 + Math.floor(Math.random() * 36)) * 3;
            list.push({ id: i, orbitRadius, angle, speed, r, type: TYPES[i], x: 0, y: 0 });
          }
          return list;
        }
    
        const PLANET_DATA = USE_SOLAR ? makeSolarPlanets() : makeProceduralPlanets();
    
        const WORLD_DIAMETER = Math.max(WORLD_TARGET_DIAMETER, computeWorldDiameter(PLANET_DATA));
        setWorldSize(WORLD, { width: WORLD_DIAMETER, height: WORLD_DIAMETER });
        alignWorldToCenter(WORLD.w / 2, WORLD.h / 2);
    
        function formatPlanetLabel(planet, index) {
          if (typeof planet.label === 'string' && planet.label.trim().length) {
            return planet.label.trim();
          }
          const candidates = [];
          if (typeof planet.name === 'string') candidates.push(planet.name);
          if (typeof planet.id === 'string') candidates.push(planet.id);
          if (typeof planet.type === 'string') candidates.push(planet.type);
    
          for (const raw of candidates) {
            if (!raw) continue;
            const pretty = raw
              .replace(/[_-]+/g, ' ')
              .trim()
              .replace(/\b\w/g, ch => ch.toUpperCase());
            if (pretty) return pretty;
          }
    
          // Tego brakowało:
          return `Planet ${index + 1}`;
        }
        // wylicz pozycje
        let planets = PLANET_DATA.map((p, index) => {
          if (p.baseR == null) p.baseR = p.r;
          if (p.r == null && p.baseR != null) {
            p.r = p.baseR * PLANET_SCALE;
          }
          p.x = SUN.x + Math.cos(p.angle) * p.orbitRadius;
          p.y = SUN.y + Math.sin(p.angle) * p.orbitRadius;
          p.label = formatPlanetLabel(p, index);
          return p;
        });
        window.planets = planets;
        publishGameState({ planets });
    
        function buildHudRadarWorldFeatures(planetList, sun) {
          const features = [];
