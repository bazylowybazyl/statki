        function mkSupportHp(type, weaponId, y = 0) {
          return { type, pos: { x: 0, y }, mount: weaponId };
        }
    
        function applyFighterSquadronLoadout(npc, squadronId) {
          const squadron = getFighterSquadronDef(squadronId);
          npc.fighter = true;
          npc.squadronId = squadron.id;
          npc.squadronName = squadron.name;
          npc.gun = squadron.weaponId;
          npc.msl = squadron.missileId;
          npc.mslAmmo = squadron.missileAmmo;
          npc.gunCD = 0;
          npc.ai = (dt) => { if (window.runAdvancedFighterAI) window.runAdvancedFighterAI(npc, dt); };
          return squadron;
        }
    
        // === MYŚLIWCE Z HANGARÓW NPC (carrier launch) ===
        // Okręt z hardpointami 'hangar' wypuszcza eskadry, gdy w pobliżu są wrogowie.
        // Myśliwce dostają carriera jako lidera skrzydła (formacja + dziedziczenie
        // celu z runAdvancedFighterAI), z respawnem po stratach i limitem per bay.
        // Spawn ODROCZONY (kolejka opróżniana na starcie npcStep), żeby nie mutować
        // npcs[] w trakcie pętli AI.
        const __carrierSpawnQueue = [];
