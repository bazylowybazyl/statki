          return { mainThrusters, sideThrusters, engineFx };
        }
    
        function applyPlayerEditorEngineLayoutFromStorage(preferredKey = null) {
          if (!ship?.visual || !ship?.engines) return false;
          const cfg = buildPlayerDefaultEditorEngines(preferredKey);
