          const fallbackMin = kind === 'side' ? -90 : -45;
          const fallbackMax = kind === 'side' ? 90 : 45;
          const normalize = (value, fallback) => normalizeEditorEngineDeg(value, fallback);
          let min = normalize(minDeg, fallbackMin);
          let max = normalize(maxDeg, fallbackMax);
