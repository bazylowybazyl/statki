            const startPort = Number.isFinite(options.startPort)
              ? Math.abs(Math.trunc(options.startPort)) % portCount
              : Math.floor(Math.random() * portCount);
            const spawnPos = stationPortWorld(start, startPort);
            npc.x = spawnPos.x;
            npc.y = spawnPos.y;
            npc.vx = 0;
            npc.vy = 0;
          }
          return true;
        }
    
        const NPC_TYPES = {
