          npc.vy = Number(opts.velocity?.y) || 0;
          npc.angVel = Number(opts.angularVelocity) || 0;
          npc.ai = null;
          npc.combatDisabled = true;
          npc.staticDummy = true;
          // Independent call-ins use the generic "dummy" mode, which normally
