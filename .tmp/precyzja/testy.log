        // odmowy niżej były wcześniej ciche, więc martwy klawisz, brak działa na
        // kadłubie i przeładowanie wyglądały identycznie: jak nic. Każde wyjście ma
        // teraz komunikat, tak jak klawisze 1/2/3/5.
        function tryFireMountedBuiltInWeapons() {
          const builtins = Game.player?.weapons?.[HP.BUILTIN] || [];
          const hasHexlance = builtins.some(loadout => loadout?.weapon?.id === 'hexlance_siege' && loadout?.hp);
          if (!hasHexlance) {
            pushZoneMessage('HEXLANCE: BRAK DZIAŁA NA KADŁUBIE', 2.0);
            return false;
          }
    
          const sw = Superweapon?.superweaponState || null;
          const wasArmed = !!sw?.armed;
          if (Superweapon.tryFireSuperweapon(ship)) {
            pushZoneMessage(wasArmed ? 'HEXLANCE: OGNIA' : 'HEXLANCE: ŁADOWANIE — WCIŚNIJ 4 PONOWNIE', 1.8);
            return true;
          }
    
          if (sw?.charging) pushZoneMessage('HEXLANCE: ŁADOWANIE…', 1.0);
          else if (sw?.queue?.length) pushZoneMessage('HEXLANCE: SALWA W TOKU', 1.0);
          else if (Number(sw?.cooldown) > 0) pushZoneMessage(`HEXLANCE: PRZEŁADOWANIE ${Number(sw.cooldown).toFixed(1)}s`, 1.2);
