            }
    
            // Towar przechodzi carrier -> dokładnie jeden wrak w tej samej operacji
            // śmierci. Nie ma zwrotu do nadawcy ani oczekiwania na następny tick.
            if (npc.isCargoVan) handleCargoVanDestroyed(npc);
    
            releaseNpcHexBody(npc);
          }
        }
        window.applyDamageToNPC = applyDamageToNPC;
    
        function enforceNpcHexIntegrityBalance() {
          const playerHexLossExponent = 2.35;
          const npcHexLossExponent = 2.2;
    
          if (ship && !ship.destroyed && ship.hexGrid && ship.hull && Number.isFinite(ship.hull.max) && ship.hull.max > 0) {
            const shipState = getHexStructuralState(ship);
            if (shipState && shipState.total > 0) {
              const ratioAdjusted = Math.pow(Math.max(0, Math.min(1, shipState.ratio)), playerHexLossExponent);
              const shipHullCap = Math.max(0, ship.hull.max * ratioAdjusted);
              if (ship.hull.val > shipHullCap + 0.25) {
                applyDamageToPlayer(ship.hull.val - shipHullCap, { bypassShield: true });
              }
              if (!ship.destroyed && shipState.active <= 0 && ship.hull.val > 0) {
                applyDamageToPlayer(ship.hull.val + 1, { bypassShield: true });
              }
            }
          }
    
          for (let i = 0; i < npcs.length; i++) {
            const npc = npcs[i];
            if (!npc || npc.dead || npc.isWreck || !npc.hexGrid || isBridgeHulk(npc)) continue;
    
            const state = getHexStructuralState(npc);
            if (!state || state.total <= 0) continue;
    
            const npcMaxHull = Math.max(1, Number(npc.maxHp) || Number(npc.hp) || 1);
            const ratioAdjusted = Math.pow(Math.max(0, Math.min(1, state.ratio)), npcHexLossExponent);
            const npcHullCap = Math.max(0, npcMaxHull * ratioAdjusted);
            if (npc.hp > npcHullCap + 0.25) {
              applyDamageToNPC(npc, npc.hp - npcHullCap, 'default', { bypassShield: true });
            }
    
            if (state.active <= 0 && npc.hp > 0) {
              applyDamageToNPC(npc, npc.hp + 1, 'default', { bypassShield: true });
            }
          }
        }
    
        function applyDamageToStation(station, amount) {
          let dmg = amount || 0;
          if (dmg <= 0) return 0;
          if (station._destroyed3D) return 0;       // already dead, no more damage
          if (isEntityShieldBlocking(station)) {
            station.shield.regenTimer = station.shield.regenDelay;
            const absorbed = Math.min(station.shield.val, dmg);
            station.shield.val -= absorbed;
            dmg -= absorbed;
          }
          if (dmg > 0) {
            const hpBefore = station.hp;
            const wasDead  = station.hp <= 0;
            station.hp = Math.max(0, station.hp - dmg);
            station.hitFlash = 0.18;
    
            // Progressive chunk detachment at 75 / 50 / 25 % HP thresholds
            if (!wasDead && !station._destroyed3D && station._mesh3d) {
              const maxHp = station.maxHp || 3000;
              for (const t of [0.75, 0.50, 0.25]) {
                if (hpBefore > maxHp * t && station.hp <= maxHp * t) {
                  window.Destruction3D?.detachChunk(station._mesh3d);
                  break; // at most one chunk per hit
                }
              }
            }
    
            if (!wasDead && station.hp <= 0) {
              // First death — trigger 3D destruction effect
              station._destroyed3D = true;
              if (typeof destroyStation3D === 'function') {
                destroyStation3D(station, { shockwave: true });
              }
              if (mercMission?.station === station) {
                const completed = completeMission('merc_pirate_station', {
                  rewardCredits: 50000,
                  banner: 'MISJA UKOŃCZONA'
                });
                if (completed) resetMercMission();
              }
            }
          }
          return dmg;
        }
    
        function applyDamageToPlatform(platform, amount) {
          if (!platform || platform.destroyed) return 0;
          let dmg = amount || 0;
          if (dmg <= 0) return 0;
          if (isEntityShieldBlocking(platform)) {
            platform.shield.regenTimer = platform.shield.regenDelay;
            const absorbed = Math.min(platform.shield.val, dmg);
            platform.shield.val -= absorbed;
            dmg -= absorbed;
          }
          if (dmg > 0) {
            platform.hp = Math.max(0, platform.hp - dmg);
          }
          platform.hitFlash = 0.18;
          if (platform.hp <= 0 && !platform.destroyed) {
            platform.destroyed = true;
            platform.deathTimer = 0;
            CanvasVFX.spawnExplosionPlasma(platform.x, platform.y, 1.4);
            spawnShockwave(platform.x, platform.y, { maxR: 420, maxLife: 0.6, color: 'rgba(255,140,120,' });
          }
