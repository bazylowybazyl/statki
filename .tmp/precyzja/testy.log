          setEntityShieldForcedOff(ship, nextForcedOff);
          if (!nextForcedOff && ship.shield.val > 0 && ship.shield.state === 'off') {
            ship.shield.regenTimer = Math.min(Number(ship.shield.regenTimer) || 0, 0);
          }
