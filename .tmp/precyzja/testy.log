          // kadluba (lengthScale siega 4.8). Stad "nie zawsze oznacza".
          function _targetingHullHit(target, wx, wy, camRef) {
            const radius = Math.max(12, getTargetRadius(target));
            const profile = target?.capitalProfile;
            const lengthScale = Math.max(1, Number(profile?.lengthScale) || 1);
            const widthScale = Math.max(0.7, Number(profile?.widthScale) || 1);
            // Stala tolerancja ~14 px ekranu przeliczona na swiat.
