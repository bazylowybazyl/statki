        function syncCiwsFromAuxLoadout(auxLoadouts) {
          const prev = Array.isArray(ship.ciws) ? ship.ciws : [];
          const prevByHpId = new Map();
          for (let i = 0; i < prev.length; i++) {
            const entry = prev[i];
            if (!entry || !entry.hpId) continue;
            prevByHpId.set(entry.hpId, entry);
          }
    
          const next = [];
          for (let i = 0; i < auxLoadouts.length; i++) {
            const loadout = auxLoadouts[i];
            const hp = loadout?.hp;
            if (!hp?.pos) continue;
            const previous = prevByHpId.get(hp.id);
            next.push({
              hpId: hp.id,
              offset: { x: Number(hp.pos.x) || 0, y: Number(hp.pos.y) || 0 },
              angle: Number.isFinite(previous?.angle) ? previous.angle : 0,
              angVel: Number.isFinite(previous?.angVel) ? previous.angVel : 0,
              cd: Number.isFinite(previous?.cd) ? previous.cd : 0
