        }
    
        function normalizeEditorEngineDeg(value, fallback = 0) {
          let deg = Number.isFinite(Number(value)) ? Number(value) : Number(fallback) || 0;
          while (deg > 180) deg -= 360;
          while (deg < -180) deg += 360;
          return deg;
