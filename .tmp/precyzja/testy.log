          // więc start był asymetryczny: trzy strumienie z jednej burty, jeden z drugiej.
          mountFirstFree(HP.HANGAR, 'fighter_squad_multirole', 6);
          mountFirstFree(HP.BUILTIN, 'hexlance_siege', 1);
          mountFirstFree(HP.SPECIAL_MISSILE, 'supernova_missile', 4);
        }
    
        function mountFirstFree(type, weaponId, howMany) {
          const inventory = Game.player.inventory;
          for (const hp of Game.player.hardpoints) {
            if (howMany <= 0) break;
            // Zapas sprawdzamy w pętli, nie raz na starcie — przy licznikach sztuk
            // ładownia może się skończyć w połowie obsadzania.
            if (!inventory.has(weaponId)) break;
            if (hp.type === type && !hp.mount && !hp.destroyed) {
