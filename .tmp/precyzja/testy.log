        function saveLoadout() {
          // Po klikniecu "Wyzeruj zapis" w DevTools zapis jest zamkniety na klucz, zeby
          // `beforeunload` nie odtworzyl wlasnie wyczyszczonego `loadout` (patrz <head>).
          if (window.__SAVE_LOCKED) return;
          try {
            syncPlayerHullSnapshot();
            const activeHullId = normalizePlayerHullId(PLAYER.activeHullId || ship.activeHullId || DEFAULT_PLAYER_HULL_ID);
            const activeHullDef = getPlayerHullDef(activeHullId);
            localStorage.setItem('loadout', JSON.stringify({
              activeHullId,
              ownedHullIds: [...getPlayerOwnedHullIds()],
              shipFrame: activeHullDef?.shipFrame || Game.player.shipFrame || DEFAULT_PLAYER_HULL_ID,
              hullChips: serializeHullChips(PLAYER.hullChips),
              hardpoints: Game.player.hardpoints.map(h => ({
                id: h.id,
                type: h.type,
                mount: h.mount,
                ammo: h.ammo,
                maxAmmo: h.maxAmmo,
                hangarSquadrons: h.type === HP.HANGAR ? getHardpointHangarSquadrons(h) : undefined
