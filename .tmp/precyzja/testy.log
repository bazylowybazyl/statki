        function buildPlayerDefaultEditorEngines(preferredKey = null) {
          const playerCfg = getPlayerEditorConfigFromStorage(preferredKey);
          const rawMain = Array.isArray(playerCfg?.engines?.main) ? playerCfg.engines.main : [];
          const rawSide = Array.isArray(playerCfg?.engines?.side) ? playerCfg.engines.side : [];
          const { scaleX, scaleY } = getPlayerEditorScale();
          const mainThrusters = [];
          const sideThrusters = [];
    
          for (let i = 0; i < rawMain.length; i++) {
            const m = normalizeEditorEngineMarker(rawMain[i], 'main');
            if (!m) continue;
            mainThrusters.push({
              offset: { x: m.x * scaleX, y: m.y * scaleY },
              forward: editorDegToForward(m.nozzleDeg),
              baseDeg: m.baseDeg,
              nozzleDeg: m.nozzleDeg,
              mount: m.mount,
