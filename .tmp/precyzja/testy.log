            const spark3D = SparkSystem3D;
            if (spark3D && spark3D.isInitialized) {
              const isHeavy = (b.weaponSize === 'L' || b.weaponSize === 'Capital');
              const sparkSpeed = isHeavy ? 400 * scale : 280 * scale;
