              _activeWrecksBuffer.push(w);
            }
          }
          enforceWreckHexBudget();
          PerfHUD.addTiming('wreckPrepTime', performance.now() - tPreSection0);
          PerfHUD.addTiming('preAiTime', performance.now() - tPreAiTotal0);
    
          // Martwe NPC misji (wrak już powstał) wypadają z npcs — raz na klatkę,
