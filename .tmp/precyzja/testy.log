        function getEntityHardpointScaleY(entity) {
          const scaleYRaw = Number(entity?.__hardpointScaleY);
          if (Number.isFinite(scaleYRaw) && scaleYRaw > 0) return scaleYRaw;
          const uniformRaw = Number(entity?.__hardpointScale);
          return (Number.isFinite(uniformRaw) && uniformRaw > 0) ? uniformRaw : 1;
