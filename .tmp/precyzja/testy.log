          ship.visual.torqueThrusters = cfg.sideThrusters;
          if (cfg.mainThrusters.length) ship.visual.engineFx = cfg.engineFx;
          else delete ship.visual.engineFx;
    
          if (cfg.mainThrusters.length) {
            const firstMain = cfg.mainThrusters[0];
            if (ship.engines.main) {
              ship.engines.main.vfxOffset = { ...firstMain.offset };
              ship.engines.main.vfxForward = { ...firstMain.forward };
              ship.engines.main.vfxYNudge = Number(firstMain.yNudge) || 0;
              ship.engines.main.vfxLengthMin = Number(firstMain.vfxLengthMin) || ship.engines.main.vfxLengthMin || 10;
              ship.engines.main.vfxLengthMax = Number(firstMain.vfxLengthMax) || ship.engines.main.vfxLengthMax || 179;
              ship.engines.main.mount = firstMain.mount || ship.engines.main.mount || null;
