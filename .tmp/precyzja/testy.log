        const SUPPORT_FORMATION = {
          lineOrder: ['frigate_laser', 'frigate_pd', 'destroyer', 'battleship', 'pirate_battleship', 'carrier', 'supercapital', 'fighter'],
          lead: 0,
          lineGap: 200,
          lateralGap: 1500,
          spawn: { perRow: 4, colGap: 90, rowGap: 70, lead: 160 },
          fighterSquadSize: 9,
          fighterOffsets: [
            { x: -20, y: -15 }, { x: -20, y: 15 },
