            const ny = toY / dist;
            const tx = -ny;
            const ty = nx;
            const speed = speedMin + Math.random() * (speedMax - speedMin);
            const tangent = (Math.random() - 0.5) * tangentialKick;
            window.flyingHexDebris.push({
              x: wx, y: wy,
              vx: entVX + nx * speed + tx * tangent + (Math.random() - 0.5) * lateralJitter,
              vy: entVY + ny * speed + ty * tangent + (Math.random() - 0.5) * lateralJitter,
              angle: Math.random() * Math.PI * 2,
