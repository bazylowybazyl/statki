        }, window.DevTuning || {});
    
        const DevFlags = window.DevFlags;
        const DevTuning = window.DevTuning;
        const Dev = window.Dev = window.Dev || {};
        const physicsBridgeV2 = DevFlags.workerPhysicsV2
          ? new PhysicsBridge({ maxBodies: 4096, maxProjectiles: 65536 })
          : null;
        window.PhysicsBridgeV2 = physicsBridgeV2;
        window.PhysicsBridgeV2Stats = () => physicsBridgeV2?.getStats?.() || { mode: 'disabled' };
        if (!Number.isFinite(Dev.station3DScale) || Dev.station3DScale <= 0) {
