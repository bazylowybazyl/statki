              const squadronMounts = getHardpointHangarSquadrons(hp);
              for (const mountId of squadronMounts) {
                const weapon = WEAPONS[mountId];
                if (!weapon) continue;
                byType[hp.type].push({
                  hp,
                  weapon,
                  mountId,
                  squadron: getFighterSquadronDef(weapon.squadronId)
