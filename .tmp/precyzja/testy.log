          lockedTargets = [];
          lockedTarget = null;
          clearPlayerAttackState();
          pushZoneMessage('CELE ODBLOKOWANE', 1.1);
        }
    
        function toggleLockedTargetUi(target) {
          if (!isValidLockedTarget(target)) return;
          if (!isPlayerLockTargetInRange(target)) {
            warnTargetOutOfLockRange(target);
            return;
          }
          const idx = lockedTargets.indexOf(target);
          if (idx >= 0) {
            const next = lockedTargets.slice();
            next.splice(idx, 1);
            setLockedTargetsExact(next);
            if (playerAttackState.target === target) clearPlayerAttackState(target);
            pushZoneMessage('CEL ODBLOKOWANY', 1.0);
            return;
          }
          const next = lockedTargets.slice(0, RADAR_UI_MAX_TARGETS - 1);
          next.unshift(target);
          setLockedTargetsExact(next);
          pushZoneMessage(`CEL ZABLOKOWANY${next.length > 1 ? ` (${next.length})` : ''}`, 1.0);
        }
    
        function getTargetingSubsystemLabel(hp) {
          const weaponName = hp?.mount ? WEAPONS[hp.mount]?.name : null;
          return String(weaponName || hp?.type || 'HARDPOINT').toUpperCase();
        }
    
        function getTargetingSubsystemTarget(entity, hp) {
          let byHardpoint = targetingMode.subsystemTargets.get(entity);
          if (!byHardpoint) {
            byHardpoint = new WeakMap();
            targetingMode.subsystemTargets.set(entity, byHardpoint);
          }
          let target = byHardpoint.get(hp);
          if (target) return target;
    
          target = {
            type: 'subsystem',
            __targetingSubsystem: true,
            ownerEntity: entity,
            hardpoint: hp,
            hostile: true,
            radius: 12,
            get x() { return getEntityHardpointWorldPos(entity, hp)?.x ?? getTargetX(entity); },
            get y() { return getEntityHardpointWorldPos(entity, hp)?.y ?? getTargetY(entity); },
            get vx() { return Number(entity?.vx ?? entity?.vel?.x) || 0; },
            get vy() { return Number(entity?.vy ?? entity?.vel?.y) || 0; },
            get friendly() { return entity?.friendly === true; },
            get isPirate() { return entity?.isPirate === true; },
            get dead() { return !isTargetAlive(entity) || hp?.destroyed === true; },
            get destroyed() { return !isTargetAlive(entity) || hp?.destroyed === true; },
            get label() { return getTargetingSubsystemLabel(hp); }
          };
          byHardpoint.set(hp, target);
          return target;
        }
    
        // Mostek jako cel podsystemu (tryb SUB, src/game/shipBridgeRuntime.js).
        // Marker = środek strefy; broń celuje w heksy strefy odsłonięte od strony
        // gracza (getBridgeAimPoint, „breach”) — liczone raz na krok fizyki.
        const _bridgeMarker = { x: 0, y: 0 };
        const _bridgeAimScratch = { x: 0, y: 0 };
    
        function getBridgeMarkerWorld(entity, bridge) {
          return bridgePngToWorld(entity, bridge.def.x, bridge.def.y, _bridgeMarker);
        }
    
        function isBridgeTargetGone(entity, bridge) {
          const st = entity?.bridgeState;
          return !st || st.commandLost || bridge.dead || !st.bridges.includes(bridge);
        }
    
        function listTargetableBridges(entity) {
          const st = entity?.bridgeState;
          return st && !st.commandLost ? st.bridges : null;
        }
    
        function getTargetingBridgeTarget(entity, bridge) {
          let byHardpoint = targetingMode.subsystemTargets.get(entity);
          if (!byHardpoint) {
            byHardpoint = new WeakMap();
            targetingMode.subsystemTargets.set(entity, byHardpoint);
          }
          let target = byHardpoint.get(bridge);
          if (target) return target;
    
          const aim = { x: 0, y: 0, at: -1, memory: { shard: null } };
          const refreshAim = () => {
            if (aim.at === bridgeSimTime) return;
            aim.at = bridgeSimTime;
            const p = isBridgeTargetGone(entity, bridge) ? null : getBridgeAimPoint(entity, _bridgeAimScratch, {
              mode: 'breach', fromX: ship.pos.x, fromY: ship.pos.y, memory: aim.memory, bridgeId: bridge.id
            });
            const q = p || getBridgeMarkerWorld(entity, bridge);
            aim.x = q.x;
            aim.y = q.y;
          };
          const gone = () => !isTargetAlive(entity) || isBridgeTargetGone(entity, bridge);
          target = {
            type: 'subsystem',
            __targetingSubsystem: true,
            __bridgeTarget: true,
            ownerEntity: entity,
            hardpoint: { id: `bridge:${bridge.id}`, type: 'bridge', destroyed: false },
            bridge,
            hostile: true,
            radius: 16,
            get x() { refreshAim(); return aim.x; },
            get y() { refreshAim(); return aim.y; },
            get vx() { return Number(entity?.vx ?? entity?.vel?.x) || 0; },
            get vy() { return Number(entity?.vy ?? entity?.vel?.y) || 0; },
            get friendly() { return entity?.friendly === true; },
            get isPirate() { return entity?.isPirate === true; },
            get dead() { return gone(); },
            get destroyed() { return gone(); },
            get label() { return bridge.def.role === 'backup' ? 'MOSTEK ZAPASOWY' : 'MOSTEK'; }
          };
          byHardpoint.set(bridge, target);
          return target;
        }
    
        function findTargetingHoveredSubsystem(entity, screenX = mouse.x, screenY = mouse.y, camRef = camera) {
          if (!entity || !targetingMode.scannedTargets.has(entity)) return null;
          const hardpoints = getEntityHardpoints(entity);
          if (!Array.isArray(hardpoints)) return null;
          let best = null;
          let bestDistSq = 16 * 16;
          for (let i = 0; i < hardpoints.length; i++) {
            const hp = hardpoints[i];
            if (!hp || hp.destroyed) continue;
            const point = getEntityHardpointWorldPos(entity, hp);
            if (!point) continue;
            const screen = worldToScreen(point.x, point.y, camRef);
            const dx = screen.x - screenX;
            const dy = screen.y - screenY;
            const distSq = dx * dx + dy * dy;
            if (distSq >= bestDistSq) continue;
            bestDistSq = distSq;
            best = getTargetingSubsystemTarget(entity, hp);
          }
          // Mostek ma większy chwyt (24 px), ale bliższy hardpoint wygrywa.
          const bridges = listTargetableBridges(entity);
          if (bridges) {
            for (let i = 0; i < bridges.length; i++) {
              const bridge = bridges[i];
              if (bridge.dead) continue;
              const point = getBridgeMarkerWorld(entity, bridge);
              const screen = worldToScreen(point.x, point.y, camRef);
              const dx = screen.x - screenX;
              const dy = screen.y - screenY;
              const distSq = dx * dx + dy * dy;
              if (distSq >= (best ? bestDistSq : 24 * 24)) continue;
              bestDistSq = distSq;
              best = getTargetingBridgeTarget(entity, bridge);
            }
          }
          return best;
        }
    
        // Diagnostyka celownika — `__targetingDebug()` w konsoli przegladarki.
        // Pokazuje dokladnie to, co widzi confirmTargetingSelection() w chwili LPM.
        window.__targetingDebug = () => {
          const cands = targetingMode.groupCandidates.map(t => ({
            id: getRadarTargetUnitId(t),
            type: String(t?.type || t?.__scannerContactType || '?'),
            progress: Number((targetingMode.groupAcquisition.get(t) || 0).toFixed(3)),
            lockTime: getTargetingLockDuration(t),
            canLock: canPlayerLockTarget(t),
            dist: Math.round(playerTargetDistance(t))
          }));
          return {
            mode: TARGETING_MODE_NAMES[targetingMode.current],
            lockRange: Math.round(getScannerSensors().lockRange),
            candidates: cands.length,
            ready: cands.filter(c => c.progress >= 1).length,
            lockedTargets: lockedTargets.length,
            lockedPrimary: lockedTarget ? getRadarTargetUnitId(lockedTarget) : null,
            acquireTarget: targetingMode.acquireTarget ? getRadarTargetUnitId(targetingMode.acquireTarget) : null,
            acquireProgress: Number(targetingMode.acquireProgress.toFixed(3)),
            detail: cands
          };
        };
    
        // Dlaczego kontakt pod kursorem nie da sie namierzyc — zamiast ciszy.
        function _targetingBlockedReason(target) {
          if (!target) return '';
          if (!isValidLockedTarget(target)) return 'KONTAKT NEUTRALNY — BRAK NAMIARU';
          if (!isPlayerLockTargetInRange(target)) {
            const sensors = getScannerSensors();
            return `POZA ZASIĘGIEM NAMIARU (${formatSensorRange(playerTargetDistance(target))}/${formatSensorRange(sensors.lockRange)})`;
          }
          return 'BRAK NAMIARU';
        }
    
        // Czy LPM ma teraz co zatwierdzic? Uzywane, zeby stacja pod kursorem nie
        // przechwytywala kliku, gdy gracz wlasnie sklada namiar na okret.
        function hasPendingTargetingConfirm(hoveredStation) {
          if (!gameStarted) return false;
          if (targetingMode.current === TARGETING_MODE.SINGLE) {
            const target = targetingMode.acquireTarget;
            // Stacja pod kursorem nadal otwiera swoj panel — LPM odbieramy jej tylko
            // wtedy, gdy namierzany jest ktos inny (okret przelatujacy nad stacja).
            if (!target || target === hoveredStation) return false;
            return targetingMode.acquireProgress > 0;
          }
          if (targetingMode.current === TARGETING_MODE.MULTI) {
            return targetingMode.groupCandidates.length > 0;
          }
          if (targetingMode.current === TARGETING_MODE.SUB) {
            return !!(targetingMode.hoveredSubsystem || targetingMode.subScanTarget);
          }
          return false;
        }
    
        function confirmTargetingSelection() {
          if (targetingMode.current === TARGETING_MODE.SINGLE) {
            const target = targetingMode.acquireTarget;
            if (!target || !canPlayerLockTarget(target)) {
              const blocked = targetingMode.hoverBlocked;
              pushZoneMessage(
                blocked ? `SINGLE: ${_targetingBlockedReason(blocked)}` : 'SINGLE: BRAK CELU POD KURSOREM',
                1.2
              );
              return;
            }
            if (targetingMode.acquireProgress < 1) {
              pushZoneMessage(`SINGLE: NAMIAR ${Math.round(targetingMode.acquireProgress * 100)}% — UTRZYMAJ CEL`, 1.0);
              return;
            }
            setLockedTargetsExact([target]);
            pushZoneMessage(`SINGLE: LOCK ${getRadarTargetUnitId(target)}`, 1.1);
            return;
          }
    
          if (targetingMode.current === TARGETING_MODE.MULTI) {
            const ready = [];
            let best = 0;
            for (let i = 0; i < targetingMode.groupCandidates.length; i++) {
              const target = targetingMode.groupCandidates[i];
              if (!canPlayerLockTarget(target)) continue;
              const progress = targetingMode.groupAcquisition.get(target) || 0;
              if (progress >= 1) ready.push(target);
              else if (progress > best) best = progress;
            }
            if (!ready.length) {
              pushZoneMessage(
                targetingMode.groupCandidates.length
                  ? `MULTI: NAMIAR ${Math.round(best * 100)}% — UTRZYMAJ RAMKĘ NA SKUPISKU`
                  : 'MULTI: PRZESUŃ RAMKĘ NAD CELE',
                1.0
              );
              return;
            }
            // Limit 8 obowiazuje dopiero TERAJ: z gotowych bierzemy te najblizsze
            // kursorowi. Podczas akwizycji lista jest pelna, zeby namiar nie gasl
            // przy przeskokach kolejnosci.
            if (ready.length > RADAR_UI_MAX_TARGETS) {
              const aim = screenToWorld(mouse.x, mouse.y);
              ready.sort((a, b) => {
                const adx = getTargetX(a) - aim.x;
                const ady = getTargetY(a) - aim.y;
                const bdx = getTargetX(b) - aim.x;
                const bdy = getTargetY(b) - aim.y;
                return (adx * adx + ady * ady) - (bdx * bdx + bdy * bdy);
              });
            }
            const locking = ready.slice(0, RADAR_UI_MAX_TARGETS);
            setLockedTargetsExact(locking);
            pushZoneMessage(`MULTI: LOCK x${lockedTargets.length}`, 1.1);
            return;
          }
    
          if (targetingMode.current === TARGETING_MODE.SELECT) {
            // TODO: podpiąć klikalne obiekty w świecie gry.
            return;
          }
    
          const entity = scan?.target;
          const subsystem = targetingMode.hoveredSubsystem || findTargetingHoveredSubsystem(entity);
          if (subsystem) {
            toggleLockedTargetUi(subsystem);
            return;
          }
          if (entity && targetingMode.scannedTargets.has(entity)) {
            pushZoneMessage('SUB: WSKAŻ HARDPOINT I KLIKNIJ LPM', 1.1);
          } else {
            pushZoneMessage(`SUB: SKANUJ KADŁUB ${Math.round(targetingMode.subScanProgress * 100)}%`, 1.1);
          }
        }
    
        function getRadarTargetUnitClass(target) {
          if (target?.__bridgeTarget) return target.label;
          if (target?.__targetingSubsystem) return `HARDPOINT • ${target.label || 'SUB'}`;
          if (isAsteroidTarget(target)) {
            const size = String(target?.size || '').toUpperCase();
            const type = String(target?.type || target?.resource || '').toUpperCase();
            return `ASTEROIDA${type ? ` ${type}` : ''}${size ? ` ${size}` : ''}`.trim();
          }
          const type = String(target?.type || target?.__scannerContactType || '').toLowerCase();
          if (type.includes('platform')) return 'PLATFORMA';
          if (type.includes('station')) return 'STACJA';
          if (type.includes('battleship') || type.includes('carrier') || type.includes('supercapital')) return 'KRAZOWNIK';
          if (type.includes('destroyer')) return 'NISZCZYCIEL';
          if (type.includes('frigate')) return 'FREGATA';
          if (type.includes('fighter') || type.includes('interceptor') || type.includes('drone')) return 'MYSLIWIEC';
          if (target?.isCapitalShip) return 'KAPITAL';
          return 'KONTAKT';
        }
    
        function getRadarTargetUnitId(target) {
          if (target?.__radarUnitId) return target.__radarUnitId;
          const prefix = target?.__targetingSubsystem ? 'SUB' : (isAsteroidTarget(target) ? 'AST' : (target?.isPirate ? 'PIR' : 'TGT'));
          const raw = Number(target?.id) || Math.floor(Math.abs(getTargetX(target) * 0.13 + getTargetY(target) * 0.07 + Math.random() * 9000));
          target.__radarUnitId = `${prefix}-${String(raw % 10000).padStart(4, '0')}`;
          return target.__radarUnitId;
        }
    
        function getRadarTargetMeta(target) {
          const source = target?.__targetingSubsystem ? target.ownerEntity : target;
          const hpScale = getEntityHardpointScale(source);
          const srcW = Number(source?.hexGrid?.srcWidth);
          const srcH = Number(source?.hexGrid?.srcHeight);
          const radius = Math.max(20, getTargetRadius(source));
          return {
            unitId: getRadarTargetUnitId(target),
            unitClass: getRadarTargetUnitClass(target),
            shipLength: Number.isFinite(srcW) && srcW > 0 ? srcW * hpScale.x : radius * 3.0,
            shipWidth: Number.isFinite(srcH) && srcH > 0 ? srcH * hpScale.y : radius * 1.8
          };
        }
    
        function buildRadarWeaponsSummary(target) {
          const buckets = new Map();
          const groups = target?.weapons && typeof target.weapons === 'object' ? Object.values(target.weapons) : [];
          for (const group of groups) {
            if (!Array.isArray(group)) continue;
            for (const entry of group) {
              const weaponId = entry?.weapon?.id || entry?.hp?.mount;
              const weaponDef = weaponId ? WEAPONS[weaponId] : null;
              const name = weaponDef?.name || weaponId || 'UNKNOWN';
              const type = String(entry?.hp?.type || weaponDef?.mountType || 'main').toUpperCase();
              const key = `${type}:${name}`;
              const prev = buckets.get(key);
              if (prev) prev.count += 1;
              else buckets.set(key, { type, name, count: 1 });
            }
          }
          return [...buckets.values()].sort((a, b) => a.type.localeCompare(b.type) || a.name.localeCompare(b.name));
        }
    
        function buildRadarCargoSummary(target) {
          if (isAsteroidTarget(target)) return buildAsteroidScanDetails(target).rows;
          const rows = [];
          if (Number.isFinite(Number(target?.mass))) rows.push({ name: 'Mass', amount: `${Math.round(Number(target.mass))}` });
          if (target?.shield && Number.isFinite(Number(target.shield?.max))) rows.push({ name: 'Shield', amount: `${Math.round(Number(target.shield.max))}` });
          const hpMax = Math.max(0, Number(target?.maxHp) || Number(target?.hp) || 0);
          if (hpMax > 0) rows.push({ name: 'Hull', amount: `${Math.round(hpMax)}` });
          if (Number.isFinite(Number(target?.cargoCap))) rows.push({ name: 'Cargo', amount: `${Math.round(Number(target.cargoCap))}` });
          return rows;
        }
    
        function buildRadarBlueprintData(target) {
          const grid = target?.hexGrid;
          const hpScale = getEntityHardpointScale(target);
          const shards = Array.isArray(grid?.shards)
            ? grid.shards.map((shard) => ({
                x: (Number(shard?.origLx) || 0) * hpScale.x,
                y: (Number(shard?.origLy) || 0) * hpScale.y,
                hp: Number(shard?.hp) || 0,
                maxHp: Number(shard?.maxHp) || 1,
                active: !!(shard?.active && !shard?.isDebris)
              }))
            : [];
          const hardpoints = (getEntityHardpoints(target) || []).map((hp) => {
            const local = getEntityHardpointLocalPos(target, hp) || { x: 0, y: 0 };
            return { x: local.x, y: local.y, destroyed: !!hp?.destroyed };
          });
          const cores = (getEntityCores(target) || []).map((core) => {
            const local = getEntityCoreLocalPos(target, core) || { x: 0, y: 0 };
            return { x: local.x, y: local.y, destroyed: !!core?.destroyed };
          });
          return {
            width: (Number(grid?.srcWidth) || Math.max(120, (Number(target?.radius) || 40) * 3)) * hpScale.x,
