                  const mouseRef = isP2Ship ? window.mouse2 : mouse;
                  const camRef = isP2Ship ? (window.camera2 || undefined) : undefined;
                  if (mouseRef && window.screenToWorld) {
                    const mw = window.screenToWorld(mouseRef.x, mouseRef.y, camRef);
                    if (mw && Number.isFinite(mw.x) && Number.isFinite(mw.y)) {
                      const dx = mw.x - muzzleData.pos.x;
                      const dy = mw.y - muzzleData.pos.y;
                      const mouseDist = Math.hypot(dx, dy);
                      const nx = mouseDist > 1e-6 ? (dx / mouseDist) : dirX;
                      const ny = mouseDist > 1e-6 ? (dy / mouseDist) : dirY;
                      pointTargetX = muzzleData.pos.x + nx * Math.min(range, mouseDist);
                      pointTargetY = muzzleData.pos.y + ny * Math.min(range, mouseDist);
                    }
                  }
                  rocketTarget = {
                    x: pointTargetX,
                    y: pointTargetY,
                    dead: false,
                    _isPositionTarget: true
                  };
                }
                window.rocketSystem3D.fire(
                  muzzleData.pos.x, muzzleData.pos.y,
                  rocketTarget, damage, weapon, colorTheme
                );
              } else {
                const bullet = {
                  x: muzzleData.pos.x,
                  y: muzzleData.pos.y,
                  vx: dirX * speed + (muzzleData.baseVel?.x || 0) * 0.2,
                  vy: dirY * speed + (muzzleData.baseVel?.y || 0) * 0.2,
                  life: life,
                  // weapon.bulletRadius opt-in override (e.g. osa_micro_missile sets r=8 to widen fuse for fast-mover)
                  // Flak ma stały, mały promień kolizji — robotę odwala pęknięcie, nie sam pocisk.
                  r: flakProfile ? FLAK_TUNING.SHELL_RADIUS
                    : (weapon.bulletRadius || (weapon.category === 'torpedo' ? 10 : (weapon.size === 'L' ? 6 : (weapon.size === 'M' ? 4 : 2)))),
                  owner: isP2Ship ? 'player2' : (shooterIsFriendly ? 'player' : 'npc'),
                  damage: damage,
                  type: weapon.category, // 'rail', 'plasma', 'rocket', etc.
                  weaponSize: weapon.size || 'M', // S, M, L, Capital — for VFX tier
                  color: weapon.vfxColor,
                  source: shooter,
                  penetration: weapon.penetration || 0,
                  explodeRadius: weapon.explodeRadius || weapon.explosionRadius || 0,
    
                  // Specyficzne dla rakiet i torped
                  target: (weapon.category === 'rocket' || weapon.category === 'torpedo') ? target : null,
                  turnRate: weapon.turnRate ? (weapon.turnRate * Math.PI / 180) : 0,
                  homingDelay: weapon.homingDelay || 0,
                  vfxKey: weapon.id,
                  forceCanvas: !!weapon.forceCanvas,  // tells weapon3DSystem to skip 3D bullet render
                  lockOwner: isP2Ship ? 'player2' : (isP1Ship ? 'player' : null)
                };
                // --- FLAK: dane zapalnika (obsługa w bulletsAndCollisionsStep) ---
                // Zwykłe przypisania zamiast spreadu obiektu tymczasowego per pocisk.
                if (flakProfile) {
                  bullet.flakAge = 0;
                  // Każdy pocisk salwy dostaje inny jitter — ściana pęknięć układa
                  // się warstwami w głąb zamiast w jedną płaską linię.
                  bullet.flakFuseTime = flakFuseTime(flakAimDist, speed, (Math.random() * 2 - 1));
                  bullet.flakFuseRadius = flakProfile.fuseRadius;
                  bullet.flakArmTime = flakProfile.armTime;
                  bullet.flakBurstRadius = flakProfile.burstRadius;
                  bullet.flakFalloff = flakProfile.falloff;
