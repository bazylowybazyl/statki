        }
    
        function restoreHardpointMountEntry(hp, entry) {
          if (!hp || !entry) return;
          if (hp.type === HP.HANGAR) {
            const squadronMounts = Array.isArray(entry.hangarSquadrons) && entry.hangarSquadrons.length
              ? entry.hangarSquadrons
              : (entry.weaponId ? [entry.weaponId] : []);
            setHardpointHangarSquadrons(hp, squadronMounts);
            return;
          }
          // Zapisany fit jest źródłem prawdy dla tego, co WISI NA KADŁUBIE — ładownia
          // ma tylko tego nie dublować. Wcześniej stało tu `skipInventory: true`, przez
          // co sztuki zdjęte z ładowni przez automount przepadały razem ze starą tablicą
          // hardpointów. Teraz montaż normalnie je pobiera, a gdy sztuki brakuje (broń
