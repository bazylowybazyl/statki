          if (templateKey === 'supercapital') {
            return spawnCapitalCallIn('supercapital', { ...opts, mode });
          }
          if (templateKey === 'atlas') {
            return spawnCapitalCallIn('atlas', { ...opts, mode });
          }
          if (templateKey === 'megafreighter') {
