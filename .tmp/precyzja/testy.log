        }
    
        function spawnReactorBlowBreakup(entity, sourceShards, explosionPos, severity = 0) {
          if (!entity?.hexGrid || !DestructorSystem?.spawnWreckEntity) {
            if (window.DEBUG_CRIT_BLOW) console.warn('[CritBlow breakup] aborted: missing entity/hexGrid/Destructor');
            return { fragments: 0, debris: 0 };
          }
    
          const eligible = Array.isArray(sourceShards)
            ? sourceShards.filter(s => s && s.active !== false && !s.isDebris && (s.hp == null || s.hp > 0))
            : [];
          if (eligible.length === 0) return { fragments: 0, debris: 0 };
    
          const severityClamped = Math.max(0, Math.min(1.4, Number(severity) || 0));
          let fragCount = 2;
          if (eligible.length >= 18) fragCount++;
          if (eligible.length >= 36) fragCount++;
          if (eligible.length >= 54 && severityClamped > 0.95) fragCount++;
          const minFragmentShards = 4;
          fragCount = Math.max(1, Math.min(fragCount, Math.floor(eligible.length / minFragmentShards) || 1));
    
          let debrisCount = Math.floor(eligible.length * (0.22 + Math.min(0.28, severityClamped * 0.20)));
          debrisCount = eligible.length >= 20 ? Math.max(debrisCount, 10) : Math.max(debrisCount, 4);
          const maxDebrisCount = Math.max(0, eligible.length - fragCount * minFragmentShards);
          debrisCount = Math.min(debrisCount, maxDebrisCount);
    
          const debrisShards = debrisCount > 0
            ? pickReactorBlowDebrisShards(entity, eligible, debrisCount)
            : [];
