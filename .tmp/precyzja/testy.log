            if (hasTargets) {
              rocketAutoFire = !rocketAutoFire;
              pushZoneMessage(rocketAutoFire ? 'RAKIETY: AUTO-FIRE ON' : 'RAKIETY: AUTO-FIRE OFF', 1.5);
            } else {
