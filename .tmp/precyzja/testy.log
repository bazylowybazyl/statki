        // =============== CIWS (point-defence) ===============
        const CIWS_FIRE_INTERVAL = 0.06;
        const CIWS_BULLET_SPEED = 900;
        const CIWS_DAMAGE = 8;
        const CIWS_RANGE = 600;
    
        const LASER_PD_FIRE_INTERVAL = 0.18;
        const LASER_PD_DAMAGE = 16;
        const LASER_PD_RANGE = 620;
        const LASER_PD_BEAM_WIDTH = 6;
    
        // Wspólny bufor wrogich rakiet/torped na bieżący krok fizyki. Budowany raz
        // w ciwsStep, używany przez działka PD oraz przez intercept CIWS w
        // bulletsAndCollisionsStep (zamiast skanowania całej tablicy bullets per pocisk).
        const _pdEnemyRocketBuffer = [];
        const _pdPlayerRocketBuffer = [];
        // Capital AI czyta te same bufory zamiast skanować całą tablicę bullets
        // osobno dla każdego statku i każdej baterii point-defence.
        window.__npcRocketThreats = _pdEnemyRocketBuffer;
        window.__playerRocketThreats = _pdPlayerRocketBuffer;
    
        function ciwsStep(dt) {
          _pdEnemyRocketBuffer.length = 0;
          _pdPlayerRocketBuffer.length = 0;
          for (let bi = 0; bi < bullets.length; bi++) {
            const rb = bullets[bi];
            if (!rb || rb.life <= 0) continue;
            if (rb.type !== 'rocket' && rb.type !== 'torpedo') continue;
            if (rb.owner === 'player' || rb.owner === 'player2') {
              _pdPlayerRocketBuffer.push(rb);
            } else {
              _pdEnemyRocketBuffer.push(rb);
            }
          }
          const auxWeapons = Game.player.weapons?.[HP.AUX] || [];
          // Bez PD CHIP-a obrona punktowa gracza strzela tylko do rakiet i myśliwców.
          const pdHullsAllowed = hasShipChip(ship, PD_CHIP_ID);
          for (let i = 0; i < ship.ciws.length; i++) {
            if (i >= auxWeapons.length) break;
            const loadout = auxWeapons[i];
            if (!loadout || !loadout.weapon) continue;
            const wDef = loadout.weapon;
            const weaponId = wDef.id;
            const pdDef = wDef.aispacePdId ? AISPACE_PD[wDef.aispacePdId] : null;
            const isFlak = isFlakWeapon(wDef);
            const isLaser = weaponId === 'laser_pd_mk1' || wDef.aispacePdId === 'pd_laser';
            const stats = pdDef;
            const gun = ship.ciws[i];
            gun.cd = Math.max(0, gun.cd - dt);
            const off = rotate(gun.offset, ship.angle);
            const base = { x: ship.pos.x + off.x, y: ship.pos.y + off.y };
            const baseVel = { x: ship.vel.x - ship.angVel * off.y, y: ship.vel.y + ship.angVel * off.x };
    
            // Zasięg z definicji broni, nie z hardcoded stałych
            const range = stats?.range || wDef.baseRange || (isLaser ? LASER_PD_RANGE : CIWS_RANGE);
            const bulletSpeed = stats?.speed || wDef.baseSpeed || CIWS_BULLET_SPEED;
    
            let target = null;
            let bestDistSq = range * range;
    
            // Priorytet 1: rakiety/torpedy wroga w zasięgu (intercept) — z bufora,
            // porównania na kwadratach dystansu (bez Math.hypot per pocisk).
            for (let bi = 0; bi < _pdEnemyRocketBuffer.length; bi++) {
              const rb = _pdEnemyRocketBuffer[bi];
              if (rb.life <= 0) continue;
              const ddx = rb.x - base.x, ddy = rb.y - base.y;
              const d2 = ddx * ddx + ddy * ddy;
              if (d2 < bestDistSq) { bestDistSq = d2; target = rb; }
            }
    
            // Priorytet 2: myśliwce. Każde PD szuka najpierw SAMYCH myśliwców —
            // flakowi pancerz okrętu zjada ~85% odłamków, a CIWS/laser robi
            // w kadłub 20% obrażeń, więc klucz myśliwców wchodzący na burtę jest
            // zawsze ważniejszy niż najbliższy kadłub.
            if (!target) {
              for (const npc of npcs) {
                if (npc.dead || npc.friendly || !npc.isPirate) continue;
                if (!isFighterNPC(npc)) continue;
                const ddx = npc.x - base.x, ddy = npc.y - base.y;
                const d2 = ddx * ddx + ddy * ddy;
                if (d2 < bestDistSq) { bestDistSq = d2; target = npc; }
              }
            }
            // Priorytet 3: dowolny piracki kadłub — tylko z PD CHIP-em.
            if (!target && pdHullsAllowed) {
              for (const npc of npcs) {
                if (npc.dead || npc.friendly || !npc.isPirate) continue;
                const ddx = npc.x - base.x, ddy = npc.y - base.y;
                const d2 = ddx * ddx + ddy * ddy;
                if (d2 < bestDistSq) { bestDistSq = d2; target = npc; }
              }
            }
            if (!target) continue;
            const dist = Math.sqrt(bestDistSq);
    
            const isRocketTarget = target.type === 'rocket' || target.type === 'torpedo';
    
            // Lead targeting z prędkością z definicji broni
            const aimPoint = isLaser ? { x: target.x, y: target.y }
              : leadTarget(base, baseVel, target, bulletSpeed);
            let desired = Math.atan2(aimPoint.y - base.y, aimPoint.x - base.x);
    
            // --- Barrage sweep: CIWS oscyluje po łuku wokół celu ---
            // Flak nie omiata: chmura odłamków ma promień dziesiątek metrów,
            // rozrzut robi za niego `spread` salwy przy wystrzale.
            if (!isLaser && !isFlak) {
              if (gun._sweepPhase == null) gun._sweepPhase = Math.random() * Math.PI * 2;
              gun._sweepPhase += dt * 7.5;
              const sweepArc = 0.18 * Math.max(0.3, 1.0 - dist / range);
              desired += Math.sin(gun._sweepPhase) * sweepArc;
            }
    
            let diff = wrapAngle(desired - gun.angle);
            // Flak to ciężka, wolno obracająca się wieża — celuje spokojniej niż CIWS.
            const aimStrength = isLaser ? 9 : (isFlak ? 6 : 10);
            const maxVel = isLaser ? 6.5 : (isFlak ? 3.4 : 8);
            let desiredVel = clamp(diff * aimStrength, -maxVel, maxVel);
            const velDelta = desiredVel - gun.angVel;
            const maxDelta = 50 * dt;
            gun.angVel += clamp(velDelta, -maxDelta, maxDelta);
            gun.angVel *= Math.exp(-6 * dt);
            gun.angVel = clamp(gun.angVel, -maxVel, maxVel);
            gun.angle = wrapAngle(gun.angle + gun.angVel * dt);
    
            // CIWS ma luźniejszą tolerancję — strzela w trakcie sweep
            const aimTolerance = isLaser ? 0.1 : (isFlak ? 0.12 : 0.35);
            if (Math.abs(diff) >= aimTolerance || gun.cd > 0) continue;
    
            const fireInterval = stats?.rps ? (1 / stats.rps) : (wDef.cooldown || (isLaser ? LASER_PD_FIRE_INTERVAL : CIWS_FIRE_INTERVAL));
            if (isFlak) {
              fireFlakSalvo(gun, base, baseVel, target, wDef, fireInterval);
            } else if (isLaser) {
              if (isRocketTarget) {
                // Laser niszczy rakietę natychmiast
                const rIdx = bullets.indexOf(target);
                if (rIdx !== -1) {
                  spawnBulletImpactEffect(target, target.x, target.y, 1.2);
                  spawnPointDefenseLaserHit(target.x, target.y);
                  const lDir = { x: Math.cos(gun.angle), y: Math.sin(gun.angle) };
                  const lMuz = { x: base.x + lDir.x * 6, y: base.y + lDir.y * 6 };
                  spawnLaserBeam(lMuz, { x: target.x, y: target.y }, LASER_PD_BEAM_WIDTH, {
                    life: 0.09, colorOuter: stats?.color || 'rgba(110,200,255,0.9)',
                    colorInner: 'rgba(250,255,255,1.0)', glowColor: stats?.color || 'rgba(90,180,255,0.95)',
                    glowBlur: 22, outerWidthMul: 1.05, innerWidthMul: 0.45
                  });
                  spawnPointDefenseLaserMuzzle(lMuz, lDir, baseVel);
                  target.life = -1; // znika też z _pdEnemyRocketBuffer (checki life<=0)
                  removeBulletAt(rIdx);
                }
                gun.cd = fireInterval;
              } else {
                firePointDefenseLaser(gun, base, baseVel, target, pdDef, fireInterval);
              }
            } else {
              fireCIWSGun(gun, base, baseVel, wDef, fireInterval);
            }
          }
        }
    
        function fireCIWSGun(gun, base, baseVel, wDef, fireInterval) {
          const spread = wDef?.spread || 0.05;
          const shotAngle = gun.angle + (Math.random() - 0.5) * spread;
          const dir = { x: Math.cos(shotAngle), y: Math.sin(shotAngle) };
          const px = base.x + dir.x * 6;
          const py = base.y + dir.y * 6;
          const damage = wDef?.baseDamage ?? CIWS_DAMAGE;
          const speed = wDef?.baseSpeed ?? CIWS_BULLET_SPEED;
          const range = wDef?.baseRange ?? CIWS_RANGE;
          window.bullets.push({
            x: px,
            y: py,
            vx: dir.x * speed + baseVel.x,
            vy: dir.y * speed + baseVel.y,
            life: range / speed,
            r: 2,
            owner: 'player',
            source: ship,
            damage,
            color: wDef?.vfxColor,
            type: 'ciws'
          });
          spawnParticle(
            { x: px, y: py },
            { x: dir.x * 120 + baseVel.x * 0.1, y: dir.y * 120 + baseVel.y * 0.1 },
            0.06,
            '#ffdf9e',
            2.0,
            true
          );
          gun.cd = fireInterval ?? CIWS_FIRE_INTERVAL;
        }
    
        function firePointDefenseLaser(gun, base, baseVel, target, stats, fireInterval) {
          const dir = { x: Math.cos(gun.angle), y: Math.sin(gun.angle) };
          const muzzle = { x: base.x + dir.x * 6, y: base.y + dir.y * 6 };
          const toTarget = { x: target.x - muzzle.x, y: target.y - muzzle.y };
          const range = stats?.range ?? LASER_PD_RANGE;
    
          // Laser_pd: 100% vs myśliwce, 20% vs hull/tarcza statków
          const _laserFighter = !!(target.fighter || target.type === 'fighter');
          const damage = (stats?.dmg ?? LASER_PD_DAMAGE) * (_laserFighter ? 1.0 : 0.2);
          const distance = clamp(Math.hypot(toTarget.x, toTarget.y), 0, range);
          const beamEnd = { x: muzzle.x + dir.x * distance, y: muzzle.y + dir.y * distance };
    
          spawnLaserBeam(muzzle, beamEnd, LASER_PD_BEAM_WIDTH, {
            life: 0.09,
            colorOuter: stats?.color || 'rgba(110,200,255,0.9)',
            colorInner: 'rgba(250,255,255,1.0)',
            glowColor: stats?.color || 'rgba(90,180,255,0.95)',
            glowBlur: 22,
            outerWidthMul: 1.05,
            innerWidthMul: 0.45
          });
          spawnPointDefenseLaserMuzzle(muzzle, dir, baseVel);
          spawnPointDefenseLaserHit(beamEnd.x, beamEnd.y);
          applyDamageToNPC(target, damage, 'laser_pd');
          gun.cd = fireInterval ?? LASER_PD_FIRE_INTERVAL;
        }
    
        // Salwa flaku z działka aux gracza.
        //
        // Jak fireCIWSGun, automatyczna obrona punktowa zachowuje własny cel
        // wybrany przez ciwsStep i własny zapalnik salwy.
        function fireFlakSalvo(gun, base, baseVel, target, wDef, fireInterval) {
          const profile = resolveFlakProfile(wDef);
          const dir = { x: Math.cos(gun.angle), y: Math.sin(gun.angle) };
          const muzzle = { x: base.x + dir.x * 10, y: base.y + dir.y * 10 };
    
          // Zapalnik nastawiony na punkt wyprzedzenia, nie na aktualną pozycję celu.
          const aim = leadTarget(base, baseVel, target, profile.speed);
          const aimDist = Math.min(profile.range, Math.hypot(aim.x - muzzle.x, aim.y - muzzle.y));
          const spread = wDef.spread || 0;
          const life = profile.range / profile.speed;
    
          for (let s = 0; s < profile.shells; s++) {
            const ang = gun.angle + (Math.random() - 0.5) * spread;
            const sx = Math.cos(ang), sy = Math.sin(ang);
            window.bullets.push({
              x: muzzle.x, y: muzzle.y,
              vx: sx * profile.speed + baseVel.x,
              vy: sy * profile.speed + baseVel.y,
              life,
              r: FLAK_TUNING.SHELL_RADIUS,
              owner: 'player',
              source: ship,
              damage: profile.damage,
              type: 'flak',
              weaponSize: profile.size,
              color: wDef.vfxColor,
              vfxKey: wDef.id,
              flakAge: 0,
              // Jitter na pocisk — salwa pęka warstwami w głąb, nie jedną płaską ścianą.
              flakFuseTime: flakFuseTime(aimDist, profile.speed, Math.random() * 2 - 1),
              flakFuseRadius: profile.fuseRadius,
              flakArmTime: profile.armTime,
              flakBurstRadius: profile.burstRadius,
              flakFalloff: profile.falloff,
              flakHullFactor: profile.hullFactor
            });
          }
    
          spawnFlakMuzzle(muzzle, dir, baseVel, wDef);
          gun.cd = fireInterval ?? (wDef.cooldown || CIWS_FIRE_INTERVAL);
        }
    
        // Wylot flaku: krótki, gruby blask + kilka niedopalonych ziaren prochu.
        function spawnFlakMuzzle(pos, dir, baseVel, wDef) {
          if (!isCanvasWeaponVfxEnabled()) return;
          const scale = wDef.size === 'Capital' ? 2.2 : (wDef.size === 'L' ? 1.5 : (wDef.size === 'M' ? 1.1 : 0.8));
          const angle = Math.atan2(dir.y, dir.x);
          spawnParticle({ x: pos.x, y: pos.y }, { x: dir.x * 140 + baseVel.x * 0.12, y: dir.y * 140 + baseVel.y * 0.12 }, 0.09, '#ffe6b0', 7 * scale, true);
          for (let i = 0; i < 5; i++) {
            const aa = angle + (Math.random() - 0.5) * 0.5;
            const speed = 220 + Math.random() * 180;
            spawnParticle(
              { x: pos.x + Math.cos(aa) * 6 * scale, y: pos.y + Math.sin(aa) * 6 * scale },
              { x: Math.cos(aa) * speed + baseVel.x * 0.15, y: Math.sin(aa) * speed + baseVel.y * 0.15 },
              0.14 + Math.random() * 0.12,
              (Math.random() < 0.4) ? '#fff0c8' : '#ffb347',
              (1.8 + Math.random() * 2.0) * scale,
              true
            );
          }
        }
    
        // ========================================================================
        // FLAK — pęknięcie pocisku
        // ========================================================================
        // Pocisk flaku nie trafia w cel, tylko pęka i sieje odłamkami po kuli
        // `flakBurstRadius`. Wszystko, co siedzi w tej kuli, obrywa wg spadku
        // z flakSystem.js — myśliwce pełną porcją, kadłuby okrętów ułamkiem.
        const _flakCandidates = [];
        const _flakHits = [];
    
        function detonateFlakShell(b) {
          const radius = Number(b.flakBurstRadius) || 120;
          const shooterFriendly = (b.owner === 'player' || b.owner === 'player2' || b.source?.friendly === true);
          const radiusSq = radius * radius;
    
          // 1. Encje w zasięgu — z tej samej siatki, której używa główna pętla kolizji.
          //    Encje zajmują wszystkie komórki pokryte kadłubem, więc promień wybuchu
          //    może pytać tylko o komórki, których rzeczywiście dotyka.
          _flakCandidates.length = 0;
          const count = SpatialGrid.getPotentialTargets(b.x, b.y, radius);
          const buf = SpatialGrid._resultBuffer;
          for (let k = 0; k < count; k++) {
            const e = buf[k];
            if (!e || e.isWreck) continue;                       // wrakom odłamki nie zaszkodzą
            if ((e._realEntity || e) === b.source) continue;
            _flakCandidates.push(e);
          }
    
          collectFlakBurstHits({
            x: b.x, y: b.y, radius,
            damage: Number(b.damage) || 0,
            falloff: b.flakFalloff,
            hullFactor: b.flakHullFactor,
            friendly: shooterFriendly,
            source: b.source
          }, _flakCandidates, _flakHits);
    
          for (let k = 0; k < _flakHits.length; k++) {
            const hit = _flakHits[k];
            const target = hit.entity;
            if (target._isPlayerShip) {
              // Jak w głównej pętli kolizji: proxy gracza routuje na applyDamageToPlayer.
              applyDamageToPlayer(hit.damage);
            } else {
              applyDamageToNPC(target._realEntity || target, hit.damage, 'flak');
            }
          }
    
          // 2. Rakiety i torpedy w chmurze odłamków — korzystamy z listy zagrożeń
          // zbudowanej już raz przez CIWS, zamiast ponownie skanować wszystkie pociski.
          const rocketThreats = shooterFriendly ? _pdEnemyRocketBuffer : _pdPlayerRocketBuffer;
          for (let k = 0; k < rocketThreats.length; k++) {
            const rb = rocketThreats[k];
            if (!rb || rb === b || rb.life <= 0) continue;
            if (rb.type !== 'rocket' && rb.type !== 'torpedo') continue;
            const rbFriendly = (rb.owner === 'player' || rb.owner === 'player2');
            if (rbFriendly === shooterFriendly) continue;        // własnej salwy nie zestrzeliwujemy
            const ddx = rb.x - b.x, ddy = rb.y - b.y;
            if (ddx * ddx + ddy * ddy > radiusSq) continue;
            spawnBulletImpactEffect(rb, rb.x, rb.y, 0.9);
            rb.life = -1;   // sprząta go własna iteracja pętli pocisków
          }
    
          // 3. Efekt: pęknięcie 2D (port prototypu) + cięższy akcent 3D dla L/Capital.
          FlakBurstVFX.spawn(b.x, b.y, { radius, vx: b.vx, vy: b.vy });
          if (radius >= 240 && window.triggerArmataImpact3D) {
            window.triggerArmataImpact3D(b.x, b.y, Math.min(260, radius * 0.5));
          }
          if (window.AudioSys) AudioSys.playSound('explosion');
        }
    
        function spawnPointDefenseLaserMuzzle(pos, dir, baseVel) {
          if (!isCanvasWeaponVfxEnabled()) return;
          const tangential = { x: -dir.y, y: dir.x };
          for (let i = 0; i < 3; i++) {
            const spread = (Math.random() - 0.5) * 0.6;
            const vel = {
              x: dir.x * (220 + Math.random() * 80) + tangential.x * spread * 80 + baseVel.x * 0.1,
              y: dir.y * (220 + Math.random() * 80) + tangential.y * spread * 80 + baseVel.y * 0.1
            };
            spawnParticle(
              { x: pos.x, y: pos.y },
              vel,
              0.08 + Math.random() * 0.05,
              '#8fe4ff',
              2.2 + Math.random() * 0.8,
              true
            );
          }
        }
    
        function spawnPointDefenseLaserHit(x, y) {
          if (!isCanvasWeaponVfxEnabled()) return;
          for (let i = 0; i < 12; i++) {
            const a = Math.random() * Math.PI * 2;
            const speed = 160 + Math.random() * 200;
            spawnParticle(
              { x, y },
              { x: Math.cos(a) * speed, y: Math.sin(a) * speed },
              0.16 + Math.random() * 0.14,
              '#78d9ff',
              1.4 + Math.random() * 1.6,
              true
            );
          }
          spawnParticle({ x, y }, { x: 0, y: 0 }, 0.05, '#ffffff', 4.4, true);
          spawnShockwave(x, y, { r: 5, maxR: 70, w: 2.4, maxLife: 0.35, color: 'rgba(110,200,255,' });
        }
    
    
    
    
        function handlePlayerDestroyed() {
          if (ship.destroyed) return;
          ship.destroyed = true;
          input.main = input.leftSide = input.rightSide = input.torque = 0;
          applyPlayerInput(ship, { controller: 'player', main: 0, thrustX: 0, thrustY: 0, leftSide: 0, rightSide: 0, torque: 0 }, input);
          ship.command = null;
          stopBoost();
          if (warp.state !== 'idle') {
            warp.state = 'idle';
            warp.charge = 0;
          }
    
          const reactorY = ship.pos.y + ship.h * 0.08;
          triggerReactorBlow3D(ship.pos.x, reactorY, ship.h * 0.35);
        }
    
        function applyDamageToPlayer(amount, opts = {}) {
          const bypassShield = !!opts?.bypassShield;
          const prevHull = ship.hull.val;
          if (!bypassShield && isEntityShieldBlocking(ship)) { const s = Math.min(ship.shield.val, amount); ship.shield.val -= s; amount -= s; ship.shield.regenTimer = ship.shield.regenDelay; }
          if (amount > 0) ship.hull.val = Math.max(0, ship.hull.val - amount);
          if (!ship.destroyed && prevHull > 0 && ship.hull.val <= 0) {
            handlePlayerDestroyed();
          }
        }
        window.applyDamageToPlayer = applyDamageToPlayer;
    
        // ── Critical Reactor Blow system ──────────────────────────────────────
        window.flyingHexDebris = [];
        let _critChainDepth = 0;
    
        function isFighterNPC(npc) {
          if (!npc) return false;
          if (npc.fighter) return true;
          const t = String(npc.type || '').toLowerCase();
          return t === 'fighter' || t === 'interceptor' || t === 'drone' ||
                 t === 'ally_fighter' || t === 'carrier_fighter';
        }
    
        function applyAoeExplosionDamage(pos, radius, baseDamage, sourceEntity) {
          const radiusSq = radius * radius;
          const prevDepth = _critChainDepth;
          _critChainDepth = prevDepth + 1;
          try {
            if (window.DEBUG_CRIT_BLOW) {
              console.log('[CritBlow AOE] pos=', pos.x | 0, pos.y | 0, 'radius=', radius | 0, 'baseDmg=', baseDamage | 0);
            }
            if (window.npcs) {
              for (const npc of window.npcs) {
                if (!npc || npc === sourceEntity || npc.dead) continue;
                if (npc.x === undefined || npc.y === undefined) continue;
                const dx = npc.x - pos.x, dy = npc.y - pos.y;
                const dSq = dx * dx + dy * dy;
                if (dSq >= radiusSq) continue;
                const t = 1 - Math.sqrt(dSq) / radius;
                const dmg = baseDamage * t;
                if (dmg > 0) applyDamageToNPC(npc, dmg, 'aoe_explosion', { bypassShield: false });
              }
            }
            if (ship && !ship.destroyed && ship.pos) {
              const dx = ship.pos.x - pos.x, dy = ship.pos.y - pos.y;
              const dSq = dx * dx + dy * dy;
              if (dSq < radiusSq) {
                const d = Math.sqrt(dSq);
                const t = 1 - d / radius;
                // Reactor blast is an impulse — part of it bypasses shields at close range.
                // Inside 40% of radius: half bypasses shield, half hits normally.
                const totalDmg = baseDamage * t * 0.65;
                const closeness = Math.max(0, 1 - d / (radius * 0.4));
                const bypassPart = totalDmg * (0.15 + closeness * 0.45); // 15..60% bypass
                const shieldPart = totalDmg - bypassPart;
                if (shieldPart > 0) applyDamageToPlayer(shieldPart, { bypassShield: false });
                if (bypassPart > 0) applyDamageToPlayer(bypassPart, { bypassShield: true });
                if (window.DEBUG_CRIT_BLOW) {
                  console.log('[CritBlow AOE] player hit dist=', d | 0, 'shield=', shieldPart | 0, 'hull=', bypassPart | 0);
                }
              }
            }
          } finally {
            _critChainDepth = prevDepth;
          }
        }
    
        function spawnFlyingHexDebris(entity, explosionPos, countOrShards, opts = null) {
          // Works with either wreck or npc (anything with hexGrid.shards + x/y/angle).
          const shards = entity?.hexGrid?.shards;
          if (!shards || shards.length === 0) return;
          const options = opts || {};
          const srcWidth  = entity.hexGrid.srcWidth  || 256;
          const srcHeight = entity.hexGrid.srcHeight || 256;
          const cx     = srcWidth * 0.5;
          const cy     = srcHeight * 0.5;
          const pivotX = entity.hexGrid.pivot?.x || 0;
          const pivotY = entity.hexGrid.pivot?.y || 0;
          const scaleX = entity.visual?.spriteScaleX || entity.visual?.spriteScale || 1;
          const scaleY = entity.visual?.spriteScaleY || entity.visual?.spriteScale || 1;
          const ang  = (entity.angle || 0) + (entity.visual?.spriteRotation || 0);
          const cosA = Math.cos(ang), sinA = Math.sin(ang);
          const hexWorldR = 9 * Math.max(scaleX, scaleY);
          const entX = (entity.x !== undefined) ? entity.x : (entity.pos?.x || 0);
          const entY = (entity.y !== undefined) ? entity.y : (entity.pos?.y || 0);
          const entVX = entity.vx || entity.vel?.x || 0;
          const entVY = entity.vy || entity.vel?.y || 0;
    
          // Prefer edge shards (fewer neighbors) for a punchier "chunks fly off" look
          const suppliedShards = Array.isArray(countOrShards) ? countOrShards : null;
          const eligible = (suppliedShards || shards).filter(s => s && s.active !== false && !s.isDebris && Number.isFinite(s.gridX));
          if (eligible.length === 0) return;
          if (!suppliedShards) {
            // Shuffle for variety
            for (let i = eligible.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [eligible[i], eligible[j]] = [eligible[j], eligible[i]];
            }
          }
          const pick = Math.min(suppliedShards ? eligible.length : Math.max(0, countOrShards | 0), eligible.length);
          const speedMin = Math.max(120, Number(options.speedMin) || 260);
          const speedMax = Math.max(speedMin, Number(options.speedMax) || 820);
          const lateralJitter = Math.max(0, Number(options.lateralJitter) || 140);
          const tangentialKick = Math.max(0, Number(options.tangentialKick) || 0);
          const radiusMul = Math.max(0.4, Number(options.radiusMul) || 1);
          const lifeMin = Math.max(0.6, Number(options.lifeMin) || 2.4);
          const lifeMax = Math.max(0, Number(options.lifeMax) || 2.6);
          const angVelMul = Math.max(0.1, Number(options.angVelMul) || 1);
          for (let i = 0; i < pick && window.flyingHexDebris.length < 512; i++) {
            const shard = eligible[i];
            const relX = (shard.gridX - cx - pivotX) * scaleX;
            const relY = (shard.gridY - cy - pivotY) * scaleY;
            const wx = entX + relX * cosA - relY * sinA;
            const wy = entY + relX * sinA + relY * cosA;
            let toX = wx - explosionPos.x, toY = wy - explosionPos.y;
            let dist = Math.hypot(toX, toY);
            if (dist < 0.001) {
              // Shard sits on epicenter — give it a random outward vector
              const a = Math.random() * Math.PI * 2;
              toX = Math.cos(a); toY = Math.sin(a); dist = 1;
            }
            const nx = toX / dist;
            const ny = toY / dist;
            const tx = -ny;
            const ty = nx;
            const speed = speedMin + Math.random() * (speedMax - speedMin);
            const tangent = (Math.random() - 0.5) * tangentialKick;
            window.flyingHexDebris.push({
              x: wx, y: wy,
              vx: entVX + nx * speed + tx * tangent + (Math.random() - 0.5) * lateralJitter,
              vy: entVY + ny * speed + ty * tangent + (Math.random() - 0.5) * lateralJitter,
              angle: Math.random() * Math.PI * 2,
              angVel: (Math.random() - 0.5) * 0.35 * angVelMul,
              life: 1.0,
              lifetime: lifeMin + Math.random() * lifeMax,
              hexR: hexWorldR * radiusMul * (0.7 + Math.random() * 0.6),
            });
          }
        }
    
        function updateFlyingHexDebris(dt) {
          const debris = window.flyingHexDebris;
          // Tłumienie strojone na krok 1/120 s (patrz stepDecay120 / ?physHz).
          const drag = stepDecay120(0.991, dt);
          for (let i = debris.length - 1; i >= 0; i--) {
            const d = debris[i];
            d.x += d.vx * dt;
            d.y += d.vy * dt;
            d.vx *= drag;
            d.vy *= drag;
            d.angle += d.angVel * dt;
            d.life -= dt / d.lifetime;
            if (d.life <= 0) debris.splice(i, 1);
          }
        }
    
        function drawFlyingHexDebris(ctx, cam) {
          const debris = window.flyingHexDebris;
          if (!debris || debris.length === 0) return;
          ctx.save();
          for (const d of debris) {
            const alpha = Math.max(0, d.life * d.life);
            if (alpha < 0.01) continue;
            const s = worldToScreen(d.x, d.y, cam);
            const screenR = d.hexR * cam.zoom;
            if (screenR < 0.3) continue;
            ctx.save();
            ctx.translate(s.x, s.y);
            ctx.rotate(d.angle);
            ctx.globalAlpha = alpha;
            const heatT = Math.max(0, Math.min(1, d.life * 2 - 0.3));
            const r = Math.round(70 + heatT * 185);
            const g = Math.round(80 + heatT * 70);
            const b = Math.round(100 - heatT * 55);
            ctx.fillStyle = `rgb(${r},${g},${b})`;
            ctx.beginPath();
            for (let i = 0; i < 6; i++) {
              const a = (i / 6) * Math.PI * 2;
              if (i === 0) ctx.moveTo(Math.cos(a) * screenR, Math.sin(a) * screenR);
              else ctx.lineTo(Math.cos(a) * screenR, Math.sin(a) * screenR);
            }
            ctx.closePath();
            ctx.fill();
            ctx.strokeStyle = `rgba(0,0,0,${0.5 * alpha})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
            ctx.restore();
          }
          ctx.restore();
        }
        window.drawFlyingHexDebris = drawFlyingHexDebris;
    
        function pickReactorBlowDebrisShards(entity, sourceShards, desiredCount) {
          if (!entity?.hexGrid || !Array.isArray(sourceShards) || desiredCount <= 0) return [];
          const srcWidth = entity.hexGrid.srcWidth || 256;
          const srcHeight = entity.hexGrid.srcHeight || 256;
          const centerX = srcWidth * 0.5 + (entity.hexGrid.pivot?.x || 0);
          const centerY = srcHeight * 0.5 + (entity.hexGrid.pivot?.y || 0);
          const sourceSet = new Set(sourceShards);
          const candidates = [];
          let maxRadiusSq = 1;
          for (const shard of sourceShards) {
            if (!shard || shard.active === false || shard.isDebris) continue;
            const localX = (Number(shard.gridX) || 0) + (Number(shard.deformation?.x) || 0) - centerX;
            const localY = (Number(shard.gridY) || 0) + (Number(shard.deformation?.y) || 0) - centerY;
            const radiusSq = localX * localX + localY * localY;
            if (radiusSq > maxRadiusSq) maxRadiusSq = radiusSq;
            let linkedNeighbors = 0;
            for (const neighbor of shard.neighbors || []) {
              if (!neighbor || neighbor.active === false || neighbor.isDebris) continue;
              if (sourceSet.has(neighbor)) linkedNeighbors++;
            }
            candidates.push({
              shard,
              radiusSq,
              edgeScore: Math.max(0, 6 - linkedNeighbors),
              jitter: Math.random()
            });
          }
          candidates.sort((a, b) => {
            const aScore = (a.radiusSq / maxRadiusSq) * 1.15 + a.edgeScore * 0.55 + a.jitter * 0.18;
            const bScore = (b.radiusSq / maxRadiusSq) * 1.15 + b.edgeScore * 0.55 + b.jitter * 0.18;
            return bScore - aScore;
          });
          const picked = [];
          for (let i = 0; i < candidates.length && picked.length < desiredCount; i++) {
            picked.push(candidates[i].shard);
          }
          return picked;
        }
    
        function buildReactorBlowFragmentGroups(entity, sourceShards, desiredCount) {
          if (!entity?.hexGrid || !Array.isArray(sourceShards) || sourceShards.length < 3) return [];
          const groupCount = Math.max(1, desiredCount | 0);
          const srcWidth = entity.hexGrid.srcWidth || 256;
          const srcHeight = entity.hexGrid.srcHeight || 256;
          const centerX = srcWidth * 0.5 + (entity.hexGrid.pivot?.x || 0);
          const centerY = srcHeight * 0.5 + (entity.hexGrid.pivot?.y || 0);
          const angleOffset = Math.random() * Math.PI * 2;
          const sectorSize = (Math.PI * 2) / groupCount;
          const buckets = Array.from({ length: groupCount }, () => []);
          for (const shard of sourceShards) {
            if (!shard) continue;
            const localX = (Number(shard.gridX) || 0) + (Number(shard.deformation?.x) || 0) - centerX;
            const localY = (Number(shard.gridY) || 0) + (Number(shard.deformation?.y) || 0) - centerY;
            let ang = Math.atan2(localY, localX) - angleOffset;
            ang = ((ang % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
            const idx = Math.min(groupCount - 1, Math.floor(ang / sectorSize));
            buckets[idx].push(shard);
          }
    
          const viable = [];
          const leftovers = [];
          const minGroupSize = Math.max(3, Math.min(8, Math.floor(sourceShards.length * 0.14)));
          for (const bucket of buckets) {
            if (bucket.length >= minGroupSize || (groupCount === 1 && bucket.length >= 3)) viable.push(bucket);
            else leftovers.push(...bucket);
          }
          if (viable.length === 0) {
            return sourceShards.length >= 3 ? [sourceShards.slice()] : [];
          }
          let cursor = 0;
          for (const shard of leftovers) {
            viable[cursor].push(shard);
            cursor = (cursor + 1) % viable.length;
          }
          return viable.filter(group => group.length >= 3);
        }
    
        function spawnReactorBlowBreakup(entity, sourceShards, explosionPos, severity = 0) {
          if (!entity?.hexGrid || !DestructorSystem?.spawnWreckEntity) {
            if (window.DEBUG_CRIT_BLOW) console.warn('[CritBlow breakup] aborted: missing entity/hexGrid/Destructor');
            return { fragments: 0, debris: 0 };
          }
    
          const eligible = Array.isArray(sourceShards)
            ? sourceShards.filter(s => s && s.active !== false && !s.isDebris && (s.hp == null || s.hp > 0))
            : [];
          if (eligible.length === 0) return { fragments: 0, debris: 0 };
    
          const severityClamped = Math.max(0, Math.min(1.4, Number(severity) || 0));
          let fragCount = 2;
          if (eligible.length >= 18) fragCount++;
          if (eligible.length >= 36) fragCount++;
          if (eligible.length >= 54 && severityClamped > 0.95) fragCount++;
          const minFragmentShards = 4;
          fragCount = Math.max(1, Math.min(fragCount, Math.floor(eligible.length / minFragmentShards) || 1));
    
          let debrisCount = Math.floor(eligible.length * (0.22 + Math.min(0.28, severityClamped * 0.20)));
          debrisCount = eligible.length >= 20 ? Math.max(debrisCount, 10) : Math.max(debrisCount, 4);
          const maxDebrisCount = Math.max(0, eligible.length - fragCount * minFragmentShards);
          debrisCount = Math.min(debrisCount, maxDebrisCount);
    
          const debrisShards = debrisCount > 0
            ? pickReactorBlowDebrisShards(entity, eligible, debrisCount)
            : [];
          const debrisSet = new Set(debrisShards);
          const fragmentSource = eligible.filter(shard => !debrisSet.has(shard));
          const groups = buildReactorBlowFragmentGroups(entity, fragmentSource, fragCount);
          const wrecksArr = Array.isArray(window.wrecks) ? window.wrecks : null;
          const prevCount = wrecksArr ? wrecksArr.length : 0;
    
          for (const group of groups) {
            if (group.length < 3) continue;
            try { DestructorSystem.spawnWreckEntity(entity, group, null); }
            catch (_) {}
          }
    
          const createdCount = wrecksArr ? Math.max(0, wrecksArr.length - prevCount) : 0;
          const speedMul = 1 + Math.min(0.8, severityClamped * 0.55);
          if (wrecksArr) {
            for (let i = prevCount; i < wrecksArr.length; i++) {
              const sw = wrecksArr[i];
              if (!sw) continue;
              const dx = sw.x - explosionPos.x;
              const dy = sw.y - explosionPos.y;
              const dist = Math.hypot(dx, dy) || 1;
              const nx = dx / dist;
              const ny = dy / dist;
              const tx = -ny;
              const ty = nx;
              const radialSpeed = (150 + Math.random() * 180) * speedMul;
              const tangentialSpeed = (Math.random() - 0.5) * 220 * speedMul;
              sw.vx = (sw.vx || 0) + nx * radialSpeed + tx * tangentialSpeed;
              sw.vy = (sw.vy || 0) + ny * radialSpeed + ty * tangentialSpeed;
              sw.angVel = (sw.angVel || 0) + (Math.random() - 0.5) * 0.42 * speedMul;
            }
          }
    
          const debrisSource = createdCount > 0
            ? debrisShards
            : eligible;
          if (debrisSource.length > 0) {
            spawnFlyingHexDebris(entity, explosionPos, debrisSource, {
              speedMin: 420,
              speedMax: 980,
              lateralJitter: 180,
              tangentialKick: 240,
              radiusMul: 1.08,
              lifeMin: 2.8,
              lifeMax: 3.4,
              angVelMul: 1.35
            });
          }
    
          if (window.DEBUG_CRIT_BLOW) {
            console.log('[CritBlow breakup] eligible=' + eligible.length + ', fragments=' + createdCount + ', debris=' + debrisSource.length);
          }
          return { fragments: createdCount, debris: debrisSource.length };
        }
    
        function releaseNpcHexBody(npc) {
          if (!npc?.hexGrid) return;
          if (invalidateHexShipEntity3D) {
            try { invalidateHexShipEntity3D(npc); } catch (_) {}
          }
          disposeHexBody(npc);
          npc.hexGrid = null;
        }
    
        // Martwy NPC misji, po którym wrak już powstał (ciało heksowe zwolnione
        // przez releaseNpcHexBody). Nic go nie ożywi — odradzają się tylko cywile
        // (gałąź respawnTimer w npcStep), a frachtowce ładunku sprząta ich rekord.
        function isFinishedMissionNpc(npc) {
          return npc.dead === true
            && npc.mission === true
            && npc !== ship
            && !npc.isCargoVan
            && !npc.hexGrid
            && !isBridgeHulk(npc);
        }
    
        // SQUADS i SupportWing same odfiltrowują martwych; zaznaczenie RTS nie.
        function forgetPurgedNpc(npc) {
          Selection.units.delete(npc);
        }
    
        // Dobor profilu wybuchu reaktora po wielkosci kadluba. Do tej pory kazdy
        // nie-mysliwiec dostawal `capital`, czyli 4000 iskier i 3 s efektu — tyle samo
        // dla fregaty (promien 120) co dla superkapitala (500). W bitwie gina glownie
        // fregaty i niszczyciele, wiec to one generowaly wiekszosc kosztu.
        // Progi wynikaja z src/data/ships.js: fregata 120, niszczyciel 170,
        // pancernik 220, lotniskowiec 320, superkapital 500, megafrachtowiec 760.
        const REACTOR_BLOW_PROFILE_BY_RADIUS = Object.freeze([
          { minRadius: 210, profile: 'capital' },
          { minRadius: 150, profile: 'cruiser' },
          { minRadius: 0,   profile: 'escort'  }
        ]);
    
        function resolveReactorBlowProfile(npc) {
          const radius = Number(npc?.radius) || 0;
          for (const tier of REACTOR_BLOW_PROFILE_BY_RADIUS) {
            if (radius >= tier.minRadius) return tier.profile;
          }
          return 'escort';
        }
    
        function tryTriggerCriticalReactorBlow(npc, overkillDmg, aliveRatio, survivingShards, chainDepth) {
          if (isFighterNPC(npc)) {
            if (window.DEBUG_CRIT_BLOW) console.log('[CritBlow] skip fighter', npc?.type);
            return false;
          }
          if (chainDepth > 1) return false;
          const maxHull = Math.max(1, Number(npc.maxHp) || 100);
          const overkillRatio = Math.max(0, Number(overkillDmg) || 0) / maxHull;
          const aliveRatioClamped = Math.max(0, Math.min(1, Number(aliveRatio) || 0));
          // Severity metric: take the bigger signal of
          //   (a) big burst HP overkill (bulk damage weapon finishing the ship),
          //   (b) many hexes still alive at death (fast burst kill via hex damage)
          const severity = Math.max(overkillRatio, aliveRatioClamped);
          const severityGate = chainDepth > 0 ? 0.72 : 0.48;
          if (severity < severityGate) return false;
          const normalizedSeverity = Math.max(0, Math.min(1, (severity - severityGate) / Math.max(0.0001, 1 - severityGate)));
          const critChance = Math.min(0.26 + normalizedSeverity * 0.52, 0.78);
          const roll = Math.random();
          if (window.DEBUG_CRIT_BLOW) {
            console.log('[CritBlow] try',
              'type=' + (npc.type || '?'),
              'overkill=' + overkillDmg?.toFixed?.(1),
              'maxHp=' + maxHull,
              'overkillRatio=' + overkillRatio.toFixed(3),
              'aliveRatio=' + aliveRatioClamped.toFixed(3),
              'severity=' + severity.toFixed(3),
              'chance=' + critChance.toFixed(3),
              'roll=' + roll.toFixed(3),
              'surviving=' + (survivingShards?.length || 0),
              'chainDepth=' + chainDepth);
          }
          if (roll > critChance) return false;
    
          const posX = npc.x, posY = npc.y;
          const size = (npc.radius || 40) * 1.5;
          try { triggerReactorBlow3D(posX, posY, size * 1.8, { profile: resolveReactorBlowProfile(npc) }); } catch (_) {}
    
          if (chainDepth === 0) {
            const aoeR = Math.max(700, (npc.radius || 40) * 6);
            const aoeDmg = Math.max(60, maxHull * 0.45);
            applyAoeExplosionDamage({ x: posX, y: posY }, aoeR, aoeDmg, npc);
          }
    
          // Screen shake for feedback when near epicenter
          if (typeof camera !== 'undefined' && camera.addShake && ship && !ship.destroyed) {
            const dx = (ship.pos?.x || 0) - posX, dy = (ship.pos?.y || 0) - posY;
            const d = Math.hypot(dx, dy);
            const shakeR = (npc.radius || 40) * 10;
            if (d < shakeR) {
              const k = 1 - d / shakeR;
              camera.addShake(6 * k, 0.55);
            }
          }
    
          // Critical blow turns surviving structure into a few heavy fragments plus a cloud of single hexes.
          const explPos = { x: posX, y: posY };
          const sourceShards = survivingShards?.length
            ? survivingShards
            : (npc.hexGrid?.shards || []);
          spawnReactorBlowBreakup(npc, sourceShards, explPos, severity);
          return true;
        }
        // ─────────────────────────────────────────────────────────────────────
    
        // Koniec agonii hulka po utracie mostka: wrak BEZ losowego wybuchu reaktora
        // (tryTriggerCriticalReactorBlow) — „czysty kill”, kadłub zostaje łupem.
        // Zasługę za kill policzył już onBridgeCommandLost.
        function finishBridgeKill(npc) {
          if (!npc || npc.dead) return;
          npc.dead = true;
          npc.hp = 0;
          npc.respawnTimer = 3 + Math.random() * 6;
          if (npc.fleetEntry?.status) npc.fleetEntry.status.hull = 0;
          const shards = npc.hexGrid?.shards;
          const survivingShards = Array.isArray(shards) ? shards.filter(s => s.active && !s.isDebris && s.hp > 0) : [];
          if ((survivingShards.length > 3 || (npc.isCargoVan && survivingShards.length > 0)) && window.createWreckage) {
            window.createWreckage(npc, survivingShards);
          }
          if (npc.isCargoVan) handleCargoVanDestroyed(npc);
          releaseShipBridges(npc);
          releaseNpcHexBody(npc);
        }
    
        function applyDamageToNPC(npc, dmg, cause = 'default', opts = {}) {
          if (npc.dead) return;
          // Hulk po utracie mostka już nie żyje — pula (i crit) nie gra roli.
          if (isBridgeHulk(npc)) return;
          if (!Number.isFinite(dmg) || dmg <= 0) return;
          // Cargo może umrzeć dopiero, gdy istnieje geometria zdolna utworzyć realny wrak.
          // Do tego czasu rekord nadal leci, a encja jest wyłącznie niewrażliwym widokiem.
          if (npc.isCargoVan && (!npc.hexGrid || !Array.isArray(npc.hexGrid.shards) || npc.hexGrid.shards.length === 0)) return;
          const bypassShield = !!opts?.bypassShield;
          npc.hitFlash = 0.12;
          npc.damageHue = (npc.damageHue || 0) + dmg;
    
          let remaining = dmg;
          if (!bypassShield && isEntityShieldBlocking(npc)) {
            npc.shield.regenTimer = npc.shield.regenDelay ?? 0;
            const absorbed = Math.min(npc.shield.val, remaining);
            if (absorbed > 0) {
              npc.shield.val -= absorbed;
              remaining -= absorbed;
              if (npc.fleetEntry) {
                npc.fleetEntry.status.shield = npc.shield.val;
              }
            }
          }
    
          if (remaining <= 0) {
            return;
          }
    
          npc.hp -= remaining;
          if (npc.fleetEntry) {
            npc.fleetEntry.status.hull = npc.hp;
          }
          if (npc.hp <= 0) {
            npc.dead = true;
            npc.respawnTimer = 3 + Math.random() * 6;
            registerFactionKill(npc);
            const overkillDmg = -npc.hp; // hp is negative here
            const npcType = String(npc.type || '').toLowerCase();
            const isFighterLike =
              !!npc.fighter ||
              npcType === 'fighter' ||
              npcType === 'interceptor' ||
              npcType === 'drone' ||
              npcType === 'ally_fighter' ||
              npcType === 'carrier_fighter';
    
            // Measure hex alive ratio BEFORE creating wreckage / destructor cleanup,
            // so "many hexes alive = fast burst kill" can drive critical severity
