        const CAPITAL_SHIP_TEMPLATES = CAPITAL_SHIP_TEMPLATES_DATA;
    
        Fleet.templates = Object.assign(Fleet.templates || {}, { capital: CAPITAL_SHIP_TEMPLATES });
    
        function addFleetShip(entry) {
          if (!entry || !entry.entity) return null;
