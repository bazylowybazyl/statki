              const local = rotateInv({ x: mw.x - ship.pos.x, y: mw.y - ship.pos.y }, ship.angle);
              const side = (local.y >= 0) ? 'right' : 'left';
              if (rocketCooldown <= 0 && fireRocket(side)) rocketCooldown = ROCKET_FIRE_INTERVAL;
