              if (candidateT < 0 || candidateT >= hitT) continue;
    
              hitT = candidateT;
              hitNPC = npc;
              didHitShield = candidateShield;
              didHitHex = !candidateShield && hullIsHex;
              hitHexShard = didHitHex ? hullShard : null;
              hitX = candidateImpactX;
              hitY = candidateImpactY;
            }
    
            if (hitNPC) {
              // Flak trafiony bezpośrednio (np. w tarczę, zanim zadziałał zapalnik)
              // i tak pęka — obrażenia rozchodzą się jako odłamki, nie jako trafienie.
              if (b.type === 'flak' && b.flakBurstRadius) {
                b.x = hitX;
                b.y = hitY;
