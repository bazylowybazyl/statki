            updateFighterLaunchQueue(aiLogicDt);
            updateSupportWing(aiLogicDt);
            aiSupportWingMs = performance.now() - tAiSection0;
            PerfHUD.addTiming('aiSupportWingTime', aiSupportWingMs);
            if (aiDbgEnabled) AILiveDebug.record('supportWing', aiSupportWingMs);
          }
    
          const tNpcStep0 = performance.now();
          // Każdy podkrok obsługuje jeden kubełek mózgów, więc liczniki zerujemy
          // przed każdym npcStep. Grid/koordynator nadal odświeżają się tylko 20 Hz.
          window.__aiSepMs = 0;
          window.__aiWeaponScanMs = 0;
          window.__aiTargetPickMs = 0;
          window.__aiGridMs = 0;
          window.__aiNpcEnemyBrainMs = 0;
          window.__aiNpcFriendlyBrainMs = 0;
          npcStep(dt, aiDbgEnabled ? AILiveDebug : null, runAiLogic, aiLogicDt, aiBrainPhase, aiBrainPhaseCount);
          const npcStepMs = performance.now() - tNpcStep0;
          // Ograniczenia holownicze rozwiązujemy po integracji wszystkich ruchomych
          // ciał, ale przed pociskami i destruktorem. Dzięki temu kontakt i damage
