          for (const npc of npcs) {
            if (npc.mission && npc.isPirate && !npc.dead) {
              if (npc.state === 'warping_in') continue;
              npc.state = 'engage_formation';
              npc.guardStation = null;
              npc.forceTarget = null;
              npc.target = null;
            }
          }
    
          if (mercMission.swarm) {
            mercMission.swarm.active = true;
            if (!mercMission.swarm.queue || !mercMission.swarm.queue.length) resetSwarmQueue();
            if (!mercMission.swarm.timer || mercMission.swarm.timer > 1.2) mercMission.swarm.timer = 1.2;
          }
        }
    
    
        // =============== Rail (Kolejka strzałów gracza) ===============
        const RAIL_SPEED = 2600;
    
        rail = {
          cd: [0, 0],
          cdMax: 0.15,
          shotGap: 0.08,
          burstGap: 0.2,
          burstsPerClick: 1,
          barrelsPerShot: 2,
          queue: [],
          nextStart: 0,
          behaviorId: 'default',
        };
        railTimer = 0;
    
        rebuildHardpointsForFrame();
        loadLoadout();
    
        function triggerRailVolley() {
          const mainWeapons = Game.player.weapons?.[HP.MAIN];
          if (!mainWeapons || !mainWeapons.length) return;
          if (rail.queue.length) return;
          const start = rail.nextStart;
          rail.nextStart ^= 1;
          const barrels = Math.max(1, rail.barrelsPerShot || 2);
          const orderPair = barrels === 1 ? [start] : [start, 1 - start];
          for (let b = 0; b < rail.burstsPerClick; b++) {
            const baseDelay = b * (orderPair.length * rail.shotGap + rail.burstGap);
            for (let idx = 0; idx < orderPair.length; idx++) {
              const barrelBaseTime = baseDelay + idx * rail.shotGap;
              for (let w = 0; w < mainWeapons.length; w++) {
                const jitter = Math.random() * 0.12;
                rail.queue.push({
                  timer: barrelBaseTime + jitter,
                  barrel: orderPair[idx],
                  weaponIndex: w,
                  ignoreCD: true
                });
              }
            }
          }
        }
        function fireRailBarrel(barIndex, specificWeaponIdx = -1) {
          const mainWeapons = Game.player.weapons?.[HP.MAIN] || [];
          if (!mainWeapons.length) return;
    
          if (!p1WeaponCtrl) return;
          let maxCooldown = 0;
    
          for (let i = 0; i < mainWeapons.length; i++) {
            if (specificWeaponIdx !== -1 && i !== specificWeaponIdx) continue;
    
            const weaponData = mainWeapons[i]?.weapon;
            if (!weaponData) continue;
    
            if (!mainWeapons[i].hp) continue;
            const aim = getMountedWeaponAim(ship, mainWeapons[i]);
    
            // Określamy liczbę luf na podstawie rozmiaru nowej broni
            const barrelsPerShot = Number.isFinite(Number(weaponData.barrelsPerShot))
              ? Math.max(1, Math.round(Number(weaponData.barrelsPerShot)))
              : (weaponData.size === 'L' ? 1 : 2);
            const muzzle = p1WeaponCtrl.computeMountedMuzzle(mainWeapons[i], barIndex);
            const baseEmitterUid = `p_main_${i}_${weaponData.id || 'x'}`;
            muzzle.emitterUid = barrelsPerShot > 1 ? `${baseEmitterUid}:b${barIndex}` : baseEmitterUid;
    
            const targetToPass = isTargetAlive(aim.target) ? aim.target : null;
            if (mainAutoFire && lockedTargets.length && !targetToPass) continue;
            const cd = window.fireWeaponCore(ship, targetToPass, weaponData.id, muzzle);
    
            // Efekty wizualne wystrzału (Muzzle flash) z lufy gracza
            // Armata i Tempest Ion mają własny błysk 3D z dema
            // (src/3d/muzzleFx3D.js) — kanwowy rozbłysk pod nim to druga
            // warstwa tego samego efektu w tym samym punkcie.
            if (weaponData.category !== 'beam' && !MuzzleFX3D.handles(weaponData.id)) {
              const isHeavyWeapon = (weaponData.size === 'L' || weaponData.size === 'Capital');
              const muzzleScale = isHeavyWeapon ? 1.8 : 1.0;
              if (weaponData.category === 'torpedo') {
                // Torpedo launch: smoke + directional flame
                CanvasVFX.spawnArmataMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale * 1.5);
              } else if (weaponData.category === 'superweapon' || weaponData.id === 'siege_railgun') {
                // Siege railgun: massive rail flash + screen shake handled elsewhere
                CanvasVFX.spawnRailMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale * 2.0);
              } else if (weaponData.category === 'armata' || weaponData.category === 'plasma') {
                CanvasVFX.spawnArmataMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale);
              } else if (weaponData.category === 'autocannon') {
                CanvasVFX.spawnAutocannonMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale);
              } else {
                CanvasVFX.spawnRailMuzzle(muzzle.pos, muzzle.dir, ship.vel, muzzleScale);
              }
            }
    
            maxCooldown = Math.max(maxCooldown, cd || rail.cdMax);
          }
    
          rail.cd[barIndex] = maxCooldown || rail.cdMax;
        }
    
        // =============== CIWS (point-defence) ===============
        const CIWS_FIRE_INTERVAL = 0.06;
        const CIWS_BULLET_SPEED = 900;
        const CIWS_DAMAGE = 8;
        const CIWS_RANGE = 600;
    
        const LASER_PD_FIRE_INTERVAL = 0.18;
        const LASER_PD_DAMAGE = 16;
        const LASER_PD_RANGE = 620;
        const LASER_PD_BEAM_WIDTH = 6;
    
        // Wspólny bufor wrogich rakiet/torped na bieżący krok fizyki. Budowany raz
        // w ciwsStep, używany przez działka PD oraz przez intercept CIWS w
        // bulletsAndCollisionsStep (zamiast skanowania całej tablicy bullets per pocisk).
        const _pdEnemyRocketBuffer = [];
        const _pdPlayerRocketBuffer = [];
        // Capital AI czyta te same bufory zamiast skanować całą tablicę bullets
        // osobno dla każdego statku i każdej baterii point-defence.
        window.__npcRocketThreats = _pdEnemyRocketBuffer;
        window.__playerRocketThreats = _pdPlayerRocketBuffer;
    
        function ciwsStep(dt) {
          _pdEnemyRocketBuffer.length = 0;
          _pdPlayerRocketBuffer.length = 0;
          for (let bi = 0; bi < bullets.length; bi++) {
            const rb = bullets[bi];
            if (!rb || rb.life <= 0) continue;
            if (rb.type !== 'rocket' && rb.type !== 'torpedo') continue;
            if (rb.owner === 'player' || rb.owner === 'player2') {
              _pdPlayerRocketBuffer.push(rb);
            } else {
              _pdEnemyRocketBuffer.push(rb);
            }
          }
          const auxWeapons = Game.player.weapons?.[HP.AUX] || [];
          // Bez PD CHIP-a obrona punktowa gracza strzela tylko do rakiet i myśliwców.
          const pdHullsAllowed = hasShipChip(ship, PD_CHIP_ID);
          for (let i = 0; i < ship.ciws.length; i++) {
            if (i >= auxWeapons.length) break;
            const loadout = auxWeapons[i];
            if (!loadout || !loadout.weapon) continue;
            const wDef = loadout.weapon;
            const weaponId = wDef.id;
            const pdDef = wDef.aispacePdId ? AISPACE_PD[wDef.aispacePdId] : null;
            const isFlak = isFlakWeapon(wDef);
            const isLaser = weaponId === 'laser_pd_mk1' || wDef.aispacePdId === 'pd_laser';
            const stats = pdDef;
            const gun = ship.ciws[i];
            gun.cd = Math.max(0, gun.cd - dt);
            const off = rotate(gun.offset, ship.angle);
            const base = { x: ship.pos.x + off.x, y: ship.pos.y + off.y };
            const baseVel = { x: ship.vel.x - ship.angVel * off.y, y: ship.vel.y + ship.angVel * off.x };
    
            // Zasięg z definicji broni, nie z hardcoded stałych
            const range = stats?.range || wDef.baseRange || (isLaser ? LASER_PD_RANGE : CIWS_RANGE);
            const bulletSpeed = stats?.speed || wDef.baseSpeed || CIWS_BULLET_SPEED;
    
            let target = null;
            let bestDistSq = range * range;
    
            // Priorytet 1: rakiety/torpedy wroga w zasięgu (intercept) — z bufora,
            // porównania na kwadratach dystansu (bez Math.hypot per pocisk).
            for (let bi = 0; bi < _pdEnemyRocketBuffer.length; bi++) {
              const rb = _pdEnemyRocketBuffer[bi];
              if (rb.life <= 0) continue;
              const ddx = rb.x - base.x, ddy = rb.y - base.y;
              const d2 = ddx * ddx + ddy * ddy;
              if (d2 < bestDistSq) { bestDistSq = d2; target = rb; }
            }
    
            // Priorytet 2: myśliwce. Każde PD szuka najpierw SAMYCH myśliwców —
            // flakowi pancerz okrętu zjada ~85% odłamków, a CIWS/laser robi
            // w kadłub 20% obrażeń, więc klucz myśliwców wchodzący na burtę jest
            // zawsze ważniejszy niż najbliższy kadłub.
            if (!target) {
              for (const npc of npcs) {
                if (npc.dead || npc.friendly || !npc.isPirate) continue;
                if (!isFighterNPC(npc)) continue;
                const ddx = npc.x - base.x, ddy = npc.y - base.y;
                const d2 = ddx * ddx + ddy * ddy;
                if (d2 < bestDistSq) { bestDistSq = d2; target = npc; }
              }
            }
            // Priorytet 3: dowolny piracki kadłub — tylko z PD CHIP-em.
            if (!target && pdHullsAllowed) {
              for (const npc of npcs) {
                if (npc.dead || npc.friendly || !npc.isPirate) continue;
                const ddx = npc.x - base.x, ddy = npc.y - base.y;
                const d2 = ddx * ddx + ddy * ddy;
                if (d2 < bestDistSq) { bestDistSq = d2; target = npc; }
              }
            }
            if (!target) continue;
            const dist = Math.sqrt(bestDistSq);
    
            const isRocketTarget = target.type === 'rocket' || target.type === 'torpedo';
    
            // Lead targeting z prędkością z definicji broni
            const aimPoint = isLaser ? { x: target.x, y: target.y }
              : leadTarget(base, baseVel, target, bulletSpeed);
            let desired = Math.atan2(aimPoint.y - base.y, aimPoint.x - base.x);
    
            // --- Barrage sweep: CIWS oscyluje po łuku wokół celu ---
            // Flak nie omiata: chmura odłamków ma promień dziesiątek metrów,
            // rozrzut robi za niego `spread` salwy przy wystrzale.
            if (!isLaser && !isFlak) {
              if (gun._sweepPhase == null) gun._sweepPhase = Math.random() * Math.PI * 2;
              gun._sweepPhase += dt * 7.5;
              const sweepArc = 0.18 * Math.max(0.3, 1.0 - dist / range);
              desired += Math.sin(gun._sweepPhase) * sweepArc;
            }
    
            let diff = wrapAngle(desired - gun.angle);
            // Flak to ciężka, wolno obracająca się wieża — celuje spokojniej niż CIWS.
            const aimStrength = isLaser ? 9 : (isFlak ? 6 : 10);
            const maxVel = isLaser ? 6.5 : (isFlak ? 3.4 : 8);
            let desiredVel = clamp(diff * aimStrength, -maxVel, maxVel);
            const velDelta = desiredVel - gun.angVel;
            const maxDelta = 50 * dt;
            gun.angVel += clamp(velDelta, -maxDelta, maxDelta);
            gun.angVel *= Math.exp(-6 * dt);
            gun.angVel = clamp(gun.angVel, -maxVel, maxVel);
            gun.angle = wrapAngle(gun.angle + gun.angVel * dt);
    
            // CIWS ma luźniejszą tolerancję — strzela w trakcie sweep
            const aimTolerance = isLaser ? 0.1 : (isFlak ? 0.12 : 0.35);
            if (Math.abs(diff) >= aimTolerance || gun.cd > 0) continue;
    
            const fireInterval = stats?.rps ? (1 / stats.rps) : (wDef.cooldown || (isLaser ? LASER_PD_FIRE_INTERVAL : CIWS_FIRE_INTERVAL));
            if (isFlak) {
              fireFlakSalvo(gun, base, baseVel, target, wDef, fireInterval);
            } else if (isLaser) {
              if (isRocketTarget) {
                // Laser niszczy rakietę natychmiast
                const rIdx = bullets.indexOf(target);
                if (rIdx !== -1) {
                  spawnBulletImpactEffect(target, target.x, target.y, 1.2);
                  spawnPointDefenseLaserHit(target.x, target.y);
                  const lDir = { x: Math.cos(gun.angle), y: Math.sin(gun.angle) };
                  const lMuz = { x: base.x + lDir.x * 6, y: base.y + lDir.y * 6 };
                  spawnLaserBeam(lMuz, { x: target.x, y: target.y }, LASER_PD_BEAM_WIDTH, {
                    life: 0.09, colorOuter: stats?.color || 'rgba(110,200,255,0.9)',
                    colorInner: 'rgba(250,255,255,1.0)', glowColor: stats?.color || 'rgba(90,180,255,0.95)',
                    glowBlur: 22, outerWidthMul: 1.05, innerWidthMul: 0.45
                  });
                  spawnPointDefenseLaserMuzzle(lMuz, lDir, baseVel);
                  target.life = -1; // znika też z _pdEnemyRocketBuffer (checki life<=0)
                  removeBulletAt(rIdx);
                }
                gun.cd = fireInterval;
              } else {
                firePointDefenseLaser(gun, base, baseVel, target, pdDef, fireInterval);
              }
            } else {
              fireCIWSGun(gun, base, baseVel, wDef, fireInterval);
            }
          }
        }
    
        function fireCIWSGun(gun, base, baseVel, wDef, fireInterval) {
          const spread = wDef?.spread || 0.05;
          const shotAngle = gun.angle + (Math.random() - 0.5) * spread;
          const dir = { x: Math.cos(shotAngle), y: Math.sin(shotAngle) };
          const px = base.x + dir.x * 6;
          const py = base.y + dir.y * 6;
          const damage = wDef?.baseDamage ?? CIWS_DAMAGE;
          const speed = wDef?.baseSpeed ?? CIWS_BULLET_SPEED;
          const range = wDef?.baseRange ?? CIWS_RANGE;
          window.bullets.push({
            x: px,
            y: py,
            vx: dir.x * speed + baseVel.x,
            vy: dir.y * speed + baseVel.y,
            life: range / speed,
            r: 2,
            owner: 'player',
            source: ship,
            damage,
            color: wDef?.vfxColor,
            type: 'ciws'
          });
          spawnParticle(
            { x: px, y: py },
            { x: dir.x * 120 + baseVel.x * 0.1, y: dir.y * 120 + baseVel.y * 0.1 },
            0.06,
            '#ffdf9e',
            2.0,
            true
          );
          gun.cd = fireInterval ?? CIWS_FIRE_INTERVAL;
        }
    
        function firePointDefenseLaser(gun, base, baseVel, target, stats, fireInterval) {
          const dir = { x: Math.cos(gun.angle), y: Math.sin(gun.angle) };
          const muzzle = { x: base.x + dir.x * 6, y: base.y + dir.y * 6 };
          const toTarget = { x: target.x - muzzle.x, y: target.y - muzzle.y };
          const range = stats?.range ?? LASER_PD_RANGE;
    
          // Laser_pd: 100% vs myśliwce, 20% vs hull/tarcza statków
          const _laserFighter = !!(target.fighter || target.type === 'fighter');
          const damage = (stats?.dmg ?? LASER_PD_DAMAGE) * (_laserFighter ? 1.0 : 0.2);
          const distance = clamp(Math.hypot(toTarget.x, toTarget.y), 0, range);
          const beamEnd = { x: muzzle.x + dir.x * distance, y: muzzle.y + dir.y * distance };
    
          spawnLaserBeam(muzzle, beamEnd, LASER_PD_BEAM_WIDTH, {
            life: 0.09,
            colorOuter: stats?.color || 'rgba(110,200,255,0.9)',
            colorInner: 'rgba(250,255,255,1.0)',
            glowColor: stats?.color || 'rgba(90,180,255,0.95)',
            glowBlur: 22,
            outerWidthMul: 1.05,
            innerWidthMul: 0.45
          });
          spawnPointDefenseLaserMuzzle(muzzle, dir, baseVel);
          spawnPointDefenseLaserHit(beamEnd.x, beamEnd.y);
          applyDamageToNPC(target, damage, 'laser_pd');
          gun.cd = fireInterval ?? LASER_PD_FIRE_INTERVAL;
        }
    
        // Salwa flaku z działka aux gracza.
        //
        // Jak fireCIWSGun, automatyczna obrona punktowa zachowuje własny cel
        // wybrany przez ciwsStep i własny zapalnik salwy.
        function fireFlakSalvo(gun, base, baseVel, target, wDef, fireInterval) {
          const profile = resolveFlakProfile(wDef);
          const dir = { x: Math.cos(gun.angle), y: Math.sin(gun.angle) };
          const muzzle = { x: base.x + dir.x * 10, y: base.y + dir.y * 10 };
    
          // Zapalnik nastawiony na punkt wyprzedzenia, nie na aktualną pozycję celu.
          const aim = leadTarget(base, baseVel, target, profile.speed);
          const aimDist = Math.min(profile.range, Math.hypot(aim.x - muzzle.x, aim.y - muzzle.y));
          const spread = wDef.spread || 0;
          const life = profile.range / profile.speed;
    
          for (let s = 0; s < profile.shells; s++) {
            const ang = gun.angle + (Math.random() - 0.5) * spread;
            const sx = Math.cos(ang), sy = Math.sin(ang);
            window.bullets.push({
              x: muzzle.x, y: muzzle.y,
              vx: sx * profile.speed + baseVel.x,
              vy: sy * profile.speed + baseVel.y,
              life,
              r: FLAK_TUNING.SHELL_RADIUS,
              owner: 'player',
              source: ship,
              damage: profile.damage,
              type: 'flak',
              weaponSize: profile.size,
              color: wDef.vfxColor,
              vfxKey: wDef.id,
              flakAge: 0,
              // Jitter na pocisk — salwa pęka warstwami w głąb, nie jedną płaską ścianą.
              flakFuseTime: flakFuseTime(aimDist, profile.speed, Math.random() * 2 - 1),
              flakFuseRadius: profile.fuseRadius,
              flakArmTime: profile.armTime,
              flakBurstRadius: profile.burstRadius,
              flakFalloff: profile.falloff,
              flakHullFactor: profile.hullFactor
            });
          }
    
          spawnFlakMuzzle(muzzle, dir, baseVel, wDef);
          gun.cd = fireInterval ?? (wDef.cooldown || CIWS_FIRE_INTERVAL);
        }
    
        // Wylot flaku: krótki, gruby blask + kilka niedopalonych ziaren prochu.
        function spawnFlakMuzzle(pos, dir, baseVel, wDef) {
          if (!isCanvasWeaponVfxEnabled()) return;
          const scale = wDef.size === 'Capital' ? 2.2 : (wDef.size === 'L' ? 1.5 : (wDef.size === 'M' ? 1.1 : 0.8));
          const angle = Math.atan2(dir.y, dir.x);
          spawnParticle({ x: pos.x, y: pos.y }, { x: dir.x * 140 + baseVel.x * 0.12, y: dir.y * 140 + baseVel.y * 0.12 }, 0.09, '#ffe6b0', 7 * scale, true);
          for (let i = 0; i < 5; i++) {
            const aa = angle + (Math.random() - 0.5) * 0.5;
            const speed = 220 + Math.random() * 180;
            spawnParticle(
              { x: pos.x + Math.cos(aa) * 6 * scale, y: pos.y + Math.sin(aa) * 6 * scale },
              { x: Math.cos(aa) * speed + baseVel.x * 0.15, y: Math.sin(aa) * speed + baseVel.y * 0.15 },
              0.14 + Math.random() * 0.12,
              (Math.random() < 0.4) ? '#fff0c8' : '#ffb347',
              (1.8 + Math.random() * 2.0) * scale,
              true
            );
          }
        }
    
        // ========================================================================
        // FLAK — pęknięcie pocisku
        // ========================================================================
        // Pocisk flaku nie trafia w cel, tylko pęka i sieje odłamkami po kuli
        // `flakBurstRadius`. Wszystko, co siedzi w tej kuli, obrywa wg spadku
        // z flakSystem.js — myśliwce pełną porcją, kadłuby okrętów ułamkiem.
        const _flakCandidates = [];
        const _flakHits = [];
    
        function detonateFlakShell(b) {
          const radius = Number(b.flakBurstRadius) || 120;
          const shooterFriendly = (b.owner === 'player' || b.owner === 'player2' || b.source?.friendly === true);
          const radiusSq = radius * radius;
    
          // 1. Encje w zasięgu — z tej samej siatki, której używa główna pętla kolizji.
          //    Encje zajmują wszystkie komórki pokryte kadłubem, więc promień wybuchu
          //    może pytać tylko o komórki, których rzeczywiście dotyka.
          _flakCandidates.length = 0;
          const count = SpatialGrid.getPotentialTargets(b.x, b.y, radius);
          const buf = SpatialGrid._resultBuffer;
          for (let k = 0; k < count; k++) {
            const e = buf[k];
            if (!e || e.isWreck) continue;                       // wrakom odłamki nie zaszkodzą
            if ((e._realEntity || e) === b.source) continue;
            _flakCandidates.push(e);
          }
    
          collectFlakBurstHits({
            x: b.x, y: b.y, radius,
            damage: Number(b.damage) || 0,
            falloff: b.flakFalloff,
            hullFactor: b.flakHullFactor,
            friendly: shooterFriendly,
            source: b.source
          }, _flakCandidates, _flakHits);
    
          for (let k = 0; k < _flakHits.length; k++) {
            const hit = _flakHits[k];
            const target = hit.entity;
            if (target._isPlayerShip) {
              // Jak w głównej pętli kolizji: proxy gracza routuje na applyDamageToPlayer.
              applyDamageToPlayer(hit.damage);
            } else {
              applyDamageToNPC(target._realEntity || target, hit.damage, 'flak');
            }
          }
    
          // 2. Rakiety i torpedy w chmurze odłamków — korzystamy z listy zagrożeń
          // zbudowanej już raz przez CIWS, zamiast ponownie skanować wszystkie pociski.
          const rocketThreats = shooterFriendly ? _pdEnemyRocketBuffer : _pdPlayerRocketBuffer;
          for (let k = 0; k < rocketThreats.length; k++) {
            const rb = rocketThreats[k];
            if (!rb || rb === b || rb.life <= 0) continue;
            if (rb.type !== 'rocket' && rb.type !== 'torpedo') continue;
            const rbFriendly = (rb.owner === 'player' || rb.owner === 'player2');
            if (rbFriendly === shooterFriendly) continue;        // własnej salwy nie zestrzeliwujemy
            const ddx = rb.x - b.x, ddy = rb.y - b.y;
            if (ddx * ddx + ddy * ddy > radiusSq) continue;
            spawnBulletImpactEffect(rb, rb.x, rb.y, 0.9);
            rb.life = -1;   // sprząta go własna iteracja pętli pocisków
          }
    
          // 3. Efekt: pęknięcie 2D (port prototypu) + cięższy akcent 3D dla L/Capital.
          FlakBurstVFX.spawn(b.x, b.y, { radius, vx: b.vx, vy: b.vy });
          if (radius >= 240 && window.triggerArmataImpact3D) {
            window.triggerArmataImpact3D(b.x, b.y, Math.min(260, radius * 0.5));
          }
          if (window.AudioSys) AudioSys.playSound('explosion');
        }
    
        function spawnPointDefenseLaserMuzzle(pos, dir, baseVel) {
          if (!isCanvasWeaponVfxEnabled()) return;
          const tangential = { x: -dir.y, y: dir.x };
          for (let i = 0; i < 3; i++) {
            const spread = (Math.random() - 0.5) * 0.6;
            const vel = {
              x: dir.x * (220 + Math.random() * 80) + tangential.x * spread * 80 + baseVel.x * 0.1,
              y: dir.y * (220 + Math.random() * 80) + tangential.y * spread * 80 + baseVel.y * 0.1
            };
            spawnParticle(
              { x: pos.x, y: pos.y },
              vel,
              0.08 + Math.random() * 0.05,
              '#8fe4ff',
              2.2 + Math.random() * 0.8,
              true
            );
          }
        }
    
        function spawnPointDefenseLaserHit(x, y) {
          if (!isCanvasWeaponVfxEnabled()) return;
          for (let i = 0; i < 12; i++) {
            const a = Math.random() * Math.PI * 2;
            const speed = 160 + Math.random() * 200;
            spawnParticle(
              { x, y },
              { x: Math.cos(a) * speed, y: Math.sin(a) * speed },
              0.16 + Math.random() * 0.14,
              '#78d9ff',
              1.4 + Math.random() * 1.6,
              true
            );
          }
          spawnParticle({ x, y }, { x: 0, y: 0 }, 0.05, '#ffffff', 4.4, true);
          spawnShockwave(x, y, { r: 5, maxR: 70, w: 2.4, maxLife: 0.35, color: 'rgba(110,200,255,' });
        }
    
    
    
    
        function handlePlayerDestroyed() {
          if (ship.destroyed) return;
          ship.destroyed = true;
          input.main = input.leftSide = input.rightSide = input.torque = 0;
          applyPlayerInput(ship, { controller: 'player', main: 0, thrustX: 0, thrustY: 0, leftSide: 0, rightSide: 0, torque: 0 }, input);
          ship.command = null;
          stopBoost();
          if (warp.state !== 'idle') {
            warp.state = 'idle';
            warp.charge = 0;
          }
    
          const reactorY = ship.pos.y + ship.h * 0.08;
          triggerReactorBlow3D(ship.pos.x, reactorY, ship.h * 0.35);
        }
    
        function applyDamageToPlayer(amount, opts = {}) {
          const bypassShield = !!opts?.bypassShield;
          const prevHull = ship.hull.val;
          if (!bypassShield && isEntityShieldBlocking(ship)) { const s = Math.min(ship.shield.val, amount); ship.shield.val -= s; amount -= s; ship.shield.regenTimer = ship.shield.regenDelay; }
          if (amount > 0) ship.hull.val = Math.max(0, ship.hull.val - amount);
          if (!ship.destroyed && prevHull > 0 && ship.hull.val <= 0) {
            handlePlayerDestroyed();
          }
        }
        window.applyDamageToPlayer = applyDamageToPlayer;
    
        // ── Critical Reactor Blow system ──────────────────────────────────────
        window.flyingHexDebris = [];
        let _critChainDepth = 0;
    
        function isFighterNPC(npc) {
          if (!npc) return false;
          if (npc.fighter) return true;
          const t = String(npc.type || '').toLowerCase();
          return t === 'fighter' || t === 'interceptor' || t === 'drone' ||
                 t === 'ally_fighter' || t === 'carrier_fighter';
        }
    
        function applyAoeExplosionDamage(pos, radius, baseDamage, sourceEntity) {
          const radiusSq = radius * radius;
          const prevDepth = _critChainDepth;
          _critChainDepth = prevDepth + 1;
          try {
            if (window.DEBUG_CRIT_BLOW) {
              console.log('[CritBlow AOE] pos=', pos.x | 0, pos.y | 0, 'radius=', radius | 0, 'baseDmg=', baseDamage | 0);
            }
            if (window.npcs) {
              for (const npc of window.npcs) {
                if (!npc || npc === sourceEntity || npc.dead) continue;
                if (npc.x === undefined || npc.y === undefined) continue;
                const dx = npc.x - pos.x, dy = npc.y - pos.y;
                const dSq = dx * dx + dy * dy;
                if (dSq >= radiusSq) continue;
                const t = 1 - Math.sqrt(dSq) / radius;
                const dmg = baseDamage * t;
                if (dmg > 0) applyDamageToNPC(npc, dmg, 'aoe_explosion', { bypassShield: false });
              }
            }
            if (ship && !ship.destroyed && ship.pos) {
              const dx = ship.pos.x - pos.x, dy = ship.pos.y - pos.y;
              const dSq = dx * dx + dy * dy;
              if (dSq < radiusSq) {
                const d = Math.sqrt(dSq);
                const t = 1 - d / radius;
                // Reactor blast is an impulse — part of it bypasses shields at close range.
                // Inside 40% of radius: half bypasses shield, half hits normally.
                const totalDmg = baseDamage * t * 0.65;
                const closeness = Math.max(0, 1 - d / (radius * 0.4));
                const bypassPart = totalDmg * (0.15 + closeness * 0.45); // 15..60% bypass
                const shieldPart = totalDmg - bypassPart;
                if (shieldPart > 0) applyDamageToPlayer(shieldPart, { bypassShield: false });
                if (bypassPart > 0) applyDamageToPlayer(bypassPart, { bypassShield: true });
