        window.FleetAIDebug = () => {
          const phase = (side) => {
            const st = getFleetPhase(side);
            return st ? { phase: st.phase, members: st.members, threats: st.threats, frontDist: Math.round(st.frontDist) || null } : null;
          };
          const out = { awareness: describeFleetAwareness(), friendly: phase('friendly'), pirate: phase('pirate'), wingOrder: SupportWing?.order };
          console.log(out);
