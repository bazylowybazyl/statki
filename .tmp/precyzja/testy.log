          const severity = Math.max(overkillRatio, aliveRatioClamped);
          const severityGate = chainDepth > 0 ? 0.72 : 0.48;
          if (severity < severityGate) return false;
          const normalizedSeverity = Math.max(0, Math.min(1, (severity - severityGate) / Math.max(0.0001, 1 - severityGate)));
          const critChance = Math.min(0.26 + normalizedSeverity * 0.52, 0.78);
          const roll = Math.random();
          if (window.DEBUG_CRIT_BLOW) {
            console.log('[CritBlow] try',
              'type=' + (npc.type || '?'),
              'overkill=' + overkillDmg?.toFixed?.(1),
              'maxHp=' + maxHull,
              'overkillRatio=' + overkillRatio.toFixed(3),
              'aliveRatio=' + aliveRatioClamped.toFixed(3),
              'severity=' + severity.toFixed(3),
              'chance=' + critChance.toFixed(3),
