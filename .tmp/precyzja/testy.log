        }
    
        const NPC_DESPAWN_RADIUS = 20000;
        function spawnRadarPing(x, y) { radarPings.push({ x, y, age: 0, life: 1 }); }
        function scannerContactRevealTime(contact, wave) {
          const distance = Math.max(0, Number(contact?.distance) || 0);
          const speed = Math.max(1, Number(wave?.speed) || getScannerWaveSpeed());
          return Math.max(SCANNER_CONTACT_REVEAL_DELAY, distance / speed);
        }
        function scannerToneRgb(tone) {
          const t = String(tone || '').toLowerCase();
          if (t === 'hostile') return '110,255,190';
          if (t === 'resource') return '238,183,99';
          if (t === 'friendly') return '80,190,255';
          if (t === 'station') return '249,115,22';
          return '150,255,220';
        }
        function scannerRevealSummary(contact) {
          const target = contact?.target;
          const label = String(contact?.label || target?.__radarUnitId || target?.id || 'CONTACT');
          if (isAsteroidTarget(target)) {
            const mass = Number(target?.mass);
            const massLabel = Number.isFinite(mass) ? Math.round(mass).toLocaleString('en-US') : '0';
            return `${label} / MASS ${massLabel}`;
          }
          return label;
        }
        function setScannerInspectedTarget(target) {
          if (!isTargetAlive(target)) return false;
          scannerSelectedTarget = target;
          scan.target = target;
          scan.scanned = target;
          const isStation = target?.__scannerContactType === 'station' || stations.includes(target);
          scan.targetType = isAsteroidTarget(target) ? 'asteroid' : (isStation ? 'station' : (target?.type || target?.__scannerContactType || 'ship'));
          scannerOverviewUI?.selectTarget?.(target);
          return true;
        }
        function revealScannerContact(contact, wave) {
          const target = contact?.target;
          if (!isTargetAlive(target)) return false;
          if (!scannerContacts.some(c => c.target === target)) {
            scannerContacts.push(contact);
            const sorted = sortScannerSweepContacts(scannerContacts);
            scannerContacts.length = 0;
            scannerContacts.push(...sorted);
          }
          wave?.hit?.add?.(target);
          spawnRadarPing(getTargetX(target), getTargetY(target));
          scannerRevealFx.push({ contact, target, age: 0, life: SCANNER_REVEAL_FX_LIFE });
          if (scannerState.autoInspectFirst && !scannerSelectedTarget) {
            setScannerInspectedTarget(target);
            scannerState.autoInspectFirst = false;
          }
          return true;
        }
        function triggerScanWave(opts = {}) {
          const reset = opts.reset === true;
          const activeRange = getScannerActiveRange();
          const asteroidRange = getScannerAsteroidRange();
          const waveSpeed = getScannerWaveSpeed();
          const contacts = collectScannerContacts({ range: activeRange, asteroidRange, includeAsteroids: true, sweepSort: true });
          scannerState.sweepTargets = new Set(contacts.map(c => c.target).filter(Boolean));
          if (reset) {
            scannerContacts.length = 0;
            scannerSelectedTarget = null;
            scan.target = null;
            scan.scanned = null;
            scan.targetType = null;
            scannerState.autoInspectFirst = true;
          } else {
            for (let i = scannerContacts.length - 1; i >= 0; i--) {
              if (!scannerState.sweepTargets.has(scannerContacts[i]?.target)) scannerContacts.splice(i, 1);
            }
          }
          const wave = {
            x: ship.pos.x,
            y: ship.pos.y,
            r: 0,
            age: 0,
            speed: waveSpeed,
            max: activeRange,
            hit: new Set(),
            contacts,
            nextContact: 0
          };
          scanWaves.push(wave);
        }
        function setScannerActive(nextActive) {
          scannerState.active = !!nextActive;
          scannerState.lockAnim = 0;
          invalidateScannerPassiveContacts();
          if (scannerState.active) {
            scannerState.burstSerial += 1;
            refreshScannerPassiveContacts(true);
            scanWaves.length = 0;
            triggerScanWave({ reset: true });
            CICDisplay.triggerHudRadarBurst?.();
            pushZoneMessage('Active Scanner: SINGLE BURST', 1.3);
          } else {
            scannerContacts.length = 0;
            scanWaves.length = 0;
            radarPings.length = 0;
            scannerRevealFx.length = 0;
            scannerPassiveContacts.length = 0;
            scannerSelectedTarget = null;
            scannerState.sweepTargets = new Set();
            scannerState.autoInspectFirst = false;
            pushZoneMessage('Active Scanner: OFFLINE', 1.1);
          }
        }
    
        function setLockedTargetsExact(nextTargets) {
