          if (eligible.length >= 36) fragCount++;
          if (eligible.length >= 54 && severityClamped > 0.95) fragCount++;
          const minFragmentShards = 4;
          fragCount = Math.max(1, Math.min(fragCount, Math.floor(eligible.length / minFragmentShards) || 1));
    
          let debrisCount = Math.floor(eligible.length * (0.22 + Math.min(0.28, severityClamped * 0.20)));
          debrisCount = eligible.length >= 20 ? Math.max(debrisCount, 10) : Math.max(debrisCount, 4);
          const maxDebrisCount = Math.max(0, eligible.length - fragCount * minFragmentShards);
