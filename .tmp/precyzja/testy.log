          const glowR = radius * (0.65 + 0.25 * eased);
          const ringR = radius * (0.9 + 0.35 * eased);
          const lineBase = (6 + 22 * eased) * spriteScale;
          const arcLine = (10 + 18 * eased) * spriteScale;
    
