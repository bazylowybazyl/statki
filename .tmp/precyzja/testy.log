                // Lider jest zawsze w punkcie 0,0
                u.formationOffset = { x: 0, y: 0 };
              } else {
                // Reszta ustawia się w formacji "Chevron" (V)
                // idx: 1 -> row 1, side L
                // idx: 2 -> row 1, side R
                // idx: 3 -> row 2, side L ...
                const row = Math.floor((idx + 1) / 2);
