          reclaimMountedWeaponsToInventory();
          Game.player.hardpoints = generatePlayerHardpointsForFrame(Game.player.shipFrame, frame, bounds);
          Game.player.editorCores = buildPlayerDefaultEditorCores();
          Game.player.editorLights = buildPlayerDefaultEditorLights(Game.player.shipFrame);
          autoMountDefaults();
