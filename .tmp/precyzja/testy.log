        Object.values(HULL_SPRITE_PATHS_BY_ID).forEach(src => { try { loadHullSprite(src); } catch { } });
        // Typy frachtowców cywilnych. UWAGA: warunek `type.includes('frigate')`
        // NIE łapie 'freighter' — to inne słowo (fr-ei-ghter vs fr-i-gate).
        // Przez tę zbieżność wyglądu frachtowce latały bez kadłuba, bo funkcja
        // spadała na `return null` i render pomijał całą gałąź sprite'ową.
        const FREIGHTER_HULL_BY_TYPE = Object.freeze({
          'freighter-small': 'inter_station_shuttle',
          'freighter-medium': 'container_ship',
          'freighter-large': 'long_haul_freighter',
          'freighter-capital': 'long_haul_freighter'
