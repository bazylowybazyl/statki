        }
    
        function findTargetingHoveredSubsystem(entity, screenX = mouse.x, screenY = mouse.y, camRef = camera) {
          if (!entity || !targetingMode.scannedTargets.has(entity)) return null;
          const hardpoints = getEntityHardpoints(entity);
          if (!Array.isArray(hardpoints)) return null;
          let best = null;
          let bestDistSq = 16 * 16;
          for (let i = 0; i < hardpoints.length; i++) {
            const hp = hardpoints[i];
            if (!hp || hp.destroyed) continue;
            const point = getEntityHardpointWorldPos(entity, hp);
            if (!point) continue;
            const screen = worldToScreen(point.x, point.y, camRef);
            const dx = screen.x - screenX;
            const dy = screen.y - screenY;
            const distSq = dx * dx + dy * dy;
            if (distSq >= bestDistSq) continue;
            bestDistSq = distSq;
            best = getTargetingSubsystemTarget(entity, hp);
          }
          // Mostek ma większy chwyt (24 px), ale bliższy hardpoint wygrywa.
          const bridges = listTargetableBridges(entity);
          if (bridges) {
            for (let i = 0; i < bridges.length; i++) {
              const bridge = bridges[i];
              if (bridge.dead) continue;
              const point = getBridgeMarkerWorld(entity, bridge);
              const screen = worldToScreen(point.x, point.y, camRef);
              const dx = screen.x - screenX;
              const dy = screen.y - screenY;
              const distSq = dx * dx + dy * dy;
              if (distSq >= (best ? bestDistSq : 24 * 24)) continue;
              bestDistSq = distSq;
              best = getTargetingBridgeTarget(entity, bridge);
