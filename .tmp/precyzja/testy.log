          // mnozony przez TIME_SCALE = 60 i rozpedzal kreskowanie do miga.
          const uiAnimTime = () => performance.now() / 1000;
          function _targetingScreenRadius(target, zoom) {
            const radius = Math.max(12, getTargetRadius(target));
            const visualScale = targetingVisualScale(zoom);
            const profile = target?.capitalProfile;
