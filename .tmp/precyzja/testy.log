        }
    
        function loadLoadout() {
          const raw = localStorage.getItem('loadout');
          if (!raw) { syncWeaponSystems(); return; }
          try {
            const data = JSON.parse(raw);
            const loadedOwned = Array.isArray(data?.ownedHullIds) ? data.ownedHullIds : [];
            for (const hullId of loadedOwned) ensurePlayerOwnsHull(hullId);
            // Zapis sprzed chipów nie ma pola — wtedy brak chipów.
            PLAYER.hullChips = normalizeHullChips(data?.hullChips, {
              isValidHull: (hullId) => !!PLAYER_HULL_CATALOG[hullId]
            });
            const requestedHull = normalizePlayerHullId(data?.activeHullId || PLAYER.activeHullId || DEFAULT_PLAYER_HULL_ID);
            ensurePlayerOwnsHull(requestedHull);
            applyPlayerHullProfile(requestedHull, { preserveDamageRatio: true, syncVisuals: true, persist: false });
            const expectedFrame = getPlayerHullDef(requestedHull)?.shipFrame;
            if (expectedFrame && SHIPS[expectedFrame]) Game.player.shipFrame = expectedFrame;
            const frame = SHIPS[Game.player.shipFrame];
            if (frame) {
              const bounds = getPlayerHardpointBoundsForFrame(Game.player.shipFrame);
              const fresh = generatePlayerHardpointsForFrame(Game.player.shipFrame, frame, bounds);
              const savedByType = new Map();
              for (const saved of (data.hardpoints || [])) {
                // BEZPIECZEŃSTWO: Jeśli broń nie istnieje w nowym systemie, omiń ją (zapobiegnie znikaniu i crashom)
                const hangarSquadrons = saved.type === HP.HANGAR
                  ? normalizeHangarSquadronMounts(
                    Array.isArray(saved.hangarSquadrons) && saved.hangarSquadrons.length
                      ? saved.hangarSquadrons
                      : (saved.mount ? [saved.mount] : []),
                    99
                  )
                  : [];
                if ((!saved.mount || !WEAPONS[saved.mount]) && hangarSquadrons.length === 0) continue;
                // Broń mogła zmienić rodzaj gniazda już po zapisie — hexlance przeszedł
                // ze `special` na `builtin` (2026-04-11). Kubełkujemy po AKTUALNYM
                // mountType, nie po typie z zapisu: inaczej wpis ląduje na gnieździe
                // special, setHardpointMount go odrzuca (mountType !== hp.type)
                // i broń znika bez śladu, a gniazdo builtin zostaje puste.
                const bucket = WEAPONS[saved.mount]?.mountType || saved.type;
                if (!savedByType.has(bucket)) savedByType.set(bucket, []);
                savedByType.get(bucket).push({ ...saved, hangarSquadrons });
              }
              // Automount przed chwilą wyjął domyślny fit z ładowni, a my zaraz
              // podmienimy całą tablicę hardpointów na `fresh`. Bez zwrotu te sztuki
              // wyparowują — tak właśnie ginął hexlance przy zapisie bez gniazda
              // built-in: nie było go ani na kadłubie, ani w magazynie.
              reclaimMountedWeaponsToInventory();
              for (const hp of fresh) {
                const arr = savedByType.get(hp.type);
                if (arr && arr.length) {
                  const saved = arr.shift();
                  restoreHardpointMountEntry(hp, {
                    weaponId: saved.mount,
                    ammo: saved.ammo,
                    maxAmmo: saved.maxAmmo,
                    hangarSquadrons: saved.hangarSquadrons
                  });
                }
              }
              Game.player.hardpoints = fresh;
            }
          } catch (e) {
            console.warn('Loadout parse error', e);
          }
          syncPlayerHullSnapshot();
          syncWeaponSystems();
          if (typeof renderMechanic === 'function') renderMechanic();
        }
    
        function applyHardpointEditorConfigToRunningGame() {
