            const rawType = String(marker?.type || HP.MAIN).toLowerCase();
            let type = validTypes.has(rawType) ? rawType : HP.MAIN;
            if (resolvedKey === 'atlas' && type === HP.SPECIAL && String(marker?.id || '') === 'm_1zez2h7') {
              type = HP.BUILTIN;
