          const minGroupSize = Math.max(3, Math.min(8, Math.floor(sourceShards.length * 0.14)));
          for (const bucket of buckets) {
            if (bucket.length >= minGroupSize || (groupCount === 1 && bucket.length >= 3)) viable.push(bucket);
            else leftovers.push(...bucket);
          }
          if (viable.length === 0) {
