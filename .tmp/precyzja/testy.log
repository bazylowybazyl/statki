          const dist = Math.hypot(dx, dy) || 1;
          const dir = { x: dx / dist, y: dy / dist };
          const maxSpeed = opts.maxSpeed || npc.maxSpeed || npc.speed || 240;
          const currentSpeed = Math.hypot(npc.vx || 0, npc.vy || 0);
