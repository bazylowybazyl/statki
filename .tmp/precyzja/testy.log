        function getMainWeaponHudCharge() {
          const weapon = getHudWeaponByType(HP.MAIN);
          const cdMax = Math.max(0.01, Number(rail?.cdMax) || Number(weapon?.cooldown) || 0.15);
          const barrels = Math.max(1, Number(rail?.barrelsPerShot) || 1);
          const cdLeft = barrels > 1
            ? Math.max(Number(rail?.cd?.[0]) || 0, Number(rail?.cd?.[1]) || 0)
