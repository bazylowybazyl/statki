          // kupiona albo zlootowana — ładownia nie jest zapisywana do localStorage),
          // dokładamy ją i zaraz zdejmujemy montażem. Warunek `hp.mount !== weaponId`
          // pilnuje, żeby odtworzenie TEGO SAMEGO działa nie wyprodukowało sztuki z niczego.
          const inventory = Game.player?.inventory;
          if (entry.weaponId && inventory && hp.mount !== entry.weaponId && !inventory.has(entry.weaponId)) {
            inventory.give(entry.weaponId, 1);
          }
          setHardpointMount(hp, entry.weaponId, { ammo: entry.ammo, maxAmmo: entry.maxAmmo });
        }
    
        function tryPreserveMounts(previous) {
          if (!previous) return;
          const byType = new Map();
          for (const hp of previous) {
            const hangarSquadrons = hp.type === HP.HANGAR ? getHardpointHangarSquadrons(hp) : [];
            if (!hp.mount && hangarSquadrons.length === 0) continue;
            const entry = { weaponId: hp.mount, ammo: hp.ammo, maxAmmo: hp.maxAmmo, hangarSquadrons };
            if (!byType.has(hp.type)) byType.set(hp.type, []);
            byType.get(hp.type).push(entry);
          }
          for (const hp of Game.player.hardpoints) {
            const arr = byType.get(hp.type);
            if (arr && arr.length) {
              const entry = arr.shift();
              restoreHardpointMountEntry(hp, entry);
            }
          }
