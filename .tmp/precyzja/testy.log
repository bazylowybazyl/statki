        };
    
        // ============================================================================
        // TRYBY CELOWNIKA — wpływają wyłącznie na wybór celów, nigdy na statystyki broni.
        // ============================================================================
        const TARGETING_GROUP_RADIUS_PX = 190;
        const TARGETING_GROUP_PAD_PX = 44;
        const TARGETING_SUB_SCAN_TIME = 2.2;
        // Kursor moze na moment zjechac z kadluba (statek leci, reka drgnie). Bez
        // laski namiar wracal do zera dokladnie w chwili LPM i klik "nie lapal".
        const TARGETING_ACQUIRE_GRACE = 0.28;
        const TARGETING_ACQUIRE_DECAY = 0.55;
    
        const targetingMode = {
          current: TARGETING_MODE.SINGLE,
          wheelOpen: false,
          wheelHover: -1,
          wheelMouseStart: null,
          rangeDraw: 0,
          acquireTarget: null,
          acquireProgress: 0,
          acquireHold: 0,
          acquireReadyFx: 0,
          acquireReadyRef: null,
          groupAngle: 0,
          groupX: 0,
          groupY: 0,
          groupW: 160,
          groupH: 190,
          groupCandidates: [],
          groupPrevious: [],
          groupAcquisition: new WeakMap(),
          groupReadyFx: new WeakMap(),
          subScanTarget: null,
          subScanProgress: 0,
