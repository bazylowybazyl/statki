            return false;
          }
          if (chainDepth > 1) return false;
          const maxHull = Math.max(1, Number(npc.maxHp) || 100);
          const overkillRatio = Math.max(0, Number(overkillDmg) || 0) / maxHull;
          const aliveRatioClamped = Math.max(0, Math.min(1, Number(aliveRatio) || 0));
          // Severity metric: take the bigger signal of
          //   (a) big burst HP overkill (bulk damage weapon finishing the ship),
