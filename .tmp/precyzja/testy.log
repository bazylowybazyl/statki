              const blocked = targetingMode.hoverBlocked;
              pushZoneMessage(
                blocked ? `SINGLE: ${_targetingBlockedReason(blocked)}` : 'SINGLE: BRAK CELU POD KURSOREM',
                1.2
              );
              return;
            }
            if (targetingMode.acquireProgress < 1) {
              pushZoneMessage(`SINGLE: NAMIAR ${Math.round(targetingMode.acquireProgress * 100)}% — UTRZYMAJ CEL`, 1.0);
              return;
            }
            setLockedTargetsExact([target]);
