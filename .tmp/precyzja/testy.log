        function pickReactorBlowDebrisShards(entity, sourceShards, desiredCount) {
          if (!entity?.hexGrid || !Array.isArray(sourceShards) || desiredCount <= 0) return [];
          const srcWidth = entity.hexGrid.srcWidth || 256;
          const srcHeight = entity.hexGrid.srcHeight || 256;
          const centerX = srcWidth * 0.5 + (entity.hexGrid.pivot?.x || 0);
          const centerY = srcHeight * 0.5 + (entity.hexGrid.pivot?.y || 0);
          const sourceSet = new Set(sourceShards);
          const candidates = [];
          let maxRadiusSq = 1;
          for (const shard of sourceShards) {
            if (!shard || shard.active === false || shard.isDebris) continue;
            const localX = (Number(shard.gridX) || 0) + (Number(shard.deformation?.x) || 0) - centerX;
            const localY = (Number(shard.gridY) || 0) + (Number(shard.deformation?.y) || 0) - centerY;
            const radiusSq = localX * localX + localY * localY;
            if (radiusSq > maxRadiusSq) maxRadiusSq = radiusSq;
            let linkedNeighbors = 0;
            for (const neighbor of shard.neighbors || []) {
              if (!neighbor || neighbor.active === false || neighbor.isDebris) continue;
              if (sourceSet.has(neighbor)) linkedNeighbors++;
            }
            candidates.push({
              shard,
              radiusSq,
              edgeScore: Math.max(0, 6 - linkedNeighbors),
              jitter: Math.random()
            });
          }
          candidates.sort((a, b) => {
            const aScore = (a.radiusSq / maxRadiusSq) * 1.15 + a.edgeScore * 0.55 + a.jitter * 0.18;
            const bScore = (b.radiusSq / maxRadiusSq) * 1.15 + b.edgeScore * 0.55 + b.jitter * 0.18;
            return bScore - aScore;
          });
          const picked = [];
          for (let i = 0; i < candidates.length && picked.length < desiredCount; i++) {
            picked.push(candidates[i].shard);
          }
          return picked;
        }
    
        function buildReactorBlowFragmentGroups(entity, sourceShards, desiredCount) {
          if (!entity?.hexGrid || !Array.isArray(sourceShards) || sourceShards.length < 3) return [];
          const groupCount = Math.max(1, desiredCount | 0);
          const srcWidth = entity.hexGrid.srcWidth || 256;
          const srcHeight = entity.hexGrid.srcHeight || 256;
          const centerX = srcWidth * 0.5 + (entity.hexGrid.pivot?.x || 0);
          const centerY = srcHeight * 0.5 + (entity.hexGrid.pivot?.y || 0);
          const angleOffset = Math.random() * Math.PI * 2;
          const sectorSize = (Math.PI * 2) / groupCount;
          const buckets = Array.from({ length: groupCount }, () => []);
          for (const shard of sourceShards) {
            if (!shard) continue;
            const localX = (Number(shard.gridX) || 0) + (Number(shard.deformation?.x) || 0) - centerX;
            const localY = (Number(shard.gridY) || 0) + (Number(shard.deformation?.y) || 0) - centerY;
            let ang = Math.atan2(localY, localX) - angleOffset;
            ang = ((ang % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
