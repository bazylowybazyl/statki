        }
    
        function tryFireSpecialMissiles() {
          return _fireSpecialGroup(Game.player?.weapons?.[HP.SPECIAL_MISSILE] || []);
        }
    
        // Hexlance jest DWUTAKTOWY: pierwsze 4 rozpoczyna ładowanie (1,2 s), dopiero
