          if (!src.length) return [];
          const validTypes = new Set(Object.values(HP));
          const { scaleX, scaleY } = getPlayerEditorScale();
          const out = [];
          for (let i = 0; i < src.length; i++) {
            const marker = src[i];
            const x = Number(marker?.x);
            const y = Number(marker?.y);
            if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
            const rawType = String(marker?.type || HP.MAIN).toLowerCase();
            let type = validTypes.has(rawType) ? rawType : HP.MAIN;
