          window.__aiSepMs = 0;
          window.__aiWeaponScanMs = 0;
          window.__aiTargetPickMs = 0;
          window.__aiGridMs = 0;
          window.__aiNpcEnemyBrainMs = 0;
          window.__aiNpcFriendlyBrainMs = 0;
          npcStep(dt, aiDbgEnabled ? AILiveDebug : null, runAiLogic, aiLogicDt, aiBrainPhase, aiBrainPhaseCount);
          const npcStepMs = performance.now() - tNpcStep0;
