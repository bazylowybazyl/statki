        // się" przez pół układu w jednej klatce), przejście kamery i rozkaz RTS,
        // który natychmiast zawróciłby autopilota do starego celu.
        function devTeleportTo(x, y, opts = {}) {
          if (!ship?.pos || !Number.isFinite(x) || !Number.isFinite(y)) return false;
    
          if (warp.state !== 'idle') {
            warp.state = 'idle';
            warp.charge = 0;
            warp.entryProgress = 0;
          }
          warp.gravityBrake.active = false;
          warp.gravityBrake.timer = 0;
          warpBrakeTimer = 0;
    
          ship.pos.x = x;
          ship.pos.y = y;
          ship.vel.x = 0;
          ship.vel.y = 0;
          ship.angVel = 0;
          if (Number.isFinite(opts.angle)) ship.angle = opts.angle;
