const spriteCache = new Map();
function loadSprite(hullId, src) {
  const record = { hullId, src, image: new Image(), ready: false, error: false, width: 1, height: 1 };
  spriteCache.set(hullId, record);
  return new Promise((resolve) => {
    record.image.onload = () => {
      record.ready = true;
      record.width = Math.max(1, record.image.naturalWidth || record.image.width || 1);
      record.height = Math.max(1, record.image.naturalHeight || record.image.height || 1);
      resolve(record);
    };
    record.image.onerror = () => {
      record.error = true;
      resolve(record);
    };
    record.image.src = src;
  });
}

