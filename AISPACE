function resolveHullId(catalogEntry, team) {
  if (!catalogEntry) return null;
  if (catalogEntry.family === 'fighter') return null;
  if (catalogEntry.id.includes('frigate')) return team === TEAM.RED ? 'pirate_frigate' : 'terran_frigate';
  if (catalogEntry.id === 'destroyer') return team === TEAM.RED ? 'pirate_destroyer' : 'terran_destroyer';
  if (catalogEntry.id === 'battleship') return team === TEAM.RED ? 'pirate_battleship' : 'terran_battleship';
  if (catalogEntry.id === 'carrier') return 'terran_carrier';
  if (catalogEntry.id === 'supercapital') return 'terran_supercapital';
  if (catalogEntry.id === 'atlas') return 'atlas';
  if (catalogEntry.id === 'megafreighter') return 'megafreighter';
  return null;
}

function resolveStats(entry) {
  if (entry.family === 'fighter') {
    return {
      hp: entry.data.hp,
      shield: 0,
      shieldRegen: 0,
      shieldDelay: 0,
      accel: entry.data.accel,
      maxSpeed: entry.data.maxSpeed,
      turn: entry.data.turn,
      radius: entry.data.radius,
      mass: entry.data.mass,
      friction: 1,
      separationRange: entry.data.separationRange
    };
  }
  if (entry.family === 'support') {
    const shield = entry.data.shield || {};
    return {
      ...entry.data.stats,
      shield: finite(shield.val ?? shield.max),
      shieldRegen: finite(shield.regenRate),
      shieldDelay: finite(shield.regenDelay),
      friction: finite(entry.data.stats?.friction, 1)
    };
  }
  const data = entry.data;
  return {
    hp: data.hull,
    shield: data.shield,
    shieldRegen: data.shieldRegen,
    shieldDelay: data.shieldDelay,
    accel: data.accel,
    maxSpeed: data.maxSpeed,
    turn: data.turn,
    radius: data.radius,
    mass: data.mass,
    rammingMass: data.rammingMass,
    friction: 0.99,
    separationRange: Math.max(300, finite(data.radius) * 2.2)
  };
}

function preferredRangeFor(entry) {
  if (entry.id === 'frigate_pd') return 800;
  if (entry.id === 'frigate_laser') return 2400;
  if (entry.id === 'destroyer') return 1400;
  if (entry.id === 'battleship') return 1600;
  if (entry.family === 'capital') return finite(entry.data.weaponRange, 3200);
  return 0;
}

function brainFor(entry) {
  if (entry.family === 'fighter') return { name: 'runAdvancedFighterAI', fn: (_sim, npc, dt) => runAdvancedFighterAI(npc, dt) };
  if (entry.id.includes('frigate')) return { name: 'aiFrigate', fn: aiFrigate };
  if (entry.id === 'destroyer') return { name: 'aiDestroyer', fn: aiDestroyer };
  if (entry.family === 'support' || entry.family === 'capital') return { name: 'aiBattleship', fn: aiBattleship };
  return { name: 'brak AI', fn: null };
}

function makeShield(stats) {
  const max = Math.max(0, finite(stats.shield));
  return {
    val: max,
    max,
    regenRate: Math.max(0, finite(stats.shieldRegen)),
    regenDelay: Math.max(0, finite(stats.shieldDelay)),
    regenTimer: 0,
    impacts: [],
    state: max > 0 ? 'active' : 'off'
  };
}

function resetAutonomousWeapons(unit) {
  unit.autoWeapons = undefined;
  unit._weaponsInit = false;
  unit._shipScanCaches = undefined;
  unit.__weaponFacingBias = undefined;
}

function mountLoadout(unit, requested = null) {
  const base = requested || unit.loadout || DEFAULT_LOADOUT[unit.team];
  unit.loadout = {
    main: MASTER_WEAPONS[base?.main] ? base.main : DEFAULT_LOADOUT[unit.team].main,
    aux: MASTER_WEAPONS[base?.aux] ? base.aux : DEFAULT_LOADOUT[unit.team].aux,
    missile: MASTER_WEAPONS[base?.missile] ? base.missile : DEFAULT_LOADOUT[unit.team].missile
  };

  unit.weapons = Object.fromEntries(HP_TYPES.map((type) => [type, []]));
  const list = Array.isArray(unit.editorHardpoints) ? unit.editorHardpoints : [];
  for (let index = 0; index < list.length; index++) {
    const hp = list[index];
    const weaponId = unit.loadout[hp.type];
    hp.mount = weaponId && MASTER_WEAPONS[weaponId] ? weaponId : null;
    hp.ammo = null;
    hp.maxAmmo = null;
    if (!hp.mount) continue;
    const weapon = MASTER_WEAPONS[hp.mount];
    if (weapon.ammo != null) {
      hp.ammo = weapon.ammo;
      hp.maxAmmo = weapon.ammo;
    }
    unit.weapons[hp.type].push({ hp, weapon });
  }
  resetAutonomousWeapons(unit);
}

function applyCurrentLayout(unit) {
  if (!unit || unit.dead || unit.fighter) return false;
  const applied = hardpoints.applyLayoutToNpc(unit);
  if (applied) mountLoadout(unit, unit.loadout);
  return applied;
}

function createUnit(entryId, team, x, y, options = {}) {
  const entry = CATALOG_BY_ID.get(entryId);
  if (!entry) throw new Error(`Unknown AI SPACE unit: ${entryId}`);
  const stats = resolveStats(entry);
  const hullId = resolveHullId(entry, team);
  const sprite = hullId ? spriteCache.get(hullId) : null;
  const renderSize = hullId
    ? getHullRenderSize(hullId, sprite?.width || 0, sprite?.height || 0)
    : { w: stats.radius * 2, h: stats.radius * 1.4, radius: stats.radius };
  const brain = brainFor(entry);
  const id = `ais_${sim.nextId++}`;
  const maxHp = Math.max(1, finite(stats.hp, 100));
  const angle = Number.isFinite(options.angle) ? options.angle : (team === TEAM.BLUE ? 0 : Math.PI);

  const unit = {
    id,
    uid: id,
    name: `${entry.label} ${sim.nextId - 1}`,
    catalogId: entryId,
    catalogEntry: entry,
    type: entry.family === 'fighter' ? (entryId === 'interceptor' ? 'interceptor' : 'fighter') : entryId,
    shipFrame: hullId,
    team,
    friendly: team === TEAM.BLUE,
    isPirate: team === TEAM.RED,
    color: TEAM_COLOR[team],
    mission: true,
    fighter: entry.family === 'fighter',
    isCapitalShip: entry.family === 'capital' || entry.id === 'destroyer' || entry.id === 'battleship',
    staticDummy: entry.data.staticDummy === true,
    combatDisabled: entry.data.staticDummy === true,
    disableEditorLayout: entry.data.disableEditorLayout === true,
    x,
    y,
    vx: finite(options.vx),
    vy: finite(options.vy),
    pos: { x, y },
    vel: { x: finite(options.vx), y: finite(options.vy) },
    angle,
    desiredAngle: angle,
    angVel: 0,
    hp: maxHp,
    maxHp,
    shield: makeShield(stats),
    accel: Math.max(0, finite(stats.accel)),
    maxSpeed: Math.max(0, finite(stats.maxSpeed)),
    turn: Math.max(0.01, finite(stats.turn, 1)),
    turnAccel: Math.max(0.04, finite(stats.turn, 1) * 4),
    angularFriction: SHIP_PHYSICS.ANGULAR_FRICTION,
    friction: finite(stats.friction, 1),
    mass: Math.max(0.1, finite(stats.mass, 1)),
    rammingMass: Math.max(0.1, finite(stats.rammingMass, stats.mass || 1)),
    radius: Math.max(4, finite(stats.radius, renderSize.radius)),
    separationRange: Math.max(20, finite(stats.separationRange, stats.radius * 2)),
    w: renderSize.w,
    h: renderSize.h,
    visual: {},
    engines: {},
    sprite,
    keepAngle: entry.family !== 'fighter',
    preferredRange: preferredRangeFor(entry),
    broadsideRange: entry.id === 'battleship' ? 1200 : undefined,
    weaponRange: entry.family === 'capital' ? finite(entry.data.weaponRange) : undefined,
    boostDur: entry.id === 'destroyer' ? 1.8 : undefined,
    capitalProfile: entry.family === 'capital' ? { ...(entry.data.profile || {}) } : {
      lengthScale: Math.max(2, renderSize.w / Math.max(1, stats.radius)),
      widthScale: Math.max(1.2, renderSize.h / Math.max(1, stats.radius)),
      spriteRotation: 0
    },
    brainName: brain.name,
    brainFn: brain.fn,
    aiEnabled: brain.fn != null && !entry.data.staticDummy,
    dead: false,
    state: entry.family === 'fighter' ? 'engage_formation' : 'combat',
    target: null,
    forceTarget: null,
    hitFlash: 0,
    trail: [],
    trailTimer: Math.random() * 0.1,
    loadout: { ...DEFAULT_LOADOUT[team] },
    baseStats: {
      maxSpeed: Math.max(0, finite(stats.maxSpeed)),
      accel: Math.max(0, finite(stats.accel)),
      turn: Math.max(0.01, finite(stats.turn, 1)),
      preferredRange: preferredRangeFor(entry)
    }
  };

  unit.inertia = (1 / 12) * unit.mass * ((unit.w * unit.w) + (unit.h * unit.h));
  if (sprite?.ready) {
    unit.__hardpointScaleX = unit.w / sprite.width;
    unit.__hardpointScaleY = unit.h / sprite.height;
    unit.__hardpointScale = (unit.__hardpointScaleX + unit.__hardpointScaleY) * 0.5;
  } else {
    unit.__hardpointScaleX = 1;
    unit.__hardpointScaleY = 1;
    unit.__hardpointScale = 1;
  }

  if (unit.fighter) {
    const fighterDef = entry.data;
    unit.squadronId = fighterDef.id;
    unit.squadronName = fighterDef.name;
    unit.gun = fighterDef.weaponId;
    unit.msl = fighterDef.missileId;
    unit.mslAmmo = fighterDef.missileAmmo;
    unit.gunCD = 0;
    unit.mslCD = 0;
  } else {
    applyCurrentLayout(unit);
  }

  unit.ai = (dt) => {
    if (!unit.aiEnabled || !unit.brainFn || unit.dead) return;
    unit.brainFn(sim, unit, dt);
  };

  syncNpcFlightState(unit);
  return unit;
}

function spawnUnit(entryId, team, x, y, options = {}) {
  const unit = createUnit(entryId, team, x, y, options);
  sim.units.push(unit);
  return unit;
}

function spawnFighterGroup(entryId, team, count, x, y, facing) {
  const units = [];
  const columns = Math.max(1, Math.ceil(Math.sqrt(count)));
  for (let index = 0; index < count; index++) {
    const row = Math.floor(index / columns);
    const col = index % columns;
    const px = x + (team === TEAM.BLUE ? -row * 80 : row * 80);
    const py = y + (col - (columns - 1) * 0.5) * 72;
    units.push(spawnUnit(entryId, team, px, py, { angle: facing }));
  }
  const leader = units[0] || null;
  if (leader) {
    for (let index = 0; index < units.length; index++) {
      const row = Math.floor(index / 2) + 1;
      const side = index % 2 === 0 ? 1 : -1;
      units[index].squad = { leader };
      units[index].formationOffset = index === 0 ? { x: 0, y: 0 } : { x: -row * 70, y: side * row * 48 };
    }
  }
  return units;
}

function hardpointWorld(owner, hp) {
  if (!owner || !hp) return null;
  const scaleX = finite(owner.__hardpointScaleX, finite(owner.__hardpointScale, 1));
  const scaleY = finite(owner.__hardpointScaleY, finite(owner.__hardpointScale, 1));
  const lx = finite(hp.x ?? hp.pos?.x) * scaleX;
  const ly = finite(hp.y ?? hp.pos?.y) * scaleY;
  const angle = finite(owner.angle) + finite(owner.capitalProfile?.spriteRotation);
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  return { x: owner.x + lx * cos - ly * sin, y: owner.y + lx * sin + ly * cos };
}

function getUnitKind(entity) {
  if (!entity) return 'other';
  if (entity.__projectile) return entity.type === 'rocket' || entity.type === 'torpedo' ? 'rocket' : 'projectile';
  if (entity.fighter || entity.type === 'fighter' || entity.type === 'interceptor') return 'fighter';
  if (String(entity.type || '').includes('frigate')) return 'frigate';
  if (entity.type === 'destroyer') return 'destroyer';
  if (entity.type === 'battleship' || entity.isCapitalShip) return 'battleship';
  return 'other';
}

function isCombatActive(unit) {
  return !!(unit?.forceTarget || unit?.target || unit?.state === 'engage_formation' || unit?.state === 'dogfight3D' || unit?.state === 'bombing');
}

function applySeparationForces(unit, ax = 0, ay = 0) {
  const cached = unit.__sandboxSeparation || (unit.__sandboxSeparation = { x: 0, y: 0, out: { ax: 0, ay: 0 }, frame: -1 });
  if (cached.frame === sim.frameId) {
    cached.out.ax = cached.x + ax;
    cached.out.ay = cached.y + ay;
    return cached.out;
  }

  const myRadius = unit.radius || 20;
  const myMass = Math.max(1, unit.mass || 1);
  const myFighter = !!unit.fighter;
  const myCapital = !!unit.isCapitalShip || !myFighter;
  const myGain = myMass <= 2 ? 1 / myMass : 1 / Math.pow(myMass, 0.25);
  const query = queryAIGrid(unit.x, unit.y, myCapital ? 900 : 450);
  let sumX = 0;
  let sumY = 0;

  for (let index = 0; index < query.count; index++) {
    const other = query.buffer[index];
    if (!other || other === unit || other.dead) continue;
    const dx = unit.x - other.x;
    const dy = unit.y - other.y;
    const distSq = dx * dx + dy * dy;
    const otherRadius = other.radius || 20;
    const enemy = isEnemyUnit(unit, other);
    const otherFighter = !!other.fighter;
    const bigPair = myCapital || !!other.isCapitalShip || !otherFighter;
    let safe = myRadius + otherRadius;
    let strength;

    if (enemy && myFighter && otherFighter) {
      safe += 10;
      strength = 6;
    } else if (!enemy && myFighter && otherFighter) {
      safe += isCombatActive(unit) ? 22 : 46;
      strength = isCombatActive(unit) ? 8 : 12;
    } else {
      safe += Math.max(70, (myRadius + otherRadius) * 0.6);
      strength = enemy ? 13 : 12;
    }

    const dist = Math.sqrt(distSq) || 1;
    let overlap = safe - dist;
    if (bigPair && overlap <= 0 && dist < safe + 420) {
      const relVx = finite(unit.vx) - finite(other.vx);
      const relVy = finite(unit.vy) - finite(other.vy);
      const closing = -(relVx * dx + relVy * dy) / dist;
      if (closing > 40) overlap = (safe - (dist - Math.min(420, closing * 0.85))) * 0.6;
    }
    if (overlap <= 0) continue;
    const force = overlap * strength * myGain;
    sumX += dx / dist * force;
    sumY += dy / dist * force;
  }

  const limit = myFighter ? (isCombatActive(unit) ? 180 : 240) : 560;
  const length = Math.hypot(sumX, sumY);
  if (length > limit && length > 1e-6) {
    const scale = limit / length;
    sumX *= scale;
    sumY *= scale;
  }
  cached.x = sumX;
  cached.y = sumY;
  cached.frame = sim.frameId;
  cached.out.ax = sumX + ax;
  cached.out.ay = sumY + ay;
  return cached.out;
}

function segmentPointDistanceSq(x1, y1, x2, y2, px, py) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const lengthSq = dx * dx + dy * dy;
  const t = lengthSq > 1e-8 ? clamp(((px - x1) * dx + (py - y1) * dy) / lengthSq, 0, 1) : 0;
  const qx = x1 + dx * t;
  const qy = y1 + dy * t;
  const ox = px - qx;
  const oy = py - qy;
  return ox * ox + oy * oy;
}

function isLineOfFireBlocked(owner, target, range) {
  if (!owner || !target) return false;
  const tx = entityX(target);
  const ty = entityY(target);
  const dist = Math.hypot(tx - owner.x, ty - owner.y);
  if (dist > finite(range, Infinity)) return true;
  for (let index = 0; index < sim.units.length; index++) {
    const blocker = sim.units[index];
    if (!blocker || blocker.dead || blocker === owner || blocker === target) continue;
    if (isEnemyUnit(owner, blocker)) continue;
    const radius = Math.max(6, blocker.radius || 10) * 0.72;
    if (segmentPointDistanceSq(owner.x, owner.y, tx, ty, blocker.x, blocker.y) < radius * radius) return true;
  }
  return false;
}

function projectileRadius(definition) {
  if (definition.bulletRadius) return definition.bulletRadius;
  if (definition.category === 'rocket' || definition.category === 'torpedo') return definition.size === 'Capital' ? 12 : 7;
  if (definition.category === 'rail') return 4;
  return 3;
}

function addEffect(effect) {
  effect.maxLife = finite(effect.life, 0.25);
  sim.effects.push(effect);
}

function damageTarget(target, amount, source, weapon) {
  if (!target || target.dead || amount <= 0) return false;
  if (target.__projectile) {
    target.dead = true;
    if (source?.team && sim.stats[source.team]) sim.stats[source.team].hits++;
    addEffect({ type: 'burst', x: target.x, y: target.y, life: 0.18, radius: 24, color: '#ffd58a' });
    return true;
  }
  if (!source || source.team === target.team) return false;

  const stats = sim.stats[source.team];
  let damage = Math.max(0, finite(amount));
  const dealtBefore = damage;
  if (target.shield?.val > 0) {
    const absorbed = Math.min(target.shield.val, damage);
    target.shield.val -= absorbed;
    damage -= absorbed;
    target.shield.regenTimer = target.shield.regenDelay;
  }
  if (damage > 0) target.hp = Math.max(0, target.hp - damage);
  target.hitFlash = 0.12;
  if (stats) {
    stats.hits++;
    stats.damage += Math.min(dealtBefore, (target.shield?.val || 0) + target.hp + dealtBefore);
  }

  if (target.hp <= 0 && !target.dead) {
    target.dead = true;
    target.deadAt = sim.time;
    target.vx *= 0.25;
    target.vy *= 0.25;
    if (stats) stats.kills++;
    addEffect({ type: 'explosion', x: target.x, y: target.y, life: 0.8, radius: Math.max(60, target.radius * 2.1), color: source.color });
    logEvent(`${source.name} zniszczył ${target.name} · ${weapon?.name || 'trafienie'}`, 'kill');
    selection.delete(target);
    if (primarySelection === target) setPrimarySelection(selection.values().next().value || null);
  }
  return true;
}

function detonateProjectile(projectile, x, y) {
  const def = projectile.weapon;
  const radius = Math.max(0, finite(def.explosionRadius ?? def.explodeRadius ?? def.flakBurstRadius));
  if (radius <= 0) {
    if (projectile.target && !projectile.target.dead) damageTarget(projectile.target, def.baseDamage || 0, projectile.source, def);
  } else {
    for (let index = 0; index < sim.units.length; index++) {
      const target = sim.units[index];
      if (!target || target.dead || target.team === projectile.team) continue;
      const dist = Math.hypot(target.x - x, target.y - y);
      if (dist > radius + (target.radius || 0)) continue;
      const edge = clamp(dist / Math.max(1, radius), 0, 1);
      let scale = 1 - edge * 0.65;
      if (def.category === 'flak' && !target.fighter) scale *= finite(def.flakHullFactor, 0.12);
      damageTarget(target, finite(def.baseDamage) * scale, projectile.source, def);
    }
    if (def.category === 'flak') {
      for (let index = 0; index < sim.projectiles.length; index++) {
        const other = sim.projectiles[index];
        if (!other || other.dead || other.team === projectile.team || (other.type !== 'rocket' && other.type !== 'torpedo')) continue;
        if (Math.hypot(other.x - x, other.y - y) <= radius) other.dead = true;
      }
    }
  }
  addEffect({
    type: def.category === 'flak' ? 'flak' : 'explosion',
    x, y, life: def.category === 'flak' ? 0.34 : 0.55,
    radius: Math.max(28, radius || 34), color: def.vfxColor || '#ffb36b'
  });
  projectile.dead = true;
}

function spawnBulletAdapter(owner, target, weaponDef, options = {}) {
  if (!owner || !target || !weaponDef || owner.dead || target.dead) return;
  const exactOrigin = options.hp ? hardpointWorld(owner, options.hp) : null;
  const fallbackOrigin = hardpoints.resolveOwnerHardpointOrigin(owner, weaponDef, options);
  const origin = exactOrigin || fallbackOrigin || { x: owner.x, y: owner.y };
  const speed = weaponDef.baseSpeed;
  const finiteSpeed = Number.isFinite(speed) ? Math.max(1, speed) : Infinity;
  const lead = finiteSpeed < Infinity
    ? getLeadAim(origin, target, finiteSpeed, { x: 0, y: 0 })
    : { x: entityX(target), y: entityY(target) };
  const targetAngle = Math.atan2(lead.y - origin.y, lead.x - origin.x);
  const firingAngle = Number.isFinite(options.angleOverride) ? options.angleOverride : targetAngle;
  const spread = Math.max(0, finite(weaponDef.spread));
  const teamStats = sim.stats[owner.team];
  const burstCount = Math.max(1, Math.min(8, Math.round(finite(weaponDef.burstCount, 1))));

  if (!Number.isFinite(speed) || weaponDef.category === 'beam') {
    if (teamStats) teamStats.shots++;
    damageTarget(target, finite(weaponDef.baseDamage), owner, weaponDef);
    addEffect({
      type: 'beam', x: origin.x, y: origin.y, x2: entityX(target), y2: entityY(target),
      life: Math.max(0.06, finite(weaponDef.duration, 0.1)), radius: 2, color: weaponDef.vfxColor || '#7ffff0'
    });
    return;
  }

  for (let index = 0; index < burstCount; index++) {
    const fan = burstCount > 1 ? (index - (burstCount - 1) * 0.5) * Math.max(0.012, spread * 0.8) : 0;
    const angle = firingAngle + fan + (Math.random() - 0.5) * spread;
    const category = String(options.type || weaponDef.category || 'bullet').toLowerCase();
    const life = Math.max(0.2, finite(weaponDef.baseRange, 1000) / finiteSpeed);
    sim.projectiles.push({
      __projectile: true,
      id: `shot_${sim.nextId++}`,
      x: origin.x,
      y: origin.y,
      prevX: origin.x,
      prevY: origin.y,
      vx: Math.cos(angle) * finiteSpeed + finite(owner.vx),
      vy: Math.sin(angle) * finiteSpeed + finite(owner.vy),
      angle,
      speed: finiteSpeed,
      life,
      maxLife: life,
      radius: projectileRadius(weaponDef),
      type: category,
      owner: TEAM_PROJECTILE_OWNER[owner.team],
      team: owner.team,
      source: owner,
      target,
      weapon: weaponDef,
      color: weaponDef.vfxColor || owner.color,
      dead: false
    });
    if (teamStats) teamStats.shots++;
  }
}

function updateProjectiles(dt) {
  for (let index = 0; index < sim.projectiles.length; index++) {
    const projectile = sim.projectiles[index];
    if (!projectile || projectile.dead) continue;
    projectile.life -= dt;
    projectile.prevX = projectile.x;
    projectile.prevY = projectile.y;

    const homing = projectile.type === 'rocket' || projectile.type === 'torpedo';
    if (homing && projectile.target && !projectile.target.dead) {
      const targetAngle = Math.atan2(entityY(projectile.target) - projectile.y, entityX(projectile.target) - projectile.x);
      const turnRate = Math.max(0.15, finite(projectile.weapon.turnRate, 180) * Math.PI / 180);
      const delta = clamp(wrapAngle(targetAngle - projectile.angle), -turnRate * dt, turnRate * dt);
      projectile.angle = wrapAngle(projectile.angle + delta);
      projectile.vx = Math.cos(projectile.angle) * projectile.speed;
      projectile.vy = Math.sin(projectile.angle) * projectile.speed;
    }

    projectile.x += projectile.vx * dt;
    projectile.y += projectile.vy * dt;

    if (projectile.target?.__projectile && !projectile.target.dead) {
      const hitRadius = projectile.radius + (projectile.target.radius || 5);
      if (segmentPointDistanceSq(projectile.prevX, projectile.prevY, projectile.x, projectile.y, projectile.target.x, projectile.target.y) <= hitRadius * hitRadius) {
        damageTarget(projectile.target, finite(projectile.weapon.baseDamage), projectile.source, projectile.weapon);
        projectile.dead = true;
        continue;
      }
    }

    if (projectile.weapon.category === 'flak') {
      const fuse = Math.max(12, finite(projectile.weapon.flakFuseRadius, 34));
      const targetDistance = projectile.target && !projectile.target.dead
        ? Math.hypot(entityX(projectile.target) - projectile.x, entityY(projectile.target) - projectile.y)
        : Infinity;
      if (targetDistance <= fuse || projectile.life <= 0) {
        detonateProjectile(projectile, projectile.x, projectile.y);
        continue;
      }
    }

    let hit = null;
    let bestDistanceSq = Infinity;
    for (let unitIndex = 0; unitIndex < sim.units.length; unitIndex++) {
      const target = sim.units[unitIndex];
      if (!target || target.dead || target.team === projectile.team) continue;
      const hitRadius = (target.radius || 8) + projectile.radius;
      const distanceSq = segmentPointDistanceSq(projectile.prevX, projectile.prevY, projectile.x, projectile.y, target.x, target.y);
      if (distanceSq <= hitRadius * hitRadius && distanceSq < bestDistanceSq) {
        hit = target;
        bestDistanceSq = distanceSq;
      }
    }

    if (hit) {
      if (homing || finite(projectile.weapon.explosionRadius ?? projectile.weapon.explodeRadius) > 0) {
        projectile.target = hit;
        detonateProjectile(projectile, projectile.x, projectile.y);
      } else {
        damageTarget(hit, finite(projectile.weapon.baseDamage), projectile.source, projectile.weapon);
        addEffect({ type: 'hit', x: projectile.x, y: projectile.y, life: 0.16, radius: 18, color: projectile.color });
        projectile.dead = true;
      }
    } else if (projectile.life <= 0) {
      if (homing && finite(projectile.weapon.explosionRadius) > 0) detonateProjectile(projectile, projectile.x, projectile.y);
      else projectile.dead = true;
    }
  }

  let write = 0;
  for (let read = 0; read < sim.projectiles.length; read++) {
    const projectile = sim.projectiles[read];
    if (projectile && !projectile.dead) sim.projectiles[write++] = projectile;
  }
  sim.projectiles.length = write;
}

function updateEffects(dt) {
  let write = 0;
  for (let index = 0; index < sim.effects.length; index++) {
    const effect = sim.effects[index];
    effect.life -= dt;
    if (effect.life > 0) sim.effects[write++] = effect;
  }
  sim.effects.length = write;
}

function queueHangarLaunch(carrier, hp, index) {
  const origin = hardpointWorld(carrier, hp) || { x: carrier.x, y: carrier.y };
  const side = index % 2 === 0 ? 1 : -1;
  sim.pendingSpawns.push({
    entryId: 'multirole',
    team: carrier.team,
    x: origin.x + Math.cos(carrier.angle + side * Math.PI / 2) * 25,
    y: origin.y + Math.sin(carrier.angle + side * Math.PI / 2) * 25,
    angle: carrier.angle,
    carrier,
    slot: index
  });
}

function updateNpcHangars(unit, dt) {
  if (!ui.hangarLaunches.checked || !unit || unit.dead || unit.fighter || unit.combatDisabled) return;
  const tubes = (unit.editorHardpoints || []).filter((hp) => hp && hp.type === 'hangar' && !hp.destroyed);
  if (!tubes.length) return;
  const enemy = aiPickBestTarget(unit, 9000);
  if (!enemy) return;
  unit.__hangarFighters = (unit.__hangarFighters || []).filter((fighter) => fighter && !fighter.dead);
  const capacity = Math.min(tubes.length, 5) * 4;
  if (unit.__hangarFighters.length >= capacity) return;
  unit.__hangarCd = Math.max(0, finite(unit.__hangarCd) - dt);
  if (unit.__hangarCd > 0) return;
  const count = Math.min(4, capacity - unit.__hangarFighters.length);
  for (let index = 0; index < count; index++) queueHangarLaunch(unit, tubes[index % tubes.length], unit.__hangarFighters.length + index);
  unit.__hangarCd = 4.5 + Math.random() * 2.5;
}

function flushPendingSpawns() {
  if (!sim.pendingSpawns.length) return;
  for (let index = 0; index < sim.pendingSpawns.length; index++) {
    const request = sim.pendingSpawns[index];
    if (!request.carrier || request.carrier.dead) continue;
    const fighter = spawnUnit(request.entryId, request.team, request.x, request.y, { angle: request.angle });
    fighter.vx = request.carrier.vx;
    fighter.vy = request.carrier.vy;
    fighter.vel.x = fighter.vx;
    fighter.vel.y = fighter.vy;
    fighter.squad = { leader: request.carrier };
    fighter.__carrierParent = request.carrier;
    const side = request.slot % 2 === 0 ? 1 : -1;
    const row = Math.floor(request.slot / 2) + 1;
    fighter.formationOffset = { x: -row * 70, y: side * row * 48 };
    request.carrier.__hangarFighters.push(fighter);
  }
  sim.pendingSpawns.length = 0;
}

function npcRotationStep(unit, dt) {
  let desired = Number.isFinite(unit.desiredAngle) ? unit.desiredAngle : NaN;
  if (!Number.isFinite(desired) && !unit.keepAngle && unit.vx * unit.vx + unit.vy * unit.vy > 25) {
    desired = Math.atan2(unit.vy, unit.vx);
    unit.desiredAngle = desired;
  }
  const frameNorm = dt / FIXED_DT;
  const friction = clamp(finite(unit.angularFriction, SHIP_PHYSICS.ANGULAR_FRICTION), 0, 1);
  if (!Number.isFinite(desired)) {
    unit.angVel = finite(unit.angVel) * Math.pow(friction, frameNorm);
    unit.angle = wrapAngle(unit.angle + unit.angVel * dt);
    return;
  }
  const maxTurn = Math.max(0.01, finite(unit.turn, 1));
  const desiredSpin = clamp(wrapAngle(desired - unit.angle) * finite(unit.turnKp, 5.5), -maxTurn, maxTurn);
  const maxDelta = Math.max(0, finite(unit.turnAccel, maxTurn * 4)) * dt;
  unit.angVel = finite(unit.angVel) + clamp(desiredSpin - finite(unit.angVel), -maxDelta, maxDelta);
  unit.angVel *= Math.pow(friction, frameNorm);
  unit.angVel = clamp(unit.angVel, -maxTurn, maxTurn);
  unit.angle = wrapAngle(unit.angle + unit.angVel * dt);
}

function updateShield(unit, dt) {
  if (!unit.shield || unit.shield.max <= 0) return;
  if (unit.shield.regenTimer > 0) unit.shield.regenTimer = Math.max(0, unit.shield.regenTimer - dt);
  else if (unit.shield.val < unit.shield.max) unit.shield.val = Math.min(unit.shield.max, unit.shield.val + unit.shield.regenRate * dt);
}

function updateTrail(unit, dt) {
  if (!ui.showTrails.checked) {
    if (unit.trail.length) unit.trail.length = 0;
    return;
  }
  unit.trailTimer -= dt;
  if (unit.trailTimer > 0) return;
  unit.trailTimer = unit.fighter ? 0.08 : 0.14;
  unit.trail.push({ x: unit.x, y: unit.y });
  if (unit.trail.length > 42) unit.trail.shift();
}

function applyBodyCollisions() {
  if (!ui.bodyCollisions.checked) return;
  const units = sim.units;
  for (let leftIndex = 0; leftIndex < units.length; leftIndex++) {
    const left = units[leftIndex];
    if (!left || left.dead || left.isCollidable === false) continue;
    for (let rightIndex = leftIndex + 1; rightIndex < units.length; rightIndex++) {
      const right = units[rightIndex];
      if (!right || right.dead || right.isCollidable === false) continue;
      const dx = right.x - left.x;
      const dy = right.y - left.y;
      const minDistance = (left.radius || 10) + (right.radius || 10);
      const distSq = dx * dx + dy * dy;
      if (distSq >= minDistance * minDistance) continue;
      const distance = Math.sqrt(distSq) || 0.001;
      const nx = dx / distance;
      const ny = dy / distance;
      const invMassLeft = 1 / Math.max(0.1, left.mass || 1);
      const invMassRight = 1 / Math.max(0.1, right.mass || 1);
      const invMassSum = invMassLeft + invMassRight;
      const overlap = minDistance - distance;
      const correction = overlap / invMassSum * 0.72;
      left.x -= nx * correction * invMassLeft;
      left.y -= ny * correction * invMassLeft;
      right.x += nx * correction * invMassRight;
      right.y += ny * correction * invMassRight;

      const relNormal = (right.vx - left.vx) * nx + (right.vy - left.vy) * ny;
      if (relNormal < 0) {
        const impulse = -(1.08 * relNormal) / invMassSum;
        left.vx -= impulse * nx * invMassLeft;
        left.vy -= impulse * ny * invMassLeft;
        right.vx += impulse * nx * invMassRight;
        right.vy += impulse * ny * invMassRight;
      }
      left.pos.x = left.x;
      left.pos.y = left.y;
      right.pos.x = right.x;
      right.pos.y = right.y;
    }
  }
}

function refreshLayoutsIfNeeded(dt) {
  if (!hardpoints.pollCache(dt)) return;
  for (let index = 0; index < sim.units.length; index++) applyCurrentLayout(sim.units[index]);
  logEvent(`Zaktualizowano layouty hardpointów · wersja ${hardpoints.version}`, 'info');
}

function cleanupDeadUnits() {
  for (let index = sim.units.length - 1; index >= 0; index--) {
    const unit = sim.units[index];
    if (!unit.dead || sim.time - finite(unit.deadAt, sim.time) < 4) continue;
    selection.delete(unit);
    sim.units.splice(index, 1);
  }
  if (primarySelection?.dead && !sim.units.includes(primarySelection)) setPrimarySelection(selection.values().next().value || null);
}

function simulationStep(dt) {
  sim.time += dt;
  sim.frameId++;
  window.__frameId = sim.frameId;
  refreshLayoutsIfNeeded(dt);
  rebuildAIGrid(sim.units, false);
  updateFleetCoordinator(sim.units, null, dt);
  window.__aiWeaponScanMs = 0;
  window.__aiTargetPickMs = 0;
  const aiStarted = performance.now();

  const countAtStart = sim.units.length;
  for (let index = 0; index < countAtStart; index++) {
    const unit = sim.units[index];
    if (!unit || unit.dead) continue;
    updateShield(unit, dt);
    unit.hitFlash = Math.max(0, finite(unit.hitFlash) - dt);
    unit.__npcFlightIntegrated = false;
    if (unit.aiEnabled && unit.ai) unit.ai(dt);

    if (unit.__npcFlightIntegrated) {
      unit.__npcFlightIntegrated = false;
    } else {
      if (!Number.isFinite(unit.vx)) unit.vx = 0;
      if (!Number.isFinite(unit.vy)) unit.vy = 0;
      unit.x += unit.vx * dt;
      unit.y += unit.vy * dt;
      const drag = Math.pow(clamp(finite(unit.friction, 1), 0.8, 1), dt / FIXED_DT);
      unit.vx *= drag;
      unit.vy *= drag;
      npcRotationStep(unit, dt);
      unit.pos.x = unit.x;
      unit.pos.y = unit.y;
      unit.vel.x = unit.vx;
      unit.vel.y = unit.vy;
    }
    updateTrail(unit, dt);
  }

  sim.lastAiMs = performance.now() - aiStarted;
  flushPendingSpawns();
  applyBodyCollisions();
  updateProjectiles(dt);
  updateEffects(dt);
  cleanupDeadUnits();
}

