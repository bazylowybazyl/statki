    clear: clearSimulation,
    fit: fitCameraToUnits,
    get selected() {
      return primarySelection;
    },
    select(unit) {
      setPrimarySelection(unit || null);
      return primarySelection;
    }
  };
}

function clearSimulation({ keepLog = false } = {}) {
  sim.units.length = 0;
  sim.projectiles.length = 0;
  sim.effects.length = 0;
  sim.pendingSpawns.length = 0;
  sim.time = 0;
  sim.accumulator = 0;
  sim.nextId = 1;
  sim.stats.blue = { shots: 0, hits: 0, damage: 0, kills: 0 };
  sim.stats.red = { shots: 0, hits: 0, damage: 0, kills: 0 };
  selection.clear();
  setPrimarySelection(null);
  victoryState = '';
  if (!keepLog) ui.combatLog.replaceChildren();
}

function spawnFleetSide(team, x, facing, composition) {
  const direction = team === TEAM.BLUE ? 1 : -1;
  for (let index = 0; index < composition.length; index++) {
    const spec = composition[index];
    if (spec.id === 'multirole' || spec.id === 'interceptor' || spec.id === 'strike') {
      spawnFighterGroup(spec.id, team, spec.count, x - direction * finite(spec.depth), finite(spec.y), facing);
      continue;
    }
    for (let copy = 0; copy < spec.count; copy++) {
      const y = finite(spec.y) + (copy - (spec.count - 1) * 0.5) * finite(spec.spacing, 620);
      spawnUnit(spec.id, team, x - direction * finite(spec.depth), y, { angle: facing });
    }
  }
}

function spawnFighterReinforcements(team, count = 50, placement = {}) {
  const total = Math.max(1, Math.round(finite(count, 50)));
  const direction = team === TEAM.BLUE ? 1 : -1;
  const fallbackX = camera.x + (team === TEAM.BLUE ? -1 : 1) * viewport.width / Math.max(0.01, camera.zoom) * 0.3;
  const x = finite(placement.x, fallbackX);
  const y = finite(placement.y, camera.y);
  const facing = finite(placement.facing, team === TEAM.BLUE ? 0 : Math.PI);
  const interceptorCount = Math.floor(total * 0.3);
  const strikeCount = Math.floor(total * 0.3);
  const multiroleCount = total - interceptorCount - strikeCount;
  const groups = [
    { id: 'interceptor', count: interceptorCount, y: y - 1350 },
    { id: 'multirole', count: multiroleCount, y },
    { id: 'strike', count: strikeCount, y: y + 1350 }
  ];

  for (let index = 0; index < groups.length; index++) {
    const group = groups[index];
    if (group.count <= 0) continue;
    spawnFighterGroup(group.id, team, group.count, x - direction * index * 220, group.y, facing);
  }

  victoryState = '';
  if (placement.log !== false) {
    const side = team === TEAM.BLUE ? 'friendly' : 'enemy';
    logEvent(`Spawn ${total} ${side} fighters · ${interceptorCount} interceptor / ${multiroleCount} multirole / ${strikeCount} strike`, 'info');
  }
}

function spawnBigBattleSide(team) {
  const direction = team === TEAM.BLUE ? 1 : -1;
  const facing = team === TEAM.BLUE ? 0 : Math.PI;
  const baseX = team === TEAM.BLUE ? -5200 : 5200;
  const capitalX = baseX - direction * 2000;
  const capitalTypes = ['atlas', 'supercapital', 'carrier'];
  const capitalY = [-3000, 0, 3000];

  for (let index = 0; index < capitalTypes.length; index++) {
    spawnUnit(capitalTypes[index], team, capitalX, capitalY[index], { angle: facing });
  }
  for (let index = 0; index < 5; index++) {
    spawnUnit('battleship', team, baseX - direction * 1100, (index - 2) * 1600, { angle: facing });
  }
  for (let index = 0; index < 10; index++) {
    spawnUnit('destroyer', team, baseX, (index - 4.5) * 950, { angle: facing });
  }
  for (let index = 0; index < 15; index++) {
    const frigateType = index % 2 === 0 ? 'frigate_pd' : 'frigate_laser';
    spawnUnit(frigateType, team, baseX + direction * 900, (index - 7) * 650, { angle: facing });
  }
  spawnFighterReinforcements(team, 50, {
    x: baseX + direction * 2000,
    y: 0,
    facing,
    log: false
  });
}

function runScenario(id) {
  clearSimulation();
  if (id === 'empty') {
    logEvent('Pusty poligon gotowy.', 'info');
    camera.x = 0;
    camera.y = 0;
    camera.zoom = 0.12;
    return;
  }

  if (id === 'big') {
    spawnBigBattleSide(TEAM.BLUE);
    spawnBigBattleSide(TEAM.RED);
    logEvent('Big battle: 3 capitale, 5 battleshipów, 10 destroyerów, 15 fregat i 50 myśliwców na stronę.', 'info');
  } else if (id === 'fighters') {
    spawnFighterGroup('interceptor', TEAM.BLUE, 9, -2600, -300, 0);
    spawnFighterGroup('multirole', TEAM.BLUE, 9, -2800, 500, 0);
    spawnFighterGroup('interceptor', TEAM.RED, 9, 2600, 300, Math.PI);
    spawnFighterGroup('strike', TEAM.RED, 9, 2800, -500, Math.PI);
  } else if (id === 'duel') {
    spawnUnit('battleship', TEAM.BLUE, -2300, 0, { angle: 0 });
    spawnUnit('battleship', TEAM.RED, 2300, 0, { angle: Math.PI });
  } else if (id === 'capital') {
    spawnUnit('atlas', TEAM.BLUE, -5200, 0, { angle: 0 });
    spawnUnit('supercapital', TEAM.RED, 5200, 0, { angle: Math.PI });
  } else if (id === 'line') {
    const line = [
      { id: 'battleship', count: 3, y: 0, spacing: 1100 },
      { id: 'destroyer', count: 4, y: 0, spacing: 850, depth: 700 },
      { id: 'frigate_pd', count: 4, y: 0, spacing: 700, depth: 1200 }
    ];
    spawnFleetSide(TEAM.BLUE, -6200, 0, line);
    spawnFleetSide(TEAM.RED, 6200, Math.PI, line);
  } else {
    const mixed = [
      { id: 'battleship', count: 1, y: 0 },
      { id: 'destroyer', count: 2, y: 0, spacing: 1100, depth: 450 },
      { id: 'frigate_pd', count: 2, y: 0, spacing: 1700, depth: 900 },
      { id: 'multirole', count: 6, y: -950, depth: 350 }
    ];
    spawnFleetSide(TEAM.BLUE, -5000, 0, mixed);
    spawnFleetSide(TEAM.RED, 5000, Math.PI, mixed);
  }
  logEvent(`Uruchomiono scenariusz: ${id}`, 'info');
  requestAnimationFrame(() => fitCameraToUnits());
}

function resizeCanvas() {
  const rect = ui.canvas.getBoundingClientRect();
  viewport.width = Math.max(1, rect.width);
  viewport.height = Math.max(1, rect.height);
  viewport.dpr = Math.min(2, window.devicePixelRatio || 1);
  const targetWidth = Math.round(viewport.width * viewport.dpr);
  const targetHeight = Math.round(viewport.height * viewport.dpr);
  if (ui.canvas.width !== targetWidth || ui.canvas.height !== targetHeight) {
    ui.canvas.width = targetWidth;
    ui.canvas.height = targetHeight;
  }
}

function screenToWorld(screenX, screenY) {
  return {
    x: camera.x + (screenX - viewport.width * 0.5) / camera.zoom,
    y: camera.y + (screenY - viewport.height * 0.5) / camera.zoom
  };
}

function worldToScreen(x, y) {
  return {
    x: (x - camera.x) * camera.zoom + viewport.width * 0.5,
    y: (y - camera.y) * camera.zoom + viewport.height * 0.5
  };
}

function fitCameraToUnits() {
  const live = sim.units.filter((unit) => unit && !unit.dead);
  if (!live.length) {
    camera.x = 0;
    camera.y = 0;
    camera.zoom = 0.12;
    ui.cameraReadout.textContent = `zoom ${Math.round(camera.zoom * 100)}%`;
    return;
  }
  let minX = Infinity;
  let maxX = -Infinity;
  let minY = Infinity;
  let maxY = -Infinity;
  for (let index = 0; index < live.length; index++) {
    const unit = live[index];
    const pad = Math.max(unit.radius, unit.w * 0.25, 80);
    minX = Math.min(minX, unit.x - pad);
    maxX = Math.max(maxX, unit.x + pad);
    minY = Math.min(minY, unit.y - pad);
    maxY = Math.max(maxY, unit.y + pad);
  }
  camera.x = (minX + maxX) * 0.5;
  camera.y = (minY + maxY) * 0.5;
  const spanX = Math.max(600, maxX - minX);
  const spanY = Math.max(600, maxY - minY);
  camera.zoom = clamp(Math.min(viewport.width / spanX, viewport.height / spanY) * 0.82, camera.minZoom, camera.maxZoom);
  ui.cameraReadout.textContent = `zoom ${Math.round(camera.zoom * 100)}%`;
}

function drawBackground() {
  ctx.setTransform(viewport.dpr, 0, 0, viewport.dpr, 0, 0);
  const gradient = ctx.createRadialGradient(viewport.width * 0.5, viewport.height * 0.45, 20, viewport.width * 0.5, viewport.height * 0.5, Math.max(viewport.width, viewport.height));
  gradient.addColorStop(0, '#09131d');
  gradient.addColorStop(0.55, '#050b11');
  gradient.addColorStop(1, '#020509');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, viewport.width, viewport.height);
  for (let index = 0; index < backgroundStars.length; index++) {
    const star = backgroundStars[index];
    const parallaxX = ((star.x * viewport.width - camera.x * 0.008) % viewport.width + viewport.width) % viewport.width;
    const parallaxY = ((star.y * viewport.height - camera.y * 0.008) % viewport.height + viewport.height) % viewport.height;
    ctx.globalAlpha = star.alpha;
    ctx.fillStyle = '#b7d7ea';
    ctx.fillRect(parallaxX, parallaxY, star.size, star.size);
  }
  ctx.globalAlpha = 1;
}

function chooseGridStep() {
  const wantedWorld = 110 / camera.zoom;
  const magnitude = 10 ** Math.floor(Math.log10(Math.max(1, wantedWorld)));
  const normalized = wantedWorld / magnitude;
  if (normalized < 2) return 2 * magnitude;
  if (normalized < 5) return 5 * magnitude;
  return 10 * magnitude;
}

function applyWorldTransform() {
  const scale = viewport.dpr * camera.zoom;
  ctx.setTransform(
    scale, 0, 0, scale,
    viewport.dpr * (viewport.width * 0.5 - camera.x * camera.zoom),
    viewport.dpr * (viewport.height * 0.5 - camera.y * camera.zoom)
  );
}

function drawGrid() {
  const step = chooseGridStep();
  const left = camera.x - viewport.width / camera.zoom * 0.5;
  const right = camera.x + viewport.width / camera.zoom * 0.5;
  const top = camera.y - viewport.height / camera.zoom * 0.5;
  const bottom = camera.y + viewport.height / camera.zoom * 0.5;
  ctx.lineWidth = 1 / camera.zoom;
  ctx.strokeStyle = 'rgba(73, 112, 139, .14)';
  ctx.beginPath();
  for (let x = Math.floor(left / step) * step; x <= right; x += step) {
    ctx.moveTo(x, top);
    ctx.lineTo(x, bottom);
  }
  for (let y = Math.floor(top / step) * step; y <= bottom; y += step) {
    ctx.moveTo(left, y);
    ctx.lineTo(right, y);
  }
  ctx.stroke();
  ctx.strokeStyle = 'rgba(100, 166, 201, .24)';
  ctx.beginPath();
  ctx.moveTo(left, 0);
  ctx.lineTo(right, 0);
  ctx.moveTo(0, top);
  ctx.lineTo(0, bottom);
  ctx.stroke();
}

function drawTrails() {
  if (!ui.showTrails.checked) return;
  ctx.lineWidth = 1.2 / camera.zoom;
  for (let unitIndex = 0; unitIndex < sim.units.length; unitIndex++) {
    const unit = sim.units[unitIndex];
    if (!unit || unit.trail.length < 2) continue;
    ctx.strokeStyle = unit.team === TEAM.BLUE ? 'rgba(98,168,255,.28)' : 'rgba(255,100,125,.28)';
    ctx.beginPath();
    for (let index = 0; index < unit.trail.length; index++) {
      const point = unit.trail[index];
      if (index === 0) ctx.moveTo(point.x, point.y);
      else ctx.lineTo(point.x, point.y);
    }
    ctx.stroke();
  }
}

function drawEffects() {
  for (let index = 0; index < sim.effects.length; index++) {
    const effect = sim.effects[index];
    const t = clamp(effect.life / effect.maxLife, 0, 1);
    ctx.save();
    ctx.globalAlpha = t;
    ctx.strokeStyle = effect.color || '#fff';
    ctx.fillStyle = effect.color || '#fff';
    if (effect.type === 'beam') {
      ctx.lineWidth = (1.5 + t * 3) / camera.zoom;
      ctx.beginPath();
      ctx.moveTo(effect.x, effect.y);
      ctx.lineTo(effect.x2, effect.y2);
      ctx.stroke();
    } else {
      const progress = 1 - t;
      const radius = Math.max(3, effect.radius * (0.2 + progress * 0.8));
      ctx.lineWidth = (effect.type === 'flak' ? 2.5 : 1.5) / camera.zoom;
      ctx.beginPath();
      ctx.arc(effect.x, effect.y, radius, 0, TWO_PI);
      ctx.stroke();
      if (effect.type === 'explosion') {
        ctx.globalAlpha *= 0.18;
        ctx.fill();
      }
    }
    ctx.restore();
  }
}

function drawProjectiles() {
  for (let index = 0; index < sim.projectiles.length; index++) {
    const projectile = sim.projectiles[index];
    ctx.save();
    ctx.strokeStyle = projectile.color;
    ctx.fillStyle = projectile.color;
    ctx.globalAlpha = 0.9;
    const rocket = projectile.type === 'rocket' || projectile.type === 'torpedo';
    ctx.lineWidth = (rocket ? 2.4 : 1.3) / camera.zoom;
    ctx.beginPath();
    ctx.moveTo(projectile.prevX, projectile.prevY);
    ctx.lineTo(projectile.x, projectile.y);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(projectile.x, projectile.y, Math.max(projectile.radius, 1.7 / camera.zoom), 0, TWO_PI);
    ctx.fill();
    if (rocket) {
      ctx.globalAlpha = 0.38;
      ctx.beginPath();
      ctx.moveTo(projectile.x, projectile.y);
      ctx.lineTo(projectile.x - Math.cos(projectile.angle) * 42, projectile.y - Math.sin(projectile.angle) * 42);
      ctx.stroke();
    }
    ctx.restore();
  }
}

function drawThrusters(unit) {
  if (!ui.showThrusters.checked || unit.fighter || unit.dead) return;
  const angle = unit.angle + finite(unit.capitalProfile?.spriteRotation);
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  const groups = [unit.visual?.mainThrusters || [], unit.visual?.torqueThrusters || []];
  for (let groupIndex = 0; groupIndex < groups.length; groupIndex++) {
    const group = groups[groupIndex];
    for (let index = 0; index < group.length; index++) {
      const thruster = group[index];
      const ox = finite(thruster.offset?.x);
      const oy = finite(thruster.offset?.y);
      const x = unit.x + ox * cos - oy * sin;
      const y = unit.y + ox * sin + oy * cos;
      const fx = finite(thruster.forward?.x, 1);
      const fy = finite(thruster.forward?.y);
      const worldFx = fx * cos - fy * sin;
      const worldFy = fx * sin + fy * cos;
      const throttle = clamp(finite(thruster.__throttle), 0, 1);
      const length = (8 + throttle * 54) / camera.zoom;
      ctx.strokeStyle = groupIndex === 0 ? `rgba(84,205,255,${0.24 + throttle * 0.72})` : `rgba(255,194,92,${0.22 + throttle * 0.72})`;
      ctx.lineWidth = (1.2 + throttle * 2.2) / camera.zoom;
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x - worldFx * length, y - worldFy * length);
      ctx.stroke();
    }
  }
}

function drawHardpoints(unit) {
  if (!ui.showHardpoints.checked || unit.fighter || unit.dead) return;
  const list = unit.editorHardpoints || [];
  for (let index = 0; index < list.length; index++) {
    const hp = list[index];
    const point = hardpointWorld(unit, hp);
    if (!point) continue;
    const color = hardpoints.colors[hp.type] || '#d5e6ef';
    ctx.fillStyle = hp.mount ? color : 'rgba(126,145,158,.65)';
    ctx.beginPath();
    ctx.arc(point.x, point.y, Math.max(2.2 / camera.zoom, unit.fighter ? 2 : 3), 0, TWO_PI);
    ctx.fill();
    const autonomous = unit.autoWeapons?.find((weapon) => weapon.hpOffset === hp);
    if (autonomous) {
      const angle = Number.isFinite(autonomous.visualAngle)
        ? autonomous.visualAngle
        : unit.angle + finite(autonomous.mountAngle);
      ctx.strokeStyle = color;
      ctx.globalAlpha = 0.62;
      ctx.lineWidth = 1 / camera.zoom;
      ctx.beginPath();
      ctx.moveTo(point.x, point.y);
      ctx.lineTo(point.x + Math.cos(angle) * 34 / camera.zoom, point.y + Math.sin(angle) * 34 / camera.zoom);
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }
}

function drawDebugVectors(unit) {
  if (!ui.showVectors.checked || unit.dead) return;
  const speed = Math.hypot(unit.vx, unit.vy);
  if (speed > 1) {
    ctx.strokeStyle = 'rgba(102, 224, 255, .62)';
    ctx.lineWidth = 1.2 / camera.zoom;
    ctx.beginPath();
    ctx.moveTo(unit.x, unit.y);
    ctx.lineTo(unit.x + unit.vx * 0.24, unit.y + unit.vy * 0.24);
    ctx.stroke();
  }
  const target = unit.forceTarget && !unit.forceTarget.dead ? unit.forceTarget : unit.target;
  if (target && !target.dead) {
    ctx.setLineDash([8 / camera.zoom, 7 / camera.zoom]);
    ctx.strokeStyle = 'rgba(255, 214, 119, .25)';
    ctx.lineWidth = 1 / camera.zoom;
    ctx.beginPath();
    ctx.moveTo(unit.x, unit.y);
    ctx.lineTo(entityX(target), entityY(target));
    ctx.stroke();
    ctx.setLineDash([]);
  }
  const slot = getBattleSlot(unit);
  if (slot?.kind === 'line') {
    ctx.strokeStyle = 'rgba(140, 255, 168, .55)';
    ctx.lineWidth = 1 / camera.zoom;
    const arm = 10 / camera.zoom;
    ctx.beginPath();
    ctx.moveTo(slot.x - arm, slot.y);
    ctx.lineTo(slot.x + arm, slot.y);
    ctx.moveTo(slot.x, slot.y - arm);
    ctx.lineTo(slot.x, slot.y + arm);
    ctx.stroke();
  }
}

function drawUnitBody(unit) {
  const selected = selection.has(unit);
  const minRadius = 5 / camera.zoom;
  const drawRadius = Math.max(unit.radius, minRadius);
  ctx.save();
  ctx.translate(unit.x, unit.y);
  ctx.rotate(unit.angle + finite(unit.capitalProfile?.spriteRotation));
  if (unit.dead) ctx.globalAlpha = clamp(1 - (sim.time - unit.deadAt) / 4, 0, 0.42);
  if (unit.sprite?.ready && !unit.fighter) {
    ctx.drawImage(unit.sprite.image, -unit.w * 0.5, -unit.h * 0.5, unit.w, unit.h);
    ctx.strokeStyle = unit.hitFlash > 0 ? '#ffffff' : unit.color;
    ctx.lineWidth = (selected ? 2.4 : 1.1) / camera.zoom;
    ctx.globalAlpha = unit.dead ? ctx.globalAlpha : (selected ? 0.95 : 0.62);
    ctx.strokeRect(-unit.w * 0.5, -unit.h * 0.5, unit.w, unit.h);
  } else if (unit.fighter) {
    const r = drawRadius;
    ctx.fillStyle = unit.hitFlash > 0 ? '#ffffff' : unit.color;
    ctx.beginPath();
    ctx.moveTo(r * 1.35, 0);
    ctx.lineTo(-r, -r * 0.72);
    ctx.lineTo(-r * 0.55, 0);
    ctx.lineTo(-r, r * 0.72);
    ctx.closePath();
    ctx.fill();
  } else {
    ctx.fillStyle = unit.hitFlash > 0 ? '#ffffff' : unit.color;
    ctx.beginPath();
    ctx.moveTo(drawRadius * 1.3, 0);
    ctx.lineTo(-drawRadius, -drawRadius * 0.65);
    ctx.lineTo(-drawRadius * 0.8, drawRadius * 0.65);
    ctx.closePath();
    ctx.fill();
  }
  ctx.restore();

  if (selected && !unit.dead) {
    ctx.strokeStyle = '#e7f7ff';
    ctx.lineWidth = 1.7 / camera.zoom;
    ctx.setLineDash([8 / camera.zoom, 5 / camera.zoom]);
    ctx.beginPath();
    ctx.arc(unit.x, unit.y, Math.max(unit.radius * 1.35, 14 / camera.zoom), 0, TWO_PI);
    ctx.stroke();
    ctx.setLineDash([]);
  }
}

function drawUnitHud(unit) {
  if (unit.dead) return;
  const screen = worldToScreen(unit.x, unit.y);
  const visibleRadius = Math.max(7, unit.radius * camera.zoom);
  if (screen.x < -100 || screen.y < -100 || screen.x > viewport.width + 100 || screen.y > viewport.height + 100) return;
  ctx.setTransform(viewport.dpr, 0, 0, viewport.dpr, 0, 0);
  const width = unit.fighter ? 26 : clamp(unit.w * camera.zoom * 0.42, 36, 84);
  const x = screen.x - width * 0.5;
  const y = screen.y - visibleRadius - 14;
  ctx.fillStyle = 'rgba(3, 8, 12, .78)';
  ctx.fillRect(x, y, width, 4);
  ctx.fillStyle = unit.team === TEAM.BLUE ? '#5a9def' : '#e6536c';
  ctx.fillRect(x, y, width * clamp(unit.hp / unit.maxHp, 0, 1), 2);
  if (unit.shield.max > 0) {
    ctx.fillStyle = '#68dbff';
    ctx.fillRect(x, y + 2, width * clamp(unit.shield.val / unit.shield.max, 0, 1), 2);
  }
  if (selection.has(unit) || camera.zoom > 0.18) {
    ctx.font = '9px ui-monospace, SFMono-Regular, Consolas, monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = selection.has(unit) ? '#eefaff' : 'rgba(181,204,219,.72)';
    ctx.fillText(unit.catalogEntry.label, screen.x, y - 4);
  }
  applyWorldTransform();
}

function render() {
  resizeCanvas();
  drawBackground();
  applyWorldTransform();
  drawGrid();
  drawTrails();
  drawEffects();
  drawProjectiles();
  for (let index = 0; index < sim.units.length; index++) drawThrusters(sim.units[index]);
  for (let index = 0; index < sim.units.length; index++) drawUnitBody(sim.units[index]);
  for (let index = 0; index < sim.units.length; index++) drawHardpoints(sim.units[index]);
  for (let index = 0; index < sim.units.length; index++) drawDebugVectors(sim.units[index]);
  for (let index = 0; index < sim.units.length; index++) drawUnitHud(sim.units[index]);
}

function countHardpoints(unit) {
  const counts = Object.fromEntries(HP_TYPES.map((type) => [type, 0]));
  for (const hp of unit?.editorHardpoints || []) counts[hp.type] = (counts[hp.type] || 0) + 1;
  return counts;
}

function setPrimarySelection(unit, additive = false) {
  if (!additive) selection.clear();
  if (unit) {
    if (additive && selection.has(unit)) selection.delete(unit);
    else selection.add(unit);
  }
  primarySelection = unit && selection.has(unit) ? unit : (selection.values().next().value || null);
  refreshInspector(true);
}

function unitAtScreen(screenX, screenY) {
  let best = null;
  let bestSq = Infinity;
  for (let index = sim.units.length - 1; index >= 0; index--) {
    const unit = sim.units[index];
    if (!unit || unit.dead) continue;
    const screen = worldToScreen(unit.x, unit.y);
    const radius = Math.max(9, unit.radius * camera.zoom, Math.min(34, unit.h * camera.zoom * 0.35));
    const dx = screen.x - screenX;
    const dy = screen.y - screenY;
    const distanceSq = dx * dx + dy * dy;
    if (distanceSq <= radius * radius && distanceSq < bestSq) {
      best = unit;
      bestSq = distanceSq;
    }
  }
  return best;
}

function populateWeaponSelect(select, mountType) {
  const fragment = document.createDocumentFragment();
  for (const weapon of Object.values(MASTER_WEAPONS)) {
    if (!weapon || weapon.mountType !== mountType || weapon.category === 'hangar') continue;
    const option = document.createElement('option');
    option.value = weapon.id;
    option.textContent = `${weapon.name} · ${weapon.size || '—'}`;
    fragment.appendChild(option);
  }
  select.replaceChildren(fragment);
}

function refreshHardpointSummary(unit) {
  const counts = countHardpoints(unit);
  const rows = HP_TYPES.filter((type) => counts[type] > 0).map((type) => {
    const mounted = unit.weapons?.[type]?.length || 0;
    return `<div><span>${type}</span><strong>${mounted}/${counts[type]}</strong></div>`;
  });
  if (unit.fighter) rows.push(`<div><span>gun</span><strong>${unit.gun}</strong></div><div><span>missile</span><strong>${unit.msl} × ${unit.mslAmmo}</strong></div>`);
  ui.hardpointSummary.innerHTML = rows.join('') || '<div><span>brak hardpointów</span><strong>—</strong></div>';
}

function refreshInspector(force = false) {
  const unit = primarySelection && !primarySelection.dead ? primarySelection : null;
  if (!unit) {
    ui.emptyInspector.classList.remove('hidden');
    ui.inspector.classList.add('hidden');
    ui.selectedName.textContent = 'Brak zaznaczenia';
    ui.selectedSubtitle.textContent = 'Kliknij jednostkę na poligonie.';
    lastInspectorSelection = null;
    return;
  }
  ui.emptyInspector.classList.add('hidden');
  ui.inspector.classList.remove('hidden');
  ui.selectedName.textContent = unit.name;
  ui.selectedSubtitle.textContent = `${unit.team === TEAM.BLUE ? 'Niebiescy' : 'Czerwoni'} · ${unit.brainName} · ${unit.shipFrame || unit.squadronId}`;
  ui.hullText.textContent = `${Math.ceil(unit.hp).toLocaleString('pl-PL')} / ${unit.maxHp.toLocaleString('pl-PL')}`;
  ui.shieldText.textContent = unit.shield.max > 0 ? `${Math.ceil(unit.shield.val).toLocaleString('pl-PL')} / ${unit.shield.max.toLocaleString('pl-PL')}` : 'brak';
  ui.hullBar.style.width = `${clamp(unit.hp / unit.maxHp * 100, 0, 100)}%`;
  ui.shieldBar.style.width = `${unit.shield.max > 0 ? clamp(unit.shield.val / unit.shield.max * 100, 0, 100) : 0}%`;
  ui.speedMetric.textContent = `${Math.round(Math.hypot(unit.vx, unit.vy)).toLocaleString('pl-PL')} u/s`;
  ui.maxSpeedMetric.textContent = `${Math.round(unit.maxSpeed).toLocaleString('pl-PL')} u/s`;
  ui.stateMetric.textContent = unit.state || (unit.aiEnabled ? 'combat' : 'idle');
  const target = unit.forceTarget && !unit.forceTarget.dead ? unit.forceTarget : unit.target;
  ui.targetMetric.textContent = target && !target.dead ? (target.name || target.id || target.type) : 'brak';
  ui.physicsMetric.textContent = npcHasPhysicalThrusters(unit) ? 'dysze fizyczne' : (unit.fighter ? 'fighter accel' : 'fallback AI');
  const hpCounts = countHardpoints(unit);
  ui.hardpointMetric.textContent = unit.fighter ? 'uzbrojenie eskadry' : `${(unit.editorHardpoints || []).length} · ${hpCounts.main} main`;

  if (force || lastInspectorSelection !== unit) {
    ui.aiEnabled.checked = unit.aiEnabled;
    ui.tuneMaxSpeed.value = String(Math.round(unit.maxSpeed * 100) / 100);
    ui.tuneAccel.value = String(Math.round(unit.accel * 100) / 100);
    ui.tuneTurn.value = String(Math.round(unit.turn * 1000) / 1000);
    ui.tuneRange.value = String(Math.round(finite(unit.preferredRange)));
    ui.mainWeapon.value = unit.loadout?.main || '';
    ui.auxWeapon.value = unit.loadout?.aux || '';
    ui.missileWeapon.value = unit.loadout?.missile || '';
    ui.mainWeapon.disabled = unit.fighter;
    ui.auxWeapon.disabled = unit.fighter;
    ui.missileWeapon.disabled = unit.fighter;
    ui.applyLoadout.disabled = unit.fighter;
    ui.sourceFiles.textContent = unit.fighter
      ? 'src/ai/fighterAI.js\nsrc/data/fighterSquadrons.js\nsrc/data/weapons.js'
      : 'src/ai/capitalAI.js\nsrc/ai/fleetCoordinator.js\nsrc/game/flight/npcFlight.js\nsrc/data/hardpointEditorDefaults.js\nsrc/data/ships.js\nsrc/data/weapons.js';
    refreshHardpointSummary(unit);
    lastInspectorSelection = unit;
  }
}

function refreshGlobalUi(now) {
  if (now - lastUiUpdate < 120) return;
  lastUiUpdate = now;
  let blue = 0;
  let red = 0;
  for (let index = 0; index < sim.units.length; index++) {
    const unit = sim.units[index];
    if (!unit || unit.dead) continue;
    if (unit.team === TEAM.BLUE) blue++;
    else red++;
  }
  ui.blueCount.textContent = String(blue);
  ui.redCount.textContent = String(red);
  ui.layoutStatus.textContent = `layouty: v${hardpoints.version}`;
  ui.projectileStatus.textContent = `pociski: ${sim.projectiles.length}`;
  ui.fpsReadout.textContent = `${Math.round(fpsSmoothing)} FPS`;
  ui.simReadout.textContent = `${sim.lastAiMs.toFixed(2)} ms AI · ${sim.units.length} jednostek`;
  refreshInspector(false);

  if (sim.time > 1 && blue === 0 && red > 0 && victoryState !== TEAM.RED) {
    victoryState = TEAM.RED;
    logEvent('Zwycięstwo czerwonych.', 'kill');
  } else if (sim.time > 1 && red === 0 && blue > 0 && victoryState !== TEAM.BLUE) {
    victoryState = TEAM.BLUE;
    logEvent('Zwycięstwo niebieskich.', 'info');
  }
}

function frame(now) {
  const realDt = Math.min(0.1, Math.max(0, (now - lastFrameTime) / 1000));
  lastFrameTime = now;
  if (realDt > 0) fpsSmoothing += ((1 / realDt) - fpsSmoothing) * 0.08;

  if (!sim.paused) {
    sim.accumulator += realDt * sim.timeScale;
    let steps = 0;
    while (sim.accumulator >= FIXED_DT && steps < MAX_STEPS_PER_FRAME) {
      simulationStep(FIXED_DT);
      sim.accumulator -= FIXED_DT;
      steps++;
    }
    if (steps === MAX_STEPS_PER_FRAME) sim.accumulator = 0;
  }
  render();
  refreshGlobalUi(now);
  requestAnimationFrame(frame);
}

function populateCatalog() {
  const groups = [
    ['Eskadry', CATALOG.filter((entry) => entry.family === 'fighter')],
    ['Okręty liniowe', CATALOG.filter((entry) => entry.family === 'support')],
    ['Capitale i cele', CATALOG.filter((entry) => entry.family === 'capital' || entry.family === 'civilian')]
  ];
  const fragment = document.createDocumentFragment();
  for (const [label, entries] of groups) {
    const group = document.createElement('optgroup');
    group.label = label;
    for (const entry of entries) {
      const stats = resolveStats(entry);
      const option = document.createElement('option');
      option.value = entry.id;
      option.textContent = `${entry.label} · ${Math.round(stats.maxSpeed)} u/s`;
      group.appendChild(option);
    }
    fragment.appendChild(group);
  }
  ui.spawnHull.replaceChildren(fragment);
  ui.spawnHull.value = 'battleship';
  updateSpawnDescription();
}

function updateSpawnDescription() {
  const entry = CATALOG_BY_ID.get(ui.spawnHull.value);
  if (!entry) return;
  const stats = resolveStats(entry);
  ui.spawnDescription.textContent = `${entry.description}  HP ${stats.hp.toLocaleString('pl-PL')} · max ${stats.maxSpeed} · accel ${stats.accel}`;
  if (entry.family === 'fighter' && Number(ui.spawnCount.value) === 1) ui.spawnCount.value = String(entry.data.squadSize);
}

function duplicateUnit(unit) {
  if (!unit) return null;
  const copy = spawnUnit(unit.catalogId, unit.team, unit.x + unit.radius * 2.5 + 80, unit.y + unit.radius * 0.5, { angle: unit.angle, vx: unit.vx, vy: unit.vy });
  copy.maxSpeed = unit.maxSpeed;
  copy.accel = unit.accel;
  copy.turn = unit.turn;
  copy.preferredRange = unit.preferredRange;
  if (!copy.fighter) mountLoadout(copy, unit.loadout);
  return copy;
}

function bindUi() {
  document.querySelectorAll('[data-scenario]').forEach((button) => {
    button.addEventListener('click', () => runScenario(button.dataset.scenario));
  });
  document.querySelectorAll('[data-spawn-fighters]').forEach((button) => {
    button.addEventListener('click', () => {
      const team = button.dataset.spawnFighters === TEAM.RED ? TEAM.RED : TEAM.BLUE;
      spawnFighterReinforcements(team, 50);
    });
  });
  ui.timeControls.addEventListener('click', (event) => {
    const button = event.target.closest('[data-time]');
    if (!button) return;
    sim.timeScale = clamp(button.dataset.time, 0.1, 8);
    ui.timeControls.querySelectorAll('button').forEach((entry) => entry.classList.toggle('active', entry === button));
  });
  ui.pause.addEventListener('click', () => {
    sim.paused = !sim.paused;
    ui.pause.textContent = sim.paused ? 'Wznów' : 'Pauza';
    ui.pause.classList.toggle('active', sim.paused);
  });
  ui.reset.addEventListener('click', () => clearSimulation());
  ui.clearLog.addEventListener('click', () => ui.combatLog.replaceChildren());
  ui.spawnHull.addEventListener('change', updateSpawnDescription);
  ui.spawnButton.addEventListener('click', () => {
    const id = ui.spawnHull.value;
    const team = ui.spawnTeam.value;
    const count = clamp(Math.round(ui.spawnCount.value), 1, 80);
    const x = team === TEAM.BLUE ? camera.x - viewport.width / camera.zoom * 0.28 : camera.x + viewport.width / camera.zoom * 0.28;
    const facing = team === TEAM.BLUE ? 0 : Math.PI;
    if (CATALOG_BY_ID.get(id)?.family === 'fighter') spawnFighterGroup(id, team, count, x, camera.y, facing);
    else {
      for (let index = 0; index < count; index++) {
        spawnUnit(id, team, x, camera.y + (index - (count - 1) * 0.5) * 520, { angle: facing });
      }
    }
    logEvent(`Dodano ${count} × ${CATALOG_BY_ID.get(id)?.label} (${team}).`, 'info');
  });
  ui.reloadLayouts.addEventListener('click', () => {
    hardpoints.refreshCache(true);
    for (let index = 0; index < sim.units.length; index++) applyCurrentLayout(sim.units[index]);
    refreshInspector(true);
    logEvent(`Ręcznie wczytano hardpointy gry · wersja ${hardpoints.version}`, 'info');
  });

  ui.aiEnabled.addEventListener('change', () => {
    if (!primarySelection) return;
    primarySelection.aiEnabled = ui.aiEnabled.checked && !!primarySelection.brainFn;
  });
  ui.applyTuning.addEventListener('click', () => {
    const unit = primarySelection;
    if (!unit) return;
    unit.maxSpeed = Math.max(0, finite(ui.tuneMaxSpeed.value, unit.maxSpeed));
    unit.accel = Math.max(0, finite(ui.tuneAccel.value, unit.accel));
    unit.turn = Math.max(0.01, finite(ui.tuneTurn.value, unit.turn));
    unit.turnAccel = unit.turn * 4;
    unit.preferredRange = Math.max(0, finite(ui.tuneRange.value, unit.preferredRange));
    unit.__fighterEnv = undefined;
    logEvent(`Tuning zastosowany: ${unit.name}`, 'info');
    refreshInspector(true);
  });
  ui.resetTuning.addEventListener('click', () => {
    const unit = primarySelection;
    if (!unit) return;
    Object.assign(unit, unit.baseStats);
    unit.turnAccel = unit.turn * 4;
    unit.__fighterEnv = undefined;
    refreshInspector(true);
  });
  ui.applyLoadout.addEventListener('click', () => {
    const unit = primarySelection;
    if (!unit || unit.fighter) return;
    mountLoadout(unit, { main: ui.mainWeapon.value, aux: ui.auxWeapon.value, missile: ui.missileWeapon.value });
    refreshHardpointSummary(unit);
    logEvent(`Przemontowano hardpointy: ${unit.name}`, 'info');
  });
  ui.healSelected.addEventListener('click', () => {
    if (!primarySelection) return;
    primarySelection.hp = primarySelection.maxHp;
    primarySelection.shield.val = primarySelection.shield.max;
    primarySelection.shield.regenTimer = 0;
  });
  ui.clearTarget.addEventListener('click', () => {
    for (const unit of selection) {
      unit.forceTarget = null;
      unit.target = null;
      unit.retargetTimer = 0;
    }
  });
  ui.duplicateSelected.addEventListener('click', () => {
    const copy = duplicateUnit(primarySelection);
    if (copy) setPrimarySelection(copy);
  });
  ui.deleteSelected.addEventListener('click', () => {
    for (const unit of selection) {
      unit.dead = true;
      unit.deadAt = sim.time - 5;
    }
    selection.clear();
    setPrimarySelection(null);
    cleanupDeadUnits();
  });
}

function bindCanvas() {
  let panning = false;
  let panStartX = 0;
  let panStartY = 0;
  let cameraStartX = 0;
  let cameraStartY = 0;

  ui.canvas.addEventListener('pointerdown', (event) => {
    ui.canvas.focus();
    const rect = ui.canvas.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;
    if (event.button === 1) {
      panning = true;
      panStartX = event.clientX;
      panStartY = event.clientY;
      cameraStartX = camera.x;
      cameraStartY = camera.y;
      ui.canvas.classList.add('panning');
      ui.canvas.setPointerCapture(event.pointerId);
      event.preventDefault();
      return;
    }
    const hit = unitAtScreen(x, y);
    if (event.button === 0) {
      setPrimarySelection(hit, event.shiftKey);
    } else if (event.button === 2 && hit) {
      let assigned = 0;
      for (const unit of selection) {
        if (!unit.dead && unit.team !== hit.team) {
          unit.forceTarget = hit;
          unit.target = hit;
          unit.retargetTimer = 9999;
          assigned++;
        }
      }
      if (assigned) logEvent(`${assigned} jednostek otrzymało wymuszony cel: ${hit.name}`, 'info');
    }
  });

  ui.canvas.addEventListener('pointermove', (event) => {
    const rect = ui.canvas.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;
    const world = screenToWorld(x, y);
    ui.cursorReadout.textContent = `x ${Math.round(world.x)} · y ${Math.round(world.y)}`;
    if (!panning) return;
    camera.x = cameraStartX - (event.clientX - panStartX) / camera.zoom;
    camera.y = cameraStartY - (event.clientY - panStartY) / camera.zoom;
  });

  const stopPan = (event) => {
    if (!panning) return;
    panning = false;
    ui.canvas.classList.remove('panning');
    if (ui.canvas.hasPointerCapture(event.pointerId)) ui.canvas.releasePointerCapture(event.pointerId);
  };
  ui.canvas.addEventListener('pointerup', stopPan);
  ui.canvas.addEventListener('pointercancel', stopPan);
  ui.canvas.addEventListener('contextmenu', (event) => event.preventDefault());
  ui.canvas.addEventListener('wheel', (event) => {
    event.preventDefault();
    const rect = ui.canvas.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;
    const before = screenToWorld(x, y);
    camera.zoom = clamp(camera.zoom * Math.exp(-event.deltaY * 0.0012), camera.minZoom, camera.maxZoom);
    const after = screenToWorld(x, y);
    camera.x += before.x - after.x;
    camera.y += before.y - after.y;
    ui.cameraReadout.textContent = `zoom ${Math.round(camera.zoom * 100)}%`;
  }, { passive: false });
  ui.canvas.addEventListener('dblclick', (event) => {
    const rect = ui.canvas.getBoundingClientRect();
    const hit = unitAtScreen(event.clientX - rect.left, event.clientY - rect.top);
    if (hit) {
      camera.x = hit.x;
      camera.y = hit.y;
      camera.zoom = clamp(Math.max(camera.zoom, 0.45), camera.minZoom, camera.maxZoom);
      setPrimarySelection(hit);
    }
  });

  window.addEventListener('keydown', (event) => {
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLSelectElement) return;
    if (event.code === 'Space') {
      event.preventDefault();
      ui.pause.click();
    } else if (event.key.toLowerCase() === 'f') {
      fitCameraToUnits();
    } else if (event.key === 'Delete') {
      ui.deleteSelected.click();
    } else if (['1', '2', '4'].includes(event.key)) {
      ui.timeControls.querySelector(`[data-time="${event.key}"]`)?.click();
    }
  });
}

async function bootstrap() {
  installGameBridges();
  hardpoints.refreshCache(true);
  populateCatalog();
  populateWeaponSelect(ui.mainWeapon, 'main');
  populateWeaponSelect(ui.auxWeapon, 'aux');
  populateWeaponSelect(ui.missileWeapon, 'missile');
  bindUi();
  bindCanvas();
  resizeCanvas();

  const assetPromises = Object.entries(HULL_SPRITE_URLS).map(([hullId, src]) => loadSprite(hullId, src));
  const loaded = await Promise.all(assetPromises);
  const failures = loaded.filter((record) => record.error);
  if (failures.length) logEvent(`Nie udało się wczytać sprite'ów: ${failures.map((entry) => entry.hullId).join(', ')}`, 'kill');

  ui.runtimeStatus.innerHTML = '<i class="status-light"></i>moduły gry podłączone';
  ui.layoutStatus.textContent = `layouty: v${hardpoints.version}`;
  ui.loading.classList.add('done');
  runScenario('mixed');
  logEvent('AI SPACE korzysta z bieżących modułów gry.', 'info');
  requestAnimationFrame(frame);
}

bootstrap().catch((error) => {
  console.error(error);
  ui.loading.querySelector('strong').textContent = 'Nie udało się uruchomić AI SPACE';
  ui.loading.querySelector('span').textContent = error?.stack || error?.message || String(error);
  ui.runtimeStatus.textContent = 'błąd inicjalizacji';
});
